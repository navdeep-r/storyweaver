/721680/size7/9fed9b1f3398292ef2703326117fce4b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-335627","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-335627","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":169,"opdsId":"urn:uuid:SW-458493","title":"ਲਾਪਤਾ ਸੁੰਦਰੀ","authors":["Vikram Prinja"],"language":"","readingLevel":"","publisher":"","summary":"ਬਬੀਤਾ ਦੀ ਪਿਆਰੀ ਮੱਝ ਸੁੰਦਰੀ ਲਾਪਤਾ ਹੈ। ਕੋਈ ਨਹੀਂ ਜਾਣਦਾ ਕਿ ਉਹ ਕਿੱਥੇ ਗਈ। ਪਰ ਸਿਪਾਹੀ ਪ੍ਰੀਤੀ ਨੂੰ ਭਰੋਸਾ ਹੈ ਕਿ ਉਹ ਉਸਨੂੰ ਲੱਭ ਲਵੇਗੀ। ਉਹ ਪੂਰੇ ਪਿੰਡ ਦੀ ਛਾਣਬੀਣ ਕਰਦੀ ਹੈ। ਲੋਕਾਂ ਨੂੰ ਮੱਝ ਬਾਰੇ ਪੁੱਛਦੀ ਹੈ ਅਤੇ ਸੁਰਾਗ ਲੱਭਦੀ ਹੈ। ਕੀ ਪ੍ਰੀਤੀ ਸੁੰਦਰੀ ਨੂੰ ਲੱਭ ਸਕੇਗੀ? ਸੰਗੀਤ ਪ੍ਰੇਮੀ ਮੱਝ ਸੁੰਦਰੀ ਦੇ ਲਾਪਤਾ ਹੋਣ ਪਿੱਛੇ ਕੀ ਰਹੱਸ ਹੈ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703483/size7/32d97f0835d6c7513042c8ab55b3ce74.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703483/size7/32d97f0835d6c7513042c8ab55b3ce74.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-458493","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-458493","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":170,"opdsId":"urn:uuid:SW-270833","title":"ਜੰਗਲ ਦੀ ਕਿਤਾਬ","authors":["Kaur Param"],"language":"","readingLevel":"","publisher":"","summary":"ਅਜਿਹਾ ਕੀ ਹੋਇਆ ਕਿ ਗੈਂਡਾ ਸੜਕ ਤੇ ਪਹੁੰਚ ਗਿਆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/285291/size7/5496578942fc19f65137c8a7aead529d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/285291/size7/5496578942fc19f65137c8a7aead529d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-270833","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-270833","type":"application/epub+zip","rel":"http://opds-spec