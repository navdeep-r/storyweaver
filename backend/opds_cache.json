llustration_crops/699247/size7/3fc37d2f562718ad41ae2200b5a20908.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/699247/size7/3fc37d2f562718ad41ae2200b5a20908.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-306912","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-306912","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":457,"opdsId":"urn:uuid:SW-85557","title":"टुर्रऽऽटुर्रऽऽऽ","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"तुम्ही फुसकुली सोडा किंवा जोरानं पादा, आजूबाजूच्या सगळ्यांना त्याचा पत्ता लागतो म्हणजे लागतोच. कधी मनमोकळं तर कधी चोरून, प्रत्येकजण रोज पादण्याची मजा घेत असतोच. ही मजेशीर गोष्ट आहे एक अशीच ’हवाई’ सफरीची!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727097/size7/8a2cbd3cbde95b072abeee5d2417325d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727097/size7/8a2cbd3cbde95b072abeee5d2417325d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-85557","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-85557","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":458,"opdsId":"urn:uuid:SW-693","title":"रेडिओ आणि मासे","authors":["Pratham Mumbai Team"],"language":"","readingLevel":"","publisher":"","summary":"मासे रेडिओ ऐकताना पाहिले आहेत का तुम्ही?\nनाही ना? मग वाचा तर रेडिओ आणि मासे मध्ये.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722316/size7/70d3d953a26157dec8e50a9a64e27a5d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722316/size7/70d3d953a26157dec8e50a9a64e27a5d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-693","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-693","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":459,"opdsId":"urn:uuid:SW-261216","title":"हे आमचं घर","authors":["Sushrut Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"एका नेहमीसारख्या दिवशी शांतिनिकेतनमधे राहणारी जुगनू आणि नूरी नावाची दोन मांजरं बाहेरचं दृश्य पाहात होती - खिडक्यांतून प्रवेश करणारं सकाळचं कोवळं ऊन, मासे आणि फळं विकणारे फेरीवाले, शाळेला निघालेली मुलं... अगदी नेहमीचंच दृश्य. मात्र पाहता पाहता काही वेळातच हे सारं चित्र पार पालटून जातं. वादळ सुरू होतं. वळवाच्या पावसाच्या जोरदार सरी कोसळू लागतात. मग हा दिवस इतर दिवसांसारखा साधासुधा राहील का? चला, या शब्दविरहित चित्रपुस्तकात जुगनू आणि नूरी यांना दिसणारं जग आपणही पाहू या.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/346798/size7/66152c7f4dd3c710a56f60d5e17054c2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/346798/size7/66152c7f4dd3c710a56f60d5e17054c2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-261216","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-261216","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":460,"opdsId":"urn:uuid:SW-165","title":"वीरूची सर्कस!","authors":["Neela Ingle"],"language":"","readingLevel":"","publisher":"","summary":"जम्बो-मम्बो सर्कस बघून वीरू परत येतो आणि त्याच्या डोक्यात भन्नाट कल्पना यायला लागतात. काय बरं करतो तो?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721025/size7/4d5245425fec73a2fc96ab944c5d1b0c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721025/size7/4d5245425fec73a2fc96ab944c5d1b0c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-165","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-165","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":461,"opdsId":"urn:uuid:SW-194","title":"काय बरं घालू आज?","authors":["Bhagyashree Kenge"],"language":"","readingLevel":"","publisher":"","summary":"आता कपडे तरी कोणते घालावेत बरं? \nअसा कधी कधी पेच पडतो. हवे तसे कपडे सापडण्याआधी या गोष्टीतल्या मुलीनं \nबघा बरं, काय काय घालून बघितलंय?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/2319/size7/466aacc8ac4a2d255bdf88b7bf413bee.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/2319/size7/466aacc8ac4a2d255bdf88b7bf413bee.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-194","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-194","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":462,"opdsId":"urn:uuid:SW-101378","title":"ओला की कोरडा?","authors":["Ashlesha Mahajan"],"language":"","readingLevel":"","publisher":"","summary":"तुम्ही तुमच्या घरातल्या कचऱ्याचं काय करता? तुम्ही ओला आणि कोरडा कचरा वेगळा करता का? तर मग ही मजेदार कविता वाचा नि त्यात सांगितलंय, तस्संच करा.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/145759/size7/beb14f9fe944bd7f5b8da10710b44755.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/145759/size7/beb14f9fe944bd7f5b8da10710b44755.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-101378","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-101378","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":463,"opdsId":"urn:uuid:SW-17488","title":"राजूची नौका सफर","authors":["Pratham Mumbai Team"],"language":"","readingLevel":"","publisher":"","summary":"शहरात राहाणार्‍या राजूला गावची भारी ओढ. गावाला जाऊन होडीत\nबसण्याची मजा काही औरच असते नाही का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722301/size7/