rops/754785/size7/e3b04ed3082c816a89f48d1b00882842.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-665470","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-665470","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1640,"opdsId":"urn:uuid:SW-665072","title":"Echoes of Childhood","authors":["Moge Basar"],"language":"","readingLevel":"","publisher":"","summary":"This story presents a day in the life of children engrossed in playing little games in a Galo village. Set against the backdrop of the strong ties of community life, these games and the children who play them offer a little glimpse into the lives of the people.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/754821/size7/f852644d5955a098564e3fe69d1bace2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/754821/size7/f852644d5955a098564e3fe69d1bace2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-665072","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-665072","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1641,"opdsId":"urn:uuid:SW-664987","title":"Nyeke Monyu","authors":["Longang  Luklem"],"language":"","readingLevel":"","publisher":"","summary":"Nyeke Monyu, the sacred log drum of Pessau narrates her journey from being a mighty tree in the forest, to the becoming the heart of the village of Pessau.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/754893/size7/f0b2507a1e2f6ee42e56fa27bb6bafa5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/754893/size7/f0b2507a1e2f6ee42e56fa27bb6bafa5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-664987","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https:/