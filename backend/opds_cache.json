/pdf/SW-34318","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-34318","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":661,"opdsId":"urn:uuid:SW-375319","title":"How the Myna Ate the Sun","authors":["Labonie Roy"],"language":"","readingLevel":"","publisher":"","summary":"A very hungry myna wants to eat her favourite food, the sun! But is it possible to eat the sun? Find out in this beautiful book about food chains.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/491384/size7/4a7f9ec316e3ecd57b8b23dcad84a928.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/491384/size7/4a7f9ec316e3ecd57b8b23dcad84a928.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-375319","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-375319","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":662,"opdsId":"urn:uuid:SW-62386","title":"Cracking the Code: Women Who Have Changed the Way We Look at Computers","authors":["Alisha Sadikot"],"language":"","readingLevel":"","publisher":"","summary":"What do 19th Century English mathematician Ada Lovelace, new-age fashion designer Anouk Wipprecht, and the current Digital Minister of Taiwan Audrey Tang have in common? They’ve all impacted the way we look at computers and coding. This book introduces some inspiring women from the world of technology, from across a century.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/718336/size7/673001d175ce2760146ea7f626f8e1f0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/718336/size7/673001d175ce2760146ea7f626f8e1f0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-62386","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://story