":"https://static.storyweaver.org.in/illustration_crops/431545/size7/2b7ae67a0f852dbec9bb594cdd687341.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/431545/size7/2b7ae67a0f852dbec9bb594cdd687341.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-399934","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-399934","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":743,"opdsId":"urn:uuid:SW-150627","title":"पडक्या महालात अडकला अरुण","authors":["Atish Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"अरुण आणि अरुणाचलम एका गूढ जुन्या महालात अडकले आहेत. त्यांनी विद्युतमंडल पूर्ण केलं, तरच ते तिथून बाहेर पडू शकणार आहेत. कशी करून घेतील ते स्वतःची सुटका?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/202930/size7/56578534ef3390627c24976344c17172.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/202930/size7/56578534ef3390627c24976344c17172.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-150627","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-150627","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":744,"opdsId":"urn:uuid:SW-134213","title":"वेध डायनोसोरचा","authors":["Santosh Shintre"],"language":"","readingLevel":"","publisher":"","summary":"माणसाचं या जगात आगमन होण्यापूर्वी संपूर्ण पृथ्वीवर डायनोसोरचा मुक्त संचार असे. चला, या एका प्राचीन, अद्भुत प्राण्याबद्दल जाणून घेऊया.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715618/size7/b5a7b07919a59bf4a6e9c6b95f96544f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715618/size7/b5a7b07919a59bf4a6e9c6b95f96544f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-134213","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-134213","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":745,"opdsId":"urn:uuid:SW-314508","title":"डॉ. बाबासाहेब आंबेडकर : ग्रंथप्रेमाने भारलेले जीवन","authors":["Meera Joshi"],"language":"","readingLevel":"","publisher":"","summary":"ही गोष्ट आहे भारतीय घटनेचे शिल्पकार डॉ. बाबासाहेब आंबेडकर यांची. अर्थतज्ज्ञ आणि द्रष्टे क्रांतिकारक असलेल्या बाबासाहेबांनी आपलं संपूर्ण आयुष्य एक उत्तम वाचक म्हणूनही व्यतीत केलं. त्यांचा ज्ञानप्राप्तीसाठी असलेला ओढा आणि त्यातून घडलेला त्यांचा पुढचा जीवनप्रवास याची ही प्रेरक कहाणी.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727370/size7/dcf9772fbc6e7843e82e01cd5af44027.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727370/size7/dcf9772fbc6e7843e82e01cd5af44027.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-314508","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-314508","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":746,"opdsId":"urn:uuid:SW-90138","title":"पाऊसरंगी मी रंगते","authors":["Meera Joshi"],"language":"","readingLevel":"","publisher":"","summary":"आजूबाजूच्या जगाचे सर्व व्यवहार ठप्प झाले आहेत. पाऊसपाणी सांगत आहे गोष्टीच गोष्टी. पुस्तकातलं पावसाचं संगीत ऐकणार नं तुम्ही?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/129503/size7/89b766f8d4c0196ea302ec921b824e8d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/129503/size7/89b766f8d4c0196ea302ec921b824e8d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-90138","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-90138","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":747,"opdsId":"urn:uuid:SW-267754","title":"खडकांची रहस्यं","authors":["Varsha Gajendragadkar"],"language":"","readingLevel":"","publisher":"","summary":"खडक सगळीकडे आहेत – जमिनीखाली, जमिनीच्या वर आणि अगदी आपल्या समुद्रांच्या तळांशीसुद्धा! पण हे खडक येतात तरी कुठून? ते कशापासून बनले आहेत? जर खडक बोलू शकले, तर आपल्याला कितीतरी रहस्यं ते सांगतील.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716006/size7/2a7fc11e509d305c2c43159bbedf1d55.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716006/size7/2a7fc11e509d305c2c43159bbedf1d55.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-267754","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-267754","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":748,"opdsId":"urn:uuid:SW-69587","title":"हिरवी छटा","authors":["Sai Keskar"],"language":"","readingLevel":"","publisher":"","summary":"शहरातली हवा धुरकट आणि प्रदूषित आहे. नयनतारा आणि अलिझाला अगदी घुसमटल्यासारखं झालंय. त्यामुळं त्यांच्या डोक्यात ऑक्सिजन आणि स्वच्छ हवा तयार करणारं एक कृत्रिम पान तयार करायची कल्पना येते. त्या अशा पानाचा शोध लावू शकतील का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/718464/size7/347a0a585fadb43ad09779f4df38781d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/718464/size7/347a0a585fadb43ad09779f4df38781d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-69587","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-69587","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":749,"opdsId":"urn:uuid:SW-111313","title":"माझे हक्क","authors":["Meera Joshi"],"language":"","readingLevel":"","publisher":"","summary":"संयुक्त राष्ट्रसंघानं मुलांच्या हक्कांची सनद प्रसृत केली आहे. त्यात मुलांचे काही मूलभूत हक्क नोंदवले आहेत. तुम्ही कुठले आहात, कोणत्या वर्णाचे आहात, एखादा धर्म पाळता किंवा नाही, कोणती भाषा बोलता, तुम्ही मुलगा आहात की मुलगी, या गोष्टींचा हे हक्क मिळण्या न मिळण्याशी संबंध नाही. सर्वांसाठी हे हक्क समान आहेत! या पुस्तकात मुलांसाठीचे असेच काही हक्क नमूद केलेले आहेत.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/156212/size7/89ed34011a88c4888b1dba527607d9f5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/156212/size7/89ed34011a88c4888b1dba527607d9f5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-111313","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-111313","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":750,"opdsId":"urn:uuid:SW-535779","title":"अवकाशातले गाणे : केसरबाई केरकर","authors":["Neha Limaye"],"language":"","readingLevel":"","publisher":"","summary":"छोट्या केसरला गायला खूप आवडायचे. मोठेपणी आपला आवाज अनेक आकाशगंगांचा प्रवास करून अगदी दूरवर जाऊन पोहोचेल अशी तिने कधी कल्पनाही केली नव्हती. चला, केसरबाई केरकर यांच्या अनोख्या संगीतप्रवासाबद्दल जाणून घेण्यासाठी हे छानसे पुस्तक वाचू या.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727643/size7/cabddb8b05a4b92bfac968bdfb43ad47.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727643/size7/cabddb8b05a4b92bfac968bdfb43ad47.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-535779","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-535779","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":751,"opdsId":"urn:uuid:SW-214242","title":"मी कोण?","authors":["Ashok Londhe"],"language":"","readingLevel":"","publisher":"","summary":"एक प्राणी असा की त्याच्या पोटावर असते एक पिशवी. सांगा बर तो कोण आहे?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283184/size7/c8dc580322ba6c1d13d94c78f05f8b06.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283184/size7/c8dc580322ba6c1d13d94c78f05f8b06.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-214242","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-214242","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":752,"opdsId":"urn:uuid:SW-111189","title":"मी आहे कठपुतळी","authors":["Sayali Godse"],"language":"","readingLevel":"","publisher":"","summary":"नेमकी कोण आहे मी? कधीकधी मी दिसते परग्रहवासीयासारखी, तर कधी एका विदुषकासारखी. मी नाचूही शकते आणि डोलूही. मी हातमोज्यातच काय, पायमोज्यातसुद्धा राहते. माझं कुटुंब अगदी विशाल आहे. मला भेटायला नक्कीच आवडेल तुम्हाला!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/179726/size7/60ff2df992655244ab28c10c77af7c09.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/179726/size7/60ff2df992655244ab28c10c77af7c09.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-111189","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-111189","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":753,"opdsId":"urn:uuid:SW-124300","title":"अनुराधा करते बिहूनृत्य","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"बिहूचा सण अगदी जवळ आला होता. अनुराधाही त्यामध्ये नृत्य करण्यासाठी अगदी अधीर झाली होती. तितक्यात एक अडचण निर्माण झाली – अचानक सुरू झालेला पाऊस थांबायचं मुळी नावच घेत नव्हता. बाहेर पडून अनुराधा आपल्या मित्रमंडळींसोबत बिहूनृत्य करू शकेल का? चला, वाचूया या मस्त गोष्टीत!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727174/size7/53b5f7b949e9df9d350ecbed881271d1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727174/size7/53b5f7b949e9df9d350ecbed881271d1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-124300","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-124300","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":754,"opdsId":"urn:uuid:SW-124306","title":"काय वाटतंय मला?","authors":["Rupali Bhave"],"language":"","readingLevel":"","publisher":"","summary":"आज्जी तुम्हाला भेटायला घरी येते तेव्हा कसं वाटतं? लायब्ररीचं पुस्तक तुमच्या हातून फाटलं तर काय वाटतं? हे पुस्तक वाचा आणि बघा बरं तुम्हाला आज काय वाटतं आहे ते!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/171875/size7/b5e3b9c7796bf4435fbd82e63b8d4f38.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/171875/size7/b5e3b9c7796bf4435fbd82e63b8d4f38.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-124306","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-124306","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":755,"opdsId":"urn:uuid:SW-1010","title":"शाही मिरवणूक","authors":["Utkarsha Manish"],"language":"","readingLevel":"","publisher":"","summary":"पाटलीपुत्रात राहूनसुद्धा पार्वती आणि लक्ष्मणाने आपल्या राजाला कधीही पाहिलेले नव्हते. एके दिवशी विहारात मातीची भांडी द्यायला गेलेले असताना त्यांना एक नवीन मित्र भेटतो. तो त्यांना लवकरच राजाचे दर्शन होईल याची हमी देतो. त्यांचे हे स्वप्न साकार होते की नाही हे जाणण्यासाठी ही मौर्यकाळातील चित्तवेधक कथा वाचा...","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703492/size7/b7b9579f578a8043e0e9f143d5315a86.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703492/size7/b7b9579f578a8043e0e9f143d5315a86.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-1010","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/