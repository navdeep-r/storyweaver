SW-22999","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-22999","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":21,"opdsId":"urn:uuid:SW-69583","title":"सुंदरीला आवरेना हसू","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"खूप साऱ्या गोष्टींमुळं हसू फुटत असल्यामुळं टी. सुंदरी रोज कसल्यातरी अडचणीत सापडतेच. काही केल्या तिला आपलं हसू मुळी आवरताच येत नाही. आपल्याला काही आजार-बिजार तर नाही ना, हे टी. सुंदरीला शोधून काढायचंय. तसं नसेल, तर मग तिला सारखं, बिनधास्तपणे हसता येईल ना!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/718145/size7/8f27fe5f72c50232be4f992cd4a2eaea.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/718145/size7/8f27fe5f72c50232be4f992cd4a2eaea.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-69583","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-69583","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":22,"opdsId":"urn:uuid:SW-12217","title":"फुलपाखरू हसलं","authors":["Meera Joshi"],"language":"","readingLevel":"","publisher":"","summary":"काव्या तिच्या कुटुंबाबरोबर नुकतीच एका लहान गावातून बंगळुरूला राहायला आली आहे. वर्गात ती अगदी नवखी आहे. काव्याबरोबर आपण एका फुलपाखरांच्या उद्यानात जाणार आहोत. तिथं तिचे फुलपाखरांबरोबरचे भावबंध उलगडतात, शिवाय तिला एक नवी मैत्रीणही मिळते.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712825/size7/46977bed0760c446c9dd926ee5c83ee5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712825/size7/46977bed0760c446c9dd926ee5c83ee5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12217","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12217","type":"applica