toryweaver.org.in/illustration_crops/532359/size7/08ed742ec4dd49254e2e0e201e413974.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/532359/size7/08ed742ec4dd49254e2e0e201e413974.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-453678","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-453678","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":841,"opdsId":"urn:uuid:SW-128836","title":"My Appa and his Sounds","authors":["Venkataraghavan Subha Srinivasan"],"language":"","readingLevel":"","publisher":"","summary":"I love the sounds that my Appa makes. I have my favourite—which one is yours?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/186760/size7/31364a1bc354083c17c2a516cefd632e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/186760/size7/31364a1bc354083c17c2a516cefd632e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-128836","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-128836","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":842,"opdsId":"urn:uuid:SW-652","title":"The Generous Crow","authors":["Divaspathy Hegde"],"language":"","readingLevel":"","publisher":"","summary":"The crow is not beautiful. He can neither sing as sweetly as a cuckoo nor dance as gracefully as a peacock. But he has one unique quality that we can all learn from. Read the book to find out what it is!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722324/size7/899ce10997cf17e28b15c545ee954d63.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722324/size7/899ce10997cf17e28b15c545ee954d63.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-652","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-652","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":843,"opdsId":"urn:uuid:SW-213130","title":"Jungle Book","authors":["Ashwini Joshi"],"language":"","readingLevel":"","publisher":"","summary":"What happened to make the hippo come out from the jungle onto the road?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/285291/size7/5496578942fc19f65137c8a7aead529d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/285291/size7/5496578942fc19f65137c8a7aead529d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-213130","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-213130","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":844,"opdsId":"urn:uuid:SW-577854","title":"Daddy's Hobby","authors":["Jenny Lu"],"language":"","readingLevel":"","publisher":"","summary":"Every morning, Daddy puts on his helmet, laces up his sneakers, hops onto his bicycle! But is Daddy’s hobby riding his bicycle or…?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/642856/size7/fffc5ae3834b649a5c02e07c08104f79.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/642856/size7/fffc5ae3834b649a5c02e07c08104f79.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-577854","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-577854","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":845,"opdsId":"urn:uuid:SW-274958","title":"The Secret World of Mehlli Gobhai: The Man Who Found Art Everywhere","authors":["Jerry Pinto"],"language":"","readingLevel":"","publisher":"","summary":"The murky waters of a winding stream, stark trees stripped of leaves, a crow messing up a canvas—Mehlli Gobhai saw art in all of this. Follow the journey of this inspiring painter and see how art is all around and can help you see the world anew.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/433438/size7/57ac0a1b3775ce938ca762eda9019d2a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/433438/size7/57ac0a1b3775ce938ca762eda9019d2a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-274958","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-274958","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":846,"opdsId":"urn:uuid:SW-768","title":"Shobhini and Nani","authors":["Rukmini Banerji"],"language":"","readingLevel":"100daysreadingcampaignPunjab2022","publisher":"","summary":"Little Shobhini loves trying out new things. She goes to the mela, the jungle and to bathe in the river with her adventurous Nani. They even fly off to the moon once…wonder what happened then. A lovely story about Shobhini and Nani's little adventures.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721036/size7/57836b9694b326fa682b899413769305.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721036/size7/57836b9694b326fa682b899413769305.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-768","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-768","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":847,"opdsId":"urn:uuid:SW-25136","title":"Miss Laya Starts Her Fantastic Motorbike","authors":["Mala Kumar"],"language":"","readingLevel":"","publisher":"","summary":"Miss Laya the Games Teacher loves helping people! Join her and her fantastic\nmotorbike as they vroom off and have different adventures. This is the first in a series of\nstories called Miss Laya's Fantastic Motorbike.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117362/size7/a894b43fa2809b9b8de75bb7feeb341a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117362/size7/a894b43fa2809b9b8de75bb7feeb341a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-25136","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-25136","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":848,"opdsId":"urn:uuid:SW-821","title":"Here Comes the Camel and Other Poems","authors":["Manisha Chaudhry"],"language":"","readingLevel":"","publisher":"","summary":"Prayag Shukla's poems in Hindi have enchanted young and old alike. This collection of poems translated into English brings the joy of his writing to a new set of readers. Siraj Saxena's innovative artwork adds to the appeal of this classic collection.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722421/size7/17071390c8bd0a61c5c5913877f15057.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722421/size7/17071390c8bd0a61c5c5913877f15057.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-821","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-821","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":849,"opdsId":"urn:uuid:SW-266160","title":"Aarna and Iris' Big Task","authors":["Reshma Thapa Gurung"],"language":"","readingLevel":"","publisher":"","summary":"Aarna and Iris have a new task! There’s a new student in class, and they have to help him settle in. So they set about introducing Norgay to their school in a novel way — by using their senses.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/354874/size7/9c6042fcaf09adad8d5cb470f6ffe56a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/354874/size7/9c6042fcaf09adad8d5cb470f6ffe56a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-266160","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-266160","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":850,"opdsId":"urn:uuid:SW-55713","title":"Who Just Went By?","authors":["Radha Rangarajan"],"language":"","readingLevel":"","publisher":"","summary":"Whose footprints are these? Who left behind this trail? A book that introduces young readers to animals and their tracks.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/714338/size7/79cec9b30eb76917a457653a32a5b3e2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/714338/size7/79cec9b30eb76917a457653a32a5b3e2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-55713","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-55713","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":851,"opdsId":"urn:uuid:SW-1205","title":"Pishi Caught in a Storm","authors":["Mala Kumar","Manisha Chaudhry"],"language":"","readingLevel":"","publisher":"","summary":"Pishi was a huge manta ray fish. Once, when he was caught in a big storm in the Indian Ocean, guess who came to his rescue? Dive into this book for a dramatic story.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722387/size7/073d9b1811b5dd45c355c678228d68cc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722387/size7/073d9b1811b5dd45c355c678228d68cc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-1205","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-1205","type":"app