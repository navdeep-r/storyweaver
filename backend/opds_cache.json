b+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":907,"opdsId":"urn:uuid:SW-45958","title":"जरा नीट बघ बरं!","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"पुट्टी आणि तिची ताई बागेतून घरी परत येत असताना पुट्टीला दिसतो पोनीटेल घातलेला कुत्रा! एक भीतीदायक राक्षसही तिला दिसतो. बघा बरं जरा नीट, या पुस्तकात पुट्टीला काय काय दिसलंय ते! आणि समजा, या दोघी बहिणींना जे दिसलं ते तुम्हाला अजून दिसलं नसेल तर गोष्टीतली चित्रं जरा नीट बघा बरं!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726966/size7/15635f91953824a04da6422127147fd7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726966/size7/15635f91953824a04da6422127147fd7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-45958","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-45958","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":908,"opdsId":"urn:uuid:SW-632303","title":"माझे मित्र","authors":["Madhav  Chavan"],"language":"","readingLevel":"","publisher":"","summary":"मला खूप मित्र आहेत. मला ते सर्व आवडतात. पण त्यांच्यातला एक मला सर्वात जास्त आवडतो.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721910/size7/08a4e9f9c5199165073e54117f25ceeb.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721910/size7/08a4e9f9c5199165073e54117f25ceeb.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-632303","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-632303","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":909,"opdsId":"urn:uuid:SW-134504","title":"सर्वव्यापी कला: इथली, तिथली अन्‍ कचऱ्यातलीही","authors":["Meera Joshi"],"language":"","readingLevel":"","publisher":"","summary":"कला कुठंही, कशातूनही निर्माण होऊ शकते. ’सर्वव्यापी कला’ मालिकेतील या पुस्तकाच्या माध्यमातून कलाकारांच्या बरोबरीनं वाचकही टाकाऊ कचऱ्याकडे कलावस्तू असल्यासारखं बघतील. वाचकसुद्धा त्यातल्या शब्दांच्या खेळात रमतील, त्यांच्याही कल्पनांना पंख फुटतील!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727181/size7/b60285be90a998a96c505a8809a1b7a9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727181/size7/b60285be90a998a96c505a8809a1b7a9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-134504","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-134504","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":910,"opdsId":"urn:uuid:SW-648566","title":"तेजस्वी तारा","authors":["Ashlesha Gore"],"language":"","readingLevel":"","publisher":"","summary":"गोष्टी सांगायच्या म्हटलं, की ताराच्या मनात जणू उत्साहाची ज्योत पेटायची. मात्र प्रत्येकालाच तिने सांगितलेल्या गोष्टी आवडायच्या नाहीत. मग तिच्या आतलं हे तेज हळूहळू मंदावत गेलं. तिला पुन्हा आपल्या आतल्या ज्योतीचं तेज सापडेल का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721015/size7/04642886bdacd719fb0fecb104538fbd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721015/size7/04642886bdacd719fb0fecb104538fbd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-648566","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-648566","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":911,"opdsId":"urn:uuid:SW-644158","title":"बंब : एक जादुई नळकांडी","authors":["Sayali Godse"],"language":"","readingLevel":"","publisher":"","summary":"अमिता आणि निनादला खूपच आश्चर्य वाटतंय. अताशा त्यांचा शेजारी विलास त्यांच्यासारखा सरपण गोळा करण्यासाठी फारसा जंगलात जात नाही आणि त्याची पनी वर्षाही तिचा सगळा वेळ चुलीसमोर पाणी तापवण्यासाठी घालवत नाही. त्यांच्या मुलांचं म्हणणं असं आहे, की त्यांच्याकडे एक “मोठ्ठी जादूई नळकांडी” आहे. तिच्यातून त्यांना हवं तेव्हा, पाणी लगेच गरम करून मिळतं. खरंच अशी जादूई नळकांडी असू शकते?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727685/size7/65b7fb7fd712915b6dca84af7129a461.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727685/size7/65b7fb7fd712915b6dca84af7129a461.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-644158","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-644158","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":912,"opdsId":"urn:uuid:SW-640655","title":"ही धरती माझी शाळा : दादाजी खोब्रागडे, भारताचा भातपुरुष","authors":["Mukund Taksale"],"language":"","readingLevel":"","publisher":"","summary":"‘समाजासाठी काही तरी करा,’ ही बाबासाहेब आंबेडकरांनी दिलेली साद दादाजी खोब्रागडे यांच्या कानावर बालपणीच पडली. त्यांची जमीन हीच त्यांची शाळा बनली. या भूमीनंच त्यांना संयम, सहानुभूती आणि प्रेमाचे धडे दिले; पण याहीपेक्षा महत्त्वाचं म्हणजे समाजासाठी काही तरी वेगळं करावं, मोठं स्वप्न बघावं अशी प्रेरणाही तिनं दिली.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722797/size7/ae11ecb26549da3c10901a89947d46b5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722797/size7/ae11ecb26549da3c10901a89947d46b5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-640655","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-640655","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":913,"opdsId":"urn:uuid:SW-594361","title":"कुणाचं बरं हे बटण?","authors":["Abhijit Pendharkar"],"language":"","readingLevel":"","publisher":"","summary":"Tinny Tim sets out on an adventure to return a lost button. Along the way he goes exploring, has a miraculous escape, and makes new friends.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/190288/size7/6210011290e01b032b1d1bb0cc288133.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/190288/size7/6210011290e01b032b1d1bb0cc288133.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-594361","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-594361","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":914,"opdsId":"urn:uuid:SW-635279","title":"कुरकुरी मुलगी","authors":["Neha Limaye"],"language":"","readingLevel":"","publisher":"","summary":"मोना सारखी कुरकुर करत असते. कधी अम्माच्या हातच्या चविष्ट खिचडीबद्दल, तर कधी दादाजींच्या लंबूटांग असण्याबद्दल. चला, भेटू एका कुरकुऱ्या मुलीला आणि तिच्या कुटुंबाला.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723583/size7/e929b19c45eb6edf8cbe74160163cb46.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723583/size7/e929b19c45eb6edf8cbe74160163cb46.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-635279","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-635279","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":915,"opdsId":"urn:uuid:SW-579291","title":"The Lost Ball","authors":["Abhijit Pendharkar"],"language":"","readingLevel":"","publisher":"","summary":"जामीला मित्रांबरोबर खेळायचं होतं. पण त्याच्या खोलीतल्या पसाऱ्यात त्याचा बॉल त्याला काही केल्या सापडेना! खेळायला जमलेले त्याचे मित्र त्याच्यासाठी थांबतील का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/93521/size7/495d9fd5d7c96ad806177b340988f891.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/93521/size7/495d9fd5d7c96ad806177b340988f891.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-579291","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-579291","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":916,"opdsId":"urn:uuid:SW-398766","title":"गोरिलाची पार्टी","authors":["Neeta Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"गोरिला आपल्या मित्रमैत्रिणींसोबत पार्टीसाठी अगदी सज्ज आहे. अशी पार्टी करण्यासाठी मुख्यत: काय हवे? खूप खूप रंगीबेरंगी टोप्या. चला, आपणही या गोरिलाला घरभर सगळीकडे पार्टीसाठीच्या टोप्या ठेवायला मदत करू या. वेगवेगळ्या दिशा, बाजू आणि पार्टीसाठीच्या गंमतीदार टोप्यांबद्दलचे एक छानसे पुस्तक.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/491328/size7/21e156f5c960f08498b5485296de5fe9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/491328/size7/21e156f5c960f08498b5485296de5fe9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-398766","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-398766","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":917,"opdsId":"urn:uuid:SW-314512","title":"दुग्गा","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"दुग्गाचा दिवस चित्तथरारक घटनांनी भरलेला असायचा. दिवसभर ती वेगवेगळे वास घ्यायची आणि विलक्षण गोष्टी पाहायची. कुठल्याही आनंदी कुत्रीसारखीच ती झोपायची, खायची आणि खेळत असायची. एके दिवशी तिचं आयुष्य पार उलटंपालटं झालं. काही समजायच्या आधीच ज्या जगात दुग्गा राहायची, ते दुग्गाचं जग अचानक बदलून गेलं. आसपासच्या दयाळू माणसांनी केलेली मदत, त्यांची सहानुभूती आणि घेतली गेलेली काळजी यांमुळे दुग्गाचा प्रवास पुन्हा एकदा प्रेम, उत्साह आणि करूणा यांनी भरलेल्या चांगल्या जगाकडे कसा झाला याची ही चित्रमय गोष्ट.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/481175/size7/02d36478346ebc81530ec4d3e795b92d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/481175/size7/02d36478346ebc81530ec4d3e795b92d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-314512","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-314512","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":918,"opdsId":"urn:uuid:SW-94633","title":"पैशाचे व्यवस्थापक","authors":["Milind Sangoram"],"language":"","readingLevel":"","publisher":"","summary":"‘रुपया पैसा’ ही मालिका मुलांना पैशाबाबत अनेक रोचक गोष्टी सांगणारी मालिका आहे. या मालिकेमुळे पैसे हुशारीने मिळवायचे आणि निगुतीने वापरण्याचे महत्त्व मुलांना कळेल.\nया पुस्तकात, कुबेर गट, धनाढ्य गट आणि चाणक्य गट काय करतात ते बघा. ते तुम्हाला पैशाची बचत करायला मदत करतील. हवे असतील तेव्हा कर्जाऊ पैसे देतील आणि पैसे वाढवून द्यायला मदत करतील. ज्यांच्याजवळ अगदी कमी रक्कम आहे ते लोकही व्यवसाय कसा चालू करतात?\nपैशाविषयी या आणि अशाच अनेक रंजक गोष्टी जाणून घेण्यासाठी वाचा - रुपया-पैसा मालिकेतील, पुस्तक ३ ‘पैशाचे व्यवस्थापक’.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/518442/size7/26b49def1d3fc5370d1ee1d5c48bf641.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/518442/size7/26b49def1d3fc5370d1ee1d5c48bf641.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-94633","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-94633","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":919,"opdsId":"urn:uuid:SW-594109","title":"पाच खांबी गाव","authors":["Abhijit Pendharkar"],"language":"","readingLevel":"","publisher":"","summary":"वीज विभागाने गावात विजेचे पाच खांब उभारले आणि गावकरी आनंदून गेले. पण पुढचं काम करण्यासाठी वीज विभागाचे लोक आले नाहीत तेव्हा, गावात फक्त पाच ओकेबोके खांब उरले. आता गावकरी काय करतील?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/99487/size7/a3392200ef25ae9427c2e9009d932dea.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/99487/size7/a3392200ef25ae9427c2e9009d932dea.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-594109","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-594109","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":920,"opdsId":"urn:uuid:SW-94607","title":"पैशाचे सुंदर जग!","authors":["Milind Sangoram"],"language":"","readingLevel":"","publisher":"","summary":"‘रुपया पैसा’ ही मालिका मुलांना पैशाबाबत अनेक रोचक गोष्टी सांगणारी मालिका आहे. या मालिकेमुळे पैसे हुशारीने मिळवायचे आणि निगुतीने वापरण्याचे महत्त्व मुलांना कळेल. पूर्वी नाणी कशाची बनलेली असत? पैसे कसे मिळवावे? पैशाची बचत कशी करावी? पैसे कसे वापरावेत? हातात पैसे नसताना फ्रिज खरेदी करता येतो का? पैशाविषयी या आणि अशा अनेक रंजक गोष्टी जाणून घेण्यासाठी वाचा - रुपया-पैसा मालिकेतील ‘पैशाचे सुंदर जग’ पुस्तक 1.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/521973/size7/c717236abc9f0de954dd4e1ee3789ee9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/521973/size7/c717236abc9f0de954dd4e1ee3789ee9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-94607","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-94607","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":921,"opdsId":"urn:uuid:SW-612292","title":"अंतराळातले नियम","authors":["Rupali Bhave"],"language":"","readingLevel":"","publisher":"","summary":"३,२, १... चला, अवकाशात झेप घ्या... आणि ग्रहांना भेटी द्या, तारे नव्यानं बघा, शिवाय इथले काही नियम समजून घ्या. हे नियम अवकाश आणि आपली पृथ्वी या दोन्हीही ठिकाणी पाळण्यासाठी अगदी सारखेच आहेत!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727675/size7/b04d6052ce0895f23058503ef7d9a648.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727675/size7/b04d6052ce0895f23058503ef7d9a648.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-612292","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-612292","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":922,"opdsId":"urn:uuid:SW-640716","title":"आम्हाला काय वाटतं ?","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"कोणती आहेत आपली स्वप्नं, आशा आणि आकांक्षा? सहा देशी चित्रकारांनी एकत्र येऊन त्या साऱ्यांचं चित्रांकन केलं आहे या खास पुस्तकात.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712719/size7/6ab6bcb0f21dc196c8e9dd3f6b219aff.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712719/size7/6ab6bcb0f21dc196c8e9dd3f6b219aff.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-640716","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-640716","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":923,"opdsId":"urn:uuid:SW-377745","title":"प्राण्यांच्या नख्या- अशा आणि तशा","authors":["Varsha Gajendragadkar"],"language":"","readingLevel":"","publisher":"","summary":"प्राण्यांच्या नख्या वेगवेगळ्या प्रकारच्या असतात व त्यांचा उपयोग ते वेगवेगळ्या कारणांनी करतात. चला, थोडा शोध घेऊ या.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495514/size7/8a5affd02839d9565fce0077a3244b6e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495514/size7/8a5affd02839d9565fce0077a3244b6e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-377745","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-377745","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":924,"opdsId":"urn:uuid:SW-95742","title":"पैशाचा अद्भुतरम्य प्रवास!","authors":["Milind Sangoram"],"language":"","readingLevel":"","publisher":"","summary":"‘रुपया पैसा’ ही मालिका मुलांना पैशाबाबत अनेक रोचक गोष्टी सांगणारी मालिका आहे. या मालिकेमुळे पैसे हुशारीने मिळवायचे आणि निगुतीने वापरण्याचे महत्त्व मुलांना कळेल. एका व्यक्तीकडून दुसऱ्या व्यक्तीकडे, एका ठिकाणाहून दुसऱ्या ठिकाणी असा पैशाचा प्रवास चालू असतो. पैसा कुठे साठवतात? मोठ्या बँकेत एखादी गुहा असते का? एटीएम म्हणजे काय? लोक कर का भरतात? पैशाविषयी या आणि अशाच अनेक रंजक गोष्टी जाणून घेण्यासाठी वाचा - रुपया-पैसा मालिकेतील, ‘पैशाचा अद्भुतरम्य प्रवास’ पुस्तक 2.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723603/size7/ac32ac4ee2b4016aa6e508125a0192d4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723603/size7/ac32ac4ee2b4016aa6e508125a0192d4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-95742","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-95742","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":925,"opdsId":"urn:uuid:SW-96412","title":"गणितातिल गमतीजमती-4: वेळ आणि चलन","authors":["Saurabhi Patil"],"language":"","readingLevel":"","publisher":"","summary":"हे जरी गणिताचे पुस्तक असले तरी वेगळे आहे. यात गणितांपेक्षा गोष्टीच जास्त आहेत. म्हणून या गोष्टी वाचा आणि आपल्या मेंदूला चालना द्या!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703454/size7/4635f366876fd787fef4f3c04925cec3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703454/size7/4635f366876fd787fef4f3c04925cec3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-96412","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-96412","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":926,"opdsId":"urn:uuid:SW-578710","title":"थं