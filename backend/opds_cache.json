rg.in/illustration_crops/179743/size7/a654b0074ddd5df4feccd29d7b3b57ee.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-46582","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-46582","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":191,"opdsId":"urn:uuid:SW-71750","title":"The Scavenger Hunt","authors":["Ajit Narra"],"language":"","readingLevel":"","publisher":"","summary":"Lajjo has to find all the items on her list in order to win Daadu’s game. The family is puzzled. Why is Daadu sending Lajjo on a scavenger hunt in the middle of a crisis?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715245/size7/125c121033c3f1d3ae6712079658c840.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715245/size7/125c121033c3f1d3ae6712079658c840.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-71750","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-71750","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":192,"opdsId":"urn:uuid:SW-33","title":"Not Now, Not Now!","authors":["Rohini Nilekani"],"language":"","readingLevel":"","publisher":"","summary":"The little boy in this story wants to do something now, but all his elders say NOT NOW! Do you get angry when someone says that to you?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/719385/size7/73ae500b660e2909d95b2ed5cc71f101.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/719385/size7/73ae500b660e2909d95b2ed5cc71f101.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-33","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-33","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":193,"opdsId":"urn:uuid:SW-60804","title":"Drip-Drop-Drip","authors":["Manisha Chaudhry"],"language":"","readingLevel":"100daysreadingcampaignPunjab2022","publisher":"","summary":"What is this strange sound you can hear in \nthe forest–Drip-Drop-Drip?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721648/size7/bf7c31d602d29510073b0f23cb0d1688.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721648/size7/bf7c31d602d29510073b0f23cb0d1688.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-60804","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-60804","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":194,"opdsId":"urn:uuid:SW-8881","title":"Turtle Story","authors":["Kartik Shanker"],"language":"","readingLevel":"","publisher":"","summary":"Under cover of darkness, baby olive ridley turtles hatch from sun-warmed eggs on remote beaches. One of them, the little hatchling who is the narrator of our story, is delighted to make it across the beach and into the ocean without losing her way or being captured by predators. \n\nBut can our little olive ridley survive the dangers of the ocean? Will she make it past the deadly sharks and the terrible fishing nets and reach adulthood? Will she ever have the pleasure of laying her own brood of eggs?\n\nFind out in this charming life story of an olive ridley turtle, and meet several other interesting creatures along the way.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/27753/size7/e21f0014824d4500d005ff02b9529442.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/27753/size7/e21f0014824d4500d005ff02b9529442.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-8881","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-8881","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":195,"opdsId":"urn:uuid:SW-60932","title":"Dance, Mihlali!","authors":["Matona Fatman"],"language":"","readingLevel":"","publisher":"","summary":"The day of the concert is approaching, and Mihlali is getting more and more nervous. Will she ever be ready to dance in front of all those people?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/130507/size7/abbca912f758719547f7dc1afe9eac68.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/130507/size7/abbca912f758719547f7dc1afe9eac68.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-60932","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-60932","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":196,"opdsId":"urn:uuid:SW-3787","title":"Long Live Friendship! A Humorous Play for Children","authors":["Meera Dixit"],"language":"","readingLevel":"","publisher":"","summary":"When Vikram falls sick, Yamraj thinks its time to take him in. Vikram’s maddeningly stubborn friends think otherwise. The play takes a serious issue and presents it in a light-hearted vein. Children can easily and quickly stage and self-direct this hilarious play. Perfect for annual school days and neighbourhood events.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/699246/size7/af9f6093a29e3d59668e6c35efe10c2a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/699246/size7/af9f6093a29e3d59668e6c35efe10c2a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-3787","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-3787","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":197,"opdsId":"urn:uuid:SW-33603","title":"Fire! Fire!","authors":["Aditi Ghosh"],"language":"","readingLevel":"","publisher":"","summary":"Ana misses Goa. But she finds her new home fascinating. Everything seems so different in noisy Mumbai. In some tall buildings, she sees speakers and showers. Strange! They don’t ever come on until...","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717034/size7/201d96d6b2f02a74a45fa386e61d59a3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717034/size7/201d96d6b2f02a74a45fa386e61d59a3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-33603","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-33603","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":198,"opdsId":"urn:uuid:SW-10398","title":"One by Two","authors":["Maya Bisineer"],"language":"","readingLevel":"","publisher":"","summary":"How do you share something fairly with a friend? How do you take one thing and divide it into two equal parts? Join Rani and Jiya at the fair where they use a simple trick called One-by-Two to share a delicious meal.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723972/size7/68be81afff6476c2e972c6dea33ed083.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723972/size7/68be81afff6476c2e972c6dea33ed083.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-10398","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-10398","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":199,"opdsId":"urn:uuid:SW-149","title":"Timmy and Pepe","authors":["Madhav Chavan"],"language":"","readingLevel":"","publisher":"","summary":"Come, listen to Timmy and Pepe talk to each other. Do you also like to talk to your pet?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/701010/size7/e47e8431f29c226becbf3dc0b7a82b99.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/701010/size7/e47e8431f29c226becbf3dc0b7a82b99.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-149","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-149","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":200,"opdsId":"urn:uuid:SW-37268","title":"It's a Ghost!","authors":["Alisha Berger"],"language":"","readingLevel":"","publisher":"","summary":"Once there was a ghost who loved to scare someone every day. One day, he decided to look for something easy to scare… like a mouse! Will the mouse be as frightened as everyone else?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/617117/size7/f46f95b0a9c9d93baa8531860a28a997.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/617117/size7/f46f95b0a9c9d93baa8531860a28a997.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-37268","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-37268","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":201,"opdsId":"urn:uuid:SW-49732","title":"A Stitch in Time","authors":["Himadri  Das","Veena Prasad"],"language":"","readingLevel":"","publisher":"","summary":"First, a ripped shirt and then, a faulty iron box. The day has just begun for Shyam. With everything going wrong one after the other, Shrisha takes him to a Repair Mela where you can fix almost anything.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717377/size7/de7ac270e794445be00068049e544ed0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717377/size7/de7ac270e794445be00068049e544ed0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-49732","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-49732","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":202,"opdsId":"urn:uuid:SW-47980","title":"Shoecat Thoocat","authors":["Shalini  Srinivasan"],"language":"","readingLevel":"","publisher":"","summary":"Kamala’s new shoecat attacks whoever it meets! Tomatoes, thathas, friends, teachers, goats… everyone hates it. What will they do now?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/158527/size7/3980efa22d78c2250c1298435f56e840.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/158527/size7/3980efa22d78c2250c1298435f56e840.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-47980","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-47980","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":203,"opdsId":"urn:uuid:SW-37230","title":"Tall and Short","authors":["Celia  Bolam"],"language":"","readingLevel":"","publisher":"","summary":"Can you tell which family members are tall and which are short? This book demonstrates the concept of opposites— tall and short— through the members of a child’s family.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/101345/size7/e64bf7a17d2acc3605b1e60a19301d27.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/101345/size7/e64bf7a17d2acc3605b1e60a19301d27.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-37230","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-37230","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":204,"opdsId":"urn:uuid:SW-111469","title":"The Sound of Water","authors":["Shalini  Srinivasan"],"language":"","readingLevel":"","publisher":"","summary":"Varsha and her Appa live near the forest. It has been a hot summer and Varsha is feeling the heat. One day she hears a strange noise and decides to investigate. Only she can hear the sound and wonders what it is. What will Varsha find and will Appa believe her?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721325/size7/07c19bca39403c868921d7fe61cc44d2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721325/size7/07c19bca39403c868921d7fe61cc44d2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-111469","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-111469","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":205,"opdsId":"urn:uuid:SW-19586","title":"Who is Afraid of the Rakshas Sweetie-Man?","authors":["Ranjit Lal"],"language":"","readingLevel":"","publisher":"","summary":"Samar and Nivya are terrified of the Rakshas Sweetie-Man. He looks scary, and oh, does he eat little puppies? When their six puppies run into the Rakshas Sweetie-Man’s shop, the twins must rescue them. But then they get the biggest surprise ever!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721915/size7/c10359f01d981cd18e162b1f51f2d1bc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721915/size7/c10359f01d981cd18e162b1f51f2d1bc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-19586","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-19586","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":206,"opdsId":"urn:uuid:SW-24191","title":"Uma Versus Upma","authors":["Meera Ganapathi"],"language":"","readingLevel":"","publisher":"","summary":"Uma never eats her breakfast. Instead, she just plays with it. Can anything be done to stop her from playing with her food?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/91617/size7/7665b5719e56df1b97c01a18608f9f09.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/91617/size7/7665b5719e56df1b97c01a18608f9f09.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-24191","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-24191","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":207,"opdsId":"urn:uuid:SW-326772","title":"Beauty Is Missing","authors":["Priya Kuriyan"],"language":"","readingLevel":"","publisher":"","summary":"Tessamma’s beloved buffalo is missing! No one knows what happened to her but constable Jincy is determined to find out. She goes all over the village, questioning people and looking for clues. Will Jincy be able to find Beauty the buffalo? The game is afoot in this mystery about a music-loving buffalo.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703483/size7/32d97f0835d6c7513042c8ab55b3ce74.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703483/size7/32d97f0835d6c7513042c8ab55b3ce74.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-326772","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-326772","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":208,"opdsId":"urn:uuid:SW-10730","title":"More or Less? Need to Guess!","authors":["Gayathri Tirthapura"],"language":"","readingLevel":"","publisher":"","summary":"So many mithai boxes to count, so little time! Can Ranjita and Vikram do it? Yes, using a cool math trick called 'Approximately More-or-Less'! Read this fun wedding story to learn the trick yourself!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712829/size7/da3cb47b4e548e2e6f4f4ebd366e9ac0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712829/size7/da3cb47b4e548e2e6f4f4ebd366e9ac0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-10730","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-10730","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":209,"opdsId":"urn:uuid:SW-11050","title":"Gul in Space","authors":["Richa  Jha"],"language":"","readingLevel":"","publisher":"","summary":"What would you like to do on your birthday? How about taking a walk in OUTER SPACE! Here’s a story that will make you jump with joy… and if there’s no gravity under you, you might just stay exactly where you are! Get ready to explore the space with Astronaut Gul.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712826/size7/58683be3e3871b08499fc6cb1786c206.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712826/size7/58683be3e3871b08499fc6cb1786c206.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-11050","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-11050","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":210,"opdsId":"urn:uuid:SW-25840","title":"It's Play Time","authors":["Neha Singh"],"language":"","readingLevel":"","publisher":"","summary":"Rahi and her classmates are getting ready for their school play. Everyone is excited and nervous\nabout their performance. Will everything go as planned?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/123538/size7/58b7c973afb2776c934b384c459d490d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/123538/size7/58b7c973afb2776c934b384c459d490d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-25840","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-25840","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":211,"opdsId":"urn:uuid:SW-61788","title":"How Pintu Found Pi","authors":["Sarat  Talluri Rao"],"language":"","readingLevel":"","publisher":"","summary":"Pintu is lonely in his new school. Whenever he approaches his classmates, they form a closed circle. Then Pintu finds pi.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/718341/size7/5ba950a3c80d17bc15f123072ca97a74.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/718341/size7/5ba950a3c80d17bc15f123072ca97a74.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-61788","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-61788","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":212,"opdsId":"urn:uuid:SW-336656","title":"Picnic on Grass","authors":["Venkataraghavan Subha Srinivasan"],"language":"","readingLevel":"","publisher":"","summary":"Grass can be of different kinds. It can be soft, it can be rough, you can smell it and even taste it.  Best of all is that you can picnic on grass.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/474156/size7/d3b59531e7aa166d232530da42547ac8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/474156/size7/d3b59531e7aa166d232530da42547ac8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-336656","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-336656","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":213,"opdsId":"urn:uuid:SW-353206","title":"The Birthday Menu","authors":["Meenu Thomas"],"language":"","readingLevel":"","publisher":"","summary":"It is Kanchi’s birthday and she can’t go out to her favourite restaurant. Knowing that baingan bharta is all she has to look forward to, she is really upset. But her neighbours in Sunrise Society know that the best way to turn things around is with a feast! A story about community, compassion, and the food we eat.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727417/size7/6a5199c6c3a470dbd30154529ea8a4bc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727417/size7/6a5199c6c3a470dbd30154529ea8a4bc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-353206","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-353206","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":214,"opdsId":"urn:uuid:SW-184","title":"Look At Me","authors":["Manisha Chaudhry"],"language":"","readingLevel":"100daysreadingcampaignPunjab2022","publisher":"","summary":"Meet the children in the book. They are just like you!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721874/size7/8ecac1b7b1c40058b7d2b62254e358d7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721874/size7/8ecac1b7b1c40058b7d2b62254e358d7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-184","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-184","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":215,"opdsId":"urn:uuid:SW-29919","title":"Teaching Pa","authors":["Amrutash Misra"],"language":"","readingLevel":"","publisher":"","summary":"Diya’s Pa has never gone to school. So she decides to teach him herself. Pa listens to her most of the time, but Maths Days are difficult. How does Diya manage?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/524659/size7/c55e8e922116b1ad507a3d2b05223006.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524659/size7/c55e8e922116b1ad507a3d2b05223006.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-29919","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-29919","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":216,"opdsId":"urn:uuid:SW-36947","title":"A Whistling Good Idea","authors":["Rahul Raghavan"],"language":"","readingLevel":"reading","publisher":"","summary":"Ma wants Nivi to turn off the pressure cooker after three whistles. But Nivi wants to read  her new book instead! Find out how she cleverly does both.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/713820/size7/735e2105b6ba7d1d28b34e8940ff584c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/713820/size7/735e2105b6ba7d1d28b34e8940ff584c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-36947","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-36947","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":217,"opdsId":"urn:uuid:SW-139495","title":"The Right Way School","authors":["Shabnam  Minwalla"],"language":"","readingLevel":"","publisher":"","summary":"The Right Way School has only the right way of doing things and that’s how Mrs Gambhir teaches as well. Until one day a girl with wild hair and endless curiosity joins the school and stumps everyone with her questions, her merry voice, and her behaviour. What will happen next?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/188969/size7/3bacc5d88dc24dcb3711be73fb8f289a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/188969/size7/3bacc5d88dc24dcb3711be73fb8f289a.jpg","acquisitions":[{"href":"https