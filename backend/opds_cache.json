ize7/6f439dc6767b16a5454d590c58cecae7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-48446","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-48446","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":291,"opdsId":"urn:uuid:SW-12993","title":"राजूचं पहिलं विमानोड्डाण","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"विमानात बसून उडायचं राजूचं स्वप्न होतं. आपल्या पहिल्या उड्डाणासाठी तो तयार होतो आहे. आपणही त्याच्या प्रवासात सामील होऊ या. राजूसाठी हा खरोखर एक खास दिवस आहे.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/713806/size7/2625fe2f51bccee02b4391276a85eca7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/713806/size7/2625fe2f51bccee02b4391276a85eca7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12993","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12993","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":292,"opdsId":"urn:uuid:SW-365245","title":"बोकड कुणाला मिळाला?","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"एकदा चिन्नासुर आणि चिकासुर या दोन असुरांना भटकणारा एक बोकड दिसला. दोघांनाही तो बोकड हवा होता. अखेर मसाला ताक पिण्याची स्पर्धा लावून त्यात जो जिंकेल त्याला त्याला तो मिळणार, असं ठरलं. चला, असुरांनी ताक पिऊन दाखवेपर्यंत आपण एकीकडे अपूर्णांक आणि दशांश संख्या शिकू या.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/477081/size7/dc85ca43c5000a1f7a9917528c6ca133.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/477081/size7/dc85ca43c5000a1f7a9917528c6ca133.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-365245","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-365245","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":293,"opdsId":"urn:uuid:SW-516","title":"नाचणारे मोर आणि भजी","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"ऋतुचक्र म्हणजे एका पाठोपाठ एक येणाऱ्या ऋतूंची मालिका. भारताच्या विविध प्रांतात निरनिराळ्या पद्धतीनं प्रत्येक ऋतूचं आगमन साजरं केलं जातं. निसर्गाची मोहक रुपं, रंगांची उधळण, उत्सवी वातावरण, विविध चालीरिती यांची मजा लुटू ऋतुचक्र या मालिकेत.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/702426/size7/596c856e3620237e4a7343ecb82dac99.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/702426/size7/596c856e3620237e4a7343ecb82dac99.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-516","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-516","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":294,"opdsId":"urn:uuid:SW-267497","title":"पानांचे किती रंग आणि ढंग","authors":["Rupali Bhave"],"language":"","readingLevel":"","publisher":"","summary":"काही पानं छोटी असतात, तर काही मोठी. काही गोड असतात, तर काही कडू. आपल्या आजूबाजूला खूप वेगवेगळ्या प्रकारची पानं असतात. पानांबद्दल सर्व काही जाणून घेण्यासाठी या पुस्तकाच्या पानांची सफर करूया, चला!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725226/size7/853dcaabef8ae2b388b4ccc36003a038.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725226/size7/853dcaabef8ae2b388b4ccc36003a038.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-267497","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-267497","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":295,"opdsId":"urn:uuid:SW-45129","title":"बागेत कसं खेळाल? असं का तसं? फरक ओळखा","authors":["Sumati Joshi"],"language":"","readingLevel":"","publisher":"","summary":"बागेत जाऊन आपण खेळतो, बागडतो, उड्या मारतो, स्केटिंग करतो, झोके घेतो, धावाधाव करतो. तिथं आपल्याला नवे मित्र-मैत्रिणी मिळतात. कधी कधी आपण तिथं कचरा टाकतो, भांडाभांडी  करतो आणि ढकलाढकली करतो. पालक किंवा शिक्षक यांच्या मदतीनं फरक ओळखा आणि तुम्हाला बागेत कशा प्रकारे खेळायला आवडेल, ते शोधा.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/89002/size7/d5856c87ec927fb94e1ec33e97001b1f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/89002/size7/d5856c87ec927fb94e1ec33e97001b1f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-45129","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-45129","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":296,"opdsId":"urn:uuid:SW-368136","title":"एकूण किती?","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"सरपटणाऱ्या गोगलगायी, बागडणारी फुलपाखरं, चिखलात लोळणारी डुकरं... या पुस्तकात खूप सारे प्राणी आहेत, बरं का! तुम्हाला ते सगळे मोजता येतील का? बेरीज कशी करायची, हे शिकवणारं हे एक छान, सोपं पुस्तक!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527516/size7/2ce50b116586b7652ec79c738028bc67.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527516/size7/2ce50b116586b7652ec79c738028bc67.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-368136","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-368136","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":297,"opdsId":"urn:uuid:SW-12818","title":"लपाछपी","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"मित्रांबरोबर लपाछपी खेळताना तुम्ही कुठे लपता? लपायच्या काही मस्त कल्पना  या गोष्टीत सापडतील."