y/pdf/SW-107656","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-107656","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":452,"opdsId":"urn:uuid:SW-38906","title":"विमलाचा केक इतका लुसलुशीत कसा?","authors":["Sai Keskar"],"language":"","readingLevel":"","publisher":"","summary":"चिन्नी आणि तिचे बाबा, त्यांच्या बेकरीत चिन्नीच्या मैत्रिणीसाठी केक करतात. केक इतके लुसलुशीत कसे होतात? त्यांना कोण फुगवतं? चला! शोधून काढूया!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725317/size7/bbd2c0e9207e71489f941e2cfc06cf8e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725317/size7/bbd2c0e9207e71489f941e2cfc06cf8e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-38906","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-38906","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":453,"opdsId":"urn:uuid:SW-377750","title":"पिवळी पृथ्वी, तपकिरी पृथ्वी","authors":["Faruk S. Kazi"],"language":"","readingLevel":"","publisher":"","summary":"अविला भटकंती करून नवनव्या गोष्टी धुंडाळायला आवडतं. तो बियांची वर्गवारी करतो. डबक्यातल्या पाण्यात हुंदडतो. चला तर, अविला आवडणाऱ्या पृथ्वीवरच्या वेगवेगळ्या ठिकाणी जाऊन निसर्गातल्या रंगीबेरंगी घडामोडी अनुभवूया.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/455342/size7/109881e28a7c44f982a84f1d16ab31d2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/455342/size7/109881e28a7c44f982a84f1d16ab31d2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-377750","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-377750","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":454,"opdsId":"urn:uuid:SW-26647","titl