/illustration_crops/727499/size7/fa6b5f562a23f9008f72c484ef881eea.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-399430","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-399430","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":441,"opdsId":"urn:uuid:SW-350191","title":"नाही माहीत","authors":["Madhuri Purandare"],"language":"","readingLevel":"","publisher":"","summary":"सकाळ झाली की अपूला खूप छान वाटतं. सगळं नवं नवं, ताजं दिसतं. पण मग दुपार होते, नंतर संध्याकाळ होते आणि बघता बघता रात्र होते. अपूला काहीतरी वेगळं वाटतं. पण का ते सांगताच येत नाही. त्याला कुणी मदत करतं का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727485/size7/0d6c5fe635bc010c15e2c939365ddff2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727485/size7/0d6c5fe635bc010c15e2c939365ddff2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-350191","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-350191","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":442,"opdsId":"urn:uuid:SW-224","title":"गरम चहा आणि दुलईची उब","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"थंडीतले झकास कपडे बाहेर दिसायला लागले आहेत. भाजलेल्या शेंगांचा मस्त वास दरवळतोय. बोलताना तोंडातून वाफ बाहेर येते आहे. बघू या बरं, हिवाळा आणखी काय काय गमती घेऊन आला आहे ते!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/702420/size7/42fc34e6412fa8bae45d57c80db0b6f3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/702420/size7/42fc34e6412fa8bae45d57c80db0b6f3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-224","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-224","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":443,"opdsId":"urn:uuid:SW-641","title":"कल्लूचे किस्से 1 थापाड्या कल्लू","authors":["Sucheta Kadethankar"],"language":"","readingLevel":"","publisher":"","summary":"कल्लू आणि त्याच्या मित्रांच्या टोळक्याचे रोज काहीतरी नवे गमतीदार उद्योग आणि कारनामे चालू असतात. त्यांच्या या खजुरिया गावात तुमचं स्वागत. कधी ही मुलं गावातल्या एखाद्या प्रथेच्या विरोधात प्रश्न विचारतात, कधी अरेरावी करणाऱ्या एखाद्याला वठणीवर आणतात, कधी फक्त नेहमीची कामं करतात. पण ही टोळी सतत काही ना काही करत असते. गावात आनंदानं भटकणाऱ्या, काहीतरी नवं शोधणाऱ्या आणि त्यातनं शिकत जाऊन शहाणं होणाऱ्या  या टोळक्यात सामील व्हा आणि बघा कशी मजा येते.\nकल्लूला शाळेत जायला आजही उशीर झालाय! काय थाप मारावी बरं? शेळी पळून गेली, आई किंवा भाऊ आजारी पडला...? लवकरात लवकर काहीतरी चांगली थाप आणि त्याची गोष्ट रचायला हवी. जी सगळ्यांना पटेल. सुचते  का त्याला अशी थाप?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703474/size7/aebdec85f3efee3cc067e575ca2d0d42.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703474/size7/aebdec85f3efee3cc067e575ca2d0d42.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-641","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-641","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":444,"opdsId":"urn:uuid:SW-139","title":"येतं आणि येत नाही","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"हे छोटं पुस्तक तुम्हाला वाचता येतं. ज्या  लहान मुलांना वाचता येत नाही, त्यांना यातल्या  मस्त चित्रांची मजा घेता येते.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/704392/size7/08e45dddd1c76f90db3c17f430dfae3b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/704392/size7/08e45dddd1c76f90db3c17f430dfae3b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-139","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-139","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":445,"opdsId":"urn:uuid:SW-38109","title":"आले का रे सगळे?","authors":["Suneeta  Katti"],"language":"","readingLevel":"","publisher":"","summary":"नीना आई-बाबांबरोबर कोलकता कायमचं सोडून दिल्लीला रहायला निघालीये. तिला हे मुळीच आवडलेलं नाहीये. आगगाडीच्या प्रवासात आई-बाबांना तिची कळी खुलवता येईल का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527558/size7/d2ca9b60f3812f6cfe8931703ea209ee.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527558/size7/d2ca9b60f3812f6cfe8931703ea209ee.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-38109","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-38109","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":446,"opdsId":"urn:uuid:SW-30078","title":"जड काय नि हलकं काय?","authors":["Sai Keskar"],"language":"kg","readingLevel":"","publisher":"","summary":"एखादा खडा पिसापेक्षा वजनदार असतो, पण तोच मोठ्या दगडापेक्षा हलका असतो. मग खडा वजनदार आहे की हलकाफुलका? आपण तो खडा नक्की किती जड किंवा किती हलका आहे, हे सांगू शकतो का? या आणि अशा कितीतरी वजनाबद्दलच्या प्रश्नांची उत्तरं या मजेदार पुस्तकात मिळवा.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/714192/size7/f84b89b4e29caf6ef8a5b8b5e542bf4c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/714192/size7/f84b89b4e29caf6ef8a5b8b5e542bf4c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-30078","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-30078","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":447,"opdsId":"urn:uuid:SW-43346","title":"लाल परी","authors":["Vandana Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"लहानग्या मित्तोला गाड्या प्रचंड आवडतात आणि तिला त्यांच्याविषयी सगळी माहितीही आहे. तिला स्वप्नात देखील गाड्याच दिसतात. एके दिवशी तिला एक लाल परी भेटते. अगदी वेगळीच असते ही गाडी. लाल परी ज्या गोष्टी करू शकते त्या इतर कोणत्याही गाड्या करू शकत नाहीत.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723056/size7/138cccb6d8231292bbf0af57dc90a152.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723056/size7/138cccb6d8231292bbf0af57dc90a152.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-43346","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-43346","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":448,"opdsId":"urn:uuid:SW-377678","title":"माईंनी उभं केलेलं विश्व","authors":["Sai Keskar"],"language":"","readingLevel":"","publisher":"","summary":"स्वतःच रचना करून बांधलेल्या कॉलनीमध्ये माई राहातात. तिथे प्रेम आणि गोपी ही दुक्कल लपंडाव खेळत असताना त्यांना लपण्याच्या नवीन नवीन जागा सापडतात.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/458010/size7/91da2ed79918df599ea4cfc10a43f642.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/458010/size7/91da2ed79918df599ea4cfc10a43f642.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-377678","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-377678","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":449,"opdsId":"urn:uuid:SW-30068","title":"इंद्रधनुषी सांबार","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"भाव्या आणि तिची आजी आज काय खाणार आहेत बरं ? अर्थातच भाव्याचा आवडता पदार्थ-इंद्रधनुषी सांबार! चला, आजी आणि भाव्याच्या या रंगीब