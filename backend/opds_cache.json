/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":912,"opdsId":"urn:uuid:SW-649610","title":"ಪುಸ್ತಕಗಳಿಂದ ತುಂಬಿದ ಮನೆ","authors":["Bhoomi Biligere"],"language":"","readingLevel":"reading","publisher":"","summary":"ಪುಸ್ತಕಗಳಿಂದ ತುಂಬಿದ ಮನೆ ಎಂದರೆ, ಅದೊಂದು ಮಾಯಾಲೋಕ. ಕತೆಗಳಿಂದ ತುಂಬಿದ ಮನೆಯಲ್ಲಿ ಭರವಸೆಯ ಬೆಳಕಿದೆ. ದಾದು ಆಸ್ಪತ್ರೆಯಲ್ಲಿ ಮಲಗಿದ್ದರೂ ಸಹ, ಪುಸ್ತಕಗಳು ಒಂದು ಚಿರಪರಿಚಿತ ಅನ್ಯೋನ್ಯತೆಯ ವಾತಾವರಣವನ್ನು ನೆನಪಿಸುತ್ತವೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/744442/size7/bee736646c9dd495cb81d3b099ff6ea3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/744442/size7/bee736646c9dd495cb81d3b099ff6ea3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-649610","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-649610","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":913,"opdsId":"urn:uuid:SW-473120","title":"ಮಾವು ಹಂಚೋಣ","authors":["Parimala Desai"],"language":"","readingLevel":"","publisher":"","summary":"ಶಿಶುವಿಹಾರಕ್ಕೆ ಸೇರಿದ ಮೊದಲ ದಿನವೇ ನಾಲ್ಕು ಮಕ್ಕಳು ತಮ್ಮ ಮನೆಯ ಹಿಂದಿನ ಕೈ ತೋಟಗಳಲ್ಲಿ ಒಂದೊಂದು ಮಾವಿನ ಸಸಿ ನೆಟ್ಟರು. ಇವರು 4ನೇ ತರಗತಿ ಮುಗಿಸುವ ಹೊತ್ತಿಗೆ ಅವರು ನೆಟ್ಟ ಮರಗಳೂ ಹಣ್ಣು ಬಿಟ್ಟಿದ್ದವು. ಗಣಿತದ ಸಹಾಯದಿಂದ ಆ ಹಣ್ಣುಗಳನ್ನು ಈ ನಾಲ್ವರೂ ಸ್ನೇಹಿತರು ಎಣಿಸಿ, ಹಂಚಿದ್ದು ಹೇಗೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/520239/size7/793388c3efbc738ab6d8d638e891e3b1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/520239/size7/793388c3efbc738ab6d8d638e891e3b1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-473120","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-473120","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":914,"opdsId":"urn:uuid:SW-640027","title":"ಗಿಲಿ ಗಿಲಿಯಕ್ಕ ಇಲ್ಲಿ ನೋಡಕ್ಕಾ...","authors":["Navika"],"language":"","readingLevel":"","publisher":"","