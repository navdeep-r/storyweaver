ry/epub/SW-332719","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":404,"opdsId":"urn:uuid:SW-209539","title":"पूस की रात","authors":["Munshi Premchand"],"language":"","readingLevel":"","publisher":"","summary":"हल्कू किसान और उसकी पत्नी मुन्नी ने बड़ी मुश्किल से तीन रुपये जमा किए थे। इन तीन रुपयों से वे एक कंबल खरीदना चाहते थे पर कर चुकाने के लिए उन्हें यह रुपये सहना को देने पड़ते हैं। रात में खेत की रखवाली के दौरान हल्कू ठंड से काँपता है। आग जलाकर किसी तरह वह ठंड से राहत पाने की कोशिश करता है। चादर के अंदर सोने के बाद नीलगायें उसकी पूरी फ़सल बर्बाद कर जाती हैं पर पूस की उस रात मे वह उठने की हिम्मत नहीं कर पाता। सुबह मुन्नी द्वारा फसल की बर्बादी के विषय में पूछने पर वह पेट दर्द का बहाना बना देता है। फसल की बर्बादी के दुख से ज़्यादा उसे इस बात का संतोष है कि ऐसी सर्द रात में उसे खेत में सोना नहीं पड़ेगा। गरीब ग्रामीण किसान पर मौसम की मार किस प्रकार पड़ती है, यह कहानी उसकी तरफ इशारा करती है।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/526248/size7/acab9b0287eedc53bcb148e61a97c46b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/526248/size7/acab9b0287eedc53bcb148e61a97c46b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-209539","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-209539","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":405,"opdsId":"urn:uuid:SW-44729","title":"पिशी और मैं","authors":["Deepa Tripathi"],"language":"","readingLevel":"","publisher":"","summary":"छुटकू अपनी पिशी, यानी बुआ के साथ पैदल सैर करके लौटता तो उसके पास बातों का भंडार होता। एक बच्चे के नज़रिये से एक बुआ और उनके भतीजे के सीधे-सरल रिश्ते की दिल को छू लेने वाली कहानी है यह।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117615/size7/2b5f77b28bb196dfb73d2b136890b5b0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117615/size7/2b5f77b