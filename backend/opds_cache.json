.org/acquisition"}]},{"id":684,"opdsId":"urn:uuid:SW-248905","title":"धागे से कपड़े तक","authors":["Kusum  Singh"],"language":"","readingLevel":"","publisher":"","summary":"मामू ने सलमा और असलम को प्राकृतिक और सिंथैटिक धागों के बारे में क्या बताया| जानने के लिए कहानी पढ़े|","coverUrl":"https://static.storyweaver.org.in/illustration_crops/420601/size7/6fd7662fc1c97b8dda8d1a0b1ce70652.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/420601/size7/6fd7662fc1c97b8dda8d1a0b1ce70652.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-248905","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-248905","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":685,"opdsId":"urn:uuid:SW-125681","title":"फुलसुंगनी पक्षी खाते ही क्यों रहते हैं ?","authors":["Nirmala Shukla"],"language":"","readingLevel":"","publisher":"","summary":"क्या आपने कभी नन्ही रंग-बिरंगी पक्षियों को बगीचे में फूलों से रस पीते हुए देखा है? आपको क्या लगता है उन्हें उड़ने के लिए ऊर्जा कहाँ से मिलती है? चलिए फुलसुंगनी पक्षी लोटन और लिली के साथ इसका पता लगाते हैं!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/182229/size7/d1128f16e5c04c2aad8cb4486a209f1e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/182229/size7/d1128f16e5c04c2aad8cb4486a209f1e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-125681","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-125681","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":686,"opdsId":"urn:uuid:SW-17395","title":"कितनी बड़ी माचिस!","authors":["Manisha Chaudhry"],"language":"","readingLevel":"","publisher":"","summary":"प्रेम और उसके साथियों को एक छोटी सी डिबिया को ले कर एक बड़ा काम करने को दिया गया। क्या आप भी उनके जैसा काम कर के देखना चाहेंगे?","cover