":"https://static.storyweaver.org.in/illustration_crops/718097/size7/96641d24388cc30887da384c9724904e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-63810","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-63810","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":759,"opdsId":"urn:uuid:SW-148755","title":"फोनकॉलचा प्रवास होतोतरी कसा?","authors":["Siddharth Kelkar"],"language":"","readingLevel":"","publisher":"","summary":"आपण जेव्हा फोन करतो, तेव्हा आपला आवाज दूरदूरच्या ठिकाणांपर्यंत पोहोचू शकतो. आवाजाचा हा दूरवरच्या अंतरांपर्यंतचा प्रवास मोबाईल फोनमुळे कसा शक्य होतो? चला, जाणून घेऊया या रंजक पुस्तकात.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/216365/size7/d4a5d158d2688512fdccc901a63c125c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/216365/size7/d4a5d158d2688512fdccc901a63c125c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-148755","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-148755","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":760,"opdsId":"urn:uuid:SW-136439","title":"मेट्रोची सफर","authors":["Faruk S. Kazi"],"language":"","readingLevel":"","publisher":"","summary":"जेबा आणि तिचे अब्बू कुतुबमिनार पाहायला निघाले आहेत. ते मेट्रोमधून जाणार आहेत. चला तर, आपणही जाऊ त्यांच्याबरोबर.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/710482/size7/4e10fc23077d8d5cf155445b7b23d1e7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/710482/size7/4e10fc23077d8d5cf155445b7b23d1e7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-136439","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-136439","type":"appl