89c784b24f7f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-4964","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-4964","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":413,"opdsId":"urn:uuid:SW-223596","title":"ಹಾವು","authors":["Manjunath B G"],"language":"","readingLevel":"","publisher":"","summary":"ಹಾವು ಏನೇನು ಮಾಡುತ್ತದೆ ಎಂದು ನಿಮಗೆ ಗೊತ್ತಿದೆಯೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283197/size7/6e07d8fa9570c002026762f8e7499b8d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283197/size7/6e07d8fa9570c002026762f8e7499b8d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-223596","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-223596","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":414,"opdsId":"urn:uuid:SW-48487","title":"ನೀನು ಮೀನೇ?","authors":["Sinchana Shantharaj"],"language":"","readingLevel":"","publisher":"","summary":"ಕಬ್ಬಿಣ, ಸ್ಪಂಜು, ಜೆಲ್, ಪ್ಲಾಸ್ಟಿಕ್ಕಿನಿಂದ ಮಾಡಿದ ಮೀನುಗಳು ಸಮುದ್ರದಲ್ಲೂ ಈಜುತ್ತವೆ, ಇವು ಸಮುದ್ರಗಳ್ಳರನ್ನು ಹಿಡಿಯುತ್ತವೆ! ನೀವೇನಾದರೂ ಈ ಮೀನುಗಳನ್ನು ಕಂಡಿರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717378/size7/e2c34ddac758c05b4e233ae038b4c4ed.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717378/size7/e2c34ddac758c05b4e233ae038b4c4ed.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-48487","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-48487","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":415,"opdsId":"urn:uuid:SW-451805","title":"ಉತ್ತರ, ದಕ್ಷಿಣ, ಪೂರ್ವ, ಪಶ್ಚಿಮ","authors":["G W Carlo"],"language":"","readingLevel":"","publisher":"","summary":"ಶಾನಾ, ತನ್ನ ತಂದೆ-ತಾಯಿಯ ಜೊತೆಯಲ್ಲಿ ಭಾರತದ ವಿವಿಧ ಭೂಭಾಗಗಳಿಗೆ ಪ್ರವಾಸ ಹೊರಟಿದ್ದಾಳೆ. ತನ್ನ ಪ್ರವಾಸದ ದಿನಚರಿಯನ್ನು ಶಾಲೆಯ ಸ್ನೇಹಿತರಿಗೆ ಪತ್ರ ಮುಖೇನ ದಾಖಲಿಸಿದ್ದಾಳೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/508948/size7/47c601170f2cd0624cf961fb4cfb77a1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/508948/size7/47c601170f2cd0624cf961fb4cfb77a1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-451805","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-451805","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":416,"opdsId":"urn:uuid:SW-24657","title":"ಕಡಲ ತೀರದಲ್ಲೊಂದು ಬಿಲ","authors":["Brinda N Rao"],"language":"","readingLevel":"","publisher":"","summary":"ಮಿಸ್ ಬ್ಯಾಂಡಿಕೂಟ ಬೆಂಗಾಲೆನ್ಸಿಸ್ ಸಾಧಾರಣ ಮಖ್ಮಲ್ ಹೆಗ್ಗಣ ಅಲ್ಲ. ಅವಳಿಗೆ ಯಾವಾಗಲೂ ತನ್ನ ಸುತ್ತಲಿನ ಪ್ರತಿಯೊಂದನ್ನು ಗಮನಿಸುವ ಆಸೆ. ಪ್ರತಿ ರಾತ್ರಿ ಅವಳು ಬಿಲ ತೋಡುವ ಸಮಯದಲ್ಲಿ ಬೇಕಾಗಬಹುದಾದ ತಂಪು ಕನ್ನಡಕ, ದುರ್ಬೀನು, ಭೂತಗನ್ನಡಿ ಅಲ್ಲದೇ ತನಗೆ ಪ್ರಿಯವಾದ ಬ್ಯಾಂಡೆಜ್ ಪ್ಲಾಸ್ಟರ್ ಗಳನ್ನು ತನ್ನ ಬ್ಯಾಗಿನಲ್ಲಿ ತುಂಬಿಕೊಳ್ಳುತ್ತಾಳೆ. “ನಮ್ಮಂಥವರು ಯಾವಾಗಲೂ ಎಲ್ಲದಕ್ಕೂ ಸಿದ್ಧವಾಗಿರಬೇಕು” ಎಂದು ಅವಳು ಹೇಳುತ್ತಾಳೆ. ಪ್ರತೀ ರಾತ್ರಿ ಅವಳು ಹೊಸ ದಿಕ್ಕಿನಲ್ಲಿ ಕೊರೆಯುತ್ತಾಳೆ, ಪ್ರತಿದಿನ ಹೊಸ ಜಾಗ ಸೇರುತ್ತಾಳೆ. ಅಲ್ಲಿ ಆಹಾರ ಸೇವಿಸಿ, ಸ್ವಲ್ಪ ವಿಶ್ರಮಿಸಿ, ಸಂಜೆ ವೇಳೆಗೆ ಹೊಸ ಬಿಲ ಕೊರೆಯುತ್ತಾಳೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117644/size7/345aa877047222aeb24a3b5c333a5da8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117644/size7/345aa877047222aeb24a3b5c333a5da8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-24657","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-24657","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":417,"opdsId":"urn:uuid:SW-267742","title":"ಹಕೀಮರ ಬಿಕ್ಕಳಿಕೆ","authors":["Dr. Chaitra K S"],"language":"","readingLevel":"","publisher":"","summary":"ರಂಜಾನ್ ಸಮಯದಲ್ಲಿ ಹಕೀಮ್ ಸಾಹೇಬರಿಗೆ ಒಂದೇ ಸಮ ಬಿಕ್ಕಳಿಕೆ! ಅದನ್ನು ಹೋಗಲಾಡಿಸಲು ಅವರು ನೀರು ಕುಡಿಯುವಂತಿಲ್ಲ. ಹಕೀಮ್ ಸಾಹೇಬರು ಏನು ಮಾಡುವರು? ಅವರ ರೋಗಿಗಳು ತಮ್ಮ ಪ್ರೀತಿಯ ಡಾಕ್ಟರಿಗೆ ಸಹಾಯ ಮಾಡಬಲ್ಲರೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495600/size7/5fdb186c7a37dff48a512042343b3013.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495600/size7/5fdb186c7a37dff48a512042343b3013.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-267742","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-267742","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":418,"opdsId":"urn:uuid:SW-99603","title":"ನನ್ನ ಅಣ್ಣನ ಗಾಲಿಕುರ್ಚಿ","authors":["Swati Pandit"],"language":"","readingLevel":"","publisher":"","summary":"ದುರ್ವ ಮತ್ತು ಧ್ರುಬೊನ ಜೊತೆ ಗಾಲಿಕುರ್ಚಿಯ ಪರಿಚಯ ಮಾಡಿಕೊಳ್ಳೋಣ ಬನ್ನಿ. ಪಾರ್ಕು, ಸಂತೆ… ಹೀಗೆ ಅವರೆಲ್ಲೇ ಹೋದರೂ ಕೀಟಲೆಗೇನು ಕಡಿಮೆ. ಜೊತೆಜೊತೆಗೆ ಬೆಳೆವ ಅಣ್ಣ, ತಂಗಿಯರು ಮಾಡೋದು ಅದನ್ನೇ ತಾನೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495678/size7/30c9c6f01105d7fa1d9b37bd919d931f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495678/size7/30c9c6f01105d7fa1d9b37bd919d931f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-99603","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-99603","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":419,"opdsId":"urn:uuid:SW-432993","title":"ಪುಟ್ಟ ಲೀಲಾ ಸೈಕಲ್ ಕಲಿತಳು!","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಸೈಕಲ್‌ನಲ್ಲಿ ಶಾಲೆಗೆ ಹೋಗುವುದು ಮಜವಾಗಿರತ್ತೆ! ಆದರೆ, ಅದಕ್ಕೆ ಮೊದಲು ಸೈಕಲ್ ಕಲಿಯಬೇಕು. ಪುಟ್ಟ ಲೀಲಾ ಸೈಕಲ್ ಕಲಿತಳಾ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727486/size7/d067fd7c3005a059579ea82634ad29fa.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727486/size7/d067fd7c3005a059579ea82634ad29fa.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-432993","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-432993","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":420,"opdsId":"urn:uuid:SW-152737","title":"ಡೈನೋಸಾರ್‌ಗಳ ಲೋಕ","authors":["Keshava Moorthy C G"],"language":"","readingLevel":"","publisher":"","summary":"ಭೂಮಿಯ ಮೇಲೆ ಮಾನವರ ವಿಕಾಸಕ್ಕಿಂತಲೂ ಮುಂಚೆಯೇ, ಡೈನೋಸಾರ್‌ಗಳು ಸಂಚರಿಸುತ್ತಿದ್ದವು. ಬನ್ನಿ, ಈ ಅದ್ಭುತವಾದ \nಸರೀಸೃಪಗಳ ಬಗ್ಗೆ ಮತ್ತಷ್ಟು ತಿಳಿದುಕೊಳ್ಳೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715618/size7/b5a7b07919a59bf4a6e9c6b95f96544f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715618/size7/b5a7b07919a59bf4a6e9c6b95f96544f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-152737","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-152737","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":421,"opdsId":"urn:uuid:SW-32801","title":"ಹಾರಾಡು ಅಂತರಿಕ್ಷದಲ್ಲಿ","authors":["Kollegala Sharma"],"language":"","readingLevel":"","publisher":"","summary":"ಭೂಮಿಯಲ್ಲಿ ಜನಿಸಿದ ಎರಡು ಹಣ್ಣು ನೊಣಗಳು ಅಂತರಿಕ್ಷದಲ್ಲಿ ಬೆಳೆಯುತ್ತವೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/724110/size7/b2d320b4b71aac07a42a43edacc77861.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/724110/size7/b2d320b4b71aac07a42a43edacc77861.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-32801","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-32801","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":422,"opdsId":"urn:uuid:SW-53435","title":"ಕಪ್ಪುರಂಧ್ರದ ಅಂಚಿನಲ್ಲಿ...","authors":["Tanuja Jakkannavar"],"language":"","readingLevel":"","publisher":"","summary":"ಭೂಮಿಯಿಂದ ಮೂವರು ಸ್ನೇಹಿತರು ರಾಕೆಟ್‍ನಲ್ಲಿ ಸೌರಮಂಡಲ ಪ್ರವಾಸಕ್ಕೆ ಹೋಗುತ್ತಾರೆ. ಇದ್ದಕ್ಕಿದ್ದಂತೆ ಅವರನ್ನು ಒಂದು ಕಪ್ಪುರಂಧ್ರ ಎಳೆಯುತ್ತದೆ. ಏನದು? ಅವರು ಬಚಾವಾಗಿ ಬರುತ್ತಾರೆಯೆ? ಬನ್ನಿ ನಾವೂ ಅವರ ಈ ಸಾಹಸದಲ್ಲಿ ಪಾಲ್ಗೊಳ್ಳೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717893/size7/fd72155d5f986ecb1b1e0afa27f5da77.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717893/size7/fd72155d5f986ecb1b1e0afa27f5da77.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-53435","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-53435","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":423,"opdsId":"urn:uuid:SW-55766","title":"ಸುಂದರಿಯನ್ನು ಕಂಡಿರಾ?","authors":["Sinchana Shantharaj"],"language":"","readingLevel":"","publisher":"","summary":"ದೀನಾಳ ಗೆಳತಿ ಸುಂದರಿ ಅಡಗಿಕೊಂಡಿದ್ದಾಳೆ. ಅವಳನ್ನು ಹುಡುಕಲು ಸಹಾಯ ಮಾಡುವಿರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727061/size7/136f05ee6d48dd5d7c58d50da93c79cd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727061/size7/136f05ee6d48dd5d7c58d50da93c79cd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-55766","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-55766","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":424,"opdsId":"urn:uuid:SW-4092","title":"ಮಿಂಚುಹುಳುವಿನಂತೆ ನಾವೇಕೆ ಮಿಂಚುವುದಿಲ್ಲ?","authors":["Kavitha  Muchandi"],"language":"","readingLevel":"","publisher":"","summary":"ಮಿಂಚು ಹುಳುಗಳನ್ನು ಮಿಂಚು ತಿಗಣೆಗಳು ಎಂದೂ ಕರೆಯುತ್ತಾರೆ ಎಂಬುದು ನಿಮಗೆ ಗೊತ್ತೇ? ಮರಿ ಮಿಂಚು ಹುಳಗಳು ಮಿಂಚಿನ ಬೆಳಕಿಂದ ಶತ್ರುಗಳನ್ನು ಓಡಿಸುತ್ತವೆ ಎಂಬುದೇನಾದರೂ ಗೊತ್ತಿತ್ತೆ? ಕತ್ತಲನ್ನು ಬೆಳಕಾಗಿಸುವ ಈ ಮಿಂಚು ಹುಳಗಳ ಬಗ್ಗೆ ಮತ್ತಷ್ಟು ತಿಳಿಯಲು ಈ ಪುಸ್ತಕ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712545/size7/7b77bada31449b4371f8220006d7b99f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712545/size7/7b77bada31449b4371f8220006d7b99f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-4092","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-4092","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":425,"opdsId":"urn:uuid:SW-60927","title":"ನೆನಪಿದೆಯ?","authors":["Noorjahan Devihosur"],"language":"","readingLevel":"","publisher":"","summary":"ಅಮ್ಮು ಇನ್ನೇನು ವೇದಿಕೆ ಹತ್ತಬೇಕು. ಅವಳ ತಲೆಯಲ್ಲಿ ಸಾಲುಗಳೆಲ್ಲ ಅದಲು ಬದಲಾಗಿವೆ. ನೀವು ನೆನಪಿಡುತ್ತೀರಾ ನೋಡಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727060/size7/c9b0c085cabd2aea8920ddfc909b90f4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727060/size7/c9b0c085cabd2aea8920ddfc909b90f4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-60927","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-60927","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":426,"opdsId":"urn:uuid:SW-559657","title":"ಕಪ್ಪೆಯ ನಕ್ಷತ್ರದ ಬಯಕೆ","authors":["Bhat Ananthesha"],"language":"","readingLevel":"Level 1","publisher":"","summary":"ಕಪ್ಪೆ ನಕ್ಷತ್ರಗಳನ್ನು ನೋಡಲು ಇಷ್ಟಪಡುತ್ತದೆ. ಒಂದು ರಾತ್ರಿ  ಅವುಗಳನ್ನು ಮುಟ್ಟಬೇಕೆಂದು ನಿರ್ಧರಿಸುತದೆ. ಅದು ಬಂಡೆ, ದಿಬ್ಬವನು ಮತ್ತು ಎತ್ತರದ ತೆಂಗಿನ ಮರ ಏರುತದೆ! ಆದರೆ ನಕ್ಷತ್ರಗಳು ಯಾವಾಗಲೂ ತಲುಪುವುದಿಲ್ಲ. ಕಪ್ಪೆ ಎಂದಾದರೂ ನಕ್ಷತ್ರಗಳ ಬಳಿ ಇರಲು ಒಂದು ಮಾರ್ಗವನ್ನು ಕಂಡುಕೊಳ್ಳುತ್ತದೆಯೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/96013/size7/e997f05de22463de507bd6c3b5021ef9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/96013/size7/e997f05de22463de507bd6c3b5021ef9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-559657","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-559657","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":427,"opdsId":"urn:uuid:SW-41","title":"ನನ್ನ ದೇಹಕ್ಕೆ ಕಿವಿಗೊಡಿರಿ","authors":["Ishwar Daitota"],"language":"","readingLevel":"","publisher":"","summary":"ಪ್ರತಿಯೊಬ್ಬರಿಗೂ ಅದ್ಭುತವಾದ ದೇಹವಿದೆ.\nಆದರೆ, ನೀವು ಯಾವತ್ತಾದರೂ ಈ ದೇಹ ಏನು ಹೇಳಬಯಸುತ್ತದೆಂದು ಕೇಳಿದ್ದೀರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/700895/size7/19ca6ebcfc082bc86d63cf3227d13b74.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/700895/size7/19ca6ebcfc082bc86d63cf3227d13b74.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-41","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-41","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":428,"opdsId":"urn:uuid:SW-112403","title":"ಆ ಭೂತ ಈ ಭೂತ","authors":["Pallavi Rao"],"language":"","readingLevel":"","publisher":"","summary":"ಚಂದ್ರನಿಲ್ಲದ ರಾತ್ರಿಯಲ್ಲಿ ಯಾರದು ನಿನ್ನ ಹೆಸರನ್ನು ಪಿಸುಗುಡುತ್ತಿರುವರು? ಬಹುಶಃ ಏನೂ ಇಲ್ಲ. ಬಹುಶಃ ಏನೋ ಇದೆ. ಈ ಪುಸ್ತಕದ ಪುಟಗಳನ್ನು ತಿರುವಿ ಹಾಕು. ಆಗ ನಿನಗದು ಕೇಳಿಸಬಹುದು. ಒಂದು ವೇಳೆ ಕೇಳಿಸಿತೆಂದರೆ, ನೀನು ಹಿಂದೆ ಬರುವಂತಿಲ್ಲ. ಹ್ಞಾಂ...","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723696/size7/e0ce37ed7c3c01ca31cf9fd159adcc8b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723696/size7/e0ce37ed7c3c01ca31cf9fd159adcc8b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-112403","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-112403","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":429,"opdsId":"urn:uuid:SW-150016","title":"ಮರೆಗುಳಿ ಅಮ್ಮನ ಕನ್ನಡಕ","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಅಮ್ಮನ ಕನ್ನಡಕ ಮತ್ತೆ ಕಳೆದು ಹೋಗಿದೆ! ಕನ್ನಡಕ ಹುಡುಕುವ ದಾರಿಯನ್ನು ನಿಮು ಮತ್ತು ಮಿರ್ಚಿಯೆ ಕಂಡುಕೊಳ್ಳಬೇಕು. ಆದರೆ, ಈ ಹುಡುಕುವ ಆಟದಲ್ಲಿ ಅವರಿಗೆ ಬೇರೆ ಏನೆಲ್ಲ ಸಿಕ್ಕವು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/202733/size7/a6f4e0983cec0206edd0894d2365758e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/202733/size7/a6f4e0983cec0206edd0894d2365758e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-150016","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-150016","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":430,"opdsId":"urn:uuid:SW-91441","title":"ಗಲಾಟೆಯ ಕಾಗೆಗಳು","authors":["Uday Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಕಾವ್! ಕಾವ್! ಈ ಕಥೆಯಲ್ಲಿರುವ ಕಾಗೆ ಪುಟಾಣಿ ಓದುಗರನ್ನು ಈ ಪುಸ್ತಕ ಓದಲು ಕರೆಯುತ್ತಿದೆ. ‘ನಮ್ಮ ಸುತ್ತಮುತ್ತಲಿನ ಪ್ರಾಣಿಗಳು’ ಪುಸ್ತಕ ಸರಣಿಯಲ್ಲಿ ಈ ಪುಸ್ತಕವೂ ಒಂದಾಗಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/704907/size7/13f658c3851393d29582f887eedc6f06.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/704907/size7/13f658c3851393d29582f887eedc6f06.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-91441","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-91441","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":431,"opdsId":"urn:uuid:SW-60142","title":"ಬಾಚಲಾಗದ ಪುಕ್ಕಗಳು!","authors":["Tanuja Jakkannavar"],"language":"","readingLevel":"","publisher":"","summary":"ಹಕ್ಕಿಯ ಪುಕ್ಕಗಳೇಕೆ ಕೆದರಿದ ಹಾಗಿರುತ್ತವೆ. ಒಂದು ವೇಳೆ ನಿಮಗೂ ಅಂತಹ ಕೂದಲು ಇದ್ದಿದ್ದರೆ ಏನು ಮಾಡುತ್ತೀರಿ? ಈ ಕಥೆ ಓದಿ ಒಂದಿಷ್ಟು ಮೋಡಿಗಾರ ಪಕ್ಷಿಗಳ ಬಗ್ಗೆ ತಿಳಿದುಕೊಳ್ಳಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715403/size7/facfcb3ed0569c840e40a087e98ba009.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715403/size7/facfcb3ed0569c840e40a087e98ba009.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-60142","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-60142","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":432,"opdsId":"urn:uuid:SW-33535","title":"ಸುಳ್ಳಿನ ಹಿಂದೆ...","authors":["Sudha Shankar"],"language":"","readingLevel":"","publisher":"","summary":"ವಲ್ಲಿ ಮತ್ತು ರಮೇಶ ಅಸಾಧ್ಯ ಕೋಪಿಷ್ಠ ತಂದೆಯ ಭಯದ ನೆರಳಲ್ಲಿ ಬದುಕಿದ್ದರು. ಎಂದಾದರೂ ಅವರ ಸ್ಥಿತಿ ಬದಲಾದೀತೆ? ಇದು ಕೌಟುಂಬಿಕ ದೌರ್ಜನ್ಯ ಹಾಗೂ ಭರವಸೆಯ ಸುತ್ತ ಹೆಣೆದಿರುವ ಕಥೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/713827/size7/f0bc807027e81b582713864f4cb60cf1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/713827/size7/f0bc807027e81b582713864f4cb60cf1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-33535","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-33535","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":433,"opdsId":"urn:uuid:SW-29568","title":"ಅಲ್ಲಿ, ಇಲ್ಲಿ ಎಲ್ಲೆಲ್ಲೋ","authors":["Shashi Sampalli"],"language":"","readingLevel":"","publisher":"","summary":"ಹುಡುಗಿಯೊಬ್ಬಳು ತನ್ನ ಯೋಚನೆಗಳ ಬಗ್ಗೆ ಯೋಚಿಸುತ್ತಿದ್ದಾಳೆ! ದಿನವಿಡೀ ಅವು ಏನು ಮಾಡುತ್ತವೆ? ಎಲ್ಲಿಗೆ ಹೋಗುತ್ತವೆ? .. ನೀವೇನಾದರೂ ಅವಳ ಯೋಚನೆಗಳ ಕಂಡಿರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/276432/size7/d9be1b71882531b5e4b2ebd28f8c9ef6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/276432/size7/d9be1b71882531b5e4b2ebd28f8c9ef6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-29568","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-29568","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":434,"opdsId":"urn:uuid:SW-21130","title":"ಕೆಳಗೆ ಬಿದ್ದ ಮಾವಿನಹಣ್ಣು","authors":["Subhashini  M.L."],"language":"","readingLevel":"","publisher":"","summary":"ಮಾವಿನಹಣ್ಣು ಮರದ ಮೇಲಿಂದ ಬೀಳುತ್ತದೆ. ಟಪಕ್! \nಪಾರಿವಾಳ, ಕೋತಿ, ಸಿಂಹ ಮತ್ತು ಇತರ ಅನೇಕ ಪ್ರಾಣಿಗಳ ಜೊತೆಗೆ ನೀವೂ ಜೊತೆಗೂಡಿ ಮುಂದೇನಾಗುತ್ತದೆ ಎಂಬುದನ್ನು ಈ ಚಿಕ್ಕ ಕಥೆಯಲ್ಲಿ ಕಂಡುಕೊಳ್ಳಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723612/size7/bb2545112bd96070db240d74fdca5aa6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723612/size7/bb2545112bd96070db240d74fdca5aa6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-21130","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-21130","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":435,"opdsId":"urn:uuid:SW-560451","title":"ಅದೃಷ್ಟದ ಸಮಯ","authors":["Bhat Ananthesha"],"language":"","readingLevel":"Level 2","publisher":"","summary":"ಎರಡು ಇಲಿಗಳು ಬುಟ್ಟಿಯಲ್ಲಿ ಇರಿಸಲಾದ ಕೆಲವು ಬೆಲ್ಲವನ್ನು ಸವಿಯಲು ನಿರ್ಧರಿಸಿವೆ. ಸಿಹಿಯಾದ ಸತ್ಕಾರದ ತುಂಡನ್ನು ಕಸಿದುಕೊಳ್ಳಲು ಅವುಗಳು ತಮ್ಮ ಕೈಲಾದಷ್ಟು ಪ್ರಯತ್ನಿಸುತ್ತಾರೆ. ಇಲಿಗಳು ಎಂದಾದರೂ ಬೆಲ್ಲದ ರುಚಿಯನ್ನು ಅನುಭವಿಸುತ್ತವೆ ಎಂದು ನೀವು ಭಾವಿಸುತ್ತೀರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/128595/size7/a24f1de359c0a53ba8442f38392449ed.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/128595/size7/a24f1de359c0a53ba8442f38392449ed.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-560451","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-560451","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":436,"opdsId":"urn:uuid:SW-32253","title":"ಕುಣಿಯಲು ಬಯಸಿದ ಕಾಳಿ","authors":["Girish N. R."],"language":"","readingLevel":"","publisher":"","summary":"ನೃತ್ಯ ಮಾಡಬೇಕು ಎಂಬುದಷ್ಟೇ ಕಾಳಿಯ ಆಸೆ. ಆದರೆ ಮಾಡುವುದು ಹೇಗೆ? ಅವರ ಹಳ್ಳಿಯಲ್ಲಿ ಯಾವ ಹುಡುಗರೂ ನರ್ತಿಸಿದ್ದಿಲ್ಲ; ಅದರಲ್ಲೂ ಭರತನಾಟ್ಯವಂತೂ ಇಲ್ಲವೇ ಇಲ್ಲ. ಇದು - ಕನಸು, ಮಹತ್ವಾಕಾಂಕ್ಷೆ ಮತ್ತು ಅವುಗಳನ್ನು ಸಾಧಿಸಲು ಬೇಕಾದ ನಂಬಿಕಗಳ ಕುರಿತಾದ ಕತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722803/size7/279e3b0b11f71cddf1a84d019cdd0cb8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722803/size7/279e3b0b11f71cddf1a84d019cdd0cb8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-32253","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-32253","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":437,"opdsId":"urn:uuid:SW-273791","title":"ಏನು ವಿಶೇಷ?","authors":["H S Venkateshamurthy"],"language":"","readingLevel":"","publisher":"","summary":"ಹಾರುವ ಬಲೂನು ಎಂದರೆ ಮಕ್ಕಳಿಗೆ ಬಲೇ ಇಷ್ಟ. ಅಂತ ಬಲೂನಿನ ಜೊತೆ ತಾನೂ ಮೇಲೆ ಹಾರಿದರೆ ಎನ್ನುವ\nಯೋಚನೆ ಮಕ್ಕಳಿಗೆ ಮಾತ್ರವಲ್ಲ ದೊಡ್ಡವರಿಗೂ ಮುದ ನೀಡುತ್ತದೆ. ಹಾಗೆ ಮೇಲೆ ಮೇಲೆ ಹೋದ ಹುಡುಗ\nವಾಪಸ್ಸು ಬರುವುದು ಯಾವಾಗ? ಬಲೂನು, ಚಂದ್ರ, ಮಕ್ಕಳ ಮುಗ್ಧ ವಿಚಾರಗಳ ಬಗ್ಗೆ ಹೇಳುತ್ತದೆ 'ಏನು ವಿಶೇಷ?'","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723777/size7/5baa0e9dd10e0d144d1e4e1f324956e6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723777/size7/5baa0e9dd10e0d144d1e4e1f324956e6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-273791","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-273791","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":438,"opdsId":"urn:uuid:SW-663674","title":"ನಾನು ಚಿತ್ರ ಬಿಡಿಸುವುದು ಹೀಗೆ","authors":["Chakora"],"language":"","readingLevel":"","publisher":"","summary":"ಎಷ್ಟು ಮೋಮೋಗಳನ್ನು ಪೇರಿಸಿದರೆ ಒಬ್ಬ ಇಲ್ಲಸ್ಟ್ರೇಟರ್‌ನನ್ನು ಮಾಡಬಹುದು? ಯಾರ ಕಣ್ಣಿಗೂ ಬೀಳದೇ ಎಲ್ಲವನ್ನೂ ಗಮನಿಸುವ ಗೋಡೆಗಂಟಿಕೊಂಡ ನೊಣವಾಗುವುದು ಹೇಗೆ? ಕಲ್ಪನೆಗಳ ತಾರಾಗಣದ ಎಣಿಕೆ ಮಾಡಬಲ್ಲಿರಾ? ಒಂದು ಚಿತ್ರಪುಸ್ತಕ ಬರೆಯುವುದಕ್ಕೂ ಇದಕ್ಕೂ ಏನು ಸಂಬಂಧ? ತಿಳಿದುಕೊಳ್ಳುವ ಕುತೂಹಲವಿದೆಯೇ? ಭಾರತದ ಅಚ್ಚುಮೆಚ್ಚಿನ ಇಲ್ಲಸ್ಟ್ರೇಟರ್‍ಸ್ ಪುಸ್ತಕಗಳನ್ನು ಚಿತ್ರಿಸುವ ಬಗೆಯನ್ನು ತೋರಿಸಿ ಕೊಡಲಿದ್ದಾರೆ, ಕೇವಲ ನಿಮಗಾಗಿ. ತಯಾರಾಗಿದ್ದೀರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/744968/size7/014adfa761046e8ca4e2dee142ee4f85.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/744968/size7/014adfa761046e8ca4e2dee142ee4f85.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-663674","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-663674","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":439,"opdsId":"urn:uuid:SW-63685","title":"ನಮ್ಮ ಮನೆ","authors":["Kalgundi  Naveen"],"language":"","readingLevel":"","publisher":"","summary":"ನಮ್ಮ ಸುತ್ತಲೂ ಪ್ರಾಣಿ-ಪಕ್ಷಿಗಳು ಗೂಡು ಕಟ್ಟಿಕೊಳ್ಳುವುದನ್ನು ನೋಡಿರುತ್ತೇವೆ. ಅವು ವಾಸಿಸುವ ಸ್ಥಳಗಳು ಯಾವುವು ಗೊತ್ತೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527543/size7/b7fb5ea8fe68a362a90b6a22b064780d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527543/size7/b7fb5ea8fe68a362a90b6a22b064780d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-63685","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-63685","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":440,"opdsId":"urn:uuid:SW-275989","title":"ಮನೆಯೇ ಮೈದಾನವಾದಾಗ","authors":["Ashwini Kalasad"],"language":"","readingLevel":"","publisher":"","summary":"ಅಮ್ಮಿನಿಗೆ ಅವಳ ನೆಚ್ಚಿನ ತರಗತಿಗಳಿಗೆ ಹೋಗಲು ಆಗದಿರುವ ಮತ್ತು ಅವಳ ತಮ್ಮ ಉನ್ನಿಗೆ ತನ್ನ ಅಚ್ಚುಮೆಚ್ಚಿನ ಚಿಕ್ಕಮ್ಮನನ್ನು ಕಾಣದಿರುವ ಚಿಂತೆ. ಅದಲ್ಲದೆ ಇಬ್ಬರಿಗೂ ಪಾರ್ಕಿನಲ್ಲಿ ಆಡದಿರುವ ದೊಡ್ಡ ಶಿಕ್ಷೆ. ಎಲ್ಲರೂ ಮನೆಯೊಳಗಡೆ ಇರಬೇಕೆಂಬ ನಿರ್ಬಂಧ. ಇವತ್ತಾದರೂ ಹೊರಗೆ ತಿರುಗಾಡಲು ಹೋಗಲು ಅಡ್ಡಿ ಇಲ್ಲ ತಾನೆ? ಎಂದು ಅಮ್ಮಿನಿ ತನ್ನಷ್ಟಕ್ಕೇ ಕೇಳಿಕೊಳ್ಳುತ್ತಿದ್ದಾಳೆ. ಲಾಕ್ ಡೌನ್ ಮತ್ತು ಸಾಮಾಜಿಕ ಅಂತರ ಪಾಲಿಸಬೇಕಾದ ಸಮಯದಲ್ಲಿ ಎಳೆಯ ಮಕ್ಕಳಿಬ್ಬರ ಪೀಕಲಾಟದ ಕತೆ ಇದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/362389/size7/92cfd489ab32329c3852cad118700016.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/362389/size7/92cfd489ab32329c3852cad118700016.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-275989","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-275989","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":441,"opdsId":"urn:uuid:SW-63083","title":"ಮಾಯಾ ಪತ್ರ","authors":["Harshavardhan Sullia"],"language":"","readingLevel":"","publisher":"","summary":"ಇಜಾಸ್ ಗೆ ತನ್ನ ಆತ್ಮೀಯ ಗೆಳೆಯ ವಿಕ್ರಮ್ ನಿಂದ ಪತ್ರವೊಂದು ಬಂತು. ಇಜಾಸ್ ಅದನ್ನು ಓದಲು ಕಾತರದಿಂದಿದ್ದಾನೆ. ಆದರೆ, ಪತ್ರವನ್ನು ತೆರೆದು ನೋಡಿದಾಗ ಇಜಾಸ್ ಗೆ ಆಶ್ಚರ್ಯ ಕಾದಿತ್ತು!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715435/size7/f5d72137c40e34f62e312d1469ef4961.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715435/size7/f5d72137c40e34f62e312d1469ef4961.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-63083","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-63083","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":442,"opdsId":"urn:uuid:SW-36027","title":"ಆಹಾ! ಏನಿದು ಘಮ","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂದು ಮಧ್ಯಾಹ್ನ ಅಪ್ಪು ಸೋಮಾರಿತನದಲ್ಲಿ ಕುಳಿತಿದ್ದ. ಎಂತಹುದೋ ಸುವಾಸನೆ ಮೂಗಿಗೆ ಬಡಿಯಿತು… ಆದರೆ, ಅದು ಏನೆಂದು ಗೊತ್ತಾಗಲಿಲ್ಲ. ಅದರ ಜಾಡು ಹಿಡಿದು ಹೋದ ಅವನಿಗೆ ನೀವೂ ಜೊತೆಯಾಗಿ. ಈ ಕತೆ ಸುಂದರ ನಗರಿ ಕೋಲ್ಕತ್ತಾಗೆ ನಿಮ್ಮನ್ನು ಕರೆದೊಯ್ಯುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725414/size7/c639bab6e686d995eaf6bdec0c08d4bf.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725414/size7/c639bab6e686d995eaf6bdec0c08d4bf.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-36027","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-36027","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":443,"opdsId":"urn:uuid:SW-461199","title":"ಅಂಗಳ ಶಾಲೆ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಶಾಲೆ ಮಕ್ಕಳಿಗೆ ಮಾತ್ರವಾ? ಮತ್ತೊಂದೆಡೆ, ಪಿಂಟು ಶಾಲೆಗೆ ಹೋಗುವ ದಾರಿಯಲ್ಲಿ ಎಷ್ಟೊಂದು ಮಜ ಮಜವಾದ ಶಾಲೆಗಳು ಕಾಣುತ್ತವೆ. ನೀವೂ ಅವನ್ನು ನೋಡಬೇಕಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727493/size7/21776053ccf55e215d97c6b50d6c8bc5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727493/size7/21776053ccf55e215d97c6b50d6c8bc5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-461199","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-461199","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":444,"opdsId":"urn:uuid:SW-5452","title":"ವರ್ಲ್ಡ್ ವೈಡ್ ವೆಬ್ ನ ಒಳಗೆ","authors":["Brinda N Rao"],"language":"","readingLevel":"","publisher":"","summary":"ಇಂದು ಮಿಲಿಯಾಂತರ ಜನ ಇಂಟರ್ನೆಟ್ಟನ್ನು ಬಳಸುತ್ತಾರೆ. ಅದು ಕೆಲಸ ಮಾಡುವುದು ಹೇಗೆ? ಈ ಪುಸ್ತಕವು ವೆಬ್ನ ಬಗ್ಗೆ, ಅಂತರ್ಸಂಪರ್ಕ ವ್ಯವಸ್ಥೆಯ ಬಗ್ಗೆ, ಇಂಟರ್ನೆಟ್ ಪ್ರಾರಂಭವಾದ ಹಾಗೂ ಅಭಿವೃದ್ಧಿಗೊಂಡ ಬಗೆಗಿನ ಪ್ರಶ್ನೆಗಳಿಗೆ ಉತ್ತರ ನೀಡುತ್ತದೆ.  ಜೊತೆಯಲ್ಲಿಯೇ ಈ ಅದ್ಭುತ ವ್ಯವಸ್ಥೆಯ ಸೌಂದರ್ಯವನ್ನೂ ತೆರೆದಿಡುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712338/size7/78e325d28576a52fd9d7edc40163b740.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712338/size7/78e325d28576a52fd9d7edc40163b740.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-5452","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-5452","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":445,"opdsId":"urn:uuid:SW-461219","title":"ನಾನು ಮತ್ತು ಶಂಭು","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ರಾವಿಗೆ ಹಸು ಮತ್ತು ಶಂಭು ಎಂಬ ಕರು ತುಂಬಾ ಇಷ್ಟ. ಬನ್ನಿ ಶಂಭು ಮತ್ತು ರಾವಿ ಸೇರಿ ಏನೇನು ಮಜಾ ಮಾಡುತ್ತಾರೆ ನೋಡೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727498/size7/d3ee1822e1979c99a2f678a2b8bc5fb0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727498/size7/d3ee1822e1979c99a2f678a2b8bc5fb0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-461219","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-461219","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":446,"opdsId":"urn:uuid:SW-36002","title":"ನಂದಿನಿ ಎಲ್ಲಿದ್ದಾಳೆ?","authors":["Manjunatha. J.R Javagal"],"language":"","readingLevel":"","publisher":"","summary":"ತೋಟದ ಮನೆಯಲ್ಲಿ ದೊಡ್ಡ, ಚಿಕ್ಕ ಹಸುಗಳಿವೆ. ಮಾಲಿನಿ ಅವುಗಳನ್ನು ಮೇಯಿಸಲು ಬಯಲಿಗೆ ಕರೆದುಕೊಂಡು ಹೋಗಿದ್ದಾಳೆ. ಹಸುಗಳನ್ನು ಕಾಯುತ್ತಿದ್ದಾಗ, ಪುಟ್ಟ ನಂದಿನಿ ಮಾಯವಾಗುತ್ತಾಳೆ! ಆಗ ಮಾಲಿನಿ ನಂದಿನಿಯನ್ನು ಪತ್ತೆ ಮಾಡಲು ಹೊರಡುತ್ತಾಳೆ. ನಂದಿನಿಯನ್ನು ಅವಳು ಹುಡುಕುವಳೇ? ಈ ಕಥೆಯು ವಿಂಗಡಣೆಯ ಪರಿಕಲ್ಪನೆಯನ್ನು ಪರಿಚಯಿಸುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716441/size7/487f7b6f222158fac25528b8cb4aff36.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716441/size7/487f7b6f222158fac25528b8cb4aff36.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-36002","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-36002","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":447,"opdsId":"urn:uuid:SW-62","title":"ಪೈಲ್ವಾನ್ ಜೀ","authors":["Ishwar Daitota"],"language":"","readingLevel":"100daysreadingcampaignPunjab2022","publisher":"","summary":"ಪೈಲ್ವಾನ್ ಜೀ ಎಲ್ಲರ ಮೇಲೆ ಅಧಿಕಾರ ಚಲಾಯಿಸುತ್ತಿದ್ದ. ಆದರೆ, ಗಪ್ಪು ಅದಕ್ಕೊಂದು ಪರಿಹಾರ ಹುಡುಕಿದ. ಅದೇನು ಎಂಬುದು ತಿಳಿಯಲು ತಮಾಷೆಯಾಗಿರುವ ಈ ಪುಸ್ತಕ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722698/size7/98bcdcf0cb7fb7abb4210429783d8707.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722698/size7/98bcdcf0cb7fb7abb4210429783d8707.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-62","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-62","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":448,"opdsId":"urn:uuid:SW-32255","title":"ಬಟ್ಟೆ ಒಗೆಯಲೊಂದು ದಿನ","authors":["Kavitha  Muchandi"],"language":"","readingLevel":"","publisher":"","summary":"ಇವತ್ತು ಮೇರಿಗೆ ವಿಶೇಷ ದಿನ. ಏಕೆಂದರೆ, ಇಂದು ಮೇರಿ ಇಷ್ಟದ ಬಟ್ಟೆ ಒಗೆಯುವ ದಿನ. ಬನ್ನಿ ಮೇರಿ ಅಕ್ಕ-ಪಕ್ಕದ ಮನೆಯವರನ್ನ ಭೇಟಿಯಾಗೋಣ. ಈ ದಿನ ಅವರು ಬಟ್ಟೆಗಳನ್ನ ಹೇಗೆ ತೊಳೆದು ಒಪ್ಪ ಮಾಡಿಕೊಳ್ಳುವರೋ ನೋಡೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/55464/size7/56deae620a87cdf1061749233170a37b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/55464/size7/56deae620a87cdf1061749233170a37b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-32255","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-32255","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":449,"opdsId":"urn:uuid:SW-119674","title":"ಓಟ ಕಿತ್ತ ಹಂದಿ","authors":["Ramya Coushik"],"language":"","readingLevel":"","publisher":"","summary":"ಮಿನಿ ಸಿಂಘನ ಮುದ್ದು ಸಾಕು ಹಂದಿ ಲಲಿತಾ, ಓಡಿ ಹೋಗಿದೆ. ದಾರಿಯಲ್ಲಿ ಅದಕ್ಕೆ ಸಿಡುಕ ಕತ್ತೆ, ಧಡೂತಿ ಎಮ್ಮೆ ಹಾಗೂ ಬೊಗಳುವ ನಾಯಿಗಳು ಎದುರಾಗುತ್ತವೆ. ಲಲಿತಾಗೆ ಈ ಹೊಸ ಸಾಹಸ ಬಲು ಮೋಜು ಎನಿಸುತ್ತದೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/167985/size7/0064490a5acbc7cb991472fdd8048aea.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/167985/size7/0064490a5acbc7cb991472fdd8048aea.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-119674","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-119674","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":450,"opdsId":"urn:uuid:SW-124301","title":"ನನ್ನ ಭಾವನೆಗಳ ಪ್ರಪಂಚ","authors":["Uma Rao Kolar"],"language":"","readingLevel":"","publisher":"","summary":"ನಿನ್ನ ನೋಡಲು ಅಜ್ಜಿ ಬಂದಾಗ ನಿನಗೆ ಏನು ಅನಿಸತ್ತೆ? ಲೈಬ್ರರಿಯ ಪುಸ್ತಕ ಹಾಳಾದಾಗ ನಿನಗೆ ಏನು ಅನಿಸತ್ತೆ? ಈ ಪುಸ್ತಕವನ್ನು ಓದು ಮತ್ತು ಇವತ್ತು ನಿನಗೆ ಏನು ಅನಿಸತ್ತೆ ಅಂತ ನೋಡು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/171875/size7/b5e3b9c7796bf4435fbd82e63b8d4f38.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/171875/size7/b5e3b9c7796bf4435fbd82e63b8d4f38.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-124301","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-124301","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":451,"opdsId":"urn:uuid:SW-69903","title":"ಮಳೆಹನಿ ಏರಿ  ಹೋಗೋಣ ಸವಾರಿ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಮಳೆಹನಿಯ ಮೇಲೇರಿದ ಮಕ್ಕಳ ಒಂದು ಗುಂಪು ಆಕಾಶಕ್ಕೇರಿ ಮಾಡಿದ ಸಾಹಸಯಾತ್ರೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715549/size7/a5c8a47dabfa60113e88bae316878c5e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715549/size7/a5c8a47dabfa60113e88bae316878c5e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-69903","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-69903","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":452,"opdsId":"urn:uuid:SW-53346","title":"ಸಹನಾಳ ಸಂಗೀತ","authors":["Sinchana Shantharaj"],"language":"","readingLevel":"","publisher":"","summary":"ಸಹನಾಳ ಮನೆಯಲ್ಲಿ ಒಂದಿಷ್ಟೂ ಸದ್ದಿಲ್ಲ. ಎಲ್ಲರನ್ನೂ, ಎಲ್ಲವನ್ನೂ ಮಾತನಾಡಿಸುವ ನಮ್ಮ ಸಹನಾ ಇದನ್ನು ಹೇಗೆ ಸಹಿಸಬೇಕು? ಈಗ ಅವಳದೇ ಒಂದು ಸಂಗೀತ ಕಛೇರಿ ಶುರುವಾಗಿದೆ. ಕೇಳೋಣವಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725481/size7/36bebfc2c6bd04e5fa90fc5082458ae6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725481/size7/36bebfc2c6bd04e5fa90fc5082458ae6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-53346","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-53346","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":453,"opdsId":"urn:uuid:SW-38075","title":"ರೈಲಲ್ಲಿ ನಿನಾಳ ಆಟ","authors":["Kumar S"],"language":"","readingLevel":"","publisher":"","summary":"ನಿನಾ ಅಪ್ಪ, ಅಮ್ಮನೊಂದಿಗೆ ಕೋಲ್ಕತ್ತದಿಂದ ದೆಹಲಿಗೆ ಹೋಗುತ್ತಿದ್ದಾಳೆ. ನಿನಾಗೆ ನೆಚ್ಚಿನ ಗೆಳೆಯರು, ಅಜ್ಜ-ಅಜ್ಜಿಯರನ್ನು ಬಿಟ್ಟು ಹೋಗುವುದು ಸ್ವಲ್ಪವೂ ಇಷ್ಟವಿಲ್ಲ. ರೈಲಲ್ಲಿ ಅಪ್ಪ, ಅಮ್ಮ ಅವಳ ಬೇಸರ ಹೋಗಲಾಡಿಸುವರೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527558/size7/d2ca9b60f3812f6cfe8931703ea209ee.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527558/size7/d2ca9b60f3812f6cfe8931703ea209ee.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-38075","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-38075","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":454,"opdsId":"urn:uuid:SW-539375","title":"ನನ್ನ ಮಾತೃಭಾಷೆ ಯಾವುದು?","authors":["Hema Khurshapur"],"language":"language","readingLevel":"","publisher":"","summary":"ನಾಗಾಲ್ಯಾಂಡ್‌ನ ಝೆವ್ಲಿಯ ಶಾಲೆಯಲ್ಲಿ ಭಾಷಾ ದಿನ \nಆಚರಿಸುತ್ತಿದ್ದಾರೆ.  ಅವಳು ತನ್ನ ಮಾತೃಭಾಷೆಯಲ್ಲಿ ಪರಿಚಯಿಸಿಕೊಳ್ಳಬೇಕಿದೆ. ಆದರೆ, ಝೆವ್ಲಿಗೆ ಅವಳ \nಮಾತೃಭಾಷೆ ಯಾವುದು ಎಂದು ಖಚಿತವಾಗಿ ತಿಳಿಯದು.  \nಈ ಮೆಚ್ಚಿನ ಪುಸ್ತಕವು ಅನನ್ಯತೆ ಮತ್ತು\nಕಣ್ಮರೆಯಾಗುತ್ತಿರುವ ಭಾಷೆಗಳ ಕತೆಯನ್ನು ಹೇಳುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/636961/size7/c7fa46137b73c42dba1791a78e6d54db.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/636961/size7/c7fa46137b73c42dba1791a78e6d54db.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-539375","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-539375","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":455,"opdsId":"urn:uuid:SW-14722","title":"ಸುಗಂಧ ವನ","authors":["Meera Tushar Punarvasu"],"language":"","readingLevel":"","publisher":"","summary":"ದಕ್ಷಿಣ ಭಾರತದ ಅರಣ್ಯಗಳ, ಶ್ರೀಮಂತ ಪರಿಮಳಗಳ ಈ ಸುಗಂಧದ ಕಥೆಯನ್ನು ಓದಿರಿ. ಯಾರೂ ಕಾಲಿಟ್ಟಿರದ ಕಾಡಿನ ಆ ಜಾಗಕ್ಕೆ ಹೊರಟಿರುವ ಪುಟ್ಟ ಹುಡುಗಿ ಬುಲ್‌ಬುಲಿ ಮತ್ತು ಅವಳ ಗೆಳೆಯ ಗಿಣಿ ತೋತಾರಾಮರ ಜತೆಯಲ್ಲಿ ನಿಮ್ಮ ಕಲ್ಪನೆಯೂ ವಿಹರಿಸಲಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/720907/size7/a1d4cbb9fca226b83fe34cb0077dbe59.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/720907/size7/a1d4cbb9fca226b83fe34cb0077dbe59.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-14722","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-14722","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":456,"opdsId":"urn:uuid:SW-21127","title":"ಬೊಮ್ಮಕ್ಕ ಮಾಡಿದ ನಾಟ್ಯದ ಬೊಂಬೆ","authors":["Subhashini  M.L."],"language":"","readingLevel":"","publisher":"","summary":"ಸಾಂಪ್ರದಾಯಿಕ ಶೈಲಿಯಲ್ಲಿ ತಯಾರಿಸಲಾಗುವ ತಂಜಾವೂರಿನ ಬೊಂಬೆಯ ಒಂದು ಸುಂದರ ಕಥೆಯನ್ನು ಗೀತರೂಪದಲ್ಲಿ ಕಟ್ಟಿಕೊಡಲಾಗಿದೆ. ದಕ್ಷಿಣ ಭಾರತದ ತಂಜಾವೂರು “ತಲೈ ಆಟೈ ಬೊಮ್ಮೆ”ಯಿಂದ  ಸ್ಫೂರ್ತಿಗೊಂಡು ಒಂದು ಮುದ್ದೆ ಮಣ್ಣು ಬೊಂಬೆಯಾಗಿ ತಯಾರಾದ ಬಗೆಯನ್ನು ಈ ಪುಸ್ತಕ ವಿವರಿಸುತ್ತದೆ. ಮಕ್ಕಳ ಓದಿಗೆ ಸುಲಭವಾಗಿ ದಕ್ಕುವ ಭಾಷೆ ಹಾಗೂ ಪದಗಳನ್ನು ಬಳಸಲಾಗಿದ್ದು ಉತ್ತೇಜನಕಾರಿಯಾಗಿದೆ. ಮಕ್ಕಳಿಗೆ ಕರಕುಶಲ ಕಲೆಯಲ್ಲಿ ಬೊಂಬೆಯನ್ನು ಮಾಡುವ ಪೂರ್ಣ ಚಿತ್ರವನ್ನು ಮಕ್ಕಳಿಗೆ ಈ ಕಥಾನಕ ಕಟ್ಟಿಕೊಡುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/114328/size7/087d139e9e25a4db2e8af7c0435a63bc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/114328/size7/087d139e9e25a4db2e8af7c0435a63bc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-21127","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-21127","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":457,"opdsId":"urn:uuid:SW-25988","title":"ಲಯಾಳ ಬೊಂಬಾಟ್ ಬೈಕ್ ಸವಾರಿ","authors":["Smitha sathyaprakash"],"language":"","readingLevel":"","publisher":"","summary":"ಆಟಗಳನ್ನು ಕಲಿಸುವ ಶಿಕ್ಷಕಿ ಲಯಾ. ಅವರ ಬೊಂಬಾಟ್ ಬೈಕಿನ ಜತೆ ಹೋದಲ್ಲೆಲ್ಲ ಜನರಿಗೆ ಸಹಾಯ ಮಾಡುತ್ತಾರೆ. ಲಯಾಳ ಸಾಹಸಗಳನ್ನು ಒಮ್ಮೆ ನೋಡಿ ಬರೋಣ. ಇದು ‘ಲಯಾಳ ಬೊಂಬಾಟ್ ಬೈಕು’ ಪುಸ್ತಕ ಮಾಲೆಯ ಮೊದಲ ಕಥೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117362/size7/a894b43fa2809b9b8de75bb7feeb341a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117362/size7/a894b43fa2809b9b8de75bb7feeb341a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-25988","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-25988","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":458,"opdsId":"urn:uuid:SW-32249","title":"ಭಾರವೆಂದರೆ ಎಷ್ಟು ಭಾರ?","authors":["Sarita Sharan"],"language":"kg","readingLevel":"","publisher":"","summary":"ಒಂದು ಕಲ್ಲು, ಹಕ್ಕಿಯ ಒಂದು ಗರಿಗಿಂತ ಭಾರ ಮತ್ತು ಬಂಡೆಗಲ್ಲಿಗಿಂತ ಹಗುರ. ಹಾಗಾದರೆ ಕಲ್ಲು ಭಾರವೋ? ಹಗುರವೋ? ಕಲ್ಲು ಎಷ್ಟು ಭಾರ ಅಥವಾ ಎಷ್ಟು ಹಗುರ ಎಂದು ನಮಗೆ ತಿಳಿಯಲು ಸಾಧ್ಯವಿದೆಯೆ? ಈ ಪ್ರಶ್ನೆಗೆ ಹಾಗೂ ಇನ್ನೂ ಹಲವು ತೂಕದ ಕುರಿತಾದ ಕುತೂಹಲಭರಿತ ಪ್ರಶ್ನೆಗಳಿಗೆ ಈ ಕಥೆ ಪುಸ್ತಕದಲ್ಲಿ ಉತ್ತರಗಳನ್ನು ಹುಡುಕಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/714192/size7/f84b89b4e29caf6ef8a5b8b5e542bf4c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/714192/size7/f84b89b4e29caf6ef8a5b8b5e542bf4c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-32249","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-32249","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":459,"opdsId":"urn:uuid:SW-3802","title":"ಜೇನುನೊಣ ಗುಂಯಿಗುಡುವುದೇಕೆ?","authors":["Jayashree Deshpande"],"language":"","readingLevel":"","publisher":"","summary":"ಜೇನುನೊಣಗಳಿಗೆ ಸದ್ದಿಲ್ಲದೇ ಕೆಲಸ ಮಾಡಲು ಆಗುತ್ತದೆಯೇ? \nಅವು ಗುಂಯಿಗುಡುವುದೇಕೆ? ಜೇನುನೊಣಗಳ ಕುರಿತು ಸ್ವಾರಸ್ಯಕರ ಸಂಗತಿಗಳನ್ನು ಈ ಪುಸ್ತಕದಲ್ಲಿ ತಿಳಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712557/size7/923f83c35af803721c0069afdc49bd7f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712557/size7/923f83c35af803721c0069afdc49bd7f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-3802","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-3802","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":460,"opdsId":"urn:uuid:SW-454554","title":"ಪೈಸಾ ಪೈಸಾ ಲೆಕ್ಕ","authors":["Praveen S"],"language":"","readingLevel":"","publisher":"","summary":"ಬಾಂಕೊ‌ ಸ್ವಲ್ಪ ಹಣ ಉಳಿತಾಯ ಮಾಡಿದ್ದ. ಅದನ್ನು ಪ್ರಾಣಿಗಳನ್ನು ರಕ್ಷಿಸುವ ಜನರಿಗೆ ದಾನ ಕೊಡಬೇಕು ಎಂದುಕೊಂಡಿದ್ದ. ಹಣದ ಮೌಲ್ಯ ಹಾಗೂ ಪೈಸಾದಿಂದ ರೂಪಾಯಿಗೆ ಪರಿವರ್ತಿಸುವುದನ್ನು ದಾಯಿ ಅವನಿಗೆ ತಿಳಿಸಿಕೊಟ್ಟರು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/524648/size7/9ebcee8fba0efbc406431490a6764fc5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524648/size7/9ebcee8fba0efbc406431490a6764fc5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-454554","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-454554","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":461,"opdsId":"urn:uuid:SW-69735","title":"ಥೂ... ಥೂ...","authors":["Utthaana Bharighat"],"language":"","readingLevel":"","publisher":"","summary":"ಪೊದೆ, ಗಾಡಿ, ಮನೆ ಶಾಲೆ ನಾವು ಎಲ್ಲಿ ಥೂ ಅಂತ ಉಗುಳಲ್ಲ ಹೇಳಿ? ಥೂ ಥೂ ಎಂದು ಉಗುಳುವ ಬಗೆಗಿರುವ ಈ ಮಜವಾದ ಕವನ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727098/size7/2f57802c19b3b7c8da536d61066591c1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727098/size7/2f57802c19b3b7c8da536d61066591c1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-69735","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-69735","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":462,"opdsId":"urn:uuid:SW-640996","title":"ಗೊಗ್ಗಯ್ಯ ಎಲ್ಲಿ?","authors":["Kollegala Sharma"],"language":"","readingLevel":"","publisher":"","summary":"ಪುಟ್ಟಿ ಗೊಗ್ಗಯ್ಯನನ್ನು ನೋಡಬೇಕಂತೆ. ಬಹಳ ದಿನಗಳಿಂದ; ಅಣ್ಣ ಪುಟ್ಟನ ಜೊತೆ ಸೇರಿ ಹುಡುಕುತ್ತಿದ್ದಾಳೆ. ನೀವು ನೋಡಿದ್ದೀರಾ? ಕಂಡಿದ್ದೀರಾ? ಕಂಡಿದ್ದರೆ ಗೊಗ್ಗಯ್ಯನಿಗೆ ತಿಳಿಸಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723784/size7/e7ef7449b13aac59bce727272b35da36.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723784/size7/e7ef7449b13aac59bce727272b35da36.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-640996","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-640996","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":463,"opdsId":"urn:uuid:SW-28568","title":"ಸೋಮಾರಿ ಮಾಮ","authors":["Manjunatha. J.R Javagal"],"language":"","readingLevel":"","publisher":"","summary":"ಕುರ್ಚಿ ಬಿಟ್ಟು ಏಳದೆಯೇ ಸೋಮಾರಿ ರಘು ಮಾಮ ಸಾಹಸ ಯಾತ್ರೆಗೆ ಹೊರಟಿದ್ದಾರೆ. ಅದು ಹೇಗೆ ಎಂದು ಅಮಿಶ್ ಮತ್ತು ಸೋನಿಗೆ ಅಚ್ಚರಿಯಾಗಿದೆ. ಅವರೊಂದಿಗೆ ನೀವೂ ಈ ರೀತಿ ಸಾಹಸಯಾತ್ರೆಗೆ ಹೋಗಬಹುದೇ ಎಂಬುದನ್ನು ಕತೆ ಓದಿ ತಿಳಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/714195/size7/3774467adccf3e2d6841cf43aa22d880.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/714195/size7/3774467adccf3e2d6841cf43aa22d880.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-28568","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-28568","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":464,"opdsId":"urn:uuid:SW-14720","title":"ನಗರವೆಂಬ ಸರೋವರದಲ್ಲಿ ವನ್ಯಜೀವಿಗಳು","authors":["Janhavi Lakshminarayanan"],"language":"","readingLevel":"","publisher":"","summary":"ಯಾವುದೇ ನಗರದಲ್ಲಿರುವ ತೇವಾಂಶವುಳ್ಳ ನೆಲವನ್ನು ಪಾಳುನೆಲ ಎಂದು ಭಾವಿಸಿ, ಕಟ್ಟಡಗಳನ್ನು ಕಟ್ಟುವುದನ್ನೇ ಕಾಯುವಂತಾಗಿದೆ. ಅದು ನಿಜಕ್ಕೂ ಏನು ಎಂದು ನಮಗೆ ತೋರಿಸಲು ಒಬ್ಬ ದಣಿವರಿಯದ ಪರಿಸರವಾದಿಯೇ ಬೇಕಾಗಿದೆ - ಅದು  ಚಮತ್ಕಾರದಿಂದ ಕೂಡಿದ, ಸಂರಕ್ಷಿಸಲು ಅರ್ಹವಾದ ಜೀವಸಂಕುಲ. ನಿಜ ಜೀವನದ ಅನುಭವದಿಂದ ಬರೆದ ಈ  ಕಥೆಯು ನಮಗೆ ನಗರ ಜೀವನದ ಆಹ್ಲಾದಭರಿತ ಸಸ್ಯಸಂಪತ್ತು ಹಾಗು ಪ್ರಾಣಿ ಸಂಪತ್ತುಗಳ ಪರಿಚಯ ನೀಡುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/621647/size7/39928c882af4ee5fd34262e3951764d7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/621647/size7/39928c882af4ee5fd34262e3951764d7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-14720","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-14720","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":465,"opdsId":"urn:uuid:SW-95746","title":"ಹಣ ಹೇಗೆ ಸಂಚರಿಸುತ್ತದೆ!","authors":["Shaila Manipal"],"language":"","readingLevel":"","publisher":"","summary":"‘ರೂಪಾಯಿ ಪೈಸೆ ಸರಣಿ’ ತನ್ನೊಂದಿಗೆ ಅನೇಕ ಉಪಯುಕ್ತ ಮಾಹಿತಿಗಳನ್ನು ಹೊತ್ತು ತಂದಿದೆ. ಅವು, ನಿತ್ಯ ಬದಲಾಗುವ ಜಗತ್ತಿನಲ್ಲಿ, ಬೆಳೆಯುತ್ತಿರುವ ಮಕ್ಕಳು ಹಣವನ್ನು ಹೇಗೆ ಜಾಣತನದಿಂದ ಉಪಯೋಗಿಸಿಕೊಳ್ಳಬೇಕು ಎಂಬುದನ್ನು ಹೇಳಿ ಕೊಡುತ್ತವೆ. ಹಣ ಒಬ್ಬ ವ್ಯಕ್ತಿಯಿಂದ ಇನ್ನೊಬ್ಬ ವ್ಯಕ್ತಿಗೆ ಹಾಗೂ ಒಂದು ಸ್ಥಳದಿಂದ ಇನ್ನೊಂದು ಸ್ಥಳಕ್ಕೆ ವರ್ಗಾವಣೆಯಾಗುತ್ತದೆ. ಇದು ಒಂದು ದೊಡ್ಡ ಬ್ಯಾಂಕ್‍ನ ಗುಹೆಯೊಳಗೆ ಶೇಖರಣೆಯಾಗುತ್ತಿದೆಯಾ? ಎ.ಟಿ.ಎಂ. ಎಂದರೇನು? ಜನರು ತೆರಿಗೆಯನ್ನು ಯಾಕೆ ನೀಡುತ್ತಾರೆ? ಈ ಎಲ್ಲಾ ಪ್ರಶ್ನೆಗಳಿಗೆ ಉತ್ತರವನ್ನು ‘ರೂಪಾಯಿ ಪೈಸೆ ಸರಣಿ’ಯ ‘ಹಣ ಹೇಗೆ ಸಂಚರಿಸುತ್ತದೆ!’ - ಪುಸ್ತಕದಲ್ಲಿ ಪಡೆಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723603/size7/ac32ac4ee2b4016aa6e508125a0192d4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723603/size7/ac32ac4ee2b4016aa6e508125a0192d4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-95746","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-95746","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":466,"opdsId":"urn:uuid:SW-91440","title":"ತುಂಟ ನಾಯಿ","authors":["Uday Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ನಿಮಗೊಂದು ಬಾಲ ಇದ್ದಿದ್ದರೆ ಈ ಕಥೆಯನ್ನು ಓದಿದನಂತರ ನೀವು ಅದನ್ನು ಆಡಿಸುತ್ತಿದ್ದಿರಿ. ‘ನಮ್ಮ ಸುತ್ತಮುತ್ತಲಿನ ಪ್ರಾಣಿಗಳು’ ಪುಸ್ತಕ ಸರಣಿಯಲ್ಲಿ ಈ ಪುಸ್ತಕವೂ ಒಂದಾಗಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/704905/size7/6ba1aebea83f179aa77599f8f256fc8d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/704905/size7/6ba1aebea83f179aa77599f8f256fc8d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-91440","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-91440","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":467,"opdsId":"urn:uuid:SW-1114","title":"ನಾವೆಲ್ಲರೂ ಪ್ರಾಣಿಗಳು","authors":["Ishwar Daitota"],"language":"","readingLevel":"","publisher":"","summary":"ಮಕ್ಕಳು ಓದಿ, ಮಜಾ ಪಡಲು ತಮಾಷೆ ಕಥೆಗಳಲ್ಲಿನ ಮಹಾ ಚಿಂತನೆಗಳು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722264/size7/dea133672cf8f0bfe601479dc135e764.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722264/size7/dea133672cf8f0bfe601479dc135e764.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-1114","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-1114","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":468,"opdsId":"urn:uuid:SW-52562","title":"ಒಂದು ಚಿಪ್ಪಿನ ಕಥೆ","authors":["Sarita Sharan"],"language":"","readingLevel":"","publisher":"","summary":"ಮಿಲಿಯ ಬೆನ್ನ ಮೇಲಿನ ಚಿಪ್ಪು ಕಳೆದು ಹೋಗಿರುತ್ತದೆ. ತನಗೆ ಸರಿ ಹೊಂದುವ ಒಂದು ಚಿಪ್ಪಿಗಾಗಿ ಅವಳು ಸಮುದ್ರ ತೀರವನ್ನೆಲ್ಲ ಅಲೆಯುತ್ತಾಳೆ. ಆಗ ಅವಳು ಸಮುದ್ರ ತೀರದಲ್ಲಿ ಕಸ ಹರಡುವ ಜನರನ್ನು, ಸಿಟ್ಟಿಗೇಳಿಸುವ ಬಸವನ  ಹುಳುವನ್ನು ಭೇಟಿಯಾಗುತ್ತಾಳೆ. ಮಿಲಿಯ ಬೆನ್ನು ಬಿಸಿಲಿನಿಂದ ಚುರುಗುಡುವ ಮುನ್ನ ಅವಳಿಗೆ ಸರಿ ಹೊಂದುವ ಚಿಪ್ಪು ಸಿಗುವುದೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/537878/size7/fcee6e9d81481cb027d4fd946e8012f8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/537878/size7/fcee6e9d81481cb027d4fd946e8012f8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-52562","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-52562","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":469,"opdsId":"urn:uuid:SW-39014","title":"ಯಾರಿಗೆ ಎಷ್ಟು ಲಾಡು?","authors":["Kollegala Sharma"],"language":"","readingLevel":"","publisher":"","summary":"ಲಾಡು ತಿನ್ನುವ ಸಮಯ. ಮೀರಾ, ಮಿಹಿರ್ ಇನ್ನೇನು ಲಾಡು ಬಾಯಿಗೆ ಇಡಬೇಕು, ಯಾರಾದರೂ ಅತಿಥಿಗಳು ಬರುವರು. ಅವರ ಬಳಿ ಹನ್ನೆರಡು ಲಾಡುಗಳಿವೆ. ಅವನ್ನು ಹೇಗೆ ಹಂಚಿಕೊಳ್ಳುತ್ತಾರೆ ನೋಡೋಣ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117565/size7/399dc3e5ef943846b6f10d2347afdec5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117565/size7/399dc3e5ef943846b6f10d2347afdec5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-39014","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-39014","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":470,"opdsId":"urn:uuid:SW-456365","title":"ನನ್ನ ಗೆಳೆಯರು","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ನನಗೆ ತುಂಬಾ ಜನ ಗೆಳೆಯರಿದ್ದಾರೆ. ನಾನು ಅವರೆಲ್ಲರನ್ನೂ ಇಷ್ಟಪಡುತ್ತೇನೆ ಆದರೆ, ಅಷ್ಟೂ ಜನರಲ್ಲಿ ಒಬ್ಬರು ನನಗೆ ಬಹಳ ಇಷ್ಟ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721912/size7/066122b27bde426119a6c1d4284800f1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721912/size7/066122b27bde426119a6c1d4284800f1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-456365","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-456365","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":471,"opdsId":"urn:uuid:SW-49739","title":"ಇದು ಕೀಟವೇ?","authors":["Channamallaswamy M N"],"language":"","readingLevel":"","publisher":"","summary":"ಕೀಟಗಳದ್ದೇ ಅಚ್ಚರಿಯ ಲೋಕ. ಹಾರಾಟ, ನೆಗೆತ, ತೆವಳು ಅಷ್ಟೇ ಏಕೆ ಈ ಕೀಟಗಳಿಗೆ ಈಜೂ ಗೊತ್ತು. ಕೀಟಗಳನ್ನೇ ಹೋಲುವ ಯಂತ್ರಗಳನ್ನು ವಿಜ್ಞಾನಿಗಳು ತಯಾರಿಸುತ್ತಿದ್ದಾರೆ. ಅವು ಯಾವವು ಎಂದು ತಿಳಿಯೋಣವೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717379/size7/7f2d134d25c26372bf5233344b3b3413.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717379/size7/7f2d134d25c26372bf5233344b3b3413.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-49739","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-49739","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":472,"opdsId":"urn:uuid:SW-134510","title":"ಕಂಡಲ್ಲಿ ಕಲೆ - ಇಲ್ಲಿ, ಅಲ್ಲಿ ನಿತ್ಯ ಬಳಸುವ ವಸ್ತುಗಳಲ್ಲೂ","authors":["Utthaana Bharighat"],"language":"","readingLevel":"","publisher":"","summary":"ಕಲೆ ನಮ್ಮ ಸುತ್ತಲೂ ಇದೆ. ಕೇವಲ ರೇಖಾಚಿತ್ರ ಅಥವಾ ಬಣ್ಣದ ಚಿತ್ರಗಳಲ್ಲಿ ಮಾತ್ರ ಇಲ್ಲ. ಕಂಡಲ್ಲಿ ಕಲೆ ಸರಣಿ ಪುಸ್ತಕದಲ್ಲಿ ಒಬ್ಬ ಓದುಗ ಕಲಾವಿದನೊಡನೆ ಹೆಜ್ಜೆ ಹಾಕುತ್ತಾ ದಿನನಿತ್ಯದ ವಸ್ತುಗಳ ರೂಪ ಮತ್ತು ಆಕೃತಿಗಳಲ್ಲಿ ಹುದುಗಿರುವ ಕಲೆಯನ್ನು ಹುಡುಕುತ್ತಾನೆ. ಪ್ರಾಸಪದ್ಯಗಳಿಂದ ಕೂಡಿದ ಈ ಪುಸ್ತಕವನ್ನು ಓದುತ್ತಿದ್ದರೆ ಓದುಗರ ಕಲ್ಪನೆಗೂ ರೆಕ್ಕೆಪುಕ್ಕ ಬರುತ್ತವೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727183/size7/4fbe18e06d9e043ea0b6dc4ddd1ff58a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727183/size7/4fbe18e06d9e043ea0b6dc4ddd1ff58a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-134510","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-134510","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":473,"opdsId":"urn:uuid:SW-36642","title":"ಬೆಂಕಿ! ಬೆಂಕಿ!","authors":["Manjunatha. J.R Javagal"],"language":"","readingLevel":"","publisher":"","summary":"ಗೋವಾದಿಂದ ಗದ್ದಲದ ನಗರ ಮುಂಬೈಗೆ ಬಂದಿರುವ ಆ್ಯನಾಗೆ ಅಲ್ಲಿ ಎಲ್ಲವೂ ಹೊಸತು. ಕೆಲ ಎತ್ತರದ ಕಟ್ಟಡಗಳಲ್ಲಿ ಆ್ಯನಾಗೆ ಸ್ಪೀಕರ್, ಸ್ನಾನದ ಶವರ್ ಜಾಲರಿ ಕಾಣುತ್ತಿದೆ. ಏನಿದು ವಿಚಿತ್ರ! ಆ್ಯನಾ ಕೆಲಸಕ್ಕೆ ಬಂದಿದ್ದು ಯಾವಾಗ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717034/size7/201d96d6b2f02a74a45fa386e61d59a3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717034/size7/201d96d6b2f02a74a45fa386e61d59a3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-36642","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-36642","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":474,"opdsId":"urn:uuid:SW-461221","title":"ಅಮ್ಮ ತುಂಬಾ ಒಳ್ಳೆಯವಳು","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಸರ್ಗಮ್ ಮತ್ತು ಸಮೀರ್ ಯಾವಾಗಲೂ ಹೇಳುವುದು, 'ನನ್ನ ಅಮ್ಮ ತುಂಬಾ ಒಳ್ಳೆಯವಳು,' ಎಂದು. ಯಾಕೆ ಗೊತ್ತಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727500/size7/b0203722afe0a3339e15963466a5275b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727500/size7/b0203722afe0a3339e15963466a5275b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-461221","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-461221","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":475,"opdsId":"urn:uuid:SW-29036","title":"“ಆಹಾ, ಹವೆಯೇ!” ಅನ್ನಾ ಮಣಿಯ ಪ್ರಯೋಗಗಳು","authors":["Sarita Sharan"],"language":"","readingLevel":"","publisher":"","summary":"ಭಾರತೀಯ ವಿಜ್ಞಾನಿ ಅನ್ನಾ ಮಣಿಗೆ ತನ್ನ ಸುತ್ತಲ ಜಗತ್ತಿನ ಬಗ್ಗೆ ಓದಿ ತಿಳಿದುಕೊಳ್ಳುವ ಅದಮ್ಯ ಆಸೆ. ಬನ್ನಿ ಆಕೆಯ ಎಂಟನೇ ಹುಟ್ಟುಹಬ್ಬದ ಆಚರಣೆಯ ಸಂಭ್ರಮದಲ್ಲಿ ಪಾಲ್ಗೊಂಡು, ನಾವೂ ಆಕೆಯ ವೈಜ್ಞಾನಿಕ ಸಾಹಸಗಳನ್ನು ತಿಳಿದುಕೊಳ್ಳೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/713822/size7/8ad4999364f9232b0849d84b9bd5e794.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/713822/size7/8ad4999364f9232b0849d84b9bd5e794.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-29036","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-29036","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":476,"opdsId":"urn:uuid:SW-214841","title":"ಮೊದಲ ಪತ್ರ","authors":["Shabana Begum"],"language":"","readingLevel":"","publisher":"","summary":"ಆಯಿಷಾ ಮೊದಲ ಪತ್ರ ಬರೆಯುತ್ತಿದ್ದಾಳೆ. ಅವಳು ತನ್ನ ಮೊದಲ ಪತ್ರ ಯಾರಿಗೆ ಬರೆಯುತ್ತಿದ್ದಾಳೆ? ತಿಳಿದುಕೊಳ್ಳಲು ಕಥೆ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283922/size7/c7bdc837476ae5c2177cbd3f2d90d6ea.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283922/size7/c7bdc837476ae5c2177cbd3f2d90d6ea.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-214841","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-214841","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":477,"opdsId":"urn:uuid:SW-640","title":"ಕಲ್ಲುವಿನ ಪ್ರಪಂಚ-1 ಮತ್ತೊಮ್ಮೆ ಅಪಾಯದಲ್ಲಿ!","authors":["Aparna Prasanna"],"language":"","readingLevel":"","publisher":"","summary":"ಕಲ್ಲು, ಮತ್ತೆ ಶಾಲೆಗೆ ತಡವಾಗಿ ಬಂದನು! ಮಾಸ್ತರಿನ ಸಿಟ್ಟಿನಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳುವುದಕ್ಕಾಗಿ ನಮ್ಮ ಕಲ್ಲು ಯಾವ ಕಥೆಯನ್ನು ಹೆಣೆಯುತ್ತಾನೆ ಎನ್ನುವುದನ್ನು ನೋಡೋಣವೆ...?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703474/size7/aebdec85f3efee3cc067e575ca2d0d42.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703474/size7/aebdec85f3efee3cc067e575ca2d0d42.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-640","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-640","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":478,"opdsId":"urn:uuid:SW-5068","title":"ಬೋಂಡ ಮತ್ತು ದೇವಿ","authors":["Manjunatha Varadaraju"],"language":"","readingLevel":"","publisher":"","summary":"ಉತ್ತಮ ಸ್ನೇಹಿತರು ಯಾವಾಗಲೂ ಒಂದೇ ರೀತಿ ಇರಬೇಕೆ? ದೇವಿ ಮತ್ತು ಬೋಂಡ ಉತ್ತಮ ಸ್ನೇಹಿತರು, ಆದರೆ ದೇವಿ ಚಿಕ್ಕ ಹುಡುಗಿಯಾಗಿದ್ದರೆ, ಬೋಂಡ... ಭಾರವಾದ ವಸ್ತುಗಳನ್ನು ಎತ್ತಬಲ್ಲ, ಕೈ-ಕಾಲುಗಳನ್ನು ಚಾಚಬಲ್ಲ, ಹೇಳಿದ ಯಾವುದನ್ನೂ ಮರೆಯುವುದಿಲ್ಲ, ಅವನನ್ನು ಸ್ಥಗಿತಗೊಳಿಸಿ ಮತ್ತೆ ಚಾಲನೆಗೊಳಿಸಲೂ ಸಾಧ್ಯವಿದೆ. ಅವನು ಏನು ಎಂಬುದನ್ನು ಊಹಿಸಬಲ್ಲಿರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723790/size7/52bbadeb3606658617b9a6032bc22021.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723790/size7/52bbadeb3606658617b9a6032bc22021.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-5068","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-5068","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":479,"opdsId":"urn:uuid:SW-45130","title":"ಉದ್ಯಾನವನದಲ್ಲಿ ನಾವು ಹೇಗಿರಬೇಕು? - ವ್ಯತ್ಯಾಸಗಳನ್ನು ಗುರುತಿಸಿ","authors":["Sarita Sharan"],"language":"","readingLevel":"","publisher":"","summary":"ನಾವೇಕೆ ಉದ್ಯಾನಕ್ಕೆ ಹೋಗುತ್ತೇವೆ? ಆಟ ಆಡಲು, ಜಿಗಿಯಲು, ಸ್ಕೇಟಿಂಗ್, ಉಯ್ಯಾಲೆ ಆಡಲು ಗೆಳೆಯರನ್ನು ಮಾಡಿಕೊಳ್ಳಲು ಅಲ್ಲವೇ? ಆದರೆ ಅದೇ ಕೆಲ ಸಲ ಉದ್ಯಾನದಲ್ಲೇ ಕಸ ಎಸೆಯುತ್ತೇವೆ, ಗೆಳೆಯರ ಜತೆ ಜಗಳ ಆಡುತ್ತೇವೆ, ಅವರನ್ನು ತಳ್ಳುತ್ತೇವೆ. ಏಕೆ ಹೀಗೆ? ನಿಮ್ಮತಂದೆ/ತಾಯಿ, ಗೆಳೆಯರು ಅಥವಾ ಶಿಕ್ಷಕರನ್ನು ಕೇಳಿ ನೋಡಿ ಮತ್ತು ನೀವು ಉದ್ಯಾನದಲ್ಲಿ ಹೇಗೆ ಆಟ ಆಡಬಹುದು ಎಂದು ತಿಳಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/89002/size7/d5856c87ec927fb94e1ec33e97001b1f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/89002/size7/d5856c87ec927fb94e1ec33e97001b1f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-45130","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-45130","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":480,"opdsId":"urn:uuid:SW-116187","title":"ಮಂಗಳಯಾನ - ಮಂಗಳ ಗ್ರಹದಲ್ಲೊಂದು ಸುತ್ತು","authors":["Harshavardhan Sullia"],"language":"","readingLevel":"","publisher":"","summary":"ಬನ್ನಿ, ಬನ್ನಿ ಮಂಗಳಯಾನಕ್ಕೆ ಒಮ್ಮೆ ಹಾರಿ ಬಿಡೋಣ. ಹಾ, ನಮ್ಮ ಮೊದಲ ಗುರಿ ಮಂಗಳಗ್ರಹ. ಅಲ್ಲಿಗೆ ತಲುಪಲು ಚಂದಿರನಿಂದಾಚೆಗೆ, ಸೂರ್ಯನ ಇನ್ನೊಂದು ದಿಕ್ಕಿನತ್ತ ಹಾರಿ ಹೋಗೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/720045/size7/2d5d71e713132473aa21890cddff485e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/720045/size7/2d5d71e713132473aa21890cddff485e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-116187","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-116187","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":481,"opdsId":"urn:uuid:SW-32362","title":"ಕಣ್ಣಾಮುಚ್ಚೇ…","authors":["Kollegala Sharma"],"language":"up","readingLevel":"","publisher":"","summary":"ಹಕ್ಕಿಗಳು, ಬಾವಲಿಗಳು, ಗಾಳಿಪಟಗಳು ಹಾಗೂ ವಿಮಾನ. ಆಗಸದಲ್ಲಿನ ಜಗತ್ತನ್ನು ನೀವು ಎಷ್ಟು ಕಂಡಿದ್ದೀರಿ? ಹಾಗಿದ್ದರೆ, ತಯಾರಾಗಿ ಈ ಸುಂದರ ವಿನ್ಯಾಸಗಳ ಪುಸ್ತಕದಲ್ಲಿ ಸರಿ ಹೊಂದದವುಗಳನ್ನು ಹುಡುಕಲು ಹೋಗೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/714197/size7/b769676c4189b596ea7f2c7e00825ca4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/714197/size7/b769676c4189b596ea7f2c7e00825ca4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-32362","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-32362","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":482,"opdsId":"urn:uuid:SW-4410","title":"ಬೀಜವನ್ನು  ಸಂಗ್ರಹಿಸಲು ಹೋಗೋಣ!","authors":["Ravikiran"],"language":"","readingLevel":"","publisher":"","summary":"ಬಸ್ಯ, ಸುಳ್ಳಿ ಮತ್ತು ಅವರ ಆತ್ಮೀಯ ಗೆಳತಿ ಶುಂಟಿ ಊರೆಲ್ಲಾ ಸುತ್ತುತ್ತ ಬೀಜಗಳನ್ನು ಹುಡುಕುವಲ್ಲಿ ನಾವೂ ಸೇರೋಣ ಬನ್ನಿ. ಅವರು ಹುಳಿಯಾ - ಹುಣಸೆ ಮರವನ್ನು ಭೇಟಿ ಮಾಡಿದ ಮೇಲೆ ಅವರ ಸಾಹಸ ಶುರುವಾಗುವುದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712346/size7/abaaefe06528fa8cae908c4e423f651b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712346/size7/abaaefe06528fa8cae908c4e423f651b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-4410","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-4410","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":483,"opdsId":"urn:uuid:SW-16591","title":"ಮೋಡದ ಐಸ್ ಕ್ರೀಂ","authors":["Ishwar Daitota"],"language":"","readingLevel":"100daysreadingcampaignPunjab2022","publisher":"","summary":"ಸರಳಾ ಮತ್ತು ಅವಳ ಗಾಳಿಪಟ ಭಾರೀ ಸ್ನೇಹಿತರು. ಪಟ ಅವಳಿಗೊಂದು ಅಪ್ಯಾಯಮಾನ ಕೊಡುಗೆ ತರುತ್ತದೆ. ಆ ಕೊಡುಗೆ ಏನೆಂದು ಓದಿ ತಿಳಿಯೋಣ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721661/size7/714b72460159f8ae2bde9ed34b463c58.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721661/size7/714b72460159f8ae2bde9ed34b463c58.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-16591","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-16591","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":484,"opdsId":"urn:uuid:SW-513","title":"ಮೋರುವಿನ ಲೆಕ್ಕಾಚಾರ","authors":["Shaila Manipal"],"language":"","readingLevel":"","publisher":"","summary":"ಮೋರುವಿನ ಜಗತ್ತಿನಲ್ಲಿ, ಸಂಖ್ಯೆಗಳು ಕುಣಿಯುತ್ತಿದ್ದವು, ಅಂಕೆಗಳು ತೇಲಾಡುತ್ತಿದ್ದವು ಮತ್ತು ಭಾಗಾಕಾರದ ಲೆಕ್ಕ ಒಂದು ಸುಂದರ ಬಾಲದಂತೆ ಕಾಣುತ್ತಿತ್ತು. ಆದರೆ, ಶಾಲೆಯಲ್ಲಿ ಒಂದು ದಿನ ಈ ಕಲ್ಪನಾ ಜಗತ್ತು ಮುರಿದು ಬಿತ್ತು. ಬಳಿಕ ಮೋರು ಸ್ಥಳೀಯ ಕೇಡಿಯಾಗಿ ಮಾರ್ಪಟ್ಟ. ಕಲಿಯುವಿಕೆಯಲ್ಲಿರುವ ಸಂತೋಷವನ್ನು ಮತ್ತೊಮ್ಮೆ ಕಂಡುಕೊಳ್ಳಲು ಅವನಿಗೆ ಒಬ್ಬರು ಸಹಾಯ ಮಾಡಿದರು. ಈ ಸನ್ನಿವೇಶದ ಬಗ್ಗೆ ತಿಳಿಯಲು ಮನಸ್ಸಿಗೆ ಖುಷಿ ನೀಡುವ ಈ ಕಥೆಯನ್ನು ಓದಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/696874/size7/9ff16cdbaba183411b9f0abc8173386f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/696874/size7/9ff16cdbaba183411b9f0abc8173386f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-513","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-513","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":485,"opdsId":"urn:uuid:SW-99726","title":"ರಾಜ ಮೆರವಣಿಗೆ","authors":["Sujatha Rajanna"],"language":"","readingLevel":"","publisher":"","summary":"ಪಾರ್ವತಿ ಮತ್ತು ಅವಳ ಸೋದರ ಲಕ್ಷ್ಮಣ ಸಾಮ್ರಾಟ್ ಅಶೋಕನ ಕಾಲಾವಧಿಯಲ್ಲಿ ಪಾಟಲೀಪುತ್ರದಲ್ಲಿ ವಾಸಿಸುತ್ತಿದ್ದರು. ಆದರೆ, ಅವರು ಸಾಮ್ರಾಟನನ್ನು ಎಂದೂ ಕಂಡಿರಲಿಲ್ಲ. ಒಂದು ದಿನ ಅವರು ಅರಮನೆಯ ನೌಕರನೊಬ್ಬನನ್ನು ಭೇಟಿಯಾಗುತ್ತಾರೆ ಮತ್ತು ಸಾಮ್ರಾಟನನ್ನು ಕಾಣುವ ಸೌಭಾಗ್ಯ ತಮಗೂ ಸಿಗಬಹುದೇನೋ ಎಂದು ಆಸೆ ಪಡುತ್ತಾರೆ.\nಈ ಮಕ್ಕಳಿಗೆ ತಮ್ಮ ಆಸೆ ಅಷ್ಟು ಬೇಗನೆ ಈಡೇರುವುದೆಂಬ ನಿರೀಕ್ಷೆ ಇರುವುದಿಲ್ಲ. ಅಂತಹ ಸದಾವಕಾಶ ಬಂದಾಗ ಅವರಿಗೆ ಎಂತಹ ಆಶ್ಚರ್ಯ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703492/size7/b7b9579f578a8043e0e9f143d5315a86.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703492/size7/b7b9579f578a8043e0e9f143d5315a86.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-99726","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-99726","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":486,"opdsId":"urn:uuid:SW-134501","title":"ಕಂಡಲ್ಲಿ ಕಲೆ - ಇಲ್ಲಿ, ಅಲ್ಲಿ ಮತ್ತು ಕಸದ ಬೀಡಲ್ಲಿ","authors":["M R GANESHA KUMAR"],"language":"","readingLevel":"","publisher":"","summary":"ಕಲೆ ನಮ್ಮ ಸುತ್ತಲೂ ಇದೆ. ಕೇವಲ ರೇಖಾಚಿತ್ರ ಅಥವಾ ಬಣ್ಣದ ಚಿತ್ರಗಳಲ್ಲಿ ಮಾತ್ರ ಇಲ್ಲ. ಕಂಡಲ್ಲಿ ಕಲೆ ಸರಣಿ ಪುಸ್ತಕದಲ್ಲಿ ಒಬ್ಬ ಓದುಗ ಕಲಾವಿದನೊಡನೆ ಹೆಜ್ಜೆ ಹಾಕುತ್ತಾ ಕಸವೆಂದು ಎಸೆವ ವಸ್ತುಗಳಲ್ಲೂ ಹುದುಗಿರುವ ಕಲೆಯನ್ನು ಹುಡುಕುತ್ತಾನೆ. ಪ್ರಾಸಪದ್ಯಗಳಿಂದ ಕೂಡಿದ ಈ ಪುಸ್ತಕವನ್ನು ಓದುತ್ತಿದ್ದರೆ ಓದುಗರ ಕಲ್ಪನೆಗೂ ರೆಕ್ಕೆಪುಕ್ಕ ಬರುತ್ತವೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727181/size7/b60285be90a998a96c505a8809a1b7a9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727181/size7/b60285be90a998a96c505a8809a1b7a9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-134501","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-134501","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":487,"opdsId":"urn:uuid:SW-29671","title":"ಪಾಯಸ ಕದ್ದವರಾರು?","authors":["Meera Tushar Punarvasu"],"language":"","readingLevel":"","publisher":"","summary":"ಮೀರಾಳ ತಂದೆ ದಾಕ್ಷಿ ತರಲು ಮಾರುಕಟ್ಟೆಗೆ ಹೋದಾಗ, ಅವರು ಮಾಡಿಟ್ಟ ಪಾಯಸ ಮಾಯವಾಗುತ್ತದೆ. ಅವರಿಲ್ಲದ ಸಮಯದಲ್ಲಿ ಪಾಯಸವನ್ನು ತಿಂದವರಾರು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725166/size7/9535ca6dbe1a0b67362b66129050c97f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725166/size7/9535ca6dbe1a0b67362b66129050c97f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-29671","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-29671","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":488,"opdsId":"urn:uuid:SW-138952","title":"ಕಲಿಯುವ ಮನೆ","authors":["Navya. N"],"language":"","readingLevel":"","publisher":"","summary":"ಇಂದು ನಾಲ್ಕನೆ ತರಗತಿಯ ಮಕ್ಕಳು ವಿಜ್ಞಾನ ಕೇಂದ್ರಕ್ಕೆ ಲಗ್ಗೆ ಇಡುತ್ತಿದ್ದಾರೆ. \nಬನ್ನಿ. ನಾವು ಅವರ ಜೊತೆ ಹೋಗೋಣ. ಆನಂದಿಸೋಣ. \nಹಾಂ. ಹಾಗೆಯೆ ಅಲ್ಲಿರುವ ಆರು ತುಂಟ ಮಕ್ಕಳ ಮೇಲೆ ಗಮನ ಇರಲಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721202/size7/6e38f782e652b5931b13f22d1f71379c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721202/size7/6e38f782e652b5931b13f22d1f71379c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-138952","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-138952","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":489,"opdsId":"urn:uuid:SW-223588","title":"ಹೊಸ ಪುಸ್ತಕ","authors":["Manjunath B G"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂದು ಮಗುವಿಗೆ ತಮಾಷೆ ಕಥೆಯಿರುವ ಪುಸ್ತಕ ಸಿಕ್ಕಿತು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/285295/size7/17de53cbc340ef50fb25679a43f3b5ff.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/285295/size7/17de53cbc340ef50fb25679a43f3b5ff.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-223588","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-223588","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":490,"opdsId":"urn:uuid:SW-591161","title":"ನಾವೂ ಪುಸ್ತಕ ಮಾಡ್ತೇವೆ","authors":["Nagesh  Hegde"],"language":"","readingLevel":"","publisher":"","summary":"ಜಗಿಯುತ್ತ, ಕತ್ತರಿಸುತ್ತ, ಸುರುಳಿ ಸುತ್ತುತ್ತ, ಹೊಲಿಗೆ ಹಾಕುತ್ತ- ನಾವೂ ಪುಸ್ತಕ ಮಾಡ್ತೇವೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/705538/size7/51f63f36c3d378bc88b93ca0fa829330.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/705538/size7/51f63f36c3d378bc88b93ca0fa829330.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-591161","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-591161","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":491,"opdsId":"urn:uuid:SW-59990","title":"ಹಸಿವೆಯ ಮೆಟ್ಟಿಲು ಏರಿದವರಾರು?","authors":["Kollegala Sharma"],"language":"","readingLevel":"","publisher":"","summary":"ಪ್ರಣವನಿಗೆ ಹಸಿವಾಗಿದೆ. ಮನೆಯೊಳಗೆ ಹೋಗಲು ಅವನು ಮೆಟ್ಟಿಲು ಏರುವಾಗ ಇನ್ನೂ ಹಲವರು ಅವನ ಹಿಂದೆ ಬರುತ್ತಾರೆ. ಅವನನ್ನು ಮೆಟ್ಟಿಲು ಹತ್ತಿ ಓಡುವಂತೆ ಮಾಡುವವರು ಯಾರು ನೋಡಬೇಕೆ? ಇದೋ ಬನ್ನಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/97609/size7/fce4da2bddc71052a69c395326c949bc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/97609/size7/fce4da2bddc71052a69c395326c949bc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-59990","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-59990","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":492,"opdsId":"urn:uuid:SW-276514","title":"ಹುಟ್ಟುಹಬ್ಬದ ಕೇಕ್","authors":["Pallavi Koushik"],"language":"","readingLevel":"","publisher":"","summary":"ಆಜಾದ್, ಹನಿಯಾ, ಚಾರುಲತಾ, ಪಿಯೂಷ್ ತಮ್ಮ ಮನೆಯ ಮುಂದೆ ಆಟವಾಡಲು ಇಷ್ಟಪಡುತ್ತಾರೆ - ಬೀದಿಯ ಕೊನೆಯಲ್ಲಿರುವ ಅಜ್ಜಿಯ ಮುಂಗೋಪಕ್ಕೆ ತುತ್ತಾಗುವವರೆಗೆ. ಆವತ್ತೊಂದು ದಿನ ಅಜ್ಜಿಯ ಹುಟ್ಟುಹಬ್ಬ ಎಂದು ತಿಳಿದಾಗ, ಈ ಸ್ನೇಹಿತರು ಅಜ್ಜಿಗಾಗಿ ಕೇಕ್ ತಯಾರಿಸಲು ನಿರ್ಧರಿಸುತ್ತಾರೆ. ಏನೇ ಆದರೂ, ಯಾರೂ ಅವರವರ ಹುಟ್ಟುಹಬ್ಬವನ್ನು ಒಬ್ಬರೇ ಆಚರಿಕೊಳ್ಳುವಂತಾಗಬಾರದು. ಇದು ಭ್ರಾತೃತ್ವ ಮತ್ತು ಅನುಭೂತಿ ಬಗೆಗಿನ ಚೆಂದದ ಕಥೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/524457/size7/3de4e044e2aa994fccf7b609981e035c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524457/size7/3de4e044e2aa994fccf7b609981e035c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-276514","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-276514","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":493,"opdsId":"urn:uuid:SW-113941","title":"ನೀನೂ ಬಾ ಅಮ್ಮಾ","authors":["Smitha sathyaprakash"],"language":"","readingLevel":"","publisher":"","summary":"ಆದ್ಯಾಗೆ ಎಲ್ಲಕ್ಕೂ ಅವಳಮ್ಮನೇ ಬೇಕು - ರಜೆಗೆಂದು ಅಸ್ಸಾಂಗೆ ಹೋಗಲು ಅವಳ ಲಗೇಜು ರೆಡಿ ಮಾಡಲು ಅಮ್ಮ ಬೇಕು. ಹಾಗೇ ಅಲ್ಲಿ ನದಿಯಲ್ಲಿ ಆಡಲೂ ಅವಳಮ್ಮನೇ ಬೇಕು. ಈ ಪ್ರವಾಸದಿಂದ ಆದ್ಯಾ ಬದಲಾಗುವಳೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727165/size7/4732117263204c3711957aac53a0efbe.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727165/size7/4732117263204c3711957aac53a0efbe.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-113941","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-113941","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":494,"opdsId":"urn:uuid:SW-111310","title":"ನನ್ನ ಹಕ್ಕು ತಿಳಿಯುವುದು ನನ್ನ ಹಕ್ಕು","authors":["Madhusudana YN"],"language":"","readingLevel":"","publisher":"","summary":"ವಿಶ್ವಸಂಸ್ಥೆಯ ಮಕ್ಕಳ ಹಕ್ಕುಗಳ ಕುರಿತಾದ ಒಪ್ಪಂದ ಮಕ್ಕಳ ಮೂಲಭೂತ ಹಕ್ಕುಗಳನ್ನು ಪಟ್ಟಿ ಮಾಡಿದೆ. ನೀವು ಎಲ್ಲಿಯವರು, ನಿಮ್ಮ ಚರ್ಮದ ಬಣ್ಣವೇನು, ನೀವು ಧರ್ಮವನ್ನು ಪಾಲಿಸುತ್ತೀರೋ ಇಲ್ಲವೋ, ನೀವು ಆಡುವ ಭಾಷೆ ಯಾವುದು, ನೀವು ಗಂಡೋ ಹೆಣ್ಣೋ ಅಥವಾ ಇನ್ನೂ ನಿರ್ಧರಿಸಿಲ್ಲವೋ – ಇದಾವುದನ್ನೂ ಪರಿಗಣಿಸುವುದಿಲ್ಲ! ಈ ಭಿತ್ತಿಚಿತ್ರಗಳ ಪುಸ್ತಕಗಳು ಮಕ್ಕಳ ಕೆಲವು ಹಕ್ಕುಗಳನ್ನು ಪಟ್ಟಿ ಮಾಡುತ್ತವೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/156212/size7/89ed34011a88c4888b1dba527607d9f5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/156212/size7/89ed34011a88c4888b1dba527607d9f5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-111310","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-111310","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":495,"opdsId":"urn:uuid:SW-144104","title":"ಕರಟದ ಸುಬ್ಬಮ್ಮ","authors":["K. Nallathambi"],"language":"","readingLevel":"","publisher":"","summary":"ಎಸೆಯುವ ಪದಾರ್ಥಗಳಿಂದ ಏನಾದರು ಹೊಸದನ್ನು ಮಾಡುವುದು ಸುಬ್ಬಮ್ಮನ ಹವ್ಯಾಸ. ಆದರೆ, ಅವಳಿಗೆ ಶಾಲೆಯಲ್ಲಿ ಓದಿನ ಕಡೆ ಗಮನ ಕೊಡುವುದು, ಮನೆಪಾಠ ಮಾಡುವುದು ಎಂದರೆ ಅದೇನೊ ನಿರಾಸಕ್ತಿ. ತುಂಟ ಹುಡುಗಿ ಸುಬ್ಬಮ್ಮ ಕರಟದ ಸುಬ್ಬಮ್ಮನಾದ ಕಥೆಯನ್ನು ಓದೋಣ ಬನ್ನಿ...","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726194/size7/fa3869211439a8b65f32c4c39ce50074.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726194/size7/fa3869211439a8b65f32c4c39ce50074.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-144104","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-144104","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":496,"opdsId":"urn:uuid:SW-55774","title":"ಏನಿದು ವಾಸನೆ?","authors":["Hema Hebbagodi"],"language":"","readingLevel":"","publisher":"","summary":"ಮಾಧವ ಮತ್ತು ತಾರಾಳ ತಿಂಡಿಯೆಲ್ಲ ಇದ್ದಕ್ಕಿದ್ದಂತೆ ಮಾಯವಾಗುತ್ತಿದ್ದವು. ಅವುಗಳನ್ನು ವಿಚಿತ್ರವಾದ ಜೀವಿಗಳೋ, ರಾಕ್ಷಸರೋ ಅಥವ ಅದೃಶ್ಯ ಜೀವಿಗಳೋ ಗುಳುಂ ಮಾಡುತ್ತಿರಬಹುದೇ? ಯಾರಿರಬಹುದು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/714317/size7/943de6f6a8d5ef43d1bb7b9147b1ca58.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/714317/size7/943de6f6a8d5ef43d1bb7b9147b1ca58.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-55774","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-55774","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":497,"opdsId":"urn:uuid:SW-111762","title":"ಕೆರೆ ಕಾಯುವೆ ನಾನು","authors":["Sinchana Shantharaj"],"language":"","readingLevel":"","publisher":"","summary":"ಮಂಜು ಹಾಗೂ ಹಮೀದ್‌ ಕೆರೆಯ ಕಾವಲು ಆಟವಾಡುತ್ತಿದ್ದಾರೆ. ಆದರೆ, ಈ ಆಟ ಹಮೀದ್‌ ಗೆ ಬೇಸರ ತರಿಸುತ್ತಿದೆ ಏಕೆ? ಬೇಸರಕ್ಕೆ ಕಾರಣವೇನು? ಮಾಲಿನ್ಯ ಮತ್ತು ನಶಿಸುತ್ತಿರುವ ನೀರಿನ ಮೂಲಗಳ ಕುರಿತಾದ ಕತೆ ಇದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/196528/size7/4b27744f1d84c940dbf9370defe8966a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/196528/size7/4b27744f1d84c940dbf9370defe8966a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-111762","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-111762","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":498,"opdsId":"urn:uuid:SW-448","title":"ಕತ್ತಲಲ್ಲಿ ಸೂರ್ಯನೆಂತು ಮರೆಯಾಗುವನಕ್ಕಾ?","authors":["Vasantha Kalbagal"],"language":"","readingLevel":"","publisher":"","summary":"ಪುಟ್ಟ ತಮ್ಮನ ಅನ್ವೇಷಕ ತಲೆಯಲ್ಲಿ ಯಾವತ್ತೂ ಅಕ್ಕನನ್ನು ಕೇಳಬೇಕಾದ ಅನೇಕ ಪ್ರಶ್ನೆಗಳು\nತುಂಬಿರುತ್ತವೆ. ಅಕ್ಕನಿಗೆ ಉತ್ತರಗಳೆಲ್ಲವೂ ಗೊತ್ತು ಎಂದು ಆತನಿಗೆ ಅರಿವಿದೆ. ಯಾಕೆಂದರೆ ಆಕೆ \nಯಾವತ್ತು ದಪ್ಪದಪ್ಪ ಪುಸ್ತಕಗಳನ್ನು ಓದುತ್ತಿರುತ್ತಾಳಲ್ಲಾ.\nಈ ಪುಸ್ತಕದಲ್ಲಿ ಪುಟ್ಟ ತಮ್ಮನಿಗೆ ರಾತ್ರಿಯಲ್ಲಿ ಸೂರ್ಯ ಎಲ್ಲಿ ಹೋಗುತ್ತಾನೆಂಬ ಆಶ್ಚರ್ಯ \nಉಂಟಾಗುತ್ತದೆ. ಆತ ದಿನವಿಡೀ ದುಡಿದು ಸುಸ್ತಾಗಿ ಮಲಗಲು ಹೋಗುತ್ತಾನೇಯೇ ಅಥವಾ \nಇನ್ನೆಲ್ಲಾದರೂ ಆಳದಲ್ಲಿ ಮುಳುಗಿ ಬಿಡುತ್ತಾನೆಯೇ - ನೀರಿನಡಿಯಲ್ಲಿ ಆಟವಾಡುವ \nಜಲಕನ್ಯಯರಿಗೆ ಬೆಳಕು ಕೊಡಬೇಕಲ್ಲ.\nಕೊನೆಗೆ ಅಕ್ಕನೇ ಸರಿಯಾದ ಉತ್ತರ ಕೊಡುತ್ತಾಳೆ. ಆದರೆ, ಈ ಪುಸ್ತಕ ಓದಲು ಆರಂಭಿಸುವ \nಮುನ್ನವೇ ರಾತ್ರಿಯಲ್ಲಿ ಸೂರ್ಯನೆಲ್ಲಿ ಮಾಯವಾಗುತ್ತಾನೆ ನೀವು ಹೇಳಿ ನೋಡೋಣ.\nಈ ಪುಸ್ತಕಗಳೂ ಲಭ್ಯ\nಕತ್ತಲಲ್ಲಿ ಸೂರ್ಯನೆಂತು ಮರೆಯಾಗುವನಕ್ಕಾ?\nಅಕ್ಕಾ, ಅಕ್ಕಾ, ವಸ್ತುಗಳೇತಕೆ ಏಳವು ಮೇಲಕೆ?\nಅಕ್ಕಾ, ಅಕ್ಕಾ, ಗುಡುಗುಡು ಸದ್ದು ಬರುವುದೆಲ್ಲಿಂದ ಎದ್ದು?\nಹೇಳೇ ಅಕ್ಕಾ ಆಗಸವೇಕೆ ತಿಳಿನೀಲಿ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722403/size7/bb21401a90260fde1161c0d0b384ab76.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722403/size7/bb21401a90260fde1161c0d0b384ab76.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-448","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-448","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":499,"opdsId":"urn:uuid:SW-578279","title":"ನಿರ್ಧಾರ","authors":["Bhat Ananthesha"],"language":"","readingLevel":"Level 3","publisher":"","summary":"ಒಂದು ಹಳ್ಳಿಯು ತಮ್ಮ ಜೀವನವನ್ನು ಉತ್ತಮವಾಗಿ ಬದಲಾಯಿಸಲು ಒಟ್ಟಾಗಿ ನಿರ್ಧಾರ ತೆಗೆದುಕೊಳ್ಳುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/106408/size7/1810d196f828b94b51312fbbe19e1392.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/106408/size7/1810d196f828b94b51312fbbe19e1392.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-578279","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-578279","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":500,"opdsId":"urn:uuid:SW-381946","title":"ಸೂರ್ಯನನ್ನೇ ತಿಂದ ಮೈನಾ!","authors":["Deepti B"],"language":"","readingLevel":"","publisher":"","summary":"ತುಂಬ ಹಸಿದ ಒಂದು ಮೈನಾ ತನ್ನ ಪ್ರೀತಿಯ ತಿಂಡಿಯಾದ ಸೂರ್ಯನನ್ನು ತಿನ್ನಲು ಬಯಸುತ್ತಿದೆ. ಸೂರ್ಯನನ್ನು ತಿನ್ನಲು ಹೇಗೆ ಸಾಧ್ಯ? ಆಹಾರ ಸರಪಳಿಯ ಬಗೆಗಿನ ರೋಚಕ ಕತೆಯನ್ನು ಈ ಪುಸ್ತಕದಲ್ಲಿ ಕಾಣಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/491384/size7/4a7f9ec316e3ecd57b8b23dcad84a928.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/491384/size7/4a7f9ec316e3ecd57b8b23dcad84a928.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-381946","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-381946","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":501,"opdsId":"urn:uuid:SW-13750","title":"ಕಲ್ಪನಾಳ ಸೈಕಲ್ ಸವಾರಿ","authors":["Aparna Prasanna"],"language":"","readingLevel":"","publisher":"","summary":"ಕಲ್ಪನಾ ಸೈಕಲ್ ಕಲಿಯುತ್ತಿದ್ದಾಳೆ, ಆದರೆ ಅದು ಅಷ್ಟು ಸುಲಭವಲ್ಲ. ಅವಳು ಪದೇ ಪದೇ ಬೀಳುತ್ತಿದ್ದಾಳೆ, ಬಿದ್ದು ಗಾಯ ಮಾಡಿಕೊಳ್ಳುತ್ತಿದ್ದಾಳೆ. ಅವಳು ಕೊನೆಗೂ ಸೈಕಲ್ ಕಲಿತಳೇ? ಅಥವಾ ಕಲಿಯುವುದನ್ನು ಬಿಟ್ಟು ಬಿಟ್ಟಳೇ? ಪ್ರಯತ್ನದ ಮಹತ್ವದ ಬಗ್ಗೆ ಸಾಹಿತ್ಯ ಅಕಾಡಮಿಯ ಬಾಲ ಸಾಹಿತ್ಯ ಪುರಸ್ಕಾರ ವಿಜೇತರು ಬರೆದಿರುವ ಮನಮುಟ್ಟುವ ಕಥೆಯಿದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/713553/size7/3ad6ce1af3d4d426a2cb31704c688037.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/713553/size7/3ad6ce1af3d4d426a2cb31704c688037.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-13750","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-13750","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":502,"opdsId":"urn:uuid:SW-150264","title":"ಕನ್ನಡಿಯಲ್ಲಿ ಯಾರದು?","authors":["Sandesh H  Naik"],"language":"","readingLevel":"","publisher":"","summary":"ಕನ್ನಡಿಯಲ್ಲಿ ಯಾರದು? ಮಾನಸ ಅದನ್ನು ಕಂಡುಹಿಡಿಯಲು ಏನೆಲ್ಲ ಪ್ರಯತ್ನಗಳನ್ನು ಮಾಡುತ್ತಾಳೆ ನೋಡಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715292/size7/3607544f44e5bafa3e829994c2ba226d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715292/size7/3607544f44e5bafa3e829994c2ba226d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-150264","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-150264","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":503,"opdsId":"urn:uuid:SW-14745","title":"ಕಲ್ಲುವಿನ ಪ್ರಪಂಚ 3 - ಮಂಗು ಮಾಲಿ ಮತ್ತು ಅಂಬಿ ಭೂತ","authors":["Shalini Jaikumar"],"language":"","readingLevel":"","publisher":"","summary":"ಕಲ್ಲುವಿನ ಪ್ರಪಂಚಕ್ಕೆ ಸ್ವಾಗತ - ಇಲ್ಲಿ ಪ್ರತಿದಿನ ಕಲ್ಲು ಮತ್ತವನ ಪಟಾಲಮ್ಮಿನ ಅದ್ಭುತ ಸಾಹಸಗಳು ನಡೆಯುತ್ತಲೇ ಇರುತ್ತವೆ. ಇವರು ಹಳ್ಳಿಯ ಸಂಪ್ರದಾಯಗಳನ್ನು ಪ್ರಶ್ನಿಸುವ, ತಂಟೆಕೋರ ಪುಂಡರನ್ನು ಪ್ರತಿಭಟಿಸುವ ತುಂಟರು. ಬನ್ನಿ, ಊರೆಲ್ಲಾ ಅಡ್ಡಾಡುತ್ತಾ ದಿನವೂ ಹೊಸತನ್ನು ಕಲಿಯುತ್ತಾ ಜಾಣರಾಗುತ್ತಿರುವ ಅವರ ಜೊತೆಗೂಡಿ.\nಖಜೂರಿಯದಲ್ಲಿ ಎಲ್ಲರಿಗೂ ಮುನಿಯಳ ಕೋಪದ ಬಗ್ಗೆ ಗೊತ್ತಿತ್ತು. ಮಂಗು ಮಾಲಿ ಅವನ ತೋಟದಲ್ಲಿದ್ದ ಮಾವಿನಹಣ್ಣುಗಳನ್ನು ಕೊಡುವ ವಿಷಯದಲ್ಲಿ ಎಷ್ಟು ಜಿಪುಣ ಎಂಬುದು ಕೂಡ ಎಲ್ಲರಿಗೂ ತಿಳಿದಿತ್ತು. ಈಗ ಮುನಿಯಳಿಗೆ ಮಾವಿನಹಣ್ಣು ತಿನ್ನಬೇಕೆನ್ನಿಸಿತು. ಅದೂ ಮಂಗು ಮಾಲಿಯ ತೋಟದಲ್ಲಿದ್ದ ಮಾವಿನಹಣ್ಣುಗಳನ್ನೇ ತಿನ್ನಬೇಕೆನ್ನಿಸಿತು. ಇಂತಹ ಒಂದು ಪರಿಸ್ಥಿತಿಯನ್ನು ನೀವು ಕಲ್ಪಿಸಿಕೊಳ್ಳಬಹುದೇ? ಮುಂದೆ ಏನಾಗಬಹುದೆಂದು ಓದಿ ತಿಳಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/31115/size7/6d83c8e348dae277f57773d74ef2f9e2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/31115/size7/6d83c8e348dae277f57773d74ef2f9e2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-14745","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-14745","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":504,"opdsId":"urn:uuid:SW-63811","title":"ಹಾರಿ, ಹಾರುತ ದೂರ, ದೂರಕೆ!","authors":["Nagesh  Hegde"],"language":"","readingLevel":"","publisher":"","summary":"ಅರುಗೆ ಹಾರುವ ಆಸೆ, ಆದರೆ ಗುರುತ್ವ ಅವಳನ್ನು ನೆಲದ ಮೇಲೆ ಹಿಡಿದು ನಿಲ್ಲಿಸುತ್ತದೆ. ಭೂಮಿಯ ಮೇಲೆ ಕೆಲವು ಕ್ಷಣ ಗುರುತ್ವ ಇಲ್ಲದಿದ್ದರೆ ಏನಾಗುತ್ತದೆ? ಅರುಗೆ ಈಗ ಇದನ್ನು ಕಂಡು ಹಿಡಿಯಬೇಕಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/718097/size7/96641d24388cc30887da384c9724904e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/718097/size7/96641d24388cc30887da384c9724904e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-63811","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-63811","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":505,"opdsId":"urn:uuid:SW-57107","title":"ಬೀಚಲ್ಲಿ ಗೊರಿಲ್ಲಾಗಳು","authors":["Tanuja Jakkannavar"],"language":"","readingLevel":"","publisher":"","summary":"ಕುಣಿದಾಡು, ನೆಗೆದಾಡು, ಆಟವಾಡು! ಗೊರಿಲ್ಲಾ ಗೆಳೆಯರಿಂದು ಬೀಚಿಗೆ ಹೊರಟಿದ್ದಾರೆ. ಬೀಚಲ್ಲಿ ಗೊರಿಲ್ಲಾದೇನು ಕೆಲಸ ಅಂದಿರಾ? ಬನ್ನಿ, ನೋಡೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727081/size7/71dba9e0d57f48debbb73e859b0c45fe.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727081/size7/71dba9e0d57f48debbb73e859b0c45fe.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-57107","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-57107","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":506,"opdsId":"urn:uuid:SW-586298","title":"ನಮ್ಮ ರಜಾ ದಿನಗಳು","authors":["Smitha sathyaprakash"],"language":"","readingLevel":"","publisher":"","summary":"ಈ ಬಾರಿಯ ನಿಮ್ಮ ರಜಾ ದಿನಗಳನ್ನು ಹೇಗೆ ಕಳೆದಿರಿ? ಈ ಪುಸ್ತಕದಲ್ಲಿರುವ ಮಕ್ಕಳು ಅವರ ರಜಾ ದಿನಗಳಲ್ಲಿ ಏನೇನು ಮಾಡಿದರು ನೋಡೋಣ ಬನ್ನಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/101419/size7/a70081c575ef41c895932302704ba952.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/101419/size7/a70081c575ef41c895932302704ba952.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-586298","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-586298","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":507,"opdsId":"urn:uuid:SW-49020","title":"ಗಪ್ಪು ಕುಣಿದಳು!","authors":["Tanuja Jakkannavar"],"language":"","readingLevel":"","publisher":"","summary":"ಗಪ್ಪುಗೆ ಕುಣಿಯಲು ಬರುವುದಿಲ್ಲ ಎಂದು ಕ್ಲಾಸಿನಲ್ಲಿರುವ ಎಲ್ಲರಿಗೂ ಗೊತ್ತಾಗಿದೆ. ಮಕ್ಕಳೆಲ್ಲ ಎಡಗೈ ಎತ್ತಿದರೆ, ಗಪ್ಪು ಬಲಗೈ ಎತ್ತುವಳು! ಹಾಗಿದ್ದರೆ ಕೋಮಲಾ ಮಿಸ್ ಗಪ್ಪುಗೆ ಕುಣಿವುದನ್ನು ಕಲಿಸುವರೆ? ಅಕ್ಕ-ಪಕ್ಕ ನೋಡದೇ ಕುಣಿವುದರಲ್ಲಿ ಮಜವಿದೆ ಎನ್ನುತ್ತದೆ ಈ ಸರಳ ಕಥೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/86794/size7/d9e7817fdf87669ef2d64e2b131c3593.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/86794/size7/d9e7817fdf87669ef2d64e2b131c3593.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-49020","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-49020","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":508,"opdsId":"urn:uuid:SW-12373","title":"ಹೆಚ್ಚು ಅಥವಾ ಕಡಿಮೆ? ಊಹಿಸಿ!","authors":["Aparna Prasanna"],"language":"","readingLevel":"","publisher":"","summary":"ಎಣಿಸಲು ಎಷ್ಟೊಂದು ಮಿಠಾಯಿ ಡಬ್ಬಿಗಳು, ಎಷ್ಟೊಂದು ಕಡಿಮೆ ಸಮಯ! ರಂಜಿತ ಮತ್ತು ವಿಕ್ರಮ್ ನಿಂದ ಇದು ಸಾಧ್ಯವೇ? ಹೌದು, ಗಣಿತದ ಯುಕ್ತಿ ಬಳಸಿ ’ಹೆಚ್ಚು-ಕಡಿಮೆ ಅಂದಾಜು’. ಈ ತಂತ್ರವನ್ನು ನೀವು ಕಲಿಯಲು ಮಜವಾದ ಈ ಮದುವೆಯ ಕಥೆಯನ್ನು ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712829/size7/da3cb47b4e548e2e6f4f4ebd366e9ac0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712829/size7/da3cb47b4e548e2e6f4f4ebd366e9ac0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12373","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12373","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":509,"opdsId":"urn:uuid:SW-223565","title":"ನಾನು ಯಾರು?","authors":["Manjunath B G"],"language":"","readingLevel":"","publisher":"","summary":"ನಾನೊಂದು ಪ್ರಾಣಿ, ನನ್ನ ಹೊಟ್ಟೆಯಲ್ಲಿ ಒಂದು ಚೀಲ ಇದೆ. ಹೇಳಿ ನಾನು ಯಾವ ಪ್ರಾಣಿ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283184/size7/c8dc580322ba6c1d13d94c78f05f8b06.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283184/size7/c8dc580322ba6c1d13d94c78f05f8b06.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-223565","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-223565","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":510,"opdsId":"urn:uuid:SW-445250","title":"ಗೆಜ್ಜೆ ಗುಟ್ಟು","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ರಾಯ್ ಧರಿಸಿರುವ ಅಜ್ಜಿಯ ಗೆಜ್ಜೆ ಸದ್ದು ಯಾರಿಗೂ ಕೇಳಿಸಬಾರದು. ಆದರೆ, ಅದನ್ನ ಮುಚ್ಚಿಡುವುದು ಊಹಿಸಿದ್ದಕ್ಕಿಂತ ಹೆಚ್ಚು ಕಠಿಣವಾಗಿದೆ ಮತ್ತು ಅವನಿಗೆ ತಾನು ತಪ್ಪು ಮಾಡಿಬಿಟ್ಟೆ ಎನ್ನುವ ಭಾವ ಕಾಡುತ್ತಿದೆ. ರಾಯ್ ಈ ಗೊಂದಲದಲ್ಲಿ ಹೇಗೆ ಸಿಲುಕಿದ ಮತ್ತು ಅದರಿಂದ ಹೇಗೆ ಹೊರಬರುತ್ತಾನೆ? ಗಲ್-ಗಲ್...","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717407/size7/2ceccd52eb887c7a45da3ee2d7871842.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717407/size7/2ceccd52eb887c7a45da3ee2d7871842.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-445250","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-445250","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":511,"opdsId":"urn:uuid:SW-351276","title":"ಆಶಾಳ ದನಿ","authors":["Vinathe Sharma"],"language":"","readingLevel":"","publisher":"","summary":"ಆಶಾ ಎಲ್ಲಾ ತರಹದ ಕೆಲಸಗಳನ್ನು ಮಾಡಲು ಇನ್ನೂ ತುಂಬಾ ಚಿಕ್ಕವಳು. ಆದರೆ, ಕೆಲವೊಂದು ಕೆಲಸಗಳನ್ನು ಮಾಡಲು ಅವಳು ದೊಡ್ಡ ಹುಡುಗಿ. ದೊಡ್ಡ ಆಲೋಚನೆಗಳನ್ನು ಮಾಡಲು ನಾವೇನೂ ಚಿಕ್ಕವರಲ್ಲ ಎನ್ನುವ ಕತೆಯಿದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/645619/size7/bd7c729e225fe34acd79502c24a406ef.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/645619/size7/bd7c729e225fe34acd79502c24a406ef.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-351276","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-351276","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":512,"opdsId":"urn:uuid:SW-64585","title":"ಸುದಿಪ್ತಾ ಸೇನ್ ಗುಪ್ತಾ - ಕರೆಯುತಿದೆ ಕಲ್ಲು!","authors":["Tanuja Jakkannavar"],"language":"","readingLevel":"","publisher":"","summary":"ಸುದಿಪ್ತಾಳಿಗೆ ಪರ್ವತರೋಹಣವೆಂದರೆ ಇಷ್ಟ. ಅವಳಿಗೆ ಬಂಡೆಕಲ್ಲುಗಳ ಜಾತಕ, ಪುಸ್ತಕಗಳನ್ನು ಓದುವಷ್ಟೇ ಕರತಲಾಮಲಕ. ಶಿರ್ಮಾರ್ಕರಿನ ಬಂಡೆಕಲ್ಲುಗಳ ಬಗ್ಗೆ ಅರಿಯಲು ಆಕೆ ಆ ಬೆಟ್ಟವನ್ನೇ ಏರಿದ ಮೊದಲ ಭಾರತೀಯ ಮಹಿಳಾ ಭೂವಿಜ್ಞಾನಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/718389/size7/ea4bf7799998c102cf56af0f5fb6246a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/718389/size7/ea4bf7799998c102cf56af0f5fb6246a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-64585","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-64585","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":513,"opdsId":"urn:uuid:SW-219998","title":"ಬಂಟಿ ಮತ್ತು ಅಮ್ಮ","authors":["Shabana Begum"],"language":"","readingLevel":"","publisher":"","summary":"ಅಪ್ಪ ಬಂಟಿಗಾಗಿ ಗಾಳಿಪಟ ತಂದರು. ಆದರೆ ಅದು ನೀರಿನಲ್ಲಿ ಒದ್ದೆಯಾಯಿತು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283165/size7/184bb3160617d029a3fc16e15dd351af.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283165/size7/184bb3160617d029a3fc16e15dd351af.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-219998","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-219998","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":514,"opdsId":"urn:uuid:SW-223603","title":"ಗೂಬೆ ರಾಜನ ರಾತ್ರಿ","authors":["Shabana Begum"],"language":"","readingLevel":"","publisher":"","summary":"ರಾತ್ರಿಯಾಯಿತು ಗೂಬೆ ರಾಜನ ಸಭೆ ಪ್ರಾರಂಭವಾಯಿತು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283796/size7/5bd5aefbeffb0a95e36efc078822af1c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283796/size7/5bd5aefbeffb0a95e36efc078822af1c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-223603","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-223603","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":515,"opdsId":"urn:uuid:SW-48447","title":"ಮೋನಾಳ ಚಪಾತಿ","authors":["Smitha sathyaprakash"],"language":"","readingLevel":"","publisher":"","summary":"ಬಿಸಿಬಿಸಿಯಾದ, ಉಬ್ಬಿದ ಚಪಾತಿ ಮಾಡುವುದು ಹೇಗೆಂದು ಮೋನಾ ಜತೆ ನೀವೂ ಕಲಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/83282/size7/6f439dc6767b16a5454d590c58cecae7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/83282/size7/6f439dc6767b16a5454d590c58cecae7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-48447","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-48447","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":516,"opdsId":"urn:uuid:SW-609665","title":"ಬೆಳಕೋ ಬೆಳಕು","authors":["S Diwakar"],"language":"","readingLevel":"","publisher":"","summary":"ಅಮ್ಮನ ದೃಷ್ಟಿಯಲ್ಲಿ ಶಕ್ತಿ ಏನನ್ನೂ ಸರಿಯಾಗಿ ಮಾಡದ, ಯಾವುದಕ್ಕೂ ಲಾಯಕ್ಕಲ್ಲದ ಹುಡುಗಿ. ಆದರೆ, ಅದೇ ಶಕ್ತಿಗೆ ಹುಡುಗಿಯೊಬ್ಬಳು ಎಲ್ಲರಲ್ಲೂ ಇರುವ ಬೆಳಗುವ ಸಾಮರ್ಥ್ಯವನ್ನು ನೆನಪು ಮಾಡಿಕೊಟ್ಟದ್ದೇ ಅವಳು ಸಂಪೂರ್ಣವಾಗಿ ಬದಲಾಗುತ್ತಾಳೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727673/size7/46954cc7c750b045e7e96c77bd372b8f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727673/size7/46954cc7c750b045e7e96c77bd372b8f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-609665","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-609665","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":517,"opdsId":"urn:uuid:SW-93310","title":"ಶರತ್ಕಾಲದ ಮೈತ್ರಿ","authors":["Srinidhi  TG"],"language":"","readingLevel":"","publisher":"","summary":"ಬೇಸಿಗೆ ಮುಗಿಯುತ್ತ ಬಂದಿದೆ ಮತ್ತು ನಿಮ್ಮಿ ಅಮ್ಮನಿಗಾಗಿ ಕೆಲಸಗಳನ್ನು ಮಾಡಿಕೊಡುವುದರಲ್ಲೇ ಮುಳುಗಿದ್ದಾಳೆ. ಅವಳ ಪಾಲಿಗೆ ಬಂದಿರುವ ಹೊಸ ಕೆಲಸ - ಪಕ್ಕದ ಮನೆಯ ಅಕ್ಕನಿಗೆ ಮೊಟ್ಟೆಗಳನ್ನು ಕೊಟ್ಟು ಬರುವುದು. ನೀರಸವೆಂದು ತೋರುವ ಈ ಕೆಲಸವೇ ದಿನವನ್ನು ಕಳೆಯುವ ಒಳ್ಳೆಯ ಮಾರ್ಗವೂ ಆಗಬಹುದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/621804/size7/3dd5318d2513738716d8e20eae0d3a16.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/621804/size7/3dd5318d2513738716d8e20eae0d3a16.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-93310","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-93310","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":518,"opdsId":"urn:uuid:SW-32706","title":"ಅಪ್ಪನಿಗೆ ಗಣಿತ ಪಾಠ!","authors":["Kollegala Sharma"],"language":"","readingLevel":"","publisher":"","summary":"ದಿಯಾಳ ಅಪ್ಪ ಶಾಲೆಗೆ ಹೋದವರಲ್ಲ. ಆದ್ದರಿಂದ ಅವಳೇ ಅವರಿಗೆ ಪಾಠ ಕಲಿಸಬೇಕು ಎಂದು ಸಂಕಲ್ಪ ಮಾಡಿದಳು. ಅಪ್ಪ ಯಾವಾಗಲೂ ಅವಳ ಮಾತು ಕೇಳುತ್ತಾರೆ.\nಆದರೂ ಅವರಿಗೆ ಗಣಿತ ಕಲಿಸುವುದು ಬಹಳ ಕಷ್ಟ. ಹೀಗಿರುವಾಗ ದಿಯಾ ತನ್ನ ಅಪ್ಪನಿಗೆ ಲೆಕ್ಕ ಹೇಗೆ ಕಲಿಸುತ್ತಾಳೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/524659/size7/c55e8e922116b1ad507a3d2b05223006.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524659/size7/c55e8e922116b1ad507a3d2b05223006.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-32706","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-32706","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":519,"opdsId":"urn:uuid:SW-540321","title":"ಗೋಲ್!","authors":["Navika"],"language":"","readingLevel":"","publisher":"","summary":"ಹೀನಾ ಪ್ರತಿ ಭಾನುವಾರವೂ ಕಿಟಕಿಯಿಂದ ಕೆಲವು ಹುಡುಗಿಯರು \nಫುಟ್‌ಬಾಲ್‌ ಆಡುವುದನ್ನು ನೋಡುತ್ತಾಳೆ. ಅವಳಿಗೂ ಅವರ ಜತೆ \nಆಡಲು ಇಷ್ಟ. ಆದರೆ, ಅಬ್ಬೂ ಹಾಗೂ ಅಮ್ಮಿಯನ್ನು ಅದಕ್ಕೆ \nಒಪ್ಪಿಸುವುದು ಸುಲಭವಲ್ಲ. ಅವಳು ತಂಡವನ್ನು ಸೇರಿಕೊಳ್ಳುವಳೇ? \nಅವರೆಲ್ಲರ ಜತೆ ಓಡುತ್ತಾ, ಫುಟ್‌ಬಾಲ್‌ ಆಡುತ್ತಾ, ಕಿಕ್‌ ಹೊಡೆದು, \nಗೋಲು ಗಳಿಸಿ ಸ್ವಾತಂತ್ರ್ಯದ ಸುಖ ಅನುಭವಿಸುವಳೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722712/size7/9dad0be4a882027e361a9250311b4692.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722712/size7/9dad0be4a882027e361a9250311b4692.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-540321","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-540321","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":520,"opdsId":"urn:uuid:SW-45955","title":"ರಾಜನ ಕಿರೀಟ","authors":["Subbakrishna Rao"],"language":"","readingLevel":"","publisher":"","summary":"ರಾಜ 'ಅನವ್ರತ' ಎತ್ತರದ ದೇಗುಲವನ್ನು ಕತ್ತೆತ್ತಿ ನೋಡುವಾಗ ಆತನ ಕಿರೀಟ ಕೆಳಗೆ ಬಿತ್ತು. ರಾಜ ತನ್ನ ಕಿರೀಟ ಬೀಳದಂತೆ ಗೋಪುರ ನೋಡಲು ಏನು ಮಾಡಿದ ಎಂಬುದನ್ನು ತಿಳಿಯಲು ಮಯಾನ್ಮಾರ್‌ ಈ ಕಥೆ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726964/size7/0ae16bb956d9050f08df35fe1dabc4dd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726964/size7/0ae16bb956d9050f08df35fe1dabc4dd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-45955","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-45955","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":521,"opdsId":"urn:uuid:SW-24722","title":"ಮಿಸ್ ಬ್ಯಾಂಡಿಕೋಟ ಹುಡುಕಿದ ಪುರಾತನ ಗುಹೆಗಳು","authors":["Kumar S"],"language":"","readingLevel":"","publisher":"","summary":"ಮಿಸ್ ಬ್ಯಾಂಡಿಕೋಟ ಸಾಮಾನ್ಯ ಹೆಗ್ಗಣಗಳಂತೆ ಅಲ್ಲ. ಅವಳು ಸದಾ ಹೊಸ ಸಾಹಸಗಳನ್ನು ಮಾಡಲು ಉತ್ಸುಕಳಾಗಿದ್ದಳು... ಕನ್ನಡಕ, ಬೈನಾಕ್ಯುಲರ್, ಸ್ಟಿಕರ್ ಬ್ಯಾಂಡೇಜ್ ಹೊಂದಿರುವ ಕೈಚೀಲದೊಂದಿಗೆ ಪ್ರತಿ ದಿನ ಸಂಜೆ ಹೊರಡುತ್ತಿದ್ದ ಅವಳು  ಹೊಸ ಜಾಗವನ್ನು ಅನ್ವೇಷಿಸುತ್ತಿದ್ದಳು.          \nಅನ್ವೇಷಕರು ಸದಾ ಸಿದ್ಧರಿರುತ್ತಾರೆ ಎನ್ನುವ ಬ್ಯಾಂಡಿಕೋಟ, ಇಡೀ ರಾತ್ರಿ ಬಿಲ ಕೊರೆದು ಹೊಸ ಸಮುದ್ರ ತೀರ, ಬೆಟ್ಟ-ಗುಡ್ಡಗಳನ್ನು ತಲುಪುತ್ತಿದ್ದಳು. ಈ ಕಥೆಯಲ್ಲಿ ತನ್ನ ಹೊಸ ಸ್ನೇಹಿತ ನೊಂದಿಗೆ ಅವಳು ಭಾರತದ ಪುರಾತನ ಗುಹೆಗಳನ್ನು ಅನ್ವೇಷಿಸಿದ್ದಾಳೆ. ಬನ್ನಿ, ನೀವೂ ಅವಳೊಂದಿಗೆ ಜೊತೆಗೂಡಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117031/size7/51df7e3258940334c16aef2ad8a6f8e6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117031/size7/51df7e3258940334c16aef2ad8a6f8e6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-24722","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-24722","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":522,"opdsId":"urn:uuid:SW-398596","title":"ಘಮ್ ಅಂತಿದೆ!‌","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಶಾಂತಿನಿಕೇತನದಲ್ಲಿ ಒಂದು ದಿನ, ಮಿನಿಗೆ ಅದೆಲ್ಲಿಂದಲೋ \nಘಮಘಮ ಪರಿಮಳ ಬರುತ್ತಿದೆ. ಅದು ಯಾವುದರ ಘಮ ಇರಬಹುದು ಅಂತ ಹುಡುಕುತ್ತ ಹೊರಟವಳಿಗೆ ಏನೆಲ್ಲಾ ಕಂಡಿತು ಗೊತ್ತಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/706357/size7/e619d7631277c90319d1b47e0d884bca.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/706357/size7/e619d7631277c90319d1b47e0d884bca.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-398596","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-398596","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":523,"opdsId":"urn:uuid:SW-440419","title":"ಎಲ್ಲರೂ ತಿನ್ನುತ್ತಾರೆ!","authors":["Bhat Ananthesha"],"language":"","readingLevel":"","publisher":"","summary":"ಪ್ರತಿಯೊಂದು ಪ್ರಾಣಿಯು ವಿಭಿನ್ನ ಆಹಾರವನ್ನು ಹೊಂದಿರುತ್ತದೆ. ಅವರು ಏನು ತಿನ್ನುತ್ತಾರೆ ಎಂದು ಕಂಡುಹಿಡಿಯೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/150107/size7/5625ec845065d5711b10f51242e9a806.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/150107/size7/5625ec845065d5711b10f51242e9a806.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-440419","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-440419","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":524,"opdsId":"urn:uuid:SW-551","title":"ವೀರು ಸರ್ಕಸ್ ಗೆ ಹೋದ","authors":["Aparna Prasanna"],"language":"","readingLevel":"","publisher":"","summary":"ಜಂಬೊ-ಮಂಬೊ ಸರ್ಕಸ್ ನಿಂದ ಮರಳಿದ ವೀರುಗೆ ದೊಡ್ಡದೊಡ್ಡ ಉಪಾಯಗಳು ಹೊಳೆದವು. ಅವುಗಳನ್ನು ತಿಳಿಯಲು ಈ ಪುಸ್ತಕವನ್ನು ಓದಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721025/size7/4d5245425fec73a2fc96ab944c5d1b0c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721025/size7/4d5245425fec73a2fc96ab944c5d1b0c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-551","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-551","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":525,"opdsId":"urn:uuid:SW-92307","title":"ನಾನು ಹತ್ತಬಲ್ಲೆ!","authors":["Meera Tushar Punarvasu"],"language":"","readingLevel":"","publisher":"","summary":"ಇಲ್ಲಿ, ಪುಟ್ಟ ಹುಡುಗ ಮೇಲೆ ಹತ್ತಲು ಕಲಿಯುತ್ತಿದ್ದಾನೆ. ಆದರೆ ಕೆಳಗೆ ಇಳಿಯುವುದು ಅವನಿಗೆ ಗೊತ್ತೆ? ‘ಬೆಳೆಯುತ್ತಿರುವವರು’ ಸರಣಿಯಲ್ಲಿನ ನಾಲ್ಕು ಪುಸ್ತಕಗಳಲ್ಲಿ ಈ ಪುಸ್ತಕವೂ ಒಂದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/705479/size7/57c8c82ddc4444a38929edee69280586.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/705479/size7/57c8c82ddc4444a38929edee69280586.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-92307","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-92307","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":526,"opdsId":"urn:uuid:SW-15795","title":"ಒಂದು ಮಿಯಾಂ ಮತ್ತೊಂದು ಘುರ್","authors":["A.S. Chandra Mouli"],"language":"","readingLevel":"","publisher":"","summary":"ವೇದಿಕಾ ಮತ್ತು ಕರಣ್ ತಮ್ಮ ಅಜ್ಜನ ಕುರ್ಚಿಯಲ್ಲಿ ಕುಳಿತಿರುವಂತೆಯೇ ಒಂದು ನಿಜ ಸಾಹಸವನ್ನು ಹಂಚಿ ಕೊಂಡರು. ಈ ಮೋಜಿನ ಕಥೆಯಲ್ಲಿ ಅವರ ಸ್ನೇಹಿತರಾದ ಸಿಂಹ ಮತ್ತು ಬೆಕ್ಕನ್ನು ಭೇಟಿ ಮಾಡಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/40018/size7/d1e5bc76d62394c2859fdc1920374e28.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/40018/size7/d1e5bc76d62394c2859fdc1920374e28.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15795","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15795","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":527,"opdsId":"urn:uuid:SW-279","title":"ರಮ್ಯಳ  ನಕ್ಷತ್ರಗಳು","authors":["Aparna Prasanna"],"language":"","readingLevel":"","publisher":"","summary":"ರಮ್ಯಾಳ ವಜ್ರದ ಓಲೆಗಳು ಎಲ್ಲಿಂದ ಬಂದವು? \nಅದನ್ನು ಈ ನಳನಳಿಸುವ ಪುಟ್ಟ ಕಥೆಯಲ್ಲಿ ಓದಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/697344/size7/6dac34f354bcb34c50707ac6ec4b973b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/697344/size7/6dac34f354bcb34c50707ac6ec4b973b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-279","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-279","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":528,"opdsId":"urn:uuid:SW-460690","title":"ಒಂದು ಸುಂದರ ರಜಾದಿನ","authors":["Indumathi C"],"language":"","readingLevel":"","publisher":"","summary":"ಸಿಮ್ರಾನ್‌, ಜೀತು ಹಾಗೂ ವೀರು ತಮ್ಮಇಷ್ಟದ ತಿಂಡಿಗಳನ್ನು ಕೊಳ್ಳಲು ಮಂಜೀತ್ ಮಾಮಾ ಅಂಗಡಿಗೆ ಹೋಗುತ್ತಾರೆ. ಮಂಜೀತ್‌ ಅವರು ತಿಂಡಿಗಳನ್ನು ತೂಕ ಮಾಡುವುದನ್ನು ನೋಡಿ ಹಾಗೂ ಮಕ್ಕಳು ಕೊಂಡ ತಿಂಡಿಯ ತೂಕ ಎಷ್ಟು ಎಂದು ಕಂಡುಹಿಡಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/446383/size7/1fe4f6c5ed6cb8dd64f42353919bef98.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/446383/size7/1fe4f6c5ed6cb8dd64f42353919bef98.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-460690","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-460690","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":529,"opdsId":"urn:uuid:SW-114","title":"ಸ್ವಲ್ಪ ಸ್ವಲ್ಪ","authors":["A.S. Chandra Mouli"],"language":"","readingLevel":"","publisher":"","summary":"ತೋಳ ಆಶ್ರಯ ಕೇಳಿದಾಗ ಎರಡು ಧೈರ್ಯವಂತ ಪುಟ್ಟ ಮೊಲಗಳು ಏನು ಮಾಡಿದವು? ಈ ಮೋಜಿನ ಪುಸ್ತಕವನ್ನು ಸ್ವಲ್ಪ ಸ್ವಲ್ಪವಾಗಿ ಓದಿರಲ್ಲ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/700035/size7/404357a2d58fabc3af755d06b71f1125.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/700035/size7/404357a2d58fabc3af755d06b71f1125.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-114","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-114","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":530,"opdsId":"urn:uuid:SW-205283","title":"ಹತ್ತರ ಗಮ್ಮತ್ತು","authors":["Utthaana Bharighat"],"language":"","readingLevel":"","publisher":"","summary":"ಎಣಿಸುತ್ತ ಎಣಿಸುತ್ತ ಮಕ್ಕಳು ಬ್ರಹ್ಮಾಂಡವನ್ನು ಒಂದು ಸುತ್ತು ಸುತ್ತಿ ಬರುವ ಪುಸ್ತಕ ಇದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527932/size7/c96a288120349dfd79243cdb758f3daf.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527932/size7/c96a288120349dfd79243cdb758f3daf.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-205283","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-205283","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":531,"opdsId":"urn:uuid:SW-314521","title":"ಪೂಚಿಗೊಬ್ಬ ಸ್ನೇಹಿತೆ","authors":["Navika"],"language":"","readingLevel":"","publisher":"","summary":"ಸ್ನೇಹಿತರನ್ನು ಮಾಡಿಕೊಳ್ಳುವುದು ಸುಲಭವಲ್ಲ. ಅದರಲ್ಲೂ ಪೂಚಿ ತರಹ ಉದ್ದ ಕೂದಲುಳ್ಳ, ಭಯಭೀತನಾದವನಿಗಂತೂ ತುಂಬಾ ಕಷ್ಟ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/621788/size7/2783d2c2ca6b720a3821276ee8967b44.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/621788/size7/2783d2c2ca6b720a3821276ee8967b44.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-314521","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-314521","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":532,"opdsId":"urn:uuid:SW-26398","title":"ಜೇಡ ಬಂತು ಜೇಡ!","authors":["Shashi Sampalli"],"language":"","readingLevel":"","publisher":"","summary":"ಜೇಡ ಏನೇನೆಲ್ಲಾ ಮಾಡುತ್ತೆ ಗೊತ್ತಾ? ಇಲ್ಲ ಅಲ್ಲವಾ? ಹಾಗಾದರೆ ಜೇಡನ ರಾತ್ರಿ ವಿಹಾರದಲ್ಲಿ ಜೊತೆಯಾಗಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726735/size7/be74f0e5449aa5d37bb143e53e0f0a2c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726735/size7/be74f0e5449aa5d37bb143e53e0f0a2c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-26398","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-26398","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":533,"opdsId":"urn:uuid:SW-121117","title":"ಒಂದು ನದಿಯ ಕಾಲಯಾತ್ರೆ","authors":["LC Nagaraj"],"language":"","readingLevel":"","publisher":"","summary":"ನದಿಗಳು ಹಿಂದಿನ, ಇಂದಿನ, ಮುಂದಿನ ಕಾಲದ ಕತೆಗಳನ್ನು ಹೇಳುತ್ತವೆ ಗೊತ್ತಾ. ತುಂಬಾ ಮನುಷ್ಯರು ಆಹಾರ ಬೆಳೆದುಕೊಳ್ಳಬೇಕೆಂದು ಬಯಸಿದಾಗ ನದಿಗಳಿದ್ದವು. ಮನುಷ್ಯರು ನಗರಗಳನ್ನು ಕಟ್ಟಲು ಬಯಸಿದಾಗ ನದಿಗಳಿದ್ದವು. ಮನುಷ್ಯರಿಗೆ ಅಗತ್ಯವಾದ ನೀರು, ಆಹಾರ ಬೆಳೆದು ಜೀವಿಸಲು ಅನುವು ಮಾಡಿಕೊಡಲು ನದಿಗಳು ಈಗಲು ಇವೆ. ಆದರೆ ಈಗ ನದಿಗಳನ್ನು ಕಸದ ತೊಟ್ಟಿಗಳೆಂದು ಮನುಷ್ಯರು ಭಾವಿಸಿ ನಿಂದನೆ ಮಾಡುತ್ತಿದ್ದಾರೆ. ನಮ್ಮ ಬಗ್ಗೆ ಹೇಗೆ ಕಾಳಜಿ ವಹಿಸಬೇಕು ಎಂಬುದು ನದಿಗಳಿಗೆ ಗೊತ್ತಿದೆ. ಆದರೆ ನದಿಗಳೊಂದಿಗೆ ಹೇಗೆ ವರ್ತಿಸಬೇಕು ಎಂಬುದು ನಮಗೆ ಗೊತ್ತಿಲ್ಲ. ನದಿಗಳು ನಾಳೆಯು ನಮ್ಮೊಂದಿಗೆ ಇರಬೇಕು ಎಂದಾದರೆ ಇಂದೆ ನಾವು ನಮ್ಮ ಕೆರೆ, ತೊರೆ, ಹೊಳೆ ಹಳ್ಳ ಮುಂತಾದ ಅಮೂಲ್ಯ ಜಲಕಾಯಗಳ ಬಗ್ಗೆ ಕಾಳಜಿ ವಹಿಸಬೇಕು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/196531/size7/011dc21c4087678d4acf7f20de6a0ff6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/196531/size7/011dc21c4087678d4acf7f20de6a0ff6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-121117","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-121117","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":534,"opdsId":"urn:uuid:SW-107653","title":"ಊಟದ ಕೂಟ","authors":["Harshavardhan Sullia"],"language":"","readingLevel":"","publisher":"","summary":"ಊಟದ ಸಮಯವೆಂದರೆ ಮೀನುಗೆ ಅದೇನೋ ಬೇಜಾರು. ಅವಳಮ್ಮ ಡಬ್ಬಿಗೆ ಯಾವಾಗಲೂ  ಇಡ್ಲಿಯನ್ನೇ ಕಟ್ಟುತ್ತಿದ್ದರು. ಆದರೆ, ಅವಳ ಸಹಪಾಠಿ ಕಮಲೇಶ್ ಡಬ್ಬಿಯಲ್ಲಿ ಏನಿದೆ? ಮೀನು ಕುತೂಹಲ ತಾಳದೇ ಡಬ್ಬಿಯಲ್ಲಿ ಇಣುಕಿ ನೋಡಿಯೇ ಬಿಡುವಳು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/159426/size7/24bf771e8e549de1a9f5449bc5c0e216.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/159426/size7/24bf771e8e549de1a9f5449bc5c0e216.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-107653","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-107653","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":535,"opdsId":"urn:uuid:SW-14481","title":"ಬಾದಶಹನ ಉದ್ಯಾನ","authors":["Raghunatha Cha. Ha."],"language":"","readingLevel":"","publisher":"","summary":"ಜನರು ಭಯಪಡುವ ಆ ನಿಷೇಧಿತ ಸ್ಥಳಕ್ಕೆ ಅಶ್ಹರ್ ಹೋದುದಾದರೂ ಏಕೆ? ಸುತ್ತಿಗೆ ಹಾಗೂ ಮೊಳೆ ಹಿಡಿದುಕೊಂಡು ಅಲ್ಲಿಗೆ ಹೋದ ಅವನು ಒಂದೋ ಹುಚ್ಚನಿರಬೇಕು ಇಲ್ಲವೇ ತಾನು ಧೈರ್ಯವಂತ ಎಂದು ನಿರೂಪಿಸಲು ಬಯಸಿರಬೇಕು. ಅಂದಹಾಗೆ, ಅವನು ಜುಲ್ಫಿಯ ಸವಾಲು ಒಪ್ಪಿಕೊಂಡಿದ್ದು ಏಕೆ? ಹುಣ್ಣಿಮೆಯ ರಾತ್ರಿಯಲ್ಲಿ ದೆವ್ವ ಸಂಚರಿಸುವ ಸ್ಮಾರಕವನ್ನು ಅಶ್ಹರ್ ಪ್ರವೇಶಿಸಿದನೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721706/size7/7455c3e7d30a58b67c0cb76a80888ca8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721706/size7/7455c3e7d30a58b67c0cb76a80888ca8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-14481","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-14481","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":536,"opdsId":"urn:uuid:SW-586816","title":"ಇವರು ನಮ್ಮ ಗೆಳೆಯರು","authors":["Pushpak M"],"language":"","readingLevel":"","publisher":"","summary":"ರೈನೋ, ಮೊಸಳೆ, ಜಿರಾಫೆ ಮತ್ತು ಜೀಬ್ರ ಎಲ್ಲರಿಗೂ ಇರುವ ಒಬ್ಬ ಗೆಳೆಯ ಯಾರು ಊಹಿಸುವಿರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/706095/size7/61695b92450e5cf6696869c4b800dd6e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/706095/size7/61695b92450e5cf6696869c4b800dd6e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-586816","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-586816","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":537,"opdsId":"urn:uuid:SW-436754","title":"ಹೇಳಿ ಎಷ್ಟು?","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ತೆವಳುವ ಬಸವನ ಹುಳುಗಳು, ಹಾರಾಡುವ ಚಿಟ್ಟೆಗಳು, ಕೆಸರಿನಲ್ಲಿ ಆಡುವ ಹಂದಿಗಳು. ಈ ಪುಸ್ತಕದಲ್ಲಿ ಇನ್ನೂ ಅನೇಕ ಪ್ರಾಣಿಗಳಿವೆ ಮತ್ತು ಇವುಗಳ ಜೊತೆಗೆ ಬೇರೆ ಬೇರೆ ಪ್ರಾಣಿಗಳು ಬಂದು ಸೇರುತ್ತಿವೆ. ಈ ಎಲ್ಲ ಪ್ರಾಣಿಗಳನ್ನು ನೀವು ಎಣಿಸುವಿರಾ? ಕೂಡಿಸುವುದರ ಬಗೆಗಿನ ಸರಳ ಪುಸ್ತಕ ಇದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527516/size7/2ce50b116586b7652ec79c738028bc67.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527516/size7/2ce50b116586b7652ec79c738028bc67.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-436754","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-436754","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":538,"opdsId":"urn:uuid:SW-61117","title":"ತೊಂದೆ ಮೀನಿನ ತೊಂದರೆ!","authors":["Shashi Sampalli"],"language":"","readingLevel":"","publisher":"","summary":"ಕಡಲ ದಂಡೆಯ ನೀರಿನ ಗುಂಡಿಯಲ್ಲಿ ತೊಂದೆ ಮೀನಿನ ಮರಿಯೊಂದು ಸಿಲುಕಿದೆ. ಅದು ಮರಳಿ ಕಡಲು ಸೇರುವುದೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/724195/size7/7c77fc33d367383329d2c2e7c042303b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/724195/size7/7c77fc33d367383329d2c2e7c042303b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-61117","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-61117","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":539,"opdsId":"urn:uuid:SW-445102","title":"ಚರಿತ್ರೆ ಹೇಳುವ ಮರ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಏನೂ? ಮರ ಚರಿತ್ರೆಯ ಕತೆ ಹೇಳುತ್ತದೆಯೇ? ಎಚ್ಚರಿಕೆಯಿಂದ ಆಲಿಸಿದರೆ, ಮರಗಳು ಪಿಸುಗುಡುವ; ಮಳೆ, ಬೇಸಿಗೆ, ಚಳಿಗಾಲ, ಭೂತ, ಭವಿಷ್ಯದ, ಕಾಡಿನ ಬೆಂಕಿಯ ಕತೆಗಳನ್ನು ನಿಜವಾಗಿಯೂ ಕೇಳಬಹುದು. ಮರದ ಕಾಂಡದೊಳಗಿನ ಅದರ ಹೃದಯವನ್ನು ಸೂಕ್ಷ್ಮವಾಗಿ ಗಮನಿಸಿದರೆ ಅಲ್ಲಿ ಅನೇಕ ಕತೆಗಳು ಅಡಗಿರುವುದು ಗೊತ್ತಾಗುತ್ತದೆ - ಈ ಪುಸ್ತಕದಲ್ಲಿ ಹೇಳಲಾದ ಕತೆಯಂತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716359/size7/c8fe91246e9c51abbdb60013eab5f3df.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716359/size7/c8fe91246e9c51abbdb60013eab5f3df.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-445102","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-445102","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":540,"opdsId":"urn:uuid:SW-146314","title":"ಎರಡರಷ್ಟು ಎತ್ತರ","authors":["Harshavardhan Sullia"],"language":"","readingLevel":"","publisher":"","summary":"ಅಬ್ಬಬ್ಬ, ಮುತ್ತುಲಕ್ಷ್ಮಿ ಪಿ ಅದೆಷ್ಟು ಬೇಗ ಬೆಳೆಯುತ್ತಿದ್ದಾಳೆ. ಅವಳು ದೊಡ್ಡವಳಾಗುತ್ತಾ ಇನ್ನೆಷ್ಟು ಉದ್ದಕ್ಕೆ ಬೆಳೆಯುವಳೋ ಏನೋ? ಅವಳು ತನ್ನ ಎರಡರಷ್ಟು ಆದರೆ? ಹಾಗೆಯೇ, ಎರಡೆರಡರಷ್ಟು ಬೆಳೆಯುತ್ತಲೇ ಹೋದರೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715294/size7/5e00e4f6b972e1c84779a28018b77d81.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715294/size7/5e00e4f6b972e1c84779a28018b77d81.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-146314","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-146314","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":541,"opdsId":"urn:uuid:SW-136445","title":"ಅಮ್ಮು ಮತ್ತು ಗುಬ್ಬಚ್ಚಿಗಳು","authors":["Dhanapala Nagarajappa"],"language":"","readingLevel":"","publisher":"","summary":"ಅಪ್ಪ ಅಮ್ಮನಿಂದ ದೂರವಾಗಿ ಅಜ್ಜಿ ಮನೆಯಲ್ಲಿ ಬೆಳೆಯುತ್ತಿರುವ ಅಮ್ಮುವಿಗೆ ಹಕ್ಕಿಗಳಿಗೆ ಕಾಳೂಡಿಸುವುದು ನೆಚ್ಚಿನ ಕೆಲಸ. ಪ್ರತಿ ಬಾರಿ ಹಕ್ಕಿಗಳಿಗೆ ಕಾಳೂಡಿಸುವಾಗಲು ಅಮ್ಮು, \nಅಪ್ಪ ಗುಬ್ಬಚ್ಚಿ ಮತ್ತು ಅಮ್ಮ ಗುಬ್ಬಚ್ಚಿ ಜೊತೆಯಾಗಿ ಬರುವರೆ ಎಂದು ಎದುರು ನೋಡುತ್ತಿರುತ್ತಾನೆ. ಅಪ್ಪ ಅಮ್ಮ ಜೊತೆ ಇಲ್ಲದಿರುವ ನೋವು ಅವನನ್ನು ಯಾವಾಗಲು ಕಾಡುತ್ತಿರುತ್ತದೆ. \nಅಪ್ಪ ಮತ್ತು ಅಮ್ಮ ಅಮ್ಮುವನ್ನು ಕರೆದುಕೊಂಡು ಹೋಗಲು ಜೊತೆಯಾಗಿ ಬರುವರೆ? \nಇದು ಅಗಲಿಕೆ ಮತ್ತು ಹಾತೊರೆಯುವಿಕೆಯ ಭಾವನೆಗಳ ಕುರಿತಾಗಿನ ಪುಸ್ತಕ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/198742/size7/02bbb40b5f8beb53fdf171d8bbf28752.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/198742/size7/02bbb40b5f8beb53fdf171d8bbf28752.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-136445","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-136445","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":542,"opdsId":"urn:uuid:SW-556522","title":"ಕತ್ತಲ ಹ್ಯಾಂಗ ಸದ್ದು ಮಾಡ್ತೈತಿ?","authors":["Hasan Nayeem Surkod"],"language":"","readingLevel":"","publisher":"","summary":"ಭಾವನೆಗಳು ಅಂದ್ರ ಅವು ಅನ್ನಿಸುವುದಾದರೂ ಹೆಂಗ? ಪ್ರೀತಿಯ ಸುವಾಸನೆ ಹ್ಯಾಂಗಿರ್ತೈತಿ? ಜಾದೂ ಅಂದ್ರ ಏನು? ದಿನಾ ನೋಡುವ ಸುಪರಿಚಿತ ಜಗತ್ತಿನ್ಯಾಗ ಹೆಜ್ಜಿ ಇಡ್ರಿ. ಹತ್ತಿರದಿಂದ ನೋಡ್ರಿ, ಕಿವಿಗೊಟ್ಟು ಕೇಳ್ರಿ. ಕಣ ಕಣದಾಗಿನ ಆಶ್ಚರ್ಯವನ್ನು ಸಂಭ್ರಮಿಸಿರಿ","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727644/size7/ffa8aee73935162cd6a249a70158794e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727644/size7/ffa8aee73935162cd6a249a70158794e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-556522","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-556522","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":543,"opdsId":"urn:uuid:SW-125061","title":"ಇಂಟರ್ನೆಟ್‌ನಲ್ಲಿ ಕಳೆದು ಹೋದಾಗ","authors":["N. A. M. Ismail"],"language":"IP","readingLevel":"","publisher":"","summary":"ಇಂಟರ್ ನೆಟ್ ನಲ್ಲಿ ಕಳೆದು ಹೋದ ಕುನಾಲ್‌ ಗೆ ಅದರಿಂದ ಹೊರ ಬರುವುದು ಹೇಗೆ ಎಂದು ತಿಳಿಯುತ್ತಿಲ್ಲ. ಕುನಾಲ್ ಇಂಟರ್ ನೆಟ್ ಮೂಲಕ ತನ್ನ ಮನೆಯ ಹಾದಿ ಕಂಡುಕೊಂಡಿದ್ದು ಹೇಗೆ ಎಂದು ತಿಳಿಯೋಣ ಬನ್ನಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/181775/size7/f1f3e98219874cda59f16f00331eea98.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/181775/size7/f1f3e98219874cda59f16f00331eea98.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-125061","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-125061","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":544,"opdsId":"urn:uuid:SW-577209","title":"ಭಾವನೆಗಳು ಬಂದು ಹೋಗುತ್ತವೆ","authors":["Bhat Ananthesha"],"language":"","readingLevel":"Level 2","publisher":"","summary":"ನೀವು ಅನುಭವಿಸುವ ಭಾವನೆಗಳನ್ನು ಮತ್ತು ಏಕೆ ಎಂದು ನೋಡಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/231859/size7/bdb9d057c77432781e3e911d92aa1bfe.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/231859/size7/bdb9d057c77432781e3e911d92aa1bfe.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-577209","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-577209","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":545,"opdsId":"urn:uuid:SW-32361","title":"ಮುಖಿಲಾಳ ಮೊದಲ ರಕ್ತ ಪರೀಕ್ಷೆ","authors":["Girish N. R."],"language":"","readingLevel":"","publisher":"","summary":"ಮುಖಿಲಾಗೆ ಜ್ವರ ಬಂದಾಗ ಅವಳ ಅಮ್ಮ ಅವಳನ್ನು ಆಸ್ಪತ್ರೆಗೆ ಕರೆದುಕೊಂಡು ಹೋಗುತ್ತಾಳೆ. ಮುಖಿಲಾ ಈಗ ತನ್ನ ಮೊಟ್ಟ ಮೊದಲ ರಕ್ತ ಪರೀಕ್ಷೆಗೆ ಹೋಗುತ್ತಿದ್ದಾಳೆ, ನೀವೂ ಅವಳ ಜೊತೆ ಇರುತ್ತೀರಲ್ವ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/724151/size7/d0c6a34c2ae1e41832c171b1ca3e427f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/724151/size7/d0c6a34c2ae1e41832c171b1ca3e427f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-32361","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-32361","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":546,"opdsId":"urn:uuid:SW-456946","title":"ಅಮ್ಮುವಿನ ನಾಯಿ ಮರಿ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಅಮ್ಮು ತನ್ನ ಶಾಲೆಯಲ್ಲಿ ಎಲ್ಲರಿಗೂ ಅವಳ ಮನೆಯಲ್ಲಿ ನಾಯಿ ಮರಿ ಇದೆ, ಅದು ಚೆಂಡಿನ ಆಟ ಆಡುತ್ತದೆ, ಅದಕ್ಕೆ ಬಾಳೆಹಣ್ಣು ತುಂಬಾ ಇಷ್ಟ ಅಂತೆಲ್ಲ ಹೇಳಿಬಿಟ್ಟಿದ್ದಾಳೆ. ಸ್ನೇಹಿತರೆಲ್ಲ ನಾಯಿ ಮರಿ ಶಂಕರ್‌ನನ್ನು ನೋಡಲು ಬರುತ್ತೇವೆ ಎನ್ನುತ್ತಿದ್ದಾರೆ. ಆದರೆ, ಮನೆಯಲ್ಲಿ ನಾಯಿ ಮರಿ ಇಲ್ಲ. ಅಮ್ಮು ಈಗ ಏನು ಮಾಡುತ್ತಾಳೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/696665/size7/5c7d534c8828504a66ff3855ce3b80ab.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/696665/size7/5c7d534c8828504a66ff3855ce3b80ab.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-456946","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-456946","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":547,"opdsId":"urn:uuid:SW-26230","title":"ದೀಪಾ ಕರ್ಮಾಕರ್ - ಹಗ್ಗದ ಮೇಲಿನ ನಡಿಗೆ","authors":["soma shekar"],"language":"","readingLevel":"","publisher":"","summary":"2016ರ ರಿಯೋ ಒಲಂಪಿಕ್ಸ್​ನಲ್ಲಿ ಭಾಗವಹಿಸಿ, ನಾಲ್ಕನೇ ಸ್ಥಾನ ಪಡೆದ ಭಾರತದ ಮೊದಲ ಮಹಿಳಾ ಜಿಮ್ನಾಸ್ಟ್ ದೀಪಾ ಕರ್ಮಾಕರ್. ತ್ರಿಪುರಾದಲ್ಲಿ ಬೆಳೆದ ದೀಪಾ ಐದನೇ ವಯಸ್ಸಿನಿಂದಲೇ ಜಿಮ್ನಾಸ್ಟಿಕ್ಸ್ ಅಭ್ಯಾಸ ಆರಂಭಿಸಿದಳು. ಅರ್ಗತಲಾದಿಂದ ರಿಯೋವರೆಗಿನ ಈಕೆಯ ಪಯಣವನ್ನು ನೀವೂ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/179748/size7/c76e52ff448184126696ea3475f7f43b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/179748/size7/c76e52ff448184126696ea3475f7f43b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-26230","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-26230","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":548,"opdsId":"urn:uuid:SW-219992","title":"ಆನೆಮರಿ ನೀರು ಕುಡಿಯುವುದನ್ನು ಕಲಿಯಿತು","authors":["Shabana Begum"],"language":"","readingLevel":"","publisher":"","summary":"ಆನೆ ಮರಿ ನೀರು ಕುಡಿಯಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ. ಅದು ನೀರು ಕುಡಿಯಲು ಹೇಗೆ ಪ್ರಯತ್ನಪಟ್ಟಿತು. ಎಂದು ಕಥೆಯಲ್ಲಿ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283163/size7/37a6f82e0194f64250d9d781c5ca07eb.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283163/size7/37a6f82e0194f64250d9d781c5ca07eb.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-219992","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-219992","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":549,"opdsId":"urn:uuid:SW-113937","title":"ಜುಳು ಜುಳು ನೀರು…","authors":["Hema Hebbagodi"],"language":"","readingLevel":"","publisher":"","summary":"ವರ್ಷ ಮತ್ತು ಅವಳ ಅಪ್ಪ ಕಾಡಿನ ಹತ್ತಿರ ವಾಸಿಸುತ್ತಿದ್ದರು. ಸುಡುಬೇಸಿಗೆಯ ಧಗೆಯನ್ನು ಸಹಿಸಲು ವರ್ಷ ಕಷ್ಟಪಡುತ್ತಿದ್ದಳು. ಒಂದು ದಿನ ಅವಳಿಗೆ ವಿಚಿತ್ರ ಸದ್ದು ಕೇಳಿಸಿತು. ಅದೇನು ಸದ್ದು ಎಂದು ಹುಡುಕಿ ಹೊರಟಳು. ಅವಳಿಗೆ ಸದ್ದು ಮಾತ್ರ ಕೇಳುತ್ತಿತ್ತು. ಯಾವುದರ ಸದ್ದಿರಬಹುದು ಅವಳಿಗೆ ಕುತೂಹಲ ಹುಟ್ಟಿತು. ವರ್ಷ ಏನನ್ನು ಕಂಡುಹಿಡಿದಳು ಮತ್ತು ಅಪ್ಪ ಅದನ್ನು ನಂಬಿದರೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721325/size7/07c19bca39403c868921d7fe61cc44d2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721325/size7/07c19bca39403c868921d7fe61cc44d2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-113937","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-113937","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":550,"opdsId":"urn:uuid:SW-11618","title":"ಕಣ್ಣಾಮುಚ್ಚಾಲೆ","authors":["Asha Yogendra"],"language":"","readingLevel":"","publisher":"","summary":"ಸಾನಿಯಾಳ ಹುಟ್ಟುಹಬ್ಬದ ದಿನ ಆರಂಭವಾದ ಸರಳ ಆಟ ‘ಕಣ್ಣಾಮುಚ್ಚಾಲೆ’ಯಲ್ಲಿ ದುಂಬಿಗಳು, ಬೆಕ್ಕುಗಳು ಹಾಗು ನಾಯಿಗಳು ಸೇರ್ಪಡೆಗೊಳ್ಳಲು ನಿಶ್ಚಯಿಸಿದ್ದ ಪರಿಣಾಮವಾಗಿ ಆಟವು ಒಂದು ಕುತೂಹಲಕಾರಿ ಹುಡುಕಾಟವಾಗಿ ಮಾರ್ಪಟ್ಟಿತು. ಆಟದಲ್ಲಿ ಸಾನಿಯಾ ತನ್ನ ಗೆಳೆಯ, ಗೆಳತಿಯರನ್ನು ಹುಡುಕಿದಳೆ? ಹುಟ್ಟುಹಬ್ಬದ ಹುಡುಗಿಯ ಜೊತೆಗೆ ನೀವೂ ಎಣಿಸಲು ಆರಂಭಿಸಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/713555/size7/f35c9e0ae7b19a3cefc15f016bf28ec6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/713555/size7/f35c9e0ae7b19a3cefc15f016bf28ec6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-11618","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-11618","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":551,"opdsId":"urn:uuid:SW-126489","title":"ಪ್ರಿನ್ಸೆಸ್ ರಸ್ತೆಯ ಆರ್ಟ್ ಗ್ಯಾಲರಿ","authors":["Utthaana Bharighat"],"language":"","readingLevel":"","publisher":"","summary":"ಭಾರತೀಯ ಆಧುನಿಕ ಕಲೆಯನ್ನು ಹೊರಗಿನ ಪ್ರಪಂಚಕ್ಕೆ ಕೊಂಡೊಯ್ದು ಅದಕ್ಕೊಂದು ಖ್ಯಾತಿ ತಂದುಕೊಟ್ಟವರು ಕೇಕೂ ಹಾಗೂ ಖೊರ್ಷೇದ್ ಗಾಂಧಿ ದಂಪತಿ. ಬಾಂಬೆಯಲ್ಲಿ ಅವರು ಸ್ಥಾಪಿಸಿದ ಕೆಮೋಲ್ಡ್ ಆರ್ಟ್ ಗ್ಯಾಲರಿ ಭಾರತದ ಕಲಾವಿದರಿಗೆ ಸ್ವಂತ ಮನೆಯೆ ಆಗಿ ಬಿಟ್ಟಿತ್ತು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723771/size7/475cc54a1ace4505cff93c42ec3d05df.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723771/size7/475cc54a1ace4505cff93c42ec3d05df.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-126489","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-126489","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":552,"opdsId":"urn:uuid:SW-12852","title":"ರಾಜಹಂಸಗಳ ನೃತ್ಯ","authors":["Raghunatha Cha. Ha."],"language":"","readingLevel":"","publisher":"","summary":"ನೀರಿನಲ್ಲಿನ ಕಮಲದ ಹೂವುಗಳಂತೆ ಇರುವ ಗುಲಾಬಿ ಬಣ್ಣದ ರಾಜಹಂಸಗಳನ್ನು ನೋಡುವುದು ಪ್ರಕೃತಿಯ ಅತ್ಯಂತ ಸುಂದರ ದೃಶ್ಯಗಳಲ್ಲಿ ಒಂದು. ಅಂದಹಾಗೆ, ಅವುಗಳು ಗುಲಾಬಿ ಬಣ್ಣ ಆಗಿರುವುದು ಏಕೆ? ಅವುಗಳು ತಮ್ಮನ್ನು ತಾವು ಸಿಂಗಾರ ಮಾಡಿಕೊಳ್ಳುತ್ತವೆಯೇ? ಅವುಗಳ ಉದ್ದ ಕತ್ತಿನಲ್ಲಿ ಒಂದಾದರೂ ಮೂಳೆ ಇದೆಯೇ? ರಾಜಹಂಸಗಳ ಕುರಿತ ಎಲ್ಲ ಪ್ರಶ್ನೆಗಳಿಗೆ ಈ ಸಚಿತ್ರ ಪುಸ್ತಕದಲ್ಲಿ ಉತ್ತರಗಳಿವೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/35241/size7/754e9eccdfecc87ccbcee58026ff636e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/35241/size7/754e9eccdfecc87ccbcee58026ff636e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12852","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12852","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":553,"opdsId":"urn:uuid:SW-141593","title":"ಇದು ಸರಿ ಕ್ರಮ ಶಾಲೆ","authors":["Dhwani Trust"],"language":"","readingLevel":"","publisher":"","summary":"‘ಸರಿ ಕ್ರಮ’ ಶಾಲೆಯಲ್ಲಿ ಎಲ್ಲವನ್ನೂ ‘ಸರಿಯಾದ ರೀತಿ’ಯಲ್ಲಿಯೇ ಮಾಡಬೇಕು. ಶಿಕ್ಷಕಿ ಶ್ರೀಮತಿ ಗಂಭೀರ್ ಅವರು ಕೂಡ ಹಾಗೆಯೇ ಕಲಿಸುವುದು. ತಲೆ ಬಾಚಿಲ್ಲದ, ಎಲ್ಲೆ ಇಲ್ಲದ ಕುತೂಹಲವುಳ್ಳ ಬಾಲೆಯೊಬ್ಬಳು ಒಂದು ದಿನ ಆ ಶಾಲೆಗೆ ಸೇರಿಕೊಳ್ಳುತ್ತಾಳೆ. ತನ್ನ ಪ್ರಶ್ನೆಗಳು, ಉಲ್ಲಾಸದ ದನಿ ಮತ್ತು ನಡವಳಿಕೆಗಳಿಂದ ತಬ್ಬಿಬ್ಬು ಮಾಡುತ್ತಾಳೆ. ಮುಂದೇನಾಗುವುದು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/188969/size7/3bacc5d88dc24dcb3711be73fb8f289a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/188969/size7/3bacc5d88dc24dcb3711be73fb8f289a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-141593","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-141593","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":554,"opdsId":"urn:uuid:SW-96263","title":"ಮಜಾ ಗಣಿತ: ಆಕಾರ ಮತ್ತು ದತ್ತಾಂಶಗಳು","authors":["K.P. Bhatt"],"language":"","readingLevel":"","publisher":"","summary":"ಇದೊಂದು ಹೊಸ ಬಗೆಯ ಗಣಿತ ಪುಸ್ತಕ. ಇದರಲ್ಲಿ ಸಮಸ್ಯೆಗಳಿಗಿಂತ ಕತೆಗಳೇ ಹೆಚ್ಚಾಗಿವೆ! ಕಥೆಗಳನ್ನು ಓದಿ, ಕಲ್ಪನೆ, ಮತ್ತು ವಾಸ್ತವಗಳ ಮಿಶ್ರಣವನ್ನು ಸ್ವೀಕರಿಸಿ ಜೊತೆಗೆ ನಿಮ್ಮ ಮೆದುಳಿಗೊಂದು ಸವಾಲು ಹಾಕಿ ಸಂತೋಷಪಡಿಸಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703148/size7/86d3cc20d04c72df67bf90ec26c9e00f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703148/size7/86d3cc20d04c72df67bf90ec26c9e00f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-96263","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-96263","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":555,"opdsId":"urn:uuid:SW-92879","title":"ಶ್! ಏನದು?","authors":["Tanuja Jakkannavar"],"language":"","readingLevel":"","publisher":"","summary":"ತಾರಾ ಮತ್ತು ದಿಯಾ ಇನ್ನೇನು ಮಲಗಲು ಹೋಗಬೇಕು. ಆಗ ಅವರಿಗೆ ಗೋಡೆ ಮೇಲೆ ಏನೋ ಕಂಡಿತು. ನೋಡಿದರೆ ಅದೊಂದು ದೆವ್ವ! ಭಾರೀ ಗಾತ್ರದ ಆ ದೆವ್ವವನ್ನು ಈ ಪುಟ್ಟ ಹುಡುಗಿಯರು ಓಡಿಸುವರೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715252/size7/e4df70a19ad5fea1828cbe12d80f4b60.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715252/size7/e4df70a19ad5fea1828cbe12d80f4b60.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-92879","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-92879","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":556,"opdsId":"urn:uuid:SW-63557","title":"ಬಿಸಿಲ ಬೆಕ್ಕು ಶುಂಠಿ","authors":["Hema Hebbagodi"],"language":"","readingLevel":"","publisher":"","summary":"ಶುಂಠಿ ಬೆಕ್ಕಿಗೆ ಬಿಸಿಲೆಂದರೆ ಪಂಚಪ್ರಾಣ. ಅಜ್ಜನಿಗೂ ಬಿಸಿಲೆಂದರೆ ಅದೇನೋ ಇಷ್ಟ! ಈ ಸೂರ್ಯನಲ್ಲಿ ಅಂತಹ ವಿಶೇಷತೆ ಏನಿದೆ? ಬನ್ನಿ ನೋಡೋಣ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715519/size7/2247ababfc686d876f65073da146fafa.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715519/size7/2247ababfc686d876f65073da146fafa.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-63557","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-63557","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":557,"opdsId":"urn:uuid:SW-622503","title":"ನಾಣಮ್ಮಾಳ್ ಮತ್ತು ಕಮಲಾತ್ತಾಳ್‌ - ವಾಯು ಯಾನ!","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ನಾಣಮ್ಮಾಳ್ ಮತ್ತು ಕಮಲಾತ್ತಾಳ್‌ಗೆ ಪ್ರವಾಸಕ್ಕೆ ಹೋಗುವುದೆಂದರೆ ಇಷ್ಟ. ಅವರು ಈಗಾಗಲೇ, ಕಮಲಾತ್ತಾಳ್ ಹುಟ್ಟುಹಬ್ಬ ಆಚರಿಸಲು ಮನಾಲಿಗೆ ಹೊರಟಿದ್ದಾರೆ. ಆದರೆ, ಕಮಲಾತ್ತಾಳ್‌ಗೆ ಬಿಸಿ-ಗಾಳಿ ಬಲೂನನ್ನು ಹಾರಿಸಲು ಸಾಧ್ಯವಾಗತ್ತಾ? ಗೆಳತಿಯರಿಬ್ಬರ ವಾಯು ಯಾನದ ಸಾಹಸ ನೋಡೋಣ ಬನ್ನಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/459583/size7/d18d3d12299cad74de8e3d96f5debae4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/459583/size7/d18d3d12299cad74de8e3d96f5debae4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-622503","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-622503","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":558,"opdsId":"urn:uuid:SW-3681","title":"ಹಲ್ಲುಜ್ಜುವ ಪೇಸ್ಟ್ ಟ್ಯೂಬ್ ನ ಒಳಗೆ ಸೇರಿದ್ದು ಹೇಗೆ?","authors":["Madhumitha Hebbar"],"language":"","readingLevel":"","publisher":"","summary":"ಪ್ರತಿ ದಿನ ಬೆಳಿಗ್ಗೆ ಟ್ಯೂಬ್ ನಿಂದ ಹಲ್ಲುಜ್ಜುವ ಪೇಸ್ಟ್ ಕಿವುಚಿ ಹೊರ ತೆಗೆಯುವುದು ಸುಲಭ. ಆದರೆ ಮೊಟ್ಟ ಮೊದಲಿಗೆ ಅದು ಟ್ಯೂಬ್ ನ ಒಳಗೆ ಸೇರಿದ್ದು ಹೇಗೆ ಗೊತ್ತ? ಈ ಪುಸ್ತಕ ಓದಿ ತಿಳಿಯೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/711270/size7/a842e8651f5514894aa0750d1ef205aa.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/711270/size7/a842e8651f5514894aa0750d1ef205aa.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-3681","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-3681","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":559,"opdsId":"urn:uuid:SW-89281","title":"ಬೆಳದಿಂಗಳಲ್ಲಿ ಚುಕ್ಕಿಯಾಟ","authors":["Srinidhi  TG"],"language":"","readingLevel":"","publisher":"","summary":"ನೈನಾ ಮತ್ತು ಮಾಧವ್ ತಮ್ಮ ಜಗಳವನ್ನು ಅಂತರಿಕ್ಷದಲ್ಲಿ ಬಗೆಹರಿಸಿಕೊಳ್ಳಲು ತೀರ್ಮಾನಿಸುತ್ತಾರೆ. ಸದಾ ತಿನ್ನುತ್ತಲೇ ಇರುವ ಕೊಂಬಿನ ಕುದುರೆಯಿಂದ ಪ್ರಾರಂಭಿಸಿ ಅಳುತ್ತಲೇ ಇರುವ ಡ್ರಾಗನ್‌ವರೆಗೆ ಅವರು ಅಲ್ಲಿ ಅನೇಕ ವಿಚಿತ್ರ ಜೀವಿಗಳನ್ನು ನೋಡುತ್ತಾರೆ. ಆದರೆ ಈ ಹೊಳೆವ ಜೀವಿಗಳೆಲ್ಲ ಯಾರು? ಅಂತರಿಕ್ಷದಲ್ಲಿನ ಸಾಹಸದ ಈ ಕತೆ ರಾತ್ರಿಯ ಆಕಾಶದ ನಕ್ಷತ್ರಪುಂಜಗಳನ್ನು ಪರಿಚಯಿಸುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715246/size7/9836f4784ff49053c387040a01426ad6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715246/size7/9836f4784ff49053c387040a01426ad6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-89281","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-89281","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":560,"opdsId":"urn:uuid:SW-44727","title":"ಇವತ್ತು ನಾನು","authors":["Rajeshwari  Karur"],"language":"","readingLevel":"","publisher":"","summary":"ಮೇಘಾ ಇವತ್ತು ಏನಾಗಬಹುದು? ಶೋಧಕಿ, ಗಗನಯಾತ್ರಿ? ಕಲಾವಿದೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/524542/size7/c273da52c55bd7e5d79cd98401ab3ab2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524542/size7/c273da52c55bd7e5d79cd98401ab3ab2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-44727","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-44727","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":561,"opdsId":"urn:uuid:SW-214528","title":"ಬಲೂನ್ ಮಾರುವವನು","authors":["Nataraja J"],"language":"","readingLevel":"","publisher":"","summary":"ಚಿಕು ಬಲೂನ್ ತೆಗೆದುಕೊಂಡಳು ಮತ್ತು ಅವಳ  ಗೆಳೆಯರನ್ನೂ ಕೂಗಿದಳು. ಆದರೆ ಅವಳ ಗೆಳೆಯರು ಬಲೂನ್ ಖರೀದಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ ಏಕೆಂದರೆ…","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283788/size7/b5f465a5feaef361a1e4f8086ade0bd8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283788/size7/b5f465a5feaef361a1e4f8086ade0bd8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-214528","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-214528","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":562,"opdsId":"urn:uuid:SW-132148","title":"ತಿಳಿ ಗಾಳಿಯ ಬಲಾಬಲ","authors":["Kshama V. Bhanuprakash"],"language":"","readingLevel":"","publisher":"","summary":"ರೆಕ್ಕೆಗಳು, ಗಾಳಿಪಟಗಳು ಮತ್ತು ಹವಾಯಂತ್ರಗಳಲ್ಲಿ ಸಮಾನವಾಗಿರುವುದು ಏನು? ಇವುಗಳಲ್ಲಿ ಪ್ರತಿಯೊಂದೂ ಗಾಳಿಯ ನೆರವಿನಿಂದ ಚಲಿಸುತ್ತವೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/180153/size7/36c83df1c3a7270a1c44747a7358c3ff.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/180153/size7/36c83df1c3a7270a1c44747a7358c3ff.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-132148","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-132148","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":563,"opdsId":"urn:uuid:SW-365","title":"ಅಪ್ಪ ಬಂದ","authors":["Sujatha Rajanna"],"language":"","readingLevel":"","publisher":"","summary":"ಪಲ್ಲವರ ಆಡಳಿತ ಕಾಲದಲ್ಲಿ ಬಸವ ಮತ್ತು ಅವನ ಸೋದರಿ ಸುಂದರಿ ಬಂದರು ಪಟ್ಟಣವಾದ ಮಾಮಲ್ಲಪುರದಲ್ಲಿ ವಾಸಿಸುತ್ತಿರುತ್ತಾರೆ. ಅವರ ಅಪ್ಪ ನಾವಿಕ ಹಡಗಿನಲ್ಲಿ ಕಾಂಬೋಜಕ್ಕೆ ತೆರಳಿದವನು ವಾಪಾಸ್ಸು ಬಂದಿರುವುದಿಲ್ಲ. ಮಕ್ಕಳಿಗೆ ಅದರಿಂದ ಆತಂಕವಾಗುತ್ತದೆ. ಅವರು ವಿಚಾರವೇನೆಂದು ಅರಿಯಲು ಬಂದರಿಗೆ ಹೋದಾಗ ವಿದೇಶೀ ನಾವಿಕರಿಗೆ ತಮ್ಮ ಭಾಷೆ ಲವಲೇಶವೂ ಅರ್ಥವಾಗುವುದಿಲ್ಲ ಎಂಬುದು ತಿಳಿಯುತ್ತದೆ. ಹಾಗಾದರೆ ಅವರೀಗ ಏನು ಮಾಡಲು ಸಾಧ್ಯ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703512/size7/faeccb52ca9fc7dce7067448e6e8eb61.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703512/size7/faeccb52ca9fc7dce7067448e6e8eb61.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-365","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-365","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":564,"opdsId":"urn:uuid:SW-61895","title":"ರಾಕಿ, ಕೆಳಗಿಳಿ!","authors":["Sarita Sharan"],"language":"","readingLevel":"","publisher":"","summary":"ಮೇಕೆ ರಾಕಿ ಚರ್ಚಿನ ಮಾಳಿಗೆ ಹತ್ತಿ ಬಿಟ್ಟಿದೆ. ಅದನ್ನು ಕೆಳಗೆ ಇಳಿಸಲು ರೋಸ್ ಮತ್ತು ಅಕ್ಕಪಕ್ಕದವರು ಹರಸಾಹಸ ಮಾಡುತ್ತಿದ್ದಾರೆ. ಅವರೆಲ್ಲರ ಪ್ರಯತ್ನದಿಂದ ರಾಕಿ ಕೆಳಗಿಳಿಯಿತೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715409/size7/357ef96463dde52d13f40e061e9e5bd2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715409/size7/357ef96463dde52d13f40e061e9e5bd2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-61895","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-61895","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":565,"opdsId":"urn:uuid:SW-93492","title":"ಚೂಚೂ ಮಾಂತುವಿನ ಮಿಠಾಯಿ ಜಾಡಿ","authors":["Mandara Sagara"],"language":"","readingLevel":"","publisher":"","summary":"ಪ್ರೀತ್ ಗೆ ಗೊತ್ತಿರುವಂತೆ ಚೂಚೂ ಮಾಂತುವನ್ನು ಇಷ್ಟಪಡದವರೇ ಇಲ್ಲ. ಅವರ ಸಾವಿನ ನಂತರ, ಪ್ರೀತ್ ಗೆ ಅವರೊಂದಿಗೆ ಅವರ ದಯೆಯೂ ಮಾಯವಾಯಿತೇನೋ ಎನಿಸುತ್ತದೆ. ನೈಜ ಘಟನೆ ಆಧರಿಸಿದ ಈ ಕತೆಯಲ್ಲಿ ಆತ್ಮೀಯರ ಕಳೆದುಕೊಳ್ಳುವಿಕೆ ಮತ್ತು ದುಃಖ ಹಾಗೂ ನಿತ್ಯದ ಚಟುವಟಿಕೆಗಳಲ್ಲಿ ದಯೆಯ ಪಾತ್ರ ಕುರಿತು ಹೇಳಲಾಗಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/626163/size7/005493b833ecfdd4e4d5d8fcb4b69545.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/626163/size7/005493b833ecfdd4e4d5d8fcb4b69545.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-93492","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-93492","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":566,"opdsId":"urn:uuid:SW-39013","title":"ಪಾಸ್‌ವರ್ಡ್ ಕೊಡು ಸ್ವಲ್ಪ!","authors":["Utthaana Bharighat"],"language":"","readingLevel":"","publisher":"","summary":"ಮಂಜುವಿಗೆ ಅಕ್ಕ ರಿಜುನ ಮೊಬೈಲ್‌ನಲ್ಲಿ ಗೇಮ್‌ ಆಡಲು ಆಸೆ. ಆದರೆ, ರಿಜು ಮೊಬೈಲ್ ಗೆ ಪಾಸ್ ವರ್ಡ್ ಹಾಕಿ ಬಿಟ್ಟಿದ್ದಾಳೆ. ಪಾಸ್‌ವರ್ಡ್ ಎಂದರೇನು ಎಂಬುದನ್ನು ಓದಲು ಬಲ್ಲ ಮಕ್ಕಳಿಗೆ ಅರ್ಥವಾಗುವ ಬಗೆಯಲ್ಲಿ ಸರಳವಾಗಿ ವಿವರಿಸುವ ಪುಸ್ತಕ ಇದಾಗಿದೆ. ತಡ ಮಾಡದೆ ಪುಸ್ತಕದ ಪುಟಗಳನ್ನು ತೆರೆದು ಓದಿ ನೋಡಿ. ಪುಸ್ತಕ ತೆರೆಯಲಂತೂ ಪಾಸ್‌ವರ್ಡ್‌ ಬೇಕಿಲ್ಲ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725415/size7/535de83b4fa2d0a1a0b5327e87724891.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725415/size7/535de83b4fa2d0a1a0b5327e87724891.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-39013","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-39013","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":567,"opdsId":"urn:uuid:SW-25766","title":"ಚೀನಾ ಟೌನ್ ನಲ್ಲಿ ಜೇನೀಸ್","authors":["Shashi Sampalli"],"language":"","readingLevel":"","publisher":"","summary":"ಜೇನೀಸ್ ತನ್ನ ಅಜ್ಜಿಯೊಂದಿಗೆ ಕೋಲ್ಕತ್ತಾದ ಚೀನಾ ಟೌನ್ ಗೆ ಹೋಗಿದ್ದಳು. ಆ ಬಜಾರಿನಲ್ಲಿ ಆಕೆ ಏನೆಲ್ಲಾ ನೋಡಿದಳು ಗೊತ್ತಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117364/size7/f869de03a5e7e66d3b65f3e3ba6faaf1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117364/size7/f869de03a5e7e66d3b65f3e3ba6faaf1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-25766","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-25766","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":568,"opdsId":"urn:uuid:SW-94593","title":"ಲೈಟ್ಸ್... ಕ್ಯಾಮೆರಾ... ಆಕ್ಷನ್! ದಾದಾಸಾಹೇಬ್ ಫಾಲ್ಕೆ ಜೀವನ ಗಾಥೆ","authors":["Brinda N Rao"],"language":"","readingLevel":"","publisher":"","summary":"“ಈ ಜಾದೂ ಛಾಯಾಚಿತ್ರಗಳಲ್ಲಿ ಜನ ಓಡಾಡುವುದನ್ನು ನೋಡಿ! ಎರಡು ಮೈಲಿ ಉದ್ದದ ಚಿತ್ರ. ಕೇವಲ ಮೂರೇ ಅಣೆ!” ದಾದಾಸಾಹೇಬ್ ಫಾಲ್ಕೆ ಎಂಬ ಜಾದೂಗಾರ ತಮ್ಮ ಮೊಟ್ಟಮೊದಲ ಚಿತ್ರವನ್ನು ವೀಕ್ಷಿಸುವಂತೆ ಜನರನ್ನು ಆಹ್ವಾನಿಸಿದ ರೀತಿ ಇದು. ಈ ಪ್ರತಿಭಾವಂತ ವ್ಯಕ್ತಿಯ ಜೀವನ ಕುರಿತ ಈ ಅದ್ಭುತ ಕಥೆಯ ಇತರ ಪಾತ್ರಧಾರಿಗಳು: ಸ್ತ್ರೀ ಪಾತ್ರ ಧರಿಸಿದ ಒಬ್ಬ ಅಡುಗೆಯವ ಹಾಗೂ ಭಾರತೀಯ ಚಲನಚಿತ್ರ ರಂಗದ ಮೊದಲ ಸಂಕಲನಗಾರ್ತಿ ಎಂಬ ಹೆಗ್ಗಳಿಕೆಗೆ ಪಾತ್ರರಾದ ಒಬ್ಬ ಮಹಿಳೆ - ಅವರ ಪತ್ನಿ! ಸೂಪರ್‍ ಹಿಟ್ ಚಲನಚಿತ್ರಗಳ ಪ್ರಿಯರು ನೀವಾಗಿದ್ದರೆ ದಾದಾಸಾಹೇಬ್ ಅವರ ಜೀವನ ಮತ್ತು ಮೊದಲ ಭಾರತೀಯ ಚಲನಚಿತ್ರದ ಬಗ್ಗೆ ಪರಿಚಯ ನೀಡುವ ಈ ಚಿತ್ರಕಥೆ ನಿಮ್ಮನ್ನು ವಿಸ್ಮಯಗೊಳಿಸುತ್ತದೆ. ಪ್ರೇಕ್ಷಕರ ಮನಸೂರೆಗೊಳಿಸುವ ಎಲ್ಲ ಅಂಶಗಳೂ ಇದರಲ್ಲಿ ಅಡಕವಾಗಿವೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722820/size7/b8a0190e1354e48844cd78473db9710c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722820/size7/b8a0190e1354e48844cd78473db9710c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-94593","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-94593","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":569,"opdsId":"urn:uuid:SW-136409","title":"ಹೌಜ್ ಖಾಸ್ - ಸರೋವರದ ಬದಿಯ ಶಾಲೆ","authors":["Girish Jakapure"],"language":"","readingLevel":"","publisher":"","summary":"ರಹಸ್ಯದಾರಿಯ ಮೂಲಕ ಪಯಣಿಸುವುದು ನಿಮಗೂ ಇಷ್ಟ ತಾನೆ?\nಈ ಪುಸ್ತಕ ನಿಮ್ಮನ್ನು ಒಂದು ಸರೋವರ, ಹೂದೋಟ, ಒಂದು ಪುರಾತನ ಶಾಲೆ, ಮಸೀದಿ ಹಾಗೂ ಕೆಲವು ಗುಂಬಜಗಳನ್ನು ತೋರಿಸುತ್ತ ದಿಲ್ಲಿಯ ಹೌಜ್ ಖಾಸ್ ಪರಿಸರಕ್ಕೆ ಕೊಂಡೊಯ್ಯಲಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/185528/size7/71ce8958f4c23ef9e94c96f9df6a6664.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/185528/size7/71ce8958f4c23ef9e94c96f9df6a6664.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-136409","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-136409","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":570,"opdsId":"urn:uuid:SW-432994","title":"ಚುಕ್ಕೆಗಳು","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಚು... ಚು... ಚುಕ್ಕಿಗಳು. ಬಣ್ಣಬಣ್ಣದ, ಕಪ್ಪು-ಬಿಳಿ ಚುಕ್ಕೆಗಳು. ನಾನಾ ಗಾತ್ರದ, ಪ್ರಕಾರಗಳ ಚುಕ್ಕೆಗಳನ್ನು ನೋಡಬೇಕು ಅಲ್ವ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727490/size7/8be559730895e6da8af20826f299c892.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727490/size7/8be559730895e6da8af20826f299c892.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-432994","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-432994","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":571,"opdsId":"urn:uuid:SW-138947","title":"ಪ್ರವಾಸಿ ಹುಳು","authors":["Cp Ravikumar"],"language":"","readingLevel":"","publisher":"","summary":"ಓಹೋ! ಬಿನಿತಾ ಜೀರುಂಡೆಯ ತಲೆಯಲ್ಲಿ ಪ್ರವಾಸದ ಹುಳು ಹೊಕ್ಕಿದೆ! ಅದು ಏನು ಮಾಡಿತು ಅಂತೀರಾ! ಸಾಮಾನು ಕಟ್ಟಿಕೊಂಡು ಸಾಹಸಮಯ ಪ್ರವಾಸಕ್ಕೆ ಹೊರಟೇ ಬಿಟ್ಟಿತು! ವಿವಿಧ ನಾಡುಗಳಿಗೆ ಹೋದಂತೆಲ್ಲಾ ಅದು ಹೊಸ ಅನುಭವಗಳಿಗೆ ಒಡ್ಡಿಕೊಳ್ಳುತ್ತಾ ಬದಲಾಗುತ್ತಾ ಸಾಗಿತು. ಸಂಗೀತ, ಪ್ರವಾಸ ಮತ್ತು ಹೊಸ ಗೆಳೆತನಗಳ ಮಾಂತ್ರಿಕತೆಯನ್ನು ಕಂಡುಕೊಂಡಿತು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/186217/size7/f48f1aee36c884851130acd8dbaf70c6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/186217/size7/f48f1aee36c884851130acd8dbaf70c6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-138947","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-138947","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":572,"opdsId":"urn:uuid:SW-432992","title":"ಅಜ್ಜಿ ಮನೆಯ ತಾರಸಿ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಪ್ರತಿ ರಜೆಗೆ ನಾವು ಹಳ್ಳಿಗೆ, ಅಜ್ಜಿ ಮನೆಗೆ ಹೋಗುತ್ತೇವೆ. ಏಕೆ? ಮುಂಬಯಿ ಮನೆಯಲ್ಲಿ ತಾರಸಿ ಇಲ್ಲ, ಅಜ್ಜಿಯೂ ಇಲ್ಲ, ಅದಕ್ಕೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727427/size7/32d508c5df880c96c70e0c6aa0dcb722.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727427/size7/32d508c5df880c96c70e0c6aa0dcb722.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-432992","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-432992","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":573,"opdsId":"urn:uuid:SW-39011","title":"ಗಾಳಿ ಹೇಗೆ ಇಷ್ಟು ಭಾರ?","authors":["Kollegala Sharma"],"language":"","readingLevel":"","publisher":"","summary":"ಬಲೂನುಗಳೆಂದರೆ ಬಣ್ಣ ಮತ್ತು ಹಗುರ. ಅವು ಹಾರುತ್ತವೆ. ಆದರೆ ಒಳಗೆ ಇರುವ ಗಾಳಿ ಅವಕ್ಕೆ ತೂಕ ಕೊಡುವುದಿಲ್ಲವೇ ಎಂದು ನಿಮಗೆ ಅಚ್ಚರಿ ಆಗಬಹುದು. ಲಕ್ಷ್ಮಿಗೆ ಅಚ್ಚರಿಯಾಗಿದೆ. ಹೀಗಾಗಿ ಅವಳು ಮತ್ತು ಅವಳ ಸಂಗಡಿಗರು ಗಾಳಿಗೇನಾದರೂ ಭಾರವಿದೆಯೇ ಎಂದು ಪರೀಕ್ಷಿಸಲಿದ್ದಾರೆ.\nಅವರು ಏನು ಕಲಿತರು ಅನ್ನುವುದಕ್ಕೆ ಈ ಪುಸ್ತಕದೊಳಗೆ ಒಮ್ಮೆ ಇಣುಕಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725413/size7/ce76d232acdcbc97d22d67d7ad3defba.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725413/size7/ce76d232acdcbc97d22d67d7ad3defba.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-39011","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-39011","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":574,"opdsId":"urn:uuid:SW-50465","title":"ರಿಪೇರಿ ಮೇಳಕ್ಕೆ ಬನ್ನಿ","authors":["Ravikiran"],"language":"","readingLevel":"","publisher":"","summary":"ಮುಂಜಾನೆಯಿಂದ ಕೆಲಸ ಮಾಡಲು ಮುಟ್ಟಿದ ವಸ್ತುಗಳೆಲ್ಲ ಕೈ ಕೊಡುತ್ತಿವೆ ಶ್ಯಾಮನಿಗೆ. ಆಗ ಮನೆಗೆ ಬರುವ ಶಿರೀಷ ಅವನನ್ನು ರಿಪೇರಿ ಮೇಳಕ್ಕೆ ಕರೆದುಕೊಂಡು ಹೋಗುತ್ತಾಳೆ. ಅಲ್ಲಿ ಎಲ್ಲ ವಸ್ತುಗಳನ್ನೂ ನೀವೇ ರಿಪೇರಿ ಮಾಡಬಹುದಂತೆ! ಹೇಗೆಂದು ನೋಡೋಣವಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717377/size7/de7ac270e794445be00068049e544ed0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717377/size7/de7ac270e794445be00068049e544ed0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-50465","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-50465","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":575,"opdsId":"urn:uuid:SW-24739","title":"ಇಯಾದನ ಪಾರಿವಾಳಗಳು","authors":["Subhashini  M.L."],"language":"","readingLevel":"","publisher":"","summary":"ಇಯಾದ್ ಪಾರಿವಾಳಗಳನ್ನು ಪ್ರೀತಿಸುತ್ತಾನೆ. ದಿನ ಬೆಳಗ್ಗೆ ಅವುಗಳ ಕೂ…ಕೇಳುವುದು, ನಾನಾ ಬಣ್ಣದ ಪಾರಿವಾಳಗಳನ್ನು ನೋಡುವುದು ಎಂದರೆ ಅವನಿಗೆಷ್ಟ. ಇಯಾದ್ ಮತ್ತು ಆತನ ತಾತನೊಂದಿಗೆ ಪಾರಿವಾಳಗಳ ಬಗ್ಗೆ ನೀವೂ ತಿಳಿದುಕೊಳ್ಳಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/116778/size7/f79bebed85ed9760a61d8ef498f4ed71.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/116778/size7/f79bebed85ed9760a61d8ef498f4ed71.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-24739","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-24739","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":576,"opdsId":"urn:uuid:SW-462598","title":"ಗೋಲಾ ಗೋಲಾ","authors":["Gananath S N"],"language":"","readingLevel":"","publisher":"","summary":"ಜಾತ್ರೆಯಲ್ಲಿ ಎಲ್ಲರಿಗೂ ಬೇರೆ ಬೇರೆ ಬಣ್ಣದ ಗೋಲಾಗಳೇ ಬೇಕಾಗಿದೆ! ಮಾರಿಯೊಗೆ ಪ್ರತಿಯೊಬ್ಬರ ಆಯ್ಕೆಯನ್ನೂ ನೆನಪಿಡಲು ಸುಲಭ ವಿಧಾನ ಯಾವುದು? ಇದು ವೆನ್‌ ಚಿತ್ರಗಳನ್ನು ಪರಿಚಯಿಸುವ ಕತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727386/size7/4ef251bd361e98a2383d82fc2c944bdd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727386/size7/4ef251bd361e98a2383d82fc2c944bdd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-462598","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-462598","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":577,"opdsId":"urn:uuid:SW-56927","title":"ಯಾರ ಹೆಜ್ಜೆ ಗುರುತಿದು?","authors":["Kalgundi  Naveen"],"language":"","readingLevel":"","publisher":"","summary":"ಇವು ಯಾರ ಹೆಜ್ಜೆ ಗುರುತುಗಳು? ಯಾರು ಬಿಟ್ಟು ಹೋದ ಜಾಡು ಇದು? ಇದು ಎಳೆಯ ಓದುಗರಿಗೆ ಪ್ರಾಣಿಗಳು ಹಾಗೂ ಅವುಗಳ ಜಾಡುಗಳನ್ನು ಪರಿಚಯಿಸುವ ಪುಸ್ತಕ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/714338/size7/79cec9b30eb76917a457653a32a5b3e2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/714338/size7/79cec9b30eb76917a457653a32a5b3e2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-56927","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-56927","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":578,"opdsId":"urn:uuid:SW-57288","title":"ಜಾರು ಬಾಲದ ಪೊಂಗಲ್!","authors":["Kollegala Sharma"],"language":"","readingLevel":"","publisher":"","summary":"ನಮ್ಮ ಹಂದಿಮರಿ ಪೊಂಗಲ್‌ಗೆ ಒಂದು ತೊಂದರೆಯಾಗಿದೆ.  ಪೊಂಗಲ್‌ನ ಬಾಲ ಅದರ ಮಾತು ಕೇಳುವುದೇ ಇಲ್ಲ. ಅಲ್ಲಿ ಇಲ್ಲಿ ಅಂತ ಸಾಹಸಕ್ಕೆ ಹೊರಟು ಬಿಡುತ್ತದೆ. ಅಡ್ಡಾಡಲು ಹೋದ ಬಾಲವನ್ನು ಹುಡುಕಲು ಪೊಂಗಲ್‌ಗೆ ಸಹಾಯ ಮಾಡೋಣವಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/120979/size7/3d623966446a7444473bbd5c84c8ba2e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/120979/size7/3d623966446a7444473bbd5c84c8ba2e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-57288","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-57288","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":579,"opdsId":"urn:uuid:SW-147144","title":"ಮಾನಸ ಕಲೆಹಾಕಿದ ಮಳೆಬಿಲ್ಲು","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಮಾನಸ ಒಂದು ಬೇರೆ ರೀತಿಯ ಮಳೆಬಿಲ್ಲನ್ನು ಹುಡುಕಿ ಹೊರಟಿದ್ದಾಳೆ. \nಅದು ಅವಳಿಗೆ ಸಿಗುತ್ತಾ? ಹುಡುಕಲು ನೀವೂ ಮಾನಸಳ ಜೊತೆಯಾಗಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495523/size7/5b4c1b6586eede14f66e66af9be535ef.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495523/size7/5b4c1b6586eede14f66e66af9be535ef.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-147144","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-147144","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":580,"opdsId":"urn:uuid:SW-86696","title":"ಜಲ ಶೋಧಕ ಆಟ","authors":["LC Nagaraj"],"language":"","readingLevel":"","publisher":"","summary":"ತಾತನ ಜೊತೆಗಿನ ಆಟದಲ್ಲಿ ಗೆಲ್ಲಲು ಲಜ್ಜೊ ಪಟ್ಟಿಯಲ್ಲಿರುವ ಸಾಮಾನುಗಳನ್ನು ಹುಡುಕಿಕೊಳ್ಳಬೇಕಿದೆ. ಕುಡಿಯಲು ಹನಿ ನೀರಿಲ್ಲದ ಪರಿಸ್ಥಿತಿಯಲ್ಲಿ ತಾತ-ಮೊಮ್ಮಗಳ ಈ ಜಲ ಶೋಧಕ ಆಟ ಎಲ್ಲರಲ್ಲೂ ಕುತೂಹಲ ಮೂಡಿಸಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715245/size7/125c121033c3f1d3ae6712079658c840.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715245/size7/125c121033c3f1d3ae6712079658c840.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-86696","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-86696","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":581,"opdsId":"urn:uuid:SW-114849","title":"ರೋಬೋಟ್ ಜೊತೆ ಶರಣ್ಯ ಮಾತು","authors":["Tanuja Jakkannavar"],"language":"","readingLevel":"","publisher":"","summary":"ಶರಣ್ಯಳ ಶಾಲೆಗೆ ಹೊಸದಾಗಿ ಸೇರಿದ ವಿದ್ಯಾರ್ಥಿ, ಅವಳು ಎಷ್ಟೇ ಮಾತನಾಡಿಸಿದರೂ ಮಾತನಾಡುತ್ತಿಲ್ಲ. ಅವಳ ಮಾತೂ ಅರ್ಥವಾಗುತ್ತಿಲ್ಲ. ಮಾತನಾಡಿಸುವ ದಾರಿಯನ್ನು ಶರಣ್ಯ ಕಂಡುಕೊಳ್ಳುವಳೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/720046/size7/61f7713e7da97aaeaba6086bf69eca76.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/720046/size7/61f7713e7da97aaeaba6086bf69eca76.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-114849","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-114849","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":582,"opdsId":"urn:uuid:SW-398821","title":"ನಮ್ಮ ಸುಂದರ ಜಗತ್ತು","authors":["Sarita Sharan"],"language":"","readingLevel":"","publisher":"","summary":"ಈ ಸುಂದರ ಭೂಮಿಯಲ್ಲಿ ಮಾನವ ಜೀವನವು ಸುಮಾರು 2,00,000 ವರ್ಷಗಳಿಂದಲೂ ಇದೆ. ಕಳೆದ 250 ವರ್ಷಗಳಲ್ಲಿ ನಾವು ಒಬ್ಬ ರಾಕ್ಷಸನಿಗೆ ಜನ್ಮ ನೀಡಿದ್ದೇವೆ. ಅದು ಹವಾಮಾನ ಬದಲಾವಣೆ. ಈ ರಾಕ್ಷಸ ಭೂಮಿಯ ತಾಪಮಾನವನ್ನು ಬಿಸಿ ಮಾಡುತ್ತಿದ್ದಾನೆ. ಭೂಮಿಯ ಭಾಗವಾಗಿರುವ ಮನುಷ್ಯರು ಸೇರಿದಂತೆ ಎಲ್ಲವೂ ಅಪಾಯದಲ್ಲಿದೆ. ನಾವು ಈ ಹಂತಕ್ಕೆ ಬಂದ್ದಿದು ಹೇಗೆ? ಮುಂದೇನು? ಉತ್ತರವನ್ನು ತಿಳಿಯಲು, ಈ ಪುಸ್ತಕವನ್ನು ಓದಿ. ಈ ಸಮಸ್ಯೆಗೆ ಪರಿಹಾರವನ್ನು ಸಹ ತಿಳಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/621795/size7/bf212bf61e522b6f4d6d83b07ad4934f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/621795/size7/bf212bf61e522b6f4d6d83b07ad4934f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-398821","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-398821","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":583,"opdsId":"urn:uuid:SW-33653","title":"ಲೊಚ್ ಲೊಚ್ ರಾಯನ ತಲೆಕೆಳಗು ಪ್ರಪಂಚ","authors":["Smitha sathyaprakash"],"language":"","readingLevel":"","publisher":"","summary":"ಆಕಾಶನಿಗೆ ಲೊಚ್ ಲೊಚ್‌ ರಾಯ ಎನ್ನುವ ಗೆಳೆಯ ಇದ್ದಾನೆ. ಅವನ ಪ್ರಪಂಚ ನಮ್ಮ, ನಿಮ್ಮದಕ್ಕಿಂತ ಬೇರೆಯೇ ರೀತಿ. ಅದೇ ತಲೆಕೆಳಗು ಪ್ರಪಂಚ. ಹೇಗೆಂದು ನೀವೂ ನೋಡಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717018/size7/e14e893ffc796fc65c0982fe187552ad.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717018/size7/e14e893ffc796fc65c0982fe187552ad.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-33653","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-33653","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":584,"opdsId":"urn:uuid:SW-37932","title":"​ಬೆರಳು ಚೀಪುವ ಸಿತಾರಾ","authors":["Girish N. R."],"language":"","readingLevel":"","publisher":"","summary":"ಸಿತಾರಾಳ ಕುಟುಂಬ ಭವ್ಯ ತಾಜ್ ಮಹಲ್ ಸ್ಮಾರಕ ನೋಡಲು ಪ್ರವಾಸಕ್ಕೆ ಹೊರಟಿದೆ. ಆದರೆ, ಹೆಬ್ಬೆರಳು ಚೀಪುವ ಮಕ್ಕಳನ್ನು ರೈಲಿನಲ್ಲಿ ಪ್ರಯಾಣಿಸಲು ಬಿಡುವುದಿಲ್ಲ! ಪಾಪ ಸಿತಾರಾ! ಹಾಗಿದ್ದರೆ ಈ ಪ್ರವಾಸಕ್ಕೆ ಅವಳು ಹೋಗಲಾಗುವುದಿಲ್ಲವೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/66201/size7/eba059167763ce56ee9701d9255a8fcb.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/66201/size7/eba059167763ce56ee9701d9255a8fcb.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-37932","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-37932","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":585,"opdsId":"urn:uuid:SW-460713","title":"ಮುಖವಾಡ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ನಸೀಮ್ ಒಂದು ಚೆಂದನೆಯ ಮುಖವಾಡವನ್ನು ಮಾಡಿ, ಹಾಕಿಕೊಂಡು ವಾಕಿಂಗ್ ಹೊರಟನು. ಮುಂದೆ ಏನಾಯಿತು ಎಂದು ತಿಳಿಯಲು ಈ ಕತೆ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727487/size7/b22936cefa94e00219ddef0bf97a5ed9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727487/size7/b22936cefa94e00219ddef0bf97a5ed9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-460713","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-460713","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":586,"opdsId":"urn:uuid:SW-608727","title":"ಸ್ವತಂತ್ರ ಸೋದರಿಯರು","authors":["Jayashree Kasaravalli"],"language":"","readingLevel":"","publisher":"","summary":"ಗೋದಾವರಿ ಬಡಾವಣೆಯ ಸ್ವಾತಂತ್ರ್ಯ ದಿನಾಚರಣೆ ಆಚರಣೆಗೆ ಪಯೋಶಿನಿಗೆ ಏನಾದ್ರೂ ದೊಡ್ಡದು, ಅತ್ಯಂತ ಸುಂದರ, ಅತ್ಯಾಕರ್ಷಕ ಹಾಗೂ ಅತ್ಯದ್ಭುತ ಆಗಿರುವಂಥದ್ದು ಮಾಡೋ ಆಸೆ. ಆದರೆ, ಅದಕ್ಕೆ ಬೇಕಾದಷ್ಟು ಸಮಯವಿಲ್ಲ, ಜೊತೆಗೆ, ಬ್ಯಾಂಡ್ ಮಾಸ್ಟರ್ ತೋತಾಜಿ ಅಷ್ಟೇನೂ ನೆರವು ನೀಡುತ್ತಿಲ್ಲ. ಚಿಕ್ಕ ಹುಡುಗಿಯೊಬ್ಬಳು ತನ್ನ ವ್ಯಾಮೋಹವನ್ನು ಅನುಸರಿಸಿ, ಅದನ್ನೇ ಹುಡುಕಿಕೊಂಡು ಹೋಗುವುದರ ಬಗ್ಗೆ ಈ ಕತೆಯಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727676/size7/901e9d58d13e713c77b3d5be08733a6e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727676/size7/901e9d58d13e713c77b3d5be08733a6e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-608727","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-608727","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":587,"opdsId":"urn:uuid:SW-513732","title":"ಕೋಣಿ ಜುಜ್: ಮೊಟ್ಟೆ ಜಗಳ","authors":["Hema Hebbagodi"],"language":"","readingLevel":"","publisher":"","summary":"ಅಸ್ಸಾಂನಲ್ಲಿ ರೊಂಗಾಲಿ ಬಿಹು ಹಬ್ಬದಂದು ಮೊಟ್ಟೆ ಜಗಳ ಆಡುತ್ತಾರೆ. ಮಾಮೋನಿ ಬೆಳಗ್ಗೆ ಎದ್ದವಳೇ ಈ ಜಗಳಕ್ಕಾಗಿ ವಿವಿಧ ರೀತಿಯ ಮೊಟ್ಟೆ ಆರಿಸಿಕೊಳ್ಳುತ್ತಾಳೆ. ಅವಳು ಮೊಟ್ಟೆಗಳನ್ನು ಗೆದ್ದುಬಂದಳೇ? ಎನಾಯ್ಡಿಯೊ ಅದರಿಂದ ರುಚಿಯಾದ ಮೊಟ್ಟ ಭಾಜ ಮಾಡಿಕೊಟ್ಟಳೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723109/size7/4b45240fcbecdcb37a6ade3efe0aa350.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723109/size7/4b45240fcbecdcb37a6ade3efe0aa350.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-513732","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-513732","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":588,"opdsId":"urn:uuid:SW-432999","title":"ಗೆರೆ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ನಮ್ಮ ಸುತ್ತಮುತ್ತ, ಎಲ್ಲ ಕಡೆ ಗೆರೆಗಳಿವೆ. ಮನೆ, ಹೊಲ-ಗದ್ದೆಯಲ್ಲಿ;  ಭೂಮಿ, ಆಕಾಶದಲ್ಲಿ ಮತ್ತು ನೀರಿನಲ್ಲಿ ಎಷ್ಟೊಂದು ಪ್ರಕಾರದ ಗೆರೆಗಳಿವೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727489/size7/235b12d2ddc577a053ab49c593fb66df.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727489/size7/235b12d2ddc577a053ab49c593fb66df.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-432999","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-432999","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":589,"opdsId":"urn:uuid:SW-64700","title":"ಈಜು ಕಲಿತ ರಝಿಯಾ","authors":["Kumar S"],"language":"","readingLevel":"","publisher":"","summary":"ರಝಿಯಾ ಈಜು ಕಲಿಯಲೇಬೇಕಿತ್ತು. ಆದರೆ, ಅವಳಿಗೆ ನೀರು ಕಂಡರೆ ಭಯ! ಅವಳ ಜತೆ ನೀವೂ ತೇಲಿ, ಮುಳುಗಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715532/size7/275a879874497771e67c6eda8995eff9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715532/size7/275a879874497771e67c6eda8995eff9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-64700","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-64700","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":590,"opdsId":"urn:uuid:SW-134506","title":"ಕಂಡಲ್ಲಿ ಕಲೆ – ಇಲ್ಲಿ, ಅಲ್ಲಿ ಮತ್ತು ಮಾಡುವ ಊಟದಲ್ಲೂ","authors":["Preethi Nagaraj"],"language":"","readingLevel":"","publisher":"","summary":"ಕಲೆ ನಮ್ಮ ಸುತ್ತಲೂ ಇದೆ. ಕೇವಲ ರೇಖಾಚಿತ್ರ ಅಥವಾ ಬಣ್ಣದ ಚಿತ್ರಗಳಲ್ಲಿ ಮಾತ್ರ ಇಲ್ಲ. ಕಂಡಲ್ಲಿ ಕಲೆ ಸರಣಿ ಪುಸ್ತಕದಲ್ಲಿ ಒಬ್ಬ ಓದುಗ ಕಲಾವಿದನೊಡನೆ ಹೆಜ್ಜೆ ಹಾಕುತ್ತಾ ಆಹಾರ ಪದಾರ್ಥಗಳಲ್ಲೂ ಕಲೆಯನ್ನು ಹುಡುಕುತ್ತಾನೆ. ಪ್ರಾಸಪದ್ಯಗಳಿಂದ ಕೂಡಿದ ಈ ಪುಸ್ತಕವನ್ನು ಓದುತ್ತಿದ್ದರೆ ಓದುಗರ ಕಲ್ಪನೆಗೂ ರೆಕ್ಕೆಪುಕ್ಕ ಬರುತ್ತವೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727182/size7/e9f3700d2c7912a766ad0f97187465bc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727182/size7/e9f3700d2c7912a766ad0f97187465bc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-134506","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-134506","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":591,"opdsId":"urn:uuid:SW-5249","title":"ಮಣಿಕಂಠನಿಗೆ ಸಾಕು ಸಾಕಾಗಿತ್ತು","authors":["Geetha M."],"language":"","readingLevel":"","publisher":"","summary":"ಮಣಿಕಂಠ ಮತ್ತು ಅವನ ತಾಯಿ ತಮ್ಮ ಪುಟ್ಟ ಹಳ್ಳಿಯಿಂದ ಸ್ಮಾರ್ಟ್ ನಗರಕ್ಕೆ ವಲಸೆ ಬಂದ್ದಿದ್ದಾರೆ. ಮಣಿಕಂಠನ ಬಳಿ ಈಗ ದಿವ್ಯ ಮಣಿಯೊಂದಿದೆ. ಮಣಿಕಂಠನ ದಿವ್ಯಮಣಿಯು, ಅವನು ಸಂತೋಷದಿಂದಿರುವನೋ, ದುಖ:ದಲ್ಲಿರುವನೋ, ಆರೋಗ್ಯವಾಗಿದ್ದಾನೆಯೋ ಅಥವಾ ಇಲ್ಲವೋ ಎಲ್ಲವನ್ನೂ ಹೇಳುತ್ತಿತ್ತು. ಅವನು ಯಾವಾಗ ಊಟ ಮಾಡಬೇಕು, ಯಾವಾಗ ಮಲಗಬೇಕು ಎಂದು ಹೇಳುವುದರ ಜೊತೆಗೆ, ಅವಶ್ಯವಿದ್ದಲ್ಲಿ ಮನೆ ಕೆಲಸ ಮಾಡಲು ಸಹಾಯ ಮಾಡುತ್ತಿತ್ತು. ಅವನಿಗೆ ಹುಷಾರಿಲ್ಲದಿದ್ದಲ್ಲಿ ಅಮ್ಮನಿಗೆ ತಿಳಿಸುವುದನ್ನೂ ಸಹ ಮಾಡುತ್ತಿತ್ತು. ಇದು ಮಾಯವೇ ಅಥವ ವಿಜ್ಞಾನವೇ? ಕಥೆ ಓದಿ ತಿಳಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712349/size7/80baf01ee305956f7dc6a39548938ed4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712349/size7/80baf01ee305956f7dc6a39548938ed4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-5249","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-5249","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":592,"opdsId":"urn:uuid:SW-352050","title":"ಗಿಡಕ್ಕೆ ಕೊರಳಾದವಳು","authors":["Mohan Kumar R"],"language":"","readingLevel":"","publisher":"","summary":"ಜಯಶ್ರೀಗೆ ಗಿಡಗಳೆಂದರೆ ಪಂಚಪ್ರಾಣ. ಅವುಗಳ ಬಗ್ಗೆ ತಿಳಿಯಬೇಕೆಂದು ತನ್ನಿಡಿ ಬದುಕನ್ನು ಅದಕ್ಕಾಗಿ ಮೀಸಲಿಡಲು ನಿರ್ಧರಿಸಿದರು. ಇದು ಪರಿಸರ ವಿಜ್ಞಾನಿ ಡಾ. ಜಯಶ್ರೀ ಸುಬ್ರಹ್ಮಣ್ಯಂ ಜೀವನ ಕತೆ. ಈ ಕತೆ ಗಿಡಗಳ ಕುರಿತಾದ ಅವರ ಅಪರಿಮಿತ ಆಸಕ್ತಿ, ಪ್ರೀತಿಯನ್ನು ಹೇಳುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/491323/size7/1990bf6c5f6788bca49cd0131c95f55a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/491323/size7/1990bf6c5f6788bca49cd0131c95f55a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-352050","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-352050","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":593,"opdsId":"urn:uuid:SW-461197","title":"ಒಂದು ಎಲೆಯ ಸುತ್ತಾಟ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಗಾಳಿ ಬೀಸಿತು, ಎಲೆ ಹಾರಿತು. ಅದು ದೂರ ದೂರಕ್ಕೆ ಪ್ರಯಾಣಿಸಿತು. ಕೊನೆಗೆ ಕಬೀರನ ಮನೆಗೆ ಹೋಯಿತು. ಕಬೀರ್ ಆ ಎಲೆಯನ್ನು ಏನು ಮಾಡಿದ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727494/size7/5dab3291440b3ff0f521deee44114061.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727494/size7/5dab3291440b3ff0f521deee44114061.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-461197","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-461197","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":594,"opdsId":"urn:uuid:SW-456407","title":"ಹುಟ್ಟುಹಬ್ಬದ ಸಂಭ್ರಮ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಸಂಭ್ರಮದ ಹುಟ್ಟುಹಬ್ಬದ ಆಚರಣೆಯ ನಂತರ, ಕ್ರಿಶ್‌ಗೆ ಅನೇಕ ಉಡುಗೊರೆಗಳು ಬಂದಿವೆ. ಅದರಲ್ಲಿ ಕ್ಯಾಮೆರಾ ಕೂಡ ಒಂದು. ಹೊಸ ಉಡುಗೊರೆಯೊಂದಿಗೆ ಆಟವಾಡುತ್ತಿರುವಾಗ, ತನ್ನ ಅಮ್ಮ ಅಡುಗೆಮನೆಯಲ್ಲಿ ಅಳುತ್ತಿರುವುದನ್ನು ಗಮನಿಸುತ್ತಾನೆ. ಅವನು ಮುಂದೆ ಏನು ಮಾಡುತ್ತಾನೆಂದು ಕಂಡುಹಿಡಿಯಿರಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/699247/size7/3fc37d2f562718ad41ae2200b5a20908.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/699247/size7/3fc37d2f562718ad41ae2200b5a20908.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-456407","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-456407","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":595,"opdsId":"urn:uuid:SW-113750","title":"ಮೀಂಚುಳ್ಳಿಯಾದ ಮಹಾರಾಜ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಇರುವುದೆಲ್ಲವನ್ನು ಬಿಟ್ಟು ಅಲ್ಲದುದನ್ನು ಬಯಸಿದ ರಾಜ ಮೀಂಚುಳ್ಳಿಯಾಗಿ ಕೊರಗಿಗೆ ಗುರಿಯಾದ ಕಥೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/141841/size7/b35e34f4aa3c8dc3caaf1c6592e5211c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/141841/size7/b35e34f4aa3c8dc3caaf1c6592e5211c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-113750","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-113750","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":596,"opdsId":"urn:uuid:SW-578557","title":"ನಾನು, ನನ್ನ ಗೆಳತಿ","authors":["Sarita Sharan"],"language":"","readingLevel":"","publisher":"","summary":"ಯಾಂಗ್‌ಜೀ ತನ್ನ ಚಿಕ್ಕಮ್ಮನನ್ನು ಭೇಟಿಯಾಗಲು, ಹಳ್ಳಿಗೆ ಹೋಗುತ್ತಿದ್ದಾಳೆ. ಆದರೆ, ಅವಳು ಹೊರಡುತ್ತಿರುವುದನ್ನು ತನ್ನ ಆತ್ಮೀಯ ಸ್ನೇಹಿತೆ ಲಕ್ಕಿಗೆ ಹೇಳಲು ಮರೆತಿದ್ದಳು. ಯಾಂಗ್‌ಜೀ ಮನೆಗೆ ಹಿಂದಿರುಗಿದಾಗ ಲಕ್ಕಿ ಏನು ಹೇಳಬಹುದು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/637476/size7/e45d0a114f0118c38e69d7a233320448.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/637476/size7/e45d0a114f0118c38e69d7a233320448.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-578557","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-578557","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":597,"opdsId":"urn:uuid:SW-5698","title":"ಧುಮುಕು!","authors":["Aparna Prasanna"],"language":"","readingLevel":"","publisher":"","summary":"ನಮ್ಮೊಂದಿಗೆ ಕೋರಲ್ ರೀಫ್ ಗಳ  (ಹವಳದ ಬಂಡೆಗಳು) ಅದ್ಭುತ ಲೋಕಕ್ಕೆ ಡೈವ್ ಮಾಡಿ, ಕೋರಲ್ ರೀಫ್ ಗಳ  ಅದ್ಭುತ ಲೋಕಕ್ಕೆ ನಮ್ಮೊಂದಿಗೆ ನೀವು ಕೂಡ ಸಮುದ್ರದಲ್ಲಿ ಧುಮುಕಿ ಮತ್ತು ಕೆಲವು ವಿಚಿತ್ರ ಹಾಗೂ ಸುಂದರ ಸಮುದ್ರ ಜೀವಿಗಳ ಮಿಂಚು ನೋಟ ಕಾಣಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723793/size7/cbace915f1070d1f46291c016afd4b5d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723793/size7/cbace915f1070d1f46291c016afd4b5d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-5698","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-5698","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":598,"opdsId":"urn:uuid:SW-455812","title":"ಟಪ್-ಟಪ್-ಟಪಕ್","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಮಳೆ ಬಂದು ನಿಂತಿದೆ. ಕಾಡಿನಲ್ಲಿ ಏನಿದು ಸದ್ದು? ಟಪ್-ಟಪ್-ಟಪಕ್!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721648/size7/bf7c31d602d29510073b0f23cb0d1688.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721648/size7/bf7c31d602d29510073b0f23cb0d1688.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-455812","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-455812","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":599,"opdsId":"urn:uuid:SW-15105","title":"ಮೂವರು ಶೂರರು ಚೀನಾ ಜಾನಪದ ಕಥೆ","authors":["R. Venkatesh"],"language":"","readingLevel":"","publisher":"","summary":"ಶ್ರೀಮತಿ ಛಾಂಗ್‌ಗೆ ಒಂದು ದಿನ ತನ್ನ ಮಗನಿಂದ ಪತ್ರ ಬಂದಿತ್ತು. ಅದನ್ನು ಓದಲು ಅವಳಿಂದ ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಆದ್ದರಿಂದ ಅದನ್ನು ಓದಲು ವೀರಸೈನಿಕ ವೆನ್ ನನ್ನು ಕೇಳಿ ಕೊಂಡಳು. ಅದನ್ನು ಒಮ್ಮೆ ನೋಡಿದ ಕೂಡಲೇ ವೀರಸೈನಿಕ ವೆನ್ ಅಳುವುದಕ್ಕೆ ಶುರು ಮಾಡಿದ. ಅವನು ಅಳುವುದನ್ನು ನೋಡಿದ ಛಾಂಗ್ ಆ ಪತ್ರದಲ್ಲಿ ಯಾವುದೋ ಕೆಟ್ಟ ಸುದ್ದಿಯಿರುವುದಾಗಿ ಭಾವಿಸಿ ತಾನೂ ಜೋರಾಗಿ ಅಳಲು ಶುರು ಮಾಡಿದಳು. ಆ ದಾರಿಯಲ್ಲಿ ಹೋಗುತ್ತಿದ್ದ ವ್ಯಾಪಾರಿ ಪೆಂಗ್ ಇವರು ದುಃಖ ಪಡುವುದನ್ನು ನೋಡಿ, ಅವರ ಜತೆ ಸೇರಿಕೊಂಡನು. ಆದರೆ ಆಕಾಶವೇ ತಲೆಯ ಮೇಲೆ ಬಿದ್ದಂತೆ ಅವರೆಲ್ಲರೂ ಏಕೆ ಅಳುತ್ತಿದ್ದಾರೆ? ಅದನ್ನು ಕಂಡು ಹಿಡಿಯಲು ಈ ಕುತೂಹಲಭರಿತ ಚೀನೀ ಜಾನಪದ ಕತೆಯನ್ನು ಓದಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/697452/size7/b5e2e167fa9057e1165e90a3e62fce43.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/697452/size7/b5e2e167fa9057e1165e90a3e62fce43.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15105","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15105","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":600,"opdsId":"urn:uuid:SW-12491","title":"ಅಪುವಿನ ಭಾರೀ ಭೂಕಂಪ","authors":["Ravikiran"],"language":"","readingLevel":"","publisher":"","summary":"ಅಪು ಹಾಡಿದುದರಿಂದ ಭೂಮಿ ಅಲುಗಲು ಹಾಗೂ ಕಂಪಿಸಲು ಶುರುವಾಯಿತೆ? ಅಥವಾ ಅದು ಭೂಕಂಪನವೇ? ಹೆಚ್ಚು ತಿಳಿಯಲು ಭೂಕಂಪನದ ಕುರಿತ ಈ ನಗಿಸುವ ಮತ್ತು ಮಾಹಿತಿ ಆಧಾರಿತ ಕಥೆ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/713578/size7/2e61153788e79629615dbd8dd46a58fc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/713578/size7/2e61153788e79629615dbd8dd46a58fc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12491","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12491","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":601,"opdsId":"urn:uuid:SW-314530","title":"ಬೀದಿಯಲ್ಲಿನ ಗದ್ದಲ ಕೇಳು","authors":["Smt Premalatha Rathna"],"language":"","readingLevel":"","publisher":"","summary":"ಬೆಳಗಿನ ಜಾವದಲ್ಲಿ ಒತ್ತು ಶ್ಯಾವಿಗೆ ಮಾರುವ ಅಜ್ಜಿಯ ದನಿ ಈ ಬೀದಿಯವರನ್ನೆಲ್ಲ ಎಬ್ಬಿಸಿ ಬಿಡುತ್ತಿತ್ತು. ಸಕ್ಕರೆ ಮಿಠಾಯಿ ಮಾರುವ ಕಾಕನ ದನಿ ಕೇಳುತ್ತಲೇ ಮಕ್ಕಳೆಲ್ಲ ಎದ್ದು ಬಿದ್ದು ಓಡಿ ಬರುವರು. ಈ ಗಲ್ಲಿಯಲ್ಲಿ ಪ್ರತಿದಿನ ಎಷ್ಟೊಂದು ರೀತಿಯ ದನಿಗಳು ಕೇಳಿಸುತ್ತವೆ ಗೊತ್ತಾ? ಅರೆ, ಮತ್ತೆ ಬೇರೆ ಧ್ವನಿ ಕೇಳಿಸುತ್ತಿದೆಯಲ್ಲ, ಬನ್ನಿ, ಅದು ಯಾರಿರಬಹುದೆಂದು ನೋಡೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727371/size7/8bf79007ff5177f6c3b249e01db5fcc6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727371/size7/8bf79007ff5177f6c3b249e01db5fcc6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-314530","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-314530","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":602,"opdsId":"urn:uuid:SW-223555","title":"ಜಂಗಲ್ ಬುಕ್","authors":["Shabana Begum"],"language":"","readingLevel":"","publisher":"","summary":"ನೀರಾನೆ ಕಾಡಿನಿಂದ ರಸ್ತೆಗೆ ಬರಲು ಕಾರಣ ಏನಿರಬಹುದು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/285291/size7/5496578942fc19f65137c8a7aead529d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/285291/size7/5496578942fc19f65137c8a7aead529d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-223555","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-223555","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":603,"opdsId":"urn:uuid:SW-155553","title":"ಫಿರೋಜ್‌, ನೊಹಾ ಮತ್ತು ಬೇಜಾರು","authors":["Hema Hebbagodi"],"language":"","readingLevel":"","publisher":"","summary":"ಫಿರೋಜ್‌ ಹೋದಲ್ಲೆಲ್ಲಾ ಬೇಸರವೂ ಅವನನ್ನ ನೆರಳಿನಂತೆ ಹಿಂಬಾಲಿಸುತ್ತಿದೆ. ಆದರೆ, ಅವನ ಗೆಳೆಯ ನೊಹಾ ಇರುವಾಗ ಬೇಸರಕ್ಕೆ ಜಾಗವೆಲ್ಲಿ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/730558/size7/3d0cb2d3b0fda20721eca326ffa562e0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/730558/size7/3d0cb2d3b0fda20721eca326ffa562e0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-155553","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-155553","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":604,"opdsId":"urn:uuid:SW-21670","title":"ಮಾರುದ್ದ ಕಿವಿಗಳ ಮೊಲರಾಯ","authors":["G W Carlo"],"language":"","readingLevel":"","publisher":"","summary":"ಮೊಲರಾಯನನ್ನು ಚೋಟುದ್ದ ಬಾಲ, ಮಾರುದ್ದ ಕಿವಿಗಳ ಪ್ರಾಣಿಯಾಗಿಸಿದ್ದು ಏಡಿ ಎಂದು ನಿಮಗೆ ಗೊತ್ತಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/222886/size7/8be23e09e3317e5cc5520d9e372e10f9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/222886/size7/8be23e09e3317e5cc5520d9e372e10f9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-21670","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-21670","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":605,"opdsId":"urn:uuid:SW-28744","title":"ಜೇಡನ ಜಾತ್ರೆ","authors":["Kollegala Sharma"],"language":"","readingLevel":"","publisher":"","summary":"ಕಾವೇರಿ ಮತ್ತು ಶಿವಿ ತಮ್ಮ ಗೆಳತಿ ಶಮಾಳ ಜೊತೆ ಜೇಡಗಳನ್ನು ಹುಡುಕಲು ಹೋದರು. ಆಗ ಯಾವೆಲ್ಲ ಬಗೆಯ ಜೇಡಗಳು ಕಂಡವು ಎಂದು ತಿಳಿಯಲು ಕಥೆ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/724142/size7/2def5022f432c5f5ad671e002ebe95c8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/724142/size7/2def5022f432c5f5ad671e002ebe95c8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-28744","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-28744","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":606,"opdsId":"urn:uuid:SW-436745","title":"ಮನೆಗೆ ಹೋಗುತ್ತ, ನಾನು ನೋಡಿದ್ದು...","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಪ್ರತಿದಿನ ಸಾಯಂಕಾಲ ಶಾಲೆಯಿಂದ ಮನೆಗೆ ಸೈಕಲ್‌ನಲ್ಲಿ ಹೋಗುತ್ತಾ, ಬೆಟ್ಟದ ಸಣ್ಣ ರಸ್ತೆಗಳಲ್ಲಿ ಬೆನು ಅನೇಕ ಹೊಸ ವಿಷಯಗಳನ್ನು ನೋಡುತ್ತಾಳೆ. ಅವು ಯಾವುವು? ಬನ್ನಿ ನೋಡೋಣ... ಅಲ್ಲ ಅಲ್ಲ ಎಣಿಸೋಣ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527518/size7/51104c8b31934a61c03e889db36c5644.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527518/size7/51104c8b31934a61c03e889db36c5644.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-436745","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-436745","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":607,"opdsId":"urn:uuid:SW-62761","title":"ಪಿಂಟು ಪೈ ಕಂಡು ಹಿಡಿದಿದ್ದು ಹೇಗೆ?","authors":["Sarita Sharan"],"language":"","readingLevel":"","publisher":"","summary":"ಪಿಂಟು ಹೊಸ ಶಾಲೆಯಲ್ಲಿ ಒಬ್ಬನೇ ಕುಳಿತಿದ್ದಾನೆ. ಪಿಂಟು ತನ್ನ ಸಹಪಾಠಿಗಳ ಜೊತೆ ಗೆಳೆತನ ಬೆಳೆಸಲು ಹೋದಾಗೆಲ್ಲಾ, ಅವರುಗಳು ತಮ್ಮದೇ ಪೂರ್ಣ ವೃತ್ತವನ್ನು ಮಾಡಿ ಮುಚ್ಚುತ್ತಿದ್ದರು. ಅದನ್ನು ನೋಡುತ್ತಿದ್ದಾಗ, ಪಿಂಟುಗೇ ಪೈ ಕೈವಶವಾಯಿತು. ಅಲ್ಲಿಂದ ಮುಂದಕ್ಕೆ ಎಲ್ಲ ಸರಿ ಹೋಯಿತು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/718341/size7/5ba950a3c80d17bc15f123072ca97a74.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/718341/size7/5ba950a3c80d17bc15f123072ca97a74.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-62761","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-62761","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":608,"opdsId":"urn:uuid:SW-125655","title":"ವಿನ್ಯಾಸಗಳ ಪತ್ತೇದಾರ ಪ್ರಣವ್!","authors":["V. S. S Shastry"],"language":"","readingLevel":"","publisher":"","summary":"ಆ ಮರದಲ್ಲಿ ವಿಶೇಷವಾದದುನ್ನು ಕಂಡುಕೊಳ್ಳುವವರೆಗೆ ಪ್ರಣವನಿಗೆ ಎಲ್ಲ ದಿನಗಳ ಹಾಗೆ ಅದೊಂದು ದಿನ ಅಷ್ಟೆ. ಈ ಅವಿಷ್ಕಾರ ಅವನನ್ನು ತನ್ನ ಸುತ್ತಮುತ್ತಲಿನ ಜಗತ್ತನ್ನು ನೋಡುವ ದೃಷ್ಟಿಯನ್ನೆ ಬದಲಿಸಿತು. ಆಕಾರಗಳು ಮತ್ತೆ ಮತ್ತೆ ಅದೆ ಥರ ಕಾಣುವುದಿಲ್ಲ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/182211/size7/1c0f7c208e02eb005dabac5c14150631.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/182211/size7/1c0f7c208e02eb005dabac5c14150631.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-125655","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-125655","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":609,"opdsId":"urn:uuid:SW-11282","title":"ಕೊಕ್ಕು ಮುರಿದ ಗಿಣಿ","authors":["Rupasree M.S."],"language":"","readingLevel":"","publisher":"","summary":"ಅಪ್ಪನ ಪೆನ್ನು ಕಸ್ನಿಯನ್ನು ಸೆಳೆಯುತ್ತದೆ. ಅದನ್ನು ಅವಳು ಬಳಸಬೇಕೋ? ಬೇಡವೋ? ಪೆನ್ನು ಬಳಸಿ ಚಿತ್ರ ಬಿಡಿಸಿದ ಮೇಲೆ ಅವಳು ಕೋಪಗೊಂಡಿರುವ ಅಪ್ಪ ಮತ್ತು ಗಿಣಿಯನ್ನು ಎದುರಿಸಬೇಕು. ಈ ಬಣ್ಣದ ಕಥೆಯು ಯಾವುದೇ ಮಗುವನ್ನು ಸಂತೋಷಪಡಿಸುತ್ತದೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721669/size7/7d6642454b991b38b7f71875a6519140.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721669/size7/7d6642454b991b38b7f71875a6519140.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-11282","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-11282","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":610,"opdsId":"urn:uuid:SW-218002","title":"ಕಾಣೆಯಾದ ಕಾಲ್ಚೀಲಗಳು","authors":["Pallavi Rao"],"language":"","readingLevel":"","publisher":"","summary":"ಕಣಕಣ, ಮಿಣಮಿಣ, ಗೀಟುಗೀಟಿನ ಕಾಲ್ಚೀಲಗಳೆಲ್ಲ ಕಾಣೆಯಾಗುವುವು ಎಲ್ಲಿಗೆ? ಈ ರೋಚಕ  ಕಥಾಲಹರಿ ಕೊನೆಗೂ ಕಾಣೆಯಾಗುವ ಕಾಲ್ಚೀಲಗಳ ರಹಸ್ಯವನ್ನು ಬಗೆಹರಿಸುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/287603/size7/fba59e27bdadfb9da6ce4325d90e068a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/287603/size7/fba59e27bdadfb9da6ce4325d90e068a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-218002","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-218002","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":611,"opdsId":"urn:uuid:SW-130446","title":"ನನ್ನ ಅಪ್ಪ ಮತ್ತವನ ಶಬ್ದಗಳು","authors":["Preethi Nagaraj"],"language":"","readingLevel":"","publisher":"","summary":"ನನ್ನ ಅಪ್ಪ ಮಾಡುವ ಶಬ್ದಗಳು ನನಗಿಷ್ಟ. ನನ್ನ ನೆಚ್ಚಿನ ಶಬ್ದ ಯಾವುದು ಅಂತ ನಿಮಗೆ ಗೊತ್ತಾಯಿತಲ್ಲ - ನಿಮ್ಮದು ಯಾವುದು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/186760/size7/31364a1bc354083c17c2a516cefd632e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/186760/size7/31364a1bc354083c17c2a516cefd632e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-130446","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-130446","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":612,"opdsId":"urn:uuid:SW-668","title":"ಕಿರ್ಕಿಂಚೊ ಮತ್ತು ನರಿ","authors":["K. P. Bhatt"],"language":"","readingLevel":"","publisher":"","summary":"ನರಿ ಮತ್ತು ಕಿರ್ಕಿಂಚೊ ಒಳ್ಳೆಯ ಗೆಳೆಯರಾಗಿದ್ದರು. ಅವರು ಹೆಚ್ಚು ಕಾಲ ಒಟ್ಟಿಗೇ ಇರುತ್ತಿದ್ದರು ಹಾಗೂ ತಮಾಷೆ ಮಾಡುತ್ತ ಕಾಲ ಕಳೆಯುತ್ತಿದ್ದರು. ಒಂದು ದಿನ, ಏನೂ ಮಾಡದೆ ಹೀಗೆ ಸುಮ್ಮನೆ ಕಾಲ ಕಳೆಯಬಾರದು ಎಂದು ಕಿರ್ಕಿಂಚೊ ನಿಶ್ಚಯ ಮಾಡಿತು. ಮುಂದೇನಾಗುತ್ತದೆ ಎಂಬ ಕುತೂಹಲಕ್ಕೆ ಅರ್ಜೆಂಟೀನಾದ ಜಾನಪದ ಕತೆ ಓದಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721044/size7/8d44f88b1d324cf09b40cdda343db71c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721044/size7/8d44f88b1d324cf09b40cdda343db71c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-668","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-668","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":613,"opdsId":"urn:uuid:SW-14593","title":"ಮುಮ್ತಾಜ್ ಹೆಣೆದ ಕನಸುಗಳು","authors":["Jayashree Deshpande"],"language":"","readingLevel":"","publisher":"","summary":"ಚಿಕನ್‌ಕಾರಿ ಕಸೂತಿಯಲ್ಲಿ ಹೊಸ ನಮೂನೆಗಳನ್ನು ಕಲಿಯಲೆಂದು ಮುಮ್ತಾಜ್ ತನ್ನ ಹಳ್ಳಿಯಿಂದ ಬಲು ದೂರದಲ್ಲಿ ಇರುವ ಲಖನೌಗೆ ಬರುತ್ತಾಳೆ. ಅಲ್ಲಿ ಅವಳಿಗೆ ದೊರೆತ ಹೊಸ ಸ್ನೇಹಿತ ಮುನ್ನೂನಿಂದಾಗಿ ಅವಳು ಅನೇಕಾನೇಕ ಹೊಸ ಸಂಗತಿಗಳನ್ನು ಕಲಿತುಕೊಂಡಳು. ಅವಳು ಊಹಿಸಿದ್ದಕ್ಕಿಂತಲೂ ಹೆಚ್ಚು! ಮುನ್ನಾಗೆ ಧನ್ಯವಾದಗಳು!\nಜಾಲಿ ರೋಹತಗಿ ಅವರ ಈ ಸೂಕ್ಷ್ಮ ಸಂವೇದನಾಶೀಲ ಕಥೆಗೆ ಕಲಾತ್ಮಕ ಕಾಗದ ಕತ್ತರಿಸುವಿಕೆಯ ಸಾಯಿ ಚಿತ್ರಗಳನ್ನು ರಚಿಸಿದವರು ರಾಮ್ ಸೋನಿ.\nದಸ್ತಕಾರೀ ಹಾತ್ ಸಮಿತಿಯವರಿಂದ ರೂಪಿತವಾದ ನಾಲ್ಕು ಕಥೆಗಳ ಈ ಮಾಲಿಕೆಯು ಭಾರತದ ವಿವಿಧ ಭಾಗಗಳಲ್ಲಿರುವ ಹಳ್ಳಿಗಾಡಿನ ಕಲಾಕುಶಲ ನಿಪುಣ ಜನರ ಮಕ್ಕಳ ಬದುಕಿನ ಬಗ್ಗೆ ಒಂದು ನೋಟವನ್ನು ಬೀರುತ್ತದೆ. ಆಯಾ ಪ್ರಾದೇಶಿಕ ಸೊಗಡಿನ ವರ್ಣಚಿತ್ರಗಳು ಹಾಗೂ, ಕರಕುಶಲ ಕಲೆಯ ನಮೂನೆಗಳನ್ನು ಈ ಕಥೆಗಳಲ್ಲಿ ಚಿತ್ರಗಳಾಗಿ ಬಳಸಿಕೊಳ್ಳಲಾಗಿದೆ. ಇದರಿಂದಾಗಿ ಪುಸ್ತಕವನ್ನು ಓದುವ ಮಕ್ಕಳಿಗೆ ಭಾರತದ ವೈವಿಧ್ಯಮಯ ಸಾಂಸ್ಕತಿಕ ಭಾವಪ್ರದರ್ಶನದ ಆನಂದವು ದೊರೆಯುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/118163/size7/cb7cdd8d49e3e690fae53b5375f67eb7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/118163/size7/cb7cdd8d49e3e690fae53b5375f67eb7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-14593","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-14593","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":614,"opdsId":"urn:uuid:SW-508979","title":"ಅಮ್ಮಾ, ಅಜ್ಜ ಬಂದರು!","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಮಾಮಾ-ಮಾಮಿ, ಲೀಲಾ ಮತ್ತು ಅಜ್ಜ ನಮ್ಮನ್ನು ನೋಡಲು ಮನೆಗೆ ಬಂದಿದ್ದಾರೆ. ಅಮ್ಮ, ಅಜ್ಜ ಇಷ್ಟಪಡುವುದನ್ನು ಮಾಡುತ್ತಿದ್ದಾಳೆ. ಅದು ಏನೆಂದು ಕಂಡುಹಿಡಿಯಿರಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727551/size7/2307101d6f28a5ee418a1c48e250f83d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727551/size7/2307101d6f28a5ee418a1c48e250f83d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-508979","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-508979","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":615,"opdsId":"urn:uuid:SW-294147","title":"ಮೆಹ್ಲಿ ಗೋಭಾಯ್‌ನ ಗುಪ್ತಜಗತ್ತು: ಎಲ್ಲೆಡೆಯೂ ಕಲೆ ಕಂಡ ಮನುಷ್ಯ","authors":["Navika"],"language":"","readingLevel":"","publisher":"","summary":"ಗಾಳಿ ತೇಲಿಸಿಕೊಂಡು ಬಂದಂತೆ ಹರಿಯುವ ಮಣ್ಣು ಮಿಶ್ರಿತ ನೀರು, ಎಲೆ ಉದುರಿಸಿಕೊಂಡ ದೊಡ್ಡ ಮರಗಳು, ಕ್ಯಾನ್ವಾಸ್ಸನ್ನು ಗಬ್ಬೆಬ್ಬಿಸುವ ಕಾಗೆ – ಮೆಹ್ಲಿ ಗೋಭಾಯ್ ಇವೆಲ್ಲವುಗಳಲ್ಲಿ ಕಲೆಯನ್ನು ಕಂಡ. ಈ ಸ್ಫೂರ್ತಿದಾಯಕ ವರ್ಣಚಿತ್ರಕಾರನ ಪಯಣವನ್ನು ಗಮನಿಸಿ. ನಮ್ಮ ಸುತ್ತಮುತ್ತ ಕಲೆ ಹೇಗೆ ಮಿಳಿತಗೊಂಡಿದೆ ಎನ್ನುವುದನ್ನು ನೋಡಿ. ಜಗತ್ತು ಆಗ ನಿಮ್ಮ ಕಣ್ಣಿಗೆ ಹೊಸತೇ ಆಗಿ ಕಾಣುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/433438/size7/57ac0a1b3775ce938ca762eda9019d2a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/433438/size7/57ac0a1b3775ce938ca762eda9019d2a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-294147","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-294147","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":616,"opdsId":"urn:uuid:SW-50121","title":"ಗಪ್ಪು ಗೋಲಾ","authors":["G W Carlo"],"language":"","readingLevel":"","publisher":"","summary":"ಡಬ್ಬಿ ತೆರೆಯುತ್ತಿದ್ದಂತೆ ಗಪ್ಪು ಗೋಲಾ ಹೊರಬಂದು ಏನೇನೆಲ್ಲಾ ಆಯಿತು. ಗಪ್ಪು ಗೋಲಾ ಪೇಚಾಟದಲ್ಲಿ ನೀವು ಎಲ್ಲಿದ್ದೀರಿ ಎನ್ನುವುದನ್ನು ಮರೆಯದಿದ್ದರೆ ಸಾಕು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727080/size7/6b02033d91d678fd198870c0e0c63af5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727080/size7/6b02033d91d678fd198870c0e0c63af5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-50121","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-50121","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":617,"opdsId":"urn:uuid:SW-579","title":"ಅಕ್ಕಾ, ಅಕ್ಕಾ, ವಸ್ತುಗಳೇತಕೆ  ಏಳವು ಮೇಲಕೆ?","authors":["Vasantha Kalbagal"],"language":"","readingLevel":"","publisher":"","summary":"ಪುಟ್ಟ ತಮ್ಮನ ಅನ್ವೇಷಕ ತಲೆಯಲ್ಲಿ ಯಾವತ್ತೂ ಅಕ್ಕನನ್ನು ಕೇಳಬೇಕಾದ ಅನೇಕ ಪ್ರಶ್ನೆಗಳು ತುಂಬಿರುತ್ತವೆ. ಅಕ್ಕನಿಗೆ ಉತ್ತರಗಳೆಲ್ಲವೂ ಗೊತ್ತು ಎಂದೂ ಆತನಿಗೆ ಅರಿವಿದೆ. ಯಾಕೆಂದರೆ \nಆಕೆ ಯಾವತ್ತೂ ದಪ್ಪದಪ್ಪ ಪುಸ್ತಕಗಳನ್ನು ಓದುತ್ತಿರುತ್ತಾಳಲ್ಲಾ.\n\nಈ ಪುಸ್ತಕದಲ್ಲಿ ಪುಟ್ಟ, ತಮ್ಮನೊಬ್ಬನಿಗೆ ಏಕೆ ವಸ್ತುಗಳೆಲ್ಲಾ ಕೆಳಗೆ ಬೀಳುತ್ತವೆ, ಬದಲಾಗಿ ಅವೆಲ್ಲಾ ಮೇಲಕ್ಕೆ ಏಳುವಂತಾದರೆ ಮಜಾ ಇರುತ್ತದಲ್ಲ ಎಂಬ ಯೋಚನೆ. ನೆಲದ ಮೇಲೆಲ್ಲಾ ಏನಿದು ರಾಶಿ ಹರಡಿಕೊಂಡು ಕುಳಿತಿದ್ದೀಯಾ ಎಂದು ಅಮ್ಮ ಗದರುವುದಾದರೂ ತಪ್ಪುತ್ತದಲ್ಲ!\n\nಆದರೆ ಅಕ್ಕ ನಗುತ್ತಾಳೆ ಮತ್ತು ತಮ್ಮನ ಬುದ್ಧಿವಂತ ಪ್ರಶ್ನೆಗಳಿಗೆ ತಕ್ಕ ವಿವರಣೆ ನೀಡುತ್ತಾಳೆ. ಆದರೆ, ಈ ಪುಸ್ತಕವನ್ನು ಓದಲು ಪ್ರಾರಂಭಿಸುವುದಕ್ಕೆ ಮುನ್ನವೇ ಏಕೆ ವಸ್ತುಗಳೆಲ್ಲವೂ ಕೆಳಗೆ ಬೀಳುತ್ತವೆ ಎಂದು ಉತ್ತರ ಹೇಳಿ ನೋಡೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722409/size7/6fba8609c6e66c4289bbcef0bfcb7e0a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722409/size7/6fba8609c6e66c4289bbcef0bfcb7e0a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-579","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-579","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":618,"opdsId":"urn:uuid:SW-130388","title":"ಅನುರಾಧಾ ಮತ್ತು ಬಿಹು ಹಬ್ಬ","authors":["Ramesh Halappanavar"],"language":"","readingLevel":"","publisher":"","summary":"ಇನ್ನೇನು ಬಿಹು ಹಬ್ಬ ಬಂದೆ ಬಿಟ್ಟಿತು. ಆದರೆ ಅನುರಾಧಾ ಮಾತ್ರ ಹಬ್ಬದ ದಿನದವರೆಗೆ ಕಾಯಲು ತಯಾರಿಲ್ಲ. ಅಷ್ಟರಲ್ಲಿ ಮತ್ತೊಂದು ಸಮಸ್ಯೆ ಎದುರಾಯಿತು - ನಿಲ್ಲದ ಮಳೆ. ಅನುರಾಧಾ ಹೊರಗೆ ಹೋಗಿ ಸ್ನೇಹಿತರ ಜೊತೆಗೆ ಬಿಹು ಹಬ್ಬದಲ್ಲಿ ಕುಣಿಯಲು ಸಾಧ್ಯ ಆಗುವುದೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727174/size7/53b5f7b949e9df9d350ecbed881271d1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727174/size7/53b5f7b949e9df9d350ecbed881271d1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-130388","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-130388","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":619,"opdsId":"urn:uuid:SW-437269","title":"ನದಿ ತೀರದಲ್ಲಿ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಆಕಾಶ್, ಅಮ್ಮ ಮತ್ತು ಅಣ್ಣನ ಜೊತೆ ನದಿಗೆ ಹೋದನು. ಅಬ್ಬಾ ಎಷ್ಟು ನೀರು! ಅವನಿಗೆ ಭಯವಾಯಿತು. ಆದರೆ, ಬೇರೆ ಯಾರೂ ಹೆದರಲಿಲ್ಲ. ಆಕಾಶ್ ಭಯ ಕಡಿಮೆ ಆಯಿತಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727423/size7/b90c724e3eb16b1eab240b116687396c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727423/size7/b90c724e3eb16b1eab240b116687396c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-437269","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-437269","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":620,"opdsId":"urn:uuid:SW-110551","title":"ಆನೆಯ ಸೊಂಡಿಲು","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಮೊದಲು ಆನೆಯ ಸೊಂಡಿಲು ಚಿಕ್ಕ ಮೂಗಿನಂತೆಯೇ ಇತ್ತು ಎಂಬುದು ನಿನಗೆ ಗೊತ್ತಿತ್ತೆ? ಅದು ಉದ್ದವಾಗಿದ್ದು ಹೇಗೆ  ಗೊತ್ತೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/126984/size7/3aa2f0a919d25e463ac0ec847afc5a80.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/126984/size7/3aa2f0a919d25e463ac0ec847afc5a80.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-110551","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-110551","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":621,"opdsId":"urn:uuid:SW-150164","title":"ವಿಸ್ಮಯ ಹುಟ್ಟಿಸುವ ಪ್ರಶ್ನೆಗಳು","authors":["Jayalakshmi Hegde"],"language":"","readingLevel":"","publisher":"","summary":"ನಾವು ಎಷ್ಟು ಕಾಲ ಜೀವಿಸುತ್ತೇವೆ? ನೂರು ವರ್ಷ ಜೀವಿಸುವವರೂ, ಒಂದೇ ದಿನ ಜೀವಿಸುವ: ಮನುಷ್ಯರು, ಪ್ರಾಣಿ-ಪಕ್ಷಿ, ಗಿಡ-ಮರಗಳು ಎಲ್ಲರೂ ಈ ಭೂಮಿಯಲ್ಲಿ ಒಟ್ಟಿಗೇ ವಾಸಿಸುತ್ತಿದ್ದೇವೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715621/size7/5897005fd5fa65e1cc885a5c89bd137b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715621/size7/5897005fd5fa65e1cc885a5c89bd137b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-150164","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-150164","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":622,"opdsId":"urn:uuid:SW-149300","title":"ಮಾನವ ಶರೀರ","authors":["Jnana Murthy  B R"],"language":"","readingLevel":"","publisher":"","summary":"ಮನುಷ್ಯನ ದೇಹವು ಅದ್ಭುತ! ಚಿಕ್ಕ ಸ್ನಾಯುವಿನಿಂದ ದೊಡ್ಡ ಅಂಗದವರೆಗೆ- ನಮ್ಮ ದೇಹಗಳು ಹೇಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತವೆ ಎಂಬುದನ್ನು ನೋಡೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715624/size7/0dcd3ef638a6ecafa3be7866467e9335.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715624/size7/0dcd3ef638a6ecafa3be7866467e9335.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-149300","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-149300","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":623,"opdsId":"urn:uuid:SW-536452","title":"ನಾನು ಮುಡಿಯುವ ಹೂಗಳು","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಹೂಗಳು ಗಿಡ-ಮರ-ತೋಟಗಳಲ್ಲಿವೆ. ಅವು ಆಟೋ ರಿಕ್ಷಾಗಳಲ್ಲಿಯೂ ಇರಬಹುದು. ನನಗೆ ಇಷ್ಟವಾದ ಹೂ ಅನ್ನು ನಾನು ಕೂದಲಿಗೆ ಮುಡಿಯುತ್ತೇನೆ. ನಿಮ್ಮ ಇಷ್ಟದ ಹೂ ಯಾವುದು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/617205/size7/1d33b026b2f8d4ce5aebf979bc9f92ee.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/617205/size7/1d33b026b2f8d4ce5aebf979bc9f92ee.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-536452","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-536452","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":624,"opdsId":"urn:uuid:SW-104682","title":"ಒಂಟೆಯ ಬಯಸಿದ ಕೇಲಂ","authors":["Uma Rao Kolar"],"language":"","readingLevel":"","publisher":"","summary":"ಪಬುನ ಸೋದರ ಸೊಸೆ ಕೇಲಂ ತನ್ನ ಹುಟ್ಟುಹಬ್ಬಕ್ಕೆ ಒಂಟೆ ಬೇಕೆಂದು ಕೇಳಿದಳು. ಪಬು ಒಂಟೆಗಾಗಿ ರಾಜಸ್ತಾನದಿಂದ ಲಂಕಾದವರೆಗೆ ಪ್ರಯಾಣಿಸಿದ. \nಅವನ ಈ ಪ್ರಯಾಣ ಅವನನ್ನು ಎಲ್ಲಿಗೆ ಕರೆದುಕೊಂಡು ಹೋಗಿತು ನೋಡಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723694/size7/52318613cf20d8e64bec789d77e80602.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723694/size7/52318613cf20d8e64bec789d77e80602.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-104682","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-104682","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":625,"opdsId":"urn:uuid:SW-536116","title":"ಮ್ಯೂಸಿಯಂನಲ್ಲೊಂದು ದಿನ","authors":["Dr. Vasudeva Sharma N V Executive Director, CHILD RIGHTS TRUST"],"language":"","readingLevel":"","publisher":"","summary":"ನಳಿನಿಗೆ ಮೊದಲ ಬಾರಿಗೆ ತನ್ನ ಸ್ನೇಹಿತರೊಂದಿಗೆ ಮ್ಯೂಸಿಯಂಗೆ ಭೇಟಿಕೊಟ್ಟಿದ್ದು ಖುಷಿಯೋ ಖುಷಿ.  ಅಲ್ಲಿ ನೋಡಲು ಅದೆಷ್ಟೊಂದು ಅದ್ಭುತವಾದ ವಸ್ತುಗಳಿವೆ! ಮ್ಯೂಸಿಯಂನಲ್ಲಿ ಒಂದು ದಿನ ಸುತ್ತಾಡಿದ ಮೇಲೆ, ತನ್ನ ತಮ್ಮ ವೇದ್‌ಗಾಗಿ ನಳಿನಿ ಏನು ತೆಗೆದುಕೊಂಡು ಹೋದಳು ಎಂದು ಊಹಿಸಬಲ್ಲಿರಾ? ಅದನ್ನು ಕಂಡುಕೊಳ್ಳಲು ನೀವು ಈ ಪುಸ್ತಕ ಓದಲೇಬೇಕು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/636964/size7/7f38bcd48e6580d967d2c3252a05d617.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/636964/size7/7f38bcd48e6580d967d2c3252a05d617.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-536116","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-536116","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":626,"opdsId":"urn:uuid:SW-450310","title":"ಓ... ನನ್ನ ಬ್ಯಾಟ್ ಎಲ್ಲಿ?","authors":["Ishwar Daitota"],"language":"","readingLevel":"","publisher":"","summary":"ಆಗೊಮ್ಮೆ ಈಗೊಮ್ಮೆ ಮಕ್ಕಳು ತಮ್ಮಷ್ಟಕ್ಕೆ ಮಾತಾಡೋದು ಹಾಗು ಅನುಭವವೊಂದನ್ನು ವಿವರಿಸುವುದು ಕೇಳಿ ಬರುತ್ತದೆ. ಅವರು ವರ್ಣಿಸುವುದು ಎಷ್ಟು ವೈವಿಧ್ಯಪೂರ್ಣ! ನನ್ನ ಬ್ಯಾಟ್ ಎಲ್ಲಿದೆ ಎನ್ನುವುದು ಅಂತಹುದೊಂದು ಕುತೂಹಲಕಾರಿ ಘಟನೆಯಾಗಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722289/size7/c16c84713d1b61a71cddff825f43daca.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722289/size7/c16c84713d1b61a71cddff825f43daca.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-450310","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-450310","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":627,"opdsId":"urn:uuid:SW-15444","title":"ದಾಳಿಂಬೆಯ ರುಚಿ","authors":["Jayashree Deshpande"],"language":"","readingLevel":"","publisher":"","summary":"ಪೊಟ್ಟಣ, ಬಾಟಲಿಗಳಲ್ಲಿ ಸಿದ್ಧವಾಗಿ ಬರುವ ಹಣ್ಣಿನ ರಸ, ಜ್ಯಾಮ್‌ಗಳನ್ನು ತಿನ್ನುವ ಬಾಯಿಗೆ ತಾಜಾ ಹಣ್ಣಿನ ರುಚಿ\nಹೇಗಿರುತ್ತದೆ! ಅಜ್ಜನ ಹಣ್ಣಿನ ತೋಪಿನಲ್ಲಿ ನಗರ ಬಾಲಕ ರಾಜುವಿಗೆ ಜ್ಞಾನೋದಯವಾದ ಕಥೆ ದಾಳಿಂಬೆಯ ರುಚಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722303/size7/513f479b3bc14f0c0484983614f704c6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722303/size7/513f479b3bc14f0c0484983614f704c6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15444","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15444","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":628,"opdsId":"urn:uuid:SW-69592","title":"ಇಂಕುನ ಕಚಪಚ","authors":["T.S. Gopal"],"language":"","readingLevel":"","publisher":"","summary":"ಹಾರುವ, ತೆವಳುವ, ಕುಪ್ಪಳಿಸುವ - ಇಂತಹ ಯಾವುದೇ ಆಹಾರವೂ ಇಂಕುವಿಗೆ ಹೊಸದಲ್ಲ. ಕಾಡಿನ ಜೀವಿಗಳನ್ನು ನೋಡಲು ಹೊರಟಿರುವ ಇಂಕುಗೆ ನಾವೂ ಜತೆಯಾಗೋಣ ಬನ್ನಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725073/size7/69e9284a5c48d58e27d99ecef90b3803.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725073/size7/69e9284a5c48d58e27d99ecef90b3803.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-69592","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-69592","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":629,"opdsId":"urn:uuid:SW-108255","title":"ಕಾಮನಬಿಲ್ಲು ನದಿಯ ಕಥೆ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಕಾಮನಬಿಲ್ಲು  ಆಕಾಶದಲ್ಲಿ ಕಾಣಿಸುವಂತೆ ಆದದ್ದು ಹೇಗೆ  ಎಂದು ತಾಯಿಯೊಬ್ಬಳು ತನ್ನ ಮಕ್ಕಳಿಗೆ ಹೇಳಿದ ಕುತೂಹಲಕಾರಿ ಕಥೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/127048/size7/a6c6c2b2653bec6e88befd8bf6919b8e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/127048/size7/a6c6c2b2653bec6e88befd8bf6919b8e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-108255","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-108255","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":630,"opdsId":"urn:uuid:SW-44718","title":"ರೆಡಿ? ಎಸ್! ಪ್ಲೇ!","authors":["Tanuja Jakkannavar"],"language":"","readingLevel":"","publisher":"","summary":"ಅನುಗೆ ಕ್ರಿಕೆಟ್ ಅಂದ್ರೆ ತುಂಬ ಇಷ್ಟ. ಎಂದಾದರೊಂದು ದಿನ ತಾನೂ ಕ್ರಿಕೆಟ್ ಆಡುವೆನು ಎಂದು ಕನಸು ಕಾಣುತ್ತಿದ್ದಳು. ತನ್ನ ಮೊದಲ ಪಂದ್ಯದಲ್ಲೇ ಎಲ್ಲರನ್ನೂ ಹೇಗೆ ಬೆರಗಾಗಿಸಿದಳು ಗೊತ್ತಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/90216/size7/ca6f84ff90a7405fad9a030d14f0b808.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/90216/size7/ca6f84ff90a7405fad9a030d14f0b808.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-44718","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-44718","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":631,"opdsId":"urn:uuid:SW-639010","title":"ಅಂಜೂರ ಅಂಜೂರ ಯಾರ ಅಂಜೂರ","authors":["Deepa Bhasthi"],"language":"","readingLevel":"","publisher":"","summary":"ಚಂಪಿಗೆ ಹಣ್ಣುಗಳೆಂದರೆ ತುಂಬಾ ಇಷ್ಟ. ಅದರಲ್ಲೂ ಅಂಜೂರ ಹಣ್ಣೆಂದರೆ, ತುಂಬಾ ತುಂಬಾ ಇಷ್ಟ. ಆದರೆ, ಅಂಜೂರ ಅವಳೊಬ್ಬಳಿಗೆ ಮಾತ್ರ ಇಷ್ಟದ ಹಣ್ಣಲ್ಲ. ಬೇರೆ ಯಾರಿಗಿರಬಹುದು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723783/size7/797ace837d981fb250c79ca4b0b592dd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723783/size7/797ace837d981fb250c79ca4b0b592dd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-639010","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-639010","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":632,"opdsId":"urn:uuid:SW-219999","title":"ಭಯ","authors":["Manjunath B G"],"language":"","readingLevel":"","publisher":"","summary":"ರಾತ್ರಿ ಒಂದು ವಿಚಿತ್ರ ಶಬ್ಧ ಕೇಳಿ ರೀನಾ ಭಯ ಪಟ್ಟಳು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283176/size7/267a4edcb1e1158ff0d13a3cae4bd7d5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283176/size7/267a4edcb1e1158ff0d13a3cae4bd7d5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-219999","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-219999","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":633,"opdsId":"urn:uuid:SW-208777","title":"ಇಲಿ ಮತ್ತು ರೊಟ್ಟಿ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಇಲಿಗೆ ಒಂದು ರೊಟ್ಟಿ ಸಿಕ್ಕಿತು. ಅದು ರೊಟ್ಟಿಯನ್ನು ಮನೆಗೆ ತೆಗೆದುಕೊಂಡು ಹೋಗಲು ಬಯಸಿತು. ಅದರ ಬಯಕೆ ಈಡೇರಿತೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/335913/size7/cbc9859db830f4ccb48ff04472e45dae.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/335913/size7/cbc9859db830f4ccb48ff04472e45dae.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-208777","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-208777","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":634,"opdsId":"urn:uuid:SW-536139","title":"ಡಿಟೆಕ್ಟಿವ್ ದಮಯಂತಿ","authors":["G W Carlo"],"language":"","readingLevel":"","publisher":"","summary":"ಕುರುಕುಲು ತಿಂಡಿ ತಿನ್ನುವುದು ಬಿಟ್ಟರೆ ದಮಯಂತಿ ಇಷ್ಟಪಡುವ \nಮತ್ತೊಂದು ಕೆಲಸವೆಂದರೆ ಪತ್ತೇದಾರಿಕೆ. ಯಥಾಪ್ರಕಾರ ತನ್ನ ನೆಚ್ಚಿನ \nಒಂದರಲ್ಲೇ ಮೂರು ವಸ್ತುಗಳನ್ನು ತುಂಬಿಸಿಡುವ ಡಬ್ಬಿಯೊಂದಿಗೆ \nದಮಯಂತಿ ಮತ್ತೊಂದು ಕಳುವಿನ ಪ್ರಕರಣದ ಜಾಡು ಹಿಡಿದು \nಹೊರಟಿದ್ದಾಳೆ. ಅಪ್ಪನ ಕರವಸ್ತ್ರ, ಅಜ್ಜಿಯ ಹೇರ್‌ಪಿನ್, ಅಲ್ಲದೆ \nಅವಳದೇ ಎಡ ಕಾಲ್ಚೀಲ ಕಾಣೆಯಾಗಿವೆ. ಎಲ್ಲಿ ಹೋದವು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/636972/size7/02e24940bfa24362db34b37ac7474f26.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/636972/size7/02e24940bfa24362db34b37ac7474f26.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-536139","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-536139","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":635,"opdsId":"urn:uuid:SW-85564","title":"ಡರ್ ಬುರ್...","authors":["Utthaana Bharighat"],"language":"","readingLevel":"","publisher":"","summary":"ಗಬ್ಬುನಾತದ್ದೋ ಅಥವಾ ಸದ್ದು ಮಾಡುವ ಖಾಲಿ ಪೀಪಿಯೋ - ಅಂತೂ ಈ ಹೂಸು ನೀವು ಎಲ್ಲಿದ್ದರೂ ನಾನು ನಿಮ್ಮಲ್ಲೇ ಇರುವೆ ಎಂದು ಸಾರಿ ಬಿಡುವುದು. ಇದ್ದಕ್ಕಿದ್ದಂತೆ ಸಿಡಿದು ಗಲಿಬಿಲಿ ಮಾಡುವುದೋ ಅಥವಾ ಸದ್ದಿಲ್ಲದೇ ಜಾರಿ ಬಿಡುವುದೋ, ಒಟ್ಟಿನಲ್ಲಿ ಹಾಯೆನಿಸುವುದು! ಹೂಸುಗಳ ಬಗೆಗಿನ ಈ ಕತೆಯನ್ನು ನೀವೂ ಮೂಗು ಮುಚ್ಚಿಕೊಳ್ಳದೇ ಓದಿ ಮತ್ತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727097/size7/8a2cbd3cbde95b072abeee5d2417325d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727097/size7/8a2cbd3cbde95b072abeee5d2417325d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-85564","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-85564","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":636,"opdsId":"urn:uuid:SW-56313","title":"ಸರೂ ಮತ್ತು ಅವಳ ಪುಟ್ಟ ರಹಸ್ಯ","authors":["Mahesh NC"],"language":"","readingLevel":"","publisher":"","summary":"ಮಾಯಿ ಎಂದಿಗೂ ಅಶಿಸ್ತನ್ನು ಸಹಿಸಿಕೊಳ್ಳುವುದಿಲ್ಲ; ಆದರೆ ಸರೂಗೆ ಸದಾಕಾಲ ನೇರ ಹಾಗು ಶಿಸ್ತಿನ ದಾರಿಯಲ್ಲಿ ನಡೆಯಲು ಕಷ್ಟವಾಗುತ್ತದೆ. ಸರೂ ಆಗಿಂದ್ದಾಗ್ಗೆ ಮಾಯಿಯ ಕಣ್ಣಿಗೆ ಬಿದ್ದು ತೊಂದರೆಗೆ ಸಿಕ್ಕಿಕೊಳ್ಳುತ್ತಿರುತ್ತಾಳೆ. ಈ ಬಾರಿ ಸರೂ ಏನು ಮಾಡಿದಳು? ಮಾಯಿ ಅದನ್ನು ಪತ್ತೆ ಮಾಡಿದರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/96028/size7/84cc07db945e7775faa10c9e809beeca.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/96028/size7/84cc07db945e7775faa10c9e809beeca.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-56313","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-56313","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":637,"opdsId":"urn:uuid:SW-4104","title":"ಪೂರಿ ಉಬ್ಬುವುದೇಕೆ?","authors":["Jayashree Deshpande"],"language":"","readingLevel":"","publisher":"","summary":"ಮನೆಯಲ್ಲಿ ಅಮ್ಮ ಗುಂಡಾಗಿ ಕರಿದ ಪೂರಿ ತಿನ್ನುವುದೆಂದರೆ, ನಾಲಿಗೆಯಲ್ಲಿ ನೀರೂರುತ್ತದೆ. ಆದರೆ ಅವು ಉಬ್ಬುವುದಾದರೂ ಹೇಗೆ? ಇದರ ಹಿಂದಿರುವ ವಿಜ್ಞಾನ ತಿಳಿಯೋಣ ಬನ್ನಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712715/size7/ff6bc354d6dd3c347b5b06c130c85cd2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712715/size7/ff6bc354d6dd3c347b5b06c130c85cd2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-4104","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-4104","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":638,"opdsId":"urn:uuid:SW-105779","title":"ನನಗೆ ನಾನಿಷ್ಟ","authors":["Ramya Coushik"],"language":"","readingLevel":"","publisher":"","summary":"ರುಬಿನಾ ಹೊಸ ಮನೆಗೆ ಬಂದಿದ್ದಾಳೆ. ಅವಳಿಗೆ ಹೊಸ ಸ್ನೇಹಿತರು ಬೇಕು. ಆದರೆ ಯಾರೂ ಅವಳ ಜೊತೆಗೆ ಆಡುತ್ತಿಲ್ಲ. ರುಬಿನಾಗೆ ಹೊಸ ಸ್ನೇಹಿತರು ಸಿಗುತ್ತಾರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/214248/size7/924c337c1c01987477444de3b4a774a2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/214248/size7/924c337c1c01987477444de3b4a774a2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-105779","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-105779","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":639,"opdsId":"urn:uuid:SW-460585","title":"ಅಭಾಳ ಚಹಾ ಪಾರ್ಟಿ","authors":["Ajay Swaroop"],"language":"","readingLevel":"","publisher":"","summary":"ಅಭಾ ಡಾರ್ಜಿಲಿಂಗ್‌ನ ತಂಪಾದ ಬೆಟ್ಟಗಳಿಗೆ ಹೋಗುತ್ತಿದ್ದಾಳೆ. ದಾರಿಯಲ್ಲಿ ಅವಳು ಚಹಾ ಕಾರ್ಖಾನೆಯೊಂದಕ್ಕೆ ಭೇಟಿ ಕೊಡುತ್ತಾಳೆ. ಅವಳಲ್ಲಿ ಎಷ್ಟೊಂದು ಪ್ರಶ್ನೆಗಳು! ಚಹಾ ಒಂದು ಎಲೆಯೇ? ಬೆಳೆಯುತ್ತದೆಯೇ? ಅದು ಅಷ್ಟು ರುಚಿಕರವಾಗಿರುವುದು ಹೇಗೆ? ಚಹಾ ತೋಟ, ಕಾರ್ಖಾನೆಯಲ್ಲಿ ವಿಹರಿಸುತ್ತಾ ಅಭಾಳ ಪ್ರಶ್ನೆಗಳಿಗೆ ಅವಳೊಂದಿಗೇ ಉತ್ತರವನ್ನು ಕಂಡುಕೊಳ್ಳಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/422097/size7/b064c2ac77aba307892edb71ceb40ca9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/422097/size7/b064c2ac77aba307892edb71ceb40ca9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-460585","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-460585","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":640,"opdsId":"urn:uuid:SW-590210","title":"ಮಾಯಾಳ ನೆಚ್ಚಿನ ಆಟ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಮಾಯಾಗೆ ಅನಿಸತ್ತೆ, ತಾನು ಎಲ್ಲಿಯೂ ಹೊಂದಿಕೊಳ್ಳಲು ಸಾಧ್ಯವಿಲ್ಲ ಎಂದು. ಅವಳು ತನ್ನ ತರಗತಿಯಲ್ಲಿ ಹುಡುಗರು ಮತ್ತು ಹುಡುಗಿಯರೊಂದಿಗೆ ಹೊಂದಿಕೊಳ್ಳಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ.  ಕೊನೆಗೆ ಮಾಯಾ ತನ್ನನ್ನು ತಾನು ಹೇಗೆ ಗುರುತಿಸಿಕೊಂಡಳು? ನಮ್ಮನ್ನು ನಾವು ಪ್ರೀತಿಸಿಕೊಳ್ಳುವಂತೆ ಪ್ರೇರೇಪಿಸುವ ಪುಸ್ತಕ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716362/size7/8fcefdc21a57b30da3233cf571ec89f8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716362/size7/8fcefdc21a57b30da3233cf571ec89f8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-590210","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-590210","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":641,"opdsId":"urn:uuid:SW-223604","title":"ಹರೀಶ ಮತ್ತು ಜೋಜೋ","authors":["Shabana Begum"],"language":"","readingLevel":"","publisher":"","summary":"ಹರೀಶ ಜೋಜೋನನ್ನು ತನ್ನ ಜನ್ಮದಿನದಂದು ಪಾರ್ಟಿಗೆ ಕರೆಯಲು ಇಚ್ಚಿಸುತ್ತಿದ್ದನು. ಆದರೆ ಅಮ್ಮ ಒಪ್ಪುತ್ತಿರಲಿಲ್ಲ. ಜೋಜೋ ಪಾರ್ಟಿಗೆ ಬರುತ್ತಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/282983/size7/1b358d3cd24b587ff4058fe19e5afd63.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/282983/size7/1b358d3cd24b587ff4058fe19e5afd63.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-223604","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-223604","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":642,"opdsId":"urn:uuid:SW-152864","title":"ಅಗಣಿತ ತಾರಾ ಗಣಗಳ ನಡುವೆ","authors":["Vijaya Nag"],"language":"","readingLevel":"","publisher":"","summary":"ನಾವೆಲ್ಲರೂ ರಾತ್ರಿಯ ಆಕಾಶದಲ್ಲಿ ನಕ್ಷತ್ರಗಳನ್ನು ನೋಡಿದ್ದೇವೆ. ಆದರೆ, ಅವು ಎಲ್ಲಿಂದ ಬಂದಿರುವುದು ಎಂದು ನಿಮಗೆ ಗೊತ್ತೆ? ಬನ್ನಿ ತಿಳಿಯೋಣ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/206044/size7/33b4377e1af4dd7523295710c2d2f143.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/206044/size7/33b4377e1af4dd7523295710c2d2f143.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-152864","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-152864","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":643,"opdsId":"urn:uuid:SW-433010","title":"ಚಂದಮಾಮ ಎಲ್ಲಿ ಹೋದ?","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಚಂದಮಾಮ ಹಗಲಿನಲ್ಲಿ ಎಲ್ಲಿಗೆ ಹೋಗುತ್ತಾನೆ? ಬನ್ನಿ ಹುಡುಕೋಣ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727432/size7/3128da21a30b7187295cd4539b58927b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727432/size7/3128da21a30b7187295cd4539b58927b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-433010","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-433010","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":644,"opdsId":"urn:uuid:SW-14509","title":"ಬಿಜು ನೇಯ್ದ ಮಾಯಾಜಾಲ","authors":["Samhita Trust"],"language":"","readingLevel":"","publisher":"","summary":"ಬಿಜು ಮತ್ತು ಅವನ ಕುಟುಂಬದವರು ಒರಿಸ್ಸಾದ ಗ್ರಾಮೀಣ ಪ್ರದೇಶದಲ್ಲಿ ವಾಸಿಸುವ ನೇಕಾರರು. ಇವರು ನೇಯ್ದ ಸುಂದರವಾದ ವಸ್ತ್ರಗಳು ಭಾರತದಲ್ಲಿ ಮತ್ತು ವಿದೇಶಗಳಲ್ಲಿ ಮಾರಾಟವಾಗುತ್ತವೆ. ಸೀರೆಗಳನ್ನು ಮಾರಲು ಅಪ್ಪನೊಂದಿಗೆ ದೆಹಲಿಗೆ ಹೋಗಿ, \nತನ್ನ ಕೌಶಲದಿಂದ ನಗರದ ಹುಡುಗನ ಮೆಚ್ಚುಗೆ ಗಳಿಸಿದ ಬಿಜುವಿನ ಸಾಹಸಗಳನ್ನು ಈ ಕಥೆ ಬಣ್ಣಿಸುತ್ತದೆ. ಜಯಾ ಜೇಟ್ಲಿ ಅವರ \nಈ ಮೋಹಕ ಕಥೆ ಭ್ರಮರಾ ನಾಯಕ್ ಅವರ ಪಟಚಿತ್ರ ಪದ್ಧತಿಯ ಚಿತ್ರಗಳಿಂದ ಹೆಚ್ಚು ರಂಜನೀಯವಾಗಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/524535/size7/2d6162e002a3bf3ad6834ac1a6050a54.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524535/size7/2d6162e002a3bf3ad6834ac1a6050a54.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-14509","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-14509","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":645,"opdsId":"urn:uuid:SW-456140","title":"ನನ್ನ ಕೈ ತೋಟದಲ್ಲಿ","authors":["Vanishree Balu"],"language":"","readingLevel":"","publisher":"","summary":"ಈಗ ಗಿಡಗಳಿಗೆ ನೀರು ಹಾಕುವ ಸಮಯ. ನನ್ನ ಕೈ ತೋಟವು ಬಣ್ಣದಿಂದ ತುಂಬಿದೆ. ಹತ್ತಿರದಿಂದ ಗಮನಿಸಿದರೆ ಹಲವು ಸೂಕ್ಷ್ಮ ಆಕೃತಿಗಳಿವೆ. \nಈ ಪುಸ್ತಕವು ಹೊರಗಿನ ಪ್ರಪಂಚದ ಸಹಜ ಸಂತೋಷವನ್ನು ತಿಳಿಸುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/422060/size7/3b88730eae74abcad6043ed209a55e1f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/422060/size7/3b88730eae74abcad6043ed209a55e1f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-456140","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-456140","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":646,"opdsId":"urn:uuid:SW-562617","title":"ಗ್ರೇಸ್‌: ವೈಜ್ಞಾನಿಕ ಶಿಕ್ಷಣ ಎಲ್ಲರಿಗೂ ಸಿಗುವಂತಾಗಲು ಒಬ್ಬ ಎಂಜಿನಿಯರ್ ಹೋರಾಟ","authors":["Hema Hebbagodi"],"language":"","readingLevel":"","publisher":"","summary":"ಗ್ರೇಸ್‌ಗೆ ಹಲವಾರು ಪ್ರಶ್ನೆಗಳಿದ್ದವು: ಅವಳೇಕೆ ತರಗತಿಯಿಂದ ಹೊರಗೆ ಕೂರಬೇಕು? ಅವಳೇಕೆ ಲಂಗಕ್ಕೆ ಬದಲಾಗಿ ಪ್ಯಾಂಟ್‌ ಹಾಕಿಕೊಳ್ಳಬೇಕು? ಟ್ರಾನ್ಸ್‌ಜೆಂಡರ್‌ ವ್ಯಕ್ತಿಗಳು ಎಂಜನಿಯರಿಂಗ್‌ ಏಕೆ ಓದಬಾರದು? ವಿಜ್ಞಾನ ಮತ್ತು ತಂತ್ರಜ್ಞಾನ ಶಿಕ್ಷಣವು ವ್ಯಕ್ತಿಗಳ ಭಿನ್ನತೆಯನ್ನು ಏಕೆ ಒಪ್ಪಿಕೊಳ್ಳುವುದಿಲ್ಲ ಎಂದು ಅವಳಿಗೆ ಅಚ್ಚರಿಯಾಯಿತು. ಇದಕ್ಕೆ ಕೆಲವು ಉತ್ತರಗಳನ್ನು ಕೋರ್ಟಿನಲ್ಲಿ ಪಡೆಯಲು ನಿರ್ಧರಿಸಿದಳು. ಇದು ವಿಜ್ಞಾನ ಮತ್ತು ತಂತ್ರಜ್ಞಾನ ಶಿಕ್ಷಣವು ಎಲ್ಲರಿಗೂ ಸಿಗಬೇಕು ಎಂದು ಶ್ರಮಿಸುತ್ತಿರುವ ಗ್ರೇಸ್‌ ಬಾನುವಿನ ಕತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727661/size7/3c8694a938efd491878f737a36124812.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727661/size7/3c8694a938efd491878f737a36124812.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-562617","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-562617","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":647,"opdsId":"urn:uuid:SW-533","title":"ನೇರ ಅಥವಾ ಸುರುಳಿ ಸುತ್ತಿದ","authors":["Meera Tushar Punarvasu"],"language":"","readingLevel":"","publisher":"","summary":"ನಿಮಗೆ ನೇರವಾದ ಬಾಲಗಳಿಷ್ಟವೋ ಅಥವಾ ಸುರುಳಿ ಸುತ್ತಿದ ಡೊಂಕು ಬಾಲಗಳೋ? ಅದೇನೇ ಇರಲಿ, ಕೆಲವು ಪದಾರ್ಥಗಳು, ಅವು ಹೇಗೇ ಇರಲಿ, ನಮಗೆ ಇಷ್ಟವಾಗುತ್ತವೆ. ಅಲ್ಲವೇ…","coverUrl":"https://static.storyweaver.org.in/illustration_crops/704418/size7/cc5738c5a2cf51254f0caabdcd45f2cf.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/704418/size7/cc5738c5a2cf51254f0caabdcd45f2cf.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-533","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-533","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":648,"opdsId":"urn:uuid:SW-138921","title":"ಜುನುಕಾ ಮತ್ತು ಯಂತ್ರಾಸುರರು","authors":["Smitha sathyaprakash"],"language":"","readingLevel":"","publisher":"","summary":"ಭತ್ತ ಬೆಳೆಯುವುದೆಂದರೆ ಶ್ರಮದ ಕೆಲಸ. ಹಾಗಾಗಿ ಜುನುಕಾ ಒಬ್ಬಳಿಗೆ ಭತ್ತದ ಕೃಷಿ ಮಾಡುವುದು ಕಷ್ಟವಾಗಬಹುದು. ಹಾಗಾದರೆ ಅವಳಿಗೆ ಯಾರು ಸಹಾಯ ಮಾಡುತ್ತಾರೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/720834/size7/f88341d58d9a4b25d1f96cc0731b4d4a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/720834/size7/f88341d58d9a4b25d1f96cc0731b4d4a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-138921","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-138921","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":649,"opdsId":"urn:uuid:SW-144530","title":"ಕ್ಯುಮುಲೋ ಪುಟ್ಟಿಯ ತೇಲಿಸ ಬನ್ನಿ","authors":["G N Mohan"],"language":"","readingLevel":"","publisher":"","summary":"ಕ್ಯುಮುಲೋ ಪುಟ್ಟಿಗೆ ತೀರಾ ಮುಜುಗರವಾಗಿದೆ. ಅವಳ ಕಿವಿ ಬಿಸಿಯಾಗಿದೆ. ಕೆನ್ನೆ ಕೆಂಪೇರಿದೆ. ಅವಳು ಮತ್ತೆ ಎಂದಾದರೂ \nಆ ಮೋಡದ ಪಾರ್ಕಿಗೆ ಹೋಗಲು ಸಾಧ್ಯವೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/528967/size7/96bad57b2fbb00a91feedf5fe8a65090.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/528967/size7/96bad57b2fbb00a91feedf5fe8a65090.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-144530","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-144530","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":650,"opdsId":"urn:uuid:SW-527","title":"ಪುಟ್ಟ ರೈನೋನ ದಿಟ್ಟತನ","authors":["Meera Tushar Punarvasu"],"language":"","readingLevel":"","publisher":"","summary":"ಬ್ರಹ್ಮಪುತ್ರ ನದಿಯುದ್ದಕ್ಕೂ ಹರಡಿರುವ ರಮಣೀಯವಾದ ಕಾಜಿರಂಗ ರಾಷ್ಟ್ರೀಯ ಉದ್ಯಾನವನದ ಹುಲ್ಲುಗಾವಲು ಪ್ರದೇಶದಲ್ಲಿ, ರಿಂಗೋ ಅನ್ನುವ ಪುಟ್ಟ ಘೇಂಡಾಮೃಗ ತನ್ನ ತಂದೆ ತಾಯಿಗಳೊಂದಿಗೆ ವಾಸವಾಗಿರುತ್ತದೆ. ಅದಕ್ಕೋ ಬಹಳ ನಾಚಿಕೆ ಸ್ವಭಾವ. ಎಲ್ಲರೂ ಅದನ್ನು ನೋಡಿ ನಗುತ್ತಾರೆ. ಹೀಗಿರುವಾಗ ಅದು ಹೇಗೆ ಹೊಸ ಗೆಳೆಯರನ್ನು ಮಾಡಿಕೊಳ್ಳುತ್ತದೆ ಎನ್ನುವುದನ್ನು ತಿಳಿಯಲು ಈ ಕತೆ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/118082/size7/6ac7fbb2789daff871f9187db19a202c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/118082/size7/6ac7fbb2789daff871f9187db19a202c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-527","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-527","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":651,"opdsId":"urn:uuid:SW-15068","title":"ಟಾಕ್ ಟಾಕ್","authors":["Jayashree Deshpande"],"language":"","readingLevel":"","publisher":"","summary":"ಸೋನಾಪುರದ ತಿಂಡಿಪೋತ ರಾಜನ ಕೋಣೆಯಲ್ಲಿ ರಹಸ್ಯಮಯವಾದ ಶಬ್ದವು ಕೇಳಿ ಬರುತ್ತಿತ್ತು. ಹೀಗಾಗಿ ಅವನಿಗೆ ನಿದ್ದೆ ಮಾಡಲು ಆಗಲಿಲ್ಲ. ಆ ಶಬ್ದ ಏನಿರಬಹುದು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/706157/size7/93c759f49808e92b7f9cefb99d3989f4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/706157/size7/93c759f49808e92b7f9cefb99d3989f4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15068","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15068","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":652,"opdsId":"urn:uuid:SW-311107","title":"ಬಿ ಆರ್ ಅಂಬೇಡ್ಕರ್: ಪುಸ್ತಕದೊಳಗೊಂದು ಉಜ್ವಲ ಬದುಕು","authors":["Girish Jakapure"],"language":"","readingLevel":"","publisher":"","summary":"ಈ ಕತೆ ಬಿ ಆರ್ ಅಂಬೆಡ್ಕರ್ ಅವರ ಕುರಿತದ್ದು, ಅವರನ್ನು ಭಾರತದ ಸಂವಿಧಾನ ಶಿಲ್ಪಿ, ಸಂವಿಧಾನದ ಪಿತಾಮಹ ಎಂದು ಗುರುತಿಸಲಾಗುತ್ತದೆ. ಅಂಬೇಡ್ಕರ್ ಅವರನ್ನು ಪ್ರೀತಿಯಿಂದ ಬಾಬಾಸಾಹೇಬ ಎಂದು ಕರೆಯಲಾಗುತ್ತದೆ. ಬಾಬಾಸಾಹೇಬ ಅವರು ಬರೀ ದಾರ್ಶನಿಕ, ಅರ್ಥತಜ್ಞ, ಕ್ರಾಂತಿಕಾರಿ ಅಷ್ಟೇ ಆಗಿರಲಿಲ್ಲ, ಅವರೊಬ್ಬ ಸಂವೇದನಶೀಲ ಹಾಗೂ ಅವಿರತ ಓದುಗರಾಗಿದ್ದರು. ಈ ಕತೆ ಅವರ ಓದಿನ ಹಸಿವು, ಕಲಿಯುವ ಆಸಕ್ತಿ, ಅವರ ಬಾಳಪಯಣವನ್ನು ಹೇಗೆ ಉಜ್ವಲಗೊಳಿಸಿತು ಎಂಬುದರ ಕುರಿತದ್ದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727370/size7/dcf9772fbc6e7843e82e01cd5af44027.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727370/size7/dcf9772fbc6e7843e82e01cd5af44027.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-311107","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-311107","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":653,"opdsId":"urn:uuid:SW-40320","title":"ಮಾಯಾ ದುರ್ಬೀನು","authors":["Girish N. R."],"language":"VR","readingLevel":"","publisher":"","summary":"ಮನೀಷಾ ಮತ್ತು ತೇಜಸ್ ಬಳಿ ಮಾಯಾ ದುರ್ಬೀನಿದೆ. ಅವರು ಅದರಿಂದ ಪ್ರಪಂಚದ ಬೇರೆ ಬೇರೆ ಪ್ರದೇಶದಲ್ಲಿರುವ ಏಳು ಪ್ರಾಣಿಗಳನ್ನು ನೋಡುತ್ತಿದ್ದಾರೆ. ಬನ್ನಿ, ನಾವೂ ಜತೆಯಾಗೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726794/size7/cff02b8fce687b1661207ff8aaf460c1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726794/size7/cff02b8fce687b1661207ff8aaf460c1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-40320","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-40320","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":654,"opdsId":"urn:uuid:SW-214426","title":"ಪಾರಿವಾಳ","authors":["Manjunath B G"],"language":"","readingLevel":"","publisher":"","summary":"ಸೀಮಾ ಒಂದು ಪಾರಿವಾಳವಾಗಿ ಮನೆಯ ಮಹಡಿ ಮೇಲೆ ಹೊರಟು ಹೋಗಿದ್ದಾಳೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283183/size7/7c2a7ee67c9377da91824daa02331baf.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283183/size7/7c2a7ee67c9377da91824daa02331baf.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-214426","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-214426","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":655,"opdsId":"urn:uuid:SW-455368","title":"ತಿನ್ನು, ನುಂಗು... ತೇಗು!","authors":["Surya Kiran"],"language":"","readingLevel":"","publisher":"","summary":"ತಿಮಿಂಗಿಲಗಳು ತಮ್ಮ ಆಹಾರವನ್ನು ಇಡಿಯಾಗಿ ನುಂಗುತ್ತವೆ, ಜೇನುನೊಣಕ್ಕೆ ಎರಡು ಹೊಟ್ಟೆಗಳಿವೆ ಹಾಗೂ ಹಸುಗಳು ನಿಧಾನವಾಗಿ ಜಗಿಯಲೆಂದು ಆಹಾರವನ್ನು ಹೊಟ್ಟೆಯೊಳಗೆ ಸಂಗ್ರಹಿಸಿ ಇಟ್ಟುಕೊಳ್ಳುತ್ತವೆ. ಇದು ಪ್ರಾಣಿಗಳು ಬೇರೆ ಬೇರೆ ರೀತಿಯಾಗಿ ಆಹಾರ ಸೇವಿಸುವ, ಜೀರ್ಣಿಸಿಕೊಳ್ಳುವ ಕುರಿತ ಮಾಹಿತಿಯುಳ್ಳ ಪುಸ್ತಕ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727376/size7/3d4f684cfee22f2af3e72cdcbff79b42.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727376/size7/3d4f684cfee22f2af3e72cdcbff79b42.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-455368","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-455368","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":656,"opdsId":"urn:uuid:SW-473138","title":"ನಮ್ ಸ್ಕೂಲಲ್ಲೂ ಲೈಬ್ರರಿ","authors":["Roopa As"],"language":"","readingLevel":"reading","publisher":"","summary":"ಸೀಮಾಳ ಸ್ಕೂಲಲ್ಲಿ ಅಂತೂ ಲೈಬ್ರರಿ ಆಗುತ್ತಿದೆ. ಆದರೆ, ಅವರಿಗೆ ಪುಸ್ತಕ ಕೊಳ್ಳಲು ಇನ್ನೂ 40% ಹಣ ಬೇಕಿದೆ. ಶೇಕಡಾವಾರು ಲೆಕ್ಕವನ್ನು ಕಲಿಯುತ್ತಾ, ಹಣವನ್ನು ಒಟ್ಟುಗೂಡಿಸುವ ಸೀಮಾ ಮತ್ತವಳ ಸಹಪಾಠಿಗಳಿಗೆ ನೀವೂ ಜೊತೆಯಾಗುವಿರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/477119/size7/b5f16f790828a276d28d4466adb320f3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/477119/size7/b5f16f790828a276d28d4466adb320f3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-473138","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-473138","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":657,"opdsId":"urn:uuid:SW-508216","title":"ನನಗೆ ಸಮುದ್ರ ಕಾಣಿಸುತ್ತಿದೆ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಚಿಕು ಬಣ್ಣ ಚೆಲ್ಲಿದಾಗ, ಸೋನುಗೆ ಅದು ಗಲೀಜಾಗಿ ಕಾಣಿಸುವುದಿಲ್ಲ. ಬದಲಾಗಿ; ತಿಮಿಂಗಿಲ, ಜೆಲ್ಲಿಮೀನು ಸೇರಿದಂತೆ ಸಮುದ್ರವೇ ಕಾಣಿಸುತ್ತದೆ. ಆಕಸ್ಮಿಕವಾಗಿ ಚೆಲ್ಲಿದ ಬಣ್ಣದಲ್ಲಿ, ಮಣ್ಣಿನಾಟದಲ್ಲಿ ಮುಳುಗಿದ್ದಾಗ ಮಕ್ಕಳ ಕಲ್ಪನೆಗಳು ಗರಿಗೆದರುತ್ತವೆ. ಇದರಿಂದ ಪೂರ್ತಿಯಾಗಿ ಹೊಸ ಪ್ರಪಂಚ ಸೃಷ್ಟಿಯಾಗುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/582053/size7/e8ae871d00b28e2942870e1e35ee69b4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/582053/size7/e8ae871d00b28e2942870e1e35ee69b4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-508216","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-508216","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":658,"opdsId":"urn:uuid:SW-96413","title":"ಮಜಾ ಗಣಿತ: ಕಾಲ ಮತ್ತು ಹಣ","authors":["K.P. Bhatt"],"language":"","readingLevel":"","publisher":"","summary":"ಇದೊಂದು ಹೊಸ ಬಗೆಯ ಗಣಿತ ಪುಸ್ತಕ. ಇದರಲ್ಲಿ ಸಮಸ್ಯೆಗಳಿಗಿಂತ ಕಥೆಗಳೇ ಹೆಚ್ಚಾಗಿವೆ! ಕಥೆಗಳನ್ನು ಓದಿ, ಕಲ್ಪನೆ ಮತ್ತು ವಾಸ್ತವಗಳ ಮಿಶ್ರಣವನ್ನು ಸ್ವೀಕರಿಸಿ ಜೊತೆಗೆ ನಿಮ್ಮ ಮೆದುಳಿಗೊಂದು ಸವಾಲು ಹಾಕಿ ಸಂತೋಷಪಡಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703454/size7/4635f366876fd787fef4f3c04925cec3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703454/size7/4635f366876fd787fef4f3c04925cec3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-96413","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-96413","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":659,"opdsId":"urn:uuid:SW-14793","title":"ಒಂದು ಬೇಸಿಗೆಯ ನಡುಹಗಲು","authors":["Meera Tushar Punarvasu"],"language":"","readingLevel":"","publisher":"","summary":"ಹಳ್ಳಿಯ ಮಕ್ಕಳು ಬೇರೆ ಬೇರೆ ಜೀವಿಗಳ ಜೊತೆ ಜೊತೆಗೇ ಬೆಳೆಯುತ್ತಾರೆ. ಅಂತಹ ಒಂದು ಸನ್ನಿವೇಶದಲ್ಲಿ, ಅವರು ಹೇಗೆ ಜೀವನದ ಪಾಠಗಳನ್ನು ಕಲಿಯುತ್ತಾರೆ ಎಂಬುದನ್ನು ಅರಿಯಲು ಈ ಹೃದಯಸ್ಪರ್ಶಿ ಕಥೆಯನ್ನು ಓದಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722857/size7/6fb60231ce2aa30ab7722953f3d0c925.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722857/size7/6fb60231ce2aa30ab7722953f3d0c925.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-14793","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-14793","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":660,"opdsId":"urn:uuid:SW-138957","title":"ಚಡ್ಡಿರಾಜನ ಸಾಹಸಗಳು","authors":["Pallavi Rao"],"language":"","readingLevel":"","publisher":"","summary":"ಚಡ್ಡಿರಾಜ ಜುನೈದ್, ಜಗತ್ತಿನ ಅತ್ಯುತ್ತಮ ಸೂಪರ್ ಹೀರೋ! ಇದೋ ಹೊರಟಿದ್ದಾನೆ ಸರಿಯಾದ ಒಬ್ಬ ಬಂಟನನ್ನು ಹುಡುಕಾಡುವ ಸಾಹಸಕ್ಕೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727187/size7/3f8eb125d159ff91718c5e2e27483e37.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727187/size7/3f8eb125d159ff91718c5e2e27483e37.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-138957","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-138957","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":661,"opdsId":"urn:uuid:SW-223539","title":"ಬೆಕ್ಕಿನಮರಿ","authors":["Shabana Begum"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂದು ಬೆಕ್ಕಿನಮರಿಯ ಕಾಲಿಗೆ ಏಟಾಗಿದೆ. ಯಾರಾದರೂ ಅದರ ಸಹಾಯ ಮಾಡುತ್ತಾರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283164/size7/b9809682af44499c09b4e93c69d6e8e6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283164/size7/b9809682af44499c09b4e93c69d6e8e6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-223539","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-223539","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":662,"opdsId":"urn:uuid:SW-726","title":"ನೌಕಾಯಾನ","authors":["Divaspathy Hegde"],"language":"","readingLevel":"","publisher":"","summary":"ತುಂಟ, ಸ್ವಾಮಿ ಸೋದರ ಸಂಬಂಧಿಗಳು. ಬಡಾಯಿ ಸ್ವಭಾವದ ತುಂಟ ಈಜು ಬಾರದ ಸ್ವಾಮಿಯನ್ನು ನೌಕಾಯಾನದ ಸಾಹಸಕ್ಕೆ ಒಪ್ಪಿಸುತ್ತಾನೆ. ಹಂಸವನ್ನು ಮುಟ್ಟಲು ಹೋದ ಸ್ವಾಮಿ ನೀರಿಗೆ ಬಿದ್ದು ಬದುಕಿ ಬಂದ ಸಾಹಸದ ಕಥೆಯೇ ನೌಕಾಯಾನ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/702015/size7/1445bec6f17f2ec069dd00d0fe5878d0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/702015/size7/1445bec6f17f2ec069dd00d0fe5878d0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-726","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-726","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":663,"opdsId":"urn:uuid:SW-579236","title":"ಗಾಲಿಯ ಫಜೀತಿ","authors":["Dr Akshata Shanbhag"],"language":"","readingLevel":"","publisher":"","summary":"ಕಾರಿನ ಕೆಳಗೆ ಬಿಸಿಯಾದ ಅಥವಾ ಅಂಕು-ಡೊಂಕಿನ ರಸ್ತೆಗಳಲ್ಲಿ ಉರುಳುವುದು ಗಾಲಿಗೆ ಇಷ್ಟವಿಲ್ಲ. ಅದು ಕಾರನ್ನು ಬಿಟ್ಟು ಹೊಸ ಗಾಡಿಯನ್ನು ಹುಡುಕಲು ಹೊರಡುತ್ತದೆ. ಟ್ರಕ್ ತುಂಬಾ ಭಾರವಾಗಿದೆ. ಸೈಕಲ್ಲಿಗೆ ಅದರ ಅಳತೆ ಸರಿ ಹೊಂದುವುದಿಲ್ಲ. ಮುಂದೆ ಹೋದಂತೆ, ಸ್ನೇಹಿತನನ್ನು ಹುಡುಕುತ್ತಿರುವ ಒಬ್ಬ ಹುಡುಗನನ್ನು ಭೇಟಿಯಾಗುತ್ತದೆ ಗಾಲಿ. ಅದರಿಂದ ಹುಡುಗನಿಗೆ ಸಹಾಯ ಆಗುತ್ತದೆಯೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/371263/size7/ee9db84d7d1150b1c86336f3dc04360f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/371263/size7/ee9db84d7d1150b1c86336f3dc04360f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-579236","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-579236","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":664,"opdsId":"urn:uuid:SW-45951","title":"ನಿನ್ನ ಹೆಸರೇನು?","authors":["Janhavi Lakshminarayanan"],"language":"","readingLevel":"","publisher":"","summary":"ಚಿಕ್ಕ ಹುಡುಗ ಕಿಯಾನ್ ನನ್ನು ಭೇಟಿ ಮಾಡಿ. ಅವನಿಗಿರುವ ಮುದ್ದು ಮುದ್ದು ಹೆಸರಗಳನು ತಿಳಿದುಕೊಳ್ಳಿ ಮತ್ತು ನಿಮಗೆ ಎಷ್ಟು ಮುದ್ದು ಮುದ್ದು ಹೆಸರುಗಳಿವೆ ತಿಳಿದುಕೊಳ್ಳಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726928/size7/815cf8afb91e1f8a9498b5d686687805.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726928/size7/815cf8afb91e1f8a9498b5d686687805.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-45951","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-45951","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":665,"opdsId":"urn:uuid:SW-36615","title":"ಚಾಲಕನಿಲ್ಲದ ಕಾರು... ಇದು ಕಥೆ ಕೇಳುವ ಸಮಯ!","authors":["Sunanda Patil"],"language":"","readingLevel":"","publisher":"","summary":"ಇದು ಕಥೆ ಕೇಳುವ ಸಮಯ! ಬೇಸಿಗೆ ರಜೆಯಲ್ಲಿ ಅಜ್ಜಿ ಬಂದಿದ್ದಾರೆ. ಅವರ ಹತ್ತಿರ ಕಥೆ ಕೇಳುವುದಕ್ಕಾಗಿ ಹೆಚ್ಚಿನ ಸಮಯ ಮೀಸಲಿಡುತ್ತಿದ್ದಾಳೆ ಸುವಿ. ಅಜ್ಜಿ ಪುಷ್ಪಕ ವಿಮಾನ ಕಥೆ ಹೇಳಲು ಶುರು ಮಾಡಿದಾಗ, ಇದು ಸ್ಥಳದ ಹೆಸರು ಹೇಳಿದರೆ ಸಾಕು ಸುರಕ್ಷಿತವಾಗಿ ತಲುಪುವ ಚಾಲಕನಿಲ್ಲದ ಕಾರಿನಂತೆ ಎಂದು ಸುವಿ ಅಚ್ಚರಿ ಪಟ್ಟಳು. ಅಜ್ಜಿ ಮತ್ತು ಮೊಮ್ಮಗಳ ಈ ಆಕರ್ಷಕ ಕಥಾ ಪಯಣದಲ್ಲಿ ನೀವೂ ಒಂದು ಸುತ್ತು ಹಾಕಿ ಬನ್ನಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717239/size7/5e819e64be3f8479367fb429bdb9cff8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717239/size7/5e819e64be3f8479367fb429bdb9cff8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-36615","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-36615","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":666,"opdsId":"urn:uuid:SW-120585","title":"ಚಿರತೆಯ ಉಪಾಯ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ರಾಜ ಚಿರತೆಯ ಸಾವಿನ ನಂತರ ಪ್ರಾಣಿಗಳ ರಾಜ ಯಾರಾಗಬೇಕು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/93399/size7/2d07dbe8bc9dfda0aba26e81200c4a90.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/93399/size7/2d07dbe8bc9dfda0aba26e81200c4a90.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-120585","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-120585","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":667,"opdsId":"urn:uuid:SW-99619","title":"ಕ್ರೀಡಾ ದಿನ","authors":["Swati Pandit"],"language":"","readingLevel":"","publisher":"","summary":"ಶೂ ಲೇಸ್ ಬಿಗಿಯಾಗಿ ಕಟ್ಟಿ, ಹಾಗೆ ಚೂರು ನೀರು ಕುಡಿದು ಕ್ರೀಡಾ ದಿನಕ್ಕೆ ತಯಾರಾಗಿ. ಸಂತೋಷ, ಬೇಸರ, ಖುಷಿಯ ನಡುಕ, ಉತ್ಸಾಹ, ಕೆವಿ ಶಾಲೆಯ ಮಕ್ಕಳಲ್ಲಿ ಉತ್ಸಾಹವೋ ಉತ್ಸಾಹ. ನೀವೂ ಬರುವಿರಾ ಆಟಗಾರರನ್ನು ಹುರಿದುಂಬಿಸಲು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495676/size7/969538e582d44ed3863f7c2fe495445a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495676/size7/969538e582d44ed3863f7c2fe495445a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-99619","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-99619","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":668,"opdsId":"urn:uuid:SW-15080","title":"ಅಕ್ಕಾ, ಅಕ್ಕಾ,  ಗುಡುಗುಡು ಸದ್ದು  ಬರುವುದೆಲ್ಲಿಂದ ಎದ್ದು?","authors":["Vasantha Kalbagal"],"language":"","readingLevel":"","publisher":"","summary":"ಪುಟ್ಟ ತಮ್ಮನ ಅನ್ವೇಷಕ ತಲೆಯಲ್ಲಿ ಯಾವತ್ತೂ ಅಕ್ಕನನ್ನು ಕೇಳಬೇಕಾದ ಅನೇಕ ಪ್ರಶ್ನೆಗಳು\nತುಂಬಿರುತ್ತವೆ. ಅಕ್ಕನಿಗೆ ಉತ್ತರಗಳೆಲ್ಲವೂ ಗೊತ್ತು ಎಂದೂ ಆತನಿಗೆ ಅರಿವಿದೆ. ಯಾಕೆಂದರೆ ಆಕೆ \nಯಾವತ್ತೂ ದಪ್ಪದಪ್ಪ ಪುಸ್ತಕಗಳನ್ನು ಓದುತ್ತಿರುತ್ತಾಳಲ್ಲಾ.\nಈ ಪುಸ್ತಕದಲ್ಲಿ ಪುಟ್ಟ ತಮ್ಮನಿಗೆ ಗುಡುಗು ಎಲ್ಲಿಂದ ಬರುತ್ತದೆಂದು ಆಶ್ಚರ್ಯವಾಗುತ್ತದೆ.\nಆಕಾಶದಲ್ಲಿರುವ ಕೋಪೋದ್ರಿಕ್ತ ರಾಕ್ಷಸನ ಆರ್ಭಟ ಸ್ವರ್ಗವೇ ಛಿದ್ರವಾಗುವಂತೆ \nನಡುಗಿಸುತ್ತಿದೆಯೇ ಅಥವಾ ಯಾವುದಾದರೂ ಪಡ್ಡೆ ಹುಡುಗರ ಮೋಟಾರ್ ಬೈಕ್ \nಮೋಡಗಳೆಡೆಯಲ್ಲಿ ಈ ಗುಡುಗುಡು ಮಾಡುತ್ತಿದೆಯೇ?\nಖಂಡಿತಾ, ಅಕ್ಕನಿಗೆ ಸರಿಯಾದ ಉತ್ತರ ಗೊತ್ತಿರುತ್ತದೆ. ಆದರೆ, ಈ ಪುಸ್ತಕ ಓದಲು \nಪ್ರಾರಂಭಿಸುವ ಮುನ್ನ ಗುಡುಗು ಶಬ್ಧ ಎಲ್ಲಿಂದ ಬರುತ್ತದೆಂದು ನೀವು ಹೇಳಬಲ್ಲಿರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722406/size7/9d3e085a533c4c69c41f353bbdbd072d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722406/size7/9d3e085a533c4c69c41f353bbdbd072d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15080","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15080","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":669,"opdsId":"urn:uuid:SW-137570","title":"ತರಲೆಯ ಜತೆ ತರಲೆ","authors":["Pallavi Rao"],"language":"","readingLevel":"","publisher":"","summary":"ತರಲೆ ಕಾಣೆಯಾಗಿದೆ! ಯಾರು ಈ ತರಲೆ? ಅದು ನೀವೆಂದೂ ಭೇಟಿಯಾಗದ ಒಂದು ತುಂಟ ನಾಯಿ. ಅಭಿಗೆ ಅವಳನ್ನು ಹುಡುಕಲು ನೆರವಾಗುತ್ತೀರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/170569/size7/e49effc708bc0713d9aa149563081c24.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/170569/size7/e49effc708bc0713d9aa149563081c24.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-137570","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-137570","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":670,"opdsId":"urn:uuid:SW-313706","title":"ಪ್ರಾಣಿಗಳನ್ನು ಪ್ರೀತಿಸಲು ಕಲಿಸಿದ ನಾಯಿ","authors":["Dr N Rathna"],"language":"","readingLevel":"","publisher":"","summary":"ಪಮ್ಮಿ ಮನೆಯಲ್ಲಿ ಪಮ್ಮಿಯನ್ನು ಬಿಟ್ಟು ಮಿಕ್ಕ ಎಲ್ಲರಿಗೂ ಪ್ರಾಣಿಗಳ ಮೇಲೆ ತುಂಬಾ ಪ್ರೀತಿ ಇತ್ತು. ಆದರೆ ಅವಳಿಗೆ ಮಾತ್ರ ಇಲ್ಲ. ಕಡೆಗೊಂದು ದಿನ ಅವಳಿಗೆ ಸಿಕ್ಕ ನಾಯಿ ಅವಳ ಮನಸ್ಸನ್ನೇ ಬದಲಿಸಿ ಬಿಟ್ಟಿತು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/424765/size7/32720a7c033a36e35c950f6f3d9fab76.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/424765/size7/32720a7c033a36e35c950f6f3d9fab76.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-313706","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-313706","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":671,"opdsId":"urn:uuid:SW-443564","title":"ಪುಟ್ಟ ಸಸಿ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ನಿಮ್ಮ ಸುತ್ತಲಿನ ಸಸ್ಯಗಳನ್ನು ಹತ್ತಿರದಿಂದ ನೋಡಿ. ಅವುಗಳಲ್ಲಿ ನೋಡಲು ತುಂಬಾ ಇದೆ. ಅಲ್ಲಿ ನೀವು ಹಲವಾರು ಜೀವಿಗಳನ್ನು ಭೇಟಿಯಾಗಿ, ಹೊಸದನ್ನು ಕಲಿಯಬಹುದು!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715981/size7/10130d05074d4687484c87f23e820b1b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715981/size7/10130d05074d4687484c87f23e820b1b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-443564","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-443564","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":672,"opdsId":"urn:uuid:SW-39006","title":"ಟೊಮೆಟೊ ಚಟ್ನಿ ಮಾಡಿದವರಾರು?","authors":["Sarita Sharan"],"language":"","readingLevel":"","publisher":"","summary":"ತಾರಾ ಮತ್ತು ರವಿ ಹಣ್ಣು ಮತ್ತು ತರಕಾರಿಗಳನ್ನು ಖರೀದಿಸಲು ಮಾರುಕಟ್ಟೆಗೆ ಹೋಗುತ್ತಾರೆ. ಆದರೆ, ಪ್ರತಿಸಲವೂ ಒಂದು ಹಣ್ಣು ಹಾಳಾಗುತ್ತಿರುತ್ತದೆ. ಮುಂದಿನ ಸಲ ರೀತಿ ಆಗದಂತೆ ಅವರು ಪಾಠ ಕಲಿತಿದ್ದು ಹೇಗೆ? ಕತೆಯ ಮೂಲಕ ಭಾರದ ಮತ್ತು ಹಗುರವಾದ ವಸ್ತುಗಳನ್ನು ಜೋಡಿಸುವುದು ಹೇಗೆ ಎಂಬುದನ್ನು ತಿಳಿಯಿರಿ. ಕಥೆ ಓದುವ ಮೂಲಕ ನೀವೂ ಕೂಡ ಮಾರುಕಟ್ಟೆಗೆ ಹೋದಾಗ ಯಾವ ಯಾವ ತರಕಾರಿ ಗಳನ್ನು ಚೀಲದಲ್ಲಿ ತಳದಲ್ಲಿ ಹಾಕಬಹುದು ಎಂಬುದನ್ನು ಗಮನಿಸಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717010/size7/0bef1395055c740659b27b823aeea0ac.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717010/size7/0bef1395055c740659b27b823aeea0ac.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-39006","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-39006","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":673,"opdsId":"urn:uuid:SW-513274","title":"ಬಾರೋ ವಸಂತ","authors":["O L Nagabhushana  Swamy"],"language":"","readingLevel":"","publisher":"","summary":"ಗಜಲ್‍ಗೆ ಚಳಿಗಾಲ ಇಷ್ಟ. ಕಾಶ್ಮೀರ ಕಣಿವೆಗೆ ವಸಂತ ಬಂದಾಗ ಬಣ್ಣ, ಹಾಡು, ಬಿಸಿಲೂ ಜೊತೆಗೆ ಬರುತ್ತವೆ. ಚೈತ್ರದ ಸಂಭ್ರಮ-ಉಲ್ಲಾಸದ ಇನ್ನೊಂದು ರೂಪವೇ ಇಲ್ಲಿನ ವಸಂತ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721921/size7/4f8f17d6ed73bc153b8a937a69af15cb.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721921/size7/4f8f17d6ed73bc153b8a937a69af15cb.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-513274","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-513274","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":674,"opdsId":"urn:uuid:SW-592986","title":"ಭೂಮಿಯ ಬಣ್ಣಗಳು","authors":["Dr Akshata Shanbhag"],"language":"","readingLevel":"","publisher":"","summary":"ಅವಿ ಇಂದು ಅನ್ವೇಷಕ, ಮೋಡ ವೀಕ್ಷಕ, ಕಾಳುಗಳ ವಿಂಗಡಣೆ ಮತ್ತು ನೀರಿನ ಹೊಂಡದಲ್ಲಿ ಕಾಲಿಡುವವ. ಈ ಪುಸ್ತಕದಲ್ಲಿನ ಮಾದರಿಗಳನ್ನು ನೋಡಲು ಮತ್ತು ಗುರುತಿಸಲು ಅವಿಯ ನೆಚ್ಚಿನ ಸ್ಥಳ - ಭೂಮಿಗೆ ಪ್ರಯಾಣಿಸಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/455342/size7/109881e28a7c44f982a84f1d16ab31d2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/455342/size7/109881e28a7c44f982a84f1d16ab31d2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-592986","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-592986","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":675,"opdsId":"urn:uuid:SW-61658","title":"ಬಿಂತಿಗೆ ಗೊತ್ತಿಲ್ಲವೇ?","authors":["Swati Pandit"],"language":"","readingLevel":"","publisher":"","summary":"ನಿನ್ನಿಂದ ಆಗಲ್ಲ ಎಂದು ನೀವು ಹೇಳಬಹುದಷ್ಟೇ.  ಅದೇನೇ ಕೆಲಸವಾದರೂ ನಾನು ಮಾಡುತೀನಿ ಅನ್ನುವ ಚಾಲಾಕಿ ಬಿಂತಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/121015/size7/e7f943a7bba87bbde3adea8376a9e15a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/121015/size7/e7f943a7bba87bbde3adea8376a9e15a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-61658","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-61658","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":676,"opdsId":"urn:uuid:SW-456281","title":"ಪ್ರಾಣಿಗಳ ಪಿಕ್‌ನಿಕ್‌","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಐವರು ಗೆಳೆಯರು ಪಿಕ್‌ನಿಕ್‌ಗೆ ಹೋದರೆ ತುಂಬಾ ಖುಷಿಯಾಗುತ್ತದೆ. ಅದರ ಜೊತೆಗೆ ರುಚಿ ರುಚಿಯಾದ ಆಹಾರ ಇದ್ರೆ ಪಿಕ್‌ನಿಕ್‌ ಇನ್ನೂ ಮಜವಾಗಿರುತ್ತದೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721729/size7/5342c4c88d17f024b62f9c5f7701fd3f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721729/size7/5342c4c88d17f024b62f9c5f7701fd3f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-456281","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-456281","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":677,"opdsId":"urn:uuid:SW-455636","title":"ಮೇಕೆ ಯಾರಿಗೆ?","authors":["Indira Bs"],"language":"","readingLevel":"","publisher":"","summary":"ಚಿನ್ನಶೂರ ಮತ್ತು ಚಿಕ್ಕಶೂರರಿಗೆ ಒಮ್ಮೆಲೇ ಒಂದು ಮೇಕೆ ಕಂಡಿತು. ಇಬ್ಬರಿಗೂ ಆ ಮೇಕೆಯ ಮೇಲೇ ಕಣ್ಣು. ಈ ಸಮಸ್ಯೆಯನ್ನು ಬಗೆಹರಿಸಲು ಇದ್ದ ಒಂದೇ ದಾರಿ; ಮಜ್ಜಿಗೆ ಕುಡಿಯುವ ಸ್ಪರ್ಧೆ. ಶೂರರಿಬ್ಬರು ಮಜ್ಜಿಗೆ ಕುಡಿಯುವಾಗ ಭಿನ್ನರಾಶಿ ಮತ್ತು ದಶಮಾಂಶಗಳನ್ನು ಕಲಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/477081/size7/dc85ca43c5000a1f7a9917528c6ca133.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/477081/size7/dc85ca43c5000a1f7a9917528c6ca133.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-455636","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-455636","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":678,"opdsId":"urn:uuid:SW-578280","title":"ಅಜ್ಜಿಯ ಬಾಳೆಹಣ್ಣುಗಳು","authors":["Bhat Ananthesha"],"language":"","readingLevel":"level 4","publisher":"","summary":"ಅಜ್ಜಿ ಎಲ್ಲಾ ಬಾಳೆಹಣ್ಣುಗಳನ್ನು ಎಲ್ಲಿ ಸಂಗ್ರಹಿಸುತ್ತಾರೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/232592/size7/0509b591283caaab07d51d91ecbff65a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/232592/size7/0509b591283caaab07d51d91ecbff65a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-578280","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-578280","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":679,"opdsId":"urn:uuid:SW-59998","title":"ಬೂಟಲ್ಲೊಂದು ಬೆಣಚುಕಲ್ಲು!","authors":["Smitha sathyaprakash"],"language":"","readingLevel":"","publisher":"","summary":"ರೋನು ಬೂಟಲ್ಲೊಂದು ಬೆಣಚುಕಲ್ಲು ಹೇಗೆ ಬಂತು? ಆಕಾಶದಿಂದ ಡುಮ್ಮ ಹೊಟ್ಟೆಯ ಗುಮ್ಮ ಏನಾದರೂ ಎಸೆದನೇ? ಸಮುದ್ರ ರಾಕ್ಷಸ ದವಡೆಯಲ್ಲಿಟ್ಟುಕೊಂಡು ಬಂದನಾ? ರೋನುಗೆ ತಿಳಿಯುವುದು ಹೇಗೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/121481/size7/c893d6b00cb5ea4c294f7aa4937bca42.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/121481/size7/c893d6b00cb5ea4c294f7aa4937bca42.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-59998","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-59998","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":680,"opdsId":"urn:uuid:SW-272610","title":"ಮಿನಿ ಹಾಕಿದ ಮೊದಲ ವೋಟು","authors":["Rakesh"],"language":"","readingLevel":"","publisher":"","summary":"ಆರನೇ ತರಗತಿಯಲ್ಲಿರುವ ಮಿನಿ, ಸ್ಕೂಲ್ ಕ್ಯಾಪ್ಟನ್ ಆಯ್ಕೆಗೆ ವೋಟು ಹಾಕಬೇಕಿದೆ. ಶಾಲೆಯಲ್ಲಿ ನಡೆಯುತ್ತಿರುವ ಚುನಾವಣೆಯಲ್ಲಿ ಅವಳು ಯಾರಿಗೆ ವೋಟು ಹಾಕಬಹುದು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495450/size7/63481348a8ea5c976dae3fa5d1e70c72.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495450/size7/63481348a8ea5c976dae3fa5d1e70c72.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-272610","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-272610","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":681,"opdsId":"urn:uuid:SW-564237","title":"ಪುಚ್ಕುವಿಗೊಂದು ಸಾಹಸ","authors":["Sriram MS"],"language":"","readingLevel":"","publisher":"","summary":"ರಸ್ತೆ ಮಧ್ಯದಲ್ಲಿ ಕೆಂಪು ಕಾರು ಪ್ರಪ್ ಅಂತ ನಿಂತು ಬಿಟ್ಟಿರುವುದರಿಂದ ಪುಚ್ಕು ಬೋಲ್ಟು, ಡೊಡ್ಲ ಸಿಕ್ಕಿ ಬಿದ್ದಿದ್ದಾರೆ. ಮಳೆಯಾಗುತ್ತಿರಲು ಅವರು ಅಲ್ಲಿಂದ ತಪ್ಪಿಸಿಕೊಂಡು ಮನೆ ತಲುಪುವುದು ಹೇಗೆ? ಅವರ ಅದ್ಭುತ ಯೋಜನಾ ವಿಭಾಗ (ಅಯೋವಿ) ಪಕೋಡಕ್ಕನ ಜೊತೆ ಸೇರಿ ಸಮಸ್ಯೆಯನ್ನು ಬಗೆಹರಿಸುವುದನ್ನು ನೋಡಿ ಆನಂದಿಸಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/705536/size7/68e25ad5b62c64928b016a2c4fe7ed49.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/705536/size7/68e25ad5b62c64928b016a2c4fe7ed49.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-564237","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-564237","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":682,"opdsId":"urn:uuid:SW-223554","title":"ಓಟ","authors":["Manjunath B G"],"language":"","readingLevel":"","publisher":"","summary":"ಮನೆಯಲ್ಲಿ ಪಾಯಸವನ್ನು ಮಾಡಿದರು. ಆದರೆ ಅದನ್ನು ಯಾರೂ ತಿನ್ನಲಿಲ್ಲ ಏಕೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/335914/size7/7f983bb598155d418c3cc84ef4837709.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/335914/size7/7f983bb598155d418c3cc84ef4837709.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-223554","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-223554","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":683,"opdsId":"urn:uuid:SW-456744","title":"ಮಳೆಯಲ್ಲಿ ಹಾಡೋಣ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಸುಖಿಯಾ ಕಾಕಾ ಪ್ರಸಿದ್ಧ ಗಾಯಕರು. ಅವರು ಒಮ್ಮೆ ತಮ್ಮ ದೊಡ್ಡ ಅಭಿಮಾನಿಯನ್ನು ಭೇಟಿಯಾದರು. ಅವರ ದೊಡ್ಡ ಅಭಿಮಾನಿಗೂ ಹಾಡುವುದು ಅಂದರೆ ತುಂಬಾ ಇಷ್ಟ. ಬನ್ನಿ ಆ ದೊಡ್ಡ ಅಭಿಮಾನಿ ಯಾರು, ಅವರು ಏನು ಹಾಡಿದರು ಅಂತ ನೋಡೋಣ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722389/size7/d05540af9b5524776541f85d6f0d63d4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722389/size7/d05540af9b5524776541f85d6f0d63d4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-456744","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-456744","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":684,"opdsId":"urn:uuid:SW-460693","title":"ನಿಧಿ ಪೆಟ್ಟಿಗೆ","authors":["Dwarakanath Sumana"],"language":"","readingLevel":"","publisher":"","summary":"ರೋಹನ್‌ಗೆ ಹದಿಮೂರು ಗೋಲಿಗಳು ಬೇಕಾಗಿವೆ. ಕೊಡು ಎಂದು ಅಕ್ಕ ಸೀಮಾಳನ್ನು ಕೇಳುತ್ತಿದ್ದಾನೆ. ಅದರ ಬದಲಾಗಿ ತನ್ನಲ್ಲಿರುವ; ನುಣುಪಾದ ಬಿಳಿ ಕಲ್ಲು, ನೀಲಿ ಬಲೂನು, ಫಳ ಫಳ ಹೊಳೆವ ಮಣಿ, ಕೆಂಪು ಬಟಾಣಿ ಹಾಗಿರುವ ಕಾಳುಗಳನ್ನು ಕೊಡುವೆ ಎನ್ನುತ್ತಿದ್ದಾನೆ. ಸೀಮಾಗೆ ಗೋಲಿಗಳ ಬದಲಾಗಿ ರೋಹನ್ ಎಷ್ಟು ವಸ್ತುಗಳನ್ನು ಕೊಡುತ್ತಾನೆ? ಲೆಕ್ಕ ಹಾಕಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/457869/size7/6bdf4bfe173ece72ab110a4396075c04.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/457869/size7/6bdf4bfe173ece72ab110a4396075c04.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-460693","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-460693","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":685,"opdsId":"urn:uuid:SW-261047","title":"ಜೀರುಂಡೆಗಳೂರಲ್ಲಿ","authors":["Hema Hebbagodi"],"language":"","readingLevel":"","publisher":"","summary":"ಜೀರುಂಡೆಗಳು ಊರನ್ನಾಳಿದರೆ ಏನಾಗಬಹುದು? ಅಥವಾ ಮೀನುಗಳು ಪ್ರಪಂಚವನ್ನು ಆಳಿದರೆ? ಪ್ರಕೃತಿಯ ಶ್ರೀಮಂತ ವೈವಿಧ್ಯತೆಯನ್ನು ಈ ಸುಂದರ ಕವಿತೆಯು ಕಟ್ಟಿಕೊಡುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/626165/size7/4ba2b29a4ed695927c64de968158c87c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/626165/size7/4ba2b29a4ed695927c64de968158c87c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-261047","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-261047","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":686,"opdsId":"urn:uuid:SW-55770","title":"ರಾಣಿ, ರಾಕಿಯ ಕೀಟದ ಬೇಟೆ","authors":["Kollegala Sharma"],"language":"","readingLevel":"","publisher":"","summary":"ಕುಟುಕುವ, ಕಡಿಯುವ ಕೀಟಗಳೆಂದರೆ ರಾಣಿ, ರಾಕಿಗೆ ಅಷ್ಟಕ್ಕಷ್ಟೆ. ಒಂದು ಸಲ ಅವರ ಮನಸು ಬದಲಾಯಿತು, ಏಕೆ ಗೊತ್ತೇ? ಇದೋ ಈ ಪುಸ್ತಕದಲ್ಲಿ ಕೀಟಗಳ ಜತೆ ರಾಣಿ ಮತ್ತು ರಾಕಿ ಸಾಹಸ ಹೇಗಿತ್ತೆಂದು ನಾವೂ ನೋಡೋಣವಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/714311/size7/317e0f3d88d4ec8ebba29fa9ac49379f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/714311/size7/317e0f3d88d4ec8ebba29fa9ac49379f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-55770","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-55770","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":687,"opdsId":"urn:uuid:SW-542960","title":"ಮಳೆ ಹೆಜ್ಜೆಗಳ ಜಾಡು","authors":["LC Nagaraj"],"language":"","readingLevel":"","publisher":"","summary":"ಕೆಲವು ಸಲ ಮುಂಗಾರು ಮಳೆ ಬೇಗ ಬರುತ್ತದೆ, \nಕೆಲವು ಸಲ ತಡವಾಗಬಹುದು. ಆದರೆ, ಹವಾಮಾನದಲ್ಲಿ\nಸಂಭವಿಸಿರುವ ವಿಪರೀತಗಳ ಕಾರಣದಿಂದ ಮಳೆ ನಿರ್ದಿಷ್ಟ \nದಿನದಲ್ಲೇ ಬರುತ್ತದೆ ಎಂದು ಊಹಿಸುವುದು ಕಷ್ಟವೂ ಅಪಾಯವೂ\nಆಗಿದೆ; ಈಗ ಈ ಕುರಿತಾದ ಕಾರ್ಯ ನಿರ್ವಹಣೆಗೆ ತಮ್ಮನ್ನು\nಸಮರ್ಪಿಸಿಕೊಂಡಿರುವ ಹವಾಮಾನ ತಜ್ಞರು, ಭೌತಶಾಸ್ತ್ರಜ್ಞರು,\nಬೇಸಾಯಗಾರರು ಮತ್ತು ಇತರರನ್ನು ಭೇಟಿಯಾಗೋಣ; ಇವರೆಲ್ಲರೂ\nಮಳೆಯ ವರ್ತುಲದ ಬದಲಾವಣೆಯಿಂದ ಭೂಮಿಯ ಮೇಲಾಗುವ\nಪರಿಣಾಮಗಳನ್ನು ಅಧ್ಯಯನ ಮಾಡುತ್ತಿದ್ದಾರೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/636946/size7/2529ca6d6476733ac170babbbb7dc91b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/636946/size7/2529ca6d6476733ac170babbbb7dc91b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-542960","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-542960","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":688,"opdsId":"urn:uuid:SW-126481","title":"ಸುಮಿ ಬುಧಿ ಮತ್ತು ಸುಗಿಯ ಸ್ನೇಹ","authors":["Swati Pandit"],"language":"","readingLevel":"","publisher":"","summary":"ಪ್ರತಿದಿನ ಬೆಳಗ್ಗೆ ಸಮಿ ಬುಧಿಯನ್ನು ಎಬ್ಬಿಸುವುದು ಸುಗಿಯೆ. ದಿನವಿಡಿ ಜೊತೆಯಾಗಿಯೆ ಇರುತ್ತಾರೆ. ಸುಗಿ ಒಂದು ಬಾತುಕೋಳಿ ಮತ್ತು ಸುಮಿ ಬುಧಿಗೆ ಅಚ್ಚುಮೆಚ್ಚು. ದಿನ ನಿತ್ಯದ ಬದುಕಿನ ಚಿತ್ರಣದ ಈ ಕತೆಯಲ್ಲಿ ಮಾನವ ಮತ್ತು ಪ್ರಾಣಿಗಳ ನಡುವಿನ ಸಂಬಂಧ ಬಗ್ಗೆ ಹೇಳಲಾಗಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/179820/size7/95aa06b0358340b9b2d3d332af1ae277.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/179820/size7/95aa06b0358340b9b2d3d332af1ae277.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-126481","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-126481","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":689,"opdsId":"urn:uuid:SW-272258","title":"ನದಿ","authors":["Manjula Kirugavalu"],"language":"","readingLevel":"","publisher":"","summary":"ನದಿ ಎಂದರೆ ಏನು? ಕಾಮನ ಬಿಲ್ಲಿನ ಜೋಕಾಲಿಯಲ್ಲಿ ಪಯಣಿಸುವ ಮೋಡಗಳ ಸರಮಾಲೆ. ನದಿ ಎಂದರೆ ಮೀನುಗಳ ಉಸಿರು ಹರಿಯುವ ಜಾಗ. ನದಿ ದಂಡೆಯಲ್ಲಿ ವ್ಯವಸಾಯ. ನದಿ ಸಾಗುವ ದಾರಿಯುಲ್ಲಿ ನೀವೂ ಪಯಣಿಸ ಬನ್ನಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/747240/size7/3950479c96d41e14bc0dae6143e5c584.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/747240/size7/3950479c96d41e14bc0dae6143e5c584.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-272258","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-272258","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":690,"opdsId":"urn:uuid:SW-464014","title":"ಅಜ್ಜಿಯ ಚಿನ್ನ","authors":["Jnana Murthy  B R"],"language":"","readingLevel":"","publisher":"","summary":"ಭತ್ತದ ಇಳುವರಿ ಕಡಿಮೆ ಆಗುತ್ತಿರುವುದರಿಂದ ಅಜ್ಜಿ, ಅಪ್ಪ ಇಬ್ಬರೂ ಕಂಗಾಲಾಗಿದ್ದಾರೆ. ಆದರೆ, ಇದಕ್ಕೆ ಅಜ್ಜಿಯ ಬಳಿ ಉತ್ತರವಿದೆ. ಅದನ್ನು ಅವರು ನಿಧಿ ಕಾಯ್ದಿರಿಸುವಂತೆ ಮರದ ಪೆಟ್ಟಿಗೆಯಲ್ಲಿ ಭದ್ರವಾಗಿ ಇಟ್ಟಿದ್ದಾರೆ. ಬನ್ನಿ, ನಾವೂ ಸವಿ ಮತ್ತು ಸೆಲ್ವನ್ ಅವರೊಂದಿಗೆ ದೇಸಿ ಭತ್ತದ ತಳಿಗಳಿಂದ ಸಮೃದ್ಧ ಬೆಳೆ ಬೆಳೆಯುವುದನ್ನು ಕಲಿಯೋಣ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495419/size7/233ccd21e8f8b4c78c9c7a371ec10913.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495419/size7/233ccd21e8f8b4c78c9c7a371ec10913.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-464014","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-464014","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":691,"opdsId":"urn:uuid:SW-51413","title":"ಏನೇನಾಗತ್ತೆ ಅಂತ?","authors":["Utthaana Bharighat"],"language":"","readingLevel":"","publisher":"","summary":"ಸುನೀತಾ ಹೊಕ್ಕಳನ್ನು ಒತ್ತಿಕೊಂಡರೆ, ಕಿವಿ ಎಳೆದುಕೊಂಡರೆ ಏನಾಗುತ್ತೆ ಗೊತ್ತಾ? ತಮಾಷೆಯಾಗಿ ದೇಹದ ಅಂಗಾಂಗಗಳನ್ನು ಪರಿಚಯಿಸುವ ಕತೆ ಇದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726929/size7/15b2e1748d152812ed5526070aca52ef.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726929/size7/15b2e1748d152812ed5526070aca52ef.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-51413","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-51413","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":692,"opdsId":"urn:uuid:SW-313369","title":"ಭೂಮಿ, ನಮ್ಮ ಮನೆ - ಹವಾಮಾನ ಬದಲಾವಣೆಯ ಕವಿತೆಗಳು","authors":["Bhoomi Biligere"],"language":"","readingLevel":"","publisher":"","summary":"ಭೂಮಿಯ ಕತೆ ಜೀವ ಉಗಮದ ಕತೆಯೂ ಹೌದು. \nಜೊತೆಗೆ ನಾಶ ಹೊಂದುತ್ತಿರುವ ಕತೆ ಕೂಡ ಹೌದು. \nಹವಾಮಾನ ವೈಪರೀತ್ಯದಿಂದ ಅದು ಮತ್ತೂ ಹೆಚ್ಚುತ್ತಿದೆ. \nಇಲ್ಲಿಯ ಕವಿತೆಗಳನ್ನು ನೀವು ಒರಾಂಗುಟಾನ್, ಹಸ್‌ದೇವ್ ಅರಣ್ಯ, \nಗಂಗಾ ನದಿಯ ಡಾಲ್ಫಿನ್‌ ಮತ್ತು ಪಾಂಡಿಚೆರಿಯ ಶಾರ್ಕ್ ಮೀನಿನ \nಬಾಯಿಂದಲೇ ಕೇಳುವಿರಿ. ಈ ಪದ್ಯಗಳು ನಮ್ಮ ಉಳಿವು ನಮ್ಮ ಕೈಯಲ್ಲೇ ಇದೆ ಎಂಬ ಸಂದೇಶವನ್ನು ಸಾರುತ್ತವೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721331/size7/772b3d930ec8af783d7a1a163c6b23de.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721331/size7/772b3d930ec8af783d7a1a163c6b23de.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-313369","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-313369","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":693,"opdsId":"urn:uuid:SW-52170","title":"ಮರಿ ಸಿಪಿಲೆಯ ಖುಷಿ!","authors":["Sarita Sharan"],"language":"","readingLevel":"","publisher":"","summary":"ತಾಯಿ ಸಿಪಿಲೆ ಹಕ್ಕಿ ಚಿಂತೆಯಲ್ಲಿತ್ತು. ಮರಿ ಸಿಪಿಲೆಗೆ ಖುಷಿಯಾದರೂ ಸುಮ್ಮನೇ ಇರುತ್ತಿತ್ತು. ಇದು ತಾಯಿಯ ಚಿಂತೆಗೆ ಕಾರಣ. ಈ ಕತೆ ಓದಿ ಪ್ರಾಣಿ ಪಕ್ಷಿಗಳಿಗೆ ಸಂತೋಷವಾದಾಗ ಅವು ತಮ್ಮ ಖುಷಿಯನ್ನು ಹೇಗೆ ವ್ಯಕ್ತಪಡಿಸುತ್ತವೆ ಎನ್ನುವುದನ್ನು ತಿಳಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/91201/size7/0ee8dc76299cc7e12a8829ab47850ca3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/91201/size7/0ee8dc76299cc7e12a8829ab47850ca3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-52170","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-52170","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":694,"opdsId":"urn:uuid:SW-461844","title":"ನನ್ನ ಕೆಲಸ ನಾನು ಮಾಡಿಕೊಳ್ಳುವೆ!","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ದೊಡ್ಡವರಿಗೆ ಅನಿಸುತ್ತದೆ, ನನಗೆ ಯಾವ ಕೆಲಸವನ್ನೂ ಮಾಡಲು ಬರುವುದಿಲ್ಲ ಎಂದು. ಆದರೆ, ನನ್ನ ಬಟ್ಟೆ, ಚಪ್ಪಲಿ ನಾನೇ ಹಾಕಿಕೊಂಡು ತಯಾರಾಗಬಲ್ಲೆ. ಗೊತ್ತಾ ನಿಮಗೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727502/size7/852f48e4ee086274879b4c0f745d42e7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727502/size7/852f48e4ee086274879b4c0f745d42e7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-461844","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-461844","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":695,"opdsId":"urn:uuid:SW-149461","title":"ಸೂಕ್ಷ್ಮದರ್ಶಕದ ಅಡಿಯಲ್ಲಿ","authors":["Savitri Gaitonde Shanbhag"],"language":"","readingLevel":"","publisher":"","summary":"ನಮ್ಮ ಸುತ್ತಮುತ್ತಲೂ ಸೂಕ್ಷ್ಮಜೀವಿಗಳಿರುವ ಬಗ್ಗೆ ತಿಳಿದಿದೆಯೇ? ಅವನ್ನು ಕಾಣಲು ಸೂಕ್ಷ್ಮದರ್ಶಕಡಿಯಲ್ಲಿ ಒಮ್ಮೆ ನೋಡಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715281/size7/0875751e769cb804e0b165acf043ee1f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715281/size7/0875751e769cb804e0b165acf043ee1f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-149461","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-149461","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":696,"opdsId":"urn:uuid:SW-140432","title":"ಅಮ್ಮಾ ಅಲ್ಲಿ ನೀನೇನಾ?","authors":["Pallavi Rao"],"language":"","readingLevel":"","publisher":"","summary":"ಬಾಗಿಲಲ್ಲಿ ಯಾರದು? ಅಮ್ಮನೋ ಅಥವಾ ಒಂದು ದೊಡ್ಡ ಭಯಾನಕ ಪೆಡಂಭೂತವೋ? ಒಳಗೆ ಬರಲು ಬಿಡಬೇಕಾದರೆ ಬಂದಿರುವುದು ಸರಿಯಾದ ವ್ಯಕ್ತಿ ಎಂದು ಬೀಬಿ, ಅಜೀಮ್, ಜುಝೇರ್ ಮತ್ತು ಥೇಯಿ ಥೇಯಿಗೆ ಖಾತರಿ ಆಗಬೇಕು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/216392/size7/2c6aa8668929bca782c729939ece2bfe.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/216392/size7/2c6aa8668929bca782c729939ece2bfe.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-140432","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-140432","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":697,"opdsId":"urn:uuid:SW-66244","title":"ಆಕಾರ ಮತ್ತು ಲಿನಿಯೊ ಸಾಹಸ","authors":["Jagadish Shri"],"language":"","readingLevel":"","publisher":"","summary":"ಆಕಾರ ಉದ್ದಕ್ಕೆ ನಿಂತಿರುವ ಲಂಬ ರೇಖೆ. ಲಿನಿಯೊ  ಮಲಗಿರುವ ಅಡ್ಡ ರೇಖೆ. ಈ ಇಬ್ಬರು ಸ್ನೇಹಿತರು ತಮ್ಮ ಇತರ ರೇಖಾ ಮಿತ್ರರೊಂದಿಗೆ ಆಡಲು ಹೋದರು. ಆಗ ಏನಾಗಬಹುದು, ಊಹಿಸುತ್ತೀರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715539/size7/cf9d88b7013979cf37ea1f9bb0c93c9c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715539/size7/cf9d88b7013979cf37ea1f9bb0c93c9c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-66244","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-66244","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":698,"opdsId":"urn:uuid:SW-33445","title":"ಮೂಳೆ ಸುಡೊಕು","authors":["Tanuja Jakkannavar"],"language":"","readingLevel":"","publisher":"","summary":"ಜೋಯಾ ಮತ್ತು ಅರ್ಮಾನ್ ಅಮ್ಮನ ಕ್ಲಿನಿಕ್‍ನಲ್ಲಿ ಗಡಿಬಿಡಿ ಮಾಡಿದ್ದಾರೆ. ಈ ವಿಷಯ ಅಮ್ಮನಿಗೆ ಗೊತ್ತಾದರೆ ಅವರಿಬ್ಬರೂ ದೊಡ್ಡ ತೊಂದರೆಯಲ್ಲಿ ಸಿಲುಕುವರು. ಅವರು ತಮ್ಮ ಒಣಜಗಳವನ್ನು ಪಕ್ಕಿಕ್ಕಿಟ್ಟು ಒಂದಾಗಿ ಕೆಲಸ ಮಾಡುವರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/724120/size7/c43ae4c1438930b9a3020cbb109e471a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/724120/size7/c43ae4c1438930b9a3020cbb109e471a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-33445","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-33445","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":699,"opdsId":"urn:uuid:SW-223583","title":"ನಾನು ಮಲಗುವುದಿಲ್ಲ","authors":["Shabana Begum"],"language":"","readingLevel":"","publisher":"","summary":"ಮಧ್ಯ ರಾತ್ರಿಯಾಯಿತು. ಎಲ್ಲಾ ಪ್ರಾಣಿಗಳು ಮಲಗಿದವು. ಆದರೆ ಯಾರೋ ಒಬ್ಬರಿಗೆ ನಿದ್ದೆ ಬರುತ್ತಿರಲಿಲ್ಲ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/285290/size7/427895f892a9d71e72a554d328b7969e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/285290/size7/427895f892a9d71e72a554d328b7969e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-223583","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-223583","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":700,"opdsId":"urn:uuid:SW-179","title":"ನನ್ನ ಬಾಲವಾಡಿ","authors":["Usha"],"language":"","readingLevel":"","publisher":"","summary":"ಮಗುವಿಗೆ ತನ್ನ ಅನುಭವಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳಲು ಭಲೇ ಉತ್ಸಾಹ. ತಾನೇನು ಮಾಡಿದೆ.\nಎಲ್ಲೆಲ್ಲಿಗೆ ಹೋದೆ ಎಂಬಿತ್ಯಾದಿ ವಿಚಾರ ಇತರರಿಗೆ ಹೇಳಲೇ ಬೇಕಲ್ಲ. ನನ್ನ ಬಾಲವಾಡಿ ಅನುಭವ ಎಂಬುದು ಮಕ್ಕಳ ಭಾಷೆಯಲ್ಲಿ ಎಷ್ಟು ಖುಷಿ ಕೊಡುತ್ತದೆಂದು ತೋರಿಸುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722231/size7/23231d919b2922958bb7789238735d19.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722231/size7/23231d919b2922958bb7789238735d19.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-179","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-179","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":701,"opdsId":"urn:uuid:SW-117222","title":"ಬೆಕ್ಕಿನ ಮರಿಯ ಬೇಟೆ‌ ಸಾಹಸ","authors":["Nagaraj Vaidya"],"language":"","readingLevel":"","publisher":"","summary":"ಪುಟಾಣಿ ಬೆಕ್ಕು ಬೇಟೆಗೆ ಹೊರಟಿತ್ತು. ಆದರೆ ಪಾಪ ದಾರಿ ತಪ್ಪಿಸಿಕೊಂಡಿತು!  ಬೆಕ್ಕು ಪುನಃ ತನ್ನ ಬಳಗವನ್ನು ಸೇರಿದ್ದು ಹೇಗೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/164790/size7/11a325fb8a6134cbbae60eb2c95bf009.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/164790/size7/11a325fb8a6134cbbae60eb2c95bf009.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-117222","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-117222","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":702,"opdsId":"urn:uuid:SW-372173","title":"ಕಾಡು ಎಚ್ಚೆತ್ತಾಗ","authors":["Pallavi Rao"],"language":"","readingLevel":"","publisher":"","summary":"ಸೂರ್ಯ ಅಬ್ಬರದಿಂದ ಹೊರ ಹಾರುತ್ತಿದ್ದಂತೆ, ಹೊಸತೊಂದು ದಿವಸಕ್ಕೆ ಕಾಡೂ ಎದ್ದೇಳುವುದು, ಹೊಸತೊಂದು ದಿನಚರಿ ತೆರೆದುಕೊಳ್ಳುವುದು. ಇಂದು ಕಾಡು ಹೇಗಿರಬಹುದು? ಸೂರ್ಯನಿಂದ ಹಿಡಿದು ಕಲ್ಲುಬಂಡೆಗಳ ವರೆಗೂ ಎಲ್ಲವಕ್ಕೂ ನಮ್ಮಂತೆಯೇ ಜೀವವಿದೆ ಎಂಬ ಆದಿವಾಸಿ ಜನರಾದ ಗೊಂಡರ ಪ್ರಾಚೀನ ನಂಬಿಕೆಯಿಂದ ಪ್ರೇರಿತವಾದ ಕತೆ ಇದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527482/size7/d93203ac7dc8d15f6af456cde8035923.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527482/size7/d93203ac7dc8d15f6af456cde8035923.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-372173","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-372173","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":703,"opdsId":"urn:uuid:SW-344856","title":"ಶಾರ್ಕ್ ತಿಮಿಂಗಿಲ ಎಷ್ಟು ದೊಡ್ಡದು?","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಶಾರ್ಕ್ ತಿಮಿಂಗಿಲ ಒಂದು ದೊಡ್ಡ ಮೀನು. ಅದು ಎಷ್ಟು ದೊಡ್ಡದು? ಇದು ನೀಲಿ ತಿಮಿಂಗಿಲಕ್ಕಿಂತ ದೊಡ್ಡದಾಗಿದೆಯೇ? ಅಥವಾ ಡಾಲ್ಫಿನ್‌ಗಿಂತ ಚಿಕ್ಕದಾಗಿದೆಯೇ? ಸಮುದ್ರ ಜಗತ್ತಿನ ಕುರಿತಾದ ಈ ಪುಸ್ತಕವು ಹೋಲಿಕೆ ಮಾಡುವುದನ್ನು ತಿಳಿಸಿ ಕೊಡುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/436694/size7/84cc78460481cb7264e291c1f3137fb0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/436694/size7/84cc78460481cb7264e291c1f3137fb0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-344856","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-344856","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":704,"opdsId":"urn:uuid:SW-642802","title":"ಪಿಕು ಮತ್ತು ಅವನ ಯಕ್ಷಿಣಿ ಅತ್ತೆ","authors":["G W Carlo"],"language":"","readingLevel":"","publisher":"","summary":"ಪಿಕುನ ಪಿಶಿ ನಿಜವಾಗಲೂ ಮಾಂತ್ರಿಕ ಶಕ್ತಿ ಪಡೆದುಕೊಂಡವಳು. ಅವಳು ನಾನಾ ಬಗೆಯ ಜನರ ವೇಷ ಧರಿಸಬಲ್ಲವಳಾಗಿದ್ದಳು. ಪಿಕು ಕೂಡ ನಾಟಕ ಜಗತ್ತನ್ನು ಪ್ರವೇಶಿಸಿ ಬಹಳಷ್ಟು ಹೊಸ ಸ್ನೇಹಿತರನ್ನು ಸಂಪಾದಿಸಿಕೊಳ್ಳುತ್ತಾನೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712882/size7/7910af3bbb76b165a9e341132e1e9af2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712882/size7/7910af3bbb76b165a9e341132e1e9af2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-642802","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-642802","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":705,"opdsId":"urn:uuid:SW-611828","title":"ಆಗುಂಬೆಯ ಅಜಯ್ ಮತ್ತು ಸಿಗ್ನಲ್ ಸರ್ಪ","authors":["Dr K Puttaswamy"],"language":"","readingLevel":"","publisher":"","summary":"ಅಜಯ್ ತಮ್ಮ ಕೆಲಸಕ್ಕೆ ಹೊರಟಿದ್ದಾರೆ. ಆಗುಂಬೆಯಲ್ಲಿ ಅವರ ಕಚೇರಿ. ಕಾಳಿಂಗ ಸರ್ಪವನ್ನು ಕಂಡುಹಿಡಿಯುವುದು ಅವರ ಉದ್ಯೋಗ. ನಮಗೆ ಅವರು ಒಯ್ಯುತ್ತಿರುವ ಆಂಟೆನಾ ಕಾಣಿಸುತ್ತಿದೆ. ಆದರೆ, ಅದಕ್ಕೆ ಸಂದೇಶ ರವಾನಿಸುವ ರೇಡಿಯೋ ಎಲ್ಲಿದೆ? ಸರ್ಪಗಳ ರಾಜನನ್ನು ಭೇಟಿಯಾಗುವ ಅಜಯ್ ಜೊತೆ ಹೆಜ್ಜೆ ಹಾಕಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/705616/size7/6c58e3ce173f8062b499f3fa44a02cd5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/705616/size7/6c58e3ce173f8062b499f3fa44a02cd5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-611828","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-611828","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":706,"opdsId":"urn:uuid:SW-639214","title":"ತಕರಾರು ಪುಟ್ಟಿ ಮೋನಾ","authors":["Shruthi B R"],"language":"","readingLevel":"","publisher":"","summary":"ಕೆಲವೊಮ್ಮೆ ಅಮ್ಮ ಮಾಡುವ ಖಿಚ್ಡಿ ಬಗ್ಗೆ, ಕೆಲವೊಮ್ಮೆ ತಾತನ ಉದ್ದನೆಯ ಕಾಲುಗಳ ಬಗ್ಗೆ. ಮೋನಾಗೆ ಏನಾದರೊಂದು ತಕರಾರು ತೆಗೆಯುವುದು ಇಷ್ಟ. ಎಲ್ಲಕ್ಕೂ ಹೀಗ್ಯಾಕೆ ಅನ್ನುವ ಅವಳ ಕುಟುಂಬವನ್ನು ಭೇಟಿಯಾಗೋಣ ಬನ್ನಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723583/size7/e929b19c45eb6edf8cbe74160163cb46.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723583/size7/e929b19c45eb6edf8cbe74160163cb46.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-639214","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-639214","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":707,"opdsId":"urn:uuid:SW-223542","title":"ಬೀಗದ ಕೀಲಿ","authors":["Shabana Begum"],"language":"","readingLevel":"","publisher":"","summary":"ಸಂದೀಪನಿಗೆ ಒಂದು ಬೀಗದ ಕೀಲಿ ಸಿಕ್ಕಿತು ಆದರೆ ಅದರ ಬೀಗ ಸಿಗುತ್ತಿರಲಿಲ್ಲ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/285312/size7/c42453cb742c40a243d46a70cc96d28e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/285312/size7/c42453cb742c40a243d46a70cc96d28e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-223542","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-223542","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":708,"opdsId":"urn:uuid:SW-651781","title":"ನಾನು ಮಲಗಲು ಬಯಸುವುದಿಲ್ಲ!","authors":["Bhat Ananthesha"],"language":"","readingLevel":"Level 2","publisher":"","summary":"ನಂದಿ ಮಲಗಲು ಬಯಸುವುದಿಲ್ಲ. ಖಂಡಿತ ಇಲ್ಲ! ಅವಳು ಸಾಹಸ ಮಾಡಲು ಬಯಸುತ್ತಾಳೆ. ನಂದಿ ತನ್ನ ಕಲ್ಪನೆಯನ್ನು ಮುಕ್ತವಾಗಿ ಚಲಾಯಿಸಲು ಬಿಡುವಾಗ ಅವಳೊಂದಿಗೆ ಸೇರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/130504/size7/6edd3368f087bd27eeb1acdf625c6293.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/130504/size7/6edd3368f087bd27eeb1acdf625c6293.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-651781","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-651781","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":709,"opdsId":"urn:uuid:SW-580312","title":"ಫಾರೂಕಜ್ಜನ ತೋಟ","authors":["Dr Akshata Shanbhag"],"language":"","readingLevel":"","publisher":"","summary":"ಅಮೀರ್‌ನಿಗೆ ಫಾರೂಕಜ್ಜನ ತೋಟ ಎಂದರೆ ತುಂಬಾ ಇಷ್ಟ. ಆದರೆ, ಯಾವುದೋ ಕೀಟಗಳು ತೋಟದ ಗಿಡಗಳನ್ನೆಲ್ಲ ತಿನ್ನುತ್ತಿವೆ. ಕೀಟಗಳಿಂದ ಗಿಡಗಳನ್ನು ರಕ್ಷಿಸಲು ಅಮೀರ್ ಏನು ಮಾಡಬಹುದು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/83448/size7/1a72b6f993b0eca3cfb97fffc71d0828.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/83448/size7/1a72b6f993b0eca3cfb97fffc71d0828.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-580312","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-580312","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":710,"opdsId":"urn:uuid:SW-576","title":"ಹೇಳೇ ಅಕ್ಕಾ ಆಗಸವೇಕೆ ತಿಳಿನೀಲಿ?","authors":["Vasantha Kalbagal"],"language":"","readingLevel":"","publisher":"","summary":"ಪುಟ್ಟ ತಮ್ಮನ ಅನ್ವೇಷಕ ತಲೆಯಲ್ಲಿ ಯಾವತ್ತೂ ಅಕ್ಕನನ್ನು ಕೇಳಬೇಕಾದ ಅನೇಕ \nಪ್ರಶ್ನೆಗಳು ತುಂಬಿರುತ್ತವೆ. ಅಕ್ಕನಿಗೆ ಉತ್ತರಗಳೆಲ್ಲವೂ ಗೊತ್ತು ಎಂದು ಆತನಿಗೆ ಅರಿವಿದೆ. \nಯಾಕೆಂದರೆ ಆಕೆ ಸದಾ ದಪ್ಪದಪ್ಪ ಪುಸ್ತಕಗಳನ್ನು ಓದುತ್ತಿರುತ್ತಾಳಲ್ಲಾ.\nಈ ಪುಸ್ತಕದಲ್ಲಿ ಯಾಕೆ ಆಕಾಶ ನೀಲಿಯಾಗಿದೆ ಎಂದು ತಮ್ಮ ಆಶ್ಚರ್ಯ ಪಡುತ್ತಾನೆ.\nಏಕೆ ಹಾಗಿದೆ ಹೇಳೆಂದು ಅಕ್ಕ ಅವನನ್ನೇ ಕೇಳಿದಾಗ ಆತನ ಕಲ್ಪನೆ ಗರಿಕೆದರುತ್ತದೆ. \nಆಕಾಶದಲ್ಲಿ ಒಣಗಲು ಹಾಕಿರುವ ದೊಡ್ಡ ನೀಲಿ ಸೀರೆಯಿಂದಾಗಿ ಆ ಬಣ್ಣ ಬಂದಿರಬಹುದೇ, \nಅಥವಾ ಅದಕ್ಕೆ ಬೇರೇನಾದರೂ ಕಾರಣವಿರಬಹುದೇ?\nಕೊನೆಗೆ ಅಕ್ಕನೇ ಸರಿಯಾದ ಉತ್ತರ ಕೊಡುತ್ತಾಳೆ. ಆದರೆ ಈ ಪುಸ್ತಕ ಓದಲು \nಆರಂಭಿಸುವ ಮುನ್ನವೇ ಆಗಸವೇತಕೆ ನೀಲಿಯಾಗಿದೆ ನೀವು ಹೇಳಿ ನೋಡೋಣ","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722412/size7/c9131925228d1e8ba22cbb83656b4e17.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722412/size7/c9131925228d1e8ba22cbb83656b4e17.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-576","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-576","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":711,"opdsId":"urn:uuid:SW-43330","title":"ಅಮ್ಮನ ಸಲಕರಣೆ ಡಬ್ಬಿ","authors":["Sarita Sharan"],"language":"","readingLevel":"","publisher":"","summary":"ಮಿನಿ ಮತ್ತು ತಾರಾಳ ಮನೆಯ ತುಂಬೆಲ್ಲ ನೀರು ಹರಿಯುತ್ತಿತ್ತು. ಸ್ನಾನದ ಕೋಣೆಯ ನೀರಿನ ಪೈಪೊಂದು ಒಡೆದು ಹೋಗಿದ್ದೇ ಇದಕ್ಕೆ ಕಾರಣ. ಮಕ್ಕಳನ್ನು ಈ ಸಮಸ್ಯೆಯಿಂದ ಪಾರು ಮಾಡಲು ಅಮ್ಮ ತನ್ನ ಸಲಕರಣೆ ಡಬ್ಬಿಯೊಂದಿಗೆ ಬಂದಳು. ಹಾಗಾದರೆ ಅಮ್ಮನ ಸಲಕರಣೆ ಡಬ್ಬಿಯಲ್ಲೇನಿದೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/90215/size7/f32daefc05db2f3a283a542d3941a48b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/90215/size7/f32daefc05db2f3a283a542d3941a48b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-43330","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-43330","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":712,"opdsId":"urn:uuid:SW-150918","title":"ನಾನೂ ಸ್ವಲ್ಪ ನಿಮ್ಮ ಹಾಗೆ","authors":["Priyadarshini Shettar"],"language":"","readingLevel":"","publisher":"","summary":"ರಿಂಕಿಗೆ ತಾನು ಯಾರು ಎನ್ನುವುದೇ ನೆನಪಾಗುತ್ತಿಲ್ಲ! \nಅವಳು ಯಾರು? ಆನೆಯೋ? ಜಿಂಕೆಯೋ? ಬನ್ನಿ ರಿಂಕಿಯ \nಜೊತೆ ಸೇರಿ ನಾವೂ ಅವಳು ಯಾರೆಂದು ಕಂಡುಹಿಡಿಯೋಣ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725077/size7/8de0f29bfba8ad0e01dcbff59b0a46b0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725077/size7/8de0f29bfba8ad0e01dcbff59b0a46b0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-150918","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-150918","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":713,"opdsId":"urn:uuid:SW-586327","title":"ಆಮೆ ಮತ್ತು ಮೊಲದ ಗೆಳೆತನ","authors":["Smitha sathyaprakash"],"language":"","readingLevel":"","publisher":"","summary":"ಮರಿ ಆಮೆ ಟೆನೈನ ಅಜ್ಜಿಗೆ ಹುಷಾರಿಲ್ಲ. ಅದರ ಅಪ್ಪ-ಅಮ್ಮ, ಅಜ್ಜಿಯ ಸಹಾಯಕ್ಕೆ ಹೋಗುತ್ತಿದ್ದಾರೆ. ಆಗ ಬಸಿ ಎಂಬ ಮೊಲ, ಟೆನೈನನ್ನು ತನ್ನ ಮನೆಗೆ ಕರೆದುಕೊಂಡು ಹೋಗುತ್ತದೆ. ಇದು ಆಮೆ ಮತ್ತು ಮೊಲದ ಗೆಳೆತನದ ಇನ್ನೊಂದು ಕತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527479/size7/c27aed7bef82c0d48e6c6bbfd3c447fd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527479/size7/c27aed7bef82c0d48e6c6bbfd3c447fd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-586327","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-586327","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":714,"opdsId":"urn:uuid:SW-134497","title":"ಹೆಣ್ಣುಮಕ್ಕಳಿಗೂ ಬೇಕಿದೆ ಸ್ವಾತಂತ್ರ್ಯ","authors":["Dr. H.M. Kumaraswamy"],"language":"","readingLevel":"","publisher":"","summary":"ಹೆಣ್ಣುಮಕ್ಕಳಿಗೂ ಬೇಕಿದೆ ಸ್ವಾತಂತ್ರ್ಯ. ಯಾವುದಕ್ಕೆಲ್ಲ ಸ್ವಾತಂತ್ರ್ಯ ಬೇಕಿದೆ? ಅದರ ಬಗ್ಗೆ ಓದೋಣ ಮತ್ತು ತಿಳಿಯೋಣ ಬನ್ನಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727178/size7/284664741b47d5bf7c3a6c80f09e7cae.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727178/size7/284664741b47d5bf7c3a6c80f09e7cae.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-134497","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-134497","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":715,"opdsId":"urn:uuid:SW-275967","title":"ಬರಿಗಾಲಲ್ಲಿ ಫುಟ್‌ಬಾಲ್‌ ಆಡಿದ ಕನು ತಾತ","authors":["Lakshmi N"],"language":"","readingLevel":"","publisher":"","summary":"ಚಿನಾರ್‌ಗೆ ಫುಟ್‌ಬಾಲ್‌ ಆಟ ಎಂದರೆ ಅಚ್ಚುಮೆಚ್ಚು. ದೊಡ್ಡವಳಾದ ಮೇಲೆ ವರ್ಲ್ಡ್‌ ಕಪ್‌ ಗೆಲ್ಲುವ ಆಸೆ. ಒಂದು ದಿನ ಅವಳು ಅಮ್ಮನ ಬಳಿ ಹೊಸ ಬೂಟು ಕೊಡಿಸಲು ಕೇಳುತ್ತಾಳೆ. ಆಗ ಅಮ್ಮ ಚಿನಾರ್‌ಗೆ ಕನು ತಾತ ಬರಿಗಾಲಲ್ಲಿ ಬ್ರಿಟಿಷರ ವಿರುದ್ಧ ಆಟವಾಡಿ ಗೆದ್ದ ಕತೆಯನ್ನು ಹೇಳುತ್ತಾಳೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/362417/size7/45998f2b66540b0461b38115b3ef0cf4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/362417/size7/45998f2b66540b0461b38115b3ef0cf4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-275967","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-275967","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":716,"opdsId":"urn:uuid:SW-577391","title":"ನಾವು ತಿನ್ನೋಣ","authors":["Bhat Ananthesha"],"language":"","readingLevel":"Level 2","publisher":"","summary":"ಕೊಳೆಯುತ್ತಿರುವ ಎಲೆಗಳು, ತಾಜಾ ಪರೋಪಜೀವಿಗಳು, ಅಥವಾ ತಮ್ಮದೇ ಆದ ಮಲ! ಪ್ರಾಣಿಗಳು ತಮ್ಮ ಆವಾಸಸ್ಥಾನ ಮತ್ತು ಆಹಾರಕ್ರಮಕ್ಕೆ ಸರಿಹೊಂದುವಂತೆ ಎಲ್ಲಾ ರೀತಿಯ ವಸ್ತುಗಳನ್ನು ತಿನ್ನುತ್ತವೆ. ಪೋಷಕಾಂಶಗಳನ್ನು ಪಡೆಯಲು ಮತ್ತು ಬಲವಾಗಿ ಉಳಿಯಲು ಪ್ರಾಣಿಗಳು ತಿನ್ನುವ ಆಸಕ್ತಿದಾಯಕ ವಿಧಾನಗಳ ಬಗ್ಗೆ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/444491/size7/71c51cabe1a1d9cdf76d02a72a941c01.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/444491/size7/71c51cabe1a1d9cdf76d02a72a941c01.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-577391","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-577391","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":717,"opdsId":"urn:uuid:SW-460630","title":"ಠಣ್… ಠಣಾ… ಠಣ್!","authors":["Praveen S"],"language":"","readingLevel":"","publisher":"","summary":"ದಾಯಿ ಸಂಗ್ರಹಿಸಿರುವ ನಾಣ್ಯಗಳನ್ನು ನೋಡುವುದೆಂದರೆ ಬಾಂಕೊಗೆ ಎಲ್ಲಿಲ್ಲದ ಆಸಕ್ತಿ. ಬಾಂಕೊ ಜೊತೆ ಸೇರಿ ಭಾರತೀಯ ನಾಣ್ಯಗಳ ಮೇಲಿರುವ ಚಿತ್ರಗಳನ್ನು ಗುರುತಿಸಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/451786/size7/bd94e16a6bcace869c847737c6bfef58.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/451786/size7/bd94e16a6bcace869c847737c6bfef58.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-460630","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-460630","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":718,"opdsId":"urn:uuid:SW-56380","title":"ಭಲೇ ಬುರ್ಲಿ","authors":["Brinda N Rao"],"language":"","readingLevel":"","publisher":"","summary":"ಕೋಂಡ್ ಬುಡಕಟ್ಟು ಜನಾಂಗದವರು ಕಾಡು ಸಮೀಪದಲ್ಲೇ ವಾಸಿಸುತ್ತಾರೆ. ಅವರಿಗೆ ಅಲ್ಲಿನ ಪ್ರತಿ ಡೊಂಕು ಹಾದಿ, ದೊಡ್ಡ ದೊಡ್ಡ ಸಾಲ್ ಹಾಗೂ ಮಹೂವಾ ಮರ, ಮುಂಗುಸಿ ಹಾಗೂ ಹುಲಿಯ ಹೆಜ್ಜೆ ಗುರುತು - ಎಲ್ಲವೂ ತಿಳಿದಿದೆ. ಹೌದು! ಪುಟ್ಟ ಬುರ್ಲಿಯೂ ಇವೆಲ್ಲವನ್ನೂ ಕಲಿಯುತ್ತಿದ್ದಳು. ಆದರೆ ಎದೆ ಝಲ್ಲೆನಿಸುವ, ಆ ಅಪಾಯದ ಕ್ಷಣಕ್ಕೆ ಅವಳು ಸಿದ್ಧಳಿದ್ದಳೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/99425/size7/17c509cd79601054fa8341f61478f16a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/99425/size7/17c509cd79601054fa8341f61478f16a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-56380","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-56380","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":719,"opdsId":"urn:uuid:SW-63561","title":"ಅದೋ ಅಲ್ಲಿ ಅಮ್ಮ!","authors":["Harshavardhan Sullia"],"language":"","readingLevel":"","publisher":"","summary":"ಅಶೋಕ ಮತ್ತೆ ಅವನ ತಂದೆ ಮಗುವನ್ನು ಕರೆದುಕೊಂಡು ಮಾರುಕಟ್ಟೆಗೆ ಹೊರಟಿದ್ದಾರೆ. ಆದರೆ, ಹೋದಲ್ಲೆಲ್ಲಾ ಮಗುವಿಗೆ ಅಮ್ಮನೇ ಕಾಣುತ್ತಿರುವುದೇಕೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/672401/size7/a52ff4a1ae74944bf5e1fb3aa5c0253b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/672401/size7/a52ff4a1ae74944bf5e1fb3aa5c0253b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-63561","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-63561","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":720,"opdsId":"urn:uuid:SW-208698","title":"ಯಾವ ಭಾಷೆ ಯಾರದು?","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ರೂಪ, ರಂಗು ಮತ್ತು ಭಾಷೆ ಬೇರೆ ಬೇರೆ ಆದರೂ ಎಲ್ಲವನ್ನೂ ಹಕ್ಕಿಗಳೆಂದೇ ಹೇಳುತ್ತೇವೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/282967/size7/ab1025686f316a36e8d26e195c5bb67a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/282967/size7/ab1025686f316a36e8d26e195c5bb67a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-208698","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-208698","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":721,"opdsId":"urn:uuid:SW-54253","title":"ಪ್ರಿಯಾ ತಿಂದಿದ್ದೇನು?","authors":["Meera Tushar Punarvasu"],"language":"","readingLevel":"","publisher":"","summary":"ಹಸು ಪ್ರಿಯಾ ಹೊಟ್ಟೆ ನೋವಿಗೆ ಕಾರಣವೇನು? ಅದಕ್ಕೆ ಅವಳ ಗೆಳೆಯರು ಹೇಗೆ ಸಹಾಯ ಮಾಡಿದರು ಎಂದು ತಿಳಿಯಲು ಕತೆ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/93785/size7/034e226c88d0e40181a6d5c7009efc02.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/93785/size7/034e226c88d0e40181a6d5c7009efc02.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-54253","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-54253","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":722,"opdsId":"urn:uuid:SW-110541","title":"ಕೋಳಿ ಮತ್ತು ಸಹಸ್ರಪದಿ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಕೋಳಿಗಳು ಮತ್ತು ಸಹಸ್ರಪದಿಗಳ ನಡುವಿನ ಶತ್ರುತ್ವದ ಕಾರಣವನ್ನು ವಿವರಿಸುವ ಆಕರ್ಷಕ  ಕಥೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/126966/size7/00f41c902b3ca2a809716cc279a695ab.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/126966/size7/00f41c902b3ca2a809716cc279a695ab.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-110541","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-110541","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":723,"opdsId":"urn:uuid:SW-132138","title":"ಹನಿ ಹನಿಗೂಡಿ…","authors":["LC Nagaraj"],"language":"","readingLevel":"","publisher":"","summary":"6ನೇ ತರಗತಿ ವಿದ್ಯಾರ್ಥಿಗಳಿಗೆ ಮೋಜಿನ ಪಾರ್ಕಿಗೆ ಹೋಗುವ ಆಸೆಯಾಗಿದೆ; ಆದರೆ, ಅಲ್ಲಿಗೆ ಹೋಗಲು ಬೇಕಾಗುವ ಹಣವನ್ನು ಅವರು ಹೇಗೆ ಉಳಿಸುತ್ತಾರೆ? ಕತೆ ಓದಿ ಸುಮ್ಮನಿರುವ ಹಾಗಿಲ್ಲ, ನೀವೂ ಉಳಿತಾಯ ಮಾಡಬೇಕು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495474/size7/618585369afe23028c52ba9786f8c37e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495474/size7/618585369afe23028c52ba9786f8c37e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-132138","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-132138","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":724,"opdsId":"urn:uuid:SW-41170","title":"ಬಾನಿನಲ್ಲಿ ತಿಮಿಂಗಿಲ","authors":["Srinatha S.V"],"language":"","readingLevel":"","publisher":"","summary":"ಮೋಡಗಳನ್ನು ನೋಡುತ್ತ ಕೂತಿದ್ದ ತಾತ ಮತ್ತು ಮುಜ಼್ನಾ ಒಮ್ಮೆಲೇ, ನೀಲಿ ತಿಮಿಂಗಿಲಳ ಬಗ್ಗೆ ತಿಳಿಯಲು ಕಡಲಿಗೆ ಜಿಗಿಯುತ್ತಿದ್ದಾರೆ. ಅವರೊಂದಿಗೆ ನೀವೂ ಜೊತೆಯಾಗಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/724152/size7/202262fcb48ac69ed4dcd898b6f4d20e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/724152/size7/202262fcb48ac69ed4dcd898b6f4d20e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-41170","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-41170","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":725,"opdsId":"urn:uuid:SW-456945","title":"ಅವಿ ಏನೆಲ್ಲಾ ಆದ?","authors":["Vinaya J  Vittal"],"language":"","readingLevel":"","publisher":"","summary":"ಅವಿ ವಿವಿಧ ವೇಷ ತಾಳುವ ಆಟವನ್ನು ಇಷ್ಟ ಪಡುತ್ತಾನೆ. ಈ ಪುಸ್ತಕದಲ್ಲಿ ಗಮನಿಸುವ ಹಾಗೂ ಆಕೃತಿಗಳನ್ನು ಗುರುತಿಸುವ ಚಟುವಟಿಕೆಯಿದ್ದು ಇದರಲ್ಲಿ ಅವಿ ಒಂದು ಕಲ್ಲಾಗಿ, ಒಂದು ಕೋಗಿಲೆಯಾಗಿ ಹಾಗೂ ಇನ್ನಿತರ ವಸ್ತುಗಳಾಗಿ ಮಾರ್ಪಾಡಾಗುವ ಆಟದಲ್ಲಿ ನೀವು ಭಾಗಿಯಾಗಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727422/size7/a3b92f2c33ab0eb5e15b196c974d415a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727422/size7/a3b92f2c33ab0eb5e15b196c974d415a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-456945","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-456945","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":726,"opdsId":"urn:uuid:SW-632967","title":"ನಾಚಿಕೆಯ ಥೊಯ್‌ಥೊಯ್","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಕೆಲವು ಸಲ, ಥೊಯ್‌ಥೊಯ್‌ಗೆ ನಾಚಿಕೆಯಾಗುತ್ತೆ, ಅದರಲ್ಲೂ ಕ್ಲಾಸಿನಲ್ಲಿ ಕೈ ಎತ್ತಬೇಕಾದಾಗ. ಇವತ್ತು ಮಿಸ್‌ ಲೈಮಾ ಕೇಳಿದ ಪ್ರಶ್ನೆಗೆ ಅವಳಿಗೆ ಉತ್ತರವೂ ಗೊತ್ತಿದೆ. ಹಾಗಿದ್ದರೆ, ಮುಂದೇನಾಯಿತು? ನಾಚಿಕೆ, ಸ್ನೇಹ ಕುರಿತಾದ ಚಿತ್ರ ಪುಸ್ತಕವಿದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722795/size7/8887c18a299682075fabc1fa5391ce69.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722795/size7/8887c18a299682075fabc1fa5391ce69.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-632967","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-632967","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":727,"opdsId":"urn:uuid:SW-150622","title":"ಪಾಳು ಬಂಗಲೆಯಲ್ಲಿ ಅರುಣ್","authors":["Harshavardhan Sullia"],"language":"","readingLevel":"","publisher":"","summary":"ಅರುಣ್ ಮತ್ತು ಅರುಣಾಚಲಂ ಇಬ್ಬರೂ ಪುರಾತನ ಕಾಲದ ನಿಗೂಢ ಬಂಗಲೆಯಲ್ಲಿ ಸಿಕ್ಕಿಹಾಕಿಕೊಂಡಿದ್ದರು. ಅಲ್ಲಿಂದ ಹೊರಬರಲು ಅವರಿಗೆ ಒಂದೇ ಒಂದು ಮಾರ್ಗವಿತ್ತು. ಅದೆಂದರೆ ಮಾಯಾಯಂತ್ರ ಅಂದರೆ ಎಲೆಕ್ಟ್ರಾನಿಕ್‌ ಜಾಲ ರೂಪಿಸುವುದು. ಆದರೆ ಅವರು ಅದನ್ನು ಹೇಗೆ ಸಾಧಿಸಬಲ್ಲರು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/202930/size7/56578534ef3390627c24976344c17172.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/202930/size7/56578534ef3390627c24976344c17172.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-150622","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-150622","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":728,"opdsId":"urn:uuid:SW-612293","title":"ಅಜ್ಜನ ಪ್ರತಿಭಟನೆ","authors":["Sriram MS"],"language":"","readingLevel":"","publisher":"","summary":"ಎಷ್ಟೋ ಅಜ್ಜಂದಿರು ತಮ್ಮ ವಿರಾಮ ಕುರ್ಚಿಯಲ್ಲಿ ಕೂತು ದಿನದ ಪತ್ರಿಕೆಯನ್ನು ಸೋಮಾರಿಗಳ ಹಾಗೆ ಓದಿ ಕಾಲ ಕಳೆಯುತ್ತಾರೆ. ಆದರೆ, ಮರಗಳನ್ನು ಪ್ರೀತಿಸುವ ನಮ್ಮ ವರಿಷ್ಠ ಹಾಗಲ್ಲ. ತನ್ನ ಪ್ರೀತಿಯ ಮರಗಳಿಗಾಗಿ ಅವನು ಪ್ರತಿಭಟಿಸುತ್ತಾನೆ. ಈ ಪ್ರಕ್ರಿಯೆಯಲ್ಲಿ ಆಗುವ ಅನೇಕ ತಮಾಷೆಯ ಘಟನೆಗಳು ಈ ಕತೆಯನ್ನು ಮನೋರಂಜಕವಾಗಿಸುತ್ತವೆ. ಅಂದಿನ ಪರಿಸ್ಥಿತಿಯನ್ನೂ, ಮರಗಳನ್ನು ರಕ್ಷಿಸಿದವರು ಯಾರೆಂದು ಈ ಕತೆ ಓದಿ ತಿಳಿಯಿರಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/697279/size7/ac806eb8fbccf09f3be7e392bb3ba9b2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/697279/size7/ac806eb8fbccf09f3be7e392bb3ba9b2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-612293","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-612293","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":729,"opdsId":"urn:uuid:SW-87831","title":"ಇಲಿಗೆ ಏನನ್ನು ಕಂಡರೆ ಭಯ?","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂದು ದೆವ್ವವಿತ್ತು. ಅದಕ್ಕೆ ಎಲ್ಲರನ್ನೂ ಹೆದರಿಸಿ ಮೋಜು ನೋಡುವುದು ಬಲೇ ಇಷ್ಟ. ಆನೆ, ಪೈಲ್ವಾನ ಮತ್ತು  ಸಿಂಹವನ್ನೂ ಕೂಡಾ ಅದು ಹೆದರಿಸಿತು. ಮತ್ತೊಂದು ದಿನ ಯಾರನ್ನಾದರೂ ಸುಲಭವಾಗಿ ಹೆದರಿಸಬಹುದೇನೋ ಅಂತ ಅದು ಹುಡುಕುತ್ತಿತ್ತು ಇತ್ತು. ಆಗ ಅದಕ್ಕೆ ಇಲಿ ನೆನಪಾಯಿತು. ಇಲಿ ದೆವ್ವಕ್ಕೆ ಹೆದರಿತಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/617117/size7/f46f95b0a9c9d93baa8531860a28a997.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/617117/size7/f46f95b0a9c9d93baa8531860a28a997.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-87831","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-87831","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":730,"opdsId":"urn:uuid:SW-596184","title":"ಬಂಡೆಗಳ ಗುಟ್ಟು ಕೇಳಿ","authors":["Prakrithi  K"],"language":"","readingLevel":"","publisher":"","summary":"ಬಂಡೆಗಳು ಎಲ್ಲೆಡೆಯೂ ಕಾಣಸಿಗುತ್ತವೆ - ಭೂಮಿಯೊಳಗೆ, ಭೂಮಿ ಮೇಲೆ, ಅಷ್ಟೇ ಏಕೆ ಸಮುದ್ರತಳದಲ್ಲೂ ಇರುತ್ತವೆ. ಆದರೆ, ಈ ಬಂಡೆಗಳು ಬರುವುದಾದರೂ ಎಲ್ಲಿಂದ? ಅವು ಯಾವುದರಿಂದ ಮಾಡಲ್ಪಟ್ಟಿವೆ? ಕಲ್ಲುಬಂಡೆಗಳು ಮಾತನಾಡುವ ಹಾಗಿದ್ದರೆ, ಅದೆಷ್ಟು ರಹಸ್ಯಗಳನ್ನು ನಮ್ಮೊಂದಿಗೆ ಹಂಚಿಕೊಳ್ಳುತ್ತಿದ್ದವೋ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716006/size7/2a7fc11e509d305c2c43159bbedf1d55.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716006/size7/2a7fc11e509d305c2c43159bbedf1d55.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-596184","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-596184","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":731,"opdsId":"urn:uuid:SW-91435","title":"ಜೇಡರ ಚಾಲ್ಯ","authors":["Divaspathy Hegde"],"language":"","readingLevel":"","publisher":"","summary":"ತನ್ನ ಹೆಸರು ಪ್ರಸಿದ್ಧಿಗೆ ಬರಬೇಕು ಎಂದು ಜೇಡರ ಚಾಲ್ಯ ಏನೆಲ್ಲ ಮಾಡಿತು. ಪ್ರಸಿದ್ಧಿಯ ಬೆನ್ನು ಹತ್ತಿದ ಚಾಲ್ಯ ಎಲ್ಲರೂ ಶಹಬ್ಬಾಸ್ ಎನ್ನುವ ಯಾವ ಕೆಲಸ ಮಾಡಿತು? ತಿಳಿಯಲು ಜೇಡರ ಚಾಲ್ಯ ಹಾಗೂ ಅದರ ಸ್ನೇಹಿತರ ಈ ಕಥೆ ಓದಿ..","coverUrl":"https://static.storyweaver.org.in/illustration_crops/42477/size7/e83469ed44a4c419d4491f9e892e570d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/42477/size7/e83469ed44a4c419d4491f9e892e570d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-91435","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-91435","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":732,"opdsId":"urn:uuid:SW-144111","title":"ಮನೆ","authors":["G W Carlo"],"language":"","readingLevel":"","publisher":"","summary":"ಹಸೀನಾ ಮತ್ತು ಅವಳ ಕುಟುಂಬದವರು ಸದಾ ಮಳೆಯಿಂದ ಜಿನುಗುಡುತ್ತಿದ್ದ ಅವರ ಹಳ್ಳಿಯಲ್ಲಿ ನೆಮ್ಮದಿಯಿಂದ ವಾಸಿಸುತ್ತಿದ್ದರು. ಒಂದು ದಿನ ದುರದೃಷ್ಟವಶಾತ್ ಹಸೀನಾ ಮತ್ತು ಅವಳ ತಾಯಿ ದೊಡ್ಡದೊಂದು ಕಂಟಕಕ್ಕೆ ಸಿಲುಕಿ ಕುಟುಂಬದಿಂದ ಬೇರ್ಪಟ್ಟರು. ನಂತರ ಜೀವ ಭಯದಿಂದ ಸಾಗುತ್ತಿದ್ದ ಜನರ ಗುಂಪನ್ನು ಸೇರಿ ದೇಶವನ್ನೇ ಬಿಟ್ಟು ಹೋಗಬೇಕಾಗುತ್ತದೆ. ತಮ್ಮದೆಲ್ಲವನ್ನೂ ತೊರೆದು ಹೋದ ಅವರು ಹೊಸ ನಾಡಿನಲ್ಲಿ ನಿರಾಶ್ರಿತರು. ಈ ಕತೆ ‘ಮನೆ’ ಎಂದರೆ ಏನು? ಅದನ್ನು ತೊರೆಯುವ ಸಂಕಟ ಮತ್ತು ವಾಪಸ್ಸಾಗುವುದು ಹೇಗೆ ನಮ್ಮ ಆಯ್ಕೆಗೆ ಮೀರಿದ್ದು ಎನ್ನುವುದನ್ನು ವಿಶ್ಲೇಷಿಸುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/518337/size7/f324e69b9a98fdcaed6a391bcd6c4412.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/518337/size7/f324e69b9a98fdcaed6a391bcd6c4412.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-144111","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-144111","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":733,"opdsId":"urn:uuid:SW-119030","title":"ಕ್ರಿಕೆಟ್‌! ಕ್ರಿಕೆಟ್‌!!","authors":["Swati Pandit"],"language":"","readingLevel":"","publisher":"","summary":"ಇಂದು ಕ್ರಿಕೆಟ್ ಪಂದ್ಯ ಮತ್ತು ನಮ್ಮ ಕುಟುಂಬ ಎಲ್ಲರು ಗೆಲುವಿಗಾಗಿ ಪ್ರಾರ್ಥಿಸುತ್ತಿದ್ದಾರೆ. ಆದರೆ, ಆಟಗಾರರು ಕ್ರೀಸ್ ನಲ್ಲೆ ಉಳಿದು, ಚೆನ್ನಾಗಿ ಆಡಬೇಕು ಎಂದರೆ ಸಾಕಷ್ಟು ಸಿದ್ಧತೆ ಬೇಕು. ಎಲ್ಲರು ಸಿದ್ಧರಾಗಿರುವುದು ಅವಶ್ಯ. ಅರೆ, ಆಟಗಾರರಲ್ಲ, ನಮ್ಮ ಕುಟುಂಬದ ಎಲ್ಲ ಸದಸ್ಯರು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727170/size7/a7683f938eb8ed20f706c67c9d1b8b92.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727170/size7/a7683f938eb8ed20f706c67c9d1b8b92.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-119030","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-119030","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":734,"opdsId":"urn:uuid:SW-15102","title":"ಮೂರಾದರೆ  ಉಚಿತ","authors":["R. Venkatesh"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂದಾನೊಂದು ಕಾಲದಲ್ಲಿ ತೈವಾನ್ ನ ಬನ್ ಪಿನ್ ಷಾನ್ ಬೆಟ್ಟದ ಹತ್ತಿರ ಒಂದು ಸಣ್ಣ ಹಳ್ಳಿಯಿತ್ತು. ಅಲ್ಲೊಬ್ಬ ಕಡುಬು ಮಾರುವ ತಿಂಡಿಯಜ್ಜ. ಬಿಸಿ ಕಡುಬು, ಬಿಸಿ ಬಿಸಿ ಕಡುಬು. ‘ಒಂದು ರೂಪಾಯಿಗೆ ಒಂದು, ಎರಡು ರೂಪಾಯಿಗೆ ಎರಡು, ಮೂರಾದರೆ ಉಚಿತ!’ ಎಂದು ಕೂಗುತ್ತಿದ್ದ. ಹಳ್ಳಿಗರೆಲ್ಲ ಒಂದೇ ಸಲಕ್ಕೆ ಮೂರು ಮೂರು ಕಡುಬುಗಳನ್ನು ತಿನ್ನಲು ಶುರು ಮಾಡಿದರು. ಹೆಚ್ಚು ಹೆಚ್ಚು ಜನ ಹೆಚ್ಚು ಹೆಚ್ಚು ಕಡುಬು ತಿನ್ನುತ್ತಿದ್ದಂತೆ ಬೆಟ್ಟದ ಒಂದೊಂದೇ ಭಾಗ ಕರಗುತ್ತಿತ್ತು! ಅದು ಏಕೆಂದು ತಿಳಿಯಲು ಕಥೆ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/699933/size7/53190cd41d58e95d07ea58dae0b26e02.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/699933/size7/53190cd41d58e95d07ea58dae0b26e02.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15102","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15102","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":735,"opdsId":"urn:uuid:SW-311091","title":"ಹರು","authors":["Tanuja Jakkannavar"],"language":"","readingLevel":"","publisher":"","summary":"ಇವನೇ ನೋಡಿ ಹರು. ತಿನ್ನೋದು, ಓಡೋದು, ಆಡೋದಂದ್ರೆ ಇವನಿಗಿಷ್ಟ. ಒಮ್ಮೊಮ್ಮೆ ರಾತ್ರಿ ಮಲಗಲು ಬೆಚ್ಚಗಿನ ಜಾಗ ಹುಡುಕಲು ಕಷ್ಟವಾದರೂ ಒಮ್ಮೊಮ್ಮೆ ಹೊಟ್ಟೆ ತುಂಬ ತಿನ್ನಲು ಸಿಗದಿದ್ದರೂ ಇಂದಿಗಿಂತ ನಾಳೆ ಚೆನ್ನ ಅಂತ ಹರು ನಂಬಿಕೆ. ಪ್ರೀತಿ ಮತ್ತು ಖುಷಿ ಇದ್ದ ಮೇಲೆ ಬದುಕು ಎಂದಿಗೂ ಕೆಟ್ಟದಲ್ಲ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703490/size7/b97ed02bce11100313314b0ad73e7bff.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703490/size7/b97ed02bce11100313314b0ad73e7bff.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-311091","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-311091","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":736,"opdsId":"urn:uuid:SW-28265","title":"ಉನ್ನಿಯ ಆಸೆ","authors":["Srinatha S.V"],"language":"","readingLevel":"","publisher":"","summary":"ಉನ್ನಿಗೆ ಫ್ಯಾನ್ ಕೆಳಗೆ ಮಲಗುವ ಆಸೆ. ತಂಪಾದ ಪಾನಕ ಕುಡಿಯುವುದು, ಟಿವಿಯಲ್ಲಿ ಕಾರ್ಟೂನ್ ನೋಡುವುದೂ ಅವನಿಗೆ ಇಷ್ಟ. ಆದರೆ ಈ ಯಾವುದನ್ನೂ ಮಾಡಲು ಅವನಿಗೆ ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ? ಇವುಗಳನ್ನು ಮಾಡಲಾಗದಂತೆ ಅವನನ್ನು ತಡೆಯುತ್ತಿರುವುದಾದರೂ ಏನು? ಅದನ್ನು ಪತ್ತೆ ಮಾಡಲು ಈ ಕತೆ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/724153/size7/5b8aaa9061ab9de08eeea283b994a6e5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/724153/size7/5b8aaa9061ab9de08eeea283b994a6e5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-28265","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-28265","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":737,"opdsId":"urn:uuid:SW-594350","title":"ಸೀರೆಯಲ್ಲಿ ನಮ್ಮಪ್ಪ","authors":["Dr H M Kumaraswamy"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂದು ನಡು ಮಧ್ಯಾಹ್ನ ಮೌಲಿ ಮತ್ತು ಅಪ್ಪನ ಆಟ. ಬಣ್ಣ ಬಣ್ಣದ ಸೀರೆಗಳಲ್ಲಿ ಬೆಳ್ಳಿ ಬಂಗಾರದ ಬಳ್ಳಿಗಳು. ಬನ್ನಿ ನಾವೂ ಸೇರಿಕೊಳ್ಳೋಣ ಈ ತಮಾಷೆ ಮೋಜಿನಲಿ. ನೋಡುವಾ ಫ್ಯಾಷನ್ ಜಾದೂ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722718/size7/797eed55cd210ef22850880f98c3395d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722718/size7/797eed55cd210ef22850880f98c3395d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-594350","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-594350","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":738,"opdsId":"urn:uuid:SW-85551","title":"ಅಂಕಿ ಸಂಖ್ಯಾಗಾರತಿ ಪೃಕಲ್ಪ","authors":["LC Nagaraj"],"language":"","readingLevel":"","publisher":"","summary":"ಪೃಕಲ್ಪ ಶಂಕರ್ ಗೆ ಸಂಖ್ಯೆಗಳೆಂದರೆ ಅದೇನೋ ಕುತೂಹಲ. ಸಂಖ್ಯೆಗಳಿಂದ ಅವಳಿಗೆ ಅನೇಕ ಮಾದರಿಗಳು ಕಾಣ ಸಿಗುತ್ತವೆ. ಇದರಿಂದ ಸಮುದಾಯಿಕ ಸಮಸ್ಯೆಗಳು ಬಗೆ ಹರಿಯುತ್ತದೆ ಎನ್ನುತ್ತಾರೆ. ಅದು ಹೇಗೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/718388/size7/20706d3f0f69d8952f5afdb3b86786f6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/718388/size7/20706d3f0f69d8952f5afdb3b86786f6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-85551","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-85551","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":739,"opdsId":"urn:uuid:SW-109100","title":"ಮುಂಡು ಮಾತ್ರಿಕರು","authors":["Dr Parvathi  Aithal"],"language":"","readingLevel":"","publisher":"","summary":"ತನ್ನ ಅಜ್ಜಿಯಂತೆಯೇ ಮುಂಡು ಮಾತ್ರಿಕನಾಗಬೇಕೆಂಬುದು ಉಣ್ಣಿಯ ಆಸೆ. ಅಜ್ಜಿಯ ಹಳೆಯ ಮುಂಡುಗಳಿಂದ ಅವನು ಏನು ಮಾಡಬಹುದು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727155/size7/bdd4148a9ee1b51b8a0aaf8e6bf57d54.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727155/size7/bdd4148a9ee1b51b8a0aaf8e6bf57d54.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-109100","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-109100","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":740,"opdsId":"urn:uuid:SW-125678","title":"ಸೂರಕ್ಕಿಗಳು ದಿನವಿಡೀ ತಿನ್ನುವುದೇಕೆ?","authors":["Kalgundi Naveen"],"language":"","readingLevel":"","publisher":"","summary":"ನಿಮ್ಮ ಕೈತೋಟದಲ್ಲಿ ಹಾರಾಡುವ ವರ್ಣಮಯ, ಪುಟ್ಟ ಪಕ್ಷಿಯನ್ನು ಎಂದಾದರು ನೀವು ನೋಡಿರುವಿರಾ? ಅವು ಏಕೆ ಹೂವಿನಿಂದ ಹೂವಿಗೆ ಹಾರಾಡುತ್ತಿರುತ್ತವೆ? ಗಾಳಿಯಲ್ಲಿ ತೇಲುತ್ತಿರಲು ಅವುಗಳಿಗೆ ಶಕ್ತಿ ಎಲ್ಲಿಂದ ಬರುತ್ತದೆ? ಹಾಗಾದರೆ, ಲೋಟೆನ್ ಮತ್ತು ಲಿಲ್ಲಿ ಸೂರಕ್ಕಿಗಳನ್ನು ಹಿಂಬಾಲಿಸಿ, ಕಂಡುಹಿಡಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/182229/size7/d1128f16e5c04c2aad8cb4486a209f1e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/182229/size7/d1128f16e5c04c2aad8cb4486a209f1e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-125678","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-125678","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":741,"opdsId":"urn:uuid:SW-75639","title":"ಸಂಕೇತಗಳನ್ನು ಭೇದಿಸಿದವರು: ಕಂಪ್ಯೂಟರ್ ಕಾರ್ಯವೈಖರಿ ಬದಲಿಸಿದ ಮಹಿಳಾ ತಜ್ಞರು","authors":["Vasanth Nadiger"],"language":"","readingLevel":"","publisher":"","summary":"19ನೇ ಶತಮಾನದ ಇಂಗ್ಲಿಷ್ ಗಣಿತಶಾಸ್ತ್ರಜ್ಞೆ ಅಡಾ ಲವ್‍ಲೇಸ್, ಹೊಸ ತಲೆಮಾರಿನ ಫ್ಯಾಶನ್ ಡಿಸೈನರ್ ಅನೌಕ್ ವಿಪ್ರೆಕ್ಟ್ ಹಾಗೂ ತೈವಾನಿನ ಡಿಜಿಟಲ್ ಖಾತೆಯ ಹಾಲಿ ಸಚಿವೆ ಆಡ್ರೆ ಟ್ಯಾಂಗ್ ಅವರೆಲ್ಲರ ನಡುವಿನ ಸಾಮ್ಯವೇನು? ಕಂಪ್ಯೂಟರ್‌ಗಳು ಹಾಗೂ ಕೋಡಿಂಗ್ ಅನ್ನು ನಾವೀಗ ನೋಡುತ್ತಿರುವ ರೀತಿಯ ಮೇಲೆ ಅವರು ಪ್ರಭಾವ ಬೀರಿದ್ದಾರೆ. ಒಂದು ಶತಮಾನದ ಅವಧಿಯಲ್ಲಿ ತಂತ್ರಜ್ಞಾನ ಜಗತ್ತು ಕಂಡಿರುವ ಕೆಲವು ಪ್ರೇರಣಾದಾಯಕ ಮಹಿಳೆಯರನ್ನು ಈ ಪುಸ್ತಕ ಪರಿಚಯಿಸುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/718336/size7/673001d175ce2760146ea7f626f8e1f0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/718336/size7/673001d175ce2760146ea7f626f8e1f0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-75639","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-75639","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":742,"opdsId":"urn:uuid:SW-457089","title":"ಕತೆಗಳಿಂದ... ಕತೆಗಳು","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಖುಷಿ, ಖುಷಿ, ಖುಷಿ ಕಾಡಿನಲ್ಲಿ ಜರ್ನಲಿಸ್ಟ್ ಕರಡಿಗೆ ‘ಬ್ರೇಕಿಂಗ್ ನ್ಯೂಸ್’ ಮಾಡಲು ಕತೆ ಸಿಗುತ್ತಿಲ್ಲ. ಅದಕ್ಕಾಗಿ ಅದು ತುಂಬಾ ಬೇಸರದಲ್ಲಿದೆ. ‘ಬ್ರೇಕಿಂಗ್ ನ್ಯೂಸ್’ ಮಾಡಲು ಕತೆಯಿಲ್ಲದ ಜರ್ನಲಿಸ್ಟ್ ಕರಡಿಯ ಕತೆ ಏನಾಗಿರಬಹುದು ಅಂತ ನಿಮಗೆ ಊಹಿಸಲು ಸಾಧ್ಯವೇ? ಅಲ್ಲಿಗೆ ಬರುವ ಹಾಡುಗಾರ ಸರ್ದಾರ್ಜಿ ಜರ್ನಲಿಸ್ಟ್ ಕರಡಿಗೆ ಅದು ನಿಜವಾಗಿಯೂ ಯಾರೆಂದು ಕಂಡುಕೊಳ್ಳಲು ಸಹಾಯ ಮಾಡುತ್ತಾನೆ. ಕತೆಗಳ ಶಕ್ತಿ, ಅವುಗಳ ಮಾಂತ್ರಿಕತೆ, ಕತೆ ನೇಯುವ ಜನರನ್ನು ಕೊಂಡಾಡುವ ಈ ಕತೆಯನ್ನು ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/699237/size7/a73ebf9c0be3829daf205c8376e0f49d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/699237/size7/a73ebf9c0be3829daf205c8376e0f49d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-457089","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-457089","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":743,"opdsId":"urn:uuid:SW-577189","title":"ಅಳಿಲು ಶಾಲೆಗೆ ಹೋಗುತ್ತದೆ","authors":["Bhat Ananthesha"],"language":"","readingLevel":"Level 2","publisher":"","summary":"ಪುಟ್ಟ ಅಳಿಲು, ಮೇಘ ಅತ್ಯುತ್ತಮ ಸ್ನೇಹಿತರು. ಇಬ್ಬರೂ ತುಂಬಾ ಸಂತೋಷದಿಂದ ಹಳ್ಳಿಯಲ್ಲಿ ವಾಸಿಸುತ್ತಿದ್ದಾರೆ. ಒಂದು ದಿನ, ಇಬ್ಬರೂ ಶಾಲೆಗೆ ಹೋಗೋಣ ಎಂದು ಹೇಳಿದರು. ಶಾಲೆಗೆ ಹೋಗುವುದೇ? ಶಾಲೆಗೆ ಹೋಗುವುದು ಮೋಜು ಅಲ್ಲ, ಆದರೆ ಶಾಲೆಯು ದೂರದಲ್ಲಿದೆ, ಕಾಡಿನ ಮೂಲಕ ಹೋಗುವಾಗ ಅನೇಕ ಕಾಡು ಪ್ರಾಣಿಗಳು ಇರಬಹುದು. ಅಳಿಲಿಗೆ  ಹೋಗಲು ಇಷ್ಟವಿಲ್ಲ. ಇನ್ನೂ ದಾರಿಯಲ್ಲಿ ಏನಾಯಿತು...","coverUrl":"https://static.storyweaver.org.in/illustration_crops/119964/size7/3103ddb647070d37eccd9a8555696161.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/119964/size7/3103ddb647070d37eccd9a8555696161.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-577189","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-577189","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":744,"opdsId":"urn:uuid:SW-307383","title":"ಪತ್ರ ಚಿತ್ತಾರ","authors":["LC Nagaraj"],"language":"","readingLevel":"","publisher":"","summary":"ಕೆಲವು ಎಲೆಗಳು ತುಂಬಾ ಕಿರಿದು. ಆದರೆ, ಬೇರೆ ಎಲೆಗಳು ಹಾಗಲ್ಲ. \nಕೆಲವು ಎಲೆಗಳದು ಸಿಹಿರುಚಿ, ಕೆಲವು ಎಲೆಗಳು ತುಂಬಾ ಕಹಿ. \nನಮ್ಮ ಸುತ್ತಲೂ ಅನೇಕ ಬಗೆಯ ಎಲೆಗಳಿವೆ. ಈ ಪುಸ್ತಕದ \nಪುಟ ತೆರೆಯುತ್ತ ಎಲೆಗಳ ಕುರಿತು ತಿಳಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725226/size7/853dcaabef8ae2b388b4ccc36003a038.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725226/size7/853dcaabef8ae2b388b4ccc36003a038.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-307383","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-307383","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":745,"opdsId":"urn:uuid:SW-105687","title":"ಪಿಕುವಿನ ಪುಟ್ಟ ಪ್ರಪಂಚ","authors":["Srinidhi  TG"],"language":"","readingLevel":"reading","publisher":"","summary":"ಬೇಸಿಗೆಯ ದೀರ್ಘ ಮಧ್ಯಾಹ್ನಗಳೆಂದರೆ ಪಿಕುವಿಗೆ ತುಂಬಾ ಇಷ್ಟ. ಬೇಸಿಗೆಯ ಸಂಜೆ ನಂತರ ಆವರಿಸುವ ಕತ್ತಲೆ ಮಾತ್ರ ಅವನಿಗೆ ಇಷ್ಟವಿಲ್ಲ. ಇದ್ದಕ್ಕಿದ್ದ ಹಾಗೆ ಕತೆ ಓದಿ ಹೇಳಲು ಯಾರೂ ಇಲ್ಲದ್ದನ್ನು ನೋಡಿ ಅವನಿಗೆ ಮಧ್ಯಾಹ್ನವೇ ಕತ್ತಲೆಯಾದಂತೆ ಭಾಸವಾಯಿತು. ಪಿಕುಗೆ ಪುಸ್ತಕಗಳನ್ನು ಓದುವವರು ಯಾರು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/157681/size7/ba42069ffa44213dbf0574fc90eefab9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/157681/size7/ba42069ffa44213dbf0574fc90eefab9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-105687","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-105687","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":746,"opdsId":"urn:uuid:SW-36577","title":"ನೊರೆ ಗುಳ್ಳೆಗಳು ಗುಂಡಾಗಿವೆ ಏಕೆ?","authors":["soma shekar"],"language":"","readingLevel":"","publisher":"","summary":"ಮಾಯಾ ಮತ್ತು ಮನು ನೊರೆ ಗುಳ್ಳೆಗಳಲ್ಲಿ ನಾನಾ ಆಕಾರಗಳನ್ನು ಮಾಡಬಹುದೇ ಎಂದು ನೋಡಲು ಬಯಸುತ್ತಾರೆ. ಈ ಕತೆ ಓದುವ ಮೂಲಕ ಅವರಂತೆ ನೀವೂ ಕೂಡ ನೊರೆ ಗುಳ್ಳೆಗಳು ಮತ್ತು ಅವುಗಳ ಆಕಾರಗಳ ಬಗ್ಗೆ ತಿಳಿಯಬಹುದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717015/size7/7e694fb5fdd89111f6964e007a88db37.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717015/size7/7e694fb5fdd89111f6964e007a88db37.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-36577","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-36577","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":747,"opdsId":"urn:uuid:SW-94597","title":"ಪ್ರಕೃತಿಯ ನೇಕಾರರು","authors":["Jayashree Deshpande"],"language":"","readingLevel":"","publisher":"","summary":"ಪ್ರಕೃತಿಯು ಊಹೆಗೂ ಮೀರಿದ ಆಚ್ಚರಿಗಳ ಆಗರ. ಜೇಡಗಳ ಜೀವನದ ಬಗ್ಗೆಯ ಈ ಸ್ವಾರಸ್ಯಕರ ಕಥನವನ್ನು ರಂಜಿತ್ ಲಾಲ್‌ರ ಅನುಕರಿಸಲಾಗದ ಶೈಲಿಯಲ್ಲೇ ಓದಿ! ಈ ಪುಸ್ತಕವು ಪ್ರಕೃತಿಯ ಅಸಲೀ ಬಲೆಗಾರನ ಬಗ್ಗೆ ಮಾಹಿತಿ ಹಾಗೂ ಆಸಕ್ತಿದಾಯಕ ವಿಷಯಗಳಿಂದ ಕೂಡಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722330/size7/119fe6c3bdf3723f7f50aa6e75f275dc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722330/size7/119fe6c3bdf3723f7f50aa6e75f275dc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-94597","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-94597","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":748,"opdsId":"urn:uuid:SW-460592","title":"ತಿನ್ನೋಣ ಬಾ…","authors":["Poojashree K"],"language":"","readingLevel":"","publisher":"","summary":"ತರಗೆಲೆಗಳೋ, ಹೇನುಗಳೋ ಅಥವಾ ತನ್ನದೇ ಪಿಕ್ಕೆ! ಪ್ರಾಣಿಗಳಿಗೆ ತಮ್ಮ ಆವಾಸ ಸ್ಥಾನಕ್ಕೆ ತಕ್ಕಂತೆ ತಿನ್ನುವುದು ರೂಢಿ. ಅವುಗಳಿಗೆ ಬೇಕಾಗುವ ಪೋಷಕಾಂಶಗಳನ್ನು ಪಡೆದು ಬಲಿಷ್ಠವಾಗಿರಲು, ಅದರಂತೆ ಆಹಾರ ಅಭ್ಯಾಸವನ್ನು ಹೊಂದಿಸಿಕೊಳ್ಳುವ ಬಗೆಯನ್ನು ಈ ಕತೆಯಲ್ಲಿ ತಿಳಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/444491/size7/71c51cabe1a1d9cdf76d02a72a941c01.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/444491/size7/71c51cabe1a1d9cdf76d02a72a941c01.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-460592","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-460592","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":749,"opdsId":"urn:uuid:SW-577010","title":"ಸಮವಾಗಿ ಹಂಚಿಕೊಳ್ಳಿ!","authors":["Bhat Ananthesha"],"language":"","readingLevel":"Level 2","publisher":"","summary":"ಸಮಾನವಾಗಿ ಹಂಚಿಕೊಳ್ಳಲು ಕಷ್ಟವಾದಾಗಲೂ ಅದನ್ನು ನ್ಯಾಯಯುತವಾಗಿ ಹಂಚಿಕೊಳ್ಳುವುದರ ಪ್ರಾಮುಖ್ಯತೆಯ ಕುರಿತು ಗಣಿತದ ಕಥೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/100183/size7/eae981e4460f554e1167a7a508b37de4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/100183/size7/eae981e4460f554e1167a7a508b37de4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-577010","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-577010","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":750,"opdsId":"urn:uuid:SW-244343","title":"ಆಕರ್ಷಕ ಫಿಬೊನಾಚಿ!","authors":["Aparna Prasanna"],"language":"","readingLevel":"","publisher":"","summary":"ಸುಮಾರು ಒಂದು ಸಾವಿರ ವರ್ಷಗಳ ಹಿಂದೆ ಹೇಮಚಂದ್ರ ಎಂಬ ಭಾರತೀಯ ವಿದ್ವಾಂಸರು ಆಸಕ್ತಿಕರ ಸಂಖ್ಯಾ ಅನುಕ್ರಮವೊಂದನ್ನು ಶೋಧಿಸಿದರು. ಇದಾದ ಒಂದು ಶತಮಾನದ ನಂತರ ಈ ಅನುಕ್ರಮವು ಇಟಲಿಯ ಗಣಿತಜ್ಞ, ಲಿಯನಾರ್ಡೊ ಫಿಬೊನಾಚಿಯ ಗಮನವನ್ನು ಸೆಳೆಯಿತು. ಆತ ಇದರ ಬಗ್ಗೆ ಬರೆದ ನಂತರ ಇದನ್ನು ಫಿಬೊನಾಚಿ ಅನುಕ್ರಮವೆಂದು ಕರೆಯಲಾಯಿತು. ಇದು ಸರಳವಾಗಿದ್ದರೂ ಕೂಡ ಆಕರ್ಷಣೀಯವಾಗಿದೆ, ಕಾರಣ ಇದರ ನಿರ್ದಿಷ್ಟ ಸಂಖ್ಯಾ ಶ್ರೇಣಿಯು ನಿಸರ್ಗದಲ್ಲಿ ಹಲವು ಬಾರಿ ಪುನರಾವರ್ತಿಸಿದೆ; ಹೂವು, ಕಪ್ಪೆಚಿಪ್ಪು, ಮೊಟ್ಟೆ, ಬೀಜ, ನಕ್ಷತ್ರಗಳಲ್ಲಿ.... ಇದರ ಬಗ್ಗೆ ಇನ್ನಷ್ಟು ವಿಷಯಗಳನ್ನು ಈ ಪುಸ್ತಕದಿಂದ ತಿಳಿದುಕೊಳ್ಳಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712400/size7/10f094938687f1ee29a48d028eca1101.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712400/size7/10f094938687f1ee29a48d028eca1101.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-244343","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-244343","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":751,"opdsId":"urn:uuid:SW-65360","title":"ಮಳೆ ತರಿಸಿದ ಗಡಿಬಿಡಿರಾಯ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಕೆಟ್ಟ ಹಾಡಿಗೆ ಹೆಸರಾದ ಕತ್ತೆರಾಯನ ಮಗನೇ ಗಡಿಬಿಡಿರಾಯ! ಭಾರತದ ಸಣ್ಣ ಊರೊಂದರಲ್ಲಿ ಇದ್ದಾನೆ. ಅಪ್ಪನಂತೆಯೇ ಅವನದೂ ಕೆಟ್ಟ ಧ್ವನಿ. ಅದು ಇಡೀ ಊರಿಗೆ ಗೊತ್ತು - ಗಡಿಬಿಡಿ ಒಬ್ಬನನ್ನು ಬಿಟ್ಟು. ಹೊಟ್ಟೆಪಾಡಿಗಾಗಿ ಸಣ್ಣಪುಟ್ಟ ಕೆಲಸಗಳನ್ನು ಮಾಡುತ್ತಾ, ಕಷ್ಟಗಳಿಗೆ ಹೆದರದೆ ಸದಾ ಹಾಡಿಕೊಂಡು ಕೆಲಸ ಸಾಧಿಸುವವನೇ ಈ ಗಡಿಬಿಡಿ. ಇದೋ, ಪಂಚರ್ ಹಾಕಲು ನೀರು ಹುಡುಕುತ ಹೊರಟ ಗಡಿಬಿಡಿರಾಯನಿಗೆ ದಾರಿಬಿಡಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727059/size7/2e28482892278aceea1647757d2c7ade.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727059/size7/2e28482892278aceea1647757d2c7ade.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-65360","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-65360","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":752,"opdsId":"urn:uuid:SW-592973","title":"ಹಾರಾಡುವ ಗೂಡು","authors":["Dr Akshata Shanbhag"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂದು ಹಕ್ಕಿ ತನ್ನ ಗೂಡು ಕಟ್ಟಲು ಜಾಗ ಹುಡುಕುತ್ತಿದೆ. ಮರದಲ್ಲಿ ಗೂಡು ಕಟ್ಟುತ್ತದೆ, ಹಕ್ಕಿ ಅಂದುಕೊಂಡಷ್ಟು ಒಳ್ಳೆಯ ಜಾಗವಲ್ಲ ಅದು. ನಂತರ  ಮನೆಯೊಂದರಲ್ಲಿ ಗೂಡು ಕಟ್ಟಲು ನಿರ್ಧರಿಸುತ್ತದೆ. ಅಲ್ಲೂ ಅದಕ್ಕೆ ಇಷ್ಟವಾಗುವುದಿಲ್ಲ. ಅಷ್ಟಕ್ಕೂ, ಈ ಹಕ್ಕಿ ತನ್ನ ಹೊಸ ಗೂಡನ್ನು ಎಲ್ಲಿ ಕಟ್ಟುತ್ತದೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/100169/size7/6ba43714a19f5bc87346890ae7c45e3b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/100169/size7/6ba43714a19f5bc87346890ae7c45e3b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-592973","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-592973","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":753,"opdsId":"urn:uuid:SW-604711","title":"ಚಿಟ್ಟೆ, ಫ್ರೆಂಡ್ಶಿಪ್ ಬಿಟ್ಟೆ","authors":["Raghavendra Acharya"],"language":"","readingLevel":"","publisher":"","summary":"ಆಯಿಷಾ, ಮರಿಯಾ ಒಳ್ಳೆ ಫ್ರೆಂಡ್ಸ್ ಆಗಿದ್ರು. ಆದ್ರೆ, ಯಾವಾಗ ಒಂದಿನ ಕ್ಲಾಸ್ ಟೀಚರ್ ಮರಿಯಾ ಹಾಡೋದನ್ನ ಹೊಗಳಿದ್ರೋ, ಅಲ್ದೇ ಶಾಲಾ ನಾಟಕದಲ್ಲಿ ಆಯಿಷಾ ಬದ್ಲು ಮರಿಯಾಗೇ ‘ಚಿಟ್ಟೆ’ ಪಾತ್ರ ಸಿಕ್ತೋ, ಆವತ್ತಿಂದ ಆಯಿಷಾ ಮರಿಯಾ ನಡುವೆ ಅಂತರ ಬೆಳೀತು. ಆಯಿಷಾ ಮನಸಿಗೆ ಎಷ್ಟ್ ನೋವಾಯ್ತಂದ್ರೆ, ಯಾಕೆ ತನ್ನ ಬದಲು ಮರಿಯಾಗೇ ಒಳ್ಳೆದಾಗತ್ತೆ ಅಂತ ಅವಳಿಗನಿಸಿತು! ಅಸೂಯೆ ಅದರ ಜತೆ ಬರೋ ಗೊಂದಲದ ಬಗ್ಗೆ ಒಂದು ಕತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/706686/size7/0cf9d097cfc1b13a45d8dd3f5f5af35f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/706686/size7/0cf9d097cfc1b13a45d8dd3f5f5af35f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-604711","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-604711","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":754,"opdsId":"urn:uuid:SW-283176","title":"ಡಮರು","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಒಮ್ಮೆ ಒಂದು ದೊಡ್ಡ ಹಳ್ಳಿ ಇತ್ತು. ಹಳ್ಳಿಯಲ್ಲಿ ಒಂದು ಶಾಲೆ ಇತ್ತು, ಅಲ್ಲಿ ಒಂದು ಆಟವನ್ನು ಆಡಲಾಗುತ್ತಿತ್ತು. ಮಿಮಿ ಬಿಟ್ಟು ಎಲ್ಲರೂ ಆ ಆಟ ಆಡುತ್ತಿದ್ದಾರೆ. ಆ ಮಜವಾದ ಆಟದಲ್ಲಿ ಅಕ್ಕ ಮಿಮಿಯನ್ನು ಹೇಗೆ ಸೇರಿಸಿಕೊಂಡಳು ಗೊತ್ತಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/696860/size7/f063ab8ef5b65080f809e4d3dbb4f548.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/696860/size7/f063ab8ef5b65080f809e4d3dbb4f548.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-283176","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-283176","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":755,"opdsId":"urn:uuid:SW-114845","title":"ಬಿಟ್ಟು ಬೊಟ್ಟು ಹೇಗೆ ಸುಧಾರಿಸಿದ?","authors":["Nagaraj Vaidya"],"language":"","readingLevel":"","publisher":"","summary":"ಆ್ಯಂಡಿಯ ರೋಬೋಟ್ ಬಿಟ್ಟು ಬೊಟ್ಟು ಅವನಿಗಾಗಿ ಮನೆಗೆಲಸದಿಂದ ಹಿಡಿದು, ಹೋಂವರ್ಕ್‌ ಅನ್ನೂ ಮಾಡಿ ಕೊಡುತ್ತಿತ್ತು. ಆದರೆ ಬಿಟ್ಟು ಬೊಟ್ಟು ತೊಂದರೆಗೆ ಸಿಲುಕಿದಾಗ ಆ್ಯಂಡಿ ಏನು ಮಾಡಿದನು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/719969/size7/047b6eff4aff561cb4f986eacc642bf7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/719969/size7/047b6eff4aff561cb4f986eacc642bf7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-114845","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-114845","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":756,"opdsId":"urn:uuid:SW-536157","title":"ಬಾಹ್ಯಾಕಾಶದಲ್ಲೊಂದು ಹಾಡು: ಕೇಸರ್‌ಬಾಯಿ ಕೇರ್ಕರ್","authors":["Keshava Malagi"],"language":"","readingLevel":"","publisher":"","summary":"ಪುಟ್ಟ ಕೇಸರ್‌ಳಿಗೆ ಹಾಡುವುದು ಎಂದರೆ ಅಚ್ಚುಮೆಚ್ಚು ತನ್ನ ಧ್ವನಿಯು ಜಗದಗಲ ಮತ್ತು ಆಕಾಶದಾಚೆ ವ್ಯಾಪಿಸುವುದು ಎಂಬುದನ್ನು ಅವಳು ಊಹಿಸಿಯೂ ಇರಲಿಲ್ಲ.  ಇದು ಪ್ರಸಿದ್ಧ ಗಾಯಕಿ ಕೇಸರ್‌ಬಾಯಿ ಕೇರ್ಕರ್ ಅವರ ಅದ್ಭುತ ಸಂಗೀತ ಪ್ರಯಾಣದ ಬಗೆಗಿನ ಕತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727643/size7/cabddb8b05a4b92bfac968bdfb43ad47.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727643/size7/cabddb8b05a4b92bfac968bdfb43ad47.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-536157","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-536157","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":757,"opdsId":"urn:uuid:SW-294155","title":"ನನ್ನ ಕೆಂಪು ಟಿ-ಶರ್ಟ್‌","authors":["Hema Hebbagodi"],"language":"","readingLevel":"","publisher":"","summary":"ಅಮನ್‌ಗೆ ಅವನ ಮೆತ್ತಗಿನ ಕೆಂಪು ಟಿ-ಶರ್ಟ್ ಕಂಡರೆ ಬಹಳ ಇಷ್ಟ. ಅದು ಹಳೆಯದಾಗಿ, ತೂತು ಬಿದ್ದಿದೆ ಅಂತ ಅವನಮ್ಮನಿಗೆ ಅದನ್ನು ಕಂಡರೆ ಇಷ್ಟವಿಲ್ಲ. ಅವಳು ಅದನ್ನು ಬಿಸಾಕೋಣ ಅಂತಿದ್ದಾಳೆ. ಅವನಿಗದನ್ನು ಇಟ್ಟುಕೋಬೇಕು ಅಂತಿಷ್ಟ. ಅಮನ್‌ ಏನು ಮಾಡುತ್ತಾನೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/719500/size7/7a8e3961bad059f312c0aae8026e38ea.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/719500/size7/7a8e3961bad059f312c0aae8026e38ea.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-294155","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-294155","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":758,"opdsId":"urn:uuid:SW-603457","title":"ಲಾಕ್‌ಡೌನ್‌ನಲ್ಲೊಂದು ಹುಟ್ಟುಹಬ್ಬ!","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಇಂದು ಕಾಂಚಿಯ ಹುಟ್ಟುಹಬ್ಬ. ಅವಳಿಷ್ಟದ ಹೋಟಲ್‌ಗೆ ಹೋಗಲು ಸಾಧ್ಯವಿಲ್ಲ. ಮನೆಯಲ್ಲಿ ಬದನೆಕಾಯಿ ಭರ್ತಾ ಮಾತ್ರ ಮಾಡುತ್ತಾರೆ ಎನ್ನುವ ದುಃಖ ಅವಳದು. ಆದರೆ, ಸನ್‌ರೈಸ್ ಸೊಸೈಟಿಯಲ್ಲಿರುವ ಅವಳ ನೆರೆಹೊರೆಯವರಿಗೆ ಈ ಪರಿಸ್ಥಿತಿಯನ್ನು ಹೇಗೆ ಮೋಜಿನ ಸತ್ಕಾರವಾಗಿ ಪರಿವರ್ತಿಸಬೇಕೆಂದು ತಿಳಿದಿದೆ! ಇದು ಸಮುದಾಯ, ಪರಸ್ಪರ ಸಹಾನುಭೂತಿ ಮತ್ತು ನಮ್ಮ ಆಹಾರ ಪದ್ಧತಿಯ ಕತೆಯಾಗಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727417/size7/6a5199c6c3a470dbd30154529ea8a4bc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727417/size7/6a5199c6c3a470dbd30154529ea8a4bc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-603457","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-603457","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":759,"opdsId":"urn:uuid:SW-586636","title":"ಮಣ್ಣು","authors":["Pushpak M"],"language":"","readingLevel":"","publisher":"","summary":"ಪುಟ್ಟ ಮಕ್ಕಳಿಗೆ ಮಣ್ಣಿನ ಉಪಯೋಗ ಹಾಗೂ ಮಹತ್ವವನ್ನು ತಿಳಿಸುವ ಕತೆ ಇದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/99631/size7/85e412aabd5092ebb3d97b6a3773b838.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/99631/size7/85e412aabd5092ebb3d97b6a3773b838.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-586636","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-586636","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":760,"opdsId":"urn:uuid:SW-47916","title":"ಸಿರ್... ಚಿರ್","authors":["Swati Pandit"],"language":"","readingLevel":"","publisher":"","summary":"ಅಮ್ಮೋ! ಏನದು? ಅದು ಜಿರಲೆ ಮೀಸೆಯ ಮಿಸುಕಾಟವೇ? ಸಿಕ್ಕೂ, ಸಿಗದಂತೆ ಓಡುವ ಜಿರಲೆ ಬಗ್ಗೆ ಇಲ್ಲಿದೆ ಒಂದು ಮಜವಾದ ಕವಿತೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/99507/size7/5fedd9cf8a782807f6053d707be4d8b3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/99507/size7/5fedd9cf8a782807f6053d707be4d8b3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-47916","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-47916","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":761,"opdsId":"urn:uuid:SW-668788","title":"ಭಲೇ ಭಲೇ ಆರು ಆರಾರು!","authors":["Sriram MS"],"language":"","readingLevel":"","publisher":"","summary":"ಬುಲ್‌ಬಲಿ ಮತ್ತು ಮೈನಾಗೆ ನಂಬರ್ 6 ಅಂದರೆ ಸ್ವಲ್ಪ ಭಯ. ಕುಕ್ಕೂ ಅನ್ನುತ್ತಾ ಹೊಲದಲ್ಲಿ ಕಾಣುವ ಪ್ರಾಣಿಗಳೆಲ್ಲವನ್ನೂ, ಜೋರಾಗಿ ಅಟ್ಟಿಸಿಕೊಂಡು ಹೋಗುವ ಹುಂಜದ ಸಾಮರ್ಥ್ಯವನ್ನು ನೋಡಿದರೆ ಭಯ ಆಗುವುದು ಸಹಜವೇ. ಆದರೆ, ತುಂಬಾ ಭಯ ಹುಟ್ಟಿಸೋ ಪ್ರಾಣಿಗಳೂ ನಮಗೆ ಆಶ್ಚರ್ಯ ಕೊಡಬಹುದು ಅಂತ ಈ ಮಕ್ಕಳು ಕಂಡುಕೊಳ್ಳುತ್ತಾರೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/751419/size7/31a945867e2d99c4d829ecc38b6bccf9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/751419/size7/31a945867e2d99c4d829ecc38b6bccf9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-668788","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-668788","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":762,"opdsId":"urn:uuid:SW-138977","title":"ಪಾಠ","authors":["Geetha GT"],"language":"","readingLevel":"","publisher":"","summary":"ನನಗೆ ಆ ಅಂಕಲ್‌ ಅನ್ನು ಕಂಡರೆ ಆಗಲ್ಲ. ಕೆಲವೊಮ್ಮೆ ದುರುಗುಟ್ಟಿ ನೋಡುತ್ತಾರೆ, ಇನ್ನೊಮ್ಮೆ ಹತ್ತಿರ ಕರೆಯುತ್ತಾರೆ. ಅದಕ್ಕೆ ಅಮ್ಮನಿಗೆ ಹೇಳಿಬಿಟ್ಟೆ. ನೀವೂ ಕೂಡ ಇಷ್ಟವಾಗದವರ ಬಗ್ಗೆ ಮನೆಯಲ್ಲಿ ಹೇಳಬೇಕು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727189/size7/f39c384dfaac4e928af0b8f1fa19d643.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727189/size7/f39c384dfaac4e928af0b8f1fa19d643.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-138977","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-138977","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":763,"opdsId":"urn:uuid:SW-610401","title":"ಅಂತರಿಕ್ಷ ನಿಯಮಗಳು","authors":["Lakshmi B R -  SSO,  Jawaharlal Nehru Planetarium"],"language":"","readingLevel":"","publisher":"","summary":"3,2,1... ಅಂತರಿಕ್ಷಕ್ಕೆ ಜಿಗಿಯೋಣ. ಅಲ್ಲಿ ಗ್ರಹಗಳನ್ನು ಭೇಟಿಯಾಗುವುದಿದೆ. ನಕ್ಷತ್ರಗಳನ್ನು ಪುನಃ ಸಂಧಿಸುವುದಿದೆ. ಇಲ್ಲಿ ಕೆಲವು ನಿಯಮಗಳನ್ನು ತಿಳಿಯಲೇಬೇಕು. ಈ ನಿಯಮಗಳು ವಿಶ್ವದೆಲ್ಲೆಡೆ ಸಲ್ಲುತ್ತವೆ. ಅಂತರಿಕ್ಷದಲ್ಲೂ ಮತ್ತು ನಮ್ಮ ಮನೆಯಾದ ಭೂಮಿಯ ಮೇಲೂ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727675/size7/b04d6052ce0895f23058503ef7d9a648.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727675/size7/b04d6052ce0895f23058503ef7d9a648.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-610401","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-610401","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":764,"opdsId":"urn:uuid:SW-71067","title":"ನೀಲು ಮತ್ತು ಅದ್ಭುತ ಮುದ್ರಕ","authors":["LC Nagaraj"],"language":"","readingLevel":"","publisher":"","summary":"ನೀಲುಗೆ ಪ್ರಾಣಿಗಳೆಂದರೆ ಅದೇನೊ ಅಕ್ಕರೆ. ಕೋಲ್ಕೋತಾದ ಬೀದಿಗಳಲ್ಲಿ ಕುಂಟುತ್ತಾ ಸಾಗುವ ಕುದುರೆಯೊಂದನ್ನು ನೋಡಿದ ಅವನಿಗೆ ಅದಕ್ಕೆ ಸಹಾಯ ಮಾಡುವ ಆಸೆ. ಕಂಡಿದ್ದನ್ನೆಲ್ಲ ಮುದ್ರಿಸಬಲ್ಲ 3D ಮುದ್ರಕ  ತಂತ್ರಜ್ಞಾನ ಪರಿಚಯ ಅವನಿಗಾಯಿತು. ಬಟ್ಟಲು ತಟ್ಟೆ, ಪೆನ್ಸಿಲು ಮತ್ತು ಮುಂದಿನ ದಿನಗಳಲ್ಲಿ ಕುದುರೆಯ ಪಾದದ ಗೊರಸುಗಳನ್ನ ಕೂಡ 3D ಮುದ್ರಕ ತಯಾರಿಸಬಲ್ಲದು! ಗಾಯಗೊಂಡ ಪ್ರಾಣಿಗಳಿಗೆ ಈ ತಂತ್ರಜ್ಞಾನ ನೆರವಾಗಬಹುದೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/120863/size7/5863a34c6d94a16e22da796afd94c44e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/120863/size7/5863a34c6d94a16e22da796afd94c44e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-71067","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-71067","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":765,"opdsId":"urn:uuid:SW-398","title":"ಬಾನಿ","authors":["D. Annapoorna"],"language":"","readingLevel":"","publisher":"","summary":"ಬಾನಿ ನಿದ್ದೆಯಲ್ಲೇ ತೇಲಬಲ್ಲವಳು ಹಾಗೂ ತೇಲುತ್ತಾ ಆಶ್ಚರ್ಯಕರ ಮತ್ತು ಮನರಂಜನೆಯ ತಾಣಗಳನ್ನು ತಲುಪಬಲ್ಲವಳು. ಆಕೆಯೊಂದಿಗೆ ತೇಲುತ್ತಾ ಹೋಗಲು ನೀವು ಸಿದ್ಧರಿದ್ದೀರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/700881/size7/a1a0cc5024ea7159fce4445c39ee8dd3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/700881/size7/a1a0cc5024ea7159fce4445c39ee8dd3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-398","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-398","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":766,"opdsId":"urn:uuid:SW-435974","title":"ಹಣ ಹೇಗೆ ಸಂಚರಿಸುತ್ತದೆ!","authors":["Shaila Manipal"],"language":"","readingLevel":"","publisher":"","summary":"ರೂಪಾಯಿ ಪೈಸೆ ಸರಣಿ ತನ್ನೊಂದಿಗೆ ಅನೇಕ ಉಪಯುಕ್ತ ಮಾಹಿತಿಗಳನ್ನು ಹೊತ್ತು ತಂದಿದೆ. ಈ ಪುಸ್ತಕಗಳು, \nನಿತ್ಯ ಬದಲಾಗುವ ಜಗತ್ತಿನಲ್ಲಿ; ಬೆಳೆಯುತ್ತಿರುವ ಮಕ್ಕಳು ಹಣವನ್ನು ಹೇಗೆ ಜಾಣತನದಿಂದ ಉಪಯೋಗಿಸಿಕೊಳ್ಳಬೇಕು ಎಂಬುದನ್ನು ಹೇಳಿಕೊಡುತ್ತವೆ. ಹಣ ಒಬ್ಬ ವ್ಯಕ್ತಿಯಿಂದ ಇನ್ನೊಬ್ಬ ವ್ಯಕ್ತಿಗೆ ಹಾಗೂ ಒಂದು ಸ್ಥಳದಿಂದ ಇನ್ನೊಂದು ಸ್ಥಳಕ್ಕೆ ವರ್ಗಾವಣೆಯಾಗುತ್ತದೆ. \nಇದು ಒಂದು ದೊಡ್ಡ ಬ್ಯಾಂಕಿನ ಗುಹೆಯೊಳಗೆ ಶೇಖರಣೆಯಾಗುತ್ತಿದೆಯಾ? ಎಟಿಎಂ ಎಂದರೇನು? ಜನರು ತೆರಿಗೆಯನ್ನು ಯಾಕೆ ನೀಡುತ್ತಾರೆ? ಈ ಎಲ್ಲ ಪ್ರಶ್ನೆಗಳಿಗೆ ಉತ್ತರಗಳನ್ನು  ರೂಪಾಯಿ ಪೈಸೆ ಸರಣಿಯ ಹಣ ಹೇಗೆ ಸಂಚರಿಸುತ್ತದೆ! - ಪುಸ್ತಕ 2ರಲ್ಲಿ ಪಡೆಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723603/size7/ac32ac4ee2b4016aa6e508125a0192d4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723603/size7/ac32ac4ee2b4016aa6e508125a0192d4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-435974","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-435974","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":767,"opdsId":"urn:uuid:SW-456953","title":"ಬಣ್ಣ ಬಳಿಯೋಣ, ಗಿಡ ನೆಡೋಣ","authors":["Manjula M"],"language":"","readingLevel":"","publisher":"","summary":"ಅವಿಗೆ ಗಿಡ ನೆಡುವುದು, ಸಂಗೀತ ಕೇಳುವುದು, ಬಗೆ ಬಗೆ ಬಣ್ಣಗಳನ್ನು ಬಳಿಯುವುದು, ಹೀಗೆ ವಾರವಿಡೀ ಏನಾದರೊಂದು ಕೆಲಸದಲ್ಲಿ ತೊಡಗುವುದು ರೂಢಿ. ಹಾಗೆಯೇ, ಈ ಕೆಲಸಗಳಲ್ಲಿ ಅಡಗಿರುವ ಆಕೃತಿಗಳನ್ನು ಗಮನಿಸಿ, ಗುರುತಿಸುವುದು ಕೂಡ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/472786/size7/c73d494d112953afae92ffe68d3d5f6f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/472786/size7/c73d494d112953afae92ffe68d3d5f6f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-456953","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-456953","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":768,"opdsId":"urn:uuid:SW-136417","title":"ಅಸಾಮೊ ಅದು ನೀನಾ?","authors":["Tanuja Jakkannavar"],"language":"","readingLevel":"","publisher":"","summary":"ದೀಪಗಳೇ ಇಲ್ಲದ ಜಾಗದಲ್ಲಿ ಯಮಮ್ ಅಸಾಮೊವನ್ನು ಹುಡುಕುತ್ತಿದ್ದಾಳೆ. ಆದರೆ, ಕತ್ತಲಲ್ಲಿ ಹೀಗೆ ಹುಡುಕುತ್ತಿರುವುದು ಅವಳೊಬ್ಬಳೇನಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723774/size7/cb584410ae752672dc7e46ce28d53087.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723774/size7/cb584410ae752672dc7e46ce28d53087.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-136417","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-136417","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":769,"opdsId":"urn:uuid:SW-611893","title":"ಅರಲು ಮಡಕೆಯಾಗುವ ಜಾದೂ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಸಿಜು ಎಂಬ ಹಳ್ಳಿಯಲ್ಲಿ ಸಿಮ್ಸಾಂಗ್ ನದಿ ಹರಿಯುತ್ತದೆ. ಈ ನದಿಯ ಒಡ್ಡುಗಳಲ್ಲಿ ರೂಪುಗೊಂಡ ಕೆಸರು ಮತ್ತು ಜೇಡಿಮಣ್ಣು ಗಾರೋ ಬೆಟ್ಟಗಳಲ್ಲಿ ಬಲವಾದ ಮಡಕೆಗಳನ್ನು ಮಾಡಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ. ತನ್ನ ಅಜ್ಜಿಯ ದೈನಂದಿನ ಚಟುವಟಿಕೆಗಳ ಬಗ್ಗೆ ಕುತೂಹಲ ಹೊಂದಿರುವ ಚಿಕ್ಕ ಹುಡುಗಿ ಅಸ್ಕಿ, ಕುಂಬಾರಿಕೆಯಲ್ಲಿನ ಮಾಂತ್ರಿಕತೆಯನ್ನು ಕಂಡುಹಿಡಿಯುವ ತನ್ನ ಪ್ರಯಾಣವನ್ನು ಪ್ರಾರಂಭಿಸಿದ್ದಾಳೆ. ಜೊತೆಗೆ ತನ್ನ ಪೂರ್ವಜರಿಂದ ಬಂದ ಜ್ಞಾನವನ್ನು ಸಹ ಪಡೆದುಕೊಳ್ಳುತ್ತಾಳೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/675179/size7/5ec5f57eaf3aebcc928cc50430dae340.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/675179/size7/5ec5f57eaf3aebcc928cc50430dae340.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-611893","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-611893","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":770,"opdsId":"urn:uuid:SW-441213","title":"ಈಗ ಹವಾಮಾನ ವರದಿ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಈ ದಿನ ಹವಾಮಾನ ಹೇಗಿದೆ? ಅದರ ವರದಿ ನೀಡಲು ಸುಡುವ ಬಿಸಿಲು, ಮಳೆ, ಬಿರುಗಾಳಿಯನ್ನು ಎದುರಿಸುತ್ತಿರುವ ಹವಾಮಾನ ಶಾಸ್ತ್ರಜ್ಞರನ್ನೇ ಕೇಳೋಣ ಬನ್ನಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716142/size7/f997d32782ce480d21137272fdd31bf7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716142/size7/f997d32782ce480d21137272fdd31bf7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-441213","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-441213","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":771,"opdsId":"urn:uuid:SW-481245","title":"ನನ್ನ ಮನೆ ಎಂದರೆ...","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಏನೆಲ್ಲ ಸೇರಿ ಮನೆ ಆಗುತ್ತದೆ? ದನಿ, ನೆನಪು, ವಾಸನೆ, ಬಣ್ಣ, ಸ್ನೇಹಿತರು, ಪ್ರಾಣಿಗಳನ್ನು ಸೇರಿ. ಬೆಲಾ ನಿಮ್ಮನ್ನು ಅವಳ ಮನೆಗೆ ಕರೆಯುತ್ತಿದ್ದಾಳೆ, ಬನ್ನಿ. ಅದು ಅವಳ ಮನೆಯಷ್ಟೇ ಅಲ್ಲ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/636954/size7/6a7950e041fc4a444ac4b3a10072e6b8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/636954/size7/6a7950e041fc4a444ac4b3a10072e6b8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-481245","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-481245","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":772,"opdsId":"urn:uuid:SW-607034","title":"ಚಂದ್ರನ ಪಿಜ್ಜಾ","authors":["Navika"],"language":"","readingLevel":"","publisher":"","summary":"ಟೀನೂಗೆ ಬ್ರೋಕಲಿ ಮತ್ತೆ ಬಟಾಣಿಯಿಂದ ಮಾಡಿದ ತಿಂಡಿ ಬೇಕಿಲ್ಲ. ಅವನಿಗೆ ಪಿಜ್ಜಾ ಬೇಕು. ಚಂದ್ರನ ಪಿಜ್ಜಾ ಕೂಡ ಆಗಬಹುದು!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722792/size7/34e7f976de260e52fb47baea41b24c65.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722792/size7/34e7f976de260e52fb47baea41b24c65.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-607034","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-607034","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":773,"opdsId":"urn:uuid:SW-455644","title":"ಎಲ್ಲೆಲ್ಲೂ ಗಿಡ ಮರ ಬಳ್ಳಿಗಳು","authors":["Rohith BR"],"language":"","readingLevel":"","publisher":"","summary":"ಗಿಡ-ಮರ-ಬಳ್ಳಿಗಳು ಎಲ್ಲೆಡೆಯೂ ಬೆಳೆಯುತ್ತವೆ — ಎತ್ತರದ ಪರ್ವತಗಳ ಮೇಲೆ, ಮರುಭೂಮಿಯಲ್ಲಿ; ಅಷ್ಟೇ ಅಲ್ಲ ಕಡಲ ಆಳದಲ್ಲೂ ಕೂಡ. ಈ ಪುಸ್ತಕದಲ್ಲಿ ನೀವು ಇಂತಹ ಹಲವಾರು ಗಿಡ-ಮರ-ಬಳ್ಳಿಗಳ ಬಗ್ಗೆ ತಿಳಿದುಕೊಳ್ಳಬಹುದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/434073/size7/3927b068f2f1009ae79ef445c56eb5be.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/434073/size7/3927b068f2f1009ae79ef445c56eb5be.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-455644","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-455644","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":774,"opdsId":"urn:uuid:SW-579146","title":"ಸಿಕಾಡದ ಹಾಡು","authors":["Sarita Sharan"],"language":"","readingLevel":"","publisher":"","summary":"ಸಿಕಾಡ ಹಾಡಲು ಇಷ್ಟಪಡುತ್ತದೆ. ಅದು ಹೊಸ ಹಾಡುಗಳನ್ನು ಕಲಿಯಲು ಬಯಸುತ್ತದೆ. ಬೇರೆ ಬೇರೆ ಪಕ್ಷಿ ಮತ್ತು ಕೀಟಗಳಿಂದ ಹಾಡು ಕಲಿಯಲು; ಅವೆಲ್ಲವನ್ನ ಕಾಣಲು ಹೊರಟಿದೆ. ಸಿಕಾಡ ಹೊಸ ಹಾಡುಗಳನ್ನು ಕಲಿತು ಹಾಡುತ್ತದೆಯೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/93874/size7/6a2a68bdd190f3d01e363776795b72e6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/93874/size7/6a2a68bdd190f3d01e363776795b72e6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-579146","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-579146","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":775,"opdsId":"urn:uuid:SW-455686","title":"ಚುನ್ನು-ಮುನ್ನುವಿನ ಸ್ನಾನ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಸೋಪು, ನೀರಿನಲ್ಲಿ ಆಟ. ಬಚ್ಚಲಿನಲ್ಲಿ ಜಿಗಿದಾಡು. ಬನ್ನಿ ಚುನ್ನು-ಮುನ್ನುಗೆ ಸ್ನಾನ ಮಾಡೋದು ಎಷ್ಟು ಮಜ ಅಂತ ನೋಡೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721702/size7/fb052d30f4a73aae542e0c8d52969aab.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721702/size7/fb052d30f4a73aae542e0c8d52969aab.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-455686","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-455686","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":776,"opdsId":"urn:uuid:SW-597470","title":"ಕೊಟ್ಟ ಮಾತು ತಪ್ಪದ ಶ್ರೀಂಗೇರಿ ಶ್ರೀನಿವಾಸ","authors":["Sriram MS"],"language":"","readingLevel":"","publisher":"","summary":"ಶ್ರೀಂಗೇರಿ ಶ್ರೀನಿವಾಸ ಮಹಾಮಾರಿಗೆ ಚಿಕಿತ್ಸೆ ಸಿಗುವವರೆಗೂ ಕೂದಲು ಕತ್ತರಿಸಲ್ಲಾ... ಎಂದು ಶಪಥ ಮಾಡಿದ್ದ. ತನ್ನ ಕೂದಲನ್ನ ಕತ್ತರಿಸಲು ತಯಾರಾಗುತ್ತಿರುವಾಗಲೇ, ಒಂದು ಆಘಾತಕಾರಿ ಸುದ್ದಿ ಬರುತ್ತದೆ. ಶ್ರೀಂಗೇರಿ ಏನು ಮಾಡುತ್ತಾನೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703950/size7/fa9ac41e0ad206520a3067b3fe095cef.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703950/size7/fa9ac41e0ad206520a3067b3fe095cef.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-597470","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-597470","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":777,"opdsId":"urn:uuid:SW-454879","title":"ಬಗೆ ಬಗೆಯ ಕೊಕ್ಕುಗಳು","authors":["Chandrakantha Malligere"],"language":"","readingLevel":"","publisher":"","summary":"ಹಕ್ಕಿಗಳು ಬಗೆ ಬಗೆಯ ಕೊಕ್ಕುಗಳನ್ನು ಹೊಂದಿವೆ ಮತ್ತು ಅವುಗಳನ್ನು ಬೇರೆ ಬೇರೆ ರೀತಿಯಲ್ಲಿ ಬಳಸುತ್ತವೆ. ಹೇಗೆಂದು ತಿಳಿಯೋಣ ಬನ್ನಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527541/size7/8b9b4ad89f883b4d5fc2428c650116c9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527541/size7/8b9b4ad89f883b4d5fc2428c650116c9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-454879","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-454879","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":778,"opdsId":"urn:uuid:SW-451557","title":"ಮಾಯಿಯ ಲೋಕದಲ್ಲಿ...","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಮಾಯಿ ತಾನೇ ವಿನ್ಯಾಸ ಮಾಡಿ, ಕಟ್ಟಿದ ಸುಂದರ ಕಾಲೊನಿಯಲ್ಲಿ ಇರುತ್ತಾರೆ. ಪ್ರೇಮಾ ಮತ್ತು ಗೋಪಿ ಕಣ್ಣಾಮುಚ್ಚಾಲೆ ಆಟವಾಡುತ್ತಾ ಅವಿತುಕೊಳ್ಳುವ ಅದೆಷ್ಟೋ ಜಾಗಗಳನ್ನು ಕಂಡು ಹಿಡಿಯುತ್ತಾರೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/458010/size7/91da2ed79918df599ea4cfc10a43f642.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/458010/size7/91da2ed79918df599ea4cfc10a43f642.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-451557","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-451557","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":779,"opdsId":"urn:uuid:SW-63823","title":"ಲೆನಿನ್ನನ ಅತಿಥಿಗಳು","authors":["T.S. Gopal"],"language":"","readingLevel":"","publisher":"","summary":"ಉರಿಬೇಸಿಗೆಯ ಒಂದು ದಿನ ಲೆನಿನ್ ಮನೆಗೆ ಬಂದ ಇಬ್ಬರು ಅತಿಥಿಗಳಿಗೆ ಪಾನಕ ಮಾಡುತ್ತಾನೆ. ಅವರಿಗೆ ಪಾನಕ ತಂದು ಕೊಡುವುದಕ್ಕೆ ಲೆನಿನ್ ಗೆ ನೀವೇನಾದರೂ ಸಹಾಯ ಮಾಡುವಿರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715520/size7/c1341ce9db6a070041bb561f42a6730e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715520/size7/c1341ce9db6a070041bb561f42a6730e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-63823","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-63823","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":780,"opdsId":"urn:uuid:SW-65364","title":"ಮೂಗಿನ ಖಜಾನೆ","authors":["Utthaana Bharighat"],"language":"","readingLevel":"","publisher":"","summary":"ಮೂಗಿನ ಹತ್ತಿರ ಬರುತ್ತಿದ್ದಂತೆ ನಮ್ಮ ಬೆರಳೇಕೆ ಬಾಗುವುದು? ಮೂಗಲ್ಲಿ ಬೆರಳಾಡಿಸುವುದು ನಮಗೇಕಿಷ್ಟ? ಬೆರಳು ಮತ್ತು ಮೂಗಿನ ನಡುವೆ ಆಗಿದ್ದೇನು ನೋಡೋಣವಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727091/size7/f20daa83dbeedd6c1f27fd08457294a1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727091/size7/f20daa83dbeedd6c1f27fd08457294a1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-65364","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-65364","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":781,"opdsId":"urn:uuid:SW-456424","title":"ಸುಂಯ್... ಟಾ ಟಾ!","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಈ ಚಿತ್ರ ಪುಸ್ತಕದಲ್ಲಿ, ನೊಣದ ದೃಷ್ಟಿಕೋನದಿಂದ ನಮ್ಮ ಜಗತ್ತನ್ನು ನೋಡೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717941/size7/a6572759ac00204199b69d9e391c4836.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717941/size7/a6572759ac00204199b69d9e391c4836.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-456424","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-456424","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":782,"opdsId":"urn:uuid:SW-615451","title":"ಬೆಳೆಯುವುದೆಂದರೆ...","authors":["S Diwakar"],"language":"","readingLevel":"","publisher":"","summary":"ಪ್ರಾಯದಲ್ಲಿ ಆಗುವ ಬದಲಾವಣೆಗಳನ್ನು ನಿಭಾಯಿಸುವುದು ಸುಲಭವಲ್ಲ. ಹದಿಹರೆಯಕ್ಕೆ ಹೆಜ್ಜೆಯಿಡುತ್ತಿರುವ ಮಕ್ಕಳ ಬದುಕಿನ ಜಟಿಲವೂ, ಸೂಕ್ಷ್ಮವೂ ಆದ ಜೀವನ ಘಟ್ಟವನ್ನು ಎದುರಿಸಲು ಈ ಪುಸ್ತಕ; ಮನಸೆಳೆವ ಮಾಹಿತಿಯೊಂದಿಗೆ ಸಿದ್ಧಗೊಳಿಸುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/676918/size7/a6cf8415233915d3e377842e3c066cee.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/676918/size7/a6cf8415233915d3e377842e3c066cee.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-615451","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-615451","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":783,"opdsId":"urn:uuid:SW-225869","title":"ಮೇಜು","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಮನೆಯಲ್ಲಿರುವ ಮೇಜನ್ನು ಪ್ರತಿಯೊಬ್ಬರೂ ತಮ್ಮ ಯಾವುದಾದರೊಂದು ಕೆಲಸಕ್ಕೆ ಬಳಸಿಯೇ ಬಳಸುತ್ತಾರೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283816/size7/c354d490842834570030304a57cdc70b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283816/size7/c354d490842834570030304a57cdc70b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-225869","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-225869","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":784,"opdsId":"urn:uuid:SW-457085","title":"ಇದು ಬೆಕ್ಕಿನ ತಪ್ಪು!","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಮಕ್ಕಳು ಹೋಂ ವರ್ಕ್ ಮಾಡದಿರಲು ಏನು ಕಾರಣ? ಕಾರಣವೇ ಬೇಕಿಲ್ಲ ಅಂತೀರಾ? ಈ ಕತೆಯಲ್ಲಿನ ಹುಡುಗನಿಗೆ ಕೂಡ ಮಿಸ್ ಅದನ್ನೇ ಕೇಳುತ್ತಾರೆ. ನೀನು ಹೋಂ ವರ್ಕ್ ಯಾಕೆ ಮಾಡಿಲ್ಲ ಎಂದು? ಅವನು ಏನು ಕಾರಣ ಕೊಡಬಹುದು? ಮತ್ತು ಒಂದು ವಿಷಯ ಇನ್ನೊಂದಕ್ಕೆ ಹೇಗೆ ಕಾರಣವಾಗಬಹುದು ಎಂಬುದನ್ನೂ ನೀವು ಇಲ್ಲಿ ನೋಡಬಹುದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/696669/size7/8717a72070ac52bd090aeebc8e6b36e6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/696669/size7/8717a72070ac52bd090aeebc8e6b36e6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-457085","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-457085","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":785,"opdsId":"urn:uuid:SW-36579","title":"ನಕ್ಷತ್ರಗಳ ನಾವಿಕರು ಪಾನಿಪುರಿ ತಿನ್ನಬಹುದಾ?","authors":["Tanuja Jakkannavar"],"language":"","readingLevel":"","publisher":"","summary":"ಚಿಕ್ಕಿ ಊಟದ ವಿಷಯದಲ್ಲಿ ಸ್ವಲ್ಪ ಹಠಮಾರಿ. ಅವಳಿಗೆ ಮೂಲಂಗಿ ಪರೋಟದ ವಾಸನೆ ಹಿಡಿಸುವುದಿಲ್ಲ. ಚಿಕ್ಕಿಗೆ ಬಾಹ್ಯಾಕಾಶದಲ್ಲಿ ಹಾರಾಡಬೇಕು ಎಂದು ಆಸೆ. ಆದರೆ ಅಲ್ಲೂ ಪಿಜ್ಜಾ, ಪಾನಿಪುರಿ ಹಾಗೂ ಐಸ್‌ ಕ್ರೀಂ ಸಿಗಬಹುದೇ ಎಂಬ ಯೋಚನೆ ಅವಳಿಗೆ. ಗಗನಯಾತ್ರಿಗಳು ಬಾಹ್ಯಾಕಾಶದಲ್ಲಿ ಏನನ್ನು ತಿನ್ನುತ್ತಾರೆ ಮತ್ತು ಹೇಗೆ ತಿನ್ನುತ್ತಾರೆ ಎನ್ನುವುದರ ಬಗ್ಗೆ ಚಿಕ್ಕಿ ಹಾಗೂ ನಿನುವಿನ ಜೊತೆ ನೀವೂ ತಿಳಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117466/size7/793fd168869667b621ba74334920c6f7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117466/size7/793fd168869667b621ba74334920c6f7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-36579","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-36579","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":786,"opdsId":"urn:uuid:SW-110822","title":"ಬೊಬೊ ಮತ್ತು ಹುಳುಗಳು","authors":["LC Nagaraj"],"language":"","readingLevel":"","publisher":"","summary":"ಅಪೂಜಾನ ಹುರುಳಿ ಗಿಡಗಳನ್ನು ಹುಳುಗಳು ಹಾಳು ಮಾಡುತ್ತಿವೆ. ಹಾಗಾದರೆ, ಬೊಬೊ ಸಸಿಗಳನ್ನು ಉಳಿಸಿದ್ದು ಹೇಗೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495594/size7/9fec4d87f484e7a1832f21cae4834f7b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495594/size7/9fec4d87f484e7a1832f21cae4834f7b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-110822","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-110822","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":787,"opdsId":"urn:uuid:SW-209277","title":"ಗಾಳಿಪಟ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಗಾಳಿಪಟವು ಬಗೆ ಬಗೆಯ ಬಣ್ಣಗಳಲ್ಲಿ ಸಿಗುತ್ತದೆ. ಆಗಸದಲ್ಲಿ ಎತ್ತರಕ್ಕೆ ಹಾರುತ್ತವೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/282952/size7/eb0f647eb11fc2423960eb9295c21a0b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/282952/size7/eb0f647eb11fc2423960eb9295c21a0b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-209277","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-209277","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":788,"opdsId":"urn:uuid:SW-84661","title":"ಅಮ್ಮ, ನನ್ನ ಸಾರಿನಲ್ಲಿ ಬಾವಲಿ!","authors":["Kavitha  Muchandi"],"language":"","readingLevel":"","publisher":"","summary":"ದಾರಿ ತಪ್ಪಿ ಮನೆಗೆ ನುಗ್ಗಿದ ಬಾವಲಿ ಹಾರಾಡುತ್ತಿದೆ. ಸುಪ್ಪಿಗೋ ಬಾವಲಿ ಎಂದರೆ ತುಂಬಾ ಭಯ. ಅಮ್ಮ ಮತ್ತು ಸುಪ್ಪಿ ಬಾವಲಿಯನ್ನು ಅದರ ಅಕ್ಕ-ಅಣ್ಣಂದಿರ ಜತೆ ಸೇರಿಸಿದ್ದು ಹೇಗೆ ಎನ್ನುವುದನ್ನು ತಿಳಿಯಲು ಈ ಕತೆ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/123158/size7/d0d693e146f6a7addc7937a2c944ed6a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/123158/size7/d0d693e146f6a7addc7937a2c944ed6a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-84661","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-84661","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":789,"opdsId":"urn:uuid:SW-132158","title":"ಇಲ್ಲಿ ಬೆಳಗ್ಗೆ ಅಲ್ಲಿ ರಾತ್ರಿ","authors":["Navya. N"],"language":"","readingLevel":"","publisher":"","summary":"ಮಾಧವ ಮತ್ತು ಯಾರೆಟ್ಜಿ ಭೂಮಿಯ ವಿರುದ್ಧ ಭಾಗಗಳಲ್ಲಿ ವಾಸಿಸುತ್ತಾರೆ.  ಮಾಧವನಿಗೆ ರಾತ್ರಿಯಾಗಿದ್ದಾಗ ಯಾರೆಟ್ಜಿಗೆ ಹಗಲಿರುತ್ತದೆ. ಏಕೆ ಅವರಿಬ್ಬರೂ ಏಕಕಾಲಕ್ಕೆ ನಕ್ಷತ್ರಗಳನ್ನು ನೋಡಲಾರರು? ಈ ಕತೆಯನ್ನು ಓದಿ ಮತ್ತು ಸಮಯದ ವ್ಯತ್ಯಾಸಗಳನ್ನು ತಿಳಿದುಕೊಳ್ಳಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/720805/size7/c52a302e6f94b8951096c03e132a28ed.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/720805/size7/c52a302e6f94b8951096c03e132a28ed.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-132158","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-132158","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":790,"opdsId":"urn:uuid:SW-39008","title":"ಓಹೋ ಇದು ಹೈಪರ್ ಲೂಪು!","authors":["Sarita Sharan"],"language":"go","readingLevel":"","publisher":"","summary":"ವಿಷ್ಣು ಹೊಸ ಜಾಗಗಳಿಗೆ ಹೋಗುವುದನ್ನು ಇಷ್ಟಪಡುತ್ತಾನೆ. ಆದರೆ, ದೂರ ಪ್ರಯಾಣ ಅವನಿಗೆ ಬೇಸರದ ವಿಷಯ. ನಮಗೇಕೆ ಅತೀ ವೇಗದ ಸಮೂಹ ಸಾರಿಗೆ ವ್ಯವಸ್ಥೆ ಲಭ್ಯವಿಲ್ಲ ಎಂಬ ಅಚ್ಚರಿ ಅವನಿಗೆ. ಯಾವಾಗ ವಿಷ್ಣು ಹೈಪರ್ ಲೂಪ್ ಬಗ್ಗೆ ಓದಿದನೋ... ಗಾಳಿಯಲ್ಲಿ ತೇಲತೊಡಗಿದನು. ಭವಿಷ್ಯದ ಈ ಸಮೂಹ ಸಾರಿಗೆ ವ್ಯವಸ್ಥೆ ಯಾವುದು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717240/size7/a44f4f43a962237c1c43bd120c7d774c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717240/size7/a44f4f43a962237c1c43bd120c7d774c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-39008","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-39008","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":791,"opdsId":"urn:uuid:SW-35898","title":"ಟೆಲಿಫೋನ್ - ಬೆಲ್ ನಿಂದ ಸೆಲ್ ಗೆ","authors":["Brinda N Rao"],"language":"","readingLevel":"","publisher":"","summary":"ಅಲೆಕ್ಸಾಂಡರ್ ಗ್ರಹಂ ಬೆಲ್ ಟೆಲಿಫೋನನ್ನು ಕಂಡು ಹಿಡಿದಾಗ, ಇಡೀ ಪಟ್ಟಣದಲ್ಲಿ ಎರಡೇ ಫೋನುಗಳಿದ್ದವು! ಈಗ ಬಹುತೇಕ ಎಲ್ಲರ ಬಳಿಯೂ ಸೆಲ್ ಫೋನ್ ಇದೆ. ಬೆಲ್‍ನಿಂದ ಸೆಲ್ ವರೆಗೆ ಟೆಲಿಫೋನ್ ಹೇಗೆ ವಿಕಾಸಗೊಂಡಿತು ಎಂಬುದನ್ನು ತಿಳಿಯಲು ಈ ಪುಸ್ತಕ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716429/size7/4e13bfbe328c114f3ca7223d66f6674f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716429/size7/4e13bfbe328c114f3ca7223d66f6674f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-35898","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-35898","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":792,"opdsId":"urn:uuid:SW-436749","title":"ಪೋಸ್ತೊ, ನಿನ್ನ ಮೇಜು ಸ್ವಚ್ಛ ಮಾಡು!","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಪೋಸ್ತೊನ ಮೇಜಿನ ತುಂಬೆಲ್ಲ ಸಾಮಾನುಗಳು. ಬಣ್ಣದ ಕಡ್ಡಿ, ಪೆನ್ಸಿಲ್‌, ಬಣ್ಣದ ಕುಂಚ ಮತ್ತು ಪುಸ್ತಕಗಳು ಅಲ್ಲಲ್ಲಿ ಹರಡಿಕೊಂಡಿವೆ. ಅವನು ಈ ಸಾಮಾನೆಲ್ಲ ನೀಟಾಗಿ ಇಡಬೇಕು ಎನ್ನುವುದು ಅಮ್ಮನ ಆಸೆ. ಪೋಸ್ತೊ ತನ್ನ ಮೇಜನ್ನು ಸ್ವಚ್ಛ ಮಾಡುತ್ತಾನಾ ಎನ್ನುವುದನ್ನು ನೋಡಲು, ಚಿತ್ರಗಳಿಂದ ತುಂಬಿರುವ ಈ ಸುಂದರ ಪುಸ್ತಕವನ್ನು ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527519/size7/84aea45597ceebd0788b864c215f96bd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527519/size7/84aea45597ceebd0788b864c215f96bd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-436749","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-436749","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":793,"opdsId":"urn:uuid:SW-593968","title":"ಮರೆಗುಳಿ ದೀದಾ","authors":["G W Carlo"],"language":"","readingLevel":"","publisher":"","summary":"ದೀದಾ ಎಲ್ಲವನ್ನ ಮರೆಯುತ್ತಿದ್ದಾಳೆ. ಒಂದೇ ಚಪ್ಪಲಿಯನ್ನು ಮೆಟ್ಟಿಕೊಂಡು, ಮತ್ತೊಂದನ್ನು ಮರೆತು ದಿನಸಿ ಅಂಗಡಿಗೆ ಹೊರಟಿದ್ದಲ್ಲದೆ, ಮೂರು ಮತ್ತು ಹತ್ತರ ನಡುವಿನ ಸಂಖ್ಯೆಗಳನ್ನೂ ಮರೆತಿದ್ದಳು. ಮುಂದಕ್ಕೆ ಮತ್ತೇನನ್ನು ಮರೆಯುತ್ತಾಳೋ? ತನ್ನ ಅಜ್ಜಿಯ ಬಗ್ಗೆ ಒಬ್ಬ ಪುಟ್ಟ ಬಾಲಕಿ ನಿರೂಪಿಸಿರುವ ನವಿರಾದ ಕತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/705666/size7/1e7aa9f6a7a43bf9e964e88fd9e3d0e8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/705666/size7/1e7aa9f6a7a43bf9e964e88fd9e3d0e8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-593968","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-593968","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":794,"opdsId":"urn:uuid:SW-149075","title":"ಜಾಂಗೀರ್‌ ಗುಂಗುರು","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಮಾನಸಳಿಗೆ ಅವಳ ಕೂದಲು ಇಷ್ಟವಿಲ್ಲ. ಆಕೆಯ ಕೂದಲೇಕೆ ಟೈಟಸ್‌ನ ಕೂದಲಿನಂತಿಲ್ಲ? ಈ ಗುಂಗುರು ಕೂದಲು ಬಂದಿದ್ದಾದರೂ ಎಲ್ಲಿಂದ? \nಬನ್ನಿ, ಮಾನಸಳನ್ನೇ ಕೇಳೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715837/size7/bee2f5fcda8d9484b7943ace2130e36f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715837/size7/bee2f5fcda8d9484b7943ace2130e36f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-149075","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-149075","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":795,"opdsId":"urn:uuid:SW-69595","title":"ಕಂಬಗಳಿಂದ ಅರಮನೆಗಳ ಕಡೆಗೆ","authors":["Smitha sathyaprakash"],"language":"","readingLevel":"","publisher":"","summary":"ಧೀರಾಗೆ ದೊಡ್ಡ ದೊಡ್ಡ ಕಟ್ಟಡ, ಅರಮನೆಗಳೆಂದರೆ ಅದೇನೊ ಕುತೂಹಲ. ಅಪ್ಪ, ಅಮ್ಮ ಅವಳಿಗಾಗಿ ಪುಟ್ಟ ವಿಮಾನ ಮಾಡಿ ಕೊಟ್ಟಿದ್ದಾರೆ. ಅದನ್ನೇರಿ ಅವಳು, ಪ್ರಸಿದ್ದ ಕಟ್ಟಡಗಳನ್ನು ಯಾವೆಲ್ಲ ವಸ್ತುಗಳಿಂದ ಮಾಡಿದ್ದಾರೆ ಎಂದು ತಿಳಿಯಲು ಹೊರಟಿದ್ದಾಳೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/718098/size7/7ce9adf05af275eab0dd97cacb072a00.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/718098/size7/7ce9adf05af275eab0dd97cacb072a00.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-69595","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-69595","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":796,"opdsId":"urn:uuid:SW-63975","title":"ಸೈಬೋರ್ಗ್ ತಾತ","authors":["Swati Pandit"],"language":"","readingLevel":"","publisher":"","summary":"ಮಾನವನ ಅಂಗಾಂಗ ಹೋಲುವ ಬದಲಿ  ಯಂತ್ರಗಳ ತಂತ್ರಜ್ಞಾನವೇ ಬಯೋನಿಕ್ಸ್ ಎಂದು ಐಮನ್ ಅಜ್ಜನಿಗೆ ಹೇಳಿದಳು. ಅದು ಹೇಗೆ ಎಂದು ತಿಳಿಯೋಣ ಬನ್ನಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/718335/size7/fdfe21e9fb958bd24c098dcb2a89d21d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/718335/size7/fdfe21e9fb958bd24c098dcb2a89d21d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-63975","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-63975","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":797,"opdsId":"urn:uuid:SW-460708","title":"ನನ್ನ ಒಳ್ಳೆಯ ಗೆಳೆಯರು","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಆಕಾಶನಿಗೆ ಅನೇಕ ಗೆಳೆಯರಿದ್ದಾರೆ. ಅವರಲ್ಲಿ ನಾಲ್ಕು ಕಾಲಿನವು, ಗಾಲಿಗಳದ್ದು, ಮರ, ಪುಸ್ತಕಗಳೂ ಇವೆ. ಮತ್ತೆ ಯಾರಿದ್ದಾರೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727426/size7/1e6243a591279d2047c66bf4af98e0b6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727426/size7/1e6243a591279d2047c66bf4af98e0b6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-460708","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-460708","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":798,"opdsId":"urn:uuid:SW-641962","title":"ಇಲಿ-ಬೆಕ್ಕು","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಇಲಿಯ ಹಿಂದೆ ಓಡಿತು ಬೆಕ್ಕು. ಮೇಲೆ, ಕೆಳಗೆ, ಒಳಗೆ, ಹೊರಗೆ, ಎಲ್ಲೆಲ್ಲೂ ಹುಡುಕಿತು. ಕಡೆಗೂ ಬೆಕ್ಕಿಗೆ ಸಿಕ್ಕೀತೆ ಇಲಿ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712616/size7/640d7ef8a8457e34e0b74a79ef296a2e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712616/size7/640d7ef8a8457e34e0b74a79ef296a2e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-641962","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-641962","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":799,"opdsId":"urn:uuid:SW-138962","title":"ಶಿಕಾರಿಯ ಸೈಕ್ಲಿಂಗ್ ಸಾಹಸ","authors":["Uma Rao Kolar"],"language":"","readingLevel":"","publisher":"","summary":"ಶಿಕಾರಿಗೆ ತನ್ನ ಜೀವನ ನಿಂತ ನೀರಾಗಿದೆ ಎನಿಸಿದಾಗ, ಅವನು ಏಷ್ಯನ್ ಕ್ರೀಡಾಕೂಟ ನೋಡಲು, ಬೆಂಗಳೂರಿನಿಂದ ದೆಹಲಿಗೆ ಸೈಕ್ಲಿಂಗ್ ಮಾಡಿಕೊಂಡು ಹೋಗುವ ರೋಮಾಂಚಕಾರಿ ಸಾಹಸಕ್ಕೆ ತೊಡಗುತ್ತಾನೆ. ಟ್ರಿಣ್, ಟ್ರಿಣ್... ಶಿಕಾರಿ ಹೊರಟೇಬಿಟ್ಟ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/200022/size7/e4eee829172d50faa66bc272ec56c629.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/200022/size7/e4eee829172d50faa66bc272ec56c629.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-138962","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-138962","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":800,"opdsId":"urn:uuid:SW-610218","title":"ಓಡಿಸೋದು ಹೇಗಪ್ಪ ಈ ಜ್ವರ?","authors":["Hema Hebbagodi"],"language":"Ba","readingLevel":"","publisher":"","summary":"ಪರೀಕ್ಷೆಗೆ ಕೆಲವು ದಿನಗಳಷ್ಟೇ ಉಳಿದಿವೆ. ಅಮ್ಮನಿಗೆ ಜ್ವರ ಬಂದುಬಿಟ್ಟಿದೆ. ಮನೆಯಲ್ಲಿ ಇರುವವರೆಲ್ಲ ಅವಳ ಸೇವೆಗೆ ನಿಂತಿದ್ದಾರೆ. ಅವಳಿಗೆ ಆರಾಮ ನೀಡಲು ಯತ್ನಿಸುತ್ತಿದ್ದಾರೆ. ಅಮ್ಮ ಪರೀಕ್ಷೆಗೆ ಮೊದಲು ಹುಷಾರಾಗುವಳೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727674/size7/8f8c33f70a4806d41efd626c5cf14df3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727674/size7/8f8c33f70a4806d41efd626c5cf14df3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-610218","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-610218","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":801,"opdsId":"urn:uuid:SW-578344","title":"ವಿಭಿನ್ನ ಸಾಮರ್ಥ್ಯಗಳು","authors":["Bhat Ananthesha"],"language":"","readingLevel":"Level 2","publisher":"","summary":"ನಾವೆಲ್ಲರೂ ವಿಭಿನ್ನ ಸಾಮರ್ಥ್ಯಗಳನ್ನು ಹೊಂದಿದ್ದೇವೆ, ಆದರೆ ನಾವು ಸಾಮಾನ್ಯವಾಗಿ ಏನನ್ನು ಹೊಂದಿದ್ದೇವೆ ಎಂಬುದನ್ನು ಕಂಡುಕೊಳ್ಳಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/106379/size7/3e09ace06914e0e70d3eaa420f3b51c8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/106379/size7/3e09ace06914e0e70d3eaa420f3b51c8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-578344","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-578344","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":802,"opdsId":"urn:uuid:SW-275975","title":"ಗೋಪ್ಲೂನ ರೈಲು ಸವಾರಿ","authors":["Pallavi Rao"],"language":"","readingLevel":"","publisher":"","summary":"ಗೋಪ್ಲುವಿಗೆ ತಮ್ಮಿಯ ಜತೆ ರೈಲು ಸವಾರಿ ಮಾಡಲು ಎಲ್ಲಿಲ್ಲದ ಉಮೇದು. ತಮ್ಮಿಗೋ ತುಂಬಾ ಮಂದಿ ಸ್ನೇಹಿತರು. ಮತ್ತು ಎಲ್ಲರಿಗೂ ಅವಳದೊಂದು ಮುಗುಳ್ನಗೆ. ಬಹುಶಃ ಇವತ್ತು ಗೋಪ್ಲೂಗೂ ಒಬ್ಬ ಗೆಳೆಯ ಸಿಕ್ಕರೂ ಸಿಗಬಹುದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/710681/size7/d08cb62f318cd8b5c75da8aeae9b31a4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/710681/size7/d08cb62f318cd8b5c75da8aeae9b31a4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-275975","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-275975","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":803,"opdsId":"urn:uuid:SW-109338","title":"ಮಿಸ್‌ ಮೇಕೆಯ ಮನೆ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಬೇಸಿಗೆಯು ಶುರುವಾಗುತ್ತಿದ್ದಂತೆಯೇ ಮಿಸ್‌ ಮೇಕೆಗೆ ಅತಿಯಾದ ಸೆಖೆಯಾಗತೊಡಗಿತು.  ಒಂದು ದಿನ ಸಮಯ ಸರಿದಂತೆ ಬಿಸಿಲೂ ಹೆಚ್ಚಾಯಿತು. ಮಿಸ್‌ ಮೇಕೆಯು ಬಿಸಿಲಿನಿಂದ ರಕ್ಷಣೆ ಪಡೆಯುವುದಾದರೂ ಎಲ್ಲಿ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/101396/size7/72823004ea587a6f81ad53966bdd4307.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/101396/size7/72823004ea587a6f81ad53966bdd4307.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-109338","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-109338","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":804,"opdsId":"urn:uuid:SW-641430","title":"ನೀಲೂಳ ಜುಬೈದಾ","authors":["Hema Hebbagodi"],"language":"","readingLevel":"","publisher":"","summary":"ಇಂದು ಜಾತ್ರೆಯ ಕಡೆಯ ದಿನ. ನೀಲೂ ಮತ್ತು ಜುಬೈದಾ ಜಲೇಬಿ, ಜಾಂಗೀರ್‌, ಜೋಳ ತಿನ್ನೋ ಪ್ಲಾನ್‌ ಹಾಕಿದ್ದರು. ಆದರೆ, ಇದೇನಾಯಿತು! ನೀಲೂ ಕಾಣಲೇ ಇಲ್ಲ. ಅವಳು ತನ್ನ ಗೆಳತಿ ಜೂಬಿಗೆ ಹೇಳದೆಯೇ ಪುರ್ರ್ ಅಂತ ಹಾರಿಹೋದಳೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723602/size7/28082f70e871ccdf22a2178047bce39d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723602/size7/28082f70e871ccdf22a2178047bce39d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-641430","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-641430","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":805,"opdsId":"urn:uuid:SW-644434","title":"ಬಂಬ್: ಮಾಯಾ ಸಿಲಿಂಡರ್","authors":["Krupakar Senani"],"language":"","readingLevel":"","publisher":"","summary":"ಅಮಿತಾ ಮತ್ತು ನಿನಾದ್ ಕುತೂಹಲದಲ್ಲಿದ್ದಾರೆ. ಅವರ ನೆರೆಮನೆಯ ವಿಲಾಸ್ ಎಂದಿನಂತೆ ಕಟ್ಟಿಗೆ ಸಂಗ್ರಹಿಸಲು ಕಾಡಿಗೆ ಹೋಗುತ್ತಿಲ್ಲ. ವಿಲಾಸ್ ಹೆಂಡತಿ ವರ್ಷಾ ಕೂಡ ನೀರನ್ನು ಬಿಸಿ ಮಾಡಲು ಹೆಚ್ಚು ಸಮಯ ಚುಲ್ಹಾದ ಮುಂದೆ ಕುಳಿತುಕೊಳ್ಳುತ್ತಿಲ್ಲ. “ತಮ್ಮ ಬಳಿ ಮಾಯಾ ಸಿಲಿಂಡರ್ ಇದೆ. ಅದು ಕ್ಷಣ ಮಾತ್ರದಲ್ಲಿ ಬಿಸಿನೀರನ್ನು ಒದಗಿಸುತ್ತದೆ,” ಎಂದು ಅವರ ಮಕ್ಕಳು ಹೇಳುತ್ತಾರೆ. ಇದು ನಿಜವಿರಬಹುದೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727685/size7/65b7fb7fd712915b6dca84af7129a461.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727685/size7/65b7fb7fd712915b6dca84af7129a461.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-644434","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-644434","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":806,"opdsId":"urn:uuid:SW-84813","title":"ದೇಹ ಶಿಲ್ಪಿಗಳು","authors":["Usha Bhupali"],"language":"","readingLevel":"","publisher":"","summary":"ವವಾನ ಪುಟ್ಟ ತಂಗಿಗೆ ಅಮ್ಮನ ಹೊಟ್ಟೆಯಲ್ಲಿರುವಾಗಲೇ ಕೂದಲು, ಶ್ವಾಸಕೋಶ ಮತ್ತು ಕಾಲುಗಳನ್ನು ರೂಪಿಸಿಕೊಳ್ಳುವುದು ಹೇಗೆಂದು ಗೊತ್ತು. ಈ ವಿಷಯ ತಿಳಿದ ವವಾಗೆ ಆಶ್ಚರ್ಯವಾಗಿದೆ. ನಮ್ಮ ದೇಹದಲ್ಲಿರುವ ಮಿಲಿಯನ್ ಗಟ್ಟಲೆ ಜೀವಕೋಶಗಳು ಬೆಳೆಯುತ್ತಾ ದೇಹದ ಶಿಲ್ಪಿಗಳಾಗುವುದು ಹೇಗೆ ಎಂದು ವವಾ ಜೊತೆ ನೀವೂ ತಿಳಿದುಕೊಳ್ಳಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/146763/size7/cd20c6624ef8ec0ffae3fcba78318c40.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/146763/size7/cd20c6624ef8ec0ffae3fcba78318c40.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-84813","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-84813","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":807,"opdsId":"urn:uuid:SW-598673","title":"ಗೆಳೆತನ ಚಿರಕಾಲ ಬಾಳಲಿ! ಮಕ್ಕಳಿಗಾಗಿ ಒಂದು ಹಾಸ್ಯಮಯ ನಾಟಕ","authors":["G W Carlo"],"language":"","readingLevel":"","publisher":"","summary":"ವಿಕ್ರಮ್ ಕಾಯಿಲೆ ಬಿದ್ದ ಕೂಡಲೇ ಅವನನ್ನು ತನ್ನ ಲೋಕಕ್ಕೆ ಕರೆಸಿಕೊಳ್ಳಲು ಯಮರಾಜ ತನ್ನ ದೂತನನ್ನು ಕಳಿಸಿಕೊಡುತ್ತಾನೆ. ಆದರೆ, ವಿಕ್ರಮನ ಸ್ನೇಹಿತರ ಆಲೋಚನೆಯೇ ಬೇರೆಯದಾಗಿರುತ್ತದೆ. ಈ ನಾಟಕವು ಒಂದು ಗಂಭೀರ ವಿಷಯವನ್ನು ತೆಳು ಹಾಸ್ಯದ ಲೇಪನದಿಂದ ಪ್ರಸ್ತುತ ಪಡಿಸುತ್ತದೆ. ಮಕ್ಕಳು ಈ ನಾಟಕವನ್ನು ತುಂಬಾ ಸುಲಭವಾಗಿ ನಿರ್ದೇಶಿಸಿ ಆಡಬಹುದು. ಶಾಲೆಯ ವರ್ಷಾಂತ್ಯಕ್ಕೋ ಅಥವಾ ನೆರೆಹೊರೆಯಲ್ಲಿ ಜರುಗುವ ಕಾರ್ಯಕ್ರಮಗಳಲ್ಲಿ ಸುಲಭವಾಗಿ ಆಡಬಹುದಾದ ನಾಟಕ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/699246/size7/af9f6093a29e3d59668e6c35efe10c2a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/699246/size7/af9f6093a29e3d59668e6c35efe10c2a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-598673","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-598673","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":808,"opdsId":"urn:uuid:SW-111186","title":"ನಾನೊಂದು ಗೊಂಬೆ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ನಾನ್ಯಾರು? ಒಮ್ಮೊಮ್ಮೆ ಬೇರೆ ಯಾವುದೋ ಗ್ರಹದಿಂದ ಬಂದ ಹಾಗೆ ಕಾಣುತ್ತೇನೆ. ಇನ್ನು ಕೆಲವು ಬಾರಿ ಕೋಡಂಗಿಯ ಹಾಗೆ ಕಾಣುತ್ತೇನೆ. ನಾನು ಕುಣಿಯಬಲ್ಲೆ, ಚಲಿಸಬಲ್ಲೆ! ಒಂದು ಬಟ್ಟೆಯ ಚೀಲ ಅಥವಾ ಸಾಕ್ಸ್ ನಲ್ಲಿ ಕೂಡ ಇದ್ದು ಬಿಡಬಲ್ಲೆ! ನನ್ನ ಕುಟುಂಬ ತುಂಬಾ ದೊಡ್ಡದು. ನಿಮ್ಮನ್ನೂ ಭೇಟಿಯಾಗಬೇಕಲ್ಲ ನಾನು!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/179726/size7/60ff2df992655244ab28c10c77af7c09.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/179726/size7/60ff2df992655244ab28c10c77af7c09.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-111186","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-111186","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":809,"opdsId":"urn:uuid:SW-473142","title":"ಹೂವಿನಿಂದ ಆಕೃತಿಗಳು","authors":["Sushma Venkatesh"],"language":"","readingLevel":"","publisher":"","summary":"ಓಣಂ ಹಬ್ಬವನ್ನು ಆಚರಿಸಲು ನಿಕ್ಕು ಮತ್ತು ಅವನ ಅಕ್ಕ ಹೂಗಳ ಸುಂದರವಾದ ರಂಗೋಲಿಯನ್ನು ಬಿಡಿಸುತ್ತಿದ್ದಾರೆ. ಈ ರಂಗೋಲಿಯಲ್ಲಿನ ವಿವಿಧ ಆಕಾರಗಳನ್ನು ಗುರುತಿಸೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/480203/size7/c4c3e54f9eb1af4be5e0035b26927543.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/480203/size7/c4c3e54f9eb1af4be5e0035b26927543.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-473142","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-473142","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":810,"opdsId":"urn:uuid:SW-47780","title":"ನನ್ನಜ್ಜಿಯ ಕೈಚಳಕ","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಎಸೆದು, ಹಿಡಿಯುವಾಟದಲ್ಲಿ ಪಂಟರು ನನ್ನಜ್ಜಿ. ಆಟದಲ್ಲಿ ನನಗಿಂತಲೂ ಚೂಟಿ ನನ್ನಜ್ಜಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722385/size7/10ffc5d352d10bcde84c30ff1f843613.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722385/size7/10ffc5d352d10bcde84c30ff1f843613.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-47780","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-47780","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":811,"opdsId":"urn:uuid:SW-609041","title":"ಆಮೆಚಿಪ್ಪಿನ ಜೀರುಂಡೆ","authors":["Vani Periodi"],"language":"","readingLevel":"","publisher":"","summary":"ರೋಹಿತ್ ಶಾಲೆಯ ನಾಲ್ಕು ಗೋಡೆಯ ಒಳಗೆ ಚಡಪಡಿಸುವುದು ಸುಧಾ ಮೇಡಂಗೆ ಗೊತ್ತಾಗುತ್ತದೆ. ಅವರಿಬ್ಬರೂ ಸರೋವರದ ಪಕ್ಕದಲ್ಲಿ ಹೆಜ್ಜೆ ಹಾಕುತ್ತಾರೆ. ಅಲ್ಲಿ ಆಮೆ ಚಿಪ್ಪಿನ ಜೀರುಂಡೆಯನ್ನು ಭೇಟಿಯಾಗುತ್ತಾರೆ. ಅದು ರೋಹಿತನಂತೆ ತನ್ನದೇ ಹಾದಿಯಲ್ಲಿ ನಡೆಯುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727667/size7/e1efb17d84f2b0c0fc5b207920ff7c45.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727667/size7/e1efb17d84f2b0c0fc5b207920ff7c45.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-609041","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-609041","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":812,"opdsId":"urn:uuid:SW-50116","title":"ಗಿರ ಗಿರ ಸುತ್ತು","authors":["Hema Hebbagodi"],"language":"","readingLevel":"","publisher":"","summary":"ಎಲ್ಲೆಲ್ಲೂ ಗಿರ ಗಿರ ಸುತ್ತುವ ಗೋಳವೇ ಇದೆ. ಗಿರ ಗಿರ ಸುತ್ತುತ್ತಲೇ ಏನೇನೆಲ್ಲಾ ಆಗಬಹುದಲ್ಲ. ಹೇಗೆ ಎಂದಿರಾ? ಓದಿ ನೋಡಿ ಮತ್ತೆ...","coverUrl":"https://static.storyweaver.org.in/illustration_crops/93978/size7/7483e2a4f16e97d5b60ff3e8abd540b5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/93978/size7/7483e2a4f16e97d5b60ff3e8abd540b5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-50116","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-50116","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":813,"opdsId":"urn:uuid:SW-109782","title":"ದಡ್ಡರ ಶಾಲೆಗೆ ಯಾರು ಹೋಗ್ತಾರೆ?","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ದಡ್ಡರು ಮಾತ್ರ ಶಾಲೆಗೆ ಹೋಗುತ್ತಾರೆ ಎಂಬುದು ಸಾಂಭನ ತೀರ್ಮಾನ. ಒಂದು ದಿನ ಟೀಚರ್‌ ಅವನನ್ನು ಶಾಲೆಗೆ ಕರೆದೊಯ್ದರು. ಕಲಿಕೆಯ ನಲಿವನ್ನು ಅನುಭವಿಸಿದ ಸಾಂಭ ಮರುದಿನವೂ ಹೋದನೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495472/size7/49f2e662fe988adbe41d7411b2b7585f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495472/size7/49f2e662fe988adbe41d7411b2b7585f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-109782","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-109782","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":814,"opdsId":"urn:uuid:SW-536110","title":"ಹೊಸ ಗ್ರಹದ ಕತೆ","authors":["Lakshmi B R -  SSO,  Jawaharlal Nehru Planetarium"],"language":"","readingLevel":"","publisher":"","summary":"ಅನ್ವಿಗೆ ಬಾಹ್ಯಾಕಾಶವೆಂದರೆ ಎಲ್ಲಿಲ್ಲದೆ ಉತ್ಸುಕತೆ. ಸಂಜೆಯಾಯಿತೆಂದರೆ \nದೂರದರ್ಶಕಕ್ಕೆ ಅಂಟಿಕೊಂಡೇ ಬಿಡುತ್ತಾಳೆ. ಅನ್ಯಗ್ರಹ ಜೀವಿಗಳಿವೆಯೇ \nಎಂಬ ಹುಡುಕಾಟದಲ್ಲಿದ್ದಾಳೆ. ಒಂದು ರಾತ್ರಿ ಅವಳು ಅಂತಹ ಅನ್ಯಗ್ರಹ \nಜೀವಿಗಳನ್ನು ಭೇಟಿ ಮಾಡುತ್ತಾಳೆ. ಅವುಗಳ ಗ್ರಹವನ್ನೂ ತಲುಪುತ್ತಾಳೆ, \nಮತ್ತು ಸೌರಮಂಡಲದಾಚೆಗೂ ಅನ್ಯಗ್ರಹಗಳಿವೆ, ಮಿಲ್ಕಿ ವೇ (ಕ್ಷೀರಪಥ) \nಇವೆ ಎಂದು ಮನಗಾಣುತ್ತಾಳೆ. ಈ ಅನ್ಯಗ್ರಹದ ಬಗ್ಗೆ ಹೆಚ್ಚು ತಿಳಿಯಲು \nಪುಸ್ತಕವನ್ನು ಪೂರ್ತಿ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/700845/size7/39c84c0cb8b91e4c766d58f6ae5a2722.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/700845/size7/39c84c0cb8b91e4c766d58f6ae5a2722.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-536110","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-536110","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":815,"opdsId":"urn:uuid:SW-167086","title":"ಒಂದೇ ಉಸುರಿನಲಿ ಹೇಳು","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಈ ಪುಸ್ತಕವು ಅನೇಕ ಅನುಕರಣ ಶಬ್ದಗಳನ್ನು ಮಕ್ಕಳ ಮುಂದಿಟ್ಟು ಅವನ್ನು ಒಂದೇ ಉಸುರಿನಲ್ಲಿ ಹೇಳುವ ಸವಾಲನ್ನು ಹಾಕುತ್ತದೆ.  ಈ ಶಬ್ದಗಳನ್ನು ಒಂದೇ  ಉಸುರಿನಲ್ಲಿ ಹೇಳಬಹುದು ಎಂದು ನಿಮಗೆ ಅನಿಸುತ್ತದೆಯೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/120578/size7/884b07889a34d43f8bc35b1c18d12483.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/120578/size7/884b07889a34d43f8bc35b1c18d12483.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-167086","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-167086","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":816,"opdsId":"urn:uuid:SW-457213","title":"ಹುಲ್ಲಿನ ಪ್ರವಾಸ","authors":["Chethana Gururaju"],"language":"","readingLevel":"","publisher":"","summary":"ಹುಲ್ಲುಗಳಲ್ಲಿ ಅನೇಕ ವಿಧಗಳಿವೆ, ಅದು ಮೃದುವಾಗಿ, ಒರಟಾಗಿಯೂ ಇರಬಹುದು, ಹುಲ್ಲಿಗೆ ವಾಸನೆ-ರುಚಿ ಕೂಡ ಇರಬಹುದು. ಎಲ್ಲಕ್ಕಿಂತ ಹೆಚ್ಚಾಗಿ ಹುಲ್ಲಿನ ಮೇಲೆ ಕುಳಿತು ಮನೆಯವರೆಲ್ಲ ಹರಟೆ ಹೊಡೆಯಬಹುದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/474156/size7/d3b59531e7aa166d232530da42547ac8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/474156/size7/d3b59531e7aa166d232530da42547ac8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-457213","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-457213","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":817,"opdsId":"urn:uuid:SW-150249","title":"ಗಡಿಬಿಡಿ ಕುವೊಂಬಾ","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಕುವೊಂಬಾಗೆ ಒಂದು ಸಾವಿರ ಸಿಹಿ-ತಿಂಡಿಯ ಆರ್ಡರ್ ಸಿಕ್ಕಿದೆ. ಅವಳಿಗೆ ತುಂಬಾ ಖುಷಿಯಾಗಬೇಕಲ್ಲ, ಇಲ್ಲ ಇಲ್ಲ ಅವಳಿಗೆ ತುಂಬಾ ಚಿಂತೆಯಾಗಿ ಬಿಟ್ಟಿದೆ. ಔತಣದ ಹೊತ್ತಿಗೆ ಅವಳು ಸಾವಿರ ಬಾದೂಶಾ ಮಾಡುವಳೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527508/size7/513f04e8b2e0702bd7dd0c187bfa0544.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527508/size7/513f04e8b2e0702bd7dd0c187bfa0544.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-150249","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-150249","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":818,"opdsId":"urn:uuid:SW-39012","title":"ಬೆಳದಿಂಗಳ ಹೂ ನೀಲಂಬರ","authors":["Sarita Sharan"],"language":"","readingLevel":"","publisher":"","summary":"ಬಾಲಕ ಬಾಕುವಿಗೆ ಪಕ್ಷಿಗಳನ್ನು ಎಣಿಸುವುದು ಮತ್ತು ನೋಡುವುದು ಎಂದರೆ ತುಂಬ ಇಷ್ಟ. ಒಂದು ದಿನ ಅವನು ವರ್ಣ ರಂಜಿತ ಮರಗಳಿರುವ ಮಾಂತ್ರಿಕ ಅರಣ್ಯದಲ್ಲಿ ಅಲೆದಾಡುತ್ತಿದ್ದ. ಅಲ್ಲಿ ರಹಸ್ಯಮಯ ನೀಲಂಬರ ಹೂವಿನಿಂದ ಮಾತ್ರ ಬಗೆ ಹರಿಸಬಹುದಾದ ತೊಂದರೆ ಇದೆ. ಹಾಗಾದರೆ, ಬಾಕುವಿನ ಗಣಿತ ಪ್ರೀತಿ ಇಲ್ಲಿ ಏನಾದರೂ ಸಹಾಯಕ್ಕೆ ಬರಬಹುದೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717163/size7/47efdbfa0c0dde089ef79512fcb80310.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717163/size7/47efdbfa0c0dde089ef79512fcb80310.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-39012","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-39012","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":819,"opdsId":"urn:uuid:SW-648326","title":"ಕತೆಗಳ ಅರಮನೆ","authors":["G W Carlo"],"language":"","readingLevel":"","publisher":"","summary":"ಕತೆಗಳೆಂದರೆ ತಾರಾಳ ಒಡಲಲ್ಲಿ ಕಿಚ್ಚು ಹಚ್ಚಿಂತಾಗುತ್ತದೆ. ಆದರೆ, ಅವಳ ಕತೆಗಳನ್ನ ಎಲ್ಲರೂ ಇಷ್ಟಪಡುತ್ತಾರೆ ಎನ್ನುವುದಕ್ಕಾಗುವುದಿಲ್ಲ. ಹಾಗಾದಾಗ ಆ ಕಿಚ್ಚು ಮಂದವಾಗುತ್ತದೆ. ಈ ಮಂದಬೆಳಕು ಉಜ್ವಲವಾಗಿ ಬೆಳಗುವುದೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721015/size7/04642886bdacd719fb0fecb104538fbd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721015/size7/04642886bdacd719fb0fecb104538fbd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-648326","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-648326","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":820,"opdsId":"urn:uuid:SW-433011","title":"ಮನು, ಏನು ತಂದಿರುವೆ?","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಅಮ್ಮ, ಮನುಗೆ ಮನೆಯ ತೋಟದಿಂದ ಕರಿಬೇವಿನ ಸೊಪ್ಪು ತರುವಂತೆ ಹೇಳುತ್ತಾಳೆ. ತೋಟಕ್ಕೆ ಹೋದಾಗ ಮನುಗೆ ಏನೇನು ಕಾಣಿಸತ್ತೆ? ಅವಳಿಗೆ ಕರಿಬೇವಿನ ಸೊಪ್ಪು ಸಿಗುತ್ತಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727492/size7/ea61d24e3acfe89421e29402e622494a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727492/size7/ea61d24e3acfe89421e29402e622494a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-433011","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-433011","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":821,"opdsId":"urn:uuid:SW-134515","title":"ರೇಖೆಗಳು","authors":["Girish Jakapure"],"language":"","readingLevel":"","publisher":"","summary":"ಭೂಮಿಯ ಮೇಲಿನ ಗಡಿರೇಖೆಗಳೆಲ್ಲವೂ ಮಾಯವಾಗಿರುವಂತೆ ಚೆಂದನೆಯ ಕನಸು ಕಂಡ ಕವಿಯೊಬ್ಬನ ಅಹ್ಲಾದಕರ ಬೆಳಗು ಇಲ್ಲಿದೆ. ಕನಸು ಮತ್ತು ವಾಸ್ತವದ ವಿಭಿನ್ನ ಸ್ವರೂಪ ಇದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727184/size7/44cec01e185be251620561bf58021d26.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727184/size7/44cec01e185be251620561bf58021d26.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-134515","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-134515","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":822,"opdsId":"urn:uuid:SW-161008","title":"ತುಸು ಎತ್ತರಕೆ ಹಾರು ಹೆಬ್ಬಕವೇ","authors":["Smitha sathyaprakash"],"language":"","readingLevel":"","publisher":"","summary":"ರಾನಿಯಾ, ಹೆಬ್ಬಕ ಹಾಗೂ ಅದರ ಮರಿಯನ್ನು ಸುರಕ್ಷಿತವಾಗಿಡಲು ಪಣ ತೊಟ್ಟಿದ್ದಾಳೆ. ಆದರೆ, ಈ ಪಕ್ಷಿಯ ಉಳಿವಿಗೆ ಎದುರಾಗಿರುವ ಸವಾಲುಗಳು ಅದೆಷ್ಟೊ...","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725157/size7/871c16caf664d0153a35c59751334ca9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725157/size7/871c16caf664d0153a35c59751334ca9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-161008","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-161008","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":823,"opdsId":"urn:uuid:SW-68059","title":"ಮಾದರಿ ಹಸುರೆಲೆ","authors":["Sunanda Patil"],"language":"","readingLevel":"","publisher":"","summary":"ನಗರದಲ್ಲಿರುವ ಗಾಳಿ ಕಡು ಬೂದು ಬಣ್ಣಕ್ಕೆ ತಿರುಗಿದ್ದು ನಯನತಾರಾ ಮತ್ತು ಅಲೀಜಾಗೆ ಉಸಿರುಗಟ್ಟಿಸುತ್ತಿದೆ. ಹಗಲು ರಾತ್ರಿ ಆಮ್ಲಜನಕ ಮತ್ತು ಶುದ್ಧ ಶಕ್ತಿಯನ್ನು ಬಿಡುಗಡೆ ಮಾಡುವ ಕೃತಕ ಎಲೆಗಳು ಇದ್ದಿದ್ದರೆ ಎಷ್ಟು ಚೆನ್ನಾಗಿರುತ್ತಿತ್ತು ಎಂದು ಯೋಚಿಸುತ್ತಿದ್ದಾರೆ. ಅವರೂ ಈ ಮಾದರಿಯ ಎಲೆ ತಯಾರಿಸುವರೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/718464/size7/347a0a585fadb43ad09779f4df38781d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/718464/size7/347a0a585fadb43ad09779f4df38781d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-68059","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-68059","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":824,"opdsId":"urn:uuid:SW-110830","title":"ಮೇಗನ್ ಮತ್ತು ಚೈತನ್ಯದ ಸೇತುವೆ","authors":["Srinidhi  TG"],"language":"","readingLevel":"","publisher":"","summary":"‘ಮೋಡಗಳ ಮನೆ ಸರಣಿ’ಯಲ್ಲಿ ಇದು ಕೊನೆಯ ಪುಸ್ತಕ. ಮೇಗನ್, ಫ್ರಿಟ್ಸ್ ಹಾಗೂ ರಾಜಕುಮಾರಿ ಇಳವರಸಿ ಒಂದು ವಿಚಿತ್ರ ಜಗತ್ತಿನಲ್ಲಿ ಸಿಲುಕಿದ್ದಾರೆ. ಅಲ್ಲಿ ಬೇರುಗಳು ಸೇತುವೆಗಳನ್ನು ಹೆಣೆದಿವೆ, ವಿಚಿತ್ರವಾದ ರೆಂಬೆ ಮನುಷ್ಯರು ಶ್ರಮದ ಕೆಲಸಗಳಲ್ಲಿ ತೊಡಗಿಕೊಂಡಿದ್ದಾರೆ. ಕೊನೆಗೆ ಮೇಗನ್ ಮತ್ತು ಫ್ರಿಟ್ಸ್ ತಮ್ಮ ಮನೆ ತಲುಪುತ್ತಾರೋ ಇಲ್ಲವೋ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/157769/size7/726e581a8443f136ed090f2427adc97d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/157769/size7/726e581a8443f136ed090f2427adc97d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-110830","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-110830","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":825,"opdsId":"urn:uuid:SW-150467","title":"ಕಳವು ಮಾಡಿದ ಗುಟ್ಟುಗಳ ಪುಸ್ತಕ","authors":["G W Carlo"],"language":"","readingLevel":"","publisher":"","summary":"ಗುಟ್ಟುಗಳೆಂದರೆ ಕೇವಲ ನಮ್ಮ ನಂಬಿಕಸ್ಥರೊಂದಿಗೆ ಮಾತ್ರ ಹಂಚಿಕೊಳ್ಳುವಂತಾಗಿರುತ್ತವೆ. ಆದರೂ ಗುಟ್ಟುಗಳನ್ನು ಕದಿಯುವ ಖದೀಮರೂ ಇದ್ದಾರೆ, ಎಚ್ಚರ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/202721/size7/8cd9b17890f3fc83d5706bfbae25e596.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/202721/size7/8cd9b17890f3fc83d5706bfbae25e596.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-150467","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-150467","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":826,"opdsId":"urn:uuid:SW-111190","title":"ಬಾಂಬೆಡಕ್ಸ್, ಬಾಂಬೆಡಾಕ್ಸ್","authors":["Pallavi Rao"],"language":"","readingLevel":"","publisher":"","summary":"ಮಳೆ ಸುರಿಯುತ್ತಿದೆ, ಏನು ಮಾಡೋಣ? ಬನ್ನಿ, ಅಜ್ಜಿಯ ಬಳಿ ಕುಳಿತು ಆಕೆ ಹೇಳುವ ಬಾಂಬೆ ನಗರದ ಮೂಲನಿವಾಸಿಗಳಾದ ಕೋಳಿ ಸಮುದಾಯ, ಅವರ ಮೆಚ್ಚಿನ ಮೀನಾದ ಬಾಂಬೆ ಡಕ್ ಮತ್ತು ಈ ನಗರದ ಶ್ರೇಷ್ಠ ಡಾಕ್‌ಗಳ ಬಗ್ಗೆ ಕತೆ ಕೇಳೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723772/size7/b0476b13553c024e91d6672d33eb8bf7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723772/size7/b0476b13553c024e91d6672d33eb8bf7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-111190","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-111190","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":827,"opdsId":"urn:uuid:SW-593838","title":"ನನ್ನ ಹಳದಿ ಕೊಡೆ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಮೋಡ ಕವಿದು, ಮಳೆ ಬೀಳುತ್ತಿರುವಾಗ ಸುಮ್ಮನೇ ಮನೆಯಲ್ಲಿ ಕೂತಿರುವುದು ಬೇಸರದ ವಿಷಯವಲ್ಲವೇ? ಅದೇ ಒಂದು ಕೊಡೆ ಇದ್ದರೆ... ಜಾದೂ ಮಾಡಿದಂತೆ ಎಲ್ಲ ಕಡೆ ಸುತ್ತಾಡಿ ಬರಬಹುದು. ನಾನಂತೂ ನನ್ನ ಕೊಡೆಯನ್ನ ಬಿಸಿಲು ಮಳೆಯಿಂದ ಬಚಾವಾಗಲು ಮಾತ್ರವಲ್ಲ, ಇನ್ನೂ ಬೇರೆ ಬೇರೆಯದಕ್ಕೆಲ್ಲ ಬಳಸುತ್ತೇನೆ. ಹೇಗೆ? ಈ ಸುಂದರವಾದ ಚಿತ್ರ ಪುಸ್ತಕದಲ್ಲಿ ಕಂಡುಹಿಡಿಯಿರಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/706685/size7/d283c7549928879966054e39f420f4ad.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/706685/size7/d283c7549928879966054e39f420f4ad.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-593838","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-593838","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":828,"opdsId":"urn:uuid:SW-151852","title":"ಅಳೆದು ಅರಿಯೋಣ","authors":["Manjunatha Kollegala"],"language":"","readingLevel":"","publisher":"","summary":"ಜಗತ್ತಿನಲ್ಲಿ ಅನೇಕ ವಸ್ತುಗಳಿವೆ - ದೊಡ್ಡವು, ಚಿಕ್ಕವು, ನಡುವಿನವು. \nದೊಡ್ಡ ಸಂದೇಶ ಹೊತ್ತ ಪುಟ್ಟ ಪುಸ್ತಕ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/300525/size7/1ae8271ff5b7dc30824b20d2844d6b57.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/300525/size7/1ae8271ff5b7dc30824b20d2844d6b57.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-151852","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-151852","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":829,"opdsId":"urn:uuid:SW-608933","title":"ಬಬ್ಲೂ ಕರಡಿಯ ಸಾಹಸ","authors":["G W Carlo"],"language":"","readingLevel":"","publisher":"","summary":"ಮರಿ ಕರಡಿ ಬಬ್ಲೂನ ಬಾಲ್ಯ, ಅಕ್ಷರಶಃ ತುಂಬಾ ರೋಚಕ, ರೋಮಾಂಚಕ ಮತ್ತು ಅನಿರೀಕ್ಷಿತ ತಿರುವುಗಳಿಂದ ಕೂಡಿದೆ... ಮಕ್ಕಳೇ, ಇಂದು ರಾತ್ರಿ ಅವನ ಸಾಹಸದಲ್ಲಿ ಪಾಲ್ಗೊಳ್ಳಿ ಮತ್ತು ಹಿಮಾಲಯದ ಕರಡಿಗಳ ಬಗ್ಗೆ ನೀವು ಕೇಳಿರದ ರಹಸ್ಯಗಳನ್ನು ತಿಳಿದುಕೊಳ್ಳಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/338743/size7/c05eddae0c19fbc46d6f76c842257141.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/338743/size7/c05eddae0c19fbc46d6f76c842257141.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-608933","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-608933","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":830,"opdsId":"urn:uuid:SW-607652","title":"ಭಾನು ಮನೆಗೆ ಹೋದಾಗ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಸಂಜೆಯಾಗಿದೆ. ದಿನವಿಡೀ ಜಗತ್ತಿಗೆ ಬೆಳಕು ನೀಡಿದ ಭಾನು, ಮನೆಗೆ ಹೋಗಿ ಏನು ಮಾಡುತ್ತಾಳೆ? ಬನ್ನಿ, ಕಂಡುಹಿಡಿಯೋಣ. ಯಾಕೆಂದ್ರೆ, ಭಾನು ಇವತ್ತು ನಮ್ಮನ್ನು ಅವಳ ಮನೆಗೆ ಕರೆದಿದ್ದಾಳೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727561/size7/d0b0360c3226354b8c5cdf08132da580.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727561/size7/d0b0360c3226354b8c5cdf08132da580.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-607652","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-607652","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":831,"opdsId":"urn:uuid:SW-592542","title":"ಆಮೆಯ ಮನೆ ಎಲ್ಲಿದೆ?","authors":["Anasuya Patil"],"language":"","readingLevel":"","publisher":"","summary":"ಎಷ್ಟು ಹುಡುಕಿದರೂ ಆಮೆಗೆ ಅದರ ಮನೆ ಸಿಗುತ್ತಿಲ್ಲ. ಸಹಾಯ ಮಾಡಲು ಸ್ನೇಹಿತರೆಲ್ಲ ಬಂದರು. ಅಷ್ಟರಲ್ಲಿ, ಆಗಸದಲ್ಲಿ ಮೋಡ ಕವಿದು, ಮಿಂಚು ಫಳಫಳಿಸಿತು. ಮಳೆ ಜೋರಾಗುವ ಮುನ್ನ ಆಮೆಗೆ ಅದರ ಮನೆ ಸಿಗಬಹುದೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/155655/size7/e111449adb4271c522d46faaee259b6b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/155655/size7/e111449adb4271c522d46faaee259b6b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-592542","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-592542","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":832,"opdsId":"urn:uuid:SW-106046","title":"ಸೋಮಾರಿ ಅನಾನ್ಸಿ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಜೇಡನ ಕಾಲುಗಳು ತೆಳ್ಳಗೆ ಉದ್ದವಾಗಿರುವುದೇಕೆ ?!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/141916/size7/8c5af656393928f97fa73d07f95af337.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/141916/size7/8c5af656393928f97fa73d07f95af337.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-106046","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-106046","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":833,"opdsId":"urn:uuid:SW-457175","title":"ಎಲ್ಲ ತಲೆಕೆಳಗಾಗಿದೆ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಚಿಕ್ಕ ಹುಡುಗನ ಮನೆಯಲ್ಲಿ ಎಲ್ಲವೂ ತಲೆಕೆಳಗಾಗಿದೆ. ಇದಕ್ಕೆ ಕಾರಣ ಏನಿರಬಹುದು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721697/size7/0fcb6532f2e9a502c9e31714d6fd1ead.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721697/size7/0fcb6532f2e9a502c9e31714d6fd1ead.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-457175","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-457175","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":834,"opdsId":"urn:uuid:SW-643363","title":"ಸುರ್ಕಿ ಮತ್ತು ತಿರ್ಕಿ","authors":["Jayant Kaikini"],"language":"","readingLevel":"","publisher":"","summary":"ಅವರಿಬ್ಬರೂ ಒಂದೇ ಊರಲ್ಲಿರ್ತಾರೆ, ಒಂದೇ ಶಾಲೆಗೆ ಹೋಗ್ತಾರೆ, ಒಂದೇ ತರಗತಿಯಲ್ಲಿ ಓದ್ತಾರೆ, ಜೊತೆಗೇ ಆಡ್ತಾರೆ, ಜೊತೆಗೇ ಊರೆಲ್ಲಾ ಅಲೀತಾರೆ. ಆದರೆ, ಒಂದು ದಿನ ಒಬ್ಳಿಗೆ ಇನ್ನೊಬ್ಳ ಮೇಲೆ ಕೋಪಬರುತ್ತದೆ. ಎಷ್ಟು ಕೋಪ ಅಂದ್ರೆ ಅವಳನ್ನು ‘ಠೂ’ ಬಿಡೋದಕ್ಕೆ ತಯಾರಾಗ್ತಾಳೆ. ಅವಳಿಂದ ಅದು ಆಗತ್ತಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723785/size7/08982ebf4248ab5af8d52394d3018a29.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723785/size7/08982ebf4248ab5af8d52394d3018a29.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-643363","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-643363","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":835,"opdsId":"urn:uuid:SW-592537","title":"ನಾನೊಂದು ಮರ","authors":["Anasuya Patil"],"language":"","readingLevel":"","publisher":"","summary":"ಏನ್ ಮಾಡಿದರೂ ಗ್ರೀನಿ ಮಧ್ಯಾಹ್ನ ಮಲಗುತ್ತಿಲ್ಲ! ಒಂದು ದಿನ, ಅವಳು ಮನೆಯಿಂದ ಹೊರಗೆ ಹೋಗಲು ನಿರ್ಧರಿಸುತ್ತಾಳೆ. ಬಿಸಿಲಲ್ಲಿ ಸ್ವಲ್ಪ ಹೊತ್ತು ಆಡುತ್ತಿದ್ದಂತೆ ಅವಳಿಗೆ ಸುಸ್ತಾಗುತ್ತದೆ. ಆಗ ಮನೆಗೆ ಹೋಗಲು ಬಯಸುತ್ತಾಳೆ. ಆದರೆ, ಮನೆಯ ದಾರಿ ಮರೆತು ಹೋಗಿದೆ! ಮನೆಗೆ ಹೋಗಲು ಗ್ರೀನಿ ಏನು ಮಾಡಬಹುದು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/128573/size7/1c8f6b19b30f9b21d2e8056d18a04ab7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/128573/size7/1c8f6b19b30f9b21d2e8056d18a04ab7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-592537","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-592537","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":836,"opdsId":"urn:uuid:SW-556527","title":"ದಾದು ಜೊತೆ ಊಟ","authors":["Sudha Shankar"],"language":"","readingLevel":"","publisher":"","summary":"ಶನಿವಾರದ ಬಿಸಿಲ ಮಧ್ಯಾಹ್ನಗಳು ಮೊಸರನ್ನದ ಸಮಯ. ಟಿಮ್‌ಟಿಮ್, ಮಿನು, ಬಿನಿ ಗುಂಪು ದಾದು ಮನೆಯ ರುಚಿಕರವಾದ ಪುಡಿ, ಉಪ್ಪಿನಕಾಯಿಗಳ ಊಟಕ್ಕೆ ಸೇರಿದೆ. ಇವರ ಜೊತೆಗೆ ನೀವೂ ಸೇರಿಕೊಳ್ಳಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/626858/size7/610ed5f166d8abe7df5d412be42f6476.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/626858/size7/610ed5f166d8abe7df5d412be42f6476.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-556527","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-556527","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":837,"opdsId":"urn:uuid:SW-311083","title":"ದುಗ್ಗಾ","authors":["Tanuja Jakkannavar"],"language":"","readingLevel":"","publisher":"","summary":"ಪ್ರತಿದಿನವೂ ದುಗ್ಗಾಳಿಗೆ ಏನಾದರೂ ಹೊಸದು ಬೇಕು. ನೋಡಲು, ಮೂಸಲು... ಯಾವುದೇ ಖುಷಿಯಾದ ನಾಯಿಯಂತೆ, ಅವಳೂ ನಿದ್ದೆ ಮಾಡುತ್ತಾಳೆ, ತಿನ್ನುತ್ತಾಳೆ, ಆಡುತ್ತಾಳೆ. ಬದುಕು ತಲೆಕೆಳಗಾದಂತಹ ಆ ದಿನದವರೆಗೂ ಹಾಗೇ ಇದ್ದಳು. ಯಾವುದೇ ಮುನ್ಸೂಚನೆಯಿಲ್ಲದೆ ದುಗ್ಗಾ ನೋವಿನ ಜಗತ್ತಿನೊಳಗೆ ಎಸೆಯಲ್ಪಟ್ಟಳು. ನಂತರ ಅದರಿಂದ ಹೊರಗೆ ಬಂದ ದುಗ್ಗಾ ಸಂತೋಷ, ಪ್ರೀತಿ ಮತ್ತು ಮಮಕಾರವನ್ನು ಮರಳಿ ಪಡೆಯುತ್ತಾಳೆ. ಇದು ದಯಾವಂತರ ಹಾಸ್ಯ, ಕರುಣೆ ಮತ್ತು ಆರೈಕೆ, ಕಾಳಜಿ ಕುರಿತಾದ ಕತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/481175/size7/02d36478346ebc81530ec4d3e795b92d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/481175/size7/02d36478346ebc81530ec4d3e795b92d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-311083","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-311083","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":838,"opdsId":"urn:uuid:SW-110179","title":"ಮೇಗನ್ ಮತ್ತು ಓಡಾಡುವ ಬಂಡೆಯ ರಹಸ್ಯ","authors":["Srinidhi  TG"],"language":"","readingLevel":"","publisher":"","summary":"ಮೇಗನ್ ಗೆ ಬಿಡುವೇ ಇಲ್ಲ. ‘ಫ್ರಿಟ್ಸ್’ ಹೆಸರಿನ ಅವಳ ಬೆಕ್ಕು ಕಾಣೆಯಾಗಿದ್ದು ಹೇಗೆ ಎನ್ನುವ ರಹಸ್ಯವನ್ನು ಅವಳು ಬಯಲು ಮಾಡಬೇಕಿದೆ. ಆ ಬಂಡೆಯಂಥ ಭಯಾನಕ ಪ್ರಾಣಿಯನ್ನು ಬೆನ್ನಟ್ಟಿ ವಿಚಿತ್ರವಾದ ಹೊಸ ಲೋಕಕ್ಕೆ ಹೋದರೂ ಸರಿಯೇ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/157760/size7/6cdf56d742712f6c42562ce908f7bd12.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/157760/size7/6cdf56d742712f6c42562ce908f7bd12.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-110179","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-110179","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":839,"opdsId":"urn:uuid:SW-557960","title":"ನಾನು ಮತ್ತು ಆಫೋ","authors":["Dr H R Krishnamurthy"],"language":"","readingLevel":"","publisher":"","summary":"ವಿನೋಕನ ಪಾಲಿಗೆ - ಅವನ ಹಳ್ಳಿ, ಪರ್ವತಗಳು, ವಾಯುಗುಣ ಎಲ್ಲವೂ ಬದಲಾಗುತ್ತಿದೆ. ಇದೀಗ ಅವನ ಅಕ್ಕ ಕೂಡ ದೂರ ಹೋಗುತ್ತಿದ್ದಾಳೆ. ಈ ಎಲ್ಲ ದೊಡ್ಡ ಬದಲಾವಣೆಗಳಿಗೆ ಅವನು ಹೇಗೆ ಹೊಂದಿಕೊಳ್ಳುತ್ತಾನೆ? ಇದು, ವಾಯುಗುಣ ಬದಲಾವಣೆಯ ಪರಿಣಾಮವಾಗಿ ವಲಸೆ ಮತ್ತು ಹಿಂದೆಂದಿಗಿಂತಲೂ ವೇಗವಾಗಿ ಬದಲಾಗುತ್ತಿರುವ ಪ್ರಪಂಚದಲ್ಲಿ, ಮನೆ ಮತ್ತು ಕುಟುಂಬದ ಬಗೆಗಿನ ಕತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/626610/size7/b8db5239328fba7e9bbc9f8b7b71299e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/626610/size7/b8db5239328fba7e9bbc9f8b7b71299e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-557960","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-557960","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":840,"opdsId":"urn:uuid:SW-136427","title":"ಅಂದು ರಾತ್ರಿ","authors":["G W Carlo"],"language":"","readingLevel":"","publisher":"","summary":"ಸಿಟ್ಟಿನ ಕೂಗಾಟದ ದನಿಗೆ ಚೈತು ಎಚ್ಚರಗೊಂಡಳು. ರಾತ್ರಿ ಹೊರಗಡೆ ಕತ್ತಲು ಆದರೆ ದೂರದಲ್ಲಿ ಧಗಧಗನೆ ಉರಿಯುತ್ತಿರುವ ಬೆಂಕಿ. ಚೈತು ತನ್ನ ಕುಟುಂಬ, ಸ್ನೇಹಿತರು ಮತ್ತು ಮನೆಯ ಬಗ್ಗೆ ಭಯಭೀತಳಾಗಿದ್ದಾಳೆ. \nಆ ದನಿಗಳಲ್ಲಿ ಯಾಕಷ್ಟು ಕೋಪ? ಅವರಿಗೆ ಏನಾಗಬೇಕು? ಇದು ಅಂಜಿಕೆ ಮತ್ತು ಅಸಹನೆ ತುಂಬಿದ ಜಗತ್ತಿನ ಸುತ್ತ ಹೆಣೆಯಲಾದ ಕತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/710426/size7/dc91ffc6c1d42b6c393ee8c400316dfa.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/710426/size7/dc91ffc6c1d42b6c393ee8c400316dfa.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-136427","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-136427","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":841,"opdsId":"urn:uuid:SW-223546","title":"ನಯನಳ ಕೊಡೆ","authors":["Shabana Begum"],"language":"","readingLevel":"","publisher":"","summary":"ನಯನ ಒಂದು ಅದ್ಭುತವಾದ ಕೊಡೆಯನ್ನು ಮಾಡಿದಳು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283925/size7/53a84ff9f70e35c16289cd1aceeb2227.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283925/size7/53a84ff9f70e35c16289cd1aceeb2227.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-223546","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-223546","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":842,"opdsId":"urn:uuid:SW-15032","title":"ನಾಪತ್ತೆಯಾದ ಬ್ಯಾಟು","authors":["Bhavya"],"language":"","readingLevel":"","publisher":"","summary":"ರೆಹಮಾನ್  ಚಾಚಾನ ಕಾರ್ಖಾನೆಯಿಂದ ಕ್ರಿಕೆಟ್ ಬ್ಯಾಟೊಂದು ನಾಪತ್ತೆ ಆಗಿರುತ್ತದೆ. ಪುಟ್ಟ ಆಹಮದ್ ನೇ  ಅದನ್ನು ಕದ್ದಿರುವನೆಂದು ಚಾಚಾ ಅನುಮಾನಿಸುತ್ತಾನೆ. ವಿಲೋ ಮರಗಳ ನಾಡಾದ ಕಾಶ್ಮೀರದ  ಒಂದು ಸುಂದರ ಹಾಸ್ಯ ಕಥೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/709415/size7/e95e51b7c1b18b6cf495e95f90fd659e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/709415/size7/e95e51b7c1b18b6cf495e95f90fd659e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15032","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15032","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":843,"opdsId":"urn:uuid:SW-344826","title":"ಗೊರಿಲ್ಲಾ ಪಾರ್ಟಿ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಗೊರಿಲ್ಲಾ ಪಾರ್ಟಿಗೆ ತಯಾರಾಗಿದೆ. ಪಾರ್ಟಿಗೆ ಏನು ಬೇಕು? ತುಂಬಾ ತುಂಬಾ ಟೋಪಿಗಳು! ಪಾರ್ಟಿ ಟೋಪಿಗಳನ್ನು ಗೊರಿಲ್ಲಾ ಮನೆಯಲ್ಲಿ ಎಲ್ಲ ಕಡೆ ಇರಿಸಿದೆ. ಪಾರ್ಟಿ ಟೋಪಿಗಳ ಮೂಲಕ ಸ್ಥಳಗಳನ್ನು ಗುರುತಿಸುವ ಬಗ್ಗೆ ಇರುವ ಮುದ್ದಾದ ಕತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/491328/size7/21e156f5c960f08498b5485296de5fe9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/491328/size7/21e156f5c960f08498b5485296de5fe9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-344826","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-344826","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":844,"opdsId":"urn:uuid:SW-589522","title":"ಅಪ್ಪುಗೆಯ ದಿನ","authors":["Pushpak M"],"language":"","readingLevel":"","publisher":"","summary":"ಇವಳು ಜಿಲ್ಲಿ. ಈ ದಿನ ಜಿಲ್ಲಿ ಊರಲ್ಲಿರುವ ಒಂದೊಂದು ಬೆಕ್ಕನ್ನೂ ಅಪ್ಪಿದಳು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/29567/size7/3b99c56a34d0cfcfc37440bdd0610dd7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/29567/size7/3b99c56a34d0cfcfc37440bdd0610dd7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-589522","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-589522","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":845,"opdsId":"urn:uuid:SW-579769","title":"ಹಕ್ಕಿಯ ಕರೆಯಮ್ಮ!","authors":["Anasuya Patil"],"language":"","readingLevel":"","publisher":"","summary":"ಪುಟ್ಟ ಮಗುವೊಂದು ತನ್ನ ಅಮ್ಮನಿಗೆ ಹೇಳುತ್ತಿದೆ, ಅಮ್ಮಾ, ಅಮ್ಮಾ ಹಕ್ಕಿಯ ಕರೆಯಮ್ಮ ಎಂದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/99534/size7/5f965f2bff43145b1f5f996e90b44970.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/99534/size7/5f965f2bff43145b1f5f996e90b44970.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-579769","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-579769","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":846,"opdsId":"urn:uuid:SW-592531","title":"ಭಾಭೋ ಎಂಬ ಎಮ್ಮೆ","authors":["Anasuya Patil"],"language":"","readingLevel":"","publisher":"","summary":"ಭಾಭೋ ಎಮ್ಮೆಗೆ ಚೆಂದದ ಕೋಡುಗಳಿದ್ದವು. ಒಂದು ದಿನ ಮಳೆ ಬಂದಾಗ ಅದರ ಕೋಡುಗಳು ತೊಯ್ದವು. ಆಮೇಲೆ ಗಾಳಿ ಬೀಸಿದಾಗ, ಕೋಡಿನ ಮೇಲೆ ಧೂಳು, ಮಣ್ಣು ಕೂತಿತು. ಮರುದಿನ, ಹಾರಿ ಹೋಗುತ್ತಿದ್ದ ಹಕ್ಕಿಯ ಕೊಕ್ಕಿನಿಂದ ಕಾಳೊಂದು ಜಾರಿ ಭಾಭೋನ ಕೋಡಿನ ಮೇಲೆ ಬಿದ್ದಿತು. ಆ ಕಾಳು ಮೊಳೆಕೆಯೊಡೆದು ಸಸಿಯಾಗಿ ಗಿಡವಾಯಿತು. ಕೋಡಿನ ಮೇಲೆ ಬೆಳೆದ ಮರವನ್ನು ಏನು ಮಾಡಬಹುದು ಭಾಬೋ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/93904/size7/7497d29c1c21ab7acb6c159708ce9bd9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/93904/size7/7497d29c1c21ab7acb6c159708ce9bd9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-592531","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-592531","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":847,"opdsId":"urn:uuid:SW-443549","title":"ಉದ್ಯಾನದಲ್ಲಿ ವೃತ್ತಗಳು","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಚಿಲ್ಟು ಮತ್ತು ತಾರಾ ಆಟವಾಡಲು ಪಾರ್ಕಿಗೆ ಹೋಗುತ್ತಾರೆ. ಅವರು ತಮ್ಮ ಸುತ್ತಮುತ್ತ ಏನು ನೋಡುತ್ತಾರೆ? ಈ ಪುಟ್ಟ ಪುಸ್ತಕವು ವೃತ್ತ, ಅರ್ಧ-ವೃತ್ತ ಮತ್ತು ಅದಕ್ಕಿಂತ ಚಿಕ್ಕದಾದ ಕಾಲು-ವೃತ್ತಗಳನ್ನು ಪರಿಚಯಿಸುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716360/size7/6fc2c67115bf34f0d009b7009d9c9fbc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716360/size7/6fc2c67115bf34f0d009b7009d9c9fbc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-443549","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-443549","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":848,"opdsId":"urn:uuid:SW-39009","title":"ಸ್ಪಂಜಿನಂತಹ ಕೇಕ್ ಮಾಡುವುದು ಹೇಗೆ?","authors":["Brinda N Rao"],"language":"","readingLevel":"","publisher":"","summary":"ಬಿಮ್ಲಾಳಿಗಾಗಿ ಗೆಳತಿ ಚಿನ್ನಿ ಮತ್ತು ಅವಳ ಅಪ್ಪ ತಮ್ಮ ಬೇಕರಿಯಲ್ಲಿ ಕೇಕ್ ಮಾಡುತ್ತಾರೆ. ಸ್ಪಂಜಿನಂತಹ ಕೇಕ್ ಮಾಡುವುದನ್ನು ತಿಳಿಯೋಣ ಬನ್ನಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725317/size7/bbd2c0e9207e71489f941e2cfc06cf8e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725317/size7/bbd2c0e9207e71489f941e2cfc06cf8e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-39009","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-39009","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":849,"opdsId":"urn:uuid:SW-593066","title":"ಡುಂಗ್ ಡುಂಗ್, ಡಮ್ ಡಮ್","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಡಂಬರುವಿಗೆ ತೋಪಿನ ಕಡೆಯಿಂದ ವಿಚಿತ್ರ ಶಬ್ದಗಳು ಕೇಳಿಸುತ್ತವೆ. ಅವನಿಗೆ ಏನು ಮಾಡಬೇಕೆಂದು ತೋಚುವುದಿಲ್ಲ. ನಿಲ್ಲಬೇಕೇ ಅಥವಾ ನಡೆಯಬೇಕೇ ಎಂದು ನಿರ್ಧರಿಸಲು ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ. ಈ ಕತೆಯಲ್ಲಿ ಜುಂಗ್ ಭಾಷೆಯ ಎರಡು ಸಣ್ಣ ಪದಗಳ ಬಗ್ಗೆ ಓದಿ...","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722663/size7/88825327d54678c60f1e34fda78d6b5b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722663/size7/88825327d54678c60f1e34fda78d6b5b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-593066","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-593066","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":850,"opdsId":"urn:uuid:SW-138940","title":"ದೊಡ್ಡವನಾದ ಮೇಲೆ ಇರುವುದು ನನಗೊಂದು ಮನೆ","authors":["Kumar S"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂದು ಕಟ್ಟಡವನ್ನು ಸುಂದರವಾದ ಮನೆಯಾಗಿಸುವ ಎಲ್ಲ ಅದ್ಭುತ ಸಂಗತಿಗಳ ಕುರಿತ ಕಾವ್ಯ ಪುಸ್ತಕ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727186/size7/4ae70d26ced5fa58a2b4c132364c25c8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727186/size7/4ae70d26ced5fa58a2b4c132364c25c8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-138940","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-138940","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":851,"opdsId":"urn:uuid:SW-208688","title":"ಮಂಗನ ಢೋಲು","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂದು ಮರದ ರೆಂಬೆಯಲ್ಲಿ ಒಂದು ಢೋಲು ನೇತಾಡುತ್ತಿತ್ತು. ಒಂದು ಮಂಗ ಅದನ್ನು ನೋಡಿತು. ಮುಂದೇನಾಯಿತು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/282950/size7/fe30b5fb741efa74e751ae5291151c7a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/282950/size7/fe30b5fb741efa74e751ae5291151c7a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-208688","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-208688","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":852,"opdsId":"urn:uuid:SW-104695","title":"ಎಲ್ಲಾ ಮೂಗುಗಳ ಮೂಗು","authors":["SUJITH KAMATH"],"language":"","readingLevel":"","publisher":"","summary":"ಝಹ್ರಾಳ ದಾದಿಮಾ ಮೂಗು ತುಸು ಅಪರೂಪ ಎನ್ನುವ ಹಾಗಿತ್ತು. ಅದು ಎಂತಹ ಪರಿಮಳವನ್ನೂ, ಯಾರೂ ಊಹಿಸದಷ್ಟು ಕರಾರುವಕ್ಕಾಗಿ ಕಂಡು ಹಿಡಿಯುತ್ತಿತ್ತು. ಝಹ್ರಾಳಿಗೂ ತನ್ನ ಮೂಗನ್ನು ದಾದಿಮಾ ಮೂಗಿನ ಹಾಗೆ ಪಳಗಿಸುವ ಆಸೆ. ಝಹ್ರಾ ಮತ್ತು ದಾದಿಮಾ ಅತ್ತರಿನ ಗಾಢ ಪರಿಮಳವನ್ನು ನವಿರಾಗಿ ಹೀರುತ್ತಾ, ಕಳೆದ ದಿನಗಳನ್ನು ಮೆಲುಕು ಹಾಕಿದ್ದು ಹೇಗೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/179725/size7/15f364d92111de41f9eee020024db06a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/179725/size7/15f364d92111de41f9eee020024db06a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-104695","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-104695","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":853,"opdsId":"urn:uuid:SW-378210","title":"ನಾನು ಇಂದು ಯಾವ ಮನೆ ಕಟ್ಟಲಿ?","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಜೈಸಲ್ಮೇರಿನಲ್ಲಿ ಮರಳುಗಲ್ಲಿನ ಹವೇಲಿಗಳು, ನಾಗಾಲ್ಯಾಂಡಿನಲ್ಲಿ ಕಾಡುಹುಲ್ಲಿನ ಚಾವಣಿಯ ಮನೆಗಳಿರುವುದು ನಿಮಗೆ ಗೊತ್ತೇ? ನಗರಗಳಲ್ಲಿ ಗಗನಚುಂಬಿ ಕಟ್ಟಡಗಳಿದ್ದರೆ, ಕೆಲವೆಡೆ ಸೌರಶಕ್ತಿಯಿಂದ ನಡೆಯುವ ಮನೆಗಳೂ ಇರುತ್ತವೆ. ಬನ್ನಿ, ಸುಲು ಜೊತೆ ಸೇರಿ ನಿಮ್ಮಿಷ್ಟದ ಮನೆ ಕಟ್ಟುವಿರಂತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/456982/size7/be34ea2ad64a7cc49958ddc9dd109176.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/456982/size7/be34ea2ad64a7cc49958ddc9dd109176.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-378210","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-378210","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":854,"opdsId":"urn:uuid:SW-460712","title":"ಯಾಕೆ ಅಂತ ಗೊತ್ತಿಲ್ಲ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಬೆಳಗ್ಗೆ ಆಗುತ್ತಿದ್ದ ಹಾಗೆ ಅಪ್ಪುಗೆ ಚೆನ್ನಾಗಿ ಅನಿಸತ್ತೆ. ಎಲ್ಲ ತಾಜಾ. ಆಮೇಲೆ ಮಧ್ಯಾಹ್ನ ಆಗತ್ತೆ, ಸಂಜೆ ಆಗತ್ತೆ. ನೋಡ್ತಾ ನೋಡ್ತಾ ರಾತ್ರಿ ಕೂಡ ಆಗತ್ತೆ. ಆಗ ಅಪ್ಪುಗೆ ಏನೋ ಒಂಥರಾ ಅನಿಸತ್ತೆ. ಏನು ಅಂತ ಅಪ್ಪುಗೆ ಹೇಳಲು ಆಗಲ್ಲ. ಅದೇನು ಅಂತ ಕಂಡುಹಿಡಿಯಲು ನೀವು ಯಾರಾದರೂ ಸಹಾಯ ಮಾಡ್ತೀರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727485/size7/0d6c5fe635bc010c15e2c939365ddff2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727485/size7/0d6c5fe635bc010c15e2c939365ddff2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-460712","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-460712","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":855,"opdsId":"urn:uuid:SW-36649","title":"ದಿವ್ಯಾಳ ನಕಾಶೆಯಲ್ಲಿ ಯಾರೆಲ್ಲ ಇದ್ದಾರೆ ?","authors":["Sarita Sharan"],"language":"","readingLevel":"","publisher":"","summary":"ಗಜಾಪುರಕ್ಕೆ ಬರಲಿರುವ ತನ್ನ ಸೋದರ ಸಂಬಂಧಿ ರವಿಯ ಆಗಮನಕ್ಕಾಗಿ ದಿವ್ಯಾ ಕಾತುರಳಾಗಿದ್ದಾಳೆ. ಆದರೆ ಅವನು ಹೇಗೆ ಅಲ್ಲಿಗೆ ತಲುಪುತ್ತಾನೆ ಎಂಬ ಬಗ್ಗೆ ಅವಳಿಗೆ ಖಾತರಿಯಿಲ್ಲ. ಅವನಿಗೆ ನಕಾಶೆ ಸಹಾಯಕವಾಗಬಲ್ಲದೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717011/size7/6c1c36d92ace6c0269eb253f538a74bd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717011/size7/6c1c36d92ace6c0269eb253f538a74bd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-36649","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-36649","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":856,"opdsId":"urn:uuid:SW-573141","title":"ಓದುವ ಇರುವೆ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಪುಟಾಣಿ ಇರುವೆಯೊಂದು ತನ್ನ ಬಳಗಕ್ಕಾಗಿ ದೊಡ್ಡ ಉಪಾಯ ಮಾಡುತ್ತದೆ. ಪುಟಾಣಿ ಇರುವೆಯ ಓದುವ ಪ್ರೀತಿ ಅದರ ಪರಿವಾರಕ್ಕೆ ಚಳಿಗಾಲದಲ್ಲಿ ಎದುರಾದ ಆಹಾರದ ಸಮಸ್ಯೆಯನ್ನು ಹೇಗೆ ಬಗೆ ಹರಿಸಿತು ಎನ್ನುವುದೇ ಈ ಕತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/86165/size7/cdaec4ae12cc711034c3eefcfd214d40.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/86165/size7/cdaec4ae12cc711034c3eefcfd214d40.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-573141","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-573141","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":857,"opdsId":"urn:uuid:SW-96407","title":"ಮಜಾ ಗಣಿತ: ಅಳತೆಗಳು","authors":["K.P. Bhatt"],"language":"","readingLevel":"","publisher":"","summary":"ಇದೊಂದು ಹೊಸ ಬಗೆಯ ಗಣಿತ ಪುಸ್ತಕ ಇದರಲ್ಲಿ ಸಮಸ್ಯೆಗಳಿಗಿಂತ ಕಥೆಗಳೇ ಹೆಚ್ಚಾಗಿವೆ! ಕಥೆಗಳನ್ನು ಓದಿ, ಕಲ್ಪನೆ ಮತ್ತು ವಾಸ್ತಾಗಳ ಮಿಶ್ರಣವನ್ನು ಸ್ವೀಕರಿಸಿ ಜೊತೆಗೆ ನಿಮ್ಮ ಮೆದುಳಿಗೊಂದು ಸವಾಲು ಹಾಕಿ ಸಂತೋಷಪಡಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703452/size7/8de58a1eb0b60288d6248363ca261ede.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703452/size7/8de58a1eb0b60288d6248363ca261ede.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-96407","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-96407","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":858,"opdsId":"urn:uuid:SW-600009","title":"ಲೀಲಾ ಮತ್ತವಳ ಬೆಕ್ಕು","authors":["Rosy D’souza"],"language":"","readingLevel":"","publisher":"","summary":"ಲೀಲಾ ಮತ್ತವಳ ಬೆಕ್ಕಿನ ತುಂಟತನಕ್ಕೆ ಕೊನೆಯೇ ಇಲ್ಲ. ಅವರು ಜೋಡಿಯಾದರೆಂದರೆ, ಅವರನ್ನು ಹಿಡಿಯುವವರಿಲ್ಲ. ಇದು ಒಂದು ಹುಡುಗಿ ಮತ್ತು ಅವಳ ಬೆಕ್ಕಿನ ತುಂಟಾಟದ ಕತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727666/size7/5861ee59053f562cf306d8a3d01d18e6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727666/size7/5861ee59053f562cf306d8a3d01d18e6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-600009","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-600009","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":859,"opdsId":"urn:uuid:SW-146514","title":"ಕುರಿಗಾಹಿ ಮತ್ತು ಹುಲ್ಲುಗಾವಲು","authors":["Shashi Sampalli"],"language":"","readingLevel":"","publisher":"","summary":"ವಾತಾವರಣ ನಿಧಾನವಾಗಿ ಬಿಸಿಯಾಗುತ್ತಿದ್ದಂತೆ, ರೂಮ್ ಸಿಂಹ್ ತನ್ನ ಮೇಕೆ ಮತ್ತು ಕುರಿಗಳ ಮಂದೆ ಹೊಡೆದುಕೊಂಡು ತಾಜಾ ಹುಲ್ಲಿಗಾಗಿ ಹಿಮಾಲಯವನ್ನು ಶೋಧಿಸುತ್ತಾನೆ. ಜಾಗತಿಕ ತಾಪಮಾನ ಏರಿಕೆಯ ವಾಸ್ತವತೆ ಮತ್ತು ಗಡ್ಡಿ ಕುರಿಗಾಹಿಯ 40 ವರ್ಷದ ಪಯಣವನ್ನು ಈ ಚಿತ್ರಸಂಪುಟ ನಿಮಗಾಗಿ ಇಲ್ಲಿ ನೀಡಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/674076/size7/bd639ecc34bcfc59ac0f39900fe565bd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/674076/size7/bd639ecc34bcfc59ac0f39900fe565bd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-146514","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-146514","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":860,"opdsId":"urn:uuid:SW-125055","title":"ರಿಯಾ ನೋಡಿಕೊಳ್ಳುತ್ತೆ, ಬಿಡು!","authors":["Srinidhi  TG"],"language":"","readingLevel":"","publisher":"","summary":"ಏಬಲ್ ಈಗಷ್ಟೆ ಅಕ್ಷರಗಳನ್ನು ಬರೆಯಲು ಕಲಿತಿದ್ದಾನೆ. ಸೊಟ್ಟಪಟ್ಟ ಅಕ್ಷರಗಳಲ್ಲಿ ಅಮ್ಮಚ್ಚಿಗೆ ಒಂದು ಪತ್ರ ಕೂಡ ಬರೆದಿದ್ದಾನೆ. ತನ್ನ ಅಕ್ಷರಗಳಿಂದಾಗಿ ಅಮ್ಮಚ್ಚಿಗೆ ಪತ್ರ ತಲುಪದಿದ್ದರೆ? ಎನ್ನುವ ಯೋಚನೆ ಶುರುವಾಗಿದೆ. ಈ ಸಮಸ್ಯೆಗೆ ಯಾರಾದರು ಸಹಾಯ ಮಾಡಬಹುದೆ ಎಂದು ಅವನು ಅಂಚೆ ಕಚೇರಿಗೆ ಹೋಗಿದ್ದಾನೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/182193/size7/2fdb775754be5320d27034e2f12c06cf.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/182193/size7/2fdb775754be5320d27034e2f12c06cf.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-125055","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-125055","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":861,"opdsId":"urn:uuid:SW-608394","title":"ಶುಭ ರಾತ್ರಿ, ಮೋನು","authors":["Pallavi Rao"],"language":"","readingLevel":"","publisher":"","summary":"ಮೋನು ಏನಿದ್ದರೂ ಲೋಕಕ್ಕೆಲ್ಲಾ “ಶುಭ ರಾತ್ರಿ” ಕೋರಿಯೇ ನಿದ್ದೆ ಹೋಗುವನು. ಆದರೆ, ಅದೇನು ಕತ್ತಲಲ್ಲಿ ಹೊಂಚು ಹಾಕುತ್ತಿರುವುದು? ಅದೇನಾದರೂ ಒಂದು ಪೆಡಂಭೂತವೋ ಅಥವಾ ಮೂರೋ? ಈ ಪುಸ್ತಕವನ್ನು ಎಚ್ಚರಿಕೆಯಿಂದ ತೆರೆಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723582/size7/bb825e385d699c93a216c599a745b078.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723582/size7/bb825e385d699c93a216c599a745b078.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-608394","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-608394","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":862,"opdsId":"urn:uuid:SW-595975","title":"ಇಡ್ಲಿ ಇತ್ತು ಭಾರಿ","authors":["Jayant Kaikini"],"language":"","readingLevel":"","publisher":"","summary":"ಕೋಪಗೊಂಡ ಇಡ್ಲಿಯೊಂದು ಹೋಗಿ ಸಾಂಬಾರಿನಲ್ಲಿ ಕೂತುಕೊಂಡಿತು. \nಆಗ ಒಂದು ಚಮಚೆಯೂ ಅಲ್ಲಿಗೆ ಬಂತು. ಈಗ ಇಡ್ಲಿಯ ಕತೆಯೇನು? \nಈ ಕವಿತೆಯಲ್ಲಿ ಓದೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/656025/size7/ad1220495273ace5c9bd53a4997afaeb.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/656025/size7/ad1220495273ace5c9bd53a4997afaeb.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-595975","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-595975","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":863,"opdsId":"urn:uuid:SW-151294","title":"ಫ್ಲಶ್ ಮಾಡಿದಾಗ ಏನೇನಾಗುತ್ತದೆ?","authors":["Nagesh  Hegde"],"language":"","readingLevel":"","publisher":"","summary":"ಕಮೋಡಿನಲ್ಲಿ ಬಿದ್ದ ಮೂಗಿಲಿ ಅಲ್ಲಿಂದ ಪೈಪ್ ಮೂಲಕ ಒಳಚರಂಡಿಗೆ ಪಾಲಾಗುತ್ತದೆ. ಅಲ್ಲಿ ಅದಕ್ಕೊಂದು ಸುಂಡಿಲಿ ಸಿಗುತ್ತದೆ. ಫ್ಲಶ್ ಮಾಡಿದಾಗ ಏನೇನಾಗತ್ತೆ ಅಂತ ಹೇಳುವಾಗ ಇಲಿಗಳು ಯಾಕೆ ಬಂದವು ಅಂತೀರ.. ಕತೆ ಓದಿ ಎಲ್ಲ ಗೊತ್ತಾಗತ್ತೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/203168/size7/3d957f5d94c59837655fef02fa903ba4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/203168/size7/3d957f5d94c59837655fef02fa903ba4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-151294","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-151294","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":864,"opdsId":"urn:uuid:SW-148747","title":"ನನ್ನ ಕರೆ ಎಲ್ಲಿ ಹೋಯಿತು?","authors":["Madhusudana YN"],"language":"","readingLevel":"","publisher":"","summary":"ನಾವು ದೂರವಾಣಿ ಕರೆಗಳನ್ನು ಮಾಡಿದಾಗ, ನಮ್ಮ ಧ್ವನಿ ದೂರದೂರದ ಊರುಗಳನ್ನು ತಲುಪುತ್ತದೆ. ನಮ್ಮ ಧ್ವನಿ ಇಷ್ಟೆಲ್ಲ ದೂರ ಸಾಗುವುದು ಹೇಗೆ ಸಾಧ್ಯವಾಗುತ್ತದೆ ಎಂದು ಯೋಚಿಸಿದ್ದೀರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/216365/size7/d4a5d158d2688512fdccc901a63c125c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/216365/size7/d4a5d158d2688512fdccc901a63c125c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-148747","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-148747","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":865,"opdsId":"urn:uuid:SW-138966","title":"ಅದೇನದು?","authors":["M R GANESHA KUMAR"],"language":"","readingLevel":"","publisher":"","summary":"ಕಾಡಿನಲ್ಲಿ ಎಲ್ಲೆಲ್ಲಿಯೂ ಅಲ್ಲಾಡುವ ಮರದ, ಹಾರಿವ ಹಕ್ಕಿಗಳ, ಓಡಾಡುವ ಪ್ರಾಣಿಗಳ ಹಾಗೂ ಹಾರುವ ಕೀಟಗಳ ಶಬ್ದಗಳು ಕೇಳುತ್ತಲೇ  ಇರುತ್ತವೆ. ಆದರೆ ಕಾಡಿನ ನೀರವ ಕತ್ತಲಿನಲ್ಲಿ ಈ ಸದ್ದುಗಳು ಹೆಚ್ಚು ಜೋರಾಗಿ ಕೇಳಿಸುತ್ತವೆ. ಶಿಬಿರಕ್ಕೆ ಹಿಂದಿರುಗುವಾಗ ಹಿರೆನ್‌ ಹೆದರಿದ್ದು ಕೂಡ ಅಚ್ಚರಿಯೇನಲ್ಲ. ಅವನು ಕೇಳಿದ ಸದ್ದು ಯಾವುದು? ಗಮನವಿಟ್ಟು ಕೇಳಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727188/size7/82b021d2a9def2a929d383e474c5cc5f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727188/size7/82b021d2a9def2a929d383e474c5cc5f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-138966","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-138966","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":866,"opdsId":"urn:uuid:SW-117783","title":"ಆನೆಯ ನಷ್ಟ ಊಸರವಳ್ಳಿಗೆ ಲಾಭ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ನೆಲವ ಗುದ್ದಿ ನೀರು ಬರಿಸುವಂತೆ ರಾಜ ಒಡ್ಡಿದ ಸವಾಲಿನಲ್ಲಿ ಗೆದ್ದವರಾರು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/138793/size7/bc5aa53eae24ca770caa6c6dc42d7829.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/138793/size7/bc5aa53eae24ca770caa6c6dc42d7829.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-117783","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-117783","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":867,"opdsId":"urn:uuid:SW-105360","title":"ಪಕ್ಷಿರಾಜ ಯಾರು?","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಪಕ್ಷಿಗಳಿಗೆ ತಮಗೊಬ್ಬ ರಾಜ ಬೇಕೆನ್ನಿಸಿತು. ಆದರೆ ರಾಜನ ಆಯ್ಕೆ ಕಷ್ಟವಾಯಿತು. ಅತಿ ಎತ್ತರಕ್ಕೆ ಹಾರಬಲ್ಲ ಪಕ್ಷಿ ರಾಜನಾಗಲಿ ಎಂದು ಅವು ತೀರ್ಮಾನಿಸಿದವು. ಆಫ್ರಿಕಾದ ರಣಹದ್ದು ಸ್ಪರ್ಧೆಯಲ್ಲಿ ಗೆದ್ದವನು ನಾನೇ ಎಂದುಕೊಂಡಿತು. ಆದರೆ ಪುಟಾಣಿ ಹಕ್ಕಿಯೊಂದರ ಉಪಾಯ ಅದಕ್ಕೆ ಅಡ್ಡಿಯಾಯಿತು.  ಪಕ್ಷಿರಾಜನ ಆಯ್ಕೆಯ ಕತೆಯೇನಾಯಿತೊ ತಿಳಿಯೋಣ ಬನ್ನಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/87349/size7/7ee8947a117ae52cdc670a64310dac46.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/87349/size7/7ee8947a117ae52cdc670a64310dac46.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-105360","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-105360","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":868,"opdsId":"urn:uuid:SW-461215","title":"ಶಾನುಗೆ ಯಾವ ಊಟ ಇಷ್ಟ?","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಪುಟ್ಟ ಶಾನುಗೆ ತನ್ನ ಊಟ ಮಾಡಲು ಇಷ್ಟವಿಲ್ಲ. ಅವನು ಗುಬ್ಬಿ ಮತ್ತು ಬೆಕ್ಕು ಏನು ತಿನ್ನುತ್ತವೆ ಎಂಬುದನ್ನು ನೋಡಲು ಬಯಸುತ್ತಾನೆ. ಹಾಗಾದರೆ ಅವನು ಕೊನೆಯಲ್ಲಿ ಏನು ತಿನ್ನುತ್ತಾನೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727496/size7/bc306c8bdbafd0917bf778e8d96adfaf.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727496/size7/bc306c8bdbafd0917bf778e8d96adfaf.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-461215","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-461215","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":869,"opdsId":"urn:uuid:SW-136435","title":"ಮೆಟ್ರೋ ಸವಾರಿ","authors":["Rosy D’souza"],"language":"","readingLevel":"","publisher":"","summary":"ಜೇಬಾ ಮತ್ತು ಅವಳ ಅಪ್ಪ ಕುತುಬ್ ಮೀನಾರ್ ನೋಡಲು ಹೋಗುತ್ತಿದ್ದಾರೆ. ಮೆಟ್ರೋದಲ್ಲಿ ಪ್ರಯಾಣಿಸುತ್ತಿದ್ದಾರೆ. ಬನ್ನಿ ಬನ್ನಿ ಅವರ ಜೊತೆ ಒಂದು ಸುತ್ತು ಹೋಗಿ ಬರೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/710482/size7/4e10fc23077d8d5cf155445b7b23d1e7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/710482/size7/4e10fc23077d8d5cf155445b7b23d1e7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-136435","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-136435","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":870,"opdsId":"urn:uuid:SW-110090","title":"ಮೇಗನ್ ಮತ್ತು ಮೃತ್ಯುವಿನ ರಾಜಕುಮಾರಿ","authors":["Srinidhi  TG"],"language":"","readingLevel":"","publisher":"","summary":"ಕೇಬಲ್ ಕಾರ್ ಹಾದಿಯಲ್ಲಿ ಫ್ರಿಟ್ಸ್ ನನ್ನು ಹಿಂಬಾಲಿಸಿ ಹೊರಟ ಮೇಗನ್, ಕಿರಿಕಿರಿಯ ರಾಜಕುಮಾರಿಯಿದ್ದ ಹೋಪಾ ಸ್ಥಾನವೆಂಬ ವಿಚಿತ್ರ ಜಗತ್ತಿನಲ್ಲಿ ಸಿಲುಕಿದಳು. ದಿಗಿಲು ಹುಟ್ಟಿಸುವ ಭಯಾನಕ ಗುಹೆಗಳ ಸರಣಿಯೊಂದನ್ನು ದಾಟಿದರೆ ಮಾತ್ರ ಅವಳು ಫ್ರಿಟ್ಸ್ ಜೊತೆ ಮನೆಗೆ ಮರಳುವುದು ಸಾಧ್ಯ. ಅಷ್ಟೇ ಅಲ್ಲ, ಅದಕ್ಕೂ ಮುನ್ನ ಅವಳು ಮೂರು ಒಗಟುಗಳನ್ನೂ ಬಿಡಿಸಬೇಕು!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727154/size7/b53ed09e0cc6e49999ce7b28ca94c2bb.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727154/size7/b53ed09e0cc6e49999ce7b28ca94c2bb.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-110090","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-110090","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":871,"opdsId":"urn:uuid:SW-49017","title":"ಗುಮ್ಮಣ್ಣ, ಗುಮ್ಮಣ್ಣ!","authors":["Kollegala Sharma"],"language":"","readingLevel":"","publisher":"","summary":"ಎಚ್ಚರ! ಎಲ್ಲೆಲ್ಲೂ ಗುಮ್ಮಣ್ಣ ಇದ್ದಾನೆ. ಮಕ್ಕಳು ಹೇಳಿದ ಮಾತು ಕೇಳದಿದ್ದಾಗ ಅಮ್ಮಂದಿರಿಗೆ ಗುಮ್ಮಣ್ಣ ಬೇಕೇ ಬೇಕು. ಇಲ್ಲಿ ನೀವು ಬೇರೆ, ಬೇರೆ ಆಕಾರ, ಗಾತ್ರದ ಗುಮ್ಮಣ್ಣರನ್ನು ಕಾಣುವಿರಿ. ಅವರು ಇಲ್ಲೂ, ಅಲ್ಲೂ ಸುತ್ತಾಡುತ್ತಿರಬಹುದು. ಎಚ್ಚರ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/86793/size7/97192f7272c8bde980243368b393cab8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/86793/size7/97192f7272c8bde980243368b393cab8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-49017","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-49017","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":872,"opdsId":"urn:uuid:SW-441227","title":"ದಾದಿ, ದಾದಿ ಇದು ಯಾವ ಬಣ್ಣ?","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ದಾದಿ, ಗುಡ್ಡು ಮತ್ತು ಗೋಲು ಜಾತ್ರೆಗೆ ಹೋದಾಗ ಒಂದು ಮಾಯಾ ಕನ್ನಡಕ ಹಾಕಿಕೊಂಡು ನೋಡಿದರು. ಅದರ \nಮೂಲಕ ಅವರಿಗೆ ಬಣ್ಣಗಳ ಹೊಸ ಪ್ರಪಂಚವೇ ಕಂಡಿತು. \nಎರಡು ಪ್ರಾಥಮಿಕ ಬಣ್ಣಗಳು ಸೇರಿದರೆ ಮತ್ತೊಂದು ಬಣ್ಣವಾಗುತ್ತದೆ ಎನ್ನುವುದನ್ನು ಹೇಳುವ ಸರಳ ಕತೆ ಇದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725228/size7/7e1e5be439c3e2e042742fa345880f1a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725228/size7/7e1e5be439c3e2e042742fa345880f1a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-441227","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-441227","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":873,"opdsId":"urn:uuid:SW-63324","title":"ಮುಚ್‌ಕುಂದ್ ಮತ್ತು ಸಿಹಿ ಜೇನು","authors":["Shaila Manipal"],"language":"","readingLevel":"","publisher":"","summary":"ಕರಡಿಗಳು, ಜೇನುಗಳು ಮತ್ತು ಪುಷ್ಪಗಳು ನಮ್ಮ ನೈಸರ್ಗಿಕ ಜಗತ್ತೆಂಬ ಸೌಧದ ಆಕರ್ಷಕ ಸ್ತರಗಳು. ಭಾರತದ ಹೆಜ್ಜೇನುಗಳು ವಿಶ್ವದ ಜೇನುನೊಣಗಳಲ್ಲೇ ಅತ್ಯಂತ ದೊಡ್ಡವು. ಈ ಅಮೂಲ್ಯ ನೈಸರ್ಗಿಕ ಆಸ್ತಿಯನ್ನು ರಕ್ಷಿಸಲು, ವಿಜ್ಞಾನಿಗಳು ವನವಾಸಿಗಳ ಸಹಯೋಗದಲ್ಲಿ ಕಾರ್ಯನಿರತರಾಗಿದ್ದಾರೆ. ಆದರೆ, ಮುಚ್‌ಕುಂದ್ ಮತ್ತು ಅದರ ಜಾಣ ಗುಂಪು, ಜೇನುಗಳ ಸರ್ವನಾಶವನ್ನು ತಪ್ಪಿಸಲು ತಮ್ಮದೇ ಆದ ದಾರಿಯನ್ನು ಹುಡುಕಿಕೊಂಡಿವೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/705854/size7/41c8a2f300eecde7216d6685ef85495f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/705854/size7/41c8a2f300eecde7216d6685ef85495f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-63324","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-63324","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":874,"opdsId":"urn:uuid:SW-644367","title":"ಚಿಪ್ಪುಹಂದಿ ರಕ್ಷಕರು","authors":["Krupakar Senani"],"language":"","readingLevel":"","publisher":"","summary":"ಮಧ್ಯಭಾರತದ ಒಂದು ಕಾಡು. ಕಳ್ಳಬೇಟೆಗಾರರು ಸೆರೆಸಿಕ್ಕಿದ್ದಾರೆ. ಅರಣ್ಯಾಧಿಕಾರಿಗಳು ಮತ್ತು ವನ್ಯಜೀವಿ ಸಂರಕ್ಷಣಾ ಟ್ರಸ್ಟ್‌ನ ತಂಡ (ಸಂರಕ್ಷಣಾ ಕಾವಲು ಪಡೆಯ ನಾಯಿಗಳು ಸೇರಿದಂತೆ) ಚಿಪ್ಪುಹಂದಿಯನ್ನು ಸೂಕ್ತನೆಲೆಯೊಂದಕ್ಕೆ ಸೇರಿಸುವ ಕಾರ್ಯದಲ್ಲಿ ಜೊತೆಗೂಡಿದ್ದಾರೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727677/size7/156f83d086b29a81c2f82d1380eb19f4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727677/size7/156f83d086b29a81c2f82d1380eb19f4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-644367","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-644367","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":875,"opdsId":"urn:uuid:SW-582044","title":"ಬಿಳಿ ಪಾತರಗಿತ್ತಿ","authors":["Anasuya Patil"],"language":"","readingLevel":"","publisher":"","summary":"ಬಿಳಿ ಪಾತರಗಿತ್ತಿಗೆ ಬೇರೆ ಚಿಟ್ಟೆಗಳಂತೆ ಶಾಲೆಗೆ ಹೋಗಲು ಇಷ್ಟ. ಆದರೆ, ಅದರ ಬಳಿ ಶಾಲೆಗೆ ಹೋಗಲು ಬೇಕಾದ ಪಾಟಿಚೀಲ, ಶರ್ಟು, ಟೋಪಿ, ಪೆನ್ನು ಇಲ್ಲ. ಅದಕ್ಕೆ ಶಾಲೆಗೆ ಹೋಗಲು ಬೇಕಾದ ಸಾಮಾನುಗಳನ್ನು ಕೊಡಿಸಲು ನೀವು ಸಹಾಯ ಮಾಡುತ್ತೀರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/99488/size7/879048deb2e1068ba1db73dc74ef22c6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/99488/size7/879048deb2e1068ba1db73dc74ef22c6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-582044","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-582044","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":876,"opdsId":"urn:uuid:SW-513309","title":"ಏನದು ಸದ್ದು?","authors":["Pallavi Rao"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂದು ನಿದ್ದೆಮಂಪರಿನ ಭಾನುವಾರ ಮಧ್ಯಾಹ್ನ, ಬ್ಯಾಂಡ್ ಬಾಜಾ ಕಾಲೊನಿಯ ನಿವಾಸಿಗಳಿಗೆ ಹೊರಗಡೆಯಿಂದ ವಿಚಿತ್ರ ಸದ್ದುಗಳು ಕೇಳಿಸುತ್ತವೆ. ಅದೊಂದು ಬೆಕ್ಕೇ ಅಥವಾ ಹಕ್ಕಿಯೇ? ಕೆಟಲ್ ಅಥವಾ ಶಿಳ್ಳೆಯೇ? ಏನದು ಎಂದು ಓದಿ ಪತ್ತೆ ಮಾಡಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/708297/size7/b9fb778332a6c24d73c75f5e1cbbf5da.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/708297/size7/b9fb778332a6c24d73c75f5e1cbbf5da.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-513309","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-513309","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":877,"opdsId":"urn:uuid:SW-586607","title":"ಸೋಮವಾರ ಬರದಿರಲಿ!","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ವಾರದ ದಿನಗಳು ನಿಮಗೆ ತಿಳಿದಿರುವ ವ್ಯಕ್ತಿಗಳಾಗಿದ್ದರೆ, \nಅವರು ಹೇಗಿರಬಹುದು? ಶಾಲೆಯ ಪ್ರಿನ್ಸಿಪಾಲ್, \nಒಳ್ಳೆಯ ಫ್ರೆಂಡ್ ಅಥವಾ ಅಕ್ಕನಂತೆ? ಕಟ್ಟುನಿಟ್ಟಾದ, \nಪ್ರೀತಿಯ ಅಥವಾ ಸದಾ ಕೆಲಸದಲ್ಲಿ ಇರುವವರಂತೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716358/size7/d3b3324d37e516f6e0e1132c9cbbd6f3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716358/size7/d3b3324d37e516f6e0e1132c9cbbd6f3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-586607","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-586607","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":878,"opdsId":"urn:uuid:SW-138891","title":"ಕಪ್ಪು ಟೋಪಿ, ಬಿಳಿ ಟೋಪಿ","authors":["SUJITH KAMATH"],"language":"","readingLevel":"","publisher":"","summary":"ಹ್ಯಾಕರ್‌ ಗಳೆಂದರೆ ಯಾರು? ಡೇಟಾ ಎಂದರೆ ಏನು ಮತ್ತು ಅದನ್ನು ಕದಿಯಲು ಕೆಲವರಿಗೇಕೆ ಆಸಕ್ತಿ? ಅವರಿಗೆ ಸಂಬಂಧಿಸಿಲ್ಲದ ಡೇಟಾವನ್ನು ಕದಿಯುವ ಕಳ್ಳರನ್ನು ತಡೆಯಲು ಸಾಧ್ಯವೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/186756/size7/a8263df4a78bc463b8fd0330ce595746.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/186756/size7/a8263df4a78bc463b8fd0330ce595746.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-138891","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-138891","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":879,"opdsId":"urn:uuid:SW-449885","title":"ಸುಶೀಲಾಳ ಕೋಲಮ್‌ಗಳು","authors":["Bhavya"],"language":"","readingLevel":"","publisher":"","summary":"ನೀವು ಕೋಲಮ್ ಅಂದರೆ ರಂಗೋಲಿಗಳನ್ನು ಮನೆ, ಶಾಲೆಯ ಅಂಗಳಗಳಲ್ಲಿ ನೋಡಿರಬಹುದು. ಆದರೆ ಎಂದಾದರೂ ಆಕಾಶದಲಿ ಕೋಲಮ್ ನೋಡಿದ್ದೀರಾ? ಪುಟ್ಟ ಸುಶೀಲಾಳ ಕೋಲಮ್ ಅಲ್ಲಿ ಅರಳಿದ್ದು ಹೇಗೆ ಎಂದು ತಿಳಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721007/size7/d555da2445138f0ad43899fed6f643b9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721007/size7/d555da2445138f0ad43899fed6f643b9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-449885","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-449885","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":880,"opdsId":"urn:uuid:SW-457836","title":"ಬೆಕ್ಕುಗಳ ಹಬ್ಬ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಒಮ್ಮೆ ಬೆಕ್ಕುಗಳು, ಇಲಿಗಳನ್ನು ಹಬ್ಬಕ್ಕೆ ಆಹ್ವಾನಿಸಿದವು. ನಿಜವಾಗಲೂ ಹಬ್ಬ ನಡೆಯುತ್ತದೆಯೇ ಅಲ್ಲಿ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703963/size7/29f8d3c343eaee9acf42b4513e7f0af0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703963/size7/29f8d3c343eaee9acf42b4513e7f0af0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-457836","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-457836","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":881,"opdsId":"urn:uuid:SW-63816","title":"ನೀವೂ ಬಲ್ಲಿರಾ ಡ್ರೋಣು?","authors":["Kollegala Sharma"],"language":"Do","readingLevel":"","publisher":"","summary":"ಡ್ರೋಣು ಹಾರುತ್ತದೆ. ಫೋಟೋ ತೆಗೆಯುತ್ತದೆ, ಕಾಡು ಪ್ರಾಣಿಗಳನ್ನು ಕಾಪಾಡುತ್ತದೆ. ಹಾಂ... ಭೂಕಂಪವಾದಾಗ ಜನರನ್ನೂ ಕಾಪಾಡುತ್ತದೆ. ಇಗೋ ಡ್ರೋಣ್ ಭೇಟಿ ಮಾಡೋಣವಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725493/size7/0e9a6cbab7714e56890ee411a0bf0a9c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725493/size7/0e9a6cbab7714e56890ee411a0bf0a9c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-63816","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-63816","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":882,"opdsId":"urn:uuid:SW-466127","title":"ಕಾರಂಜಿ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ರಮೇಶ್‌ನ ಮನೆಯ ಮುಂಭಾಗದ ರಸ್ತೆಯನ್ನು ಅಗೆದಿದ್ದಾರೆ. ಅದರೊಳಗೊಂದು ನೀರಿನ ಪೈಪ್ ಇತ್ತು. ಅದರಿಂದ ಕಾರಂಜಿಯೂ ಚಿಮ್ಮಿತು!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727553/size7/413ee10fa686e79078312b78f5c0dca2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727553/size7/413ee10fa686e79078312b78f5c0dca2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-466127","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-466127","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":883,"opdsId":"urn:uuid:SW-481241","title":"ನಮ್ಮೆಲ್ಲರ ಮನೆ","authors":["Deepti B"],"language":"","readingLevel":"","publisher":"","summary":"ಮನೆ ಎಂದರೆ ಯಾವೆಲ್ಲ ಅಂಶ ಅದರಲ್ಲಿ ಸೇರಿರುತ್ತದೆ? ಸದ್ದು, ಗದ್ದಲ, ರಾಶಿ ನೆನಪುಗಳು, ಸ್ನೇಹಿತರು, ಸಾಕುಪ್ರಾಣಿಗಳು ಮತ್ತೆ ಮನೆಯಲೆಲ್ಲಾ ಹರಡಿರುವ ಹೇಳಲಾಗದ ಸುವಾಸನೆ ಮತ್ತು ಬಣ್ಣಗಳು. ಕೇವಲ ಮನೆ ಎನ್ನಲಾಗದೆ ಅದಕ್ಕಿಂತಲೂ ಹೆಚ್ಚಿನ ಭಾವನೆ ರೂಪಿಸುವ ತನ್ನ ಮನೆಗೆ ಬೆಲಾ ನಮ್ಮನ್ನು ಸ್ವಾಗತಿಸುತ್ತಿದ್ದಾಳೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/636954/size7/6a7950e041fc4a444ac4b3a10072e6b8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/636954/size7/6a7950e041fc4a444ac4b3a10072e6b8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-481241","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-481241","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":884,"opdsId":"urn:uuid:SW-225864","title":"ಮೂವರು ಗೆಳೆಯರು","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಮೂವರು ಗೆಳೆಯರು ಸೇರಿ ದೋಸೆಯನ್ನು ಮಾಡುತ್ತಿದ್ದರು. ಆದರೆ ಅವರ ದೋಸೆ ಸೀದು ಕರಕಲಾಗಿ ಹೋಯಿತು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283716/size7/6ff27cb8d15f41789af67043ab1b9eaf.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283716/size7/6ff27cb8d15f41789af67043ab1b9eaf.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-225864","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-225864","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":885,"opdsId":"urn:uuid:SW-313865","title":"ನನಗೇನು ಭಯ","authors":["Pushpak M"],"language":"","readingLevel":"","publisher":"","summary":"ಅರ್ಚನಾಗೆ ಸುರಂಗಮಾರ್ಗವನ್ನು ದಾಟಿ ಹೋಗುವುದು ಎಂದರೆ ಭಯ. ಆದರೆ ತಾತ ಅವಳನ್ನು ಕಲ್ಪನಾ ಲೋಕಕ್ಕೆ ಕರೆದೊಯ್ಯುವ ಮೂಲಕ ಈ ಭಯವನ್ನು ಹೋಗಲಾಡಿಸುವ ಉಪಾಯ ಮಾಡುತ್ತಾರೆ. ತಾತ, ಮೊಮ್ಮಗಳ ನಡುವಿನ ಬಾಂಧವ್ಯ ಮತ್ತು ಕಲ್ಪನಾಲೋಕದ ಮಾಂತ್ರಿಕ ಶಕ್ತಿಯ ಕುರಿತ ನಾಟಕ ಇದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/395325/size7/fa29f3eb0bcf30049547a2650fed725f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/395325/size7/fa29f3eb0bcf30049547a2650fed725f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-313865","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-313865","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":886,"opdsId":"urn:uuid:SW-221818","title":"ನಾನು ಯಾರು?","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಹೊಟ್ಟೆಯ ಕೆಳಗೆ ಚೀಲವಿರುವ ಈ ಪ್ರಾಣಿಯು ಯಾವುದೆಂದು ನಿನಗೆ ಗೊತ್ತೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283184/size7/c8dc580322ba6c1d13d94c78f05f8b06.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283184/size7/c8dc580322ba6c1d13d94c78f05f8b06.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-221818","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-221818","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":887,"opdsId":"urn:uuid:SW-373358","title":"ನಮ್ಮ ಮನೆ ಎಂದರೆ","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಮನೆ ಎಂದರೆ ಏನೇನೆಲ್ಲಾ ಕಾಣುವುದು, ಕೇಳುವುದು, ಘಮ ಘಮಿಸುವುದು ಮತ್ತು ಮನೆ ಎಂದರೆ ಅದೊಂದು ಪ್ರತಿ ಭಾಗದೊಂದಿಗಿನ ಬಾಂಧವ್ಯ. ಈ ಪುಸ್ತಕದಲ್ಲಿ ನೆರೆಯಿಂದ ನೀರು ಪಾಲಾದ ತನ್ನ ಮನೆಯನ್ನು ನೆನಪಿಸಿಕೊಳ್ಳುತ್ತಿದ್ದಾಳೆ ಅನು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/426897/size7/727db468b86fe56b22b791ebcecc0a19.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/426897/size7/727db468b86fe56b22b791ebcecc0a19.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-373358","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-373358","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":888,"opdsId":"urn:uuid:SW-596891","title":"ಸೋಮವಾರನಾ?","authors":["Hoor Banu"],"language":"","readingLevel":"","publisher":"","summary":"ವಾರದ ದಿನಗಳನ್ನು ನಿನಗೆ ಗೊತ್ತಿರುವವರ ಜೊತೆ ಹೋಲಿಸಿದರೆ ಹೇಗಿರುತ್ತೆ? ಅದು ಯಾರಿರಬಹುದು? ನಿನ್ನ ಪ್ರಿನ್ಸಿಪಾಲ್‌ ಅಥವಾ ಅಕ್ಕ-ತಂಗಿ ಅಥವಾ ಬೆಸ್ಟ್‌ ಫ್ರೆಂಡ್ ಆಗಿರಬಹುದಾ? ನಿನಗೆ ಆ ದಿನ ಮಜವಾಗಿರುತ್ತಾ, ಬೇಜಾರು ಮಾಡಿಸುತ್ತಾ ಅಥವಾ ಬಿಡುವಿಲ್ಲದ ಹಾಗೆ ಕೆಲಸ ಕೊಡುತ್ತಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716358/size7/d3b3324d37e516f6e0e1132c9cbbd6f3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716358/size7/d3b3324d37e516f6e0e1132c9cbbd6f3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-596891","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-596891","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":889,"opdsId":"urn:uuid:SW-458018","title":"ನೀವು ಎಂದಾದರೂ ಮರ ಹತ್ತಿದ್ದೀರಾ?","authors":["Saraswathi S"],"language":"","readingLevel":"","publisher":"","summary":"ನೀವು ಎಂದಾದರೂ ಮರ ಹತ್ತಿದ್ದೀರಾ? ರಿನಿಕಿಗೆ ಮರಗಳನ್ನು ಹತ್ತುವುದೆಂದರೆ ತುಂಬಾ ಇಷ್ಟ. ಪ್ರಪಂಚದ ಎಲ್ಲ ಬಗೆಯ ಮರಗಳನ್ನು ಹತ್ತಬೇಕೆಂಬುದು ಅವಳ ಕನಸು. ತೆವಳುತ್ತ, ಕುಪ್ಪಳಿಸುತ್ತ; ಹಲಸು, ಚಿನಾರ್, ಬನ್ನಿ- ಸೇರಿದಂತೆ ಬೇರೆ ಬೇರೆ ಮರಗಳನ್ನು ಹತ್ತಲು ಹರಸಾಹಸ ಪಡುತ್ತಿರುವ ಅವಳೊಂದಿಗೆ ನೀವೂ ಸೇರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495551/size7/2d67536698e82439794800d91ba40bef.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495551/size7/2d67536698e82439794800d91ba40bef.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-458018","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-458018","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":890,"opdsId":"urn:uuid:SW-457769","title":"ಅಂಗಡಿಗೆ ಹೋದ ಸಮೀರಾ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ನೀವೂ ಸಮೀರಾ ಮತ್ತು ಮೌಚಕ್ ಜೊತೆ ಅಂಗಡಿಯವರೆಗೆ ಹೋಗಿ ಬನ್ನಿ. ಆದರೆ, ಅಮ್ಮ ಹೇಳಿದ ಸಾಮಾನು ತರಲು ಮರೆಯಬೇಡಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/705280/size7/4b968198dc09db6e476f02d1ba505cba.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/705280/size7/4b968198dc09db6e476f02d1ba505cba.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-457769","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-457769","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":891,"opdsId":"urn:uuid:SW-460236","title":"ಮನೆಗೆ ಬಂದ ಕ್ರೌಂಚ ಪಕ್ಷಿ","authors":["Jyoti S N"],"language":"","readingLevel":"","publisher":"","summary":"ಪ್ರತಿ ವರ್ಷ ವಲಸೆ ಬರುವ ಕ್ರೌಂಚ ಪಕ್ಷಿಗಳು ಖೀಚನ್‌ ಪ್ರದೇಶದಲ್ಲಿ ಐದು ತಿಂಗಳ ಕಾಲ ಬೀಡು ಬಿಟ್ಟಿರುತ್ತವೆ. ಈ ಸಮಯದಲ್ಲಿ ಹಳ್ಳಿಗರೇ ಹಕ್ಕಿಗಳ ಲಾಲನೆ, ಪಾಲನೆ ಮಾಡುತ್ತಾರೆ. ಕ್ರೌಂಚ ಪಕ್ಷಿಗಳಿಗಾಗಿ ಕಾಯುವ ರಾಜುವಿನ ಜೊತೆ; ನೀವೂ ದಿನ, ವಾರ ಮತ್ತು ತಿಂಗಳುಗಳ ಎಣಿಕೆಯನ್ನು ಕಲಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/444497/size7/90a1755cef6cf2ed9821d3200b83ae1c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/444497/size7/90a1755cef6cf2ed9821d3200b83ae1c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-460236","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-460236","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":892,"opdsId":"urn:uuid:SW-669978","title":"ಇನ್ನೇನು ಮಳೆ ಬರುತ್ತೆ!","authors":["Ananya"],"language":"","readingLevel":"","publisher":"","summary":"3, 2, 1... ಇನ್ನೇನು ಮಳೆ ಬರುತ್ತೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/754691/size7/015ea5b0621388a34e24f8634b42c045.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/754691/size7/015ea5b0621388a34e24f8634b42c045.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-669978","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-669978","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":893,"opdsId":"urn:uuid:SW-95729","title":"ಅಂತರಿಕ್ಷಕ್ಕೆ ರಾಕೆಟ್ ತೆರಳಿದ ದಿನ","authors":["Roopa"],"language":"","readingLevel":"","publisher":"","summary":"ಲಾಂಚ್ ಪ್ಯಾಡ್ ಮಿಹಿರ್ ಗೆ ರಾಕೆಟ್ ಲೀಲಾ ಅಂತರಿಕ್ಷಕ್ಕೆ ಹೋಗುವುದು ಬೇಕಿರಲಿಲ್ಲ. ಲೀಲಾಳನ್ನು ಆಕಾಶ ಅಥವಾ ಸಮುದ್ರ ನುಂಗಿಹಾಕಿದರೆ ಎಂಬ ಭಯ. ಆದರೆ ಲೀಲಾಳಲ್ಲಿ ಕೆಲವು ಅದ್ಭುತವಾದ ಆಲೋಚನೆಗಳಿದ್ದವು! ಆದರೆ ಲೀಲಾಗೆ ಅಂಥ ಯಾವ ಆತಂಕವೂ ಇರಲಿಲ್ಲ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/696672/size7/cc16221ddd26b31a3d14a5603b79de0f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/696672/size7/cc16221ddd26b31a3d14a5603b79de0f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-95729","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-95729","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":894,"opdsId":"urn:uuid:SW-460727","title":"ಚುಪುಕ್ ಚಪಾಕ್","authors":["Sriram MS"],"language":"","readingLevel":"","publisher":"","summary":"ಕಂಕನ್ ಶಾಲೆಗೆ ಹೋಗುವಾಗ ಅನೇಕ ಶಬ್ದಗಳು ಕೇಳಿಸುತ್ತವೆ. ಕೇಳಲು ನೀವೂ ಕಂಕನ್, ಓಯ್ಮಲಿ ಮತ್ತು ಅವರ ಸಹಪಾಠಿಗಳ ಜೊತೆಗೆ ಹೆಜ್ಜೆ ಹಾಕಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/580942/size7/64ef262735bae98332df63da6d68389a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/580942/size7/64ef262735bae98332df63da6d68389a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-460727","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-460727","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":895,"opdsId":"urn:uuid:SW-134733","title":"ಹ್ಯಾಗೋಸನ ಆಸ್ತಿ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ತನ್ನ ಮಕ್ಕಳ ಪ್ರತಿಭೆಯನ್ನು ಸರಿಯಾಗಿ ಗುರುತಿಸಿದ್ದ ತಂದೆಯೊಬ್ಬ  ಅವರವರ ಯಶಸ್ಸಿಗೆ ಅನುಕೂಲವಾಗುವಂತೆ  ತನ್ನ ಆಸ್ತಿಯನ್ನು ಹಂಚಿಕೊಟ್ಟ ಕಥೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/141845/size7/a7164ef13c889209527c4355f11e01ef.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/141845/size7/a7164ef13c889209527c4355f11e01ef.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-134733","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-134733","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":896,"opdsId":"urn:uuid:SW-576766","title":"ಬುದ್ದಿವಂತ ಕಪ್ಪೆ ಕೆಂಗ","authors":["Bhat Ananthesha"],"language":"","readingLevel":"Level 2","publisher":"","summary":"ತೋಟದಲ್ಲಿ ಯಾರೂ ಕೆಂಗನ ಜೊತೆ ಆಟವಾಡಲಿಲ್ಲ, ತುಂಬಾ ದುಃಖದಿಂದ ಕೆಂಗ ಮನೆಯೊಳಗೆ ನುಗ್ಗಿ ಸೋಮಾರಿ ಹುಡುಗನ ಹಾಸಿಗೆಯ ಕೆಳಗೆ ಅಡಗಿಕೊಂಡಿತು. ಹಾಸಿಗೆಯ ಕೆಂಗನಿಗಾಗಿ ಕಾಯುತ್ತಿರುವ ಅನೇಕ ವಿಶೇಷ ಸ್ನೇಹಿತರು ಇದ್ದಾರೆ ...ಅವನು ಅಕ್ಷರಗಳು ಮತ್ತು ಸಂಖ್ಯೆಗಳನ್ನು ಕಲಿಯುತ್ತಾನೆ ಮತ್ತು ಗಣಿತವನ್ನು ಓದುವುದು ಮತ್ತು ಮಾಡುವುದನ್ನು ಕಲಿಯುತ್ತಾನೆ. ತನ್ನ ಹೊಸ ಪ್ರತಿಭೆಗಳೊಂದಿಗೆ ಅವನು ಏನು ಮಾಡುತ್ತಾನೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/128558/size7/a5a2583ee67f6efbe154174de36d7583.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/128558/size7/a5a2583ee67f6efbe154174de36d7583.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-576766","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-576766","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":897,"opdsId":"urn:uuid:SW-209285","title":"ಬಣ್ಣ ಹಾಕುವ ಚಿಕ್ಕಮ್ಮ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಬಣ್ಣ ಹಾಕುವ ಚಿಕ್ಕಮ್ಮ ತುಂಬಾ ಬಟ್ಟೆಗಳಿಗೆ ಬಣ್ಣ ಹಾಕಿದಳು. ಕತೆಯನ್ನು ಓದಿ ಅವಳು ಯಾವ ಯಾವ ಬಣ್ಣ ಹಾಕಿದಳು ಎಂಬುದನ್ನು ತಿಳಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/282964/size7/93170e50f6e50ead4638f7ec3045c900.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/282964/size7/93170e50f6e50ead4638f7ec3045c900.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-209285","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-209285","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":898,"opdsId":"urn:uuid:SW-457982","title":"ಮೀನಾಳ ನಾಗಾಲೋಟ","authors":["Amruta Shastry"],"language":"","readingLevel":"","publisher":"","summary":"ಸ್ಪೋರ್ಟ್ಸ್‌ ಡೇ ಬಂದಿದೆ. ಮೀನಾ 400-ಮೀಟರ್ ಓಟದ ಸ್ಪರ್ಧೆಯಲ್ಲಿ ಪಾಲ್ಗೊಳ್ಳಬೇಕಿದೆ. ಅದಕ್ಕಾಗಿ ಅಭ್ಯಾಸ ಮಾಡಬೇಕೆಂದೂ ಅವಳಿಗೆ ಗೊತ್ತಿದೆ. ಮೊದಲು ಅವಳು 100, ಆಮೇಲೆ 200 ಮೀಟರ್ಸ್ ಓಡಿ ಅಭ್ಯಾಸ ಮಾಡಿದಳು. ಆದರೆ, ಅವಳು 400 ಮೀಟರ್ಸ್ ಓಡಬಲ್ಲಳೇ? ಮೀನಾ ಅಭ್ಯಾಸ ಮಾಡುವಾಗ ನೀವು ಅಳೆಯುವುದನ್ನು ಕಲಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/436810/size7/c1a3205a510f214897d38cc6ee0972a9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/436810/size7/c1a3205a510f214897d38cc6ee0972a9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-457982","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-457982","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":899,"opdsId":"urn:uuid:SW-622197","title":"ಶಿರೊನ ಪ್ರಿಯ ಗೆಳೆಯರು","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಶಿರೊ ಎಷ್ಟೊಂದು ಜಾಮೂನು ತಿಂದಿದ್ದಾನೆ. ಈಗ ಅವನ ಪ್ರಿಯ ಗೆಳೆಯರಾದ ಅಂಗಾಂಗಳು ಮತ್ತು ಜೀರ್ಣಾಂಗ ವ್ಯವಸ್ಥೆ ಮೂಲಕ ಅವನ ಹೊಟ್ಟೆಯ ಕತೆ ಏನಾಗಿದೆ ಅನ್ನೋದನ್ನ ನೋಡೋಣ ಬನ್ನಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/509932/size7/8f08e4ba13f297ed51e8fd2b5065263e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/509932/size7/8f08e4ba13f297ed51e8fd2b5065263e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-622197","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-622197","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":900,"opdsId":"urn:uuid:SW-592968","title":"ನಾ ಇರುವುದೇ ಹೀಗೆ!","authors":["Dr Akshata Shanbhag"],"language":"","readingLevel":"","publisher":"","summary":"ಕುರಿ ಮಟ್ಕುಗೆ ಸಣ್ಣ ಕಿಂಡಿಯಂತಹ ದೊಡ್ಡಿಯ ಬಾಗಿಲು ದಾಟಿ ಒಳಗೆ ಹೋಗಲು ಆಗುತ್ತಿಲ್ಲ. ಅದನ್ನು ತೆಳ್ಳಗಾಗಿಸಲು ಬೇರೆ ಕುರಿಗಳು ನಾನಾ ರೀತಿಯ ವ್ಯಾಯಾಮ ಮಾಡಲು ಸಲಹೆ ನೀಡುತ್ತವೆ. ಆದರೆ, ಅವ್ಯಾವುದರಿಂದಲೂ ಏನೂ ಪ್ರಯೋಜನ ಆಗುವುದಿಲ್ಲ. ಕೊನೆಯಲ್ಲಿ ಮಟ್ಕು, “ನಾ ಇರುವುದೇ ಹೀಗೆ!” ಹೀಗಿರುವುದೇ ಚೆಂದ ಎಂದು ಅರ್ಥಮಾಡಿಕೊಳ್ಳುತ್ತದೆ ಮತ್ತು ಜಾಣತನದಿಂದ ತನ್ನ ಸಮಸ್ಯೆಯನ್ನು ಪರಿಹರಿಸಿಕೊಳ್ಳುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/91966/size7/0dd597833ba92602ccca0646f0cad212.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/91966/size7/0dd597833ba92602ccca0646f0cad212.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-592968","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-592968","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":901,"opdsId":"urn:uuid:SW-460577","title":"ವೀರಾ ಮತ್ತು ತಿಲ್ಲಿ","authors":["Abhinav Anil  Hande"],"language":"","readingLevel":"","publisher":"","summary":"ವೀರಾ ತಿಲ್ಲಿಯನ್ನು ಜೋಪಾನವಾಗಿ ನೋಡಿಕೊಳ್ಳುತ್ತಿದ್ದ, \nಅಷ್ಟರಲ್ಲಾಗಲೇ ಸುಗ್ಗಿಯ ಕಾಲ ಬಂದಿತು. ತಿಲ್ಲಿ ದಷ್ಟ-ಪುಷ್ಟವಾಗಿ ಬೆಳೆದಿದೆಯೇ? ಮಾರಾಟದ ಸಮಯದಲ್ಲಿ ವೀರಾ ತಿಲ್ಲಿಯನ್ನು ಕೊಡುವನೇ? ಈರುಳ್ಳಿ ಸಸಿ ಜೊತೆಗೆ ಹುಡುಗನೊಬ್ಬನ ಒಡನಾಟ ಹಾಗೂ ನಾವು ತಿನ್ನುವ ಆಹಾರವನ್ನು ಬೆಳೆಯುವುದರ ಕುರಿತು ಮನಮುಟ್ಟುವ ಕತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/420659/size7/59e2352cd8c1fd7b00518690574670b2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/420659/size7/59e2352cd8c1fd7b00518690574670b2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-460577","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-460577","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":902,"opdsId":"urn:uuid:SW-578070","title":"ಎಂಬೋಜ ಸಾಹಸಗಳು ಮತ್ತು ಅವಳ ಹುಂಜ","authors":["Bhat Ananthesha"],"language":"","readingLevel":"Level 3","publisher":"","summary":"ಶಾಲಾ ರಜಾದಿನಗಳಲ್ಲಿ, ಎಂಬೋಜಾ ಮತ್ತು ಅವಳ ಪೋಷಕರು ಅವಳ ಅಜ್ಜಿಯನ್ನು ಭೇಟಿ ಮಾಡಲು ಹೋಗುತ್ತಾರೆ. ಅವರು ಬಂದಾಗ, ಅಜ್ಜಿ ಎಂಬೋಜಾಗೆ ಒಂದು ಹುಂಜವನ್ನು ಉಡುಗೊರೆಯಾಗಿ ನೀಡುತ್ತಾರೆ, ಆದರೆ ಅವಳು ಮೊದಲು ಅದನ್ನು ಬೆನ್ನಟ್ಟಿ ಹಿಡಿಯಬೇಕು. ಎಂಬೋಜಾ ಹುಂಜವನ್ನು ಹಿಡಿಯುತ್ತಾಳೆ ಎಂದು ನೀವು ಭಾವಿಸುತ್ತೀರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/101404/size7/31df5a06f51f018807b952b06fa2b5c2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/101404/size7/31df5a06f51f018807b952b06fa2b5c2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-578070","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-578070","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":903,"opdsId":"urn:uuid:SW-150021","title":"ಸಮುದ್ರ ಸಸ್ತನಿಗಳು ಹಿಮಾಲಯವನ್ನು ಹತ್ತಿದ್ದು ಹೇಗೆ?","authors":["G W Carlo"],"language":"","readingLevel":"","publisher":"","summary":"ನೂರು ಮಿಲಿಯನ್ ವರ್ಷಗಳ ಹಿಂದೆ ಭೂಮಿ ಈಗಿರುವುದಕ್ಕಿಂತ ಬೇರೆ ರೀತಿ ಕಾಣಿಸುತ್ತಿತ್ತು. ಈಗ ಪರ್ವತಗಳು ಇದ್ದಲ್ಲಿ ಸಮುದ್ರಗಳಿದ್ದವು. ಖಂಡಗಳ ಆಕಾರವು ಬೇರೆ ಆಗಿತ್ತು! ಆದರೆ ಇದೆಲ್ಲವು ಇಂದಿನ ಭೂಮಿಯಾಗಿ ಮಾರ್ಪಾಡು ಆಗಿದ್ದು ಹೇಗೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721197/size7/54460e465ed3c11b1fca744463b98a53.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721197/size7/54460e465ed3c11b1fca744463b98a53.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-150021","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-150021","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":904,"opdsId":"urn:uuid:SW-48105","title":"ಬೆಂಕಿಪೊಟ್ಟಣದಾಟ","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಪ್ರೇಮ್ ಮತ್ತವನ ಗೆಳೆಯರಿಗೆ ಟೀಚರು ಸಣ್ಣ ಬೆಂಕಿಪೊಟ್ಟಣ ತುಂಬುವ ಚಟುವಟಿಕೆಯನ್ನು ನೀಡಿದ್ದರು. ನೀವೂ ಇದನ್ನೊಮ್ಮೆ ಮಾಡಿ, ಮಜಾ ನೋಡಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/43610/size7/37b27665c10faf1bd7e8637da3d93033.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/43610/size7/37b27665c10faf1bd7e8637da3d93033.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-48105","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-48105","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":905,"opdsId":"urn:uuid:SW-473071","title":"ಬೀಚು ಸ್ವಚ್ಛವಾಯಿತು","authors":["Sushmitha  KM"],"language":"","readingLevel":"","publisher":"","summary":"ಅರ್ಜುವಿಗೆ ಸಮುದ್ರತೀರವೆಂದರೆ ಅಚ್ಚುಮೆಚ್ಚು. ಕಸ, ಕಡ್ಡಿಗಳಿಂದ ಗಲೀಜಾಗಿದ್ದ ಬೀಚನ್ನು ಸ್ವಚ್ಛ ಮಾಡೋದೇನು ಸುಲಭದ ಕೆಲಸವೇ! ಸ್ನೇಹಿತರ ಸಹಾಯದ ಜೊತೆ, ಗಣಿತದ ಕೆಲವು ಅಂಶಗಳನ್ನು ಬಳಸಿಕೊಂಡ ಅರ್ಜುವಿಗೆ ಈಗ, ಎಲ್ಲ ಸಮಸ್ಯೆಗಳಿಗೂ ಅದರದೇ ಆದ ಪರಿಹಾರವಿದೆ ಎಂದು ಗೊತ್ತಾಗಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716104/size7/053d818fe7b1f95214b74bd176b8550c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716104/size7/053d818fe7b1f95214b74bd176b8550c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-473071","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-473071","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":906,"opdsId":"urn:uuid:SW-474613","title":"ಪಳೆಯುಳಿಕೆಗಳು: ಪ್ರಾಚೀನ ಕತೆಗಳು","authors":["Sujaya Shekar"],"language":"","readingLevel":"","publisher":"","summary":"ಪಳೆಯುಳಿಕೆಗಳು ನಮ್ಮ ಪುರಾತನ ಯುಗಗಳ ಕುರಿತಾದ \nಹಲವು ಪ್ರಶ್ನೆಗಳಿಗೆ ಉತ್ತರ ನೀಡಬಲ್ಲವು - ಆದಿಮಾನವರು, \nಸದ್ಯ ಮರುಭೂಮಿಯಂತಾಗಿರುವ ಅಂದಿನ ಕಾಡುಗಳು ಮತ್ತು \nಗತಿಸಿದ ಪಶು-ಪ್ರಾಣಿಗಳ ಕುರಿತಾದ ಸಾಕ್ಷ್ಯಗಳನ್ನು ಇವು ನೀಡಬಲ್ಲವು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725285/size7/ab66d40aba8e67ef12bf6d139455b0cf.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725285/size7/ab66d40aba8e67ef12bf6d139455b0cf.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-474613","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-474613","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":907,"opdsId":"urn:uuid:SW-563140","title":"ಎಲೆಕೋಸುಗಳನ್ನು ಎಣಿಸುವುದು","authors":["Bhat Ananthesha"],"language":"","readingLevel":"Level 2","publisher":"","summary":"ಎಣಿಕೆ ಮತ್ತು ಹಂಚಿಕೆ ಕುರಿತು ಗಣಿತದ ಕಥೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527527/size7/ca129e32af21af0eae0ef6129066a10f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527527/size7/ca129e32af21af0eae0ef6129066a10f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-563140","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-563140","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":908,"opdsId":"urn:uuid:SW-640752","title":"ನಾವು ಬಯಸುವುದು ಏನೆಂದರೆ...","authors":["Bhargavi Hema"],"language":"","readingLevel":"","publisher":"","summary":"ಆರು ಕಲಾವಿದರು ತಮ್ಮ ಕನಸು, ನಿರೀಕ್ಷೆ, ಆಕಾಂಕ್ಷೆಗಳನ್ನು ಈ ವಿಶೇಷ ಪುಸ್ತಕದಲ್ಲಿ ಹಂಚಿಕೊಳ್ಳಲು ಜೊತೆಗೂಡಿದ್ದಾರೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712719/size7/6ab6bcb0f21dc196c8e9dd3f6b219aff.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712719/size7/6ab6bcb0f21dc196c8e9dd3f6b219aff.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-640752","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-640752","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":909,"opdsId":"urn:uuid:SW-586619","title":"ನಿಮ್ಮ ಸುತ್ತಲಿನ ವಸ್ತುವಿನ ಸ್ಥಿತಿಗಳು","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ನೀವು ನಿಮ್ಮೂರಿನ ಮಾರುಕಟ್ಟೆಯಲ್ಲಿದ್ದೀರಿ ಎಂದು ಕಲ್ಪಿಸಿಕೊಳ್ಳಿ. ನಿಮ್ಮ ಸುತ್ತಲೂ ನೀವು ಏನು ನೋಡುತ್ತೀರಿ? ಈ ಎಲ್ಲಾ ವಿಷಯಗಳು ಸಾಮಾನ್ಯವಾಗಿದೆ ಎಂದು ನೀವು ಭಾವಿಸುತ್ತೀರಾ? ಓದುಗರಿಗೆ ವಸ್ತು, ಘನವಸ್ತು, ದ್ರವ, ಅನಿಲಗಳ ಗುಣಲಕ್ಷಣಗಳನ್ನು ಪರಿಚಯಿಸುವ ಪುಸ್ತಕ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/