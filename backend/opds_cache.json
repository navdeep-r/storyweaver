yweaver.org.in/illustration_crops/725413/size7/ce76d232acdcbc97d22d67d7ad3defba.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725413/size7/ce76d232acdcbc97d22d67d7ad3defba.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-34426","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-34426","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":878,"opdsId":"urn:uuid:SW-38708","title":"Rimis Red Book","authors":["Alisha Berger"],"language":"","readingLevel":"reading","publisher":"","summary":"Rimi is always on the move! She loves to get into everything. Sometimes she interrupts Jitu when he is reading. Can Rimi and Jitu find a way to enjoy reading together?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/93520/size7/7f7c54f23cb7d737162c5e813e058e70.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/93520/size7/7f7c54f23cb7d737162c5e813e058e70.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-38708","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-38708","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":879,"opdsId":"urn:uuid:SW-123622","title":"The Dog Who Knew Sadness","authors":["Nisarg Prakash"],"language":"","readingLevel":"","publisher":"","summary":"Sadness follows Feroz like a shadow. But his best friend Noah is always there to chase it away.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/730558/size7/3d0cb2d3b0fda20721eca326ffa562e0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/730558/size7/3d0cb2d3b0fda20721eca326ffa562e0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-123622","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-123622","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":880,"opdsId":"urn:uuid:SW-272","title":"Sailing Home","authors":["Subhadra Sen Gupta"],"language":"","readingLevel":"","publisher":"","summary":"Basava and his sister Sundari live in the port-town of Mamallapuram during the Pallava period. Their father, a sailor, has not returned from his voyage to Kamboja and the children are worried. When they go to the port to find out if anyone there has information about their father's ship, they realise to their dismay that the foreign sailors there don't speak a word of their language! What are they going to do now?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703512/size7/faeccb52ca9fc7dce7067448e6e8eb61.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703512/size7/faeccb52ca9fc7dce7067448e6e8eb61.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-272","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-272","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":881,"opdsId":"urn:uuid:SW-38067","title":"Khuku and the Catfish","authors":["Stephanie  Wei"],"language":"","readingLevel":"","publisher":"","summary":"Khuku is exploring the sea with a catfish. Suddenly, a crocodile starts to chase them. Do you think the catfish will be able to save Khuku from the crocodile?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/93515/size7/de9c960accd220267c73aa15f0dd1401.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/93515/size7/de9c960accd220267c73aa15f0dd1401.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-38067","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-38067","type":"applicatio