":"https://storyweaver.org.in/api/v0/story/pdf/SW-273822","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-273822","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":308,"opdsId":"urn:uuid:SW-61680","title":"The Magic Letter","authors":["Aaquib Jaleel"],"language":"","readingLevel":"","publisher":"","summary":"Ijas receives a letter from his best friend Vikram. He can't wait to read it! But when he opens the letter, he is in for a surprise.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715435/size7/f5d72137c40e34f62e312d1469ef4961.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715435/size7/f5d72137c40e34f62e312d1469ef4961.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-61680","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-61680","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":309,"opdsId":"urn:uuid:SW-264075","title":"Snails in a Spiral","authors":["Samidha Gunjal"],"language":"","readingLevel":"","publisher":"","summary":"The natural world is full of patterns — lines, dots, spirals. Look closely around you, and you will notice patterns everywhere!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/652282/size7/1e3a23dcdc396af31898db61f77cfe98.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/652282/size7/1e3a23dcdc396af31898db61f77cfe98.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-264075","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-264075","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":310,"opdsId":"urn:uuid:SW-122938","title":"How to Catch the Wind","authors":["Anjali Vaidya"],"language":