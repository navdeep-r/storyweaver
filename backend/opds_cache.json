.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-54646","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":136,"opdsId":"urn:uuid:SW-125010","title":"The Laddoo Code","authors":["Saksham Arora"],"language":"","readingLevel":"","publisher":"","summary":"Rahul and Ritvik’s friends always eat up their snacks. Until one day, they come up with a secret code to protect their food.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/180166/size7/49c85a9527750e46622accc20a0c24f0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/180166/size7/49c85a9527750e46622accc20a0c24f0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-125010","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-125010","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":137,"opdsId":"urn:uuid:SW-38666","title":"A Special Nest","authors":["Kavita Singh"],"language":"","readingLevel":"","publisher":"","summary":"A bird is trying to build a nest for herself. But everywhere she builds a nest, something or the other disturbs her. What will she do?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/100169/size7/6ba43714a19f5bc87346890ae7c45e3b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/100169/size7/6ba43714a19f5bc87346890ae7c45e3b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-38666","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-38666","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":138,"opdsId":"urn:uuid:SW-25922","title":"What's Ameena Up To?","authors":["Roopa Banerjee"],"language":"","readingLevel":"","publisher":"","summary":"Everyone’s wondering what Ameena is up to on a sleepy Sunday afternoon. After all, where did\nthe coconut shell, the paint, the buttons, and newspaper go?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495580/size7/bce292876fe0cffa390e460a5b5e0b88.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495580/size7/bce292876fe0cffa390e460a5b5e0b88.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-25922","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-25922","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":139,"opdsId":"urn:uuid:SW-105546","title":"The Tiffin Gang","authors":["Shweta Ganesh Kumar"],"language":"","readingLevel":"","publisher":"","summary":"Meenu dislikes tiffin time because Amma always gives her idlis. But what do her classmates bring for lunch? Meenu decides to peek into their boxes and find out.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/159426/size7/24bf771e8e549de1a9f5449bc5c0e216.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/159426/size7/24bf771e8e549de1a9f5449bc5c0e216.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-105546","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-105546","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":140,"opdsId":"urn:uuid:SW-45980","title":"Tine and the Faraway Mountain","authors":["Shikha Tripathi"],"language":"","readingLevel":"","publisher":"","summary":"Whooshoo! Whooshoo!\nIn the hilly town of Echali, Tine hears a whisper. It's the mountains calling to her.\nAs she grows up, Tine dreams of getting closer to her beloved mountains. But can she reach the top of the highest mountain in the world?\nBased on the life of a mountaineer from Arunachal Pradesh, this book celebrates the power of dreams and believing in yourself.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/83442/size7/2499ede9af5c09c5a97f7cea234d4a65.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/83442/size7/2499ede9af5c09c5a97f7cea234d4a65.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-45980","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-45980","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":141,"opdsId":"urn:uuid:SW-1101","title":"The Elephant Bird","authors":["Arefa Tehsin"],"language":"","readingLevel":"","publisher":"","summary":"Munia Knew that the giant one-feathered elephant bird had not swallowed the horse, even though he was big enough to swallow one! So where had the horse disappeared? A story about a magical bird, and a brave and curious child.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/27020/size7/17058267175af8fd5a857fa240a3d630.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/27020/size7/17058267175af8fd5a857fa240a3d630.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-1101","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-1101","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":142,"opdsId":"urn:uuid:SW-47976","title":"Snip","authors":["Canato Jimo"],"language":"","readingLevel":"","publisher":"","summary":"A pair of scissors turns the day upside down for Avi and Toto. Will the playful siblings get into trouble? A wordless story full of mischief and mayhem.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495566/size7/1b7001d2c4ddf2c017bfb4589f885f91.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495566/size7/1b7001d2c4ddf2c017bfb4589f885f91.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-47976","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-47976","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":143,"opdsId":"urn:uuid:SW-43229","title":"Chunu &amp; Munu: It's Freezing!","authors":["Alisha Berger"],"language":"","readingLevel":"","publisher":"","summary":"Chunu and Munu wake up on a freezing cold morning. They can’t find their warm clothes! Where can the clothes be?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/101410/size7/9d1ab657164a00bed5d792be5509c5c0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/101410/size7/9d1ab657164a00bed5d792be5509c5c0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-43229","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-43229","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":144,"opdsId":"urn:uuid:SW-22064","title":"Did You Hear?","authors":["Sejal Mehta"],"language":"","readingLevel":"","publisher":"","summary":"Listen carefully and you will find that birds have a lot to say.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527532/size7/d554b58ed4a31df51c45cca2a90e4aa0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527532/size7/d554b58ed4a31df51c45cca2a90e4aa0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-22064","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-22064","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":145,"opdsId":"urn:uuid:SW-31958","title":"The Drawing Game","authors":["Anitha Murthy"],"language":"","readingLevel":"","publisher":"","summary":"Jeenu and Ajji are drawing circles, triangles and squares. Then they turn t