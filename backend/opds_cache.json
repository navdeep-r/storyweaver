rg.in/api/v0/story/pdf/SW-604732","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-604732","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":830,"opdsId":"urn:uuid:SW-599631","title":"माझी पिवळी छत्री","authors":["Ashlesha Gore"],"language":"","readingLevel":"","publisher":"","summary":"एखाद्या उदासवाण्या, पावसाळी दिवशी साधीसुधी छत्रीसुद्धा अगदी बहार आणू शकते. एवढंच नव्हे, तर ती इतर अनेक अनपेक्षित गोष्टीही करू शकते. कोणत्या बरं या गोष्टी? चला, एक चक्कर मारून बघू या.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/706685/size7/d283c7549928879966054e39f420f4ad.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/706685/size7/d283c7549928879966054e39f420f4ad.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-599631","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-599631","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":831,"opdsId":"urn:uuid:SW-611205","title":"आशेचा प्रकाश","authors":["Sayali Godse"],"language":"","readingLevel":"","publisher":"","summary":"अम्माच्या मते शक्ती काहीच धड करू शकत नाही. त्यामुळे, शक्ती नेहमीच निराश असते. एके दिवशी तिला एक मुलगी भेटते. आपल्या सगळ्यांमधेच चमकण्याची क्षमता आहे, याची ती शक्तीला आठवण करून देते.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727673/size7/46954cc7c750b045e7e96c77bd372b8f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727673/size7/46954cc7c750b045e7e96c77bd372b8f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-611205","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-611205","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":832,"opdsId":"urn:uuid:SW-9640