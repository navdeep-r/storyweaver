:"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":681,"opdsId":"urn:uuid:SW-141699","title":"हौज खास आणि तळ्याकाठची शाळा","authors":["Meera Joshi"],"language":"","readingLevel":"","publisher":"","summary":"तुम्हाला एखादा गुप्त माग काढत जायला आवडेल का? हे पुस्तक तुम्हाला दिल्लीच्या हौज खास परिसरात अशाच एका ठिकाणी घेऊन जाईल. \nतिथं आहे एक जुन्या काळची शाळा, मशीद, बाग आणि काही कबरीसुद्धा.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/185528/size7/71ce8958f4c23ef9e94c96f9df6a6664.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/185528/size7/71ce8958f4c23ef9e94c96f9df6a6664.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-141699","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-141699","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":682,"opdsId":"urn:uuid:SW-53434","title":"माझ्या तारकाविश्वात आहे कृष्णविवर","authors":["Meera Joshi"],"language":"","readingLevel":"","publisher":"","summary":"तीन मित्र सूर्यमालेच्या शोधमोहिमेसाठी पृथ्वीवरून अवकाशयानातून उड्डाण करतात. अचानक त्यांचं यान एका कृष्णविवरात ओढलं जाऊ लागतं. सुटकेसाठी ते काय करतील? चला तर, त्यांच्या या अवकाश साहसात आपणही सहभागी होऊ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717893/size7/fd72155d5f986ecb1b1e0afa27f5da77.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717893/size7/fd72155d5f986ecb1b1e0afa27f5da77.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-53434","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-53434","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":683,"opdsId":"urn:uuid:SW-44734","title":"सायकल शिकण्याची मोहीम","authors":["Mukund Taksale"],"language":"","readingLevel":"","publisher":"","summary":"नुरेनला सायकल शिकायची होती. इतकंच नव्हे, तर तिच्या वसीम या सगळ्यात जवळच्या मित्रासोबत शर्यत लावून ती जिंकायचीही होती... पण शहरातलं वातावरण तंग होतं. आता तिच्या सायकल शिकण्याच्या बेताचं काय होणार?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117609/size7/f694813ea14be3f5b5c97621019ab51f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117609/size7/f694813ea14be3f5b5c97621019ab51f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-44734","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-44734","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":684,"opdsId":"urn:uuid:SW-389","title":"ताई ताई, वस्तू वर का नाही पडत?","authors":["Utkarsha Manish"],"language":"","readingLevel":"","publisher":"","summary":"लहान भावाकडे आपल्या  ताईला विचारायला अनेक प्रश्न आहेत. त्याला  माहीत \nआहे, ताईकडे सर्व उत्तरे आहेत, कारण ती नेहमी कोणते ना कोणते तरी जाडे \nपुस्तक घेऊन वाचत असते.\nया पुस्तकात छोट्या भावाला प्रश्न पडला आहे - वस्तू वर का नाही पडत? \nवस्तू वर पडल्या तर किती मजा येईल नाही? कमीतकमी आई तरी जमिनीवरच्या पसाऱ्यावरून  कटकट करणार नाही!\nताईला हसू येतं, आणि ती तिच्या छोट्या भावाला याबुद्धिविशिष्ट  प्रश्नाचे \nउत्तर देते. पण हे मजेदार पुस्तक वाचण्यापूर्वी तुम्ही सांगा : तुम्हाला काय वाटते, \nवस्तू वर का नाही पडत?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722409/size7/6fba8609c6e66c4289bbcef0bfcb7e0a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722409/size7/6fba8609c6e66c4289bbcef0bfcb7e0a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-389","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-389","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":685,"opdsId":"urn:uuid:SW-377761","title":"बांधकामाची साधनं","authors":["Atish Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"नवं घर बांधायला सुरुवात झाल्यापासून ईशाचं त्याकडे बारकाईनं लक्ष आहे. चला तर तिच्याबरोबर आपणही बघू या, घर बांधायला कुठली कुठली साधनं लागतात ते!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/524492/size7/71c89ef279fc4bf1646113016705e08b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524492/size7/71c89ef279fc4bf1646113016705e08b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-377761","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-377761","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":686,"opdsId":"urn:uuid:SW-43329","title":"अम्माचं टूलकिट","authors":["Asavari Gupchup"],"language":"","readingLevel":"","publisher":"","summary":"बाथरूममधला पाइप फुटल्यावर, मिनी आणि ताराच्या घरात पाणीच पाणी झालं तेव्हा मग अम्मा धावून आली. अम्माच्या टूलकिटमध्ये काय काय होतं?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/90215/size7/f32daefc05db2f3a283a542d3941a48b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/90215/size7/f32daefc05db2f3a283a542d3941a48b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-43329","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-43329","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":687,"opdsId":"urn:uuid:SW-140458","title":"किक मारा, चालू करा अन् भर्रकन निघा!","authors":["Atish Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"मोटरसायकल कशी चालते ते तुम्हाला जाणून घ्यायचंय? ही सारी तर तिच्या इंजिनाच्या शक्तीची किमया! कशी ते जाणून घ्या या छानशा पुस्तकात.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/188858/size7/de395e43c427984657880d799020ce6f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/188858/size7/de395e43c427984657880d799020ce6f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-140458","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-140458","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":688,"opdsId":"urn:uuid:SW-38912","title":"अदृश्य करणारा अंगरखा","authors":["Varsha  Joshi"],"language":"","readingLevel":"","publisher":"","summary":"तुम्हाला अदृश्य करणारा अंगरखा मिळाला तर? पहिली गोष्ट म्हणजे, लपंडाव खेळायला खूप मजा येईल. पण असा अदृश्य करणारा अंगरखा कुणी बनवतंय का? की तो फक्त विज्ञान कथा आणि गोष्टी यामध्येच असतो? तेच तर शोधायला अर्णव आणि तनिशा वाचनालयात चालले आहेत. चला, आपण आवाज न करता त्यांच्यामागून जाऊ या - ते आपल्याला पाहू शकत नाहीत. त्यांच्या जगात आपण अदृश्य असल्यासारखेच आहोत.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117560/size7/aea0af0ba611e75850bc4dd4c24a7c54.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117560/size7/aea0af0ba611e75850bc4dd4c24a7c54.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-38912","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-38912","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":689,"opdsId":"urn:uuid:SW-849","title":"रुमनिया","authors":["Utkarsha Manish"],"language":"","readingLevel":"","publisher":"","summary":"रुमनिमा आणि आजी ही मजेदार जोडी आहे, कारण त्यांना माहीत आहे शेवटी सगळं ठीकठाक होते. रुमनियाची ही सुंदर गोष्ट वाचा!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721914/size7/7dadaadee741eae210e664a0e3d2319f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721914/size7/7dadaadee741eae210e664a0e3d2319f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-849","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-849","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":690,"opdsId":"urn:uuid:SW-56926","title":"कोण बरं गेलं इथून?","authors":["Mrinalinee  Vanarase"],"language":"","readingLevel":"","publisher":"","summary":"हे कोणाच्या बरं पायाचे ठसे आहेत? हा माग कुणी बरं सोडला असेल? प्राणी आणि ते सोडत असलेले ठसे यांची बालवाचकांना ओळख करून देणारं पुस्तक.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/714338/size7/79cec9b30eb76917a457653a32a5b3e2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/714338/size7/79cec9b30eb76917a457653a32a5b3e2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-56926","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-56926","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":691,"opdsId":"urn:uuid:SW-813","title":"समीरा  खरेदीला जाते","authors":["Smita Kolatkar"],"language":"","readingLevel":"","publisher":"","summary":"समीरा आणि मूचकबरोबर खरेदीला चला!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/705280/size7/4b968198dc09db6e476f02d1ba505cba.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/705280/size7/4b968198dc09db6e476f02d1ba505cba.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-813","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-813","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":692,"opdsId":"urn:uuid:SW-65359","title":"गडबडदासचं पाणी पळालं!","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"गडबडदास कुप्रसिद्ध गायक गर्दभदासाचा मुलगा आहे. भारतातल्या एका कोपऱ्याततल्या एका खेड्यात तो राहतो. आपल्या बाबांसारखाच तोसुद्धा खूप वाईट गातो. गडबडदास सोडून बाकीच्या सगळ्यांनाच तो किती वाईट गातो हे नीट माहीत आहे. गडबडदास नेहमीच काहीतरी खटपटी लटपटी करतो आणि गाणं गाऊन त्याचे प्रश्न अनेकदा सोडवतो.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727059/size7/2e28482892278aceea1647757d2c7ade.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727059/size7/2e28482892278aceea1647757d2c7ade.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-65359","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-65359","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":693,"opdsId":"urn:uuid:SW-341899","title":"पाटलिपुत्र","authors":["Ashok Londhe"],"language":"","readingLevel":"","publisher":"","summary":"पाटलिपुत्र चारही बाजुंनी लाकडाच्या भिंतींनी वेढलले एक सुरक्षित राज्य...या विशेष राज्याबद्दल तुम्ही आणखी जाणुन घेऊ इच्छिता का...","coverUrl":"https://static.storyweaver.org.in/illustration_crops/423669/size7/ecad8e6a5f89c8c2a451f70f4fd4544b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/423669/size7/ecad8e6a5f89c8c2a451f70f4fd4544b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-341899","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-341899","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":694,"opdsId":"urn:uuid:SW-704","title":"झुला गेला उडून","authors":["Smita Kolatkar"],"language":"","readingLevel":"","publisher":"","summary":"उडणारा झुला तुम्ही खाली कसा आणाल? या हुशार मुलांबरोबर खेळायला चला आणि याचं उत्तर शोधा.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721010/size7/845ad35f9d2a4a26d36d0db5f6116654.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721010/size7/845ad35f9d2a4a26d36d0db5f6116654.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-704","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-704","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":695,"opdsId":"urn:uuid:SW-5113","title":"मणीला सगळं अति होतं तेव्हा…","authors":["Sushrut Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"मणिकंठनच्या गळ्यातल्या ताईताला सगळं सगळं कळतं. तो कधी आनंदी आहे की दु:खी, आजारी आहे की धडधाकट हे सगळं तो ताईत ओळखतो. कधी जेवायचं, कधी झोपायचं हे तर तो सांगतोच, शिवाय त्याला गृहपाठ करायलाही मदत करतो. मणिकंठनची तब्येत जर ठीक नसेल तर तो तसं त्याच्या आईलाही सांगतो. ही जादू आहे की विज्ञानाचा चमत्कार? बघूया मणिकंठन आणि त्याची आई त्यांच्या खेड्यातून ’स्मार्ट सिटी’त आल्यावर काय घडतं ते!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712349/size7/80baf01ee305956f7dc6a39548938ed4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712349/size7/80baf01ee305956f7dc6a39548938ed4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-5113","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-5113","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":696,"opdsId":"urn:uuid:SW-33460","title":"रानातून चालताना","authors":["Mrinalinee  Vanarase"],"language":"","readingLevel":"","publisher":"","summary":"जखुमासोबत रानात चला. जखुमा मिझोराममधे राहतो. तो तिथला वनरक्षक आहे. जखुमासोबत जंगलाचा फेरफटका करूया. तिथे तो आपल्याला तिथल्या तऱ्हतऱ्हेच्या प्राण्यांची ओळख करून देईल. जंगलाचं रक्षण म्हणजे काय करावं लागतं, तेसुद्धा सांगेल.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/524523/size7/105ec7cc57f87e459269355b2764f4bf.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524523/size7/105ec7cc57f87e459269355b2764f4bf.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-33460","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-33460","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":697,"opdsId":"urn:uuid:SW-39669","title":"चालकरहित गाडी चालवतं कोण?","authors":["Meera Joshi"],"language":"","readingLevel":"","publisher":"","summary":"चला, गोष्टीची वेळ झाली!  सुवीची आजी उन्हाळ्याच्या सुट्टीत तिच्याकडे आलेली आहे. सुवीला तिच्याकडून जास्तीत जास्त गोष्टी ऐकायच्या आहेत. आजी तिला पुष्पक विमानाची गोष्ट सांगू लागते. सुवीला वाटतं, अरे हे तर आपल्या चालकरहित म्हणजे ड्रायव्हर नसलेल्या गाडीसारखंच दिसतंय. आपलं जाण्याचं ठिकाण सांगायचं, की झालं. ही गाडी आपल्याला सुरक्षित तिथं नेऊन पोचवते. सुवी आणि आजीबरोबर वाचा या उत्कंठापूर्ण शोधाची गोष्ट!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717239/size7/5e819e64be3f8479367fb429bdb9cff8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717239/size7/5e819e64be3f8479367fb429bdb9cff8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-39669","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-39669","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":698,"opdsId":"urn:uuid:SW-146518","title":"कुरणांच्या शोधात","authors":["Mrinalinee  Vanarase"],"language":"","readingLevel":"","publisher":"","summary":"हवेतली ऊब वाढू लागली की रूम सिंह आपल्या मेंढ्या-बकऱ्या घेतो आणि \nताज्या गवतासाठी हिमालयाचे चढ चढू लागतो. गेली चाळीस वर्षे तो हे करतो आहे. जागतिक तापमानवाढीमुळे अशी भटकी जीवनशैली दिवसेंदिवस कठीण होते आहे. याबाबतचे वास्तव छायाचित्रांच्या माध्यमातून सांगणारी ही गद्दी जमातीतल्या एका मेंढपाळाची गोष्ट. दर वर्षी चांगलं कुरण शोधत त्याला पर्वतात आणखी आणखी उंच चढावं लागतं आहे.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/674076/size7/bd639ecc34bcfc59ac0f39900fe565bd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/674076/size7/bd639ecc34bcfc59ac0f39900fe565bd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-146518","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-146518","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":699,"opdsId":"urn:uuid:SW-45954","title":"राजाचा मुकुट","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"राजा अनवर्त जेंव्हा कौतुकानं त्या उंच पगोडाकडे मान वर करून बघायचा तेंव्हा त्याचा मुकुटच खाली पडायचा. मग काय युक्ती केली त्या राजानं? आता आपण ज्या देशाला म्यानमार म्हणतो तिथे घडलेली ही गोष्ट!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726964/size7/0ae16bb956d9050f08df35fe1dabc4dd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726964/size7/0ae16bb956d9050f08df35fe1dabc4dd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-45954","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-45954","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":700,"opdsId":"urn:uuid:SW-61657","title":"बिंटीला ठाऊक असतं सगळं!","authors":["Shruti Panse"],"language":"","readingLevel":"","publisher":"","summary":"बिंटीनं काय करायला हवं हे तुम्ही तिला सांगून बघा हवं तर, पण आपल्याला काय करायचं आहे हे तिला अगदी नीटच माहिती असतं.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/121015/size7/e7f943a7bba87bbde3adea8376a9e15a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/121015/size7/e7f943a7bba87bbde3adea8376a9e15a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-61657","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-61657","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":701,"opdsId":"urn:uuid:SW-24655","title":"बँडीकोटाताई बेंगालेन्सिसची साहसी समुद्रसफर","authors":["Mrinalinee  Vanarase"],"language":"","readingLevel":"","publisher":"","summary":"बँडीकोटा बेंगालेन्सिस काही साधीसुधी घूस नव्हती. तिला नवं नवं शोधून काढण्याचा नाद होता. नवं काही शोधून काढताना तिचे डोळे चमकायचे. अशी कुठली दुसरी घूस असेल? दररोज रात्री ती आपलं सामान बांधायची. त्यात तिचा गॉगल असायचा, दुर्बिण, भिंगं आणि हो, तिचे आवडते स्टीकर बॅंडेज असायचे. “ज्याला नवं काही शोधायचं असेल त्यानं नेहेमी कसं तयार असलं पाहिजे” असं ती म्हणे. दर दिवशी ती वेगळीकडे खणे. आणि नंतर घरी परत यायला? अर्थातच एक नवं बीळ. \nया अनोख्या मुशाफिराला यावेळी एक नवीनच ठिकाण सापडलंय. समुद्र किनारा. चला तर मग तिच्या सोबत सफरीला. किनाऱ्याची जादुई दुनिया आणि या घुशीला भेटलेले गंमतीदार प्राणी पाहायला खूपच मजा येईल, नाही का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117644/size7/345aa877047222aeb24a3b5c333a5da8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117644/size7/345aa877047222aeb24a3b5c333a5da8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-24655","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-24655","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":702,"opdsId":"urn:uuid:SW-63556","title":"ऊनवेडी सुंठीमाऊ","authors":["Sai Keskar"],"language":"","readingLevel":"","publisher":"","summary":"सुंठी नावाच्या माऊला ऊन फार म्हणजे फारच आवडतं. अगदी आजोबांसारखंच. उन्हात असं आहे तरी काय? चला पाहू या!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715519/size7/2247ababfc686d876f65073da146fafa.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715519/size7/2247ababfc686d876f65073da146fafa.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-63556","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-63556","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":703,"opdsId":"urn:uuid:SW-21266","title":"वाळवंटातला माळढोक","authors":["Santosh Shintre"],"language":"","readingLevel":"","publisher":"","summary":"चैतनच्या घरी तसेही फार कमीच पाहुणे येतात. यावेळी आलेल्या पाहुण्यानं असे काय गुण दाखवले की चैतनच्या रागाचा पारा एकदम वर गेला? त्याच्या सर्वात प्रिय, जवळच्या ‘गगन’ या मित्राशी तर याचा काही संबंध नाही ना? राजस्थानमधल्या एका दुर्गम खेड्यातल्या छोट्या मुलाची, आणि जवळजवळ नामशेष होऊ घातलेल्या एका पक्ष्याच्या आयुष्यातल्या उलथापालथीची ही सुरस कहाणी जरूर वाचा.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/179752/size7/5da42abc315b5a28d1ea665ad7c570e0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/179752/size7/5da42abc315b5a28d1ea665ad7c570e0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-21266","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-21266","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":704,"opdsId":"urn:uuid:SW-15357","title":"बादशाही पार्क","authors":["Mukund Taksale"],"language":"","readingLevel":"","publisher":"","summary":"तिथं जाण्याची कुणाचीच छाती नव्हती. त्यातून राी तिथं जायचं आणि थेट तिथल्या थडग्यावर खिळा ठोकून यायचं? अशी पैज लावणारा अशहर एक तर मूर्ख तरी असावा किंवा फाजील धाडसी! ज़ुल्फी आणि इतर दोस्तांबरोबर त्यानं पैज लावली खरी, पण पौर्णिमेच्या रात्री त्या भुताटकीच्या मकबऱ्यात अशहर खरोखरच घुसून दाखवेल का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721706/size7/7455c3e7d30a58b67c0cb76a80888ca8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721706/size7/7455c3e7d30a58b67c0cb76a80888ca8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15357","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15357","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":705,"opdsId":"urn:uuid:SW-144114","title":"घर","authors":["Mukund Taksale"],"language":"","readingLevel":"","publisher":"","summary":"एका छोट्याशा खेड्यात खूप पाऊस पडायचा. हसीना आणि तिचं कुटुंब तिथं आनंदात राहत होतं. एक दिवस अचानक आलेल्या संकटामुळं हसीनाला आणि तिच्या अम्माला गाव सोडून माणसांच्या एका लोंढ्यात सामील व्हावं लागलं. बेघर होऊन ओळखीची कुठलीही खूण नसणाऱ्या एका नव्याच मुलखात ते शरणार्थी म्हणून राहू लागले. ‘घर’ म्हणजे काय याचा अर्थ हळूवारपणे उलगडून सांगणारी ही गोष्ट.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/518337/size7/f324e69b9a98fdcaed6a391bcd6c4412.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/518337/size7/f324e69b9a98fdcaed6a391bcd6c4412.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-144114","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-144114","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":706,"opdsId":"urn:uuid:SW-110851","title":"बहुरंगी मुली","authors":["Meera Joshi"],"language":"","readingLevel":"","publisher":"","summary":"सगळ्या मुली सारख्याच असतात का? विचार करून सांगा पाहू...","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723769/size7/9f2d836cd9446a608320018eb9b12086.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723769/size7/9f2d836cd9446a608320018eb9b12086.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-110851","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-110851","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":707,"opdsId":"urn:uuid:SW-214259","title":"नवे पुस्तक","authors":["Ashok Londhe"],"language":"","readingLevel":"","publisher":"","summ