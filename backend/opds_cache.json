api/v0/story/epub/SW-95002","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1240,"opdsId":"urn:uuid:SW-8717","title":"Neqaşe Büçkełegan","authors":["Muhamadreza Bahadur"],"language":"","readingLevel":"","publisher":"","summary":"Mał řeň kirdin fere xueş e! Bełam deranege bayed çi řeň bû?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/697317/size7/fae553c96cec531f760c79641f63a924.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/697317/size7/fae553c96cec531f760c79641f63a924.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-8717","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-8717","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1241,"opdsId":"urn:uuid:SW-539431","title":"Dunia Kallu 3: Mangu Mali dan Ambia Bhoot","authors":["Iona Stella Lumban Tobing"],"language":"","readingLevel":"","publisher":"","summary":"Selamat datang di Desa Khajuria, tempat Kallu muda dan teman-temannya berpetualang seru hampir setiap hari. Mereka mempertanyakan tradisi desa, melawan penindas, atau hanya menjalani hari-hari seperti biasa. Intinya, selalu ada yang dilakukan Kallu dan teman-temannya. Bergabunglah bersama mereka saat mereka makin bijak dan menyenangkan, menjelajahi desa dengan gembira, dan menemukan berbagai kegiatan baru. Cari tahu apa rencana mereka!\nSemua warga Khajuria tahu Munia sangat pemarah. Mereka juga tahu Mangu Mali sama sekali tidak mau membagi mangga yang ditanamnya di kebun. Munia sangat ... sangat menginginkan mangga dari kebun Mangu Mali itu. Bisa kamu bayangkan situasinya? Bacalah dan lihatlah apa yang terjadi!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/31115/size7/6d83c8e348dae277f57773d74ef2f9e2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/31115/size7/6d83c8e348dae277f57773d74ef2f9e2.jpg","acquisi