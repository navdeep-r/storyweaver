.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-351653","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":437,"opdsId":"urn:uuid:SW-26976","title":"The Very Shocking Report Card","authors":["Jane De Suza"],"language":"","readingLevel":"","publisher":"","summary":"What would happen if report cards were not all about studying and writing exams? What\nmarks would you get then?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/55823/size7/7a98e95badfcfc3d0de61368a90d57a2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/55823/size7/7a98e95badfcfc3d0de61368a90d57a2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-26976","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-26976","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":438,"opdsId":"urn:uuid:SW-43617","title":"Our Friends in the Wild","authors":["Shannon David"],"language":"","readingLevel":"","publisher":"","summary":"Throughout time, people have shared a strong relationship with animals in nature. This non-fiction poem explores the many ways that animals help humans.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/99533/size7/0da7a566a04002a3cab59345951503b8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/99533/size7/0da7a566a04002a3cab59345951503b8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-43617","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-43617","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":439,"opdsId":"urn:uuid:SW-361239","title":"North, South, East, West","authors":["C G Salamander"],"language":"","readingLevel":"","publisher":"","summary":"Shaana is travelling the length and breadth o