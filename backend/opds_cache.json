n/api/v0/story/pdf/SW-17745","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-17745","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":557,"opdsId":"urn:uuid:SW-237812","title":"How the Toad Got Its Skin","authors":["Alice Mulwa"],"language":"","readingLevel":"","publisher":"","summary":"This tale explains why toads have bumpy backs and can live away from water.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/337775/size7/cca740300affa74267fcfb08b2705d29.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/337775/size7/cca740300affa74267fcfb08b2705d29.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-237812","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-237812","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":558,"opdsId":"urn:uuid:SW-15961","title":"Lion on the loose","authors":["Paro Anand"],"language":"","readingLevel":"","publisher":"","summary":"Do rainy days make you feel that the world is full of possibilities? The lion in the story certainly believes so! Read this story to meet him as he takes a rainy day holiday from the zoo and have as much fun as the children in the story. After all, the author maintains that this story is ‘almost true’!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/42881/size7/91de93728ea0174899f988fca4f160ee.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/42881/size7/91de93728ea0174899f988fca4f160ee.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15961","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15961","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":559,"opdsId":"urn:uuid:SW-986","title":"Tok Tok","authors":["Vidya Pradhan"],"language":"","readingLevel":"","publisher":"","summary":"The food-loving king of Sonapur could not sleep because of a mysterious sound in his chambers. What could it be?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/706157/size7/93c759f49808e92b7f9cefb99d3989f4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/706157/size7/93c759f49808e92b7f9cefb99d3989f4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-986","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-986","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":560,"opdsId":"urn:uuid:SW-342422","title":"The Plant Whisperer","authors":["Sayantan Datta"],"language":"","readingLevel":"","publisher":"","summary":"Young Jaishree loves nothing more than plants. She wants to understand them, which is why she decides to spend her life studying plants. This biography of ecologist Dr H Jaishree Subrahmaniam is a story of passion and gumption.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/491323/size7/1990bf6c5f6788bca49cd0131c95f55a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/491323/size7/1990bf6c5f6788bca49cd0131c95f55a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-342422","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-342422","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":561,"opdsId":"urn:uuid:SW-4782","title":"Bonda and Devi","authors":["Roopa Pai"],"language":"","readingLevel":"","publisher":"","summary":"Do best friends always have to be alike? Devi and Bonda are best friends, but Devi is a little girl, while Bonda is a… Well, he can lift heavy boxes, he can extend his arms and legs, he neve