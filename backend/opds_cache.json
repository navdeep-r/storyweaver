//storyweaver.org.in/api/v0/story/epub/SW-53345","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":492,"opdsId":"urn:uuid:SW-635","title":"भंगारवाला","authors":["Smita Kolatkar"],"language":"","readingLevel":"","publisher":"","summary":"चिनूला आपल्या वडलांना मदत करायला आवडते. \nकधी कधी त्याला त्याबद्दल बक्षीसही मिळते!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/720804/size7/062d956d806708b1d23f33dcee3a9b74.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/720804/size7/062d956d806708b1d23f33dcee3a9b74.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-635","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-635","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":493,"opdsId":"urn:uuid:SW-56379","title":"शाब्बास बुरली!","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"कोंढ जमातीचे आदिवासी जंगलाला लागून राहतात. त्यांना जंगलातली प्रत्येक पाऊलवाट, सालाचं आणि मोहाचं झाड न् झाड ठाऊक असतं. मुंगसाच्या पाऊलखुणा कोणत्या आणि वाघाच्या पाऊलखुणा कोणत्या हे ते पाहताक्षणी सांगू शकतात. चिमुकली बुरलीही निसर्गाच्या या खुणा वाचायला शिकते आहे. पण पुढं काय संकट वाढून ठेवलंय हे ठाऊक आहे का तिला?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/99425/size7/17c509cd79601054fa8341f61478f16a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/99425/size7/17c509cd79601054fa8341f61478f16a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-56379","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-56379","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":494,"opdsId":"urn:uuid:SW-124661","title":"कुत्र्याच्या आयुष्यातला एक दिवस","authors":["Sushrut Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"एखादा कुत्रा दिवसभर काय बरं करतो? चला, या शब्दविरहित पुस्तकाच्या मदतीनं आपण माणसाच्या या सर्वोत्तम मित्राच्या आयुष्यात जरा डोकावून तर पाहू या.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727177/size7/3759994b1ddc2714678973dcf02b3769.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727177/size7/3759994b1ddc2714678973dcf02b3769.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-124661","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-124661","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":495,"opdsId":"urn:uuid:SW-66243","title":"भन्नाट सफर रेषांची","authors":["Atish Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"हडकुळी लंबू म्हणजे उभी रेषा आणि आळशी झोपू म्हणजे आडवी रेषा. या दोघीजणी आपल्या बाकीच्या त्यांच्या मैत्रिणींबरोबर खेळायला गेल्यावर तिथं काय गंमत झाली? पाहू या एका मजेशीर गोष्टीत!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715539/size7/cf9d88b7013979cf37ea1f9bb0c93c9c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715539/size7/cf9d88b7013979cf37ea1f9bb0c93c9c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-66243","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-66243","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":496,"opdsId":"urn:uuid:SW-937","title":"कल्लूचे किस्से 2 - माकडचेष्टा","authors":["Sucheta Kadethankar"],"language":"","readingLevel":"","publisher":"","summary":"कल्लू आणि त्याच्या मित्रांच्या टोळक्याचे रोज काहीतरी नवे गमतीदार उद्योग आणि कारनामे चालू असतात. त्यांच्या या खजुरिया गावात तुमचं स्वागत. कधी ही मुलं गावातल्या एखाद्या प्रथेच्या विरोधात प्रश्न विचारतात, कधी अरेरावी करणाऱ्या एखाद्याला वठणीवर आणतात, कधी फक्त नेहमीची कामं करतात. पण ही टोळी सतत काही ना काही करत असते. गावात आनंदानं भटकणाऱ्या, काहीतरी नवं शोधणाऱ्या आणि त्यातनं शिकत जाऊन शहाणं होणाऱ्या  या टोळक्यात सामील व्हा आणि बघा कशी मजा येते.\nदसऱ्याचे दिवस जवळ आलेत आणि आता वेध लागले आहेत \nरामलीलेचे! गुरुजी दरवर्षी नवीन काहीतरी करतात. यावर्षी काय वेगळी गंमत घडते, बघा बरं वाचून.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722423/size7/37044e541d68c258209aa756f201868c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722423/size7/37044e541d68c258209aa756f201868c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-937","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-937","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":497,"opdsId":"urn:uuid:SW-17758","title":"वादळात सापडली पिशी","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"पिशी ही ‘मन्टा रे’ या जातीतली मोठ्ठी मासोळी होती. एक दिवस \nसमुद्रात वादळ आलं तेंव्हा पिशीला कोणी मदत केली माहीत आहे का?\nकाय घडलं त्या दिवशी?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722387/size7/073d9b1811b5dd45c355c678228d68cc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722387/size7/073d9b1811b5dd45c355c678228d68cc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-17758","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-17758","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":498,"opdsId":"urn:uuid:SW-365221","title":"गोळ्यांची जत्रा","authors":["Atish Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"जत्रेत प्रत्येक मुलाला वेगवेगळ्या रंगाचा गोळा हवा होता. सगळ्यांची वेगवेगळी आवड लक्षात ठेवण्याची एखादी सोपी पद्धत मारियूला माहीत असती तर? वेन आकृत्यांच्या संकल्पनेची ओळख करून देणारी ही गोष्ट.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727386/size7/4ef251bd361e98a2383d82fc2c944bdd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727386/size7/4ef251bd361e98a2383d82fc2c944bdd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-365221","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-365221","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":499,"opdsId":"urn:uuid:SW-61979","title":"आजीची अजब यंत्रं","authors":["Ruchi Shevade"],"language":"","readingLevel":"","publisher":"","summary":"सूरज आणि त्याच्या आजीला नवे नवे प्रयोग करून पाहायची भारीच हौस आहे. आज त्यांनी नारळाच्या वड्या करायचा निश्चय केला आहे, आणि तेसुद्धा साध्या यंत्रांचा वापर करून!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712718/size7/9afb2c00f7a211ff4c8699e66ca7db0b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712718/size7/9afb2c00f7a211ff4c8699e66ca7db0b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-61979","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-61979","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":500,"opdsId":"urn:uuid:SW-15","title":"वारा","authors":["Madhuri Pai"],"language":"","readingLevel":"","publisher":"","summary":"वारा हे पुस्तक वाचन सरावासाठी उपयुक्त आहे. निसर्गातील न दिसणार्या पण \nपावलोपावली जाणवणार्या वार्याची ओळख यात करून दिली गेली आहे.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722240/size7/f6b5a4048ee646dd2c32af6ac5e66e23.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722240/size7/f6b5a4048ee646dd2c32af6ac5e66e23.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15","type":"application/pdf+zip","rel":"http://opds-spec.org/acqui