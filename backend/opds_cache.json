readingcampaignPunjab2022","publisher":"","summary":"Sona’s father made her a lovely toy. Read this charming story about how they helped each other.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722705/size7/4ef3782b5a3f3f10dac1c9abe15abcfe.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722705/size7/4ef3782b5a3f3f10dac1c9abe15abcfe.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-167697","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-167697","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":356,"opdsId":"urn:uuid:SW-25847","title":"The Little Red String","authors":["Madhumita Srivastava"],"language":"","readingLevel":"","publisher":"","summary":"Nani has just finished knitting a cap for a special visitor. Moni and Viru find that the\nleftover red string is the most useful thing in the house. A wordless book about families and\nplay.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726532/size7/3d4a7ae318aa75139890868e939daf18.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726532/size7/3d4a7ae318aa75139890868e939daf18.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-25847","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-25847","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":357,"opdsId":"urn:uuid:SW-375","title":"Playtime","authors":["Manisha Chaudhry"],"language":"","readingLevel":"","publisher":"","summary":"Golu and Chhotu sure make a funny pair. Read about their antics in this funny story.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721916/size7/906e74898bf061f7abefb75c6319ad63.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721916/size7/906e74898bf061f