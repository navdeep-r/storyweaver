l":"https://static.storyweaver.org.in/illustration_crops/524572/size7/86f5aa351b9a396b64694cb8b5f0a555.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524572/size7/86f5aa351b9a396b64694cb8b5f0a555.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-29476","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-29476","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":38,"opdsId":"urn:uuid:SW-22435","title":"ನೀವೂ ಕೇಳಿದಿರಾ?","authors":["Girish N. R."],"language":"","readingLevel":"","publisher":"","summary":"ಗಮನವಿಟ್ಟು ಕೇಳಿ... ಹಕ್ಕಿಗಳ ಕೂಗು ನಿಮಗೂ ಕೇಳುತ್ತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527532/size7/d554b58ed4a31df51c45cca2a90e4aa0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527532/size7/d554b58ed4a31df51c45cca2a90e4aa0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-22435","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-22435","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":39,"opdsId":"urn:uuid:SW-12833","title":"ನಾನು, ನನ್ನಣ್ಣ","authors":["Bhavya"],"language":"","readingLevel":"","publisher":"","summary":"ಇದು ಪಾಠ, ಆಟವನ್ನು ಜೊತೆಜೊತೆಯಾಗಿಯೇ ಮಾಡುವ ಅಣ್ಣತಮ್ಮನ ಕಥೆ. ಅವರು ಒಟ್ಟಿಗೆ ಇದ್ದಾಗ ಏನೇನು  ಮಾಡುತ್ತಾರೆ ಎನ್ನುವುದನ್ನು ಇದು ತಿಳಿಸುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/35077/size7/32c5acbb641dda85c65de0146802be36.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/35077/size7/32c5acbb641dda85c65de0146802be36.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12833","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12833","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":40,"opdsId":"urn:uuid:SW-220","title":"ಪುಟಾಣಿ ಪೇಂಟರ್ ಗಳು","authors":["Shaila Manipal"],"language":"","readingLevel":"","publisher":"","summary":"ಯಾವತ್ತಾದರೂ ಪೇಂಟು ಬಳಿದು, ಮಜಾ ನೋಡಿದ್ದೀರಾ! \nನಿಮ್ಮ ಮನೆ ಗೇಟಿಗೆ ಯಾವ ಬಣ್ಣ ಬಳಿಯುವಿರಿ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/697317/size7/fae553c96cec531f760c79641f63a924.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/697317/size7/fae553c96cec531f760c79641f63a924.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-220","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-220","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":41,"opdsId":"urn:uuid:SW-12997","title":"ಸುಮಾ","authors":["Bhavya"],"language":"","readingLevel":"","publisher":"","summary":"ಸುಮಾ ಒಂಟಿ ಹಾಗೂ ಆಕೆಗೆ ಬೇಜಾರಾಗಿದೆ. ಆಕೆ ಖುಷಿಯಿಂದಿರಲು ಏನೇನು ಮಾಡುತ್ತಾಳೆ ಎಂಬುದನ್ನು ತಿಳಿಯಲು ಈ ಕಥೆ ಓದಿ..","coverUrl":"https://static.storyweaver.org.in/illustration_crops/34972/size7/7660d346761cc28650c41a864263b5f3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/34972/size7/7660d346761cc28650c41a864263b5f3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12997","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12997","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":42,"opdsId":"urn:uuid:SW-12483","title":"ಗುಂಡ ಬೆಕ್ಕು , ತುಂಟ ಬೆಕ್ಕು","authors":["Ananda"],"language":"","readingLevel":"","publisher":"","summary":"ಆಕೃತಿಗಳೆಂದರೆ ಈ ಬೆಕ್ಕಿಗೆ ಬಲು ಇಷ್ಟ. ಈ ಬೆಕ್ಕು ಪುಟ್ಟ ಸ್ನೇಹಿತನ ಜೊತೆ ತಿರುಗಾಡುತ್ತಿರುವಾಗ ಯಾವ ಯಾವ ಆಕೃತಿಗಳು ಕಂಡವು? \nಆಕೃತಿಗಳತ್ತ ಕಣ್ಣು ಹಾಯಿಸುತ್ತಾ ಮಜಾ ಮಾಡಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/720849/size7/129b533b0a0d7b69a71cff6ce379b5a3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/720849/size7/129b533b0a0d7b69a71cff6ce379b5a3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12483","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12483","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":43,"opdsId":"urn:uuid:SW-29624","title":"ಅಹಿಲ್ಯಾಬಾಯಿ ಹೋಳ್ಕರ್","authors":["G W Carlo"],"language":"","readingLevel":"","publisher":"","summary":"ಇದು 28 ವರ್ಷಗಳ ಕಾಲ ಮಾಳ್ವ ರಾಜ್ಯವನ್ನು ಆಳಿದ ರಾಣಿ ಅಹಿಲ್ಯಾಬಾಯಿ ಹೋಳ್ಕರಳ ಕತೆ. ತನ್ನ ಕೆಲಸ ಕಾರ್ಯಗಳಿಂದ ಜನಮನ್ನಣೆ ಗಳಿಸಿ ಇತಿಹಾಸ ನಿರ್ಮಿಸಿದ ದಿಟ್ಟ ರಾಣಿಯ ಕತೆಯನ್ನು ಖಂಡಿತ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/162406/size7/a847404ffd4ea78d9060f1dbd640ab66.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/162406/size7/a847404ffd4ea78d9060f1dbd640ab66.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-29624","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-29624","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":44,"opdsId":"urn:uuid:SW-359","title":"ಕಳೆದಿತ್ತು ಮತ್ತೆ ಸಿಕ್ಕಿತು","authors":["Geetha M."],"language":"","readingLevel":"","publisher":"","summary":"ಒಬ್ಬ ಪುಟ್ಟ ಹುಡುಗ ಏನನ್ನೋ ಕಳೆದುಕೊಂಡು ಹುಡುಕುತಿರುವನು. ಅದು ಸಿಕ್ಕಾಗ ಅವನಿಗೆ ಹೇಗೆನಿಸಿರಬಹುದು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/709189/size7/097ef1a9bc1497c04e9ec0987d19adac.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/709189/size7/097ef1a9bc1497c04e9ec0987d19adac.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-359","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-359","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":45,"opdsId":"urn:uuid:SW-12494","title":"ಚಿಟ್ಟೆಯ ಮುಗುಳ್ನಗೆ","authors":["Brinda N Rao"],"language":"","readingLevel":"","publisher":"","summary":"ಕಾವ್ಯಳ ಕುಟುಂಬ ಇತ್ತೀಚೆಗಷ್ಟೆ ಹಳ್ಳಿಯಿಂದ ಬೆಂಗಳೂರಿಗೆ ಬಂದು ನೆಲೆಸಿದೆ. ತರಗತಿಗೆ ಅವಳು ಹೊಸಬಳು. ಅವಳು ಚಿಟ್ಟೆಗಳ ವನಕ್ಕೆ ಭೇಟಿ ಇತ್ತಾಗ ತನಗೂ ಚಿಟ್ಟೆಗಳಿಗೂ ಇರುವ ವಿಶೇಷ ನಂಟನ್ನು ಮನಗಾಣುತ್ತಾಳೆ. ಅವಳಿಗೆ ಹೊಸ ಗೆಳೆತನವೂ ದೊರೆಯುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712825/size7/46977bed0760c446c9dd926ee5c83ee5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712825/size7/46977bed0760c446c9dd926ee5c83ee5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12494","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12494","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":46,"opdsId":"urn:uuid:SW-37633","title":"ಬಿ.ಕೆ.ತಿರುಮಲಮ್ಮ ಅವರ ಹಾರು-ಬೀಳು ಕವನಗಳು","authors":["B K Tirumalamma"],"language":"","readingLevel":"","publisher":"","summary":"ಕೂಡುವುದು ಹೇಗೆ? ಕಳೆಯುವುದು ಹೇಗೆ? ಕೂರುವ, ಹಾರುವ ಈ ಪುಟ್ಟ ಹಕ್ಕಿಗಳನ್ನು ಕೇಳಿ. ಒಂದು ಚೆಂಡನ್ನು ತೆಗೆದುಕೊಂಡು ಮೇಲಕ್ಕೆ ತೂರಿ, ಪ್ರತಿ ಸಲ ಅದು ಕೆಳಗಡೆ ಬೀಳುವುದನ್ನು ನೋಡುತ್ತಿದ್ದರೆ ಆಟ ಮಜವಾಗಿದೆ ಅಂತ ಅನಿಸುತ್ತಿದೆ ಅಲ್ವ? \n\nಬಿ.ಕೆ.ತಿರುಮಲಮ್ಮ ಅವರ ಹಾರು-ಬೀಳು ಕವನಗಳು \nಮಕ್ಕಳ ಜನಪ್ರಿಯ ಸಾಹಿತ್ಯ ಗುಚ್ಛದ ಭಾಗವಾಗಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/119991/size7/ecbdb118e7715496ef320739505bcd20.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/119991/size7/ecbdb118e7715496ef320739505bcd20.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-37633","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-37633","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":47,"opdsId":"urn:uuid:SW-223","title":"ಚಳಿಗಾಲದಲ್ಲಿ ಬಿಸಿಬಿಸಿ ಚಹಾ","authors":["Shaila Manipal"],"language":"","readingLevel":"","publisher":"","summary":"ಮೀನುವಿನ ಚಳಿಗಾಲದ ಉಡುಪು ಬೀರುವಿನಿಂದ ಹೊರಬಂದಿದೆ. ಗಾಳಿಯಲ್ಲಿ ಹುರಿದ ಬೀಜಗಳ ಸುವಾಸನೆ ಹರಡಿದೆ. ನಾವು ಮಾತನಾಡುವಾಗ, ಬಾಯಿಯ ಮುಂದೆ ಮಂಜಿನ ತೆಳು ಪರದೆ ಏಳುವುದೇಕೆ! \nಈ ಚಳಿಗಾಲದಲ್ಲಿ ಏನಾಗುತ್ತಿದೆ? ಬನ್ನಿ ನೋಡೋಣ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/702420/size7/42fc34e6412fa8bae45d57c80db0b6f3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/702420/size7/42fc34e6412fa8bae45d57c80db0b6f3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-223","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-223","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":48,"opdsId":"urn:uuid:SW-381400","title":"ಕೋಳಿಯಷ್ಟು ಖುಷಿಯಾಗಿ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಭೂಮಿ ಮೇಲಿನ ಕೋಳಿಗಳು ನಡೆಸುವ ಅದ್ಭುತ ಜೀವನವನ್ನು ನೋಡಲು 'ಬುರ್ಜಿ' ಗ್ರಹದಿಂದ ಕೋಳಿಯಮ್ಮ, ಕೋಳಿಕುಮಾರ್ ಬಂದಿದ್ದಾರೆ. ಕೋಳಿಕೆರಂಗ ಅವರನ್ನು ಫುಲ್ ಖುಷಿ ಇರುವ ಜಾಗಕ್ಕೆ ಕರೆದುಕೊಂಡು ಹೋಗುತ್ತಾನೆ. ಅದು ಅವರಿಗೆ ಸಂತೋಷ ತುಂಬಿದ ಜಾಗ ಅಂತನಿಸುವುದಿಲ್ಲ ಯಾಕೆ? ಕೋಳಿಗಳು ಎಲ್ಲಿ ಖುಷಿಯಾಗಿರುತ್ತವೆ? ಈ ಕತೆ ಓದಿ ಗೊತ್ತಾಗುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703489/size7/6b0e33e14f7eb589b27584f27ff07e71.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703489/size7/6b0e33e14f7eb589b27584f27ff07e71.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-381400","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-381400","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":49,"opdsId":"urn:uuid:SW-8738","title":"ಅವನಿ ಮತ್ತು ಬಟಾಣಿ ಗಿಡ","authors":["Sneha","Vishwas  HV"],"language":"","readingLevel":"","publisher":"","summary":"ಈ ಕೆಲಸ ಮಾಡಿದ್ದು ಯಾರು? ಅವನಿ ಮತ್ತು ಅವಳ ತಾಯಿಗೆ ಗೊತ್ತಿಲ್ಲ. ಬಟಾಣಿ ಗಿಡದ ಕಥೆಯನ್ನು ಓದಿದಾಗ ಈ ಕೆಲಸ ಮಾಡಿದ್ದು ಯಾರೆಂದು ನಿಮಗೆ ತಿಳಿಯುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/26596/size7/c506a61bdb5cf05f48f5d62d9067927c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/26596/size7/c506a61bdb5cf05f48f5d62d9067927c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-8738","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-8738","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":50,"opdsId":"urn:uuid:SW-29055","title":"ಮಾಂತ್ರಿಕ ತುಂಡು","authors":["Madhav Aithal"],"language":"","readingLevel":"","publisher":"","summary":"ರಿಂಕಿ ಕೈಯಲ್ಲಿದ್ದ ಆ ವಿಶೇಷ ಪೆನ್ನು ಅದು ಹೇಗೋ ಹಾಸಿಗೆಯಡಿ ಸಿಕ್ಕಿ ಹಾಕಿಕೊಂಡಿತು. ಅವಳು ಎಷ್ಟೇ ಪ್ರಯತ್ನಿಸಿದರೂ ಹೊರತೆಗೆಯಲು ಆಗಲಿಲ್ಲ. ಆ ಕಪ್ಪು ತುಂಡು ಅವಳಿಗೆ ಸಹಾಯ ಮಾಡಿತೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/714200/size7/d52ae05d8d77083059bdcbb3508334a8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/714200/size7/d52ae05d8d77083059bdcbb3508334a8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-29055","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-29055","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":51,"opdsId":"urn:uuid:SW-12497","title":"ಕಸದ ರಾಶಿ","authors":["Geetha M."],"language":"","readingLevel":"","publisher":"","summary":"ಕಸದ ರಾಶಿಯ ಮೋಡ ಚೀಕುವಿನ ತಲೆಯ ಮೇಲೆ ತೇಲುತ್ತಿದೆ. ಇದು ಅವಳನ್ನು ಜಗತ್ತಿನ ಅತಿ ದುಃಖಿತ ಹುಡುಗಿಯನ್ನಾಗಿ ಮಾಡಿದೆ. ಆ ಕಸದ ರಾಶಿಯಿಂದ ಚೀಕು ಹೇಗೆ ಮುಕ್ತಗೊಂಡಳು ಎಂದು ಅರಿಯಲು ಈ ಕಥೆ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/713656/size7/2262cbd33bad9fd90a1213d1ee122583.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/713656/size7/2262cbd33bad9fd90a1213d1ee122583.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12497","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12497","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":52,"opdsId":"urn:uuid:SW-12365","title":"ಇರುವೆ ಮತ್ತು ಹಸಿರು ಹೆಸರುಕಾಳು","authors":["Brinda N Rao"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂದು ಪುಟ್ಟ ಇರುವೆಗೆ ಮೊಳಕೆಯೊಡೆದ ದಪ್ಪನೆಯ ಹಸಿರು ಹೆಸರುಕಾಳು ಸಿಗುತ್ತದೆ. ಅದನ್ನು ಮನೆಗೆ ತೆಗೆದುಕೊಂಡು ಹೋಗಬೇಕೆಂದು ಇರುವೆಗೆ ಆಸೆ. ಆದರೆ ದಾರಿಯಲ್ಲಿ ಅನೇಕ ತೊಂದರೆಗಳು ಎದುರಾಗುತ್ತವೆ. ಕಾಳನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋಗಲು ಇರುವೆಗೆ ಸಾಧ್ಯವಾಗುತ್ತದೆಯೇ? ಇರುವೆಯನ್ನು ಹಿಂಬಾಲಿಸಿ ಹೋಗಿ ತಿಳಿದುಕೊಳ್ಳಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721680/size7/9fed9b1f3398292ef2703326117fce4b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721680/size7/9fed9b1f3398292ef2703326117fce4b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12365","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12365","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":53,"opdsId":"urn:uuid:SW-13652","title":"ಅಜ್ಜಮ್ಮನ ಅದ್ಭುತ ಯಂತ್ರಗಳು","authors":["Ravikiran"],"language":"","readingLevel":"","publisher":"","summary":"ಬನ್ನಿ, ಸೂರಜ್ ಮತ್ತು ಅವನ ಅಜ್ಜಿ ಜೊತೆ ಸೇರಿ ನಾವೂ ಕೊಬ್ಬರಿ ಮಿಠಾಯಿ ಮಾಡೋಣ. ಹಾಗೇ, ಒಂದಲ್ಲ, ಎರಡಲ್ಲ, ಆರು ಸರಳ ಯಂತ್ರಗಳ ಪರಿಚಯ ಮಾಡಿಕೊಳ್ಳೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712718/size7/9afb2c00f7a211ff4c8699e66ca7db0b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712718/size7/9afb2c00f7a211ff4c8699e66ca7db0b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-13652","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-13652","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":54,"opdsId":"urn:uuid:SW-261","title":"ಚಿಂವ್ ಚಿಂವ್ ಟಪಕ್ ಟಪಕ್","authors":["Meera Tushar Punarvasu"],"language":"","readingLevel":"","publisher":"","summary":"ಮಗುವಿಗೆ ತನ್ನ ಸುತ್ತಲೂ ಕುತೂಹಲ ಕೆರಳಿಸುವ ಶಬ್ದಗಳು ಕೇಳಿಸುತ್ತಿವೆ. ನಿಮಗೂ ಅವು ಕೇಳಿಸುತ್ತಿವೆಯೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/696727/size7/b3c3e795229850371b008b262b0e7f6d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/696727/size7/b3c3e795229850371b008b262b0e7f6d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-261","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-261","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":55,"opdsId":"urn:uuid:SW-15459","title":"ಬಣ್ಣದ ಮೀನು","authors":["Jayashree Deshpande"],"language":"","readingLevel":"","publisher":"","summary":"ಹಳ್ಳಿಯಲ್ಲಿರುವ ಅಜ್ಜಿಯ ಮನೆಗೆ ತೆರಳಿದ ನಗರದ ಬಾಲಕ ರಾಜುವಿಗೆ ಹೊಳೆಯಲ್ಲಿದ್ದ ಮೀನು ಹೇಳಿದ ಗುಟ್ಟೇನು, ರಾಜು ಅದಕ್ಕೆ ಕೊಟ್ಟ ಮಾತೇನು? “ಬಣ್ಣದ ಮೀನು” ಕಥೆಯನ್ನು ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722296/size7/df538b82c3564bb42b0d7213482d820a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722296/size7/df538b82c3564bb42b0d7213482d820a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15459","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15459","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":56,"opdsId":"urn:uuid:SW-22437","title":"ಇದನ್ನೆಲ್ಲ ತಿಂದವರು ಯಾರು?","authors":["Kollegala Sharma"],"language":"","readingLevel":"","publisher":"","summary":"ಕಾಡು ಇಷ್ಟು ಶುಚಿಯಾಗಿರುವುದು ಹೇಗೆ? ಕಾಡಲ್ಲಿ ಕಸವೇ ಕಾಣುವುದಿಲ್ಲ ಏಕೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/188968/size7/715cc0ac513fbf98008ab8be6fa089d2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/188968/size7/715cc0ac513fbf98008ab8be6fa089d2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-22437","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-22437","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":57,"opdsId":"urn:uuid:SW-24874","title":"ಊಟಾಸುರ","authors":["Meera Tushar Punarvasu"],"language":"","readingLevel":"","publisher":"","summary":"ರೊಟ್ಟಿಯಿಂದ ದೋಸೆವರೆಗೆ, ಚಕ್ಕುಲಿಯಿಂದ ಬರ್ಫಿವರೆಗೆ ಭಾರತದ ನಾನಾ ಭಾಗಗಳಲ್ಲಿ ತರಹೇವಾರಿ ತಿನಿಸುಗಳು ಸಿಗುತ್ತವೆ. ಈ ತಿನಿಸುಗಳ ಆಕಾರಗಳು ಹೇಗಿವೆ ಎಂದು ನೀವೂ ಗಮನಿಸಿರುವಿರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/123549/size7/3687d0df50d079218bf3867d505dcd51.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/123549/size7/3687d0df50d079218bf3867d505dcd51.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-24874","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-24874","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":58,"opdsId":"urn:uuid:SW-440364","title":"ಸಾಕು ಪ್ರಾಣಿಗಳು","authors":["Bhat Ananthesha"],"language":"","readingLevel":"Level 1","publisher":"","summary":"ವಿವಿಧ ಸಾಕು ಪ್ರಾಣಿಗಳು ಯಾರು? ಈ ಪುಸ್ತಕದಲ್ಲಿ ಪಟ್ಟಿ ಮಾಡಿರುವುದನ್ನು ಹುಡುಕಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/231923/size7/8e4e4a9d42a363331e06e745fdf8b8e9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/231923/size7/8e4e4a9d42a363331e06e745fdf8b8e9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-440364","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-440364","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":59,"opdsId":"urn:uuid:SW-16908","title":"ನನ್ನ ಕೈಗಳು, ನನ್ನ ಬೆರಳುಗಳು","authors":["Meera Tushar Punarvasu"],"language":"","readingLevel":"","publisher":"","summary":"ನನ್ನ ಕೈಗಳು ಮತ್ತು ಬೆರಳುಗಳು ಎಷ್ಟೊಂದು ವಿನೋದಮಯ ಕೆಲಸಗಳನ್ನು ಮಾಡಬಲ್ಲವು! ನಿಮ್ಮವು? ಬನ್ನಿ ಕೈ ಜೋಡಿಸೋಣ, ಬಹುವಿಧದ ಕೆಲಸ ಮಾಡೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722023/size7/df7872941c3b47154232ef24b6c1e984.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722023/size7/df7872941c3b47154232ef24b6c1e984.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-16908","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-16908","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":60,"opdsId":"urn:uuid:SW-690","title":"ಮೀನು ಕೇಳಿದ ವಾರ್ತೆ","authors":["Venkatramana Gowda"],"language":"","readingLevel":"","publisher":"","summary":"ಇದು ಅಂತಿಂಥ ಮೀನಲ್ಲ. ಮನೆಯಲ್ಲಿ ರೇಡಿಯೋ ಇರುವ ಘನತೆವೆತ್ತ ಈ ಮೀನು. ವಾರ್ತಾ ಪ್ರಸಾರ ಕೇಳಿ ತನ್ನ ಕುಟುಂಬ ಮಾತ್ರವಲ್ಲ, ಸಮಸ್ತ ಜಲಚರಗಳನ್ನೂ ರಕ್ಷಿಸಿದ ಅಪೂರ್ವ ಕಥೆಯೇ ‘ಮೀನು ಕೇಳಿದ ವಾರ್ತೆ.’","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722316/size7/70d3d953a26157dec8e50a9a64e27a5d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722316/size7/70d3d953a26157dec8e50a9a64e27a5d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-690","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-690","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":61,"opdsId":"urn:uuid:SW-13715","title":"ಮಾಲೂ, ಕಾಲೂ... ಮತ್ತು ಯಾರು?","authors":["Ravikiran"],"language":"","readingLevel":"","publisher":"","summary":"ಮಾಲೂ ಮತ್ತು ಕಾಲೂ ಈ ಸಲ ಗುಡ್ಡದ ಮೇಲಿರುವ ಅಜ್ಜಿ ಮನೆಯಲಿ ಪತ್ತೇದಾರಿ ಕೆಲಸ ಮಾಡಿದ್ದಾರೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722825/size7/a8f6d625f16864f8d814762e38c0e384.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722825/size7/a8f6d625f16864f8d814762e38c0e384.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-13715","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-13715","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":62,"opdsId":"urn:uuid:SW-197","title":"ಆಲೂ-ಮಾಲೂ-ಕಾಲೂ","authors":["A.S. Chandra Mouli"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂದು ದಿನ ಮಾಲೂ ತನ್ನ ಹಿತ್ತಲ ತೋಟದಿಂದ ಒಂದಿಷ್ಟು ಆಲೂಗೆಡ್ಡೆಗಳನ್ನು ತರಬೇಕಿತ್ತು! ಅವನಿಗೆ ಯಾರು ಸಹಾಯ ಮಾಡಿದರು ಅಂದುಕೊಂಡಿರಿ? ಇನ್ಯಾರು, ಕಾಲೂ ತಾನೆ! ಕಾಲೂ ಜೊತೆಗೆ ಮಾಲೂವಿನ ಆಲೂ ತರುವ ಮುಂಜಾವಿನ ಪ್ರಸಂಗ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703824/size7/e58cf9e6698ff1d6a72c150d34efe53e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703824/size7/e58cf9e6698ff1d6a72c150d34efe53e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-197","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-197","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":63,"opdsId":"urn:uuid:SW-8618","title":"ಅತ್ಯುತ್ತಮ ಪಂದ್ಯ","authors":["Sneha","Vishwas  HV"],"language":"","readingLevel":"","publisher":"","summary":"ಯಾವಾಗ ಹಲ್ವಾಗಳು ಜಿಲೇಬಿಗಳೊಡನೆ ಆಡುತ್ತಾರೋ, ಅದು ಬರೇ ಹಾಕಿ ಪಂದ್ಯವಲ್ಲ, ಅದಕ್ಕಿಂತಲೂ ಹೆಚ್ಚಿನದು. ಪ್ರತೀ ನಿಮಿಷದಲ್ಲೂ ಪುಳಕಿತಗೊಳಿಸುವ, ರೋಮಾಂಚಕಾರಿ ಪಂದ್ಯ. ಪ್ರತಿಭೆ, ತಂಡ ಸ್ಪೂರ್ತಿ, ತಂಡ ನಿರ್ವಹಣೆಯ ಸರಿಯಾದ ಉದಾಹರಣೆ. ಪಂದ್ಯದ ಮಧ್ಯದಲ್ಲಿ ಅನಪೇಕ್ಷಿತ ತಿರುವು ನೀಡಿದರೆ ಅದಾಗುವುದು ಅತ್ಯುತ್ತಮ ಪಂದ್ಯ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/27212/size7/ddee2141a9ce35fcaae82ac5424d57c1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/27212/size7/ddee2141a9ce35fcaae82ac5424d57c1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-8618","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-8618","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":64,"opdsId":"urn:uuid:SW-534","title":"ತೂಕಡಿಸುವ ಭೀಮ","authors":["Shalini Jaikumar"],"language":"","readingLevel":"100daysreadingcampaignPunjab2022","publisher":"","summary":"ಪ್ರತಿ ಬೆಳಿಗ್ಗೆ, ನಮ್ಮಲ್ಲಿ ಹಲವಾರು ಮಂದಿ ಅನುಭವಿಸುವ ಕಷ್ಟವನ್ನು ಭೀಮ ಕೂಡ ಅನುಭವಿಸುತ್ತಾನೆ. ಸಮಯಕ್ಕೆ ಸರಿಯಾಗಿ ಅವನಿಂದ ಏಳಲು, ಸಾಧ್ಯವಾಗುತ್ತಿರಲಿಲ್ಲ. ಅವನ ಒಬ್ಬ ಚಿಕ್ಕ ಸ್ನೇಹಿತ ಅವನಿಗೆ ಸಹಾಯ ಮಾಡುತ್ತಾನೆ. ಅದು ಹೇಗೆ ಎಂಬುದರ ಬಗ್ಗೆ ನೀವು ತಿಳಿದುಕೊಳ್ಳಬೇಕೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/719515/size7/0c5a8a69dc7efb78dc43f43a4384daf8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/719515/size7/0c5a8a69dc7efb78dc43f43a4384daf8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-534","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-534","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":65,"opdsId":"urn:uuid:SW-597","title":"ಆಹಾ! ಎಷ್ಟೊಂದು ಬಾಳೆಹಣ್ಣುಗಳು","authors":["Jayashree Deshpande"],"language":"","readingLevel":"","publisher":"","summary":"ಶ್ರೀಂಗೇರಿ ಶ್ರೀನಿವಾಸ ತನ್ನ ತೋಟದಲ್ಲಿ ಬೆಳೆದಿದ್ದ ಸವಿಯಾದ ಬಾಳೆ ಹಣ್ಣುಗಳನ್ನು ಕೊಳ್ಳಲು ಯಾರೂ ತಯಾರಿರಲಿಲ್ಲ. ಆಗ ಶ್ರೀನಿವಾಸ ತಾನು ಬೆಳೆದ ಬಾಳೆ ಹಣ್ಣುಗಳ ಸದುಪಯೋಗಕ್ಕೆ ಏನು ಉಪಾಯ ಮಾಡಿದ ಎನ್ನುವುದನ್ನು ಈ ಮುದ್ದಾದ ಕಥೆಯಲ್ಲಿ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703951/size7/f7817aa88cb268daaa68075155cd66a0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703951/size7/f7817aa88cb268daaa68075155cd66a0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-597","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-597","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":66,"opdsId":"urn:uuid:SW-40394","title":"ಡಾ. ಸಿದ್ಧಯ್ಯ ಪುರಾಣಿಕ ಅವರ ನನ್ನ ಕುದುರೆ","authors":["Dr Siddayya Puranik"],"language":"","readingLevel":"","publisher":"","summary":"ಇದು ಬರಿ ಕೋಲು ಅಂತ ಹೇಳಿದ್ದು ಯಾರು? ಇದು ಕುದುರೆಯೇ. ಬೇಕೆಂದ ಕಡೆ ಅದು ಪ್ರಯಾಣಿ ಸಬಲ್ಲುದು. ಕಲ್ಪನೆಯಂತೆ ಅದು ಎಷ್ಟೊಂದು ಜಾಗಗಳಿಗೆ ಕರೆದುಕೊಂಡೂ ಹೋಗಬಹುದು.\n\nಡಾ.ಸಿ