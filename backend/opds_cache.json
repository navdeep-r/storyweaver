/283721/size7/fd214d8d30a37a6d012502a29ea9a738.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-214261","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-214261","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":777,"opdsId":"urn:uuid:SW-400157","title":"मला करडा रंग खूप आवडतो","authors":["Ashlesha Gore"],"language":"","readingLevel":"","publisher":"","summary":"टोकातोला सगळे रंग आवडतात; पण त्याचा सर्वात आवडता रंग त्याला आपल्या बाबांबरोबर शेकोटीपाशी घालवलेल्या उबदार रात्रींची आठवण करून देतो. चला, मन उल्हसित करणाऱ्या या चित्रांच्या पुस्तकातून आपणही टोकातोच्या रंगीत दुनियेची सफर करू या.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/518339/size7/89787e78298f0fa3f9cf59a4e0d8558d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/518339/size7/89787e78298f0fa3f9cf59a4e0d8558d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-400157","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-400157","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":778,"opdsId":"urn:uuid:SW-136430","title":"त्या रात्री","authors":["Sujata Deshmukh"],"language":"","readingLevel":"","publisher":"","summary":"आरडाओरडा आणि कर्कश आरोळ्या... चैतूला दचकून जाग आली. मिट्ट काळोखात दूरवर आगीच्या ज्वाळा आकाशाकडे झेपावत होत्या. आपलं घर, घरातली माणसं, मित्र-मैत्रिणी, काय होणार सगळ्यांचं? चैतूची भीतीनं गाळण उडाली. हे आवाज एवढे चढे, तापलेले का आहेत? त्यांना काय हवंय? आसपासच्या जगातलं भयाचं वातावरण आणि असहिष्णुतेला आलेला उत याची सुन्न करणारी कहाणी.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/710426/size7/dc91ffc6c1d42b6c393ee8c400316dfa.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/710426/size7/dc91ffc6c1d42b6c393ee8c400316dfa.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-136430","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-136430","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":779,"opdsId":"urn:uuid:SW-272295","title":"वाढदिवसाचा केक","authors":["Rupali Bhave"],"language":"","readingLevel":"","publisher":"","summary":"आझाद, हनिया, चारूलता आणि पियूषला त्यांच्या घरासमोरच्या गल्लीत खेळायला आवडतं. पण गल्लीच्या एका टोकाशी राहणाऱ्या खाष्ट म्हातारीची नजर चुकवून बरं का! एके दिवशी ‘आज तिचा वाढदिवस आहे’ हे त्यांना समजतं. मग हे चारही दोस्त तिच्यासाठी केक बनवायचं ठरवतात. कारण कोणालाच आपला वाढदिवस एकट्यानं घालवावा लागता कामा नये ना? वाचू या, आपुलकीची आणि सहानुभूतीची ही गोड गोष्ट.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/524457/size7/3de4e044e2aa994fccf7b609981e035c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524457/size7/3de4e044e2aa994fccf7b609981e035c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-272295","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-272295","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":780,"opdsId":"urn:uuid:SW-114852","title":"शरण्या संवाद साधते रोबॉटशी","authors":["Atish Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"शरण्याच्या शाळेत एक नवीन विद्यार्थी आलेला आहे. शरण्या त्याच्याशी बोलण्याचा खूप प्रयत्न करते आहे खरी, पण तो मात्र तिच्याशी एक अक्षरही बोलतच नाहीये. त्याला तिची भाषा का बरं कळत नाही? शरण्याला त्याच्याशी बोलण्याचा मार्ग सापडतो का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/720046/size7/61f7713e7da97aaeaba6086bf69eca76.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/720046/size7/61f7713e7da97aaeaba6086bf69eca76.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-114852","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-114852","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":781,"opdsId":"urn:uuid:SW-272279","title":"आर्ना आणि आयरिसने बजावली अवघड कामगिरी…","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"आर्ना आणि आयरिसवर एक नवीनच जबाबदारी येऊन पडलेली आहे. वर्गात एक नवा विद्यार्थी आलेला आहे. या दोघींनी त्याला नवीन शाळेत जम बसवायला मदत करायची आहे. नोर्गेला शाळेची ओळख करून देण्यासाठी ही दुक्कल एक अनोखा मार्ग निवडते – अगदी ‘जाणीव’पूर्वक!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/354874/size7/9c6042fcaf09adad8d5cb470f6ffe56a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/354874/size7/9c6042fcaf09adad8d5cb470f6ffe56a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-272279","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-272279","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":782,"opdsId":"urn:uuid:SW-142475","title":"अप्पा जेव्हा लहान होते...","authors":["Uma Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"पावसाची रिमझिम चालू आहे. तशात आप्पा त्यांच्या बालपणी गाव कसं होतं याची गोष्ट चिलटारीला सांगतात. मग बापलेकांची जोडी घराबाहेर पडते आणि जुन्या-नव्याचा संगम असलेलं गाव त्यांना नव्यानं सापडतं.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723775/size7/9ce1a032e8477edd9c14ea777ca65e75.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723775/size7/9ce1a032e8477edd9c14ea777ca65e75.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-142475","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-142475","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":783,"opdsId":"urn:uuid:SW-598625","title":"विसराळू आजी","authors":["Neeta Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"आजीला विस्मरणाचा आजार जडला आहे. किराणामालाच्या दुकानात जाताना तिने एकाच पायात सँडल घातला होता. इतकंच काय, तीन ते दहा यांच्या मधले आकडेही ती विसरून गेली आहे. आता यानंतर आजी काय काय विसरेल? आपल्या विसराळू आजीबद्दलच्या आठवणींची ही हळूवार गोष्ट सांगते आहे, तिची लहानगी नात!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/705666/size7/1e7aa9f6a7a43bf9e964e88fd9e3d0e8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/705666/size7/1e7aa9f6a7a43bf9e964e88fd9e3d0e8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-598625","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-598625","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":784,"opdsId":"urn:uuid:SW-30036","title":"झाडासारखा मित्र","authors":["Shruti Panse"],"language":"","readingLevel":"","publisher":"","summary":"झाडं आपली मित्र असतात, हे तर आपल्याला ठाऊकच आहे. पण मित्रसुद्धा झाडांसारखे असू शकतात का? मित्रसुद्धा असतात आंबट, गोड किंवा दोन्हीही, अगदी आजीच्या बागेतल्या फळांसारखे!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/54917/size7/ffaa0a6211913d76a018f79a94f4d151.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/54917/size7/ffaa0a6211913d76a018f79a94f4d151.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-30036","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-30036","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":785,"opdsId":"urn:uuid:SW-252259","title":"जग्गू आणि जोजो","authors":["Ashok Londhe"],"language":"","readingLevel":"","publisher":"","summary":"जग्गू जोजोला त्याच्या वाढदिवसाला बोल