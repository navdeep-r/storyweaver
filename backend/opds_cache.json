/SW-39725","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":506,"opdsId":"urn:uuid:SW-25773","title":"बुंऽऽऽऽग! टुणूक!","authors":["Jayshree Joshi"],"language":"","readingLevel":"","publisher":"","summary":"कायलनं तिचा चेंडू जरा जास्तच उंच उडवलाय. बघा बरं, कोण मदत करणार आहे तिला तो चेंडू पकडायला?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726256/size7/4f7d721592563e3785755d18833ad9f7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726256/size7/4f7d721592563e3785755d18833ad9f7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-25773","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-25773","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":507,"opdsId":"urn:uuid:SW-39594","title":"साबणाचे फुगे गोल का असतात?","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"वेगवेगळ्या आकाराचे साबणाचे फुगे तयार होऊ शकतील का,  हे माया आणि मनूला बघायचं आहे. त्या दोघांसारखंच तुम्हीपण प्रत्यक्ष प्रयोग करून साबणाचे फुगे आणि त्यांच्या आकाराविषयी जाणून घेऊ शकता.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717015/size7/7e694fb5fdd89111f6964e007a88db37.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717015/size7/7e694fb5fdd89111f6964e007a88db37.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-39594","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-39594","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":508,"opdsId":"urn:uuid:SW-38909","title":"आणि पौर्णिमेच्या रात्री नीलंबरा उमललं","authors":["Varsha Gajendragadkar"],"language":"","readingLevel":"","publisher":"","summary":"छोट्या बकूला आकडे मोजायला आणि पक्षी निरीक्षण करायला आवडतं. एक दिवस तो रंगीबेरंगी झाडं असलेल्या एका जादुई जंगलात भटकत असतो. तिथे एक अडचण आहे, आणि ती रहस्यमय नीलंबरा फुलाद्वारेच दूर होऊ शकते. बकूची गणिताची आवड इथे उपयोगी पडू शकेल का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717163/size7/47efdbfa0c0dde089ef79512fcb80310.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717163/size7/47efdbfa0c0dde089ef79512fcb80310.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-38909","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-38909","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":509,"opdsId":"urn:uuid:SW-104261","title":"वाघोबा, वाघोबा, गेलात कुठे?","authors":["Rupali Bhave"],"language":"","readingLevel":"","publisher":"","summary":"वाघांचा अभ्यास करणारा एक संशोधक वाघाची विष्ठा आणि केस यांच्या शोधात आहे. त्याला वाघाच्या कितीतरी खुणा सापडतात खऱ्या, पण वाघ नेमका कुठे दडून बसलाय? आपल्याला प्रत्यक्ष वाघ दिसला नाही, तरी त्याचे निरीक्षण करण्याचे मार्ग आहेत. व्वा! ते कुठले? \nचला, वाचूया या पुस्तकात.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/646333/size7/2b9e78c3f98108e08349a85a7d95c20d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/646333/size7/2b9e78c3f98108e08349a85a7d95c20d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-104261","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-104261","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":510,"opdsId":"urn:uuid:SW-39576","title":"नंदिनी कुठे आहे?","authors":["Ashlesha Mahajan"],"language":"","readingLevel":"","publisher":"","summary":"शेतामध्ये वेगवेगळ्या आकारांच्या गायी असतात. मालिनीला त्या गायींना रानामध्ये चरायला घेऊन जायचं असतं. ज्यावेळी ती गायींवर लक्ष ठेवून असते, नेमकी त्याच वेळी तिची धाकटी चुलत बहीण नंदिनी हरवते. मग नंदिनीला शोधण्यासाठी मालिनी तिचा माग काढू लागते. तिला ती शोधून काढते का? ही गोष्ट वर्गीकरणाच्या, म्हणजेच वस्तू वेगळ्या करण्याच्या संकल्पनेची मुलांना ओळख करून देते.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716441/size7/487f7b6f222158fac25528b8cb4aff36.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716441/size7/487f7b6f222158fac25528b8cb4aff36.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-39576","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-39576","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":511,"opdsId":"urn:uuid:SW-302738","title":"पहिली ओळख - पक्ष्यांशी","authors":["Asmita Chitale"],"language":"","readingLevel":"","publisher":"","summary":"आपल्या आजूबाजूला किती तरी पक्षी असतात. ते पाहून आपल्याला किती आनंद होतो ना? पण तुम्हाला ते ओळखू येतात का? पुस्तकाच्या मदतीनं आपण काही पक्ष्यांची ओळख करू घेऊ या!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727077/size7/24d5759b48e84bd414c101159f3b0119.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727077/size7/24d5759b48e84bd414c101159f3b0119.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-302738","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-302738","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":512,"opdsId":"urn:uuid:SW-114848","title":"...आणि बिट्टू बोट्टू बरा झाला!","authors":["Atish Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"बिट्टू बोट्टू हा अँडी नावाच्या एका उपद्व्यापी मुलानं बनवलेला यंत्रमानव! तो अँडीला सगळ्या कामांत मदत करतो. अगदी घरातल्या रोजच्या कामांपासून ते गृहपाठ करण्यापर्यंत. पण जेव्हा खुद्द बिट्टू बोट्टूच अडचणीत सापडतो, तेव्हा अँडीसुद्धा त्याला मदत करतो का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/719969/size7/047b