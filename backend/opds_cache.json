tory/pdf/SW-42673","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-42673","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":179,"opdsId":"urn:uuid:SW-98029","title":"Vayu, le vent","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Viens faire la connaissance du vent, cet ami silencieux et omniprésent qui accomplit tout un tas de choses sans que l'on s'en rende compte vraiment.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722240/size7/f6b5a4048ee646dd2c32af6ac5e66e23.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722240/size7/f6b5a4048ee646dd2c32af6ac5e66e23.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-98029","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-98029","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":180,"opdsId":"urn:uuid:SW-50742","title":"Vivement l'Hyperloop!","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Vishnu déteste les longs voyages. Pourquoi ne disposons-nous pas de moyens de transport super rapides, se demande-t-il. La découverte de l'Hyperloop le stupéfie. Découvre dans ce livre de quoi il s'agit.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717240/size7/a44f4f43a962237c1c43bd120c7d774c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717240/size7/a44f4f43a962237c1c43bd120c7d774c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-50742","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-50742","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":181,"opdsId":"urn:uuid:SW-26544","title":"Miss Laya et sa super moto","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Miss Laya, la prof de sport, aime aider les gens. Découvre-les, elle et sa super moto, tandis qu'elles vrombissent d'aventures en aventures. Ce livre est le premier de la collection « Miss Laya et sa super moto ».","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117362/size7/a894b43fa2809b9b8de75bb7feeb341a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117362/size7/a894b43fa2809b9b8de75bb7feeb341a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-26544","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-26544","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":182,"opdsId":"urn:uuid:SW-41615","title":"La nuit où la Lune a disparu","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Une nuit, la Lune ne s'est pas montrée dans le ciel, au-dessus de l'océan. Maisha et son ami Uchli, le poisson-volant, décident de partir à sa recherche. Mais comment retrouver la Lune sans clair de lune?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/85034/size7/3d21e461e24f11386172abfe1e74d4b4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/85034/size7/3d21e461e24f11386172abfe1e74d4b4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-41615","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-41615","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":183,"opdsId":"urn:uuid:SW-26936","title":"Faune et flore d'une mare urbaine","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"En ville, les zones humides sont considérées comme des friches, en attente de leur réhabilitation. Il faut être un écologiste infatigable pour expliquer ce que sont les mares urbaines, à savoir, des écosystèmes extraordinairement variés qui méritent d'être préservés. Découvre dans cette histoire, basée sur une expérience concrète, la faune et la flore incroyables qui peuplent le paysage urbain.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/621647/size7/39928c882af4ee5fd34262e3951764d7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/621647/size7/39928c882af4ee5fd34262e3951764d7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-26936","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-26936","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":184,"opdsId":"urn:uuid:SW-49643","title":"Le poisson qui ne savait pas nager","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"As-tu déjà entendu parler d'un poisson qui ne sait pas nager ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/85001/size7/e1afc92b13b37721c78a254ef3ca89c4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/85001/size7/e1afc92b13b37721c78a254ef3ca89c4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-49643","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-49643","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":185,"opdsId":"urn:uuid:SW-100692","title":"J'adore mon jardin","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Viens faire la connaissance d'une petite fille qui passe beaucoup de temps dans son jardin rempli de fleurs, d'abeilles et de papillons.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/99587/size7/9e6ac2f6ea4cc4f34e6e276ccbdf9270.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/99587/size7/9e6ac2f6ea4cc4f34e6e276ccbdf9270.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-100692","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-100692","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":186,"opdsId":"urn:uuid:SW-61996","title":"Les maisons des animaux","authors":["Cyrille Largillier"],"language":"","readingLevel":"","publisher":"","summary":"Maisons hautes, maisons dans les arbres, maisons suspendues, maisons souterraines : visite différentes maisons d'animaux, d'oiseaux et d'insectes tout autour de toi.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725062/size7/de0a6352d4f39207a42bf18cab47fef2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725062/size7/de0a6352d4f39207a42bf18cab47fef2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-61996","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-61996","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":187,"opdsId":"urn:uuid:SW-27774","title":"Allons récolter des graines !","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Viens faire la connaissance de Tooka, Poi et leur meilleur ami, Inji. Tandis qu'ils récoltent des graines, nos trois amis font une extraordinaire rencontre.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712346/size7/abaaefe06528fa8cae908c4e423f651b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712346/size7/abaaefe06528fa8cae908c4e423f651b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-27774","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-27774","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":188,"opdsId":"urn:uuid:SW-26295","title":"Qu'est-ce qu'Ameena est en train de manigancer?","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Toute le monde se demande ce qu'Ameena est en train de manigancer en plein dimanche après-midi. Car, après tout, où sont passés la noix de coco, le tube de peinture bleue, les boutons et le journal?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495580/size7/bce292876fe0cffa390e460a5b5e0b88.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495580/size7/bce292876fe0cffa390e460a5b5e0b88.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-26295","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-26295","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":189,"opdsId":"urn:uuid:SW-4194","title":"Chantons sous la pluie","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Sukhiya Kaka est un célèbre chanteur. Il rencontre Dino, le dinosaure, qui s'avère être son plus grand admirateur. À eux deux, ils forment un sacré duo !","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722389/size7/d05540af9b5524776541f85d6f0d63d4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722389/size7/d05540af9b5524776541f85d6f0d63d4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-4194","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-4194","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":190,"opdsId":"urn:uuid:SW-41831","title":"Les lunettes magiques","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Mirium et Tejas possèdent des lunettes magiques. Viens faire leur connaissance tandis qu'ils observent des animaux et des oiseaux que l'on ne rencontre que dans certaines parties du globe.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726794/size7/cff02b8fce687b1661207ff8aaf460c1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726794/size7/cff02b8fce687b1661207ff8aaf460c1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-41831","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-41831","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":191,"opdsId":"urn:uuid:SW-42825","title":"Les créatures préhistoriques","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Tu t'es toujours demandé ce à quoi ressemblait notre planète il y a plusieurs millions d'années? Quel genre de créatures peuplaient la Terre? Quels arbres poussaient dans les forêts préhistoriques? La paléontologie, cette science qui exhume et étudie les traces du passé, peut répondre à certaines de tes questions.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/724109/size7/ffde7fb4ad46096f5a5b5ac794c0dfce.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/724109/size7/ffde7fb4ad46096f5a5b5ac794c0dfce.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-42825","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-42825","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":192,"opdsId":"urn:uuid:SW-24834","title":"Increvables fourmis!","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Viens découvrir la vie captivante des infatigables fourmis. Ce petit livre fait partie de la série « Les Animaux autour de nous » qui comprend quatre ouvrages.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/704670/size7/241eb27666dc624a6d0b5f5b2871e868.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/704670/size7/241eb27666dc624a6d0b5f5b2871e868.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-24834","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-24834","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":193,"opdsId":"urn:uuid:SW-145593","title":"Autour du Monde avec un Chilli","authors":["Dr. Priti Bhatia"],"language":"","readingLevel":"","publisher":"","summary":"Le chilli, ou le piment, a une histoire fascinante, qui nous envoie faire un tour du monde. II est vrai que qu’il s’agit d’une histoire de ce piment piquant, mais c’est aussi une histoire des guerriers courageux et des commerçants, des mers agitées et de terres nouvelles. Amusez-vous bien avec cette histoire écrite par un spécialiste célèbre de la globalisation.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117134/size7/cb13bf0e835750df1be0f46c51b8881d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117134/size7/cb13bf0e835750df1be0f46c51b8881d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-145593","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-145593","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":194,"opdsId":"urn:uuid:SW-298466","title":"Le nouveau camarade de classe","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Aarna et Iris ont une mission à accomplir ! Elles doivent accueillir un nouvel élève. Elles décident de lui présenter leur école d'une façon originale : en utilisant tous leurs sens.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/354874/size7/9c6042fcaf09adad8d5cb470f6ffe56a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/354874/size7/9c6042fcaf09adad8d5cb470f6ffe56a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-298466","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-298466","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":195,"opdsId":"urn:uuid:SW-99397","title":"C'est grave la gravité ?","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Si la Terre est ronde, pourquoi les gens qui habitent en bas ne tombent-ils pas ? La maman de Tig lui donne une réponse et son papa une autre. Qui dit la vérité ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/83445/size7/ded1f2223f434706a4e13db64f52cb22.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/83445/size7/ded1f2223f434706a4e13db64f52cb22.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-99397","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-99397","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":196,"opdsId":"urn:uuid:SW-120223","title":"Le monstre alimentaire","authors":["Selena Gonçalves"],"language":"","readingLevel":"","publisher":"","summary":"Du roti au dosa, en passant par le chakli et le barfi, il existe différent types d'aliment que l'ont peut déguster en Inde. Mais, as-tu déjà remarqué la forme de ces aliments ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/123549/size7/3687d0df50d079218bf3867d505dcd51.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/123549/size7/3687d0df50d079218bf3867d505dcd51.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-120223","type":"application/pdf+zip","rel":"http://opds-sp