/api/v0/story/pdf/SW-276","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-276","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":782,"opdsId":"urn:uuid:SW-38","title":"Counting on Moru","authors":["Rukmini Banerji"],"language":"","readingLevel":"","publisher":"","summary":"In Moru's world, numbers danced, digits waved out and long division looked ike a graceful tail. But one day, this world came crumbling down in school. Moru then became the local bully. Then, someone helped him discover the joy of learning again. Read all about it in this heartwarming story.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/696874/size7/9ff16cdbaba183411b9f0abc8173386f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/696874/size7/9ff16cdbaba183411b9f0abc8173386f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-38","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-38","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":783,"opdsId":"urn:uuid:SW-91645","title":"The World of Money","authors":["Mala Kumar"],"language":"","readingLevel":"","publisher":"","summary":"The Rupaiya Paisa Series brings out many useful facts about money that will help children to use money wisely as they grow up in an ever-changing world. What were early coins made of? How do people earn, save and use money? Can the family buy a fridge even if it does not have the money for it today? Find out all this and more in The World of Money, Book 1 in the Rupaiya Paisa Series.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/521973/size7/c717236abc9f0de954dd4e1ee3789ee9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/521973/size7/c717236abc9f0de954dd4e1ee3789ee9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-91645","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-91645","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":784,"opdsId":"urn:uuid:SW-31970","title":"Pipsqueak Hears Echoes","authors":["Payal Molur","Sanjay Molur"],"language":"","readingLevel":"","publisher":"","summary":"Pipsqueak is an insect bat. He loves to eat mosquitoes for dinner. Sometimes, he and his friends have contests to see who will catch the most. Because it’s fun. And easy. What makes bats like him such great insect hunters? Echolocation, says Doctor Ella. She’s telling young Pip all about it. Let’s listen in, shall we?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716375/size7/0bb000dc2ee9314a7c7f07e30040eb94.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716375/size7/0bb000dc2ee9314a7c7f07e30040eb94.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-31970","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-31970","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":785,"opdsId":"urn:uuid:SW-134074","title":"Asamo, is that you?","authors":["Canato Jimo","Ogin Nayam"],"language":"","readingLevel":"","publisher":"","summary":"The lights are out, and Yumum is looking for Asamo. But what if she isn’t the only one wandering about in the dark?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723774/size7/cb584410ae752672dc7e46ce28d53087.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723774/size7/cb584410ae752672dc7e46ce28d53087.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-134074","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/S