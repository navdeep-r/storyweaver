ec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-27939","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":242,"opdsId":"urn:uuid:SW-56310","title":"Gorillas Go to the Beach","authors":["Jemma Jose"],"language":"","readingLevel":"","publisher":"","summary":"Jump, dance, play! The gorillas are at the beach today. What else do they do there? This book introduces simple verbs in a pop of colour.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727081/size7/71dba9e0d57f48debbb73e859b0c45fe.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727081/size7/71dba9e0d57f48debbb73e859b0c45fe.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-56310","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-56310","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":243,"opdsId":"urn:uuid:SW-181480","title":"Kabuliwala","authors":["Sanghamitra Ghosh"],"language":"","readingLevel":"","publisher":"","summary":"Five-year-old Mini can't stay without talking. She talks all the time to her parents. She talks with Rahmat, the Kabuliwala. Rahmat gives her cashews and kishmish. A beautiful relationship develops between them based on the airy hills of Afghanistan and his own daughter who he had to leave behind at home. But circumstances force Rehmat to end up in jail!\nYears later, it’s Mini’s wedding day and Rehmat walks out with his freedom into a world that has moved on without him.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/331524/size7/38c3ac68b99d765c8c2402b06ac97b71.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/331524/size7/38c3ac68b99d765c8c2402b06ac97b71.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-181480","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"hre