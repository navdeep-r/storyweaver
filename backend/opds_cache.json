s://storyweaver.org.in/api/v0/story/epub/SW-92910","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1048,"opdsId":"urn:uuid:SW-609979","title":"Exam Fever","authors":["Shabnam  Minwalla"],"language":"Ba","readingLevel":"","publisher":"","summary":"Exams are round the corner. And Ma is down with a fever. Everyone is fussing over her, trying to make her feel better. Will her fever go away before the exams?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727674/size7/8f8c33f70a4806d41efd626c5cf14df3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727674/size7/8f8c33f70a4806d41efd626c5cf14df3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-609979","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-609979","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1049,"opdsId":"urn:uuid:SW-387459","title":"A Very Important Tree","authors":["Elana  Bregin"],"language":"","readingLevel":"","publisher":"","summary":"Busi loves the big, beautiful tree outside her house. But her brother wants to cut it down. How will she stop him?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/504043/size7/2946f34ac8c3efb693d6357c01f57c26.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/504043/size7/2946f34ac8c3efb693d6357c01f57c26.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-387459","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-387459","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1050,"opdsId":"urn:uuid:SW-182","title":"Sister, Sister, Where Does Thunder Come From?","authors":["Roopa Pai"],"language":"","readingLevel":"","publisher":"","summary":"Little Brother's inquisitive mind is always full of questions for Big Sister. He knows Big Sister has all the answers, because she is always reading one big fat book or another. In this book, Little Brother wonders where thunder comes from. Is it the roaring of the angry giant who lives in the sky that causes the heavens to rumble, or is it just the wild biker gang up in the clouds that makes all that noise? Of course, Big Sister has the right answer in the end, but before you start reading this fun book to find out, tell us: where do YOU think thunder comes from?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722406/size7/9d3e085a533c4c69c41f353bbdbd072d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722406/size7/9d3e085a533c4c69c41f353bbdbd072d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-182","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-182","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1051,"opdsId":"urn:uuid:SW-29039","title":"And Also!","authors":["Lauren  Beukes"],"language":"","readingLevel":"","publisher":"","summary":"Thabo’s make-believe world has no room for his little sister, Keitu. But she has other ideas!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/85000/size7/0f735076e57f760f3244789c9ccbd395.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/85000/size7/0f735076e57f760f3244789c9ccbd395.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-29039","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-29039","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1052,"opdsId":"urn:uuid:SW-619943","title":"Story Chikkappa","authors":["Reshma Bachwani"],"language":"","readingLevel":"","publisher":"","summary":"Whether children or adults, everyone loves a good story. If we think about our life, we can think of it as a story too. Now, can you imagine a ‘land without stories?’ How would life be different if there were no stories? What would you miss the most? Story Chikkappa is a heartwarming tale with whimsical situations and memorable characters that take you through the journey of how the land without stories transformed into a land filled with story treasures.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/741978/size7/90d045b30ebc18c544cef37aee314e81.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/741978/size7/90d045b30ebc18c544cef37aee314e81.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-619943","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-619943","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1053,"opdsId":"urn:uuid:SW-1007","title":"A Royal Procession","authors":["Subhadra Sen Gupta"],"language":"","readingLevel":"","publisher":"","summary":"Parvati and her brother Laxman live in Pataliputra in the time of Emperor Ashoka, but have never set eyes on their king. One day, they meet a man who works in the palace, and wish they could see the king as often as he does. The children don’t know it, but their wish is going to come true sooner \nthan they think. And when it does, what a royal surprise they are going to have!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703492/size7/b7b9579f578a8043e0e9f143d5315a86.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703492/size7/b7b9579f578a8043e0e9f143d5315a86.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-1007","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-1007","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1054,"opdsId":"urn:uuid:SW-180","title":"A Walk Among Trees","authors":["Nimret Handa"],"language":"","readingLevel":"","publisher":"","summary":"Trees have been growing on our planet well before human beings appeared on it. Without their comforting shade and tasty fruit, our earth would be quite a barren place. Take a walk among trees in the King's orchard to savour the taste, the smell and the legends associated with bountiful fruit trees in India. You will feel refreshed by all that you learn!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/422995/size7/5bc4beb5c0db0f72368346a63702e768.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/422995/size7/5bc4beb5c0db0f72368346a63702e768.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-180","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-180","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1055,"opdsId":"urn:uuid:SW-150269","title":"Queen of Soweto","authors":["Jessica Taylor"],"language":"","readingLevel":"","publisher":"","summary":"Basetsana Kumalo is a beauty queen, but she’s also so much more. She teaches us that true beauty is about having a heart filled with love and generosity. Her story shows us that if you have courage and determination, you can achieve your dreams – whatever they may be.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/207471/size7/9d8e70f4aa3375bf7b6dbfa82839481b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/207471/size7/9d8e70f4aa3375bf7b6dbfa82839481b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-150269","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-150269","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1056,"opdsId":"urn:uuid:SW-248939","title":"Gyalmo, the Queen of the Mountains","authors":["Ranjini Murali"],"language":"","readingLevel":"","publisher":"","summary":"Koyna is in Spiti Valley trying to spot a snow leopard with her friend Lobzang. Gyalmo, the snow leopard, watches from a distance as they try their best to spot her.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/337624/size7/92b92701f14ec65faee8c3e0c3a0cef6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/337624/size7/92b92701f14ec65faee8c3e0c3a0cef6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-248939","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-248939","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1057,"opdsId":"urn:uuid:SW-452492","title":"Shambhu and Me","authors":["Rama Hardeekar-Sakhadeo"],"language":"","readingLevel":"","publisher":"","summary":"Raavi loves Shambhu, the calf. Come, let's see what Raavi and Shambhu do in the cowshed.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727498/size7/d3ee1822e1979c99a2f678a2b8bc5fb0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727498/size7/d3ee1822e1979c99a2f678a2b8bc5fb0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-452492","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-452492","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1058,"opdsId":"urn:uuid:SW-601765","title":"It's Not Fair","authors":["Shabnam  Minwalla"],"language":"","readingLevel":"","publisher":"","summary":"Aisha and Maria are best friends. Until, one day, their classteacher praises Maria for her singing. Then Maria gets the part of a butterfly in a play, and Aisha does not. Aisha’s heart hurts so much that she thinks it could burst. A story about envy and the confusion that comes along with it.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/706686/size7/0cf9d097cfc1b13a45d8dd3f5f5af35f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/706686/size7/0cf9d097cfc1b13a45d8dd3f5f5af35f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-601765","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-601765","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1059,"opdsId":"urn:uuid:SW-361246","title":"Once upon a Coin","authors":["Mala Kumar"],"language":"","readingLevel":"","publisher":"","summary":"Banko discovers the beauty of coins when he sees his grandmother’s collection. Join Banko to find out the images that can be spotted on Indian coins.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/451786/size7/bd94e16a6bcace869c847737c6bfef58.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/451786/size7/bd94e16a6bcace869c847737c6bfef58.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-361246","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-361246","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1060,"opdsId":"urn:uuid:SW-103254","title":"Turtle Dove","authors":["All Children Reading Cambodia"],"language":"","readingLevel":"","publisher":"","summary":"Learn what Turtle Dove can and cannot do!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/156313/size7/b2685fabde7c3f563cd571626aa0c1c5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/156313/size7/b2685fabde7c3f563cd571626aa0c1c5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-103254","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-103254","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1061,"opdsId":"urn:uuid:SW-444584","title":"So Much Work!","authors":["Rama Hardeekar-Sakhadeo"],"language":"","readingLevel":"","publisher":"","summary":"Chotu says that he has to do all the chores at home. Does he really do all the work, or does he just make a mess?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727491/size7/aafa7008a0fe65d0ff63253c160cc60a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727491/size7/aafa7008a0fe65d0ff63253c160cc60a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-444584","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-444584","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1062,"opdsId":"urn:uuid:SW-49208","title":"Jealous Anansi","authors":["Ghanaian  Folktale"],"language":"","readingLevel":"","publisher":"","summary":"Where does Anansi's jealousy lead him?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/93397/size7/763d909c9d9c610f4768cd0578e68dc0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/93397/size7/763d909c9d9c610f4768cd0578e68dc0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-49208","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-49208","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1063,"opdsId":"urn:uuid:SW-303460","title":"Ms Phone","authors":["Ursula Nafula"],"language":"","readingLevel":"","publisher":"","summary":"Ms Phone is quite a character! Can you imagine having five phones, for communicating with different people?","coverUrl":"https://static.storyweaver.org.in/illustration_cr