.org.in/api/v0/story/epub/SW-48494","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1493,"opdsId":"urn:uuid:SW-45859","title":"The Crown","authors":["Brian Kavanagh"],"language":"","readingLevel":"","publisher":"","summary":"A young boy sees that many beautiful birds have a crown. What will he do to get his own?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/99521/size7/a8480b445e7606d8e0e9dd79269d39be.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/99521/size7/a8480b445e7606d8e0e9dd79269d39be.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-45859","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-45859","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1494,"opdsId":"urn:uuid:SW-49729","title":"Clever Jackal and foolish Crow","authors":["Kholeka  Mabeta"],"language":"","readingLevel":"","publisher":"","summary":"How does the hungry jackal get the cheese from the crow?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/126986/size7/3e061c7e01351357eb0bef6c21591e40.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/126986/size7/3e061c7e01351357eb0bef6c21591e40.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-49729","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-49729","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1495,"opdsId":"urn:uuid:SW-613491","title":"Kimbe in Balpakram","authors":["Jemimah Marak"],"language":"","readingLevel":"","publisher":"","summary":"‘Kimbe in Balpakram’ is a tale woven from the threads of Garo lore, whispered around crackling fires in homes in the warm glow of the hearth's light. Kimbe, a wisp of a spirit newly arrived in the mystical Balpakram, embarks on a captivating journey. Along the way, she encounters familiar characters and names from her grandmother’s stories, like the mysterious Matchu Boldak Karam, the enigmatic Chidimmak, and the unknown Dal·gipa Nalsa.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/678187/size7/212d77aa75b68c0f530a08ff835f95eb.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/678187/size7/212d77aa75b68c0f530a08ff835f95eb.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-613491","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-613491","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1496,"opdsId":"urn:uuid:SW-612747","title":"Red Rice","authors":["Nazarene F Jyrwa"],"language":"","readingLevel":"","publisher":"","summary":"Over a pot of red rice, Bei and Dap unfold the many secrets behind red rice. Join them on this heartwarming tale as a secret of the red rice helps Dap bond with his village.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/695691/size7/0f7a2ea3248cb07f659cecf1d3683e2f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/695691/size7/0f7a2ea3248cb07f659cecf1d3683e2f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-612747","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-612747","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1497,"opdsId":"urn:uuid:SW-611147","title":"Mai Jingjing","authors":["Eleanor  Sangma"],"language":"","readingLevel":"","publisher":"","summary":"A group of children gather amidst the bamboo groves to sing the age old song centered around cicadas. Mai jingjing...mai jingjing..ambi mikki echoes throughout the groves.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/675222/size7/020d53acd398fd550e97b7e7d2760ca8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/675222/size7/020d53acd398fd550e97b7e7d2760ca8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-611147","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-611147","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1498,"opdsId":"urn:uuid:SW-528407","title":"A Day at the Museum","authors":["Anu Chowdhury-Sorabjee"],"language":"","readingLevel":"","publisher":"","summary":"Nalini is excited about going to the museum for the first time and exploring it with her friends. There are so many wonderful things to see! Read this book to find out what Nalini takes back for her little brother Ved, after a day at the museum.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/636964/size7/7f38bcd48e6580d967d2c3252a05d617.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/636964/size7/7f38bcd48e6580d967d2c3252a05d617.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-528407","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-528407","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1499,"opdsId":"urn:uuid:SW-41156","title":"Look Again!","authors":["Shruthi  Rao"],"language":"","readingLevel":"","publisher":"","summary":"When Putti and Akka are coming back from the park, Putti sees a dog with ponytails! She also sees a scary monster! Look into this book to see if you can see what she saw. And if you can’t see what the sisters can see, look again at the pictures!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726966/size7/15635f91953824a04da6422127147fd7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726966/size7/15635f91953824a04da6422127147fd7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-41156","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-41156","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1500,"opdsId":"urn:uuid:SW-609676","title":"The Root Bridge","authors":["Imtijungla Ozukum","Lanu Tsudir"],"language":"","readingLevel":"","publisher":"","summary":"The living root bridges of Meghalaya take decades to build. This is the story of a small root who aspires to be a part of one of Meghalaya's mighty root bridges.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/674230/size7/3623c872423e13f7bfce256186398a3e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/674230/size7/3623c872423e13f7bfce256186398a3e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-609676","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-609676","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1501,"opdsId":"urn:uuid:SW-176866","title":"The Story of Help Us Green","authors":["Bhumija  Rishi"],"language":"","readingLevel":"","publisher":"","summary":"Ankit Aggarwal and Bholu from Aaj Ka Jungle talk about Ankit's company 'Help us Green'. What does it do? Find out in this interesting interview.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/334950/size7/6a9e0cfd88d60120b450dc1a5336f8d6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/334950/size7/6a9e0cfd88d60120b450dc1a5336f8d6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-176866","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-176866","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{