SW-45859","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1494,"opdsId":"urn:uuid:SW-49729","title":"Clever Jackal and foolish Crow","authors":["Kholeka  Mabeta"],"language":"","readingLevel":"","publisher":"","summary":"How does the hungry jackal get the cheese from the crow?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/126986/size7/3e061c7e01351357eb0bef6c21591e40.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/126986/size7/3e061c7e01351357eb0bef6c21591e40.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-49729","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-49729","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1495,"opdsId":"urn:uuid:SW-613491","title":"Kimbe in Balpakram","authors":["Jemimah Marak"],"language":"","readingLevel":"","publisher":"","summary":"‘Kimbe in Balpakram’ is a tale woven from the threads of Garo lore, whispered around crackling fires in homes in the warm glow of the hearth's light. Kimbe, a wisp of a spirit newly arrived in the mystical Balpakram, embarks on a captivating journey. Along the way, she encounters familiar characters and names from her grandmother’s stories, like the mysterious Matchu Boldak Karam, the enigmatic Chidimmak, and the unknown Dal·gipa Nalsa.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/678187/size7/212d77aa75b68c0f530a08ff835f95eb.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/678187/size7/212d77aa75b68c0f530a08ff835f95eb.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-613491","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-613491","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1496,"opdsId":"urn:uuid:SW-612747",