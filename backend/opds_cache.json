mbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524523/size7/105ec7cc57f87e459269355b2764f4bf.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-31846","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-31846","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":598,"opdsId":"urn:uuid:SW-23588","title":"An A-maize-ing Story","authors":["Alisha Berger"],"language":"","readingLevel":"","publisher":"","summary":"While Bongie’s family is planting maize in the field, she plants a seed of her own. Bongie takes care of the seed everyday – watering it, making sure it has sunlight, protecting from birds and weeds, and even reading to it. Do you think the seed will grow for Bongie?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/128563/size7/61f6c048b93ee65884af00b514561471.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/128563/size7/61f6c048b93ee65884af00b514561471.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-23588","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-23588","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":599,"opdsId":"urn:uuid:SW-38456","title":"ACHOO!","authors":["Gouri Srinidhi"],"language":"","readingLevel":"","publisher":"","summary":"Kabir sneezes all the time. Read to find out what fresh troubles his sneezes bring to Kabir and his friends and family!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/93509/size7/b045b97ad3e5dad16fe91371048f0b8c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/93509/size7/b045b97ad3e5dad16fe91371048f0b8c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-38456","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"}