er":"","summary":"A story that takes a stance against bullying and emphasizes on doing the right thing.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/529552/size7/55127f1c0c444a320c3cf198c5a1a020.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/529552/size7/55127f1c0c444a320c3cf198c5a1a020.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-152931","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-152931","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":705,"opdsId":"urn:uuid:SW-105117","title":"Little Goat","authors":["Mirna  Lawrence"],"language":"","readingLevel":"","publisher":"","summary":"Little Goat wanders off to look for the sweet grass and doesn’t realise how far she is from Mother Goat.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/156946/size7/27377f741c50c318b7c45c1a5457254f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/156946/size7/27377f741c50c318b7c45c1a5457254f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-105117","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-105117","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":706,"opdsId":"urn:uuid:SW-128449","title":"Art is Everywhere - Here, There and in Food","authors":["Aparna  Kapur","Bijal Vachharajani"],"language":"","readingLevel":"","publisher":"","summary":"Art can happen anywhere, using almost\nanything. In this title of the Art is Everywhere\nseries, the reader joins the artists in looking for\nforms and shapes in food. Filled with irreverent\nrhymes, these books will give the reader’s\nimagination wings.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727182/size7/e9f3700d2c7912a766ad0f97187465bc.jpg","thumbnailUrl"