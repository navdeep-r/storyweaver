n/illustration_crops/721686/size7/0eaa2e9b2d4d4c465ba2c5e05a6f092c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-132","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-132","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":450,"opdsId":"urn:uuid:SW-58551","title":"Hungry on the Steps","authors":["Nandini Nayar"],"language":"","readingLevel":"","publisher":"","summary":"Pranav is hungry. As he climbs up the steps to his house slowly, many others join the line behind him. Who can make him run up the steps?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/97609/size7/fce4da2bddc71052a69c395326c949bc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/97609/size7/fce4da2bddc71052a69c395326c949bc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-58551","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-58551","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":451,"opdsId":"urn:uuid:SW-363202","title":"Every Minute Counts","authors":["Shabnam  Minwalla"],"language":"","readingLevel":"","publisher":"","summary":"Adil has a full hour to get ready and walk to school. But he is late every day! Where is he losing time? His friend Paro decides to help him account for every minute of the hour.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715159/size7/650ba79042fee11ebd6f09a6ba108f43.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715159/size7/650ba79042fee11ebd6f09a6ba108f43.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-363202","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-363202","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":452,"opdsId":"urn:uuid:SW-16921","title":"The Doll That Bommakka Made","authors":["Praba Ram","Sheela Preuitt"],"language":"","readingLevel":"","publisher":"","summary":"This charming cumulative tale celebrates the tradition of hand-crafted dolls, inspired by the South Indian Thanjavur Thalai Atti Bommai. Starting with a little ball of clay, we see the fine dancing doll grow before our eyes. The rhythmic descriptive words, stacked in a delightfully repetitive way, invite children to chant along. The vibrant illustrations complete the vivid imagery.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/114328/size7/087d139e9e25a4db2e8af7c0435a63bc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/114328/size7/087d139e9e25a4db2e8af7c0435a63bc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-16921","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-16921","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":453,"opdsId":"urn:uuid:SW-28266","title":"How Heavy Is Heavy?","authors":["Sukanya  Sinha"],"language":"kg","readingLevel":"","publisher":"","summary":"A stone is heavier than a feather and lighter than a rock. So is the stone heavy, or is it light? Can we know for sure how heavy (or light) a stone is? Find answers to these and other fascinating questions in this fun book about weight.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/714192/size7/f84b89b4e29caf6ef8a5b8b5e542bf4c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/714192/size7/f84b89b4e29caf6ef8a5b8b5e542bf4c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-28266","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-28266","type":"application/epub+zip",