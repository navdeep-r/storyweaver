storyweaver.org.in/api/v0/story/epub/SW-164902","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":964,"opdsId":"urn:uuid:SW-667922","title":"ಟ್ರಿಣ್ ಟ್ರಿಣ್","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಇಬ್ಬರು ಗೆಳೆಯರು, ಒಂದು ದಾರದ ಫೋನ್ ಮತ್ತು ಒಂದು ಮುಖ್ಯವಾದ ಕರೆ. ಇನ್ನೇಕೆ ತಡ ಫೋನ್ ಮಾಡಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/749958/size7/b1337e5dcdc3fe275a8ec9d23f99324c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/749958/size7/b1337e5dcdc3fe275a8ec9d23f99324c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-667922","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-667922","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":965,"opdsId":"urn:uuid:SW-223231","title":"ಹಳ್ಳದಲ್ಲಿ ಕುರಿಮರಿ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಕುರಿಮರಿಯೊಂದು ಹಳ್ಳದೊಳಕ್ಕೆ ಬಿದ್ದಿರುವುದನ್ನು ನೋಡಿದ ಬೇಲಾ ಸಾಹಸದಿಂದ ಅದನ್ನು ಕಾಪಾಡಿದ ಕತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283380/size7/339a0666e3f6f30961d5f3dea5189159.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283380/size7/339a0666e3f6f30961d5f3dea5189159.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-223231","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-223231","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":966,"opdsId":"urn:uuid:SW-473141","title":"ದಿನಸಿ ಹೋದದ್ದೆಲ್ಲಿ?","authors":["Koravathi Pallavi"],"language":"","readingLevel":"","publisher":"","summary":"ದಿನಸಿಗಳನ್ನು ಡಬ್ಬಿಗೆ ಹಾಕಲು ಆರವ್, ಅಮ್ಮನಿಗೆ ಸಹಾಯ ಮಾಡುತ್ತಿದ್ದಾನೆ. ಮೊಟ್ಟೆಗಳು ಟ್ರೇನಲ್ಲಿ ಹಿಡಿಸುತ್ತವೆಯೇ? ಅಕ್ಕಿಗೆ ಸರಿಯಾದ ಡಬ್ಬಿ ಯಾವುದು? ಅವನು ಒಂದು ಚೀಲದಲ್ಲಿ ಎಷ್ಟು ಕ್ಯಾರೆಟ್ ಹಾಕಬಹುದು? ನಮ್ಮ ದೈನಂದಿನ ಜೀವನದಲ್ಲಿ ಗಣಿತವನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳುವ ಬಗ್ಗೆ ಒಂದು ಕತೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/431545/size7/2b7ae67a0f852dbec9bb594cdd687341.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/431545/size7/2b7ae67a0f852dbec9bb594cdd687341.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-473141","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-473141","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":967,"opdsId":"urn:uuid:SW-594254","title":"ರೋಡೋ, ಮೃಗಾಲಯವೋ?","authors":["Pushpak M"],"language":"","readingLevel":"","publisher":"","summary":"ರಸ್ತೆಯಲ್ಲಿ ರಂಗು ಪುಸ್ತಕದಲ್ಲಿ ಸೋನು, ಮೊನು ಮತ್ತು ರೀನ ಏನೇನೆಲ್ಲ ಕಂಡುಕೊಂಡರು. ಈ ಎರಡನೆ ಪುಸ್ತಕದಲ್ಲಿ, ಮೂವರು ಗೆಳೆಯರು ಆಟಕ್ಕೆಂದು ಹೊರಟಿದ್ದಾರೆ. ಆದರೆ ಪ್ರಾಣಿ ತಂಡವೇ ಅಲ್ಲಿರುವುದು ಅವರಿಗೆ ತಾನೆ ಹೇಗೆ ಗೊತ್ತಾಗಬೇಕು. ನಿಮಗೂ ಆ ಪ್ರಾಣಿಗಳನ್ನು ನೋಡುವ ಆಸೆ ಇದೆಯಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703806/size7/ca4ec79c4a3534baf1250338357fe8ec.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703806/size7/ca4ec79c4a3534baf1250338357fe8ec.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-594254","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-594254","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":968,"opdsId":"urn:uuid:SW-208758","title":"ಇಲಿ-ಬೆಕ್ಕು","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಗಡವ ಬೆಕ್ಕು ಚಿಕ್ಕ ಇಲಿಯ ಹಿಡಿಯ ಹೋಯಿತು. ಅಪಾಯದಿಂದ ಇಲಿ ಹೇಗೆ ಪಾರಾಯಿತು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283809/size7/12e5856b4b4ab06beb92362899c4693d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283809/size7/12e5856b4b4ab06beb92362899c4693d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-208758","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-208758","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":969,"opdsId":"urn:uuid:SW-220375","title":"ಬರ್ಫಿಯ ಬಯಸಿದ ಬೆಕ್ಕು","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂದು ಬೆಕ್ಕಿಗೆ ಬರ್ಫಿ ತಿನ್ನುವ ಆಸೆ ಆಯಿತು. ‌ಅದು ತನ್ನ ಆಸೆಯನ್ನು ಹೇಗೆ ಪೂರೈಸಿಕೊಂಡಿತು ಗೊತ್ತೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283709/size7/2202aa367c482bb86bf943520e25ae9f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283709/size7/2202aa367c482bb86bf943520e25ae9f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-220375","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-220375","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":970,"opdsId":"urn:uuid:SW-474627","title":"ಸರಿಯಾದ ಉಪಕರಣಗಳು","authors":["Bhagyashree Chickerur"],"language":"","readingLevel":"","publisher":"","summary":"ಇಶಾಗಾಗಿ ಮನೆ ಕಟ್ಟುವ ಕೆಲಸ ಈಗಷ್ಟೇ ಶುರುವಾಗಿದೆ. ಅಡಿಪಾಯದಿಂದ ಮನೆ ಕಟ್ಟುವವರೆಗೂ ಯಾವೆಲ್ಲ ಉಪಕರಣಗಳು ಬೇಕಾಗುತ್ತವೆ ಎಂದು ಕಲಿಯಳಿದ್ದಾಳೆ ಇಶಾ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/524492/size7/71c89ef279fc4bf1646113016705e08b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524492/size7/71c89ef279fc4bf1646113016705e08b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-474627","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-474627","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":971,"opdsId":"urn:uuid:SW-586829","title":"ಚೆಂಡು ಎಲ್ಲಿದೆ?","authors":["Pushpak M"],"language":"","readingLevel":"","publisher":"","summary":"ಜಮಿಗೆ ಗೆಳೆಯರೊಂದಿಗೆ ಆಟ ಆಡಬೇಕು. ಆದರೆ, ಚೆಲ್ಲಾಪಿಲ್ಲಿಯಾದ ಅವನ ರೂಮಲ್ಲಿ, ಚೆಂಡು ಅದೆಲ್ಲಿ ಬಿದ್ದಿದೆಯೋ! ಅವನ ಗೆಳೆಯರು ತಾನೆ ಎಷ್ಟು ಹೊತ್ತು ಕಾಯುವರು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/93521/size7/495d9fd5d7c96ad806177b340988f891.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/93521/size7/495d9fd5d7c96ad806177b340988f891.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-586829","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-586829","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":972,"opdsId":"urn:uuid:SW-665650","title":"ಬಾಹ್ಯಾಕಾಶದ ಸಾಂಬಾರ್","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಡ್ರಾಗನ್ ತನ್ನ ಬಾಯಿಂದ ಬೆಂಕಿಯನ್ನು ಉಸಿರಾಡಲು ಕಾರಣವೇನು? ಅದು ಸುಡುಸುಡು ಗ್ರಹದ ಖಾರಖಾರ ಸಾಂಬಾರು ತಿಂದಿದ್ದಕ್ಕೆ ಇರಬಹುದೇ? ಬನ್ನಿ, ನೋಡೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/747545/size7/2436b3c514b2867951c567c7b4787a8d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/747545/size7/2436b3c514b2867951c567c7b4787a8d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-665650","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-665650","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":973,"opdsId":"urn:uuid:SW-110331","title":"ಪೊಂತಶಿಬಾಬೊನ ಮರಗೆಳೆಯ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ನಿಜವಾದ ಗೆಳೆತನದ ಬಗ್ಗೆ ತಿಳಿಸಿಕೊಡುವ ಕಥೆಯಿದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/139822/size7/244572a10673380365651501c4b8d648.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/139822/size7/244572a10673380365651501c4b8d648.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-110331","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-110331","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":974,"opdsId":"urn:uuid:SW-592856","title":"ಸಮುದ್ರ ತೀರದ ವಿಚಿತ್ರ ಸಂಗತಿಗಳು","authors":["Dr Akshata Shanbhag"],"language":"","readingLevel":"","publisher":"","summary":"ಅಜ್ಜನ ಮನೆಯ ಜಗುಲಿಯ ಮೇಲೆ ಕುಳಿತು; ಆಡುತ್ತಿರುವ ಮಾಯಾ ಮತ್ತವಳ ಕಸಿನ್ಸ್‌ಗೆ ಸಮುದ್ರ ತೀರದಲ್ಲಿ ವಿಚಿತ್ರವಾದ ಸಂಗತಿಗಳು ಕಾಣುತ್ತವೆ. ಅವು ಸರಿದಾಡುವ ಸಮುದ್ರ ರಾಕ್ಷಸರೇ? ಅಥವಾ ಮರಳಿನ ಕೋಟೆಯ ಏಡಿಗಳೇ? ಬನ್ನಿ ಏನೂಂತ ನೋಡೋಣ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527481/size7/a72ad091108c6a127e6c7d08133fb3af.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527481/size7/a72ad091108c6a127e6c7d08133fb3af.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-592856","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-592856","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":975,"opdsId":"urn:uuid:SW-162271","title":"ಅಡುಗೆಮನೆಯಲ್ಲಿ ಫಾತಿ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಫಾತಿ ತಾನೆಂತಹ ವೇಗದ ಓಟಗಾರ್ತಿ ಎಂಬುದನ್ನು ಶಾಲೆಯ ಕ್ರೀಡಾ ದಿನಾಚರಣೆಯಂದು ಮತ್ತೊಮ್ಮೆ ಪ್ರದರ್ಶಿಸಿದಳು. ಶಾಲೆಯಿಂದ ಹಿಂದಿರುಗಿದ ಅವಳು ಅಡುಗೆ ಮನೆಯಲ್ಲಿ ಅಮ್ಮನಿಗೆ ಓಕ್ರೊ ಸೂಪು ತಯಾರಿಸಲು ಸಹಾಯ ಮಾಡಿದಳು.  ಸೂಪು ಘಮಗುಟ್ಟಿತು. ಫಾತಿ ಚಪಲಚಿತ್ತಳಾದಳು! ಉತ್ತರ ಘಾನಾದೇಶದಲ್ಲಿ ಬೆಳೆವ ಹುಡುಗಿಯೊಬ್ಬಳ  ದಿನಚರಿಯನ್ನಾಧರಿಸಿದ ಕತೆ ʻಅಡುಗೆಮನೆಯಲ್ಲಿ ಫಾತಿʼ","coverUrl":"https://static.storyweaver.org.in/illustration_crops/101361/size7/65a19ebf8ebc1992566927780b60359d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/101361/size7/65a19ebf8ebc1992566927780b60359d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-162271","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-162271","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":976,"opdsId":"urn:uuid:SW-214544","title":"ನಾಗು ಮತ್ತು ನೂನು","authors":["Shabana Begum"],"language":"","readingLevel":"","publisher":"","summary":"ಗಣಿತದ ಪ್ರಶ್ನೆಗಳು ನಾಗು ಮತ್ತು ನೂನುಗೆ ಕಷ್ಟವಾಯಿತು. ಆದ್ದರಿಂದ ಇಬ್ಬರು ಶಾಲೆಗೆ ಹೋಗಲು ಇಷ್ಟಪಡುತ್ತಿರಲಿಲ್ಲ. ಇವರ ಈ ಕಷ್ಟ ಸುಲಭವಾಗುತ್ತಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/282985/size7/2c3bec142fb7cdf52d4911e6d4522ef7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/282985/size7/2c3bec142fb7cdf52d4911e6d4522ef7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-214544","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-214544","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":977,"opdsId":"urn:uuid:SW-651745","title":"ಅದೇ ಆಕಾಶದ ಕೆಳಗೆ ಅದೇ ಕನಸು","authors":["S Diwakar"],"language":"","readingLevel":"","publisher":"","summary":"ಅಮನ್‌ಳ ಊರು ಪರ್ವತ. ಅಲ್ಲಿ ಕೆಲವೊಮ್ಮೆ ಯುದ್ಧವಾದರೆ ಇನ್ನು ಕೆಲವೊಮ್ಮೆ ಶಾಂತಿ. ಒಂದು ಯುದ್ಧವಾದ ಮೇಲೆ ಅಮನ್‌ಳನ್ನು ಬಾದಲ್ ಸುರಕ್ಷಿತ ಸ್ಥಳಕ್ಕೆ ಕರೆದೊಯ್ಯುತ್ತಾನೆ. ಶಾಂತಿಗೆ ಏನೇನು ಅರ್ಥವಿರಬಹುದೆಂದು ಕಂಡುಕೊಳ್ಳುವುದಕ್ಕಾಗಿ ಇಬ್ಬರೂ ಒಂದು ಪ್ರಯಾಣ ಹೊರಡುತ್ತಾರೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/724688/size7/cc984cfc6a7ca8b1ebe24a5711f3e3ed.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/724688/size7/cc984cfc6a7ca8b1ebe24a5711f3e3ed.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-651745","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-651745","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":978,"opdsId":"urn:uuid:SW-592530","title":"ಬಿರುಗಾಳಿಯಲ್ಲಿ ಸಿಕ್ಕಿಬಿದ್ದ ಪಿಶಿ","authors":["Sarita Sharan"],"language":"","readingLevel":"","publisher":"","summary":"ಪಿಶಿ ಒಂದು ದೊಡ್ಡ ಮಾಂಟಾ ರೇ ಮೀನು. ಒಮ್ಮೆ ಹಿಂದೂ ಮಹಾಸಾಗರದಲ್ಲಿ ಪಿಶಿ ದೊಡ್ಡ ಚಂಡಮಾರುತಕ್ಕೆ ಸಿಲುಕಿತು. ಆಗ ಅದಕ್ಕೆ ಸಹಾಯ ಮಾಡಿದವರು ಯಾರು ಗೊತ್ತಾ? ಆ ದಿನ ಏನಾಯಿತು ಎಂದು ತಿಳಿಯಲು ನೀವು ಬಯಸುವಿರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722387/size7/073d9b1811b5dd45c355c678228d68cc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722387/size7/073d9b1811b5dd45c355c678228d68cc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-592530","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-592530","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":979,"opdsId":"urn:uuid:SW-652553","title":"ಚಂದ್ರನ  ತುಂಬಾ ಇರುವೆ","authors":["Cp Ravikumar"],"language":"","readingLevel":"","publisher":"","summary":"ಏಳು ಬೂಟು ತೊಟ್ಟ ಸರೋವರ, ಒಂದು ಬಟ್ಟಲಿನ ತುಂಬಾ ಶಿಶಿರ, ಕೊಂಬಿನ ಕುದುರೆಯ ದಂತಪಂಕ್ತಿ! ಮೋಜಿನ ಜಗತ್ತಲ್ಲವೇ ಇದು? ಏನಂತೀ -ಎಲ್ಲಾ ಆದಂತಿದೆ ತಲೆಕೆಳಗೆ! ತಡವೇಕೆ? ಬಾ ಹೋಗೋಣ, ಒಳಗೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/744441/size7/7f372143b81d5b02a005273eb2128680.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/744441/size7/7f372143b81d5b02a005273eb2128680.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-652553","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-652553","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":980,"opdsId":"urn:uuid:SW-630408","title":"ಓ... ನನ್ನ ಬ್ಯಾಟ್ ಎಲ್ಲಿ?","authors":["Ishwar Daitota"],"language":"","readingLevel":"","publisher":"","summary":"ಆಗೊಮ್ಮೆ ಈಗೊಮ್ಮೆ ಮಕ್ಕಳು ತಮ್ಮಷ್ಟಕ್ಕೆ ಮಾತಾಡೋದು ಹಾಗು ಅನುಭವವೊಂದನ್ನು ವಿವರಿಸುವುದು ಕೇಳಿ ಬರುತ್ತದೆ. ಅವರು ವರ್ಣಿಸುವುದು ಎಷ್ಟು ವೈವಿಧ್ಯಪೂರ್ಣ! ನನ್ನ ಬ್ಯಾಟ್ ಎಲ್ಲಿದೆ ಎನ್ನುವುದು ಅಂತಹುದೊಂದು ಕುತೂಹಲಕಾರಿ ಘಟನೆಯಾಗಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722292/size7/89ebac7c365c6659764d6bf443b07ac9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722292/size7/89ebac7c365c6659764d6bf443b07ac9.jpg","acquisitions":[{"href":"