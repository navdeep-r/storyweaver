stration_crops/700894/size7/0b3a679b1d24e2b4e223307bff56b880.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/700894/size7/0b3a679b1d24e2b4e223307bff56b880.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-1039","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-1039","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":425,"opdsId":"urn:uuid:SW-530","title":"मसाला चहा","authors":["Sucheta Kadethankar"],"language":"","readingLevel":"","publisher":"","summary":"जंगलातल्या त्या अद्भुत विचित्ररूप ठिकाणाविषयी बुलबुलीनं खूप ऐकलं होतं. लोक त्याविषयी सतत बोलत, पण तिथे गेलं मात्र कुणीच नव्हतं. तिथे जाताना, बुलबुलीच्या सोबतीला होता फक्त तोताराम. तिच्या आयुष्यातलं ते सर्वात मोठं साहस ठरणार का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/720907/size7/a1d4cbb9fca226b83fe34cb0077dbe59.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/720907/size7/a1d4cbb9fca226b83fe34cb0077dbe59.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-530","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-530","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":426,"opdsId":"urn:uuid:SW-95635","title":"तूच आहेस का सुतार पक्षी?","authors":["Mrinalinee  Vanarase"],"language":"","readingLevel":"","publisher":"","summary":"अरेरे! किल्ली आणि किल्लन ही पोपटांची जोडी बेघर झालीये. झाडाच्या खोडात घरट्यासाठी बीळ करून देईल अशा सुतार पक्ष्याच्या शोधात ते दोघे निघालेत. त्यांना कितीतरी वेगवेगळी घरटी दिसताहेत. पण त्यांना मनाजोगतं नवं घर बांधून मिळेल का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726997/size7/39aa7999b25b35f60ec02919fb3a4b79.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726997/size7/39aa7999b25b35f60ec02919fb3a4b79.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-95635","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-95635","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":427,"opdsId":"urn:uuid:SW-1111","title":"आम्ही सारे प्राणी","authors":["Madhav Chavan","Meera Tendolkar"],"language":"","readingLevel":"","publisher":"","summary":"आम्ही सारे प्राणी म्हणजे प्राण्यांची सहज करून दिलेली ओळख होय.  \nगोष्टीतील मुख्य पात्र सर्वच मुलांचे प्रतीक आहे.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722264/size7/dea133672cf8f0bfe601479dc135e764.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722264/size7/dea133672cf8f0bfe601479dc135e764.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-1111","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-1111","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":428,"opdsId":"urn:uuid:SW-12271","title":"खाऊ कशी? मटामटा!! पोटासाठी मस्त गोष्टी","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"आपण खातो म्हणून आपण जगतो. परंतु काय खायचं आणि कसं खायचं हे आपल्याला ठाऊक असतं का? आपले पोटोबा खूश राहावेत म्हणून विचारांसाठी हे थोडं खाद्य!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722846/size7/238d8c9a8b5ce51478ca8709ab812085.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722846/size7/238d8c9a8b5ce51478ca8709ab812085.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12271","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12271","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":429,"opdsId":"urn:uuid:SW-125660","title":"प्रणव-आकृतिबंध टिप