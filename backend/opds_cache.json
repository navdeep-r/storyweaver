ize7/f6b5a4048ee646dd2c32af6ac5e66e23.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722240/size7/f6b5a4048ee646dd2c32af6ac5e66e23.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-16","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-16","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":613,"opdsId":"urn:uuid:SW-22302","title":"Squirrel Goes to School","authors":["Alisha Berger"],"language":"","readingLevel":"","publisher":"","summary":"Trang lives in a mountaintop village with her friend Squirrel. One day, she asks Squirrel to come to school. But school sounds like no fun. And school is so far away. Will Squirrel be brave for his best friend?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/119964/size7/3103ddb647070d37eccd9a8555696161.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/119964/size7/3103ddb647070d37eccd9a8555696161.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-22302","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-22302","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":614,"opdsId":"urn:uuid:SW-63140","title":"We Love Our Home","authors":["Karthika G"],"language":"","readingLevel":"","publisher":"","summary":"Look high and low and you will find animals and birds making their homes around you. Here’s a story about the habitats they live in.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527543/size7/b7fb5ea8fe68a362a90b6a22b064780d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527543/size7/b7fb5ea8fe68a362a90b6a22b064780d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-63140","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-63140","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":615,"opdsId":"urn:uuid:SW-237100","title":"Cooking","authors":["Clare Verbeek","Thembani  Dladla","Zanele Buthelezi"],"language":"","readingLevel":"","publisher":"","summary":"I am helping to prepare vegetables for a meal. There is one vegetable I don't like preparing.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/337764/size7/aeca1ac31486525d1175d2a35e733b23.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/337764/size7/aeca1ac31486525d1175d2a35e733b23.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-237100","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-237100","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":616,"opdsId":"urn:uuid:SW-113896","title":"Sharanya Speaks to Robots","authors":["Tanvi Bhat"],"language":"","readingLevel":"","publisher":"","summary":"The new student in school won’t talk to Sharanya, no matter how hard she tries. Why doesn’t he understand her? Can Sharanya find a way to talk to him?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/720046/size7/61f7713e7da97aaeaba6086bf69eca76.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/720046/size7/61f7713e7da97aaeaba6086bf69eca76.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-113896","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-113896","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":617,"opdsId":"urn:uuid:SW-12513","title":"The Dance of  the Flamingo","authors":["Anita Mani"],"language":"","readingLevel":"","publisher":"","summary":"Living like lotus flowers on water, the sight of pink flamingos is one of the most beautiful sights of the natural world. Why are they pink? Do they put on make-up? Do they have even a single bone in their long neck? Here is a book of photographs that answers all the questions about these graceful birds.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/35241/size7/754e9eccdfecc87ccbcee58026ff636e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/35241/size7/754e9eccdfecc87ccbcee58026ff636e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12513","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12513","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":618,"opdsId":"urn:uuid:SW-261640","title":"My Red T-shirt","authors":["Rohini Nilekani"],"language":"","readingLevel":"","publisher":"","summary":"Aman loves his red T-shirt, because it is so bright and so soft. His Ma hates it, because it is old and has holes in it. She wants to throw it away. He wants to keep it. What is Aman going to do?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/719500/size7/7a8e3961bad059f312c0aae8026e38ea.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/719500/size7/7a8e3961bad059f312c0aae8026e38ea.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-261640","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-261640","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":619,"opdsId":"urn:uuid:SW-188","title":"Sister, Sister, Why don't things fall up?","authors":["Roopa Pai"],"language":"","readingLevel":"","publisher":"","summary":"Little Brother's inquisitive mind is always full of questions for Big Sister. He knows Big Sister has all the answers, because she is always reading one big fat book or another. 