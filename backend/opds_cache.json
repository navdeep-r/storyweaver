/static.storyweaver.org.in/illustration_crops/139852/size7/cc857b88c9f9aeb63dcfdb0a58196033.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/139852/size7/cc857b88c9f9aeb63dcfdb0a58196033.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-94094","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-94094","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":789,"opdsId":"urn:uuid:SW-94218","title":"Four Lambs and a Fox","authors":["Angesom  Abadi"],"language":"","readingLevel":"","publisher":"","summary":"One should be careful telling others a secret.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/138498/size7/ccc984907878eef5fc285c69c38e8fa4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/138498/size7/ccc984907878eef5fc285c69c38e8fa4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-94218","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-94218","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":790,"opdsId":"urn:uuid:SW-213349","title":"Who Am I?","authors":["Nancy Siddhant Dogra"],"language":"","readingLevel":"","publisher":"","summary":"An animal who has a pocket on its stomach and can jump really far! Can you guess its name?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283184/size7/c8dc580322ba6c1d13d94c78f05f8b06.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283184/size7/c8dc580322ba6c1d13d94c78f05f8b06.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-213349","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-213349","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":791,"opdsId":"urn:uuid:SW-173119","title":"I like to read","authors":["Letta Machoga"],"language":"","readingLevel":"","publisher":"","summary":"A story about reading.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/235022/size7/9f0ef652482649f3a62111cac60a16f6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/235022/size7/9f0ef652482649f3a62111cac60a16f6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-173119","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-173119","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":792,"opdsId":"urn:uuid:SW-158121","title":"My Elder Brother","authors":["Madhu B. Joshi"],"language":"","readingLevel":"","publisher":"","summary":"The elder brother is found with books and formulas. The younger brother is found with butterflies and lost kites. The elder brother keeps studying everyday and barely does anything else. The younger brother plays in gardens and enjoys doing what he likes. The elder brother takes every chance to criticize his younger brother for not studying. The younger brother still keeps playing outdoors. What follows is a timeless tale of following one's own heart despite those that only ridicule and demotivate.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/526077/size7/eeb09f48b43bd15afb126b9d2f8cef28.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/526077/size7/eeb09f48b43bd15afb126b9d2f8cef28.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-158121","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-158121","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":793,"opdsId":"urn:uuid:SW-163725","title":"Polygon Family","authors":["African Storybook Initiative","Lindiwe Tshabalala"],"language":"","readingLevel":"","publisher":"","summary":"The family of Polygons come together in an attempt to know each other! Do you want to know them?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/228290/size7/e4e6314995480cca3523d0fff4f0b051.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/228290/size7/e4e6314995480cca3523d0fff4f0b051.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-163725","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-163725","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":794,"opdsId":"urn:uuid:SW-444501","title":"The Lonely Whale Shark","authors":["Mahira Kakajiwala"],"language":"","readingLevel":"","publisher":"","summary":"A big little whale shark is sad and lonely on his reef. But when he meets a group of whale sharks,\nhe realises all he needs to do is look around him.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527540/size7/253f6a3fc66f50591bb0b261fdf07953.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527540/size7/253f6a3fc66f50591bb0b261fdf07953.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-444501","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-444501","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":795,"opdsId":"urn:uuid:SW-173","title":"The Jungle School","authors":["Madhav Chavan","Meera Tendolkar"],"language":"","readingLevel":"","publisher":"","summary":"The animals in the jungle rush to the new school with great enthusiasm. What do you think happened after that?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/701000/size7/449224bf6cf24a86087b052fd6327570.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/701000/size7/449224bf6cf24a86087b052fd6327570.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-173","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-173","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":796,"opdsId":"urn:uuid:SW-444499","title":"A Bunch of Flowers","authors":["Liwliwa Malabed"],"language":"","readingLevel":"","publisher":"","summary":"What is happening to Peri’s mother? His mother is always sleeping, her room is always dark like a thick forest of tall trees. In this wordless book for early readers, Peri thinks of ways to bring the outdoors and sunshine back into their home and into his mother’s eyes.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527510/size7/34996dcb4ae6d0731bb0d88630443cec.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527510/size7/34996dcb4ae6d0731bb0d88630443cec.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-444499","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-444499","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":797,"opdsId":"urn:uuid:SW-373315","title":"The Right Tools","authors":["C G Salamander"],"language":"","readingLevel":"","publisher":"","summary":"Isha’s house is being built from scratch by a lot of people. Join her as she discovers all the tools they use to build it.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/524492/size7/71c89ef279fc4bf1646113016705e08b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524492/size7/71c89ef279fc4bf1646113016705e08b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-373315","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-373315","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":798,"opdsId":"urn:uuid:SW-26021","title":"Where Do My Thoughts Go?","authors":["Sherein Bansal"],"language":"","readingLevel":"","publisher":"","summary":"A girl is thinking about her thoughts! What do they do all day? Where do they go? Have you seen them anywhere?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/276432/size7/d9be1b71882531b5e4b2ebd28f8c9ef6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/276432/size7/d9be1b71882531b5e4b2ebd28f8c9ef6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-26021","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-26021","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":799,"opdsId":"urn:uuid:SW-213159","title":"The Blue Fruit","authors":["Kaminee Singh"],"language":"","readingLevel":"","publisher":"","summary":"Kasnee was surprised to see a blue fruit on a tree and ran to her mother...read more to find out what happens next!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283721/size7/fd214d8d30a37a6d012502a29ea9a738.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283721/size7/fd214d8d30a37a6d012502a29ea9a738.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-213159","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-213159","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":800,"opdsId":"urn:uuid:SW-94122","title":"Are You the Woodpecker?","authors":["Suhel Quader"],"language":"","readingLevel":"","publisher":"","summary":"Oh no! Killi and Killan the parakeets have lost their home. They set out in search of the woodpecker who can make them a tree hole nest. The birds discover many other nests, but will they find a new home?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726997/size7/39aa7999b25b35f60ec02919fb3a4b79.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726997/size7/39aa7999b25b35f60ec02919fb3a4b79.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-94122","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-94122","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":801,"opdsId":"urn:uuid:SW-10031","title":"Mumtaz Embroiders Her Dreams","authors":["Jolly  Rohatgi"],"language":"","readingLevel":"","publisher":"","summary":"Young Mumtaz has come from her village to Lucknow to learn new stitches for the chikankari that she and the other women in her village do. Thanks to her friend Munnu, Mumtaz learns even more than she had imagined!  Jolly Rohtagi’s sensitive story is illustrated by Ram Soni through sanjhi, the art of paper cutting.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/118163/size7/cb7cdd8d49e3e690fae53b5375f67eb7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/118163/size7/cb7cdd8d49e3e690fae53b5375f67eb7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-10031","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-10031","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":802,"opdsId":"urn:uuid:SW-16146","title":"We call her Ba - A Biography of Kasturba Gandhi","authors":["Subhadra Sen Gupta"],"language":"","readingLevel":"","publisher":"","summary":"Kasturba Gandhi was no ordinary woman. She had a strong identity, courage and tremendous willpower and she sacrificed a lot for her country. She was a friend and trusted companion of the Father of the Nation, Mahatma Gandhi. Gandhiji’s biographer, Louis Fischer wrote about her, “Being herself and being at the same time a shadow of the Mahatma made her a remarkable woman.”\nRead about this amazing woman who walked shoulder to shoulder with one of the most prominent leaders of the world during the most turbulent times of this peninsula.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/43053/size7/b8e88a3967820974f51cc878f316d3ed.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/43053/size7/b8e88a3967820974f51cc878f316d3ed.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-16146","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-16146","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":803,"opdsId":"urn:uuid:SW-470","title":"Naughty or Not (Tell me now series)","authors":["Madhav Chavan"],"language":"","readingLevel":"","publisher":"","summary":"Often, an inquisitive child asks his parents an endless set of questions. The 'Tell me ... now!' Series describes how interesting the questions and answers turn out. This one is about behaviour.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/700475/size7/87fc5b8f1397a63daae7e68a63dae475.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/700475/size7/87fc5b8f1397a63daae7e68a63dae475.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-470","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-470","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":804,"opdsId":"urn:uuid:SW-214558","title":"A Scary Pit","authors":["Zubin Miller"],"language":"","readingLevel":"","publisher":"","summary":"Samira loves to cycle! But suddenly she stops when she hears a goat bleating…","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283380/size7/339a0666e3f6f30961d5f3dea5189159.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283380/size7/339a0666e3f6f30961d5f3dea5189159.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-214558","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-214558","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":805,"opdsId":"urn:uuid:SW-112695","title":"The Amazing Adventure","authors":["Kim Ann Arun"],"language":"","readingLevel":"","publisher":"","summary":"Tito and Rika fight over a mobile phone when, by accidentally pressing a button, they summon a UFO. An alien appears at the door and asks them to come aboard. Accompanied by a puppy and firefly, they go on a grand adventure in the spaceship. But next morning they wonder… Was it all a dream?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/198771/size7/527817e40ccb3a942cde879c554bd00c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/198771/size7/527817e40ccb3a942cde879c554bd00c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-112695","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-112695","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":806,"opdsId":"urn:uuid:SW-259305","title":"The Secrets of Rocks","authors":["Suchi Govindarajan"],"language":"","readingLevel":"","publisher":"","summary":"Rocks are everywhere — under the ground,\nabove the ground, and even at the bottom of\nour oceans. But where do rocks come from?\nWhat are they made of? If rocks could talk,\nthey would share many secrets.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716006/size7/2a7fc11e509d305c2c43159bbedf1d55.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716006/size7/2a7fc11e509d305c2c43159bbedf1d55.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-259305","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-259305","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":807,"opdsId":"urn:uuid:SW-749","title":"The Sparrow and The Fruit","authors":["Divaspathy Hegde"],"language":"","readingLevel":"","publisher":"","summary":"When her plump juicy guava falls into a clump of thorns, Gubbi uses every trick she knows, and gets the fruit back. But is it right to use mean tricks to get what you want? Find out by reading this book!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722315/size7/b686eaaf5b0e52c1db3be9ef3e06a678.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722315/size7/b686eaaf5b0e52c1db3be9ef3e06a678.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-749","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-749","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":808,"opdsId":"urn:uuid:SW-59413","title":"Nima's First Day of School","authors":["Alisha Berger"],"language":"","readingLevel":"","publisher":"","summary":"It's her first day of school. Nima gets new shoes, a new bag, and a new pen, but she still does not feel happy. What could help Nima feel happy again?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/130494/size7/56ad2631e826dfabd555b27e73f84b3e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/130494/size7/56ad2631e826dfabd555b27e73f84b3e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-59413","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-59413","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":809,"opdsId":"urn:uuid:SW-638","title":"Kallu's World 1 - In Big Trouble Again!","authors":["Subhadra Sen Gupta"],"language":"","readingLevel":"","publisher":"","summary":"Kallu is late for school again. Where did he make his goat run away this time? Or who was sick? He needs to find a story badly... a convincing one. Welcome to Khajuria - a village where young Kallu and his gang run delightful adventurous riots almost everyday. Sometimes they question village traditions, defy bullies or just go about their daily business, but Kallu and his gang are up for anything. Join them as they grow wiser and wittier, as they happily roam the village finding new things to do, and see what they come up with!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703474/size7/aebdec85f3efee3cc067e575ca2d0d42.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703474/size7/aebdec85f3efee3cc067e575ca2d0d42.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-638","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-638","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":810,"opdsId":"urn:uuid:SW-37244","title":"Socks","authors":["Shannon David"],"language":"","readingLevel":"","publisher":"","summary":"Anu loves socks and uses her imagination to find many uses for them.  Anu's mother asks if she can use some of Anu's old socks to make a mop. Do you think Anu will be able to part with her cherished socks?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/93880/size7/a0d0c3a2febe0622d11276e73468247a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/93880/size7/a0d0c3a2febe0622d11276e73468247a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-37244","type":"application/pdf+zip","rel"