://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-63719","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":714,"opdsId":"urn:uuid:SW-97850","title":"Tumi a peur","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"« Et s'il y a un monstre sous mon lit ? » Tumi a peur. Sa maman essaie de lui faire comprendre que tout va bien.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527548/size7/0bacccee2370b502d39470570de6f7ef.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527548/size7/0bacccee2370b502d39470570de6f7ef.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-97850","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-97850","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":715,"opdsId":"urn:uuid:SW-382319","title":"C'est quoi, le thé ?","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Abha se rend dans la région de Darjeeling, en Inde. En route, elle visite une fabrique de thé. Le thé est-il une feuille ? Où pousse-t-il ? Comment le récolte-t-on ? Pourquoi a-t-il si bon goût ? Découvre toutes les réponses à ces questions en compagnie d’Abha.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/422097/size7/b064c2ac77aba307892edb71ceb40ca9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/422097/size7/b064c2ac77aba307892edb71ceb40ca9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-382319","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-382319","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":716,"opdsId":"urn:uuid:SW-62014","title":"Trop petit ou trop grand ? Faudrait savoir !","authors":["