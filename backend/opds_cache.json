://storyweaver.org.in/api/v0/story/pdf/SW-582867","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-582867","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":689,"opdsId":"urn:uuid:SW-125063","title":"इंटरनेट जाल में फँसा कुणाल","authors":["Suman Bajpai"],"language":"IP","readingLevel":"","publisher":"","summary":"कुणाल इंटरनेट में खो जाता है और उसे समझ नहीं आता कि वह उसमें से कैसे निकले। इंटरनेट के माध्यम से अपने घर वापस जाने का रास्ता ढूँढ़ने के दौरान, इस वैज्ञानिक-कहानी की यात्रा में आप भी उसके साथ शामिल हो जाइये।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/181775/size7/f1f3e98219874cda59f16f00331eea98.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/181775/size7/f1f3e98219874cda59f16f00331eea98.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-125063","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-125063","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":690,"opdsId":"urn:uuid:SW-60820","title":"हम उन्हें बा कहते हैं","authors":["Madhu B. Joshi"],"language":"","readingLevel":"","publisher":"","summary":"कस्तूरबा कोई साधारण महिला नहीं थीं। उनमें साहस कूट-कूट कर भरा हुआ था, उनकी अपनी विशेष पहचान थी और उनके दृढ़ संकल्प के आगे किसी की नहीं चलती थी। उन्होंने देश के लिए बहुत कुछ किया था। वे राष्ट्रपिता महात्मा गाँधी की विश्वासपात्र मित्र व संगिनी थीं। बापू की जीवनी लिखने वाले लुई फ़िशर ने बा के विषय में लिखा है, “स्वयं की पहचान बनाये रखते हुए महात्मा गाँधी की छाया बन जाना उन्हें एक उल्लेखनीय महिला बना देता है।”\nइस अद्भुत महिला के बारे में पढ़िए जिन्होंने भारतीय उपमहाद्वीप के सबसे कठिन समय में दुनिया के प्रमुख नेताओं के साथ कंधे से कंधा मिलाकर काम किया।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/43053/size7/b8e88a3967820974f51cc878f316d3ed.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/43053/size7/b8e88a3967820974f51cc878f316d3ed.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-60820","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-60820","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":691,"opdsId":"urn:uuid:SW-363276","title":"किसे मिली बकरी?","authors":["Nirmala Shukla"],"language":"","readingLevel":"","publisher":"","summary":"चिन्नासुर और चीकासुर को भटकती हुई एक बकरी मिली। दोनों की नज़र उस बकरी पर है। लेकिन सवाल यह उठता है कि बकरी मिले किसे? तो इसके लिए तय किया गया कि जो ज़्यादा मसाला छाछ पिएगा, वही उस बकरी का मालिक होगा। आइए, असुरों के साथ मसाला छाछ पीते-पीते दशमलव और भिन्न सीखें।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/477081/size7/dc85ca43c5000a1f7a9917528c6ca133.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/477081/size7/dc85ca43c5000a1f7a9917528c6ca133.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-363276","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-363276","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":692,"opdsId":"urn:uuid:SW-38894","title":"बिन आहट सुने पिप्पू","authors":["Deepa Tripathi"],"language":"","readingLevel":"","publisher":"","summary":"पिप्पू को मच्छर खाना बहुत भाता है। कभी कभी उसके दोस्तों में यह होड़ लगती है कि कौन सबसे ज़्यादा मच्छर खा पायेगा! आखिर उसके जैसे चिमगादडों के लिए कीट-पतंगे पकड़ना इतना आसान कैसे होता है? डॉक्टर इला कहती हैं कि प्रतिध्वनि की सहायता से वे आसानी से ऐसा कर पाते हैं। वे नन्हे पिप्पू को बता रही हैं इसके बारे में, आईये हम भी सुनें।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716375/size7/0bb000dc2ee9314a7c7f07e30040eb94.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716375/size7/0bb000dc2ee9314a7c7f07e30040eb94.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-38894","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-38894","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":693,"opdsId":"urn:uuid:SW-66241","title":"आकार और लिनिओ के कारनामे","authors":["Nirmala Shukla"],"language":"","readingLevel":"","publisher":"","summary":"आकार एक खड़ी रेखा है। लिनिओ एक आड़ी रेखा है। दोनों मित्र अपने दूसरे रेखा दोस्तों के साथ खेलने के लिए जाते हैं। क्या आप सोच सकते हैं कि फिर क्या हुआ होगा?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715539/size7/cf9d88b7013979cf37ea1f9bb0c93c9c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715539/size7/cf9d88b7013979cf37ea1f9bb0c93c9c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-66241","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-66241","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":694,"opdsId":"urn:uuid:SW-209757","title":"ईदगाह","authors":["Munshi Premchand"],"language":"","readingLevel":"","publisher":"","summary":"रमजान के पूरे तीस रोजों के बाद ईद आयी है।ईद की चमक, ईदगाह जाने की उमंग और सज़दे में झुकते सर, ईद सिर्फ़ एक त्योहार नहीं है, हामिद सहित सभी बच्चों के लिए यह ख़ुशियों का सबब है।  ये बच्चे दुनिया और समाज को अपने दृष्टिकोण से देखना और आलोचना करना जानते हैं।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/526246/size7/daa865a087d0cb3eb495be407769cfe1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/526246/size7/daa865a087d0cb3eb495be407769cfe1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-209757","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-209757","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":695,"opdsId":"urn:uuid:SW-373429","title":"खज़ाने से भरा सन्दूक","authors":["Pooja Bahanwal"],"language":"","readingLevel":"","publisher":"","summary":"रोहन को 13 कंचे चाहिए जो उसकी बहन सीमा के पास हैं, वह उससे उन्हें माँगता है। बदले में वह उसे बीज, गुब्बारे, पत्थर और मोती देने को तैयार है। आइए, पता लगाते हैं, बदले में सीमा को उसने कितनी चीज़ें दीं।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/457869/size7/6bdf4bfe173ece72ab110a4396075c04.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/457869/size7/6bdf4bfe173ece72ab110a4396075c04.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-373429","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-373429","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":696,"opdsId":"urn:uuid:SW-361132","title":"चबाना, गटकना... डकारना!","authors":["M. A. Sameer"],"language":"","readingLevel":"","publisher":"","summary":"व्हेल अपना भोजन पूरा-का-पूरा निगलती हैं, जबकि मधुमक्खियों के दो पेट होते हैं। गाएँ बाद में पचाने के लिए, अपने पेट में भोजन निगलती हैं। जानवरों के निगलने और पचाने के नए तरीकों के बारे में है यह पुस्तक।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727376/size7/3d4f684cfee22f2af3e72cdcbff79b42.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727376/size7/3d4f684cfee22f2af3e72cdcbff79b42.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-361132","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-361132","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":697,"opdsId":"urn:uuid:SW-29824","title":"एक छोटा बीज : वंगारी मथाई की कहानी","authors":["Shiv Pratap Pal"],"language":"","