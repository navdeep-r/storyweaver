aver.org.in/illustration_crops/704668/size7/0ee6cdb1e849d174ef05ae395bfb14f7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/704668/size7/0ee6cdb1e849d174ef05ae395bfb14f7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-278","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-278","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":518,"opdsId":"urn:uuid:SW-38903","title":"टोमॅटोची चटणी कुणी केली?","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"तारा आणि रवी फळं आणि भाज्या आणायला बाजारात जातात खरं, पण प्रत्येक वेळी एक फळ चिरडलं जातं.\nया गोष्टीमध्ये वस्तू वेगवेगळ्या ठेवायची योग्य पद्धत जड आणि हलक्या वस्तूंच्या मार्फत शिकवली आहे. या पुस्तकातील चित्रं रीतली वर्तमानपत्रं, जुनी मासिकं आणि कागदी पिशव्या यांच्यापासून बनवलेली आहेत, गादीखाली ठेवून चुरगळलेली वर्तमानपत्रं किंवा मासिकांपासून नव्हेत हं.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717010/size7/0bef1395055c740659b27b823aeea0ac.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717010/size7/0bef1395055c740659b27b823aeea0ac.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-38903","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-38903","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":519,"opdsId":"urn:uuid:SW-30061","title":"सांगा पाहू मी कुठे?","authors":["Mrinalinee  Vanarase"],"language":"","readingLevel":"","publisher":"","summary":"साप, बेडूक, किडे, पक्षी आपापल्या भोवतालाशी इतके एकरूप होतात की, ते त्यात दिसेनासेच होतात. प्राण्यांचं एकरूप होण्याचं कसब उलगडून दाखवणारं हे पुस्तक मात्र लक्ष वेधून घेणारं आहे! बघू या तर मग...","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117402/size7/5d94c729c7722f47fe24fe55039e5998.jpg","thumb