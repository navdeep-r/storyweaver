ng for the last 40 years.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/674076/size7/bd639ecc34bcfc59ac0f39900fe565bd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/674076/size7/bd639ecc34bcfc59ac0f39900fe565bd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-121978","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-121978","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":492,"opdsId":"urn:uuid:SW-42296","title":"The Snail's Wonderful Journey","authors":["Alisha Berger"],"language":"","readingLevel":"","publisher":"","summary":"Cheta the Snail wants to take a bus journey. He tries many times to catch the bus, but it is not as easy as he hoped! Will his dream ever come true?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/130022/size7/c50f0b9f4afeefb84e390e9cfc404ddd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/130022/size7/c50f0b9f4afeefb84e390e9cfc404ddd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-42296","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-42296","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":493,"opdsId":"urn:uuid:SW-9933","title":"Hugs in the City","authors":["Milly  Brouard"],"language":"","readingLevel":"","publisher":"","summary":"This is Jilly. Today, she hugged most of the cats in town!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/29567/size7/3b99c56a34d0cfcfc37440bdd0610dd7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/29567/size7/3b99c56a34d0cfcfc37440bdd0610dd7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-9933","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"http