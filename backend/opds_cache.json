ub/SW-54065","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":648,"opdsId":"urn:uuid:SW-149767","title":"The Lazy Ant","authors":["Cebo Solombela"],"language":"","readingLevel":"","publisher":"","summary":"Lazy ant is very lazy. He lets the other\nants do all the work. Will he ever stop\nbeing lazy?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/207463/size7/a0a2f34be8fbefce356292c656b17b5f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/207463/size7/a0a2f34be8fbefce356292c656b17b5f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-149767","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-149767","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":649,"opdsId":"urn:uuid:SW-4938","title":"Where Did Your Dimples Go?","authors":["Radha HS"],"language":"","readingLevel":"","publisher":"","summary":"Langlen has curly hair like Appa and a cleft chin like Imma. It makes her wonder why brothers and sisters, or parents and children look alike. Is she just a collection of traits, then? So many questions, but Imma and Appa have all the answers.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712511/size7/6dcbcdeebd95d1825f334cd0ef963c21.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712511/size7/6dcbcdeebd95d1825f334cd0ef963c21.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-4938","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-4938","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":650,"opdsId":"urn:uuid:SW-209","title":"The Timid Train","authors":["Bharati Jagannathan"],"language":"","readingLevel":"","publisher":"","summary":"Loco, the new train felt rather scared of going anywhere. But e