.in/api/v0/story/pdf/SW-71915","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-71915","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":309,"opdsId":"urn:uuid:SW-64970","title":"Madame Lapin devient cheffe cuisinière","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Madame Lapin a en assez de manger des carottes crues matin, midi et soir. Elle veut apprendre à cuisiner pour en faire un plat délicieux.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/105036/size7/18f8fd4a121fc54acd71d658d4013da8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/105036/size7/18f8fd4a121fc54acd71d658d4013da8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-64970","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-64970","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":310,"opdsId":"urn:uuid:SW-100570","title":"Piggy, la petite tirelire","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Piggy, la petite tirelire, a très peur d'être cassée. Son amie, Na, l'aime beaucoup et en prend grand soin. Mais un jour, la maman de Na décide de casser Piggy pour acheter une robe à Na. Que va faire Na ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/118510/size7/7fb665ffac68f8d931dddb42bb8673fb.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/118510/size7/7fb665ffac68f8d931dddb42bb8673fb.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-100570","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-100570","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":311,"opdsId":"urn:uuid:SW-37521","title":"Le tinocéros, le rhinours et l’ougre","authors":["Cyrille Largillier"],"language":"","readingLevel":"","publisher":"","summary":"Tingu le tigre n’est pas heureux avec sa peau orange et poilue. Il échange donc sa peau avec celle de Ranga le rhinocéros. Mais quand il veut la récupérer, Ranga l’a déjà échangée avec Oursou l’ours! Le tinocéros, le rhinours et  l’ougre réussiront-ils à redevenir un tigre, un rhinocéros et un ours?\nDécouvre-le dans cette histoire avec des animaux mélangés.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726495/size7/0f748e0a30ec491c6c7ac54cd4157b8e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726495/size7/0f748e0a30ec491c6c7ac54cd4157b8e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-37521","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-37521","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":312,"opdsId":"urn:uuid:SW-226722","title":"Le daim qui pleure","authors":["Cyrille Largillier"],"language":"","readingLevel":"","publisher":"","summary":"En jouant dans la forêt, un faon s'est blessé. Il n'arrêtait pas de pleurer jusqu'à ce que quelqu'un de spécial arrive. Peux-tu deviner qui ? Regarde l'histoire pour le savoir.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/285294/size7/3e13f46b14fc5bbb22a5ddd5c91d4c22.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/285294/size7/3e13f46b14fc5bbb22a5ddd5c91d4c22.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-226722","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-226722","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":313,"opdsId":"urn:uuid:SW-42312","title":"Derrière les mensonges","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Valli et Ramesh vivent dans un climat de terreur permanent à cause de leur père violent. Leur situation va-t-elle changer ? Découvre-le dans cette histoire sur la violence domestique, le courage et l'espoir.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/713827/size7/f0bc807027e81b582713864f4cb60cf1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/713827/size7/f0bc807027e81b582713864f4cb60cf1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-42312","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-42312","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":314,"opdsId":"urn:uuid:SW-303237","title":"Dot, le petit livre","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"La petite Minnie adore son petit livre, Dot. Elle ne le quitte jamais. Jusqu'au jour où elle grandit. Que va-t-il arriver à Dot ? Découvre-le dans cette histoire sur les livres que l'on aime.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/352165/size7/2426a700524e1043bd3be342f25a7283.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/352165/size7/2426a700524e1043bd3be342f25a7283.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-303237","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-303237","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":315,"opdsId":"urn:uuid:SW-330804","title":"Ma Mère a Fait Des Plantations","authors":["Muriel  Binek","Translators withoutBorders"],"language":"","readingLevel":"","publisher":"","summary":"Mother and father are planting gardens. The family works together to plant and harvest.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/418458/size7/82c75f9b882c5297a3bb1ed710e0fe53.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/418458/size7/82c75f9b882c5297a3bb1ed710e0fe53.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-330804","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-330804","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":316,"opdsId":"urn:uuid:SW-103465","title":"Joyeux anniversaire, petit chien !","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Xongyee souhaite organiser une fête surprise pour l'anniversaire de son petit chien. Mais c'est elle qui va avoir la surprise de sa vie. Découvre pourquoi dans cette petite histoire.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/93893/size7/de6d224cf3d16e38da111325a4eac436.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/93893/size7/de6d224cf3d16e38da111325a4eac436.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-103465","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-103465","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":317,"opdsId":"urn:uuid:SW-302078","title":"Le grand nettoyage de plage","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Arzu adore la plage et est bien décidée à la nettoyer. Mais quel casse-tête ! Heureusement, Arzu va découvrir que tous les problèmes ont leur solution.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716104/size7/053d818fe7b1f95214b74bd176b8550c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716104/size7/053d818fe7b1f95214b74bd176b8550c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-302078","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-302078","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":318,"opdsId":"urn:uuid:SW-11450","title":"Les petits peintres","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Peindre la maison, c'est très drôle. Mais de quelle couleur faut-il peindre la barrière?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/697317/size7/fae553c96cec531f760c79641f63a924.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/697317/size7/fae553c96cec531f760c79641f63a924.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-11450","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-11450","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":319,"opdsId":"urn:uuid:SW-300080","title":"Qu'avons-nous fait au climat ?","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Il fait trop chaud ou trop froid. Il n'y a pas assez de pluie ou beaucoup trop. Il neige moins. Il y a trop de carbone dans l'atmosphère. Les grizzlis ne savent pas s'ils doivent hiberner ou pas. Les pingouins ne savent plus quoi manger. Les kangourous fuient les feux de forêt. Les abeilles sont empoisonnées par les pesticides... Le monde est frappé par la crise climatique. Est-il temps de s’en inquiéter ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/234334/size7/e8a8b21f43aaa4d1a27745b56b34a5d1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/234334/size7/e8a8b21f43aaa4d1a27745b56b34a5d1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-300080","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-300080","type":"application/epub+zi