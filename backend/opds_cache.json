ref":"https://storyweaver.org.in/api/v0/story/epub/SW-214520","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":601,"opdsId":"urn:uuid:SW-633","title":"Cheenu's Gift","authors":["Sridala Swami"],"language":"","readingLevel":"","publisher":"","summary":"Cheenu has a lot of fun helping his father. Sometimes, there is a special treat for him too!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/720804/size7/062d956d806708b1d23f33dcee3a9b74.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/720804/size7/062d956d806708b1d23f33dcee3a9b74.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-633","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-633","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":602,"opdsId":"urn:uuid:SW-67","title":"Sister, Sister, Where Does the Sun Go at Night?","authors":["Roopa Pai"],"language":"","readingLevel":"","publisher":"","summary":"Little Brother's inquisitive mind is always full of questions for Big Sister. He knows Big Sister has all the answers, because she is always reading one big fat book or another. In this book, Little Brother wonders where the sun goes at night. Does he just go to sleep after a long day at work, or does he sink down into the ocean deep to make it daylight for the mermaids who frolic there?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722403/size7/bb21401a90260fde1161c0d0b384ab76.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722403/size7/bb21401a90260fde1161c0d0b384ab76.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-67","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-67","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":603,"opdsId":"urn:uuid:SW-447380","title":"The Mask","authors":["Rupali Bhave"],"language":"","readingLevel":"","publisher":"","summary":"Naseem made a lovely mask. Feeling grand, he wore it and went for a walk. Did his grand idea work?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727487/size7/b22936cefa94e00219ddef0bf97a5ed9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727487/size7/b22936cefa94e00219ddef0bf97a5ed9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-447380","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-447380","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":604,"opdsId":"urn:uuid:SW-8907","title":"Pambaram, the Naughty Top","authors":["Kavitha Punniyamurthi"],"language":"","readingLevel":"","publisher":"","summary":"Spin along with Pambaram, the naughty top, which has a mind of its own.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722862/size7/6f38839522e2b7cb345f55e6c3d29b60.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722862/size7/6f38839522e2b7cb345f55e6c3d29b60.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-8907","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-8907","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":605,"opdsId":"urn:uuid:SW-44655","title":"The Conical Hat","authors":["Erica Cuellar"],"language":"","readingLevel":"","publisher":"","summary":"This is a little poem about a conical hat. It is a hat woven from cane. It is used for many things. Would you like to know more about this delightful little hat?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/99589/size7/63fed35bfb54dfe91a630d95634a6749.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/99589/size7/63fed35bfb54dfe91a630d95634a6749.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-44655","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-44655","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":606,"opdsId":"urn:uuid:SW-362498","title":"Where Is Number 5?","authors":["Pankaj Saikia"],"language":"","readingLevel":"","publisher":"","summary":"Number 5 is missing! Bulbuli and Maina go searching for her and along the way they meet a bunch of her friends but no one knows where she has disappeared. Are there any surprises in store when they find Number 5?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527650/size7/40c4fc2d7e8f3980bce514e961fc0373.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527650/size7/40c4fc2d7e8f3980bce514e961fc0373.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-362498","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-362498","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":607,"opdsId":"urn:uuid:SW-113926","title":"RIA Sorts It Out","authors":["Sonal Sher"],"language":"","readingLevel":"","publisher":"","summary":"Abel is worried that his card to Ammachi will get lost because of his bad handwriting. So he visits the post office to find someone to help him sort things out.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/182193/size7/2fdb775754be5320d27034e2f12c06cf.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/182193/size7/2fdb775754be5320d27034e2f12c06cf.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-113926","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-113926","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":608,"opdsId":"urn:uuid:SW-537364","title":"What's My Mother Tongue?","authors":["Abokali Jimomi"],"language":"language","readingLevel":"","publisher":"","summary":"It is Language Day at Zhevili’s school in Nagaland. She has to introduce herself in her mother tongue. But what is her mother tongue? Zhevili isn’t sure. This endearing book tells the story of identity and disappearing languages.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/636961/size7/c7fa46137b73c42dba1791a78e6d54db.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/636961/size7/c7fa46137b73c42dba1791a78e6d54db.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-537364","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-537364","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":609,"opdsId":"urn:uuid:SW-70193","title":"The Starlight Adventure","authors":["Parinita Shetty"],"language":"","readingLevel":"","publisher":"","summary":"Naina and Madhav decide to settle their disagreement in outer space. They end up meeting a host of odd characters – from a unicorn who can't stop eating to a dragon who won't stop crying. But who are these glowy creatures? A space adventure that introduces readers to constellations in the night sky.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715246/size7/9836f4784ff49053c387040a01426ad6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715246/size7/9836f4784ff49053c387040a01426ad6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-70193","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-70193","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{