//opds-spec.org/acquisition"}]},{"id":958,"opdsId":"urn:uuid:SW-94606","title":"पैसे की दुनिया","authors":["Madhu B. Joshi"],"language":"","readingLevel":"","publisher":"","summary":"रुपया पैसा शृंखला ऐसे कई उपयोगी तथ्य उजागर करती है जो हमारी इस बदलती हुई दुनिया में बच्चों को पैसे के सही उपयोग करने में सहायता करेंगे। पहले-पहल सिक्के किस के बने थे? लोग पैसा कमाते, बचाते और बरतते कैसे हैं? आज अपने पास पैसा न होने पर भी क्या एक परिवार फ़्रिज खरीद सकता है? इन सबके बारे में पैसे की दुनिया, पुस्तक १ पढ़ कर जानिए। रुपया पैसा शृंखला में और भी बहुत कुछ जानने को मिलेगा।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/521973/size7/c717236abc9f0de954dd4e1ee3789ee9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/521973/size7/c717236abc9f0de954dd4e1ee3789ee9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-94606","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-94606","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":959,"opdsId":"urn:uuid:SW-550426","title":"एक नए ग्रह की खोज","authors":["Nagraj Rao"],"language":"","readingLevel":"","publisher":"","summary":"अन्वी ब्रह्माण्ड के बारे में सबकुछ जानना चाहती है और अपनी नई दूरबीन से चिपक कर बैठी रहती है। वह जानना चाहती है कि क्या वास्तव में एलियन यानी परग्रहवासी होते हैं? एक रात जब वह कुछ एलियनों से मिली तो उसे पता चला कि हमारे सौर मंडल और आकाशगंगा के परे भी कई ग्रह हैं। चलिए जानते हैं इन एक्सोप्लेनेट्स के बारे में!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/700845/size7/39c84c0cb8b91e4c766d58f6ae5a2722.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/700845/size7/39c84c0cb8b91e4c766d58f6ae5a2722.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-550426","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-550426","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":960,"opdsId":"urn:uuid:SW-580572","title":"चलो साथ में रहें","authors":["Priyanka Gautam"],"language":"","readingLevel":"","publisher":"","summary":"तेंदाई कछुए की दादी के खोल में चोट लग गई है। मम्मी और पापा को उनकी देखभाल के लिए जाना होगा। \"आओ हमारे साथ रहो,\" तेंदाई की पक्की दोस्त खरगोश बुसी उससे कहती है, और फिर शुरू होता है असली मज़ा!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527479/size7/c27aed7bef82c0d48e6c6bbfd3c447fd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527479/size7/c27aed7bef82c0d48e6c6bbfd3c447fd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-580572","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-580572","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":961,"opdsId":"urn:uuid:SW-343674","title":"जब पानी आया-1","authors":["Pratham Resource Centre"],"language":"","readingLevel":"","publisher":"","summary":"बाढ़ के कारण जाने लोगो को कैसी-कैसी कठनाइयो का सामना करना पड़ा।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/469059/size7/e507c13447dc55196add1d6f5db3575c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/469059/size7/e507c13447dc55196add1d6f5db3575c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-343674","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-343674","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":962,"opdsId":"urn:uuid:SW-138960","title":"चड्ढी सरताज की रोमांचक दास्तान","authors":["Madhu B. Joshi"],"language":"","readingLevel":"","publisher":"","summary":"जुनैद सबसे बेहतरीन सुपरहीरो है। वह चड्ढी सरताज है! उसे तलाश है एक बढ़िया जमूरे की। उसे ढूँढ़ते हुए चड्ढी सरताज के साथ क्या-क्या गुज़