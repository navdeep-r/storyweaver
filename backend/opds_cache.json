aver.org.in/api/v0/story/pdf/SW-261538","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-261538","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":810,"opdsId":"urn:uuid:SW-370956","title":"गोष्ट चिमुकल्या कीटकांच्या जगाची, राजमोहना केलोथ यांच्या संशोधनाची","authors":["Varsha Gajendragadkar"],"language":"","readingLevel":"","publisher":"","summary":"वर्गातली इतर मुलं जेव्हा झोपलेली असायची, तेव्हा छोटी मोहना मुंग्यांची फौज निरखण्यात दंग व्हायची. मोठी झाल्यावर ती कीटकतज्ज्ञ बनली. या पुस्तकात राजमोहना केलोथ आणि ती निरीक्षण करत असलेल्या चिमुकल्या कीटकांच्या मोठ्या जगाबद्दल जाणून घेऊ या.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727421/size7/1c51e44491a29f2e9c497da35a49add2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727421/size7/1c51e44491a29f2e9c497da35a49add2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-370956","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-370956","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":811,"opdsId":"urn:uuid:SW-550787","title":"आपली राज्यघटना, आपले देशबांधव","authors":["Meera  Joshi"],"language":"","readingLevel":"","publisher":"","summary":"भारताची राज्यघटना हा एक भविष्यवेधी, स्वप्नवत आश्वासनांचा ठेवा आहे. आपलं वर्तमान आणि आपलं भविष्य या दृष्टीनं या महत्त्वाच्या दस्तऐवजाची भूमिका काय आहे, तसेच या देशाचे नागरिक असण्याचा नेमका अर्थ काय आहे, हे नीटपणे समजावून घेण्यासाठी जरा इतिहासाच्या पानांमध्ये डोकावून पाहू या.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/532359/size7/08ed742ec4dd49254e2e0e201e413974.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/532359/size7/08ed742ec4dd49254e2e0e201e413974.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-550787","type":"applicati