/SW-13759","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-13759","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":272,"opdsId":"urn:uuid:SW-24871","title":"अन्न-दैत्य","authors":["Nagraj Rao"],"language":"","readingLevel":"","publisher":"","summary":"भारत में रोटी से दोसा और चकली से बर्फी तक, हम कई तरह के व्यन्जनों का स्वाद चख सकते हैं। \nअन्न-दैत्य में हम इन व्यंजनों के आकारों का पता लगाते हैं।\nइस कहानी के चित्र एक पुरानी तकनीक ‘ज्ञोताकु’ यानि मछलियों से की जाने वाली एक छपाई पर आधारित है जिसके ज़रिए मछुआरे पकड़ी गई मछलियों का हिसाब रखा करते थे।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/123549/size7/3687d0df50d079218bf3867d505dcd51.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/123549/size7/3687d0df50d079218bf3867d505dcd51.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-24871","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-24871","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":273,"opdsId":"urn:uuid:SW-50261","title":"चलो खेलें","authors":["Mohammad Wasif"],"language":"","readingLevel":"","publisher":"","summary":"तैयार, एक, दो, तीन... भागो। फिसलो। खेल-खेल में विज्ञान सीखो।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717460/size7/371430b9f5e5718d4be9c13d0336e745.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717460/size7/371430b9f5e5718d4be9c13d0336e745.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-50261","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-50261","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":274,"opdsId":"urn:uuid:SW-49944","title":"गप्पू गोला","authors":["Jitendra   Bhatia"],"language":"","readingLevel":"","publisher":"","summary":"पिटारा खुलते और गप्पू गोले के बाहर आते ही क्या क्या नहीं होता! गड़बड़ घोटाले की एक लड़ी सी फूट पड़ती है। तो आइए पढ़ें यह अगड़म बगड़म कविता।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727080/size7/6b02033d91d678fd198870c0e0c63af5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727080/size7/6b02033d91d678fd198870c0e0c63af5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-49944","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-49944","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":275,"opdsId":"urn:uuid:SW-12435","title":"एक जैसे या अलग-अलग?","authors":["Meera Hadap"],"language":"","readingLevel":"","publisher":"","summary":"क्या आपकी दोस्ती सिर्फ़ ऐसे लोगों से हो सकती है जो आपके जैसे हैं? क्या आपका सबसे अच्छा दोस्त आपसे अलग नहीं हो सकता? इस कहानी में, जैसे सँपोले और नन्ही गौरैया ने बहुत सोच-समझकर इन सवालों के जवाब ढूँढ निकाले, वैसे ही आप भी अपने जवाब ढूँढ निकालिये।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/713551/size7/e4d629c39bd8feb1be0de5a47991ae6b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/713551/size7/e4d629c39bd8feb1be0de5a47991ae6b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12435","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12435","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":276,"opdsId":"urn:uuid:SW-94602","title":"श्रींगेरी श्रीनिवास की गाय क्यों नहीं रम्भाती?","authors":["Rajesh Khar"],"language":"","readingLevel":"","publisher":"","summary":"श्रींगेरी श्रीनिवास एक नई ही समस्या से जूझ रहा है। उसकी गाय रम्भा नहीं रही और उसे बड़ा गुस्सा आ रहा है। उसकी पत्नी, उसके बच्चे, सभी जी जान से कोशिश कर रहे हैं कि गाय र