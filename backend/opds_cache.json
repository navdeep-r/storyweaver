":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-366098","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":669,"opdsId":"urn:uuid:SW-58662","title":"The Birthday Present","authors":["Alisha Berger"],"language":"","readingLevel":"","publisher":"","summary":"Maya the Tortoise tries everyday to get to school in time, but ends up being late. She needs a bicycle. But where ever will she find a bicycle for a tortoise? Read on to see what she receives as a birthday present.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/103149/size7/edcf2026dbcce3a663ea098cd80ebfa2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/103149/size7/edcf2026dbcce3a663ea098cd80ebfa2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-58662","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-58662","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":670,"opdsId":"urn:uuid:SW-63968","title":"Gadbad Das in 'No water for you!'","authors":["Jayanto Banerjee"],"language":"","readingLevel":"","publisher":"","summary":"Gadbad Das is the son of the famous singer, Gardhab Das. He lives in a small town in India. Like his father, Gadbad is a very bad singer. Everybody knows this, except him! He does various odd jobs to survive and solves his problems musically mostly. Like this one, where there is no water for his puncture shop. Off goes Gadbad Das to find some water, but it’s not as easy as you’d think.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727059/size7/2e28482892278aceea1647757d2c7ade.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727059/size7/2e28482892278aceea1647757d2c7ade.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-63968","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-63968","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":671,"opdsId":"urn:uuid:SW-1062","title":"Noisy Crows","authors":["Kanchan Bannerjee"],"language":"","readingLevel":"","publisher":"","summary":"Caw! Caw! The crow in this book is calling out to young readers to read this book. This book is one of the four books in the 'Animals Around Us' series.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/704907/size7/13f658c3851393d29582f887eedc6f06.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/704907/size7/13f658c3851393d29582f887eedc6f06.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-1062","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-1062","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":672,"opdsId":"urn:uuid:SW-612553","title":"Muthu and Kappu","authors":["Sheena Deviah"],"language":"","readingLevel":"","publisher":"","summary":"Muthanna of Kottageri does not like black cats. They bring bad luck, he is sure. What happens when Gangu and Raja bring home the blackest of kittens?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/705618/size7/25a31473686ab2e52b88b4013188a895.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/705618/size7/25a31473686ab2e52b88b4013188a895.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-612553","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-612553","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":673,"opdsId":"urn:uuid:SW-264337","title":"Dadi, Dadi, What Colour Do You See?","authors":["Ekta Bharti"],"language":"","readingLevel":"","publisher":""