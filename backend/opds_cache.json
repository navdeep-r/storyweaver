,{"id":399,"opdsId":"urn:uuid:SW-433271","title":"घोटाळा","authors":["Madhuri Purandare"],"language":"","readingLevel":"","publisher":"","summary":"घरात सकाळची कामं सुरू झाली.\nमाशीला वाटलं, आपणही कामाला लागायला हवं.\nती लगबगीनं निघाली अन्... झाला नं घोटाळा!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727546/size7/3d6cb8abf37a7c69dfca4f68e086ed89.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727546/size7/3d6cb8abf37a7c69dfca4f68e086ed89.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-433271","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-433271","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":400,"opdsId":"urn:uuid:SW-229","title":"कोजागिरी आणि मसाला दूध","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"धम, धम, धम.. मला मृदुंग शिकायचा आहे आणि आईला स्कूटर चालवायला शिकायची आहे. कधी माहीत आहे? दसर्‍याच्या मुहूर्तावर!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/702492/size7/7e3531c64e0b2ad008042698b9cb8516.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/702492/size7/7e3531c64e0b2ad008042698b9cb8516.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-229","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-229","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":401,"opdsId":"urn:uuid:SW-377663","title":"प्रत्येक रुपया मोलाचा","authors":["Atish Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"बँकोनं बचत करून थोडे पैसे साठवले आहेत. हे पैसे त्याला प्राण्यांची सुटका करणाऱ्या, त्यांना वाचवण्याचं काम करणाऱ्या लोकांना द्यायची इच्छा आहे. रुपयांचं पैशात आणि पैशांचं रुपयात रुपांतर करण्यासाठी ताई त्याला मदत करते आणि पैशाचं मूल्य कसं मोजायचं, हेही शिकवते. चला, आपणही बँकोसोबत हे  शिकू या!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/524648/size7/9ebcee8fba0efbc406431490a6764fc5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524648/size7/9ebcee8fba0efbc406431490a6764fc5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-377663","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-377663","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":402,"opdsId":"urn:uuid:SW-302741","title":"पहिली ओळख - वाहनांशी","authors":["Asmita Chitale"],"language":"","readingLevel":"","publisher":"","summary":"आपल्या आजूबाजूला खूप सारी वाहनं असतात! ती पाहून आपल्याला किती आनंद होतो ना? पण तुम्हाला त्यांची नावं ठाऊक आहेत का? या पुस्तकाच्या मदतीनं आपण आजूबाजूच्या काही गोष्टींची ओळख करू घेऊ या!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727071/size7/1abbc9ffc6290e630e64062d59f19726.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727071/size7/1abbc9ffc6290e630e64062d59f19726.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-302741","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-302741","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":403,"opdsId":"urn:uuid:SW-264","title":"सूरज आणि शेरसिंग","authors":["Mukund Taksale"],"language":"","readingLevel":"","publisher":"","summary":"सूरज आणि शेरसिंग बागेत धमाल मजा करत आहेत. चला त्यांना भेटूया.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/127522/size7/8cf9a2a4c77304b36929ad3151cad63e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/127522/size7/8cf9a2a4c77304b36929ad3151cad63e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-264","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-264","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":404,"opdsId":"urn:uuid:SW-272271","title":"तुम्हाला खरं नाही वाटणार…","authors":["Atish Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"तशी ही परिचित गोष्ट. एका मुलाची. कदाचित तुम्ही त्याला ओळखतही असाल. तुम्हाला बहुदा खरं नाही वाटणार, पण त्याला आपली शाळा खूप आवडते, जरी शाळेला तो आवडत नसला तरीसुद्धा. शिक्षकांची नजर चुकवून त्याला छळणाऱ्या वर्गमित्रांना तो आवडत नसला तरीसुद्धा. एकदा तो खूप सारे मासे असलेल्या एका तळ्यापाशी जातो. तिथे त्याला ‘आपण आता एकटे नाही,’ हे लक्षात येतं.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/524464/size7/495e026e7af09c81f3d5813cf16cdcb8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524464/size7/495e026e7af09c81f3d5813cf16cdcb8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-272271","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-272271","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":405,"opdsId":"urn:uuid:SW-115312","title":"उंचच उंच.... दुप्पट उंच","authors":["Sayali Godse"],"language":"","readingLevel":"","publisher":"","summary":"मुथूलक्ष्मी पी. ची उंची अगदी भराभरा वाढते आहे. मोठी झाल्यावर ती नक्की किती उंच होईल, हे सध्या कुणीच खात्रीशीरपणे सांगू शकत नाही. पण जर तिची उंची चक्क दुपटीनं वाढली तर? आणि पुन्हा पुन्हा दुपटीनं सारखी वाढतच गेली तर? मग काय गंमत होईल ते वाचा या मजेशीर पुस्तकात!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715294/size7/5e00e4f6b972e1c84779a28018b77d81.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715294/size7/5e00e4f6b972e1c84779a28018b77d81.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-115312","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-115312","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":406,"opdsId":"urn:uuid:SW-11227","title":"अपूचा राक्षसी भूकंप","authors":["Shruti Panse"],"language":"","readingLevel":"","publisher":"","summary":"अपूच्या गाण्यामुळं पृथ्वी हलली आणि हादरली का? की हा एक भूकंप होता? भूकंपाची ही मजेदार आणि माहितीपूर्ण गोष्ट वाचून तर बघा.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/713578/size7/2e61153788e79629615dbd8dd46a58fc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/713578/size7/2e61153788e79629615dbd8dd46a58fc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-11227","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-11227","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":407,"opdsId":"urn:uuid:SW-635808","title":"आलेपाक","authors":["Wasimbarry Maner"],"language":"","readingLevel":"","publisher":"","summary":"चिंगी तालुक्याच्या कापड बाजारात पहिल्यांदाच गेली. रंगीबेरंगी फुललेला बाजार बघून खूश झाली. शकीलतात्यानं एवढी मोठ्ठी खरेदी केली की त्याची छोट्टी नॅनो गाडी भरून गेली. \nमग चिंगीने तात्यासाठी अगदी छोट्टी खरेदी केली आणि त्याने मोठ्ठी मजा आली.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723782/size7/46febe3b5c6068d42bec84da0df5479e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723782/size7/46febe3b5c6068d42bec84da0df5479e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-635808","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-635808","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":408,"opdsId":"urn:uuid:SW-421","title":"माझी गाडी","authors":["Neha Taksale"],"language":"","readingLevel":"","publisher":"","summary":"खैदीजवळ एक मस्त गाडी आहे. डुर्ररम... सगळीकडे तो ती घेऊन जातो. खूप हिंडतो. \nचला, त्याच्याबरोबर जगाची सफर करूया.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/709197/size7/07f56b1cecb466139edbec1330051a29.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/709197/size7/07f56b1cecb466139edbec1330051a29.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-421","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-421","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":409,"opdsId":"urn:uuid:SW-69","title":"ताई, ताई, रात्री सूर्य जातो कुठे?","authors":["Utkarsha Manish"],"language":"","readingLevel":"","publisher":"","summary":"लहान भाऊ आपल्मा ताईला सारखे प्रश्न विचारतो आहे. \nत्माला माहीत आहे, ताईकडे सर्व उत्तरे आहेत, कारण ती नेहमी कोणते \nना कोणते तरी जाडे पुस्तक घेऊन वाचत असते.\nमा पुस्तकात छोट्या भावाला प्रश्न पडला आहे - रात्री सूर्म जातो कुठे? \nतो दिवसभराच्मा कामानंतर थकून भागून झोपी जातो की तो महासागरात \nखोलवर बुडतो आणि मत्स्मकन्मा जिथे बागडतात तिथे प्रकाश पाडतो?\nअर्थात शेवटी ताईकडे खरं उत्तर आहे, पण हे मजेदार पुस्तक वाचण्मापूर्वी \nतुम्ही सांगा : तुम्हाला काम वाटते, रात्री सूर्म जातो कुठे?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722403/size7/bb21401a90260fde1161c0d0b384ab76.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722403/size7/bb21401a90260fde1161c0d0b384ab76.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-69","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-69","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":410,"opdsId":"urn:uuid:SW-5105","title":"वरचं जग, खालचं जग","authors":["Sushrut Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"भारतातल्या पर्णाच्छादित जंगलात वरचं जग आणि खालचं जग, ही दोन्हीही जगं\nपरस्परांकडं नेहमीच संशयानंच बघायची. पण ज्यावेळी गोपा रानउंदराचं पुस्तक चुकून खाली फातिमाच्या डोक्यावर पडलं, त्यावेळी मात्र हे सगळं बदललं. जंगलामधली जैवविविधता आणि मैत्री यांबद्दल असणारी ही छानशी गोष्ट.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723877/size7/512e37faaf23415856672bb730140ee1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723877/size7/512e37faaf23415856672bb730140ee1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-5105","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-5105","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":411,"opdsId":"urn:uuid:SW-867","title":"माझी बॅट हरवली, माझी बॅट सापडली","authors":["Meera Tendolkar"],"language":"","readingLevel":"","publisher":"","summary":"कधीतरी मूल स्वत:शीच बोलते आणि मग त्यातून एक छोटासा प्रसंग डोळ्यासमोर उभा राहतो. ’माझी बॅट हरवली, माझी बॅट सापडली’ यामध्ये अशाच एका प्रसंगाचे वर्णन आहे.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722289/size7/c16c84713d1b61a71cddff825f43daca.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722289/size7/c16c84713d1b61a71cddff825f43daca.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-867","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-867","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":412,"opdsId":"urn:uuid:SW-16397","title":"मी काय करू?","authors":["Utkarsha Manish"],"language":"","readingLevel":"","publisher":"","summary":"एका छोट्या मुलीला सारखं काही ना काही करावसं\nवाटतं. तुम्हीही असे आहात काय?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721847/size7/89e982f898d1e62a1132207d8a46156f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721847/size7/89e982f898d1e62a1132207d8a46156f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-16397","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-16397","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":413,"opdsId":"urn:uuid:SW-331440","title":"टोपी घ्या टोपी!","authors":["Mini Shrinivasan"],"language":"","readingLevel":"","publisher":"","summary":"जंगलात एक माकड आलंय,\nसुंदर आणि रंगीत टोप्या घेऊन.\nकुणाकुणाला मिळेल बरं टोपी?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727425/size7/a73e3a35f69099a1fdb42783c8d63cf0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727425/size7/a73e3a35f69099a1fdb42783c8d63cf0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-331440","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-331440","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":414,"opdsId":"urn:uuid:SW-174","title":"जंगल शाळा","authors":["Meera Tendolkar"],"language":"","readingLevel":"","publisher":"","summary":"एका जंगलामध्ये शाळा सुरू झाली आहे हे कळल्यावर मोठ्या उत्साहात प्राणी तिथे गेले. त्यांचे पुढे काय झाले ते जंगल शाळा समजावून सांगेल.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/701000/size7/449224bf6cf24a86087b052fd6327570.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/701000/size7/449224bf6cf24a86087b052fd6327570.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-174","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-174","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":415,"opdsId":"urn:uuid:SW-377667","title":"अच्चचींची दप्तरछत्री","authors":["Atish Kulkarni"],"language":"",