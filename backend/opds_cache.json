.org/acquisition"}]},{"id":420,"opdsId":"urn:uuid:SW-369359","title":"Kucing yang Pintar","authors":["Invani Lela Herliana"],"language":"","readingLevel":"","publisher":"","summary":"Safi adalah seekor kucing yang pintar. Yuk, cari tahu lebih banyak tentang Safi!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/253186/size7/12d218fb4d4baa7c1463938230643b3c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/253186/size7/12d218fb4d4baa7c1463938230643b3c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-369359","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-369359","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":421,"opdsId":"urn:uuid:SW-590457","title":"बुलबुला लार राज","authors":["Yuman Hussain  Team Azad India Foundation"],"language":"","readingLevel":"","publisher":"","summary":"एकटा छोटो बोकरी खोबे उत्सुक छे। वाँ  पहला बार तालबोत गोतोर खुलवा गइल। तालाब डात पहुँचे वॉ भाला बुलबुला देख ले। इला कुंठे से ओचे ? कोई वार सवाल डार जवाब नी दी छे कि वा बुलबुलार राज डा कभी जानवा पाबे?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/427053/size7/9cafc47475f7d6eed6edb7877a504d6e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/427053/size7/9cafc47475f7d6eed6edb7877a504d6e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-590457","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-590457","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":422,"opdsId":"urn:uuid:SW-411351","title":"Lingkaran","authors":["Alif I. Dzaki"],"language":"","readingLevel":"","publisher":"","summary":"Sang Induk Berung Bangkai membawa anak burung kecil pada penerbangan pertamanya. Dalam perjalanan mereka, mereka melihat gemsbok yang sekarat. Dia menunjukka