.org.in/api/v0/story/pdf/SW-167682","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-167682","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1178,"opdsId":"urn:uuid:SW-14561","title":"A Miaow and A Roar","authors":["Tanya Luther Agarwal"],"language":"","readingLevel":"","publisher":"","summary":"Vedika and Karan share a real adventure as they sit in Grandfather’s chair. Meet their friends, the lion and the cat in this fun story.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/40018/size7/d1e5bc76d62394c2859fdc1920374e28.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/40018/size7/d1e5bc76d62394c2859fdc1920374e28.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-14561","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-14561","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1179,"opdsId":"urn:uuid:SW-161985","title":"Our Little River","authors":["Sanghamitra Ghosh"],"language":"","readingLevel":"","publisher":"","summary":"Tagore’s poem is on a little river in a village. Lots of activities happen around that river. Children bathe, catch fish, women wash clothes. Flowering Kaash shrubs line the banks, foxes bark, mynahs whistle. While in summer there is knee- deep water, monsoon months make it swell.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/331509/size7/b31059ef129b34f41adbbabd4949dcb3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/331509/size7/b31059ef129b34f41adbbabd4949dcb3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-161985","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-161985","type":"application/epub+zip","rel":"htt