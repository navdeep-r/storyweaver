now.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723784/size7/e7ef7449b13aac59bce727272b35da36.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723784/size7/e7ef7449b13aac59bce727272b35da36.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-642225","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-642225","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1621,"opdsId":"urn:uuid:SW-651907","title":"Snow Ice Cream","authors":["Tashi Chong Sherpa"],"language":"","readingLevel":"","publisher":"","summary":"In the village of Uttarey, little Dolma patiently awaits the arrival of snowfall so that she can enjoy the delicious snow ice-cream. Does she get to taste the winter treat? Read this little poem to find out.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/754816/size7/0dd726611b1a71b8f3521aab4f361fe3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/754816/size7/0dd726611b1a71b8f3521aab4f361fe3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-651907","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-651907","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1622,"opdsId":"urn:uuid:SW-651910","title":"Yapom","authors":["Moge Basar"],"language":"","readingLevel":"","publisher":"","summary":"A lonely Yapom lives high up on a tree. One day, she meets a little boy. Their time together unfolds the journey of the yapom and her\nlonging for companionship and friendship.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/754815/size7/a2969c4be473bd87e010df4ac38c0ca4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/754815/size7/a2969c4be473bd87e010df4ac38c0ca4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-651910","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-651910","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1623,"opdsId":"urn:uuid:SW-664709","title":"Yapa Yapa Yambuks","authors":["Chalini Basumatary"],"language":"","readingLevel":"","publisher":"","summary":"It’s Ali-Aye Ligang and Takar’s yambuk sonam’s are excited to join the festivities!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/754818/size7/d4a806e28891506581a0afb5edd87309.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/754818/size7/d4a806e28891506581a0afb5edd87309.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-664709","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-664709","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1624,"opdsId":"urn:uuid:SW-666481","title":"Trring Trring","authors":["Tanya Sudheer"],"language":"","readingLevel":"","publisher":"","summary":"Two friends, a string phone, and an important call. Dial in.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/749958/size7/b1337e5dcdc3fe275a8ec9d23f99324c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/749958/size7/b1337e5dcdc3fe275a8ec9d23f99324c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-666481","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-666481","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1625,"opdsId":"urn:uuid:SW-653132","title":"The Magical Spring of Fiara","authors":["Joan Lalramngaihsangi"],"language":"","readingLevel":"","publisher":"","summary":"Determined to save her village from water scarcity, Rini sets out on a mission to discover new water resources. At the end of her journey she discovers a hidden magical spring. As she attempts to take the water for her village, she encounters the spring’s old guardian and fierce protector, Fiara. Will Rini be able to take water for her village? Read this story to find out.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/754755/size7/9f8b75022fee2bbb70c161f44f5f1f4a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/754755/size7/9f8b75022fee2bbb70c161f44f5f1f4a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-653132","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-653132","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1626,"opdsId":"urn:uuid:SW-664984","title":"Passang's First Syabru","authors":["Tashi Chong Sherpa"],"language":"","readingLevel":"","publisher":"","summary":"Passang is back home for Losar and he is very excited to dance his first Syabru! But what is this? Everyone is comparing him to his Gaga, the best Syabru dancer in Naghi! He cannot dance as well as her. What if he is an embarrassment? What if this joyous occasion is not joyous at all? Join little Passang as he navigates his way through the anxiety and excitement.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/756352/size7/b706543b92aaeffd4904e8683959c44d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/756352/size7/b706543b92aaeffd4904e8683959c44d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-664984","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-664984","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1627,"opdsId":"urn:uuid:SW-665570","title":"Space Sambar","authors":["Somesh Kumar"],"language":"","readingLevel":"","publisher":"","summary":"How did the dragon breathe fire? Maybe it had something to do with a very spicy sambar on \na very hot planet?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/747545/size7/2436b3c514b2867951c567c7b4787a8d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/747545/size7/2436b3c514b2867951c567c7b4787a8d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-665570","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-665570","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1628,"opdsId":"urn:uuid:SW-650476","title":"Riri and the Cats","authors":["H.A Sothing Shimray"],"language":"","readingLevel":"","publisher":"","summary":"While playing with her cats, Riri discovers a curious thing about their nature. Wondering what that could be? Follow Riri and her cats on an enchanting journey surrounded by stars.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/750819/size7/4bfd5f5d59414552699c8248dad02fbd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/750819/size7/4bfd5f5d59414552699c8248dad02fbd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-650476","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-650476","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1629,"opdsId":"urn:uuid:SW-652918","title":"Charcoal","authors":["Niboli Keziah Chophi"],"language":"","readingLevel":"","publisher":"","summary":"With their parents away in the fields and left in charge of their napping Asu, Khumtsa and Xuivi have a mischievous idea in mind.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/754823/size7/7d00724bdd3f168bd8be691c181fc440.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/754823/size7/7d00724bdd3f168bd8be691c181fc440.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-652918","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-652918","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1630,"opdsId":"urn:uuid:SW-664155","title":"The Fabrics of Our Identity","authors":["SauraMandala Foundation"],"language":"","readingLevel":"","publisher":"","summary":"A journey through North-east India showcased by traditional garments worn by men and women from the region.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/754778/size7/3eec7410785cad4facfff363a5da51a8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/754778/size7/3eec7410785cad4facfff363a5da51a8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-664155","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-664155","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1631,"opdsId":"urn:uuid:SW-665326","title":"Langpang Boy","authors":["H.A Sothing Shimray"],"language":"","readingLevel":"","publisher":"","summary":"The story is an imaginative creation of the author based on the belief of the Tangkhul Naga tribe of Manipur that Langpang is a gift from God for humankind to live and thrive together.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/754894/size7/bc653a7ac8f4890d06a62e7192cc5e1e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/754894/size7/bc653a7ac8f4890d06a62e7192cc5e1e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-665326","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-665326","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1632,"opdsId":"urn:uuid:SW-673864","title":"Nelson the Magician","authors":["Menaka Raman"],"language":"","readingLevel":"","publisher":"","summary":"It is time for Nelson’s first ever magic show.\nAjji Majji La Tarajji, what kind of magician\nis he going to be?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/756851/size7/8e5c4e79d217ae5fe6c7ad78c0f3a1b7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/756851/size7/8e5c4e79d217ae5fe6c7ad78c0f3a1b7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-673864","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-673864","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1633,"opdsId":"urn:uuid:SW-653057","title":"The Fishing Trip","authors":["Thomas Malsom"],"language":"","readingLevel":"","publisher":"","summary":"When Thoni wanted to eat her mother’s special fish curry, she and her friends decided to go on a fishing adventure. But once they reach\nthe river, there were no fish! With things going against their plan, help comes from an unexpected source. Will Thoni and her friends be\nable to enjoy the fish curry? Read this story to find out.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/754822/size7/4ade617964443e527c00a0cb4b2bece1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/754822/size7/4ade617964443e527c00a0cb4b2bece1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-653057","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-653057","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1634,"opdsId":"urn:uuid:SW-665304","title":"Lungdai and the Hornbill","authors":["Thomas Malsom"],"language":"","readingLevel":"","publisher":"","summary":"Lungdai is frustrated! The hornbill bird keeps taking away all the fruits from his Pipi’s garden. They belong to his Pipi!\nIn his quest to chase away the bird, Lungdai learns an important lesson about love, devotion, and what it means to live in a community.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/754784/size7/ebe25eb53632c6b3b68216f52e5a7443.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/754784/size7/ebe25eb53632c6b3b68216f52e5a7443.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-665304","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-665304","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1635,"opdsId":"urn:uuid:SW-665305","title":"The tale of Pukshi","authors":["Linthoi Chanu"],"language":"","readingLevel":"","publisher":"","summary":"In ancient Samutak, Haokha Nongkha Ngamba's daughter Wandengnu wished to participate in the traditional Pam Yanba ritual. Delighted by her interest, Haokha Nongkha gives his daughter a gourd of honey to share with her friends on their journey. However, he forgets to tell Wangdengnu a small detail... that the gourd was magical.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/754788/size7/399015e0004db0c53f8552a716ccc32f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/754788/size7/399015e0004db0c53f8552a716ccc32f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-665305","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-665305","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1636,"opdsId":"urn:uuid:SW-657262","title":"The Heart of our Home","authors":["SauraMandala Foundation"],"language":"","readingLevel":"","publisher":"","summary":"A w