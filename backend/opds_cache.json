_crops/721706/size7/7455c3e7d30a58b67c0cb76a80888ca8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-11187","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-11187","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":904,"opdsId":"urn:uuid:SW-111363","title":"Under the Microscope","authors":["C G Salamander"],"language":"","readingLevel":"","publisher":"","summary":"Did you know that there are tiny creatures all around us? Look under a microscope to see them for yourself!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715281/size7/0875751e769cb804e0b165acf043ee1f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715281/size7/0875751e769cb804e0b165acf043ee1f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-111363","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-111363","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":905,"opdsId":"urn:uuid:SW-15618","title":"Flippy the Flowerpecker","authors":["Garima Bhatia"],"language":"","readingLevel":"","publisher":"","summary":"Flippy the tiny flowerpecker visits a eucalyptus tree to find a meal but a surprise is in store for her!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/344865/size7/fe7fac265ca1a7773f755c928497892f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/344865/size7/fe7fac265ca1a7773f755c928497892f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15618","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15618","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":906,"opdsId":"urn:uuid:SW-163738","title":"Grandma's Bananas","aut