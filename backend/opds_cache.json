 out?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717407/size7/2ceccd52eb887c7a45da3ee2d7871842.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717407/size7/2ceccd52eb887c7a45da3ee2d7871842.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-268489","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-268489","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":723,"opdsId":"urn:uuid:SW-337655","title":"Rathna and the Ring of Fire","authors":["Nandita Jayaraj"],"language":"","readingLevel":"","publisher":"","summary":"For one full minute, the sun will disappear behind the moon, and a ring of fire will be seen instead. Astronomer Rathna is very excited. Watch her day unfold at the planetarium.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/431234/size7/7ea8115f035aa92a1f2ef78f8c4e8ca3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/431234/size7/7ea8115f035aa92a1f2ef78f8c4e8ca3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-337655","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-337655","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":724,"opdsId":"urn:uuid:SW-41038","title":"What did Priya eat?","authors":["Anna D"],"language":"","readingLevel":"","publisher":"","summary":"Priya, the cow, is sick. Her tummy hurts. Read this book to find out why she was unwell, and how her friends helped her.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/93785/size7/034e226c88d0e40181a6d5c7009efc02.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/93785/size7/034e226c88d0e40181a6d5c7009efc02.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-41038","type":"appli