ttps://static.storyweaver.org.in/illustration_crops/721044/size7/8d44f88b1d324cf09b40cdda343db71c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-100747","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-100747","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":558,"opdsId":"urn:uuid:SW-48296","title":"बड़े हौवे की बड़ी किताब","authors":["Dr Amardeep"],"language":"","readingLevel":"","publisher":"","summary":"सावधान! हौवे हर जगह पहुँच सकते हैं और डरा सकते हैं। तमिलनाडु में, बच्चों से कुछ काम, जो उनको नापसंद होते हैं, करवाने के लिए पता है किसे बुलाते हैं? बूचंडी नाम के हौवे को। इस किताब में आप हर शक्ल और हुलियों के हौवे पाएँगे, जो गुर्राते हैं और घात लगाए रहते हैं। ध्यान रहे!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/157772/size7/c22c969c00ed3abf7b7e06e6075fa53c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/157772/size7/c22c969c00ed3abf7b7e06e6075fa53c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-48296","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-48296","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":559,"opdsId":"urn:uuid:SW-30045","title":"जादुर्इ गुटका","authors":["Madhu B. Joshi"],"language":"","readingLevel":"","publisher":"","summary":"एक बहुत ख़ास कलम फिसल कर पलंग के नीचे सरक गया है। रिंकी उसे वापस लाने की बहुत कोशिश कर रही है लेकिन वह उस तक पहुँच नहीं पा रही! क्या एक मामूली सा काला गुटका उसकी मदद कर पायेगा?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/714200/size7/d52ae05d8d77083059bdcbb3508334a8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/714200/size7/d52ae05d8d77083059bdcbb3508334a8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-30045","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-30045","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":560,"opdsId":"urn:uuid:SW-52560","title":"एकांतवासी केकड़ा","authors":["Pooja Bahanwal"],"language":"","readingLevel":"","publisher":"","summary":"मिली, एक केकड़ा है। उसका शंख के जैसा आवरण कहीं खो गया है। वो समुद्रतट पर अपने लिए एक अच्छी सी खोल ढूँढ़ने निकल पड़ती है। पर उसे मिलता है ढेर सारा कूड़ा, लोग और गुस्से से भरा घोंघा। क्या मिली गर्मी बढ़ने से पहले अपना खोल ढूँढ़ पाएगी?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/537878/size7/fcee6e9d81481cb027d4fd946e8012f8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/537878/size7/fcee6e9d81481cb027d4fd946e8012f8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-52560","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-52560","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":561,"opdsId":"urn:uuid:SW-30023","title":"चीहू की जादुयी शक्ति","authors":["Ashvini  Vyas"],"language":"","readingLevel":"","publisher":"","summary":"चीहू को कुछ रोचक चीजें दिखाई देती हैं जिसे कोई और नहीं देख पाता - जैसे उड़ते हुए रॉकेट और ब्लैकबोर्ड पर तैरती हुई मछलियाँ। आज्जी उसकी जादुई शक्तियों के बारे में पता लगाने के लिए उसे आँखों के डॉक्टर के पास ले कर जाती है।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722813/size7/196de06440ab4625dccdce4e70396bd7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722813/size7/196de06440ab4625dccdce4e70396bd7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-30023","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-30023","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},