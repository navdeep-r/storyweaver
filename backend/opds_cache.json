/static.storyweaver.org.in/illustration_crops/527541/size7/8b9b4ad89f883b4d5fc2428c650116c9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527541/size7/8b9b4ad89f883b4d5fc2428c650116c9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-378904","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-378904","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":680,"opdsId":"urn:uuid:SW-49682","title":"Senzo et la course du soleil","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Les rayons du soleil réveillent Senzo. Cocorico ! chante le coq. Viens faire la connaissance de Senzo tandis que le soleil l'accompagne toute la journée.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/85553/size7/8bc5506a0bf82b256a769430c410b2b0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/85553/size7/8bc5506a0bf82b256a769430c410b2b0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-49682","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-49682","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":681,"opdsId":"urn:uuid:SW-409584","title":"Le jour de la peinture, le jour des plantes","authors":["Cyrille Largillier"],"language":"","readingLevel":"","publisher":"","summary":"Avi aime la journée des plantes, la journée de la musique et la journée de la peinture, et s'occupe tout au long de la semaine. Accompagne Avi dans ses travaux de bricolage dans la maison, dans ce livre où il s'agit de remarquer et de reconnaître des rythmes.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/472786/size7/c73d494d112953afae92ffe68d3d5f6f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/472786/size7/c73d494d112953afae92ffe68d3d5f6f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-409584","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-409584","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":682,"opdsId":"urn:uuid:SW-430352","title":"Un arbre très important","authors":["Cyrille Largillier"],"language":"","readingLevel":"","publisher":"","summary":"Busi aime le grand et bel arbre devant sa maison. Mais son frère veut l'abattre. Comment va-t-elle l'arrêter ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/504043/size7/2946f34ac8c3efb693d6357c01f57c26.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/504043/size7/2946f34ac8c3efb693d6357c01f57c26.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-430352","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-430352","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":683,"opdsId":"urn:uuid:SW-48400","title":"Chantons sous la pluie","authors":["Marie"],"language":"","readingLevel":"","publisher":"","summary":"Sukhiya Kaka était un célèbre chanteur. Il rencontra Dino qui s'avéra être son plus grand fan. Ensemble ils faisaient la paire !","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722389/size7/d05540af9b5524776541f85d6f0d63d4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722389/size7/d05540af9b5524776541f85d6f0d63d4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-48400","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-48400","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":684,"opdsId":"urn:uuid:SW-75485","title":"Fati et le Serpent Vert","authors":["Mathilde  Pitaval"],"language":"","readingLevel":"","publisher":"","summary":"Chaque jour est une nouvelle aventure pour Fati, une petite fille qui essaye toujours de faire les choses comme il faut. Dans cette histoire, Fati se fait surprendre alors qu'elle ramasse du bois pour le feu avec ses parents. Fati et le Serpent Vert est basé sur les vraies aventures d'une fille qui grandit dans le nord du Ghana.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/62460/size7/731db424da42564f209ccf9e5c96a6c4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/62460/size7/731db424da42564f209ccf9e5c96a6c4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-75485","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-75485","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":685,"opdsId":"urn:uuid:SW-43161","title":"Approximativement, plus ou moins","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Ranjita et Vikram vont-ils parvenir à compter autant de boîtes de gâteaux en si peu de temps ? Oui, grâce à une astuce mathématique appelée 'Approximativement, plus ou moins'. Viens découvrir leur méthode dans cette histoire!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712829/size7/da3cb47b4e548e2e6f4f4ebd366e9ac0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712829/size7/da3cb47b4e548e2e6f4f4ebd366e9ac0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-43161","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-43161","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":686,"opdsId":"urn:uuid:SW-484390","title":"Une feuille part en voyage","authors":["Cyrille Largillier"],"language":"","readingLevel":"","publisher":"","summary":"Une feuille s'est envolée dans le vent. Elle est allée très loin. En fin de compte, elle a atterri dans la maison de Kabir. Qu'est-ce que Kabir a fait de la feuille ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727494/size7/5dab3291440b3ff0f521deee44114061.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727494/size7/5dab3291440b3ff0f521deee44114061.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-484390","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-484390","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":687,"opdsId":"urn:uuid:SW-100706","title":"Une pomme sucrée pour Maman","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Rajani adore peindre au gré de son imagination. Mais sa maman se demande pourquoi ses peintures ne représentent pas davantage la réalité.. Comment Rajani peut-elle montrer à sa maman qu'il n'y a pas qu'une seule façon de peindre ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/103153/size7/45642f52073d8a93beb638ee9b9ded79.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/103153/size7/45642f52073d8a93beb638ee9b9ded79.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-100706","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-100706","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":688,"opdsId":"urn:uuid:SW-484623","title":"Tant d'invités","authors":["Cyrille Largillier"],"language":"","readingLevel":"","publisher":"","summary":"Un invité… Deux invités… Six invités… Qu'y a-t-il de spécial aujourd'hui dans la maison d'Ovi ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727530/size7/9464c2cf78a4c11b9f8111063ab35391.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727530/size7/9464c2cf78a4c11b9f8111063ab35391.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-484623","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-484623","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":689,"opdsId":"urn:uuid:SW-62324","title":"Plouf-Plouf, le petit poisson explorateur","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Plouf-Plouf et sa maman nagent en eaux peu profondes. Plouf-Plouf souhaiterait aller jouer avec les autres poissons, dans les eaux profondes. Mais sa maman prétend que c'est beaucoup trop dangereux pour lui. Plouf-Plouf décide d'y aller quand même. Que va-t-il lui arriver ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/101350/size7/fe581f9e83d861b2dc322c9f507026ae.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/101350/size7/fe581f9e83d861b2dc322c9f507026ae.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-62324","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-62324","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":690,"opdsId":"urn:uuid:SW-55313","title":"Où est passée Rainette ?","authors":["goofy"],"language":"","readingLevel":"","publisher":"","summary":"Dina recherche partout son amie Rainette. Peux-tu l’aider à la trouver ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727061/size7/136f05ee6d48dd5d7c58d50da93c79cd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727061/size7/136f05ee6d48dd5d7c58d50da93c79cd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-55313","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition