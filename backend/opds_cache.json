er":"","summary":"A story that takes a stance against bullying and emphasizes on doing the right thing.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/529552/size7/55127f1c0c444a320c3cf198c5a1a020.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/529552/size7/55127f1c0c444a320c3cf198c5a1a020.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-152931","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-152931","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":705,"opdsId":"urn:uuid:SW-105117","title":"Little Goat","authors":["Mirna  Lawrence"],"language":"","readingLevel":"","publisher":"","summary":"Little Goat wanders off to look for the sweet grass and doesn’t realise how far she is from Mother Goat.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/156946/size7/27377f741c50c318b7c45c1a5457254f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/156946/size7/27377f741c50c318b7c45c1a5457254f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-105117","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-105117","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":706,"opdsId":"urn:uuid:SW-128449","title":"Art is Everywhere - Here, There and in Food","authors":["Aparna  Kapur","Bijal Vachharajani"],"language":"","readingLevel":"","publisher":"","summary":"Art can happen anywhere, using almost\nanything. In this title of the Art is Everywhere\nseries, the reader joins the artists in looking for\nforms and shapes in food. Filled with irreverent\nrhymes, these books will give the reader’s\nimagination wings.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727182/size7/e9f3700d2c7912a766ad0f97187465bc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727182/size7/e9f3700d2c7912a766ad0f97187465bc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-128449","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-128449","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":707,"opdsId":"urn:uuid:SW-7710","title":"The Boink Mystery","authors":["Mala Kumar","Manisha Chaudhry"],"language":"","readingLevel":"","publisher":"","summary":"BOINK BOINK BOINK...  Aman could hear it. What was 'it'? \nRead on to solve this great mystery set in Jantar Mantar in \nJaipur. You are sure to have a lot of good clean fun!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/26111/size7/df5f0504dede1df990880442ab741222.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/26111/size7/df5f0504dede1df990880442ab741222.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-7710","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-7710","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":708,"opdsId":"urn:uuid:SW-212798","title":"What's That Sound?","authors":["Zubin Miller"],"language":"","readingLevel":"","publisher":"","summary":"It’s late at night and Reena is lying in bed. Suddenly, she starts to hear a strange noise coming from somewhere in the house…","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283176/size7/267a4edcb1e1158ff0d13a3cae4bd7d5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283176/size7/267a4edcb1e1158ff0d13a3cae4bd7d5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-212798","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-212798","type"