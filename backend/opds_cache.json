org.in/api/v0/story/pdf/SW-625470","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-625470","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":788,"opdsId":"urn:uuid:SW-350893","title":"द ग्रेट रिफासा","authors":["Varsha Gajendragadkar"],"language":"","readingLevel":"","publisher":"","summary":"कबिनीच्या जंगलात सगळंच बिनसलं होतं – त्या वर्षी मोसमी पाऊस आला नव्हता आणि नेहमी जीप्समधून सफारीसाठी येणारी पर्यटक माणसं गायब झालेली दिसत होती. अखेर कबिनीमधले प्राणी आपली स्वतःची सफारी सुरू करण्यासाठी एकत्र जमले. कोविड-१९च्या दूरगामी परिणामांविषयीची एका वेगळ्या दृष्टिकोनातून लिहिलेली ही गमतीशीर कथा!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/498555/size7/8bee5577b1f9b703ded4771fa511230a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/498555/size7/8bee5577b1f9b703ded4771fa511230a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-350893","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-350893","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":789,"opdsId":"urn:uuid:SW-105680","title":"पिकूचं पिटुकलं जग","authors":["Rupali Bhave"],"language":"","readingLevel":"reading","publisher":"","summary":"पिकूला उन्हाळ्यातल्या दुपारच्या निवांत वेळा खूप आवडायच्या, पण अंधाऱ्या संध्याकाळी मात्र त्याला मुळ्ळीच आवडायच्या नाहीत. अचानक एक दिवस त्याच्या उन्हाळ्यातल्या दुपारीसुद्धा अंधारून गेल्या, कारण आता त्याला गोष्टी वाचून दाखवायला कुणीच उरलं नव्हतं. आता पिकूकडची पुस्तकं न वाचता तशीच पडून राहतील का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/157681/size7/ba42069ffa44213dbf0574fc90eefab9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/157681/size7/ba42069ffa44213dbf0574fc90eefab9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-105680","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-105680","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":790,"opdsId":"urn:uuid:SW-69594","title":"खांबांपासून महालांपर्यंत","authors":["Vandana Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"धीराला वेगवेगळ्या प्रकारच्या वास्तू खूप आवडतात. मग आई-बाबा तिला एक छोटसं विमान बनवून देतात. त्या विमानातून प्रवास करून ती वेगवेगळ्या ठिकाणच्या इमारती कशा बनवल्या आहेत, हे जाणून घेते.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/718098/size7/7ce9adf05af275eab0dd97cacb072a00.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/718098/size7/7ce9adf05af275eab0dd97cacb072a00.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-69594","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-69594","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":791,"opdsId":"urn:uuid:SW-114545","title":"या आरशात दडलंय कोण?","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"आरशामध्ये कोण दडून बसलंय? मनसा हे शोधून काढणारच आहे. चला, तिच्याबरोबर तुम्हीपण शोधा पाहू.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715292/size7/3607544f44e5bafa3e829994c2ba226d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715292/size7/3607544f44e5bafa3e829994c2ba226d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-114545","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-114545","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":792,"opdsId":"urn:uuid:SW-579334","title":"चाक बसलं रुसून!","authors":["Abhijit Pendharkar"],"language":"","readingLevel":"","publisher":"","summary":"एका चाकाला तापलेल्या रस्त्यावरून धावायला आणि अणकुचीदार दगडांवरून चालायला आवडत नाही. मग ते स्वतःसाठी नवीन वाहन शोधायला बाहेर पडतं. ट्रक त्याच्यासाठी असतो खूप मोठा, पण छोट्या सायकलशीही त्याचं जमत नाही. अखेर चाकाची गाठ एका लहान मुलासोबत पडते. हा मुलगा स्वतःसाठी मित्र शोधतोय. चाक त्या मुलाला मदत करू शकेल का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/371263/size7/ee9db84d7d1150b1c86336f3dc04360f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/371263/size7/ee9db84d7d1150b1c86336f3dc04360f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-579334","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-579334","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":793,"opdsId":"urn:uuid:SW-368127","title":"चहाच्या मळ्यातली सैर","authors":["Mrinalinee  Vanarase"],"language":"","readingLevel":"","publisher":"","summary":"आभा दार्जिलिंग या थंड हवेच्या ठिकाणी चालली आहे. वाटेत ती चहाच्या कारखान्यात थांबते. तिला कितीतरी प्रश्न पडले आहेत! चहा म्हणजे पान असतं का? ते कुठे वाढतं? चहा इतका मस्त कसा काय लागतो? चला, आपणसुद्धा तिच्यासोबत चहाचा मळा आणि चहाच्या कारखाना यांची सैर करून या प्रश्नांची उत्तरं शोधूया.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/422097/size7/b064c2ac77aba307892edb71ceb40ca9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/422097/size7/b064c2ac77aba307892edb71ceb40ca9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-368127","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-368127","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":794,"opdsId":"urn:uuid:SW-276881","title":"मिनीचं पहिलं मतदान","authors":["Varsha Gajendragadkar"],"language":"","readingLevel":"","publisher":"","summary":"मिनी आता सहावीत आहे. नुकताच तिला शाळेच्या निवडणुकीत मतदान करण्याचा अधिकार मिळाला आहे. शाळेचा विद्यार्थीप्रमुख निवडून देण्यासाठी तिला मत द्यावं लागणार आहे. तिनं नेमकं कुणाला निवडून द्यावं, सांगा बरं!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495450/size7/63481348a8ea5c976dae3fa5d1e70c72.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495450/size7/63481348a8ea5c976dae3fa5d1e70c72.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-276881","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-276881","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":795,"opdsId":"urn:uuid:SW-93308","title":"उन्हाळ्याच्या सुट्टीतली उबदार मैत्री","authors":["Rupali Bhave"],"language":"","readingLevel":"","publisher":"","summary":"इकडं उन्हाळ्याची सुट्टी संपत आली आहे आणि निम्मी मात्र आईनं सांगितलेली कामं करण्यातच अडकून पडली आहे. अगदी आत्ताचं काम म्हणजे शेजारच्या अक्काकडे अंडी पोचवणं. पण कदाचित या कंटाळवाण्या कामातून एका मस्त, मजेदार दिवसाची सुरुवात होईल का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/621804/size7/3dd5318d2513738716d8e20eae0d3a16.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/621804/size7/3dd5318d2513738716d8e20eae0d3a16.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-93308","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-93308","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":796,"opdsId":"urn:uuid:SW-171335","title":"ता.क.– या हवापाण्याचं बिघडलंय तरी काय?","authors":["Mrinalinee  Vanarase"],"language":"","readingLevel":"","publisher":"","summary":"कुठं खूप उकाडा आहे, तर कुठं खूप थंडी आहे. कुठं पाऊस नाही, तर कुठं खूप पाऊस आहे. कुठं बर्फ पडला नाही पुरेसा, तर कुठं हवेत खूप जास्त कार्बन आहे. भुऱ्या अस्वलांना कळतच नाहीये झोपावं की नाही. पेंग्विनना कळत नाहीये आता खावं तरी काय? कांगारू जंगलातल्या वणव्यातून निसटण्याचा प्रयत्न करताहेत. मधमाश्यांना कीटकनाशकांमुळे गुंगी येते आहे. हवामान बदलामुळे जगात इतके बदल होताहेत, आतातरी आपल्याला चिंता वाटायला हवी ना?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/234334/size7/e8a8b21f43aaa4d1a27745b56b34a5d1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/234334/size7/e8a8b21f43aaa4d1a27745b56b34a5d1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-171335","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-171335","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":797,"opdsId":"urn:uuid:SW-104704","title":"सगळयात तिखट नाक","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"झहराच्या आजीचं नाक सगळ्यांपेक्षा मोठं आहे. इतर कुणाला जाणवणारही नाहीत असे वास झहराच्या आजीला मात्र लगेच येतात. झहरालाही असंच ‘सुपरनाक’ हवंय. झहराला तिखट नाक मिळावं म्हणून ती आणि आजी जातात एका साहसी सफरीवर!  मग काय होतं?\nवाचू या एका मजेशीर गोष्टीत.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/179725/size7/15f364d92111de41f9eee020024db06a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/179725/size7/15f364d92111de41f9eee020024db06a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-104704","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-104704","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":798,"opdsId":"urn:uuid:SW-1303","title":"सगळी चूक त्या मांजराचीच!","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"एका खोडकर मांजरामुळे, या मुलाला त्याचा होमवर्क पूर्ण करता आला नाही म्हणे! अगदीच फालतू कारण वाटतंय ना? मग वाचा तर काय घडलं ते! एकातून दुसरं, आणि दुसऱ्यातून तिसरं, आणि चौथं… आणि…","coverUrl":"https://static.storyweaver.org.in/illustration_crops/696669/size7/8717a72070ac52bd090aeebc8e6b36e6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/696669/size7/8717a72070ac52bd090aeebc8e6b36e6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-1303","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-1303","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":799,"opdsId":"urn:uuid:SW-272304","title":"रॉयचं वाजणारं गुपित","authors":["Neeta Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"रॉयनं आपल्या आजीचा पैंजण घातलाय हे कुणालाच कळायला नको होतं. मात्र आपल्याला वाटत होतं, त्यापेक्षा हे गुपित राखणं अवघड आहे, हे लवकरच त्याच्या लक्षात आलं. अपराधी भावनेनं त्याला अगदी घेरून टाकलं. रॉयनं हा सगळा घोळ कसा घालून ठेवला आणि आता त्यातून तो मार्ग कसा काढणार? वाचा या मजेशीर गोष्टीत.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717407/size7/2ceccd52eb887c7a45da3ee2d7871842.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717407/size7/2ceccd52eb887c7a45da3ee2d7871842.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-272304","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-272304","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":800,"opdsId":"urn:uuid:SW-485669","title":"माझं घरकुल","authors":["Sayali Godse"],"language":"","readingLevel":"","publisher":"","summary":"घराला घरपण कशानं येतं? आवाज आणि आठवणी, मित्र-मैत्रिणी, प्राणी, वास आणि रंग हे सगळं मिळूनच! चला तर मग, बेला सोबत जाऊन तिचं घर पाहू या. ती आपलं घरात स्वागत करते आहे. नेहमीच्या साध्या, चार भिंतीच्या घरापेक्षा तिचं घरात खूप जास्त गंमत आहे.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/636954/size7/6a7950e041fc4a444ac4b3a10072e6b8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/636954/size7/6a7950e041fc4a444ac4b3a10072e6b8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-485669","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-485669","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":801,"opdsId":"urn:uuid:SW-138980","title":"धडा","authors":["Shobha Bhagwat"],"language":"","readingLevel":"","publisher":"","summary":"आमच्याकडं येणारे एक काका मला अजिबात आवडत नाहीत. कधीकधी ते माझ्याकडं टक लावून पाहत राहतात, तर कधीकधी ते मला अगदी जवळ घेतात. मग मी काय केलं असेल? तुम्ही स्वतःच वाचून पाहा ना!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727189/size7/f39c384dfaac4e928af0b8f1fa19d643.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727189/size7/f39c384dfaac4e928af0b8f1fa19d643.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-138980","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-138980","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":802,"opdsId":"urn:uuid:SW-18240","title":"कुहूऽऽ कुहूऽऽ !","authors":["Pratham Mumbai Team"],"language":"","readingLevel":"","publisher":"","summary":"कोकिळेचा मधुर आवाज शहरातील मुलांना ऐकायला मिळत नाही. आजोळी गेलेल्या राजूला\nकोकिळेचा आवाज ऐकून खूप गंमत वाटली त्याचीच ही गोष्ट आहे.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722314/size7/eaafe192563b3d5c62345ba000badfa8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722314/size7/eaafe192563b3d5c62345ba000badfa8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-18240","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-18240","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":803,"opdsId":"urn:uuid:SW-63684","title":"आपलं लाडकं घर","authors":["Varsha Gajendragadkar"],"language":"","readingLevel":"","publisher":"","summary":"आपल्या अवतीभवती नजर टाकलीत, तर तुम्हाला कितीतरी प्राण्यांची आणि पक्ष्यांची घरं दिसतील. ते राहत असणाऱ्या ठिकाणांची ही गोष्ट.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527543/size7/b7fb5ea8fe68a362a90b6a22b064780d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527543/size7/b7fb5ea8fe68a362a90b6a22b064780d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-63684","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-63684","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":804,"opdsId":"urn:uuid:SW-397","title":"बनी","authors":["Meera Tendolkar"],"language":"","readingLevel":"","publisher":"","summary":"बनी स्वप्नात तरंगते आणि अतिशय आश्चर्यकारक आणि अद्भुत जागी जाते. \nतुम्हाला तिच्याबरोबर तरंगायला आवडेल?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/700881/size7/a1a0cc5024ea7159fce4445c39ee8dd3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/700881/size7/a1a0cc5024ea7159fce4445c39ee8dd3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-397","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-397","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":805,"opdsId":"urn:uuid:SW-558516","title":"अफो आणि मी","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"विनोकाच्या आजूबाजूची प्रत्येक गोष्ट बदलते आहे - त्याचं गाव, तिथले पर्वत आणि आजूबाजूचं वातावरण बदलत चाललं आहे. आता तर त्याची बहीणही त्याला सोडून चालली आहे. या मोठ्या बदलांना विनोका कसं सामोरं जाणार आहे? हवामानबदलाच्या पार्श्वभूमीवर होणाऱ्या स्थलांतराची ही गोष्ट आहे. कधी नव्हे इतक्या प्रचंड वेगानं बदलणाऱ्या या जगात घर आणि कुटुंबाचं नेमकं स्थान काय असतं, ते समजावून सांगणारी ही एक अनोखी गोष्ट.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/626610/size7/b8db5239328fba7e9bbc9f8b7b71299e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/626610/size7/b8db5239328fba7e9bbc9f8b7b71299e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-558516","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-558516","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":806,"opdsId":"urn:uuid:SW-151291","title":"फ्लश  केल्यावर नेमकं काय घडतं?","authors":["Sai Keskar"],"language":"","readingLevel":"","publisher":"","summary":"नोझी नावाचा पाळीव उंदीर अचानक एका अपघातामुळं जमिनीखालच्या गटारांमध्ये वाहात जातो! सुदैवानं त्याला तिथे चिकी नावाची मैत्रीण भेटते. तिथल्या भुयारात खूप वेगानं पाणी वाहत असतं. चिकी कशी नोझीला एका साहसी भुयारी सफरीवर घेऊन जाते, वाचू या गोष्टीत!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/203168/size7/3d957f5d94c59837655fef02fa903ba4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/203168/size7/3d957f5d94c59837655fef02fa903ba4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-151291","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-151291","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":807,"opdsId":"urn:uuid:SW-56312","title":"सरू आणि तिचं इवलंसं गुपित","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"माई होत्या कडक शिस्तीच्या आणि सरूला तर असं सरळसोट वागणं मुळीच जमायचं नाही. त्यामुळे सरू कायम अडचणीत यायची. यावेळी तर एक अगदी वेगळीच गोष्ट घडली. माईंना ती कळली तर काय बरं होईल? हे पुस्तक वाचलंत तर कळ