weaver.org.in/illustration_crops/524702/size7/8b45d81a89d54fb0128f5b0aeeab4c60.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524702/size7/8b45d81a89d54fb0128f5b0aeeab4c60.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-366147","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-366147","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1175,"opdsId":"urn:uuid:SW-213164","title":"The Picnic","authors":["Nancy Siddhant Dogra"],"language":"","readingLevel":"","publisher":"","summary":"Five friends went to a forest. What will they do there? Let us read more to find out!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283708/size7/961bb11444e1ed0e553910f436a4620e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283708/size7/961bb11444e1ed0e553910f436a4620e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-213164","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-213164","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1176,"opdsId":"urn:uuid:SW-44616","title":"Ann-Nem-Oh-Nee Finds Adventure","authors":["Matthew  Griffiths"],"language":"","readingLevel":"","publisher":"","summary":"Ann-Nem-Oh-Nee is stuck on her rock all alone. She’s looking for adventure and wants to see the world! But how?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/85005/size7/9af6db2ff7d95fafd066f608b954c665.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/85005/size7/9af6db2ff7d95fafd066f608b954c665.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-44616","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-44616","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1177,"opdsId":"urn:uuid:SW-14561","title":"A Miaow and A Roar","authors":["Tanya Luther Agarwal"],"language":"","readingLevel":"","publisher":"","summary":"Vedika and Karan share a real adventure as they sit in Grandfather’s chair. Meet their friends, the lion and the cat in this fun story.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/40018/size7/d1e5bc76d62394c2859fdc1920374e28.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/40018/size7/d1e5bc76d62394c2859fdc1920374e28.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-14561","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-14561","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1178,"opdsId":"urn:uuid:SW-167682","title":"The Hare and the Tortoise (Again!)","authors":["Divaspathy Hegde"],"language":"","readingLevel":"","publisher":"","summary":"Remember how the slow and steady tortoise beat the arrogant hare in that great race long ago? Now the two are back together again, and they have a task to complete. Each knows that he cannot do it without the other, but can these two big rivals work together?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722326/size7/7f723423c6a3adfa5f807c1262f5a731.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722326/size7/7f723423c6a3adfa5f807c1262f5a731.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-167682","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-167682","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1179,"opdsId":"urn:uuid:SW-161985","title":"Our Little River","authors":["Sanghamitra Ghosh"],"language":"","readingLevel":"","publisher":"","