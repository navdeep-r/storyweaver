://static.storyweaver.org.in/illustration_crops/709418/size7/22151a159d215e955b9c33345d9ea352.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/709418/size7/22151a159d215e955b9c33345d9ea352.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-169","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-169","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":237,"opdsId":"urn:uuid:SW-374691","title":"Paint Day, Plant Day","authors":["Sanjana  Kapur"],"language":"","readingLevel":"","publisher":"","summary":"Avi enjoys plant day, music day and paint day, and being busy throughout the week. Join in as Avi potters about the house, in this book about noticing and recognising patterns.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/472786/size7/c73d494d112953afae92ffe68d3d5f6f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/472786/size7/c73d494d112953afae92ffe68d3d5f6f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-374691","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-374691","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":238,"opdsId":"urn:uuid:SW-1658","title":"Ammu's Puppy","authors":["Sowmya Rajendran"],"language":"","readingLevel":"","publisher":"","summary":"Ammu does not have a puppy. But she tells her friends that she does! Her puppy's name is Shankar, she says. Shankar loves bananas, she says. She tells them so much about Shankar that her friends want to come home and meet him. Now what will Ammu do?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/696665/size7/5c7d534c8828504a66ff3855ce3b80ab.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/696665/size7/5c7d534c8828504a66ff3855ce3b80ab.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-1658","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-1658","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":239,"opdsId":"urn:uuid:SW-122951","title":"Pranav the Pattern Detective","authors":["Aditya Swaminathan"],"language":"","readingLevel":"","publisher":"","summary":"It is an ordinary day for Pranav until he spots something special in a tree. This discovery sets him on a journey that changes the way he views the world around him. Shapes will never look the same again.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/182211/size7/1c0f7c208e02eb005dabac5c14150631.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/182211/size7/1c0f7c208e02eb005dabac5c14150631.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-122951","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-122951","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":240,"opdsId":"urn:uuid:SW-162976","title":"Annual Haircut Day- ONCE AGAIN!","authors":["Rohini Nilekani"],"language":"","readingLevel":"","publisher":"","summary":"Sringeri Srinivas is back! It is  Annual Haircut Day, once again. But there is a lockdown in his village due to the Coronavirus pandemic. The barbershop is closed. What will the lovable banana farmer do this time?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703827/size7/86b351e48d9884f3c7b9cdaf770d1a08.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703827/size7/86b351e48d9884f3c7b9cdaf770d1a08.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-162976","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/ap