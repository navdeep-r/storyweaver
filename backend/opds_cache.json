49/size7/ea093afce102eff3bd37d3abdb75c9a9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-430346","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-430346","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":503,"opdsId":"urn:uuid:SW-63639","title":"La Fée rouge","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Meeto est passionnée de voitures. Elle en rêve même la nuit ! Un jour, elle découvre Fée rouge, une voiture magique qui fait des choses qu'aucune autre voiture ne peut faire.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723056/size7/138cccb6d8231292bbf0af57dc90a152.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723056/size7/138cccb6d8231292bbf0af57dc90a152.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-63639","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-63639","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":504,"opdsId":"urn:uuid:SW-65657","title":"Le bonbon au chocolat","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Tutul veut offrir un bonbon au chocolat à son amie pour l'anniversaire de celle-ci. Mais aucun membre de sa famille ne peut aller le lui acheter. Tutul parviendra-t-elle à convaincre le marchand de lui donner un bonbon au chocolat ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/646387/size7/ff1df4b48c7dcd320e96152a03c86f3e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/646387/size7/ff1df4b48c7dcd320e96152a03c86f3e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-65657","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/s