atic.storyweaver.org.in/illustration_crops/721934/size7/f35be74fc3bef97057a90688a52adc0c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-630743","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-630743","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":917,"opdsId":"urn:uuid:SW-137652","title":"ಆಲೋಚಿಸಿ ಆಚರಿಸುವವನೆ ಜಾಣ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಸ್ವಂತ ಆಲೋಚನೆಯನ್ನೇ ಮಾಡದೆ ಗೆಳೆಯನ ಸಲಹೆಯಂತೆ ನಡೆದುಕೊಳ್ಳಲು ಒಬ್ಬನು ಪ್ರಯತ್ನಿಸುತ್ತಾನೆ. ಪರಿಣಾಮ ಏನಾಗಬಹುದೆಂದು ಭಾವಿಸುತ್ತೀರಿ ನೀವು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/99516/size7/5717eeb81f7e16ed04c71d00881764bb.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/99516/size7/5717eeb81f7e16ed04c71d00881764bb.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-137652","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-137652","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":918,"opdsId":"urn:uuid:SW-544691","title":"ಮೊದಲ ಮನೆ","authors":["Geetha M."],"language":"","readingLevel":"","publisher":"","summary":"ಬಹಳ ಬಹಳ ದಿನಗಳ ಹಿಂದೆ, ಜನರು ಕಾಡಿನಲ್ಲಿ ವಾಸಿಸುತ್ತಿದ್ದಾಗ, ಇಬ್ಬರು ಅಣ್ಣತಮ್ಮಂದಿರು, ಈಶಾನ್ಯ ಭಾರತದ, ಈಗ ಅರುಣಾಚಲ\nಪ್ರದೇಶ ಎನಿಸಿಕೊಂಡಿರುವ ಪ್ರದೇಶದಲ್ಲಿ, ಒಂದು ಮನೆಯನ್ನು\nಕಟ್ಟಲು ನಿರ್ಧರಿಸಿದರು. ಈ ಜಾನಪದ ಕತೆಯಲ್ಲಿ ಮೊದಲ\nಮನೆಯನ್ನು ಕಟ್ಟಿದ್ದು ಹೇಗೆ ಎಂಬುದರ ಬಗ್ಗೆ ತಿಳಿಯುತ್ತೇವೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/699943/size7/0e15576e8c73b38bf8275d54a2d1bf1d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/699943/size7/0e15576e8c73b38bf8275d54a2d1bf1d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-544691","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-544691","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":919,"opdsId":"urn:uuid:SW-221655","title":"ಬಂಟಿ ಮತ್ತು ಗಾಳಿಪಟ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಬಂಟಿಗೆಂದು ಅವನ ಅಪ್ಪ ತಂದ ಗಾಳಿಪಟ ನೀರಿನಲ್ಲಿ ನೆಂದು ಹೋಯಿತು. ಮುಂದೇನಾಯಿತು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283165/size7/184bb3160617d029a3fc16e15dd351af.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283165/size7/184bb3160617d029a3fc16e15dd351af.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-221655","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-221655","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":920,"opdsId":"urn:uuid:SW-446678","title":"ಬೊಮ್ಮಕ್ಕನ ಬೊಂಬೆ","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಸಾಂಪ್ರದಾಯಿಕ ಶೈಲಿಯಲ್ಲಿ ತಯಾರಿಸಲಾಗುವ ತಂಜಾವೂರಿನ ಬೊಂಬೆಯ ಒಂದು ಸುಂದರ ಕತೆಯನ್ನು ಗೀತರೂಪದಲ್ಲಿ ಕಟ್ಟಿಕೊಡಲಾಗಿದೆ. ದಕ್ಷಿಣ ಭಾರತದ ತಂಜಾವೂರು “ತಲೈ ಆಟೈ ಬೊಮ್ಮೆ”ಯಿಂದ ಸ್ಫೂರ್ತಿಗೊಂಡು ಒಂದು ಮುದ್ದೆ ಮಣ್ಣು ಬೊಂಬೆಯಾಗಿ ತಯಾರಾದ ಬಗೆಯನ್ನು ಈ ಪುಸ್ತಕ ವಿವರಿಸುತ್ತದೆ. ಮಕ್ಕಳ ಓದಿಗೆ ಸುಲಭವಾಗಿ ದಕ್ಕುವ ಭಾಷೆ ಹಾಗೂ ಪದಗಳನ್ನು ಬಳಸಲಾಗಿದೆ. ಕರಕುಶಲ ಕಲೆಯಲ್ಲಿ ಬೊಂಬೆಯನ್ನು ಮಾಡುವ ಪೂರ್ಣ ಚಿತ್ರವನ್ನು ಮಕ್ಕಳಿಗೆ ಈ ಕಥಾನಕ ಕಟ್ಟಿಕೊಡುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/114328/size7/087d139e9e25a4db2e8af7c0435a63bc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/114328/size7/087d139e9e25a4db2e8af7c0435a63bc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-446678","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-446678","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":921,"opdsId":"urn:uuid:SW-441220","title":"ಸುರುಸುರುಳಿ ಸುತ್ತಿ","authors":["Hema Khurshapur"],"l