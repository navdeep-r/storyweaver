aver.org.in/illustration_crops/527477/size7/ec03a8394b99362fadf3d7773b55ce92.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527477/size7/ec03a8394b99362fadf3d7773b55ce92.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-101804","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-101804","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":274,"opdsId":"urn:uuid:SW-16721","title":"Les émotions","authors":["Cyrille Largillier"],"language":"","readingLevel":"","publisher":"","summary":"Lis cette petite histoire pour voir combien de choses nous ressentons en seulement un jour !","coverUrl":"https://static.storyweaver.org.in/illustration_crops/40485/size7/df628cafd40f537f4787fbd20da95b90.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/40485/size7/df628cafd40f537f4787fbd20da95b90.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-16721","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-16721","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":275,"opdsId":"urn:uuid:SW-25260","title":"Comment vais-je m'habiller aujourd'hui ?","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Certains matins, c'est très difficile de savoir comment s'habiller. Dans cette histoire, la petite fille essaie beaucoup de vêtements avant de trouver la tenue parfaite.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/2289/size7/466aacc8ac4a2d255bdf88b7bf413bee.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/2289/size7/466aacc8ac4a2d255bdf88b7bf413bee.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-25260","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"http