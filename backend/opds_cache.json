ic.storyweaver.org.in/illustration_crops/495000/size7/10b0e201c8fb0d5fedea18e9d76933dd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-26712","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-26712","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":458,"opdsId":"urn:uuid:SW-317825","title":"Yapo apprend à jouer collectif","authors":["Cyrille Largillier"],"language":"","readingLevel":"","publisher":"","summary":"Yapo adore jouer au football ! Mais il n'aime pas passer le ballon à ses coéquipiers. Comment Yapo découvrira-t-il que gagner ne consiste pas seulement à marquer des points ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/329657/size7/e7b79cb9ca651a12689b993d2df91702.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/329657/size7/e7b79cb9ca651a12689b993d2df91702.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-317825","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-317825","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":459,"opdsId":"urn:uuid:SW-62405","title":"Kanchha, le petit rhinocéros perdu","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Kanchha, le petit rhinocéros adore partir à l'aventure tout seul dans la savane. Un jour, il s'éloigne trop loin de sa maman et se perd. Découvre dans ce livre quels dangers il va devoir affronter.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/99520/size7/f72be906c0cf11b24dce19f4ac8da635.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/99520/size7/f72be906c0cf11b24dce19f4ac8da635.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-62405","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisitio