cation/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":763,"opdsId":"urn:uuid:SW-558522","title":"अंधाराचा आवाज कसा असतो?","authors":["Rupali Bhave"],"language":"","readingLevel":"","publisher":"","summary":"भावना कशा जाणवतात? प्रेमाचा गंध कसा असतो? जादू म्हणजे काय? एरवी आपण रोजच्या जगण्यात डोळेझाक करत असलेल्या गोष्टींमध्ये एक खोल बुडी मारू या. सगळं जवळून, नीट बघू या, लक्षपूर्वक ऐकू या आणि प्रत्येक गोष्टीतली नवलाई साजरी करू या!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727644/size7/ffa8aee73935162cd6a249a70158794e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727644/size7/ffa8aee73935162cd6a249a70158794e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-558522","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-558522","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":764,"opdsId":"urn:uuid:SW-69591","title":"इंकूची खादाडी","authors":["Asmita Chitale"],"language":"","readingLevel":"","publisher":"","summary":"उडणारा खाऊ, सरपटणारा खाऊ, उड्या मारणारा खाऊ – इंकूला सारखा नवनवा गंमतीशीर असणारा खाऊ खायला मिळात होता. इंकूसोबत आपणही जंगल्यातल्या इतर प्राण्यांना भेटू या, तिच्या अनोख्या साहसातही सामील होऊ या!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725073/size7/69e9284a5c48d58e27d99ecef90b3803.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725073/size7/69e9284a5c48d58e27d99ecef90b3803.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-69591","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-69591","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":765,"opdsId":"urn:uuid:SW-110180","title":"मेगन आणि भटकणाऱ्या पाषाणाचं रहस्य","authors":["Meera Joshi"],"language":"","readingLevel":"","publisher":"","su