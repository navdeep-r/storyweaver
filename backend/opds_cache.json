c5a97f7cea234d4a65.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/83442/size7/2499ede9af5c09c5a97f7cea234d4a65.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-234668","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-234668","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1354,"opdsId":"urn:uuid:SW-538634","title":"Dunia Kallu 1: Masalah Besar Lagi!","authors":["Iona Stella Lumban Tobing"],"language":"","readingLevel":"","publisher":"","summary":"Kallu kembali terlambat ke sekolah. Ke mana dia membuat kambingnya kabur kali ini? Siapa yang sakit? Dia benar-benar butuh alasan ... yang meyakinkan.\nSelamat datang di Khajuria, sebuah desa tempat Kallu muda dan teman-temannya berpetualang seru hampir setiap hari. Kadang mereka mempertanyakan tradisi desa, melawan penindas, atau hanya menjalani hari-hari seperti biasa. Intinya, selalu ada yang dilakukan Kallu dan teman-temannya.\nBergabunglah bersama mereka saat mereka makin bijak dan menyenangkan, saat mereka menjelajahi desa dengan gembira dan menemukan berbagai kegiatan baru. Cari tahu apa rencana mereka!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703474/size7/aebdec85f3efee3cc067e575ca2d0d42.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703474/size7/aebdec85f3efee3cc067e575ca2d0d42.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-538634","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-538634","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1355,"opdsId":"urn:uuid:SW-540236","title":"Si Jago yang Sok Jago","authors":["Ahmad Husni"],"language":"","readingLevel":"","publisher":"","summary":"Si Ayam Jago Merah membangga-banggakan keberaniannya. Temukan apa yang terjadi saat seekor elang mendatanginya.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/166659/size7/6f45111d9fbe15e759b71424683468be.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/166659/size7/6f45111d9fbe15e759b71424683468be.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-540236","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-540236","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1356,"opdsId":"urn:uuid:SW-135629","title":"UFudu uthola ikhaya lakhe","authors":["Nal’ibali"],"language":"","readingLevel":"","publisher":"","summary":"Ngelinye ilanga uFudu wayezihambela endle. Wayefuna ndawo zonke. Wayesinga kude aphinde anciphise amehlwana otshanini......","coverUrl":"https://static.storyweaver.org.in/illustration_crops/155655/size7/e111449adb4271c522d46faaee259b6b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/155655/size7/e111449adb4271c522d46faaee259b6b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-135629","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-135629","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1357,"opdsId":"urn:uuid:SW-147161","title":"សង្រ្គាម​រវាង ​រ៉ូស និង​រ៉ក់​គី​​ ជាមួយ​សត្វល្អិត","authors":["Samnang Chan"],"language":"","readingLevel":"","publisher":"","summary":"រ៉ូស​ និង រ៉ក់គី ​ស្អប់​សត្វល្អិតពីព្រោះពួកវាខាំ និងទិច​មនុស្ស​។ តើអ្វីដែលធ្វើឱ្យពួកគេផ្លាស់ប្តូរគំនិត? ចូលរួមជាមួយ រ៉ូស​ និង រ៉ក់​គី ​ក្នុងដំណើរផ្សងព្រេងរបស់ពួកគេនៅក្នុងសៀវភៅដ៏រីករាយអំពីសត្វល្អិតនេះ​។","coverUrl":"https://static.storyweaver.org.in/illustration_crops/714311/size7/317e0f3d88d4ec8ebba29fa9ac49379f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/714311/size7/317e0f3d88d4ec8ebba29fa9ac49379f.jpg","acquis