.in/api/v0/story/epub/SW-16552","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":56,"opdsId":"urn:uuid:SW-236168","title":"बघा बघा, किती ही गंमत!","authors":["Sushrut Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"एखाद्या घरात बघण्यासारख्या कितीतरी गमती-जमती असतात ना! खूप साऱ्या लहान-मोठ्या गोष्टी, प्राणी आणि माणसं यांनी मिळूनच तर घर बनतं ना? चला, आपणही या उमा नावाच्या रांगणाऱ्या बाळासोबत तिचं घर पाहू या.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/315559/size7/ca9efae074f72f3550506be13013256d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/315559/size7/ca9efae074f72f3550506be13013256d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-236168","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-236168","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":57,"opdsId":"urn:uuid:SW-12992","title":"वैमानिक आर्या","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"आर्याने नेहमी विमानातून उडायचं स्वप्न पाहायची. आर्याने हे स्वप्न कसं पूर्ण केलं आणि ती काॅकपीटपर्यंत वैमानिक म्हणून कशी पोचली  ते वाचा. आर्यासाठी हा खरंच एक खास दिवस आहे.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/713815/size7/86bf40b3b913d9d94bc04157998a8257.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/713815/size7/86bf40b3b913d9d94bc04157998a8257.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12992","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12992","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":58,"opdsId":"urn:uuid:SW-52195","title":"वेटलिफ्टिंग करणारी राजकुमारी","authors":["Bhagyashree Kenge"],"language":"","readingLevel":"","publisher":"","summary":"राजकुमारी नीला तिच्या राज्यात होणाऱ्या सूर्या वेटलिफ्टिंग या सुप्रसिद्ध स्पर्धेचं विजेतेपद मिळवण्यासाठी उत्सुक आहे. मात्र, त्यासाठी तिला कितीतरी अडचणींवर मात करावी लागणार आहे.  सोबतच तिला एक देखणा राजकुमार आणि तिच्या पालकांच्या अपेक्षासुद्धा पूर्ण करायच्या आहेत.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/128169/size7/f54d978ae723b040027c6084b41e2e86.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/128169/size7/f54d978ae723b040027c6084b41e2e86.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-52195","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-52195","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":59,"opdsId":"urn:uuid:SW-300074","title":"पहिली ओळख - फळे आणि भाज्यांशी","authors":["Asmita Chitale"],"language":"","readingLevel":"","publisher":"","summary":"आपल्या आजूबाजूला किती वेगवेगळ्या प्रकारची फळं आणि भाज्या दिसत असतात ना! पण तुम्हाला त्यांची नावं ठाऊक आहेत का? आपल्या आजूबाजूंच्या गोष्टींचा परिचय करून देणाऱ्या पुस्तकांच्या मालिकेतल्या या पुस्तकाच्या मदतीने काही फळं आणि भाज्या यांची ओळख करून घेऊ या.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727076/size7/3e0038c6ea6a361551139c213fa482fa.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727076/size7/3e0038c6ea6a361551139c213fa482fa.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-300074","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-300074","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":60,"opdsId":"urn:uuid:SW-1104","title":"हत्ती पक्षी आणि मुनिया","authors":["Neha Taksale"],"language":"","readingLevel":"","publisher":"","summary":"मुनियाला ठाऊक होतं की त्या मोठ्ठ्या हत्ती पक्ष्यानं घोडा गिळलेला नाही. म्हणजे घोडा गिळण्याइतका तो पक्षी मोठा असला तरी! मग अधानिया गावातून घोडा कसा गायब झाला? एक जादूई पक्षी आणि एक साहसी, चतुर मुलगी यांची ही कथा.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/26861/size7/18a9841b7435cd9eef01a71ba77e99ab.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/26861/size7/18a9841b7435cd9eef01a71ba77e99ab.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-1104","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-1104","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":61,"opdsId":"urn:uuid:SW-16087","title":"लालची उंदीरमामा","authors":["Pratham Mumbai Team"],"language":"","readingLevel":"","publisher":"","summary":"लोभीपणा केल्याबद्दल उंदराला धडा मिळाला...","coverUrl":"https://static.storyweaver.org.in/illustration_crops/118175/size7/74a688ee10cc7264d20523334bd5c41c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/118175/size7/74a688ee10cc7264d20523334bd5c41c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-16087","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-16087","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":62,"opdsId":"urn:uuid:SW-15397","title":"का बरं का?","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"ही गोष्ट वाचून, एकमेकांना अशी फुगलेली तोंडं करून दाखवायला मजा येईल.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721026/size7/af4bab29430c70afc836892055d9e3e8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721026/size7/af4bab29430c70afc836892055d9e3e8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15397","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15397","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":63,"opdsId":"urn:uuid:SW-13727","title":"सगळ्यात उत्तम घर","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"मोठं, छोटं, गोलगोल, चौकोनी, जड, हलकं - घरं खूप प्रकारची असतात... ती वेगवेगळ्या प्रकारची का असतात, ते समजून घेऊ या. स्वतःचं घर बनवू या. घर कसं बांधतात, ते आमची छोटी आर्किटेक्ट दाखवेल ना तुम्हाला!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/724108/size7/44fe170ad046b14664899d1727befc14.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/724108/size7/44fe170ad046b14664899d1727befc14.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-13727","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-13727","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":64,"opdsId":"urn:uuid:SW-30080","title":"जुन्या जगाचे रहिवासी","authors":["Mrinalinee  Vanarase"],"language":"","readingLevel":"","publisher":"","summary":"लाखो वर्षांपूर्वी आपलं जग कसं असेल? इथं कोणते प्राणी-पक्षी वावरत असतील? तेव्हाची जंगलं कशी असतील? हे सारं शोधून काढता येतं. कसं माहिती आहे? पॅलिआँटोलॉजी म्हणजे पुराजीवशास्त्र नावाची विज्ञानाची शाखा हे शोधून काढायला आपल्याला मदत करते. पुराजीवशास्त्र म्हणजे पूर्वी होऊन गेलेल्या प्राण्यांचा पुराव्यांच्या मदतीनं केलेला अभ्यास. बघूया का आत डोकावून?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/724109/size7/ffde7fb4ad46096f5a5b5ac794c0dfce.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/724109/size7/ffde7fb4ad46096f5a5b5ac794c0dfce.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-30080","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-30080","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":65,"opdsId":"urn:uuid:SW-39723","title":"तरंगणारी जहाजं आणि बुडणारे चमचे","authors":["Sai Keskar"],"language":"","readingLevel":"","publisher":"","summary":"छोटे चमचे पाण्यात बुडतात, पण भलीमोठी जहाजं मात्र त्यावर तरंगतात. हे काय कोडं आहे बुवा? तेन्झिन आणि ताशी हे दोन छोटे तिबेटी भिक्षू आणि त्यांच्या मठातले जेनला हे सगळ्यांचे लाडके कथाकार यांना हे कोडं पडलंय. हे तिघं यामागचं रहस्य शोधून काढायचा प्रयत्न करतात. \nविज्ञानाच्या शिक्षिका  सोनमताई त्यांना मदत करतात. आणि मग, कागदी बोटी, एक सफरचंद, एक चमचा आणि पाण्यानं भरलेला टब  यांच्या  साहाय्यानं हे कोडं उलगडतं.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717230/size7/b192003f504666cffb50823a65999e64.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717230/size7/b192003f504666cffb50823a65999e64.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-39723","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-39723","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":66,"opdsId":"urn:uuid:SW-337","title":"खेळता-खेळता","authors":["Utkarsha Manish"],"language":"","readingLevel":"","publisher":"","summary":"गोलू आणि छोटूचे अद्भुत कारनामे वाचा.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721916/size7/906e74898bf061f7abefb75c6319ad63.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721916/size7/906e74898bf061f7abefb75c6319ad63.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-337","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-337","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":67,"opdsId":"urn:uuid:SW-4972","title":"दम-ए-दम बिर्याणी!","authors":["Meera Joshi"],"language":"","readingLevel":"","publisher":"","summary":"बाशा आणि साईनबीच्या पोटात उठलाय गोळा. त्यांची अम्मी आजारी आहे आणि इकडं सायरामावशीनं तिच्या २३ मित्र-मैत्रिणींना घेऊन रात्री जेवायला त्यांच्याकडं येण्याची वर्दी दिली आहे. लहान बाशा पाककला शिकतो आहे. त्यामुळं अम्मी करते तशी दम बिर्याणी आपल्याला करता येईल असं त्याला वाटतं. पण अम्मी नेहमी फक्त ४ जणांची बिर्याणी शिजवते. मग २४ जणांसाठी किती आणि कशी बिर्याणी करायची हे सांगायला साईनबी पुढं सरसावते! कारण ती आहे गणितातला किडा. शेवटी दोघं बहीण-भाऊ चटकदार दम बिर्याणी शिजवतात का? वाचा तर या गोष्टीत!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/710992/size7/148136331161fe3faf86e1ff30c0f59d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/710992/size7/148136331161fe3faf86e1ff30c0f59d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-4972","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-4972","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":68,"opdsId":"urn:uuid:SW-554","title":"बुजगावण्यांची वरात","authors":["Varsha Gajendragadkar"],"language":"","readingLevel":"","publisher":"","summary":"पक्षी आणि प्राण्यांनी शेतात घुसू नये म्हणून त्यांना घाबरवण्यासाठी शेतात बुजगावणी उभारतात. पण छोट्या गौरीला मात्र काही वेगळंच वाटतं!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721021/size7/9448fd2878fc1f55703df493c6ddd850.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721021/size7/9448fd2878fc1f55703df493c6ddd850.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-554","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-554","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":69,"opdsId":"urn:uuid:SW-40324","title":"जादूची दुर्बीण","authors":["Meera Joshi"],"language":"VR","readingLevel":"","publisher":"","summary":"मरियम आणि तेजसकडे एक जादूची दुर्बीण आहे. या दुर्बीणीतून ते जगातल्या विशिष्ट भागात आढळणारे ७ प्राणी आणि पक्षी बघतात. चला तर मग, पाहूया आपणही त्यांच्याबरोबर...","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726794/size7/cff02b8fce687b1661207ff8aaf460c1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726794/size7/cff02b8fce687b1661207ff8aaf460c1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-40324","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-40324","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":70,"opdsId":"urn:uuid:SW-15559","title":"तीन फुकट","authors":["Utkarsha Manish"],"language":"","readingLevel":"","publisher":"","summary":"कोणे एकेकाळी, एका डोंगराजवळच्या छोट्याशा गावात एक\nम्हातारा लाडू विकायला आला. एक पैशाला एक, दोन पैशाला\nदोन आणि तीन लाडू घेतले तर फुकट. गावकर्यांचा विश्वासच\nबसेना. असे फुकटात लाडू कोण देईल? पण ते खरंच आहे असं\nजेव्हा लक्षात आलं तेव्हा सगळ्यांनी अफाट लाडू खायला सुरवात\nकेली. लोभीपणा एवढ्या थराला गेला की डोंगराचा काही भाग\nनष्ट होतो आहे हेही त्यांच्या लक्षात आलं नाही. तैवानमधील ही\nरंजक लोककथा वाचा म्हणजे कळेल की असं का झालं?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/699933/size7/53190cd41d58e95d07ea58dae0b26e02.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/699933/size7/53190cd41d58e95d07ea58dae0b26e02.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15559","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15559","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":71,"opdsId":"urn:uuid:SW-12812","title":"रात्रीच्या गोष्टी","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"चला, पांघरुणात लपेटून बसा. हा छोटा मुलगा झोपण्यापूर्वी त्याची आई सांगते, त्या गोष्टींची  ही गोष्ट.","coverUrl":"https://static.storyweaver.org.in/illustrati