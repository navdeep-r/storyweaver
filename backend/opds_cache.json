n/api/v0/story/pdf/SW-104685","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-104685","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":654,"opdsId":"urn:uuid:SW-24888","title":"बँडीकोटा बेंगालेन्सिसचा गुंफाशोध","authors":["Mrinalinee  Vanarase"],"language":"","readingLevel":"","publisher":"","summary":"बँडीकोटा बेंगालेन्सिस काही साधीसुधी घूस नव्हती. तिला नवं नवं शोधून काढण्याचा नाद होता. दर संध्याकाळी आपलं सामान बांधायची. त्यात तिचा गॉगल असायचा, दुर्बिण, भिंगं आणि हो तिचे आवडते स्टीकर बँडेजसुद्धा असायचे. एवढ्या तयारीनिशी ती नवं काही शोधायला निघायची. “ज्याला नवं काही शोधायचं असेल त्यानं नेहेमी कसं तयार असलं पाहिजे” असं ती म्हणे. एकदा रात्रभर खणून तिनं चक्क समुद्र किनारा गाठला होता. या अनोख्या मुशाफिराला यावेळी एक नवीनच ठिकाण सापडलंय. भारतातल्या एका प्राचीन पर्वतातील एक प्राचीन गुंफा. चला तर मग तिच्या सोबत गुंफा-सफरीला.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117031/size7/51df7e3258940334c16aef2ad8a6f8e6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117031/size7/51df7e3258940334c16aef2ad8a6f8e6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-24888","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-24888","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":655,"opdsId":"urn:uuid:SW-27332","title":"लयाताईच्या भन्नाट मोटरबाईकला फळं आवडत नाहीत","authors":["Sayali Godse"],"language":"","readingLevel":"","publisher":"","summary":"मिस लया या शाळेत खेळ शिकवणाऱ्या शिक्षिकेला लोकांना मदत करायला आवडतं. यावेळी ती आणि तिची भन्नाट मोटरबाईक एका चवदार आणि रसाळ प्रवासाला निघाले आहेत. चला, आपणही जाऊया त्यांच्याबरोबर. \nलयाताई आणि तिची भन्नाट मोटरबाईक या मालिकेतील हे चौथं पुस्तक.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117410/size7/d9218a9f899048e494ea1c5f77ed52da.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117410/size7/d9218a9f899048e494ea1c5f77ed52da.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-27332","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-27332","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":656,"opdsId":"urn:uuid:SW-15546","title":"तुटक्या चोचीचा पोपट","authors":["Varsha Gajendragadkar"],"language":"","readingLevel":"","publisher":"","summary":"कुठलं लहान मूल भिंतीवर चित्र काढत नाही? पण छोट्या कासनीनं असं केलं तेव्हा गडबडच झाली. पेन तर तुटलंचं पण पोपटाची चोचपण तुटली. एका बाजूला कासनीचे बाबा आणि दुसऱ्या बाजूला तो पोपट, बिचारी कासनी  करणार तरी काय? चला, वाचूया, शेवटी काय घडतं?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721669/size7/7d6642454b991b38b7f71875a6519140.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721669/size7/7d6642454b991b38b7f71875a6519140.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15546","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15546","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":657,"opdsId":"urn:uuid:SW-149770","title":"अद्भुत मानवी शरीर","authors":["Varsha Gajendragadkar"],"language":"","readingLevel":"","publisher":"","summary":"मानवी शरीर अद्भुत आहे! चला, जाणून घेऊया, शरीरातल्या सर्वात लहान स्नायूपासून ते सर्वात मोठ्या अवयवापर्यंत आपलं शरीर कसं काम करतं ते!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715624/size7/0dcd3ef638a6ecafa3be7866467e9335.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715624/size7/0dcd3ef638a6ecafa3be7866467e9335.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-149770","type":"application/pdf+zip","rel":"http://opds-spec.or