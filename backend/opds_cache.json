ication/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-347","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":473,"opdsId":"urn:uuid:SW-377680","title":"कट कट चुर चुर","authors":["Sai Keskar"],"language":"","readingLevel":"","publisher":"","summary":"स्वयंपाकाचा दिवस अवीला खूप आवडतो. शिवाय घरातल्या सगळ्यांना मदत करायलाही त्याला फार आवडतं. आकृतिबंध पाहायला आणि ओळखायला शिकवणार्‍या या अनोख्या पुस्तकात अवीसोबत त्याच्या स्वयंपाकघरात काय काय दिसतंय, हे आपणही बघू या.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/461865/size7/c5024bc800308b02341e8e8878c2507c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/461865/size7/c5024bc800308b02341e8e8878c2507c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-377680","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-377680","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":474,"opdsId":"urn:uuid:SW-15719","title":"कासवाची गोष्ट","authors":["Utkarsha Manish"],"language":"","readingLevel":"","publisher":"","summary":"सूर्यप्रकाशाने उबवलेल्या अंडयांतून रात्रीच्या अंधारात ऑलिव्ह रिडली कासवांची पिले बाहेर येतात. त्यातील एक पिल्लू या कथेचे वर्णन करते आहे. किनाऱ्यावरून महासागराची वाट कुठेही न चुकता व न पकडले जाता पार केल्याबद्दल त्याला आनंद आहे.\nपण महासागरातले सर्व धोके हे छोटेसे ऑलिव्ह रिडली पार करू शकेल? प्राणघातक शार्क माशांपासून, भयंकर जाळयांतून आपले संरक्षण करत ती मोठी होईल का? ती स्वतःचे घरटे बनवून त्यात अंडी घालण्याचा आनंद अनुभवू शकेल का?\nऑलिव्ह रिडली कासवाच्या या मनोगतामध्ये ती इतर मनोरंजक प्राण्यांना तिच्या प्रवासात कशी भेटते ते वाचा.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/27753/size7/e21f0014824d4500d005ff02b9529442.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/27753/size7/e21f0014824d4500d005ff02b9529442.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15719","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15719","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":475,"opdsId":"urn:uuid:SW-33462","title":"विसराळू आज्जा","authors":["Vandana Atre"],"language":"","readingLevel":"","publisher":"","summary":"आज्जा त्याच्या संध्याकाळच्या फिरण्यासाठी तयार होत आहेत. पण लागणाऱ्या सगळ्या गोष्टींची त्यांना नेहेमी आठवण राहतेच असं नाही. सुदैवानं सुज्जू त्यांना मदत करायला हजर आहे. या पुस्तकात ’विरुद्धार्थी शब्द’ या संकल्पनेचा शोध घेतलेला आहे.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/63222/size7/80e0c49ab4a062ed86712a78b846f0a0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/63222/size7/80e0c49ab4a062ed86712a78b846f0a0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-33462","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-33462","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":476,"opdsId":"urn:uuid:SW-8345","title":"दात घासण्यात कसली आलीय मजा?","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"रोहनला दात घासायला मुळीच आवडत नाही आणि अंघोळ करायचाही कंटाळा येतो. पण त्याची बहीण त्याला एक गमाडी- गम्मत सांगते. आणि मग काय, रोहन बदलूनच जातो!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527487/size7/3b22d4a144943a8e5648a8ff9a4364de.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527487/size7/3b22d4a144943a8e5648a8ff9a4364de.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-8345","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-8345","type":"application/epub+zip","rel":"http://opds-spe