/pdf/SW-151884","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-151884","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1077,"opdsId":"urn:uuid:SW-187206","title":"ঘোর প্যাঁচ অটঃ গণ্ডগোল","authors":["Kalicharan Kora"],"language":"","readingLevel":"","publisher":"","summary":"খজুরিয়ারে আপেকে জহার - অকা হাতুরে কল্লু অটঃ আয়াঃ দল প্রায় দিনমগে মজা্রেন কীর্তি কড়ায়াকু। মিশে মিশে-দ আঙকু টলারেন আংকোঃ পরম্পরা নিয়ে জাগার রাকাএয় কু, মিশে মিশে-দ \nধুরত্তু হনকুরেন সামাংরে তিঙ্গুনাকু, বা দিনুমরেন কামিরে ব্যস্ত ধনঃআকু, কিন্তু কল্লু আয়াঃ দল যত কিছুরেন নাতিঃ সামটা ধনঃআকু। আংকোঃ লঃঅ দহন কতেঃ লেলেম আংকু চিংকে মাড়াং হারাঃআকু, বুদ্ধি হুয়োঃঅ, অটঃ রৌস্করে হাতুরে ঘুরো ভারাঃআকু নাওয়া কামি পাঞ্জা নাতিঃ, অটঃ লেলেম আংকু চিনাঃ চিনাঃ পাঞ্জা নামেয়াকু। কল্লু অটঃ ইস্কুল নাতিঃ দেরি কাঃআয়। মেরমটিকেঃ অটঃ কথাং নির গামাতিঃইয়ায়? অকেয়াঃ হরমো বেশ বাঃআয় না নাহা? অম্মী সিঃ আয়াঃ হাগাতে? আয়াঃ খুঃগে মিঞেঃ গল্পরেন দরকারা...মিঞেঃ বুগিন গল্প...পাথিয়ে লাকাঃ গল্প...আয়াঃ থাং মেনাঃসিঃ নেকা মিঞেঃ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703474/size7/aebdec85f3efee3cc067e575ca2d0d42.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703474/size7/aebdec85f3efee3cc067e575ca2d0d42.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-187206","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-187206","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1078,"opdsId":"urn:uuid:SW-108378","title":"Mnu. Mbhobo ophethwe buthongo","authors":["African Storybook Project Team"],"language":"","readingLevel":"","publisher":"","summary":"Ngelinye ilanga, uMnu. Mbhobo weza wazokuvakatjha. Wathi: Ngiphethwe buthongo! Ngifunana netaka engingakghona ukulala kilo!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/85673/size7/1825ef035f979fd15