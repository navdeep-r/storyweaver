":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-358678","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-358678","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":437,"opdsId":"urn:uuid:SW-53487","title":"एक, तीन, पाँच, मदद! मदद!","authors":["Poonam S. Kudesia"],"language":"","readingLevel":"","publisher":"","summary":"यह है एक हट्टे कट्टे नारियल पेड़ वाले भँवरे की कहानी है जिसे गिनती में बहुत मज़ा आता है। उसे संख्या को तरह-तरह के डिज़ाईन से समझना बहुत अच्छा लगता है। एक दिन वो फिसल कर गिर गया तो उसे बचाने उसके कितने दोस्त आए? वो विषम संख्या में आये या फिर सम संख्या में?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725492/size7/3ecd3874b39dcc8551a41c3b387e60ab.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725492/size7/3ecd3874b39dcc8551a41c3b387e60ab.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-53487","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-53487","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":438,"opdsId":"urn:uuid:SW-604","title":"मोरू एक पहेली","authors":["Manisha Chaudhry"],"language":"","readingLevel":"","publisher":"","summary":"मोरू को अंक पसंद थे और उसे स्कूल जाना भी अच्छा लगता था। ऐसा क्या हुआ जो उसे उसके प्यारे अंकों से दूर ले गया? पढ़िये मोरू की मन को छू लेने वाली कहानी।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/696874/size7/9ff16cdbaba183411b9f0abc8173386f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/696874/size7/9ff16cdbaba183411b9f0abc8173386f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-604","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-604","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":439,"opdsId":"urn:uuid:SW-481","title":"लस्सी या फ़ालूदा?","authors":["Rajesh Khar"],"language":"","readingLevel":"","publisher":"","summary":"क्या आम पन्ना लस्सी से ज़्यादा मज़ेदार है? या फ़ालूदा इन दोनों से ज़्यादा मज़ेदार है? यह तय करने का अच्छा तरीका तो यही है कि इनको चखा जाए और मीनू ऐसा ही कर रही है। इतनी गर्मी में और किया भी क्या जा सकता है?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722331/size7/770e318345a2dab26f2da545913195b7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722331/size7/770e318345a2dab26f2da545913195b7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-481","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-481","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":440,"opdsId":"urn:uuid:SW-55772","title":"यह कैसी गंध है?","authors":["Nirmala Shukla"],"language":"","readingLevel":"","publisher":"","summary":"कोई माधव और तारा का सारा खाना खा रहा है। यह कौन हो सकता है? कोई अजीब प्राणी, रोएँदार राक्षस या कुछ अदृष्य? कौन हो सकता था ये?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/714317/size7/943de6f6a8d5ef43d1bb7b9147b1ca58.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/714317/size7/943de6f6a8d5ef43d1bb7b9147b1ca58.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-55772","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-55772","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":441,"opdsId":"urn:uuid:SW-381","title":"दीदी, दीदी, बादल क्यों गरजते हैं?","authors":["Shobhit Mahajan"],"language":"","readingLevel":"","publisher":"","summary":"दीदी से पूछने के लिये मुन्ने राजा के मन में न जाने कितने सवाल उठते रहते हैं। \nदीदी के पास जवाब हमेशा मिलते हैं क्योंकि वह हर समय कोई न कोई मोटी सी \nकिताब पढ़ती रहती है। यहाँ मुन्ने राजा सोच रहे हैं कि बादल गरजते क्यों हैं?\nक्या कोई राक्षस गुस्से में हुंकार रहा है या बादलों में रहने वाले मोटर साइकिल \nचालक ज़ोर-ज़ोर से मोटर साइकिल चला रहे हैं? दीदी अन्त में सही उत्तर दे देती \nहै पर मुन्ने राजा के मज़ेदार जवाब भी पढ़ने लायक हैं।आप भी बताइये आपको \nक्या लगता है बादल क्यों गरजते हैं?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722406/size7/9d3e085a533c4c69c41f353bbdbd072d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722406/size7/9d3e085a533c4c69c41f353bbdbd072d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-381","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-381","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":442,"opdsId":"urn:uuid:SW-86694","title":"जुगाड़ से जादू","authors":["Sandhya Gandhi-Vakil"],"language":"","readingLevel":"","publisher":"","summary":"दादू का खेल जीतने के लिए लाजो को उनकी बताई सभी चीजें ढूँढ़ निकालनी है। घर के लोग सोच रहें हैं, दादू इस बेचारी को ऐसे संकटकाल में यह सब भला क्यों करवा रहे हैं।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715245/size7/125c121033c3f1d3ae6712079658c840.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715245/size7/125c121033c3f1d3ae6712079658c840.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-86694","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-86694","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":443,"opdsId":"urn:uuid:SW-38900","title":"पासवर्ड क्या है!","authors":["Sadaf Jafar"],"language":"","readingLevel":"","publisher":"","summary":"मंजू अपनी बहन के मोबाइल फोन पर खेल खेलना चाहती है। इस पुस्तक में पाठकों को पासवर्ड की अवधारणा से अवगत कराया गया है ताकि वे अ