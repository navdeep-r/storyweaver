/story/epub/SW-57854","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":176,"opdsId":"urn:uuid:SW-12734","title":"आंब्याचं झाड","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"या छोट्या मुलीला मोठया आंब्याच्या झाडात लपायला खूप आवडतं. तिला कोण शोधून काढेल बरं?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/33304/size7/23a920a3cbb156501ad40ddc9e72c040.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/33304/size7/23a920a3cbb156501ad40ddc9e72c040.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12734","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12734","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":177,"opdsId":"urn:uuid:SW-394","title":"केळीच केळी","authors":["Utkarsha Manish"],"language":"","readingLevel":"","publisher":"","summary":"शृंगेरी श्रीनिवासच्या बागेतील गोड केळी कोणीही विकत घेत नव्हते. अशा वेळी त्याने त्या केळ्यांचे काय केलेे हे जाणून घेण्यासाठी ही छान गोष्ट वाचा.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703951/size7/f7817aa88cb268daaa68075155cd66a0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703951/size7/f7817aa88cb268daaa68075155cd66a0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-394","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-394","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":178,"opdsId":"urn:uuid:SW-94604","title":"श्रींगेरी श्रीनिवासची गाय हंबरणार का?","authors":["Mukund Taksale"],"language":"","readingLevel":"","publisher":"","summary":"श्रींगेरी श्रीनिवासची यावेळी वेगळीच समस्या आहे. त्याची गाय काही केल्या ‘हंबरत’च नाही. त्यामुळे त्याच्या कपाळावर आठ्या आहेत. तो कमालीचा वैतागलेला आहे. त्यासाठी त्याची मुलं काय काय करतात. अगदी मिठाईसुद्धा खायला घालतात. पण ती पठ्ठी काही तोंडून ‘हम्मा’ काढत नाही. चला तर मग, या शेतकरी कुटुंबाला आणि त्यांच्या नव्या मांजराला भेटू या, शेवटी एक गमतीदार वळण घेणाऱ्या या गोष्टीत!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703876/size7/b8450198b14417eb987648711d009944.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703876/size7/b8450198b14417eb987648711d009944.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-94604","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-94604","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":179,"opdsId":"urn:uuid:SW-10467","title":"भारतातील हस्तकला","authors":["Usha Rane"],"language":"","readingLevel":"","publisher":"","summary":"भारतात भटकंती करताना लेखिकेला जी वैविध्यपूर्ण माणसं भेटली, जे रसपूर्ण अनुभव आले, त्यावर आधारित हे पुस्तक. त्यांची ही निरीक्षणं तुम्हालाही आनंद देतील.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117159/size7/443e0dc11c25b7e2248a06b2096057c1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117159/size7/443e0dc11c25b7e2248a06b2096057c1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-10467","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-10467","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":180,"opdsId":"urn:uuid:SW-303113","title":"बोला एका दमात","authors":["Sai Keskar"],"language":"","readingLevel":"","publisher":"","summary":"ही आहे मुलांसाठी एक मजेशीर कविता! वेगवेगळे आवाज एका श्वासात कसे काढता येतात ही मौज मुलांना समजेल. असे आवाज काढण्याचा खेळ त्यांना नक्की आवडेल. बघू या बरं, कोण किती आवाज काढू शकतं ते!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/120578/size7/884b07889a34d43f8bc35b1c18d12483.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/120578/size7/884b07889a34d43f8bc35b1c18d12483.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-303113","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-303113","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":181,"opdsId":"urn:uuid:SW-10","title":"लठ्ठ राजाचा कुत्रा","authors":["Utkarsha Manish"],"language":"","readingLevel":"","publisher":"","summary":"लठ्ठ राजा आणि त्याचा कुत्रा यांच्याबरोबर पळायचे आहे?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721909/size7/578f72502f01ea8298384a08257557b2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721909/size7/578f72502f01ea8298384a08257557b2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-10","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-10","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":182,"opdsId":"urn:uuid:SW-13331","title":"चिंटू","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"चिंटू हा एकदम खास कुत्रा! या गोष्टीत इतरही त्याचे मित्र आहेत. भेटायचं आहे का त्यांना?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/389128/size7/19ea2321a4747fc5040f6f361eaa4de5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/389128/size7/19ea2321a4747fc5040f6f361eaa4de5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-13331","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-13331","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":183,"opdsId":"urn:uuid:SW-275962","title":"“ए, हाऽड!!” नावाचा कुत्रा","authors":["Faruk S. Kazi"],"language":"","readingLevel":"","publisher":"","summary":"“ए, हाऽड!!!” त्या तपकिरी रंगाच्या लहानशा कुत्र्याला पाहिलं की प्रत्येकजण हेच म्हणायचा. एकसारखे तेच शब्द ऐकून त्या कुत्र्याला आपलं नावच मुळी ‘हाऽड’ आहे, असं वाटायला लागलं होतं. पण, एक दिवस मात्र एका मुलानं शाळेतून घरी जाताना आपल्या डब्यातला खाऊ हाऽडला द्यायचं ठरवलं... मग पुढं काय झालं? या छानशा पुस्तकात नक्की वाचा.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723776/size7/3c4685534dd86b57918f11d2c9c9e01b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723776/size7/3c4685534dd86b57918f11d2c9c9e01b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-275962","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-275962","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":184,"opdsId":"urn:uuid:SW-308652","title":"बुडबुड्यांचं रहस्य","authors":["Sushrut Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"छोटसं कोकरू खूप उत्साहात आहे. ते पहिल्यांदाच आंघोळीला तलावावर गेलंय. तलावापाशी गेल्यावर त्याला पाण्यात खूप बुडबुडे येताना दिसले. हे बुडबुडे कुठून आले? कोणीच त्याच्या प्रश्नाचं उत्तर देत नाही. त्याला या बुडबुड्यांचं रहस्य कधी कळेल का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/427053/size7/9cafc47475f7d6eed6edb7877a504d6e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/427053/size7/9cafc47475f7d6eed6edb7877a504d6e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-308652","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-308652","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":185,"opdsId":"urn:uuid:SW-26229","title":"लयाताई आणि तिची भन्नाट मोटरबाईक","authors":["Sayali Godse"],"language":"","readingLevel":"","publisher":"","summary":"मिस लया या शाळेत खेळ शिकवणाऱ्या शिक्षिकेला लोकांना मदत करायला आवडतं. चला मिस लया आणि तिची भन्नाट मोटरबाईक यांच्यासोबत आपणही सफरीवर निघूया. झूम्‌ऽऽऽ!!! पाहूया तरी त्या दोघी कोणकोणती कामगिरी करतात ते!\nलयाताई आणि तिची भन्नाट मोटरबाईक या मालिकेमधलं हे पहिलं पुस्तक.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117362/size7/a894b43fa2809b9b8de75bb7feeb341a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117362/size7/a894b43fa2809b9b8de75bb7feeb341a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-26229","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-26229","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":186,"opdsId":"urn:uuid:SW-355439","title":"पॉमी आणि टॉमी","authors":["Sai Keskar"],"language":"","readingLevel":"","publisher":"","summary":"पॉमीच्या घरातल्या सगळ्यांनाच प्राणी आवडतात, पण पॉमीला मात्र ते आवडत नाहीत. एकदा तिला एक कुत्रा भेटला आणि तिचं असं वागणंच पार बदलून गेलं!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/424765/size7/32720a7c033a36e35c950f6f3d9fab76.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/424765/size7/32720a7c033a36e35c950f6f3d9fab76.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-355439","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-355439","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":187,"opdsId":"urn:uuid:SW-463","title":"रंग ('सांग ना लवकर' मालिका)","authors":["Meera Tendolkar"],"language":"","readingLevel":"","publisher":"","summary":"आपल्या आजूबाजूला दिसणाऱ्या रंग, आकार वगैरे अनेक गोष्टींबद्दल लहान मुलांना कुतूहल असते. मग ती मुले प्रश्न विचारतात आणि आई किंवा बाबा त्यांना उत्तरे देतात. सांग ना लवकर ... रंग यामध्ये अशीच छोटी छोटी प्रश्नोत्तरे आहेत.","coverUrl":"https://static.storyweaver.