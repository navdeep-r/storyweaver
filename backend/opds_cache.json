itions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15212","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15212","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":148,"opdsId":"urn:uuid:SW-36481","title":"Colours","authors":["Alisha Berger"],"language":"","readingLevel":"","publisher":"","summary":"A white bear likes colours a lot, and he falls in love with new ones all the time. Join him as he explores a world of rainbows.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/93903/size7/0a9bcf1123b6cf65ac42dfa8c6258c1d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/93903/size7/0a9bcf1123b6cf65ac42dfa8c6258c1d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-36481","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-36481","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":149,"opdsId":"urn:uuid:SW-10448","title":"Ghum-Ghum Gharial's Glorious Adventure","authors":["Aparna  Kapur"],"language":"","readingLevel":"","publisher":"","summary":"Ghum-Ghum Gharial is out on her very first swim when she realizes that her family has swum off without her. Will she find them? Swim along the river Ganga with Ghum-Ghum and meet many amazing creatures along the way!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723978/size7/fef3cb2e4de26e284dc81d72ff16571a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723978/size7/fef3cb2e4de26e284dc81d72ff16571a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-10448","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-10448","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":150,"opdsId":"urn:uuid:SW-8905","title":"Chipko takes root","authors":["Jeyanthi Manokaran"],"language":"","readingLevel":"","publisher":"","summary":"Here is a story set in the hills that shows what bravery and grit can accomplish. Dichi, a brave Bhotiya girl takes part in the Chipko movement to save her beloved trees. Everybody in her village knows that trees give them all the important things in their life. Rapid deforestation in the Himalayan region of Alaknanda river caused floods in the 1970s and gave birth to a movement to save trees by hugging them. Read this heartwarming tale to learn the power of collective action as seen through the eyes of young Dichi.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/29172/size7/d13859ef173ca4ad6a2462e70e5d344a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/29172/size7/d13859ef173ca4ad6a2462e70e5d344a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-8905","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-8905","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":151,"opdsId":"urn:uuid:SW-61982","title":"Malar's Big House","authors":["Thirupurasundari Sevvel"],"language":"","readingLevel":"","publisher":"","summary":"Malar loves to build things. What will she build today?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715434/size7/5613393324b2c4300bc530bb88cb1e16.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715434/size7/5613393324b2c4300bc530bb88cb1e16.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-61982","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-61982","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":152,"opdsId":"urn:uuid:SW-41319","title":"The Seed Savers","authors":["Bijal Vachharajani"],"language":"","readingLevel":"","publisher":"","summary":"Without seeds there would be no food to eat or clothes to wear. Inspired by a real-life event, this is the story of a village that comes together to open a seed bank.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/89005/size7/c376949d6d1c81338903a0c7d238c634.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/89005/size7/c376949d6d1c81338903a0c7d238c634.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-41319","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-41319","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":153,"opdsId":"urn:uuid:SW-30972","title":"Kali Wants to Dance","authors":["Aparna Karthikeyan"],"language":"","readingLevel":"","publisher":"","summary":"All Kali wanted to do was dance. But how could he? After all, in his village, boys did not\ndance, especially not Bharatanatyam. A story about dreams and aspirations and believing in them.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722803/size7/279e3b0b11f71cddf1a84d019cdd0cb8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722803/size7/279e3b0b11f71cddf1a84d019cdd0cb8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-30972","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-30972","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":154,"opdsId":"urn:uuid:SW-131021","title":"ABCD - A Nature Alphabet Book","authors":["Adrija Ghosh"],"language":"","readingLevel":"","publisher":"","summary":"A is for Ant, B is for Bee, N is for Nature Words in this beautiful alphabet book.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/180922/size7/e1769284b709b57136