df+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-63323","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":839,"opdsId":"urn:uuid:SW-528476","title":"गोष्ट एका नव्या ग्रहाची","authors":["Atish Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"अन्वीला अवकाशानं भुरळ पाडलीय. रोज संध्याकाळी ती आपल्या नव्या दुर्बिणीला चिकटून बसलेली असते. परग्रहावर जीवसृष्टी अस्तित्वात आहे का हे तिला शोधायचं असतं. एके रात्री ती एका वेगळ्याच ग्रहावरच्या जीवांना भेटते. आपल्या सूर्यमालेच्या आणि आकाशगंगेच्या बाहेरही ग्रह आहेत हे तिला समजतं. चला, ही गोष्ट वाचून आपण या ग्रहांबद्दल म्हणजे एक्सोप्लॅनेट्सबद्दल माहिती मिळवूया.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/700845/size7/39c84c0cb8b91e4c766d58f6ae5a2722.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/700845/size7/39c84c0cb8b91e4c766d58f6ae5a2722.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-528476","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-528476","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":840,"opdsId":"urn:uuid:SW-137573","title":"या ट्रबलचा भारी त्रास!","authors":["Siddharth Kelkar"],"language":"","readingLevel":"","publisher":"","summary":"ट्रबल हरवली आहे! पण कोण आहे ही ट्रबल? ती आहे एक अगदी खट्याळ कुत्री. तिला शोधायला अभिला मदत कराल का तुम्ही?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/170569/size7/e49effc708bc0713d9aa149563081c24.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/170569/size7/e49effc708bc0713d9aa149563081c24.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-137573","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-137573","type":"application/epub+zip","rel":"http:/