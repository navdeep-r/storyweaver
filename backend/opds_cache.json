eaver.org.in/api/v0/story/epub/SW-49725","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1616,"opdsId":"urn:uuid:SW-650968","title":"Khampai Becomes a Yaopa","authors":["Longang  Luklem"],"language":"","readingLevel":"","publisher":"","summary":"In life, one experiences love, joy, and loss. Join Khampai on an emotional journey, where he explores his grandfather’s craft, embraces his legacy, and finds himself on a path of self-discovery.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/754813/size7/545facfa367d73e231d129ac0486b720.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/754813/size7/545facfa367d73e231d129ac0486b720.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-650968","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-650968","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1617,"opdsId":"urn:uuid:SW-652921","title":"Lost in Ultapani","authors":["Chalini Basumatary"],"language":"","readingLevel":"","publisher":"","summary":"In a state of being lost, an unexpected friendship leads the way through the darkness. Explore the rich flora and fauna of Ultapani forest as baby elephant finds his way back to his family.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/756375/size7/5665d0763c959a76d276838e338f1101.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/756375/size7/5665d0763c959a76d276838e338f1101.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-652921","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-652921","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1618,"opdsId":"urn:uuid:SW-653037","title":"Nungpak Thabi vs Tumurak","authors":["Linthoi Chanu"],"language":"","readi