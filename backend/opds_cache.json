.in/api/v0/story/epub/SW-579244","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":959,"opdsId":"urn:uuid:SW-636241","title":"ಶುಂಠಿ ಮಿಠಾಯಿ","authors":["Jayant Kaikini"],"language":"","readingLevel":"","publisher":"","summary":"ತಾಲೂಕು ಪಟ್ಟಣದ ಜವಳಿ ಪೇಟೆಗೆ ಚಿಂಗಿ ಮೊದಲ ಬಾರಿ ಹೋದಳು. ನಾನಾ ಬಣ್ಣಗಳಲ್ಲಿ ಕಂಗೊಳಿಸುತ್ತಿದ್ದ ಪೇಟೆ ನೋಡಿ ಖುಷಿಯಾದಳು. ಶಕೀಲ್‌ಚಿಕ್ಕಪ್ಪ ಎಷ್ಟು ಭಾರೀ ಖರೀದಿ ಮಾಡಿದ್ದನೆಂದರೆ ಅವರ ಪುಟ್ಟ ನ್ಯಾನೋ ಕಾರು ತುಂಬಿಯೇ ಹೋಯಿತು. ನಂತರ ಚಿಂಗಿ ಚಿಕ್ಕಪ್ಪನಿಗೆಂದೇ ಒಂದು ಪುಟ್ಟ ಖರೀದಿ ಮಾಡಿದಳು. ಅದರಿಂದ ಅವನಿಗೆ ತುಂಬಾ ಖುಷಿಯಾಯಿತು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723782/size7/46febe3b5c6068d42bec84da0df5479e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723782/size7/46febe3b5c6068d42bec84da0df5479e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-636241","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-636241","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":960,"opdsId":"urn:uuid:SW-160672","title":"ಗಿಡಗಳೊಂದಿಗೆ ಮಾತನಾಡುವ ಖಲಾಯಿ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ವಿವಿಧ ಗಿಡಗಳೊಂದಿಗೆ ಮಾತನಾಡುವ ಪುಟ್ಟ ಹುಡುಗಿಯೇ ಖಲಾಯಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/235335/size7/01c6bf1eb33fda92149a539c6f0f9fea.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/235335/size7/01c6bf1eb33fda92149a539c6f0f9fea.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-160672","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-160672","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":961,"opdsId":"urn:uuid:SW-462006","title":"ನರಿಯ ಸೋಲು","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂದು ಬುದ್ಧಿವಂತ ಮೊಲ ತನ್ನ ಸ್ನೇಹಿತ ಆಮೆಗೆ ಸಹಾಯ ಮಾಡುತ್ತದೆ. 