s-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-214852","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":670,"opdsId":"urn:uuid:SW-373426","title":"कीट वैज्ञानिक : राजमोहना केलोथ","authors":["Vartul Adishesh Dhaundiyal"],"language":"","readingLevel":"","publisher":"","summary":"मोहना की कक्षा के सब बच्चे सो रहे हैं लेकिन वह चींटियों की एक फौज को ध्यान से देख रही है। बड़ी होकर वह एंटोमोलोजिस्ट यानी कीट विज्ञानी बनीं। चलिए जानते हैं राजमोहना केलोथ और नन्हे कीड़ो के संसार के बारे में!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727421/size7/1c51e44491a29f2e9c497da35a49add2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727421/size7/1c51e44491a29f2e9c497da35a49add2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-373426","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-373426","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":671,"opdsId":"urn:uuid:SW-377702","title":"अच्चाची का रंगीन छाता","authors":["Priyanka Gautam"],"language":"","readingLevel":"","publisher":"","summary":"सह्याद्री ने फिर से अपना छाता खो दिया। अम्मा तो बहुत गुस्सा होने वालीं हैं इस बार। लेकिन अच्छी बात यह है कि अच्चाची छाता बनाने में उसकी मदद करने वाले हैं। आइए, पाई चार्ट की अवधारणा से परिचित कराती, इस किताब को पढ़ते हैं।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727418/size7/37170842b20a8ced11ae674f17ce3855.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727418/size7/37170842b20a8ced11ae674f17ce3855.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-377702","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-377702","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":672,"opds