0/story/epub/SW-25665","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":176,"opdsId":"urn:uuid:SW-4772","title":"Dum Dum-a-Dum Biryani!","authors":["Gayathri Tirthapura"],"language":"","readingLevel":"","publisher":"","summary":"Basha and Sainabi are in a panic. Ammi is ill, and Saira aunty has just announced that she is arriving for lunch - with 23 other people! Budding chef Basha thinks he can cook Ammi's Dum Biryani, but her recipe only makes enough for 4 people. Math wiz Sainabi jumps in to help, declaring that she knows how to turn a 4-person recipe to a 24-person recipe. Do the siblings succeed in serving up a truly Dum Dum-a-Dum biryani? Read this book to find out!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/710992/size7/148136331161fe3faf86e1ff30c0f59d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/710992/size7/148136331161fe3faf86e1ff30c0f59d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-4772","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-4772","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":177,"opdsId":"urn:uuid:SW-12292","title":"Hide and Seek","authors":["Kanchan Bannerjee"],"language":"","readingLevel":"","publisher":"","summary":"When you play Hide and Seek with your friends, where do YOU hide? Want some ideas? Let's read this story.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/34964/size7/b444d20af25d0c9bafa9a14a0c23ba2a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/34964/size7/b444d20af25d0c9bafa9a14a0c23ba2a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12292","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12292","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":178,"opdsId":"urn:uuid:SW-705","title":"The Magic Powder - A Folktale from Myanmar","authors":["Greystroke"],"language":"","readingLevel":"","publisher":"","summary":"Once upon a time, in a little village on the banks of the Irrawaddy river, there lived a young woman called Thuza. She was very happily married to handsome young Theingi. But there was one problem that nagged Thuza – her husband believed he would find a way to turn dirt into hold! Did he succeed? Read this delightful tale from Myanmar to find out.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/697435/size7/1a89e33ee73ca7454a57ef29be7d2dab.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/697435/size7/1a89e33ee73ca7454a57ef29be7d2dab.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-705","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-705","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":179,"opdsId":"urn:uuid:SW-38367","title":"The Magic Mirror","authors":["Magdalena  Cooper"],"language":"","readingLevel":"","publisher":"","summary":"An evil witch curses the village, causing children to turn into scary creatures. Only Sam and Soy are free from the curse. Will Sam and Soy continue to escape the witch’s curse? Will the other children stay scary creatures forever?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/101351/size7/f5105b39b5e56da9625b42d59e079231.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/101351/size7/f5105b39b5e56da9625b42d59e079231.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-38367","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-38367","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":180,"opdsId":"urn:uu