ication/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-163","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":630,"opdsId":"urn:uuid:SW-249034","title":"On Mondays I Want to Hide","authors":["Shabnam  Minwalla"],"language":"","readingLevel":"","publisher":"","summary":"If the days of the week were people you knew, what would they be like? Your school principal, your sister, or best friend? Would they be happy or difficult, boring or busy?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716358/size7/d3b3324d37e516f6e0e1132c9cbbd6f3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716358/size7/d3b3324d37e516f6e0e1132c9cbbd6f3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-249034","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-249034","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":631,"opdsId":"urn:uuid:SW-628","title":"Paplu, the Giant","authors":["Ramendra Kumar"],"language":"","readingLevel":"","publisher":"","summary":"Paplu was a strange giant who did not like to fight with anyone, nor did he like scaring people. But when his beloved villagers were in danger, he rose to great heights to solve the problem.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/720909/size7/5f3ec51e870f794a1862b7c0e2d28d17.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/720909/size7/5f3ec51e870f794a1862b7c0e2d28d17.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-628","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-628","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":632,"opdsId":"urn:uuid:SW-176853","title":"The Salt Inspector","authors":["Vibha Lohani"],"language":"","readingLevel":"","publisher":"","summary":"Munshi Vanshidar lacks the ability to be dishonest or corrupt in spite of being surrounded by greedy people soaked in money. As the salt inspector, he is true to himself and to the integrity of his work. Soon, this leads him to clash with Pandit Alopideen, the most powerful man in their area. What follows is a tale that will always be relevant to our society, portraying the constant war between the lure of money and the need to be moral.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/526054/size7/2e25b6bda7e562108e56282766f1c927.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/526054/size7/2e25b6bda7e562108e56282766f1c927.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-176853","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-176853","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":633,"opdsId":"urn:uuid:SW-45620","title":"My First Day at School","authors":["Shannon David"],"language":"","readingLevel":"","publisher":"","summary":"Sesi is six years old and lives with her parents in Turiani. After her first day at school, she comes home and tells them something funny that happened at school. What do you think happened?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/101668/size7/f3ebb6a2a0fde3404ddc015d3599db76.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/101668/size7/f3ebb6a2a0fde3404ddc015d3599db76.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-45620","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-45620","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":634,"opdsId":"urn:uuid:SW-94115","title":"Ox and Donkey","authors":["Eliz