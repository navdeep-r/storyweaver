ion/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":81,"opdsId":"urn:uuid:SW-14802","title":"ನಸುನಗೆ ಬೀರಿ!","authors":["A.S. Chandra Mouli"],"language":"","readingLevel":"100daysreadingcampaignPunjab2022","publisher":"","summary":"ಗೆಳೆಯರ ಜೊತೆ ಓಡುತಿರುವ ಪುಟ್ಟ ಜಿಂಕೆಯನು ಹಿಂಬಾಲಿಸಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721917/size7/548c488c38612955cf9c42fe6894c5f1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721917/size7/548c488c38612955cf9c42fe6894c5f1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-14802","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-14802","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":82,"opdsId":"urn:uuid:SW-622904","title":"ಕಥೆ ಚಿಕ್ಕಪ್ಪ","authors":["Mangala BE"],"language":"","readingLevel":"","publisher":"","summary":"ಮಕ್ಕಳಾಗಲಿ, ದೊಡ್ಡವರಾಗಲಿ ಎಲ್ಲರೂ ಒಳ್ಳೆಯ ಕಥೆಯನ್ನು ಇಷ್ಟಪಡುತ್ತಾರೆ. ನಾವು ನಮ್ಮ ಜೀವನದ ಬಗ್ಗೆ ಯೋಚಿಸಿದರೆ, ನಾವು ಅದನ್ನು ಕಥೆ ಎಂದು ಭಾವಿಸಬಹುದು. ಈಗ, ನೀವು ‘ಕಥೆಗಳಿಲ್ಲದ ನಾಡು’ಎಂಬುದನ್ನು ಕಲ್ಪಿಸಿಕೊಳ್ಳಬಹುದೇ? ಕಥೆಗಳಿಲ್ಲದಿದ್ದರೆ ಜೀವನವು ಹೇಗೆ ಭಿನ್ನವಾಗಿರುತ್ತದೆ? ನೀವು ಯಾವುದನ್ನು ಹೆಚ್ಚು ಕಳೆದುಕೊಳ್ಳುತ್ತೀರಿ? ‘ಕಥೆ ಚಿಕ್ಕಪ್ಪ’ ಒಂದು ಹೃದಯಸ್ಪರ್ಶಿ ಕಥೆ.\nವಿಚಿತ್ರ ಸನ್ನಿವೇಶಗಳು ಮತ್ತು ಸ್ಮರಣೀಯ ಪಾತ್ರಗಳೊಂದಿಗೆ ಕಥೆಗಳಿಲ್ಲದ ನಾಡು ಹೇಗೆ ಕಥಾ ಸಂಪತ್ತಿನಿಂದ ತುಂಬಿದ ನಾಡಾಗಿ ರೂಪಾಂತರಗೊಳ್ಳುತ್ತದೆ ಎಂಬುದರ ಅನಾವರಣವೇ ಈ ಕಥೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/741978/size7/90d045b30ebc18c544cef37aee314e81.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/741978/size7/90d045b30ebc18c544cef37aee314e81.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-622904","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-622904","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":83,"opdsId":"urn:uuid:SW-48483","title":"ಚಕ್ ಚಕ್!","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಅವಿ ಮತ್ತು ಟೊಟೊ ಕೈಗೆ ಕತ್ತರಿ ಸಿಕ್ಕಿಬಿಟ್ಟಿದೆ. ಅಕ್ಷರಗಳಿಲ್ಲದ ಈ ಚಿತ್ರಕಥೆಯಲ್ಲಿ ತುಂಟ ಅಕ್ಕ-ತಮ್ಮ ಏನೆಲ್ಲ ಅವಾಂತರ ಮಾಡಿದರು ಎನ್ನುವುದು ಪುಟಗಳನ್ನು ತಿರುಗಿಸಿದರೆ ಸಾಕು ಗೊತ್ತಾಗುತ್ತದೆ. ಅವರಿಬ್ಬರ ಬಾಲಂಗೋಚಿ ಬೆಕ್ಕೂ ಅವರಂತೆಯೇ ಕುಣಿಯುತ್ತೆ. ನೋಡಿ ಬೇಕಾದರೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495566/size7/1b7001d2c4ddf2c017bfb4589f885f91.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495566/size7/1b7001d2c4ddf2c017bfb4589f885f91.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-48483","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-48483","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":84,"opdsId":"urn:uuid:SW-31015","title":"ಕುಂಬಾರನ ಹಂದಿ","authors":["Subhashini  M.L."],"language":"","readingLevel":"","publisher":"","summary":"ಲಲಿತಾ, ಕುಂಬಾರ ಮಿನಿ ಸಿಂಘ್ ನ ಮುದ್ದಿನ, ತುಂಟ ಹಂದಿ. ಯಾವಾಗಲೂ ಏನಾದರೊಂದು ಅವಾಂತರ ಮಾಡುತ್ತಲೇ ಇರುತ್ತಿತ್ತು. ಒಂದು ದಿನ ಮಿನಿ ತನ್ನ ಸುಂದರ ಮಡಕೆಗಳೆಲ್ಲಾ ಚೂರು ಚೂರಾಗಿರುವುದು ಕಂಡು ಅಘಾತಗೊಂಡ. ಇದು ಲಲಿತಾಳದ್ದೇ ಕೆಲಸ ಎಂದು ಅದನ್ನು ಕಟ್ಟಿ ಹಾಕಿದ. ಮುಂದೆ ಏನಾಯಿತು? ಓದಿ ನೋಡಿ. ಪುಣೆಯಲ್ಲಿ ವಾಸಿಸುತ್ತಿರುವ ಕುಂಬಾರ ಮತ್ತು ಅವನ ಮುದ್ದಿನ ಹಂದಿಯಿಂದ ಪ್ರೇರಿತಗೊಂಡ ನೈಜ ಕಥೆ ಇದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/167262/size7/ca6c5111d8ce48f2a627f7fdece3807e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/167262/size7/ca6c5111d8ce48f2a627f7fdece3807e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-31015","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-31015","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":85,"opdsId":"urn:uuid:SW-220014","title":"ಬುಗುರಿ","authors":["Manjunath B G"],"language":"","readingLevel":"","publisher":"","summary":"ಇಂದು ರಾಜು ಮತ್ತು ಲಕ್ಕಿ ಇಬ್ಬರನ್ನೂ ನೋಡಿ ಅಮ್ಮನೂ ಕುಣಿದಳು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283714/size7/505c49233cb7fab4c144ffff537d21e1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283714/size7/505c49233cb7fab4c144ffff537d21e1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-220014","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-220014","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":86,"opdsId":"urn:uuid:SW-214856","title":"ಮೂರು ಗೆಳೆಯರು","authors":["Shabana Begum"],"language":"","readingLevel":"","publisher":"","summary":"ಮೂರು ಗೆಳೆಯರು ಸೇರಿ ದೋಸೆ ಮಾಡುತ್ತಿದ್ದರು ಆದರೆ ದೋಸೆ ಸುಟ್ಟು ಹೋಯಿತು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283716/size7/6ff27cb8d15f41789af67043ab1b9eaf.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283716/size7/6ff27cb8d15f41789af67043ab1b9eaf.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-214856","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-214856","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":87,"opdsId":"urn:uuid:SW-11952","title":"ಒಂದೆಯೋ ಬೇರೆ ಬೇರೆಯೋ?","authors":["Brinda N Rao"],"language":"","readingLevel":"","publisher":"","summary":"ನೀವು ನಿಮ್ಮ ಹಾಗೆಯೇ ಇರುವವರೊಂದಿಗೆ ಮಾತ್ರ ಗೆಳೆತನ  ಮಾಡುವಿರಾ? ನಿಮಗಿಂತಲೂ ಭಿನ್ನವಾಗಿರುವವರೊಂದಿಗೆ ಗೆಳೆತನ ಮಾಡುವುದು ತಪ್ಪೇ? ಈ ಪ್ರಶ್ನೆಗಳಿಗೆ ಉತ್ತರಗಳನ್ನು ಗುಬ್ಬಿ ಮತ್ತು ಹಾವಿನೊಂದಿಗೆ ಬಗೆಹರಿಸಿಕೊಳ್ಳಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/713551/size7/e4d629c39bd8feb1be0de5a47991ae6b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/713551/size7/e4d629c39bd8feb1be0de5a47991ae6b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-11952","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-11952","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":88,"opdsId":"urn:uuid:SW-13692","title":"ಆಕ್ಷಿ! ಹಾ... ಆಆಆ... ಕ್ಷಿ!","authors":["Janhavi Lakshminarayanan"],"language":"","readingLevel":"","publisher":"","summary":"ಆಕ್ಷಿರಾಮನು ಮಾಡುವ ಯಾವುದೋ ಒಂದು ಕೆಲಸ ಇಡೀ ಪಟ್ಟಣವೇ ತಲೆ ಕೆಳಗಾಗುವಂತೆ ಮಾಡುತ್ತದೆ. ಅದೇನೆಂದು ತಿಳಿಯಲು ಬಯಸುವಿರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/116907/size7/bb5846057dd49f676de244368d2eca67.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/116907/size7/bb5846057dd49f676de244368d2eca67.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-13692","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-13692","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":89,"opdsId":"urn:uuid:SW-222386","title":"ಆಮೆ ಮತ್ತು ಮೊಲದ ಕತೆ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಆಮೆ ಮತ್ತು ಮೊಲ ಒಟ್ಟಿಗೆ ಓಡಲು ಶುರು ಮಾಡಿದವು. ದಾರಿಯಲ್ಲಿ ಮೊಲ ಮಲಗಿ ನಿದ್ದೆ ಮಾಡಿತು. ಆಮೆ ಮುಂದೆ ಸಾಗಿತು. ಆದರೆ ನಡುದಾರಿಯಲ್ಲಿ ಆಮೆಗೆ ಸಿಂಹವೊಂದು ಎದುರಾಯಿತು. ಮುಂದೇನಾಯಿತು? ಹಳೆಯ ಕತೆಗೆ ಹೊಸ ತಿರುವು!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/282978/size7/f0f4bc971ee80853a0691be353e006a1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/282978/size7/f0f4bc971ee80853a0691be353e006a1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-222386","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-222386","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":90,"opdsId":"urn:uuid:SW-50892","title":"ಕಣ್ಣ ಕನ್ನಡಿ","authors":["Sarita Sharan"],"language":"","readingLevel":"","publisher":"","summary":"ಚಂದಾ, ಟಿಂಕು ಮತ್ತು ಮೋಟು ಪ್ರಯೋಗಾಲಯಕ್ಕೆ ಹೋಗಿದ್ದಾರೆ. ಅಲ್ಲಿ ಎಷ್ಟೊಂದು ಬಗೆಯ ಮಸೂರಗಳವೆ. ದೂರದಲ್ಲೆಲ್ಲೋ ಇರುವ ವಸ್ತುಗಳು ಅವರ ಹತ್ತಿರವೇ ಇರುವಂತೆ ಕಾಣುತ್ತಿವೆ. ಅಷ್ಟೇ ಏಕೆ, ಲಕ್ಷಾಂತರ ಮೈಲು ದೂರದಲ್ಲಿರುವ ನಕ್ಷತ್ರಗಳೂ ಪಕ್ಕದಲ್ಲೆಲ್ಲೋ ಇರುವಂತೆ ಕಾಣುತ್ತಿವೆ. ಬನ್ನಿ, ಮಸೂರಗಳೆಂದರೆ ಏನು ಮತ್ತು ಅವು ಹೇಗೆ ಕೆಲಸ ಮಾಡುತ್ತವೆ ಎಂದು ತಿಳಿಯೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/94920/size7/bb37fccabe337577e1fe6a33eb2adf44.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/94920/size7/bb37fccabe337577e1fe6a33eb2adf44.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-50892","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-50892","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":91,"opdsId":"urn:uuid:SW-205","title":"ಬಂಟಿ ಮತ್ತು ಬಬ್ಲಿ","authors":["Bhavya"],"language":"","readingLevel":"","publisher":"","summary":"ಬಂಟಿಗೆ ಸೋಪು ಹಚ್ಚಿ ಸ್ನಾನ ಮಾಡುವುದು ಎಂದರೆ ಬೇಜಾರು. ಒಂದು ರಾತ್ರಿ ಅವಳಿಗೊಂದು ಕನಸು ಬಿತ್ತು... ಮುಂದೇನಾಯಿತು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/720260/size7/bfaca307e321a40d4fce0bf9bade9047.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/720260/size7/bfaca307e321a40d4fce0bf9bade9047.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-205","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-205","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":92,"opdsId":"urn:uuid:SW-26399","title":"ಇದು ನಾಟಕದ ಸಮಯ!","authors":["Subbakrishna Rao"],"language":"","readingLevel":"","publisher":"","summary":"ರಾಹಿ ಮತ್ತು ಅವಳ ಗೆಳೆಯರು ಶಾಲೆಯಲ್ಲಿ ನಾಟಕದ ತಯಾರಿ ಮಾಡುತಿದ್ದಾರೆ. ಎಲ್ಲ ಮಕ್ಕಳಿಗೂ ಕಾತರ, ಆತುರ. ಮುಂದೆ ಏನಾಗಲಿದೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/123538/size7/58b7c973afb2776c934b384c459d490d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/123538/size7/58b7c973afb2776c934b384c459d490d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-26399","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-26399","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":93,"opdsId":"urn:uuid:SW-483","title":"ನಂಗೆ ಈಗಲೇ ಹೇಳು!  ಬಣ್ಣಗಳು","authors":["Ishwar Daitota"],"language":"","readingLevel":"","publisher":"","summary":"ಸಾಮಾನ್ಯವಾಗಿ ಮಗು ತನ್ನ ಸುತ್ತಮುತ್ತ ಕಾಣುವ ಬಣ್ಣ ಮತ್ತು ಆಕಾರಗಳ ಬಗ್ಗೆ ಕುತೂಹಲದಿಂದ ಕೇಳುತ್ತದೆ. ಈ ಪ್ರಶ್ನೆ - ಉತ್ತರಗಳು ಹೇಗೆ ಆಕರ್ಷಕವಾಗಿರುತ್ತವೆ ಎನ್ನುವುದನ್ನು ನನಗೆ ಈಗಲೇ ಹೇಳು: ಬಣ್ಣಗಳು ಕಥೆ ತಿಳಿಸುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/700102/size7/610c0cae5d16405f1f342e373837d71f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/700102/size7/610c0cae5d16405f1f342e373837d71f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-483","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-483","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":94,"opdsId":"urn:uuid:SW-362","title":"ಹಾರಿತು ಆಟೋ ಅಂಬರಕೆ","authors":["Uday Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ದೆಹಲಿಯ ದಟ್ಟ ಸಂಚಾರದಲ್ಲಿ ಸಿಕ್ಕಿಹಾಕಿಕೊಂಡ ಒಂದು ಆಟೋಗೆ ಮಾಯಾ ಸ್ಪರ್ಶದ ಅನುಭವವಾಗುತ್ತದೆ. ಚಾಲಕ ಹಾಗೂ ಒಬ್ಬ ಪ್ರಯಾಣಿಕಳೊಂದಿಗೆ ನೀವೂ ಒಂದು ಸವಾರಿ ಮಾಡಿ. ನಕ್ಷತ್ರಲೋಕದ ಮೃದು ಸ್ಪರ್ಶವನ್ನು ಕೆಲಕ್ಷಣ ಅನುಭವಿಸಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721008/size7/ff25bb40f46b3cc1d01ce26448db417a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721008/size7/ff25bb40f46b3cc1d01ce26448db417a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-362","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-362","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":95,"opdsId":"urn:uuid:SW-2080","title":"ಅಕ್ಕ ಮತ್ತು ರಂಗುರಂಗಿನ ಖಜಾನೆ","authors":["Sriram MS"],"language":"","readingLevel":"","publisher":"","summary":"ಕೊಳಕಿನಿಂದ ಸುತ್ತುವರೆದ ಮಕ್ಕಳು ಮೋಜು ಮಸ್ತಿ ಮಾಡುವುದು ಹೇಗೆ? ಒಂದು ದಿನ ಅಕ್ಕ ಬಂದು ಮಕ್ಕಳ ಜೀವನಕ್ಕೆ ರಂಗನ್ನು ಹಚ್ಚುತ್ತಾಳೆ. ಅವಳು ತಂದ ಕಥೆಗಳು, ಪುಸ್ತಕಗಳು ಅವರ ಜೀವನವನ್ನೇ ಬದಲಿಸುತ್ತದೆ. ಅಕ್ಕ ಮತ್ತವಳ ಗೆಳೆಯರು ಪುಸ್ತಕಗಳೊಂದಿಗೆ ಸಂಭ್ರಮಿಸುವ ಈ ಕಥೆಯನ್ನು ಓದಿ ಆನಂದಿಸಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721709/size7/55afba6173fec2f775fdf425b7609188.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721709/size7/55afba6173fec2f775fdf425b7609188.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-2080","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-2080","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":96,"opdsId":"urn:uuid:SW-1027","title":"ಮೊದಲ ಮನೆ","authors":["Geetha M."],"language":"","readingLevel":"","publisher":"","summary":"ಬಹಳ ಬಹಳ ದಿನಗಳ ಹಿಂದೆ, ಜನರು ಕಾಡಿನಲ್ಲಿ ವಾಸಿಸುತ್ತಿದ್ದಾಗ, ಇಬ್ಬರು ಅಣ್ಣತಮ್ಮಂದಿರು, ಈಶಾನ್ಯ ಭಾರತದ, ಈಗ ಅರುಣಾಚಲ\nಪ್ರದೇಶ ಎನಿಸಿಕೊಂಡಿರುವ ಪ್ರದೇಶದಲ್ಲಿ, ಒಂದು ಮನೆಯನ್ನು\nಕಟ್ಟಲು ನಿರ್ಧರಿಸಿದರು. ಈ ಜಾನಪದ ಕತೆಯಲ್ಲಿ ಮೊದಲ\nಮನೆಯನ್ನು ಕಟ್ಟಿದ್ದು ಹೇಗೆ ಎಂಬುದರ ಬಗ್ಗೆ ತಿಳಿಯುತ್ತೇವೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/699943/size7/0e15576e8c73b38bf8275d54a2d1bf1d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/699943/size7/0e15576e8c73b38bf8275d54a2d1bf1d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-1027","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-1027","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":97,"opdsId":"urn:uuid:SW-18764","title":"ದುರಾಸೆಯ ಇಲಿ","authors":["Kollegala Sharma"],"language":"","readingLevel":"","publisher":"","summary":"ಇಲಿ ದೊಡ್ಡ ತಿಂಡಿಯನ್ನು ಬಿಲದೊಳಗೆ ತೆಗೆದುಕೊಂಡು ಹೋಗಲು ನೋಡುತ್ತದೆ. ದುರಾಸೆಯಿಂದ ಲಾಭವಿಲ್ಲ ಎಂದು ಕಲಿಯುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/118175/size7/74a688ee10cc7264d20523334bd5c41c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/118175/size7/74a688ee10cc7264d20523334bd5c41c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-18764","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-18764","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":98,"opdsId":"urn:uuid:SW-48467","title":"ಗಪ್ಪು ಕುಣಿದಳು!","authors":["Tanuja Jakkannavar"],"language":"","readingLevel":"","publisher":"","summary":"ಗಪ್ಪುಗೆ ಕುಣಿಯಲು ಬರುವುದಿಲ್ಲ ಎಂದು ಕ್ಲಾಸಿನಲ್ಲಿರುವ ಎಲ್ಲರಿಗೂ ಗೊತ್ತಾಗಿದೆ. ಮಕ್ಕಳೆಲ್ಲ ಎಡಗೈ ಎತ್ತಿದರೆ, ಗಪ್ಪು ಬಲಗೈ ಎತ್ತುವಳು! ಹಾಗಿದ್ದರೆ ಕೋಮಲಾ ಮಿಸ್ ಗಪ್ಪುಗೆ ಕುಣಿವುದನ್ನು ಕಲಿಸುವರೆ? ಅಕ್ಕ-ಪಕ್ಕ ನೋಡದೇ ಕುಣಿವುದರಲ್ಲಿ ಮಜವಿದೆ ಎನ್ನುತ್ತದೆ ಈ ಸರಳ ಕಥೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/87073/size7/68a0d3d182c04e01576caea671cc33bf.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/87073/size7/68a0d3d182c04e01576caea671cc33bf.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-48467","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-48467","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":99,"opdsId":"urn:uuid:SW-5349","title":"ಜಾದವ್ ಮತ್ತು ಮರಗಳ ತಾಣ","authors":["Brinda N Rao"],"language":"","readingLevel":"","publisher":"","summary":"ಪ್ರಪಂಚದಲ್ಲೇ ಅತ್ಯಂತ ಶ್ರೇಷ್ಠ ಕೆಲಸ ಜಾದವ್ ನದು. ಅವನು ಕಾಡುಗಳನ್ನು ಬೆಳೆಯುತ್ತಾನೆ! ಹೇಗೆ ಬೆಳೆಯುತ್ತಾನೆ? ತಿಳಿಯಲು ಈ ಪುಸ್ತಕ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712342/size7/d8de7d5aebdf7754bbf81fd93c25dba0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712342/size7/d8de7d5aebdf7754bbf81fd93c25dba0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-5349","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-5349","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":100,"opdsId":"urn:uuid:SW-5277","title":"ರೀತಿ ಮತ್ತು ಮಿತು","authors":["Vishwas  HV"],"language":"","readingLevel":"","publisher":"","summary":"ರೀತಿಯ ರಜೆ ಶುರು, ಆದರೆ ಅವಳಿಗೆ ಅದು ಇಷ್ಟವಿಲ್ಲ. ಅವಳ ಸ್ನೇಹಿತರು ರಜೆಯಲ್ಲಿ ಸಿಗದಿರುವುದರಿಂದ ಅವಳಿಗೆ ಬೇಜಾರು. ಒಂದು ದಿನ ಅವಳಿಗೆ ಮಿತು – ಮಾತನಾಡುವ ಸಾಕು ಗಿಳಿ ಸಿಕ್ಕಿದ. ಮಿತು ಅವಳ ಹೊಸ ಅತಿ ಪ್ರೀತಿಯ ಗೆಳೆಯನಾಗುವನೆ? ಗೆಳೆತನದ ಈ ಕಥೆಯನ್ನು ಓದಿ ತಿಳಿಯಿರಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712362/size7/6e9dd62bad3d039fcb159c653b045aae.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712362/size7/6e9dd62bad3d039fcb159c653b045aae.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-5277","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-5277","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":101,"opdsId":"urn:uuid:SW-11039","title":"ಕಥೆಗಳ ಮಹಾನಗರ","authors":["K. Rajalakshmi"],"language":"","readingLevel":"","publisher":"","summary":"ಆ ನಗರದಲ್ಲಿ ಯಾರಿಗೂ ಕಥೆ ಹೇಳಲು ಗೊತ್ತಿರಲಿಲ್ಲ. ಪುಟ್ಟಿ ಮತ್ತು ಅಕ್ಕಯ್ಯ ನಗರದಲ್ಲಿ ಕಥೆಯ ಮಹಾಪೂರವನ್ನೇ ಹರಿಸಿದರು. ಸಣ್ಣ ನಗರವೊಂದನ್ನು ಕಥೆಗಳ ಮಹಾನಗರಿಯನ್ನಾಗಿ ಪರಿವರ್ತಿಸಿದ ಆಕರ್ಷಕವಾದ ಈ ಕಥೆಯನ್ನು ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/696863/size7/c637010f3ab1b8255033925b14a2a69c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/696863/size7/c637010f3ab1b8255033925b14a2a69c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-11039","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-11039","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":102,"opdsId":"urn:uuid:SW-5768","title":"ಮುತ್ತಜ್ಜಿಯ ವಯಸ್ಸೆಷ್ಟು?","authors":["Manjunatha Varadaraju"],"language":"","readingLevel":"","publisher":"","summary":"ಮುತ್ತಜ್ಜಿಗೆ ತುಂಬಾ ವಯಸ್ಸಾಗಿದೆ ಎಂಬುದು ಪುಟ್ಟ ಮತ್ತು ಪುಟ್ಟಿಗೆ ಗೊತ್ತು. ಆದರೆ ನಿಖರವಾಗಿ ಅವರ ವಯಸ್ಸು ಎಷ್ಟು? ಅದರ ಅನ್ವೇಷಣೆಗೆ ಮುಂದಾದ ಪುಟ್ಟ, ಪುಟ್ಟಿ ಮುತ್ತಜ್ಜಿಯ ನೆನಪುಗಳು ಹಾಗೂ ದೇಶದ ಇತಿಹಾಸವನ್ನು ತಿಳಿದುಕೊಳ್ಳುತ್ತಾ ಲೆಕ್ಕಾಚಾರಕ್ಕೆ ಮುಂದಾದರು. ಬನ್ನಿ, ಈ ಜೋಡಿ ಪತ್ತೇದಾರಿಗಳೊಂದಿಗೆ ನೀವೂ ಜತೆಗೂಡಿ..","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723800/size7/30b6242b35da965c70816bf0f26308c3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723800/size7/30b6242b35da965c70816bf0f26308c3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-5768","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-5768","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":103,"opdsId":"urn:uuid:SW-124","title":"ಇಂದು ನಗುವಿರಲಿಲ್ಲ","authors":["Ravikiran"],"language":"","readingLevel":"","publisher":"","summary":"ಶಾಂತಿ ತುಂಬಾ ಚೂಟಿ. ಅವಳು ಸುಮ್ಮನೆ ಕುಳಿತದ್ದಾಗಲಿ, ಮಾತಾಡದೇ ಇದ್ದುದನ್ನಾಗಲೀ ಯಾರೂ ನೋಡಿರಲಿಲ್ಲ. ಆದರೆ ಒಂದು ದಿನ ಅವಳು ಇದ್ದಕ್ಕಿದ್ದಂತೆ ತನ್ನ ಸ್ನೇಹಿತರೊಂದಿಗೆ ಮಾತು ನಿಲ್ಲಿಸಿದ್ದಳು. ಶಾಂತಿಗೆ ಏನಾಗಿತ್ತು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721014/size7/3f052202b9d0ee3719cef5b8b813c31f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721014/size7/3f052202b9d0ee3719cef5b8b813c31f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-124","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-124","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":104,"opdsId":"urn:uuid:SW-79","title":"ಕಮಲಾ ಅತ್ತೆಯ ಮಗು","authors":["Shalini Jaikumar"],"language":"","readingLevel":"","publisher":"","summary":"ಕಮಲಾ ಅತ್ತೆಯ ಮಗುವನ್ನು ಎತ್ತಾಡುತ್ತಾ, ಅತಿ ಮುದ್ದು ಮಾಡುತ್ತಿರುವುದು ಅನುಗೆ ಇಷ್ಟವಾಗಲಿಲ್ಲ. ಅವಳಿಗೆ ಈ ಮಗುವೋ ಸ್ವಲ್ಪವೂ ತಿಳುವಳಿಕೆಯಿಲ್ಲದ ಪೆದ್ದು ಎನಿಸಿತು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721708/size7/e06593123cad33ccaac20b9451642c4d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721708/size7/e06593123cad33ccaac20b9451642c4d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-79","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-79","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":105,"opdsId":"urn:uuid:SW-569","title":"ಮರಗಳ ನಡುವೆ ಒಂದು ವಿಹಾರ","authors":["Bhavya"],"language":"","readingLevel":"","publisher":"","summary":"ಮನುಷ್ಯನ ಆಗಮನಕ್ಕಿಂತಲೂ ಮುಂಚಿತವಾಗಿಯೇ ಮರಗಳು ಭೂಮಿಯ ಮೇಲೆ ಇದ್ದವು. ಇವುಗಳ ತಂಪಾದ ನೆರಳು, ರುಚಿಯಾದ ಹಣ್ಣುಗಳು ಇಲ್ಲದಿದ್ದರೆ ಈ ಭೂಮಿ ನಿಜವಾಗಿಯೂ ಬರಡಾಗುತ್ತಿತ್ತು. ನಿಮಗಿದು ಗೊತ್ತಾ? ಒಂದು ಪರಂಗಿ ಹಣ್ಣಿನ ಬೀಜಗಳಿಂದ ಸುಮಾರು ಐನೂರು ಮರಗಳು ಬೆಳೆಯಬಹುದು! ಹುಣಸೆ ಮರದ ರೆಂಬೆಗಳ ಮೇಲೆ ದೆವ್ವಗಳಿರುತ್ತವೆ ಎನ್ನುವ ನಂಬಿಕೆ ಇರುವುದರಿಂದ ಜನರು ರಾತ್ರಿಯ ಹೊತ್ತು ಅದರ ಅಡಿಯಲ್ಲಿ ಮಲಗುವುದಿಲ್ಲ! ಬನ್ನಿ, ರಾಜನ ತೋಟದ ಮರಗಳ ನಡುವೆ ವಿಹರಿಸುತ್ತ ಭಾರತದ ಅದ್ಭುತವಾದ ಹಣ್ಣಿನ ಮರಗಳ ರುಚಿ. ಪರಿಮಳ ಹಾಗೂ ಅದರ ಜತೆಗೆ ಬೆಸೆದುಕೊಂಡಿರುವ ಐತಿಹ್ಯಗಳನ್ನು ತಿಳಿದುಕೊಳ್ಳೋಣ. ಈ ಕಲಿಕೆ ನಿಮ್ಮಲ್ಲಿ ಖಂಡಿತವಾಗಿ ಉಲ್ಲಾಸ ಮತ್ತು ಉತ್ಸಾಹ ತುಂಬುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/422995/size7/5bc4beb5c0db0f72368346a63702e768.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/422995/size7/5bc4beb5c0db0f72368346a63702e768.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-569","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-569","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":106,"opdsId":"urn:uuid:SW-556187","title":"ಕಪ್ಪು ಇರುವೆ","authors":["Bhat Ananthesha"],"language":"","readingLevel":"Level 1","publisher":"","summary":"ಕಪ್ಪು ಇರುವೆ ಧೈರ್ಯಶಾಲಿ ಇರುವೆಯಾಗಿದ್ದು, ಪೊದೆಯಲ್ಲಿ ಸಾಹಸಗಳನ್ನು ಮಾಡಲು, ಇತರ ಪ್ರಾಣಿಗಳನ್ನು ಭೇಟಿ ಮಾಡಲು ಮತ್ತು ಹೊಸ ವಿಷಯಗಳನ್ನು ಕಲಿಯಲು ಇಷ್ಟಪಡುತ್ತದೆ. ಆಕೆಯ ಮುಂದಿನ ಸಾಹಸದಲ್ಲಿ ಏನಾಗುತ್ತದೆ ಎಂದು ನೀವು ಯೋಚಿಸುತ್ತೀರಿ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/99522/size7/c7619b9b0b3b2df8ae5de6bf6539ef6f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/99522/size7/c7619b9b0b3b2df8ae5de6bf6539ef6f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-556187","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-556187","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":107,"opdsId":"urn:uuid:SW-9","title":"ಡುಮ್ಮರಾಜ  ಸಣಕಲು ನಾಯಿ","authors":["A.S. Chandra Mouli"],"language":"","readingLevel":"","publisher":"","summary":"ಡುಮ್ಮರಾಜನ ಜೊತೆಗೆ ಓಡಿ ಸಣಕಲ ನಾಯಿಯ ಜೊತೆಗೂಡಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721909/size7/578f72502f01ea8298384a08257557b2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721909/size7/578f72502f01ea8298384a08257557b2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-9","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-9","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":108,"opdsId":"urn:uuid:SW-64142","title":"ಮಾಯಾ ಕೀಟಗಳು: ನೀವೂ ಎಣಿಸಿ ನೋಡಿ","authors":["Shashi Sampalli"],"language":"","readingLevel":"","publisher":"","summary":"ಎಂದಾದರೂ ಕೀಟಗಳನ್ನು ಎಣಿಸಿದ್ದೀರಾ? ಅವುಗಳ ಅಚ್ಚರಿಯ ಲೋಕವನ್ನೊಮ್ಮೆ ಸುತ್ತಿ ಬರೋಣವಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715524/size7/35f9bcba83e1ac90a87d5e939fcc12c8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715524/size7/35f9bcba83e1ac90a87d5e939fcc12c8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-64142","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-64142","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":109,"opdsId":"urn:uuid:SW-26562","title":"ಗುರು ಮತ್ತು ಪೀಚು ವಿಹಾರ","authors":["Kumar S"],"language":"","readingLevel":"","publisher":"","summary":"ಗುರು ಮತ್ತು ಪೀಚುಗೆ ಆಟವಾಡಲು ಜಾಗವಿರಲಿಲ್ಲ. ಅದಕ್ಕಾಗಿ ಹೊಸ ಜಾಗಗಳನ್ನು ಅವರು ಹುಡುಕಿ ಹೊರಟಿದ್ದಾರೆ. ಬನ್ನಿ, ನಾವೂ ಹೋಗೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722963/size7/a8ebe3620e8f0c4efe7a4021ea268154.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722963/size7/a8ebe3620e8f0c4efe7a4021ea268154.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-26562","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-26562","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":110,"opdsId":"urn:uuid:SW-710","title":"ಅಕ್ಬರ್ ಮತ್ತು ಬಾಲದರ್ಜಿ","authors":["Sujatha Rajanna"],"language":"","readingLevel":"","publisher":"","summary":"ರಜಾನ ಅಪ್ಪ ರಹಮತ್ ಖಾನ್ ಇನ್ಯಾರೂ ಅಲ್ಲ, ಮೊಘಲ್ ದೊರೆ ಅಕ್ಬರನ ಖಾಸಾ ದರ್ಜಿ. ದೊರೆಯ ಬೇಸಿಗೆ ಉಡುಪುಗಳನ್ನು ತಲುಪಿಸಲು ಅವರು ಅರಮನೆಗೆ ತೆರಳಿದಾಗ ಅಕ್ಬರ ದೊರೆಗೆ ತನ್ನ ಅಪ್ಪ ಹೊಲಿದ ಉಡುಪುಗಳ ವಿನ್ಯಾಸ ಪೂರ್ತಿಯಾಗಿ ತೃಪ್ತಿ ತಂದಿಲ್ಲವೆಂದು ರಜಾನಿಗೆ ಮನವರಿಕೆಯಾಗುತ್ತದೆ. ಅಪ್ಪನಿಗೆ ನೆರವಾಗಬೇಕೆಂಬ ಉತ್ಕಟಾಕಾಂಕ್ಷೆ ಮಗನದು. ಆದರೆ, ಪುಟ್ಟ ಬಾಲಕನಿಂದ ಏನು ಮಾಡಲು ಸಾಧ್ಯ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703510/size7/13407a9c27504b76fe16a628a443bf2b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703510/size7/13407a9c27504b76fe16a628a443bf2b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-710","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-710","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":111,"opdsId":"urn:uuid:SW-32802","title":"ಮಿಜೋ ಕಾಡಿನಲ್ಲಿ ಅಲೆದಾಟ","authors":["Abdul  Rasheed"],"language":"","readingLevel":"","publisher":"","summary":"ಝಾಕುಮಾ ಮಿಜೋರಾಂ ಅರಣ್ಯದ ಧೀರ ವನಪಾಲಕ. ಅವನೊಡನೆ ನಾವೂ ಕಾಡೊಳಗೆ ತಿರುಗೋಣ. ಬಗೆಬಗೆಯ ಕಾಡ ಜೀವಿಗಳ ಬಗ್ಗೆ ತಿಳಿಯೋಣ ಕಾಡನ್ನು ಕಾಪಾಡುವುದು ಅಂದರೆ ಏನು ಎಂದೂ ಕಲಿಯೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/524523/size7/105ec7cc57f87e459269355b2764f4bf.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524523/size7/105ec7cc57f87e459269355b2764f4bf.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-32802","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-32802","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":112,"opdsId":"urn:uuid:SW-928","title":"ಅರಸರಾಯರ ಹಲ್ಲುನೋವು","authors":["Ishwar Daitota"],"language":"","readingLevel":"","publisher":"","summary":"ಕಾಡಿಗೆ ರಾಜನೇ ಇರಬಹುದು, ಆದರೆ ಸಿಂಹಕ್ಕೂ ಹಲ್ಲು ಉಜ್ಜುವುದು ತಪ್ಪುವುದಿಲ್ಲ. ಕಥೆ ಓದಿ ಸಿಂಹಕ್ಕೆ ಹಲ್ಲನ್ನು ಉಜ್ಜುವುದು ಹೇಳಿ ಕೊಟ್ಟವರು ಯಾರು ಎಂದು ತಿಳಿಯಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721939/size7/730a74fae41af958bee4353aff545c11.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721939/size7/730a74fae41af958bee4353aff545c11.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-928","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-928","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":113,"opdsId":"urn:uuid:SW-214454","title":"ಆಮೆ ಮತ್ತು ಮೊಲ","authors":["Nataraja J"],"language":"","readingLevel":"","publisher":"","summary":"ಆಮೆ ಮತ್ತು ಮೊಲ ಓಡಿದವು. ದಾರಿಯಲ್ಲಿ ಮೊಲವು ನಿದ್ರೆಗೆ ಜಾರಿತು ಮತ್ತು ಆಮೆ ಮುಂದೆ ಹೋಯಿತು. ಅಷ್ಟರಲ್ಲಿ ಆಮೆಗೆ ಸಿಂಹ ಸಿಕ್ಕಿತು. ಮುಂದೆ ಏನಾಗುತ್ತದೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/282978/size7/f0f4bc971ee80853a0691be353e006a1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/282978/size7/f0f4bc971ee80853a0691be353e006a1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-214454","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-214454","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":114,"opdsId":"urn:uuid:SW-61459","title":"ಪ್ರಾಣಿಗಳ ಮನೆಗಳು","authors":["Tanuja Jakkannavar"],"language":"","readingLevel":"","publisher":"","summary":"ಉದ್ದನೆಯ ಮನೆ, ಗಿಡದಲಿ ಮನೆ, ತೂಗಾಡುವ ಮನೆ, ನೆಲದಲಿ ಕಟ್ಟಿರುವ ಮನೆ. ನಿಮ್ಮ ಸುತ್ತಮುತ್ತ ವಾಸಿಸುವ ಪ್ರಾಣಿ, ಪಕ್ಷಿ ಮತ್ತು ಕೀಟಗಳ ಮನೆಗಳಿಗೆ ಹೋಗಿ ಬರೋಣವಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725062/size7/de0a6352d4f39207a42bf18cab47fef2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725062/size7/de0a6352d4f39207a42bf18cab47fef2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-61459","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-61459","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":115,"opdsId":"urn:uuid:SW-214837","title":"ಗಾಳಿಪಟ","authors":["Shabana Begum"],"language":"","readingLevel":"","publisher":"","summary":"ಬೇರೆ-ಬೇರೆ ಬಣ್ಣದ ಗಾಳಿಪಟಗಳು ಸಿಗುತ್ತವೆ ಮತ್ತು ಗಾಳಿಪಟಗಳು ಆಕಾಶದಲ್ಲಿ ಹಾರಾಡುತ್ತವೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/282952/size7/eb0f647eb11fc2423960eb9295c21a0b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/282952/size7/eb0f647eb11fc2423960eb9295c21a0b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-214837","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-214837","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":116,"opdsId":"urn:uuid:SW-11132","title":"ನೀಮಾ, ಇವತ್ತು ಏನು ತಿನ್ನುತ್ತಾಳೆ?","authors":["Aparna Prasanna"],"language":"","readingLevel":"","publisher":"","summary":"ತಿನ್ನುವುದನ್ನು ಇಷ್ಟಪಡುವ ನೀಮಾಳನ್ನು ಭೇಟಿ ಮಾಡಿ. ಜಾರುವ ಲಿಚಿ, ಮೆತ್ತಗಿನ ನೇರಳೆ ಹಣ್ಣು, ಹುಳಿಯಾದ ಹುಣಸೆ, ಹೊಳೆಯುವ ಪಾಲಕ್ – ಅವಳಿಗೆ ಎಲ್ಲವೂ ಇಷ್ಟ!! ತಿನ್ನುತ್ತ, ಅಗಿಯುತ್ತ ವರ್ಷವಿಡಿ ಕಳೆಯುವ ನೀಮಾ ಜೊತೆ ನೀವೂ ಸೇರಿಕೊಳ್ಳಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712721/size7/2f46f2aea0d54ba83cce96e1c6f9d5d9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712721/size7/2f46f2aea0d54ba83cce96e1c6f9d5d9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-11132","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-11132","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":117,"opdsId":"urn:uuid:SW-214522","title":"ಅಳಿಲು","authors":["Nataraja J"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂದು ಅಳಿಲು  ತುಂಬಾ ತುಂಟಾಟ ಮಾಡುತ್ತಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/294294/size7/2e3c7a1ed3a82e33b4a69d826c2af6f7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/294294/size7/2e3c7a1ed3a82e33b4a69d826c2af6f7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-214522","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-214522","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":118,"opdsId":"urn:uuid:SW-22","title":"ಚುಸ್ಕಿಟ್ ಶಾಲೆಗೆ ಹೋಗುತ್ತಾಳೆ","authors":["K. P. Bhatt"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂಬತ್ತರ ಪ್ರಾಯದ ಚುಸ್ಕಿತ್ ಗೆ ಶಾಲೆಗೆ ಹೋಗಲು ಆಸೆ. ಸ್ನೇಹಿತರನ್ನು ಮಾಡಿಕೊಳ್ಳುವ ಆಸೆ. ಲೆಕ್ಕ ಕಲಿಯುವ ಆಸೆ. ಆಟವಾಡುವ ಆಸೆ. ಆದರೆ ಅದು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ, ಅಬ್ದುಲ್ ಅವಳಿಗೆ ಹೇಗಾದರೂ ಸಹಾಯ ಮಾಡೋಣವೆಂದು ನಿಶ್ಚಯಿಸುವವರೆಗೂ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/696796/size7/84e50630872438f3eac4b91c9d7b8caf.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/696796/size7/84e50630872438f3eac4b91c9d7b8caf.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-22","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-22","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":119,"opdsId":"urn:uuid:SW-54250","title":"ಹಾಥಿಭಾಯಿ","authors":["Meera Tushar Punarvasu"],"language":"","readingLevel":"","publisher":"","summary":"ಗುಜರಾತಿನ ಜಾನಪದದಲ್ಲಿ 'ಹಾಥಿಬಾಯಿ' ಎನ್ನುವ ಪುಟ್ಟ ಹಾಡಿದೆ. ಹಲವು ವರ್ಷಗಳಿಂದ ಅಲ್ಲಿನ ಮಕ್ಕಳ ಬಾಯಲ್ಲಿ ಈ ಹಾಡು ಜನಜನಿತ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726800/size7/518e753c9e4171032d31a6d8f386d7c0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726800/size7/518e753c9e4171032d31a6d8f386d7c0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-54250","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-54250","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":120,"opdsId":"urn:uuid:SW-29670","title":"ಕಾಮನಬಿಲ್ಲಿನ ಸಾಂಬಾರು","authors":["Subhashini  M.L."],"language":"","readingLevel":"","publisher":"","summary":"ಭವ್ಯ ಮತ್ತು ಅಜ್ಜಿ ಇವತ್ತು ಏನು ತಿನ್ನಬೇಕು? ಭವ್ಯಳ ಅಚ್ಚುಮೆಚ್ಚಿನ ಅಡುಗೆ… ಅಂದರೆ ಕಾಮನಬಿಲ್ಲಿನ ಸಾಂಬಾರು! ಮಧ್ಯಾಹ್ನದ ರುಚಿಯಾದ ಊಟಕ್ಕೆ ಭವ್ಯ ಮತ್ತು ಅಜ್ಜಿಗೆ ನೀವೂ ಜತೆಯಾಗಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/56684/size7/b9155fef4902fd82e8b9529dcf1c6ce3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/56684/size7/b9155fef4902fd82e8b9529dcf1c6ce3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-29670","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-29670","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":121,"opdsId":"urn:uuid:SW-15400","title":"ಕುಹೂ ಕುಹೂ ಕೋಗಿಲೆ","authors":["Jayashree Deshpande"],"language":"","readingLevel":"","publisher":"","summary":"ಅನುಪಮ ಕಂಠದ ಪ್ರಕೃತಿಯ ಹಾಡುಗಾರ ಹಕ್ಕಿ ಕೋಗಿಲೆ ನಗರಗಳಲ್ಲಿ ವಾಸವಾಗಿರುವುದಿಲ್ಲವೇನು? ನಗರದ ಬಾಲಕ ರಾಜು ಹಾಗೂ ಗ್ರಾಮಾಂತರ ಕೋಗಿಲೆಯ ಆತ್ಮೀಯ ಮಾತುಕತೆಯ ಚಿತ್ರಣವೇ ಕುಹೂ ಕುಹೂ ಕೋಗಿಲೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722314/size7/eaafe192563b3d5c62345ba000badfa8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722314/size7/eaafe192563b3d5c62345ba000badfa8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15400","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15400","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":122,"opdsId":"urn:uuid:SW-24882","title":"ಉಮಾ ಮತ್ತು ಉಪ್ಪಿಟ್ಟು","authors":["soma shekar"],"language":"","readingLevel":"","publisher":"","summary":"ಉಮಾ ನಾಲ್ಕನೇ ಕ್ಲಾಸಿನ ಹುಡುಗಿ. ತಿಂಡಿ ಎಂದರೆ ಅಷ್ಟಕ್ಕಷ್ಟೆ. ಏನು ಕೊಟ್ಟರೂ ಆಟದ ವಸ್ತು. ಅಮ್ಮನಿಗೆ ಸುಸ್ತೋ ಸುಸ್ತು. ಇವಳ ತಿಂಡಿಯ ಆಟ ನಿಲ್ಲಿಸೋದು ಹೇಗೆ? ಬನ್ನಿ ನೋಡೋಣ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/91617/size7/7665b5719e56df1b97c01a18608f9f09.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/91617/size7/7665b5719e56df1b97c01a18608f9f09.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-24882","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-24882","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":123,"opdsId":"urn:uuid:SW-650","title":"ಶಾಲೆಗೆ ಬಂದ ತರಕಾರಿಗಳು","authors":["Venkatramana Gowda"],"language":"","readingLevel":"","publisher":"","summary":"ಶಾಲೆಗೆ ಹೊರಟ ಪುಟಾಣಿಗೆ ದಾರಿಯಲ್ಲಿ ಜೊತೆಯಾದ ಅಪೂರ್ವ ಜೀವಿಗಳು ಯಾರು? ತಿಂದು ಹೊಟ್ಟೆ ಸೇರಬೇಕಾದ ಸೊಪ್ಪು ತರಕಾರಿಗಳು ಶಾಲೆಗೇ ಬಂದು ಪಾಠ ಮಾಡಿದರೆ? ಅದುವೇ ಶಾಲೆಗೆ ಬಂದ ತರಕಾರಿಗಳು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722318/size7/17abcfb72df4343564c63356594732e8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722318/size7/17abcfb72df4343564c63356594732e8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-650","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-650","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":124,"opdsId":"urn:uuid:SW-72","title":"ಆಹಾ, ಎಲ್ಲವೂ ಹೊಸತು!","authors":["Shaila Manipal"],"language":"","readingLevel":"","publisher":"","summary":"ಮೀನುವಿನ ಸುತ್ತಲು  ಹಲವಾರು ಹೂಗಳು, ಹಲವಾರು ಬಣ್ಣಗಳು, ಪಕ್ಷಿಗಳು ಮತ್ತು ಅಳಿಲುಗಳು ಕಿಚಿಪಿಚಿಗುಟುತ್ತಾ, ಚಿಲಿಪಿಲಿ ಎನ್ನುತ್ತಾ ಓಡಾಡುವ ಮನಸೆಳೆಯುವ ವಾತಾವರಣ ಇದೆ. ಮೀನು ಪ್ರಕೃತಿಯ ಈ ಚೆಲುವಿನಲ್ಲಿ ಮುಳುಗಿಹೋಗಿದ್ದಾಳೆ. ಎಷ್ಟೇ ಆದರೂ ಇದು ವಸಂತಕಾಲ ಅಲ್ಲವೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/702434/size7/ba622e2c893a49e15653341c6057331a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/702434/size7/ba622e2c893a49e15653341c6057331a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-72","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-72","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":125,"opdsId":"urn:uuid:SW-37452","title":"ಶಿಳ್ಳೆಗೆ ಒಳ್ಳೇ ಉಪಾಯ","authors":["Pallavi Rao"],"language":"","readingLevel":"reading","publisher":"","summary":"ಪ್ರೆಶರ್ ಕುಕ್ಕರ್ ಮೂರು ಶಿಳ್ಳೆ ಹೊಡೆದೊಡನೆ ಒಲೆ ಆರಿಸುವಂತೆ ಅಮ್ಮ ನಿವಿಗೆ ಹೇಳಿದ್ದಾಳೆ. ನಿವಿಗೊ ಅದರ ಬದಲು ತನ್ನ ಹೊಸ ಪುಸ್ತಕ ಓದಬೇಕಾಗಿದೆ! ಜಾಣತನದಿಂದ ಅವಳು ಎರಡೂ ಕೆಲಸವನ್ನು ಹೇಗೆ ಮಾಡಿದಳು ನೋಡಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/713820/size7/735e2105b6ba7d1d28b34e8940ff584c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/713820/size7/735e2105b6ba7d1d28b34e8940ff584c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-37452","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-37452","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":126,"opdsId":"urn:uuid:SW-44016","title":"ನನಗೆ ಈಗಲೇ ಹೇಳು! ನಿನಗೊಳ್ಳೆಯದು","authors":["Ishwar Daitota"],"language":"","readingLevel":"","publisher":"","summary":"ಸಾಮಾನ್ಯವಾಗಿ ಮಗು ತನ್ನ ಸುತ್ತಮುತ್ತಲಿನಲ್ಲಿ ಕಾಣುವ ಬಣ್ಣ ಮತ್ತು ಆಕಾರಗಳ ಬಗ್ಗೆ ಕುತೂಹಲದಿಂದ ಕೇಳುತ್ತದೆ. ಈ ಪ್ರಶ್ನೆ - ಉತ್ತರಗಳು ಹೇಗೆ ಆಕರ್ಷಕವಾಗಿರುತ್ತವೆ ಎನ್ನುವುದನ್ನು ನನಗೆ ಈಗಲೇ ಹೇಳು: ನಿನಗೊಳ್ಳೆಯದು ಕಥೆ ತಿಳಿಸುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/118167/size7/4639d7adf6ecaf744a6d4318b423e6a0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/118167/size7/4639d7adf6ecaf744a6d4318b423e6a0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-44016","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-44016","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":127,"opdsId":"urn:uuid:SW-220006","title":"ಯಾರು ಹೇಗೆ ಕೂಗುತ್ತಾರೆ?","authors":["Shabana Begum"],"language":"","readingLevel":"","publisher":"","summary":"ಬಣ್ಣ, ರೂಪ, ಭಾಷೆ, ಎಲ್ಲಾ ಬೇರೆ ಬೇರೆ ಆದರೂ ನಾವು ಅವುಗಳನ್ನು ಪಕ್ಷಿಗಳು ಎಂದು ಕರೆಯುತ್ತೇವೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/282967/size7/ab1025686f316a36e8d26e195c5bb67a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/282967/size7/ab1025686f316a36e8d26e195c5bb67a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-220006","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-220006","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":128,"opdsId":"urn:uuid:SW-236","title":"ಚಂದಿರ ಮತ್ತು ಟೋಪಿ","authors":["Ishwar Daitota"],"language":"","readingLevel":"","publisher":"","summary":"ಬಿಸಿಲಿನ ಝಳ ಇದ್ದಾಗ ಟೋಪಿ ಧರಿಸಲು ನಿಮಗಿಷ್ಟವೇನು? \nಈ ಆಕರ್ಷಕ ಪುಸ್ತಕದಲ್ಲಿ ಇನ್ಯಾರೆಲ್ಲಾ ಟೋಪಿ ಧರಿಸಲು ಬಯಸುತ್ತಾರೆ ಎಂದು ಪತ್ತೆ ಹಚ್ಚಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/700911/size7/a7997747b4c2afe36ad258eb24979534.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/700911/size7/a7997747b4c2afe36ad258eb24979534.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-236","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-236","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":129,"opdsId":"urn:uuid:SW-11761","title":"ಸರ್ಪಿ ಎಂಬ ಹಾವು","authors":["Sneha","Vishwas  HV"],"language":"","readingLevel":"","publisher":"","summary":"ಸರ್ಪಿಗೆ ನೇರ ಸಾಲುಗಳಲ್ಲಿ ಚಲಿಸುವ ಆಸೆ. ಆದರೆ ನೀವು ಯಾವುದಾದರೂ ನೇರವಾಗಿ ಹರಿವ ಹಾವನ್ನು ನೋಡಿದ್ದೀರಾ? ಆದರೆ, ಜಿಂಕೆ, ಹಕ್ಕಿಗಳನ್ನು ನೋಡಿದ ಸರ್ಪಿ ತಾನೇ ಉತ್ತರ ಕಂಡುಕೊಂಡಿತು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721005/size7/1e607d5b8d020b4737ff6d164801146d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721005/size7/1e607d5b8d020b4737ff6d164801146d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-11761","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-11761","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":130,"opdsId":"urn:uuid:SW-50303","title":"ಅಮ್ಮಾ ತುಪ್ಪ ಹೇಗಾಯ್ತು?","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಟೀನಾಗೆ ತುಪ್ಪ ಎಂದರೆ ಇಷ್ಟ. ಅದರಲ್ಲೂ ಅವಳಿಷ್ಟದ ಹೋಳಿಗೆ ಜೊತೆ ತುಪ್ಪ ಎಂದರೆ ಬಾಯಲ್ಲಿ ನೀರೂರುವುದು. ಆದರೆ, ತುಪ್ಪ ಬಂದಿದ್ದು ಎಲ್ಲಿಂದ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/725461/size7/e2b03f77a1f2932b13834b337e4bea82.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/725461/size7/e2b03f77a1f2932b13834b337e4bea82.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-50303","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-50303","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":131,"opdsId":"urn:uuid:SW-19108","title":"ಸಿಂಹದ ಅಂಬಾರಿ","authors":["Ishwar Daitota"],"language":"","readingLevel":"100daysreadingcampaignPunjab2022","publisher":"","summary":"ಕಾಡಿನ ರಾಜ ನಾಡಿನ ರಾಜನ ಅನುಕರಣೆ ಮಾಡಲು ಹೊರಟರೆ ಏನಾಗುತ್ತದೆ? ಒಳ್ಳೇ ಕುಲುಕಾಟದ ದರ್ಬಾರ್! ಈ ತಮಾಷೆ ಕಥೆ ಓದಿದರೆ ಸಮಾಚಾರ ಗೊತ್ತಾಗುತ್ತದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721657/size7/6407c1d16f9a71e4f6fb2943dbccfd4b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721657/size7/6407c1d16f9a71e4f6fb2943dbccfd4b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-19108","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-19108","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":132,"opdsId":"urn:uuid:SW-26959","title":"ಲಯಾಳ ಬೊಂಬಾಟ್ ಬೈಕಿನ ಅದ್ಭುತ ಪೆಟ್ಟಿಗೆ","authors":["Smitha sathyaprakash"],"language":"","readingLevel":"","publisher":"","summary":"ಶಾಲೆಯಲ್ಲಿ ಮಕ್ಕಳಿಗೆ ಆಟಗಳನ್ನು ಕಲಿಸುವ ಲಯಾ ಮಿಸ್ ಗೆ ಅವರ ಬೊಂಬಾಟ್ ಬೈಕಿನ ಜತೆ ಜನರಿಗೆ ಸಹಾಯ ಮಾಡುವುದು ತುಂಬ ಇಷ್ಟ. ಈ ಬಾರಿ ಲಯಾ ಮಿಸ್  ಬೊಂಬಾಟ್ ಬೈಕ್ ನಲ್ಲಿರುವ ಅದ್ಭುತ ಪೆಟ್ಟಿಗೆಯಲ್ಲೇನಿದೆ ಎಂದು ನೋಡೋಣ.  ಇದು ‘ಲಯಾಳ ಬೊಂಬಾಟ್ ಬೈಕು’ ಪುಸ್ತಕ ಮಾಲೆಯ ಮೂರನೆಯ  ಕಥೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723795/size7/ffe235cca5707bc8faf425742b37efc6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723795/size7/ffe235cca5707bc8faf425742b37efc6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-26959","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-26959","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":133,"opdsId":"urn:uuid:SW-48298","title":"ಗುಮ್ಮಣ್ಣ, ಗುಮ್ಮಣ್ಣ!","authors":["Kollegala Sharma"],"language":"","readingLevel":"","publisher":"","summary":"ಎಚ್ಚರ! ಎಲ್ಲೆಲ್ಲೂ ಗುಮ್ಮಣ್ಣ ಇದ್ದಾನೆ. ನಮ್ಮ ಮಕ್ಕಳು ಹೇಳಿದ ಮಾತು ಕೇಳದಿದ್ದಾಗ ಅಮ್ಮಂದಿರಿಗೆ ಗುಮ್ಮಣ್ಣ ಬೇಕೇ ಬೇಕು. ಇಲ್ಲಿ ನೀವು ಬೇರೆ, ಬೇರೆ ಆಕಾರ, ಗಾತ್ರದ ಗುಮ್ಮಣ್ಣರನ್ನು ಕಾಣುವಿರಿ. ಅವರು ಇಲ್ಲೂ, ಅಲ್ಲೂ ಸುತ್ತಾಡುತ್ತಿರಬಹುದು. ಎಚ್ಚರ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/157772/size7/c22c969c00ed3abf7b7e06e6075fa53c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/157772/size7/c22c969c00ed3abf7b7e06e6075fa53c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-48298","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-48298","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":134,"opdsId":"urn:uuid:SW-1038","title":"ಅಜ್ಜಿಯ ಕನ್ನಡಕ","authors":["Geetha M."],"language":"","readingLevel":"","publisher":"","summary":"ಅಜ್ಜಿ ಯಾವಾಗಲೂ ತಮ್ಮ ಕನ್ನಡಕವನ್ನು ಮರೆಯುತ್ತಿರುತ್ತಾರೆ. ಕೆಲವೊಮ್ಮೆ ಅದನ್ನು ಹುಡುಕಿ ಕೊಡಲು ಅವರಿಗೆ ಚಾಣಾಕ್ಷ ಪತ್ತೇದಾರಳ ಅಗತ್ಯವಿದೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/700894/size7/0b3a679b1d24e2b4e223307bff56b880.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/700894/size7/0b3a679b1d24e2b4e223307bff56b880.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-1038","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-1038","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":135,"opdsId":"urn:uuid:SW-15069","title":"ಕಡಲಾಮೆಯ ಕಥೆ","authors":["Sujatha Rajanna"],"language":"","readingLevel":"","publisher":"","summary":"ದೂರ ತೀರಗಳ ಮರಳಿನಡಿಯಲ್ಲಿ ಸೂರ್ಯನ ಶಾಖದಿಂದ ಬೆಚ್ಚಗಿರುವ ಆಲಿವ್ ರಿಡ್ಲಿ ಮೊಟ್ಟೆಗಳು ಒಡೆದು ಎಳೆಯ ಕಡಲಾಮೆಗಳು ಹೊರಬರುತ್ತವೆ. ಅಂತವುಗಳಲ್ಲಿ ಒಂದು ಮರಿ ಈ ಕಥೆಯ ನಿರೂಪಕ; ದಾರಿ ತಪ್ಪದೆ, ಯಾವ ದುಷ್ಟ ಬಾಯಿಗೂ ಸಿಗದೆ ಕಿನಾರೆಯನ್ನು ದಾಟಿ ಸಾಗರವನ್ನು ಸೇರಿಕೊಳ್ಳಲು ಸಂತೋಷಪಡುತ್ತದೆ.\n\nಆದರೆ, ಈ ನಮ್ಮ ಪುಟ್ಟ ಆಮೆ ಸಾಗರದ ಅಪಾಯಗಳನ್ನು ಎದುರಿಸಿ ಬಾಳಬಲ್ಲುದೇ? ದುರುಳ ಶಾರ್ಕ್‌ಗಳಿಗೆ ಆಹಾರವಾಗದೆ, ಮೀನು ಬಲೆಗಳಿಗೆ ಸಿಲುಕದೆ ದೊಡ್ಡ ಕಡಲಾಮೆಯಾದೀತೇ? ಮುಂದೊಂದು ದಿನ ತನ್ನದೇ ಗರ್ಭದಿಂದ ಮೊಟ್ಟೆಗಳನ್ನು ಇಡಬಲ್ಲುದೇ?\n\nಈ ಮುದ ನೀಡುವ ಆಲಿವ್ ರಿಡ್ಲಿ ಕಡಲಾಮೆಯ ಜೀವನ ಕಥೆಯನ್ನು ಓದಿರಿ ಹಾಗೂ ಇತರ ಅನೇಕ ಜಲಚರಗಳ ಬಗ್ಗೆಯೂ ತಿಳಿದುಕೊಳ್ಳಿರಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/27753/size7/e21f0014824d4500d005ff02b9529442.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/27753/size7/e21f0014824d4500d005ff02b9529442.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15069","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15069","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":136,"opdsId":"urn:uuid:SW-214369","title":"ಬಸ್","authors":["Shabana Begum"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂದು ಬಸ್ ರಸ್ತೆಯಲ್ಲಿ ಪೌಂವ್-ಪೌಂವ್ ಶಬ್ಧ ಮಾಡಿ ಚಲಿಸುತ್ತಿದೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283812/size7/370660d1ad37768096cf4db0aa609335.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283812/size7/370660d1ad37768096cf4db0aa609335.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-214369","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-214369","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":137,"opdsId":"urn:uuid:SW-19112","title":"ಇದು ಏನು?","authors":["A.S. Chandra Mouli"],"language":"","readingLevel":"","publisher":"","summary":"ಅರಣ್ಯದ ಕೋಕಿಲ ಕಂಠವನ್ನು ಭೇಟಿಯಾಗಲು ಬನ್ನಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/118239/size7/24acd1b6280faa5efff9d119b107c8d2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/118239/size7/24acd1b6280faa5efff9d119b107c8d2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-19112","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-19112","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":138,"opdsId":"urn:uuid:SW-15104","title":"ಮರ ಕಡಿಯುವಾತ - ಇಥಿಯೋಪಿಯಾ ಜಾನಪದ ಕಥೆ","authors":["R. Venkatesh"],"language":"","readingLevel":"","publisher":"","summary":"ಒಂದು ದಿನ ಬೆಳಗ್ಗೆ ಕಟ್ಟಿಗೆ ಕಡಿವ ಗುರಾ ಸ್ವಲ್ಪ ಸೌದೆಯನ್ನು ತರಲು ಕಾಡಿಗೆ ಹೊರಟ. ಒಂದು ಮರವನ್ನು ಏರಿ ಒಂದು ದೊಡ್ಡ ರೆಂಬೆಯ ಕೊನೆಯಲ್ಲಿ ಕುಳಿತುಕೊಂಡ. ನಂತರ ತಾನು ಕುಳಿತಿದ್ದ ರೆಂಬೆಯನ್ನು ಕಡಿಯಲು ಶುರು ಮಾಡಿದ. ಆ ಹಾದಿಯಲ್ಲಿ ಹೋಗುತ್ತಿದ್ದ ಗ್ರಾಮದ ಪೂಜಾರಿ, ಮರ ಗುರಾನನ್ನು ನೋಡಿ ನಿಂತು ಮಾತಾಡಿದ. ಹೀಗೆ ಮಾಡಿದರೆ ರೆಂಬೆ ಮುರಿದು, ನೀನು ಕೆಳಗೆ ಬಿದ್ದು ಸಾಯುವೆ ಎಂದು ಪೂಜಾರಿ ಎಚ್ಚರಿಸಿದ. ಮುಂದೇನಾಯಿತು ಎಂದು ತಿಳಿಯಲು ಇಥಿಯೋಪಿಯಾದ ಈ ಜಾನಪದ ಕಥೆ ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/699931/size7/16d65735feb6912fdd617ec9907fe4bf.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/699931/size7/16d65735feb6912fdd617ec9907fe4bf.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15104","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15104","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":139,"opdsId":"urn:uuid:SW-62766","title":"ಮಲರ್ ಕಟ್ಟಿದ ದೊಡ್ಡ ಮನೆ","authors":["Sriram MS"],"language":"","readingLevel":"","publisher":"","summary":"ಏನನ್ನಾದರೂ ಕಟ್ಟುತ್ತ ಇರುವವಳು ಮಲರ್. ಇವತ್ತು ಅವಳೇನು ಕಟ್ಟಬಹುದು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715434/size7/5613393324b2c4300bc530bb88cb1e16.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715434/size7/5613393324b2c4300bc530bb88cb1e16.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-62766","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"hre