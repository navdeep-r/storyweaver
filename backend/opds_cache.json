weaver.org.in/illustration_crops/191966/size7/9242ec477b75ce8d6c53ec9ca7103f99.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/191966/size7/9242ec477b75ce8d6c53ec9ca7103f99.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-103145","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-103145","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":781,"opdsId":"urn:uuid:SW-303467","title":"Old Woman in a Bottle","authors":["Lorato Trok"],"language":"","readingLevel":"","publisher":"","summary":"A greedy, lonely old woman is tired of living inside a bottle. One day, a fairy pays her a visit. Find out what happens to her!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/418464/size7/5e97aa42c6ae04ac3e506a40327ad23e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/418464/size7/5e97aa42c6ae04ac3e506a40327ad23e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-303467","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-303467","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":782,"opdsId":"urn:uuid:SW-134074","title":"Asamo, is that you?","authors":["Canato Jimo","Ogin Nayam"],"language":"","readingLevel":"","publisher":"","summary":"The lights are out, and Yumum is looking for Asamo. But what if she isn’t the only one wandering about in the dark?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723774/size7/cb584410ae752672dc7e46ce28d53087.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723774/size7/cb584410ae752672dc7e46ce28d53087.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-134074","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-134074","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":783,"opdsId":"urn:uuid:SW-38","title":"Counting on Moru","authors":["Rukmini Banerji"],"language":"","readingLevel":"","publisher":"","summary":"In Moru's world, numbers danced, digits waved out and long division looked ike a graceful tail. But one day, this world came crumbling down in school. Moru then became the local bully. Then, someone helped him discover the joy of learning again. Read all about it in this heartwarming story.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/696874/size7/9ff16cdbaba183411b9f0abc8173386f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/696874/size7/9ff16cdbaba183411b9f0abc8173386f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-38","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-38","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":784,"opdsId":"urn:uuid:SW-276","title":"This and That","authors":["Radha HS"],"language":"","readingLevel":"","publisher":"","summary":"Bekku and the little girl like different things. But there is one thing they both love. What do you think it is?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/704668/size7/0ee6cdb1e849d174ef05ae395bfb14f7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/704668/size7/0ee6cdb1e849d174ef05ae395bfb14f7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-276","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-276","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":785,"opdsId":"urn:uuid:SW-31970","title":"Pipsqueak Hears Echoes","authors":["Payal Molur","Sanjay Molur"],"language":"","readingLevel":"","publisher":"","summary":"Pipsqueak is an insect bat. He loves to eat mosquitoes for dinner. Sometimes, he and his friends have contests to see who will catch the most. Because it’s fun. And easy. What makes bats like him such great insect hunters? Echolocation, says Doctor Ella. She’s telling young Pip all about it. Let’s listen in, shall we?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716375/size7/0bb000dc2ee9314a7c7f07e30040eb94.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716375/size7/0bb000dc2ee9314a7c7f07e30040eb94.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-31970","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-31970","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":786,"opdsId":"urn:uuid:SW-23457","title":"The School is on Fire!","authors":["Magdalena  Cooper"],"language":"","readingLevel":"","publisher":"","summary":"One weekend, Teddy Bear, Ducky, and Fish go to the hill behind their school to roast some sweet potatoes. But suddenly, a strong wind comes and their fire spreads to the bushes. Soon, their school is on fire! What will the three friends do?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/120553/size7/35d69b9e70fd69096bd340f9d6ebb2f2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/120553/size7/35d69b9e70fd69096bd340f9d6ebb2f2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-23457","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-23457","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":787,"opdsId":"urn:uuid:SW-118927","title":"A rainbow tale","authors":["Mimi  Werna"],"language":"","readingLevel":"","publisher":"","summary":"Yana looks around, picks colours to reach the end of rainbow. Find out more about her quest in this book.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/202069/size7/872027738153ec241667e5277c29e16a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/202069/size7/872027738153ec241667e5277c29e16a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-118927","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-118927","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":788,"opdsId":"urn:uuid:SW-94094","title":"How Zebra got his stripes","authors":["Jaco Jacobs"],"language":"","readingLevel":"","publisher":"","summary":"Brave Zebra saves the day.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/139852/size7/cc857b88c9f9aeb63dcfdb0a58196033.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/139852/size7/cc857b88c9f9aeb63dcfdb0a58196033.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-94094","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-94094","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":789,"opdsId":"urn:uuid:SW-213349","title":"Who Am I?","authors":["Nancy Siddhant Dogra"],"language":"","readingLevel":"","publisher":"","summary":"An animal who has a pocket on its stomach and can jump really far! Can you guess its name?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283184/size7/c8dc580322ba6c1d13d94c78f05f8b06.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283184/size7/c8dc580322ba6c1d13d94c78f05f8b06.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-213349","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-213349","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":790,"opdsId":"urn:uuid:SW-94218","title":"Four Lambs and a Fox","authors":["Angesom  Abadi"],"language":"","readingLevel":"","publisher":"","summary":"One should be careful telling others a secret.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/138498/size7/ccc984907878eef5fc285c69c38e8fa4.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/138498/size7/ccc984907878eef5fc285c69c38e8fa4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-94218","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-94218","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":791,"opdsId":"urn:uuid:SW-173119","title":"I like to read","authors":["Letta Machoga"],"language":"","readingLevel":"","publisher":"","summary":"A story about reading.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/235022/size7/9f0ef652482649f3a62111cac60a16f6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/235022/size7/9f0ef652482649f3a62111cac60a16f6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-173119","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-173119","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":792,"opdsId":"urn:uuid:SW-158121","title":"My Elder Brother","authors":["Madhu B. Joshi"],"language":"","readingLevel":"","publisher":"","summary":"The elder brother is found with books and formulas. The younger brother is found with butterflies and lost kites. The elder brother keeps studying everyday and barely does anything else. The younger brother plays in gardens and enjoys doing what he likes. The elder brother takes every chance to criticize his younger brother for not studying. The younger brother still keeps playing outdoors. What follows is a timeless tale of following one's own heart despite those that only ridicule and demotivate.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/526077/size7/eeb09f48b43bd15afb126b9d2f8cef28.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/526077/size7/eeb09f48b43bd15afb126b9d2f8cef28.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-158121","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-158121","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":793,"opdsId":"urn:uuid:SW-444501","title":"The Lonely Whale Shark","authors":["Mahira Kakajiwala"],"language":"","readingLevel":"","publisher":"","summary":"A big little whale shark is sad and lonely on his reef. But when he meets a group of whale sharks,\nhe realises all he needs to do is look around him.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527540/size7/253f6a3fc66f50591bb0b261fdf07953.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527540/size7/253f6a3fc66f50591bb0b261fdf07953.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-444501","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-444501","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":794,"opdsId":"urn:uuid:SW-163725","title":"Polygon Family","authors":["African Storybook Initiative","Lindiwe Tshabalala"],"language":"","readingLevel":"","publisher":"","summary":"The family of Polygons come together in an attempt to know each other! Do you want to know them?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/228290/size7/e4e6314995480cca3523d0fff4f0b051.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/228290/size7/e4e6314995480cca3523d0fff4f0b051.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-163725","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-163725","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":795,"opdsId":"urn:uuid:SW-173","title":"The Jungle School","authors":["Madhav Chavan","Meera Tendolkar"],"language":"","readingLevel":"","publisher":"","summary":"The animals in the jungle rush to the new school with great enthusiasm. What do you think happened after that?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/701000/size7/449224bf6cf24a86087b052fd6327570.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/701000/size7/449224bf6cf24a86087b052fd6327570.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-173","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-173","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":796,"opdsId":"urn:uuid:SW-373315","title":"The Right Tools","authors":["C G Salamander"],"language":"","readingLevel":"","publisher":"","summary":"Isha’s house is being built from scratch by a lot of people. Join her as she discovers all the tools they use to build it.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/524492/size7/71c89ef279fc4bf1646113016705e08b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/524492/size7/71c89ef279fc4bf1646113016705e08b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-373315","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-373315","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":797,"opdsId":"urn:uuid:SW-444499","title":"A Bunch of Flowers","authors":["Liwliwa Malabed"],"language":"","readingLevel":"","publisher":"","summary":"What is happening to Peri’s mother? His mother is always sleeping, her room is always dark like a thick forest of tall trees. In this wordless book for early readers, Peri thinks of ways to bring the outdoors and sunshine back into their home and into his mother’s eyes.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527510/size7/34996dcb4ae6d0731bb0d88630443cec.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527510/size7/34996dcb4ae6d0731bb0d88630443cec.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-444499","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-444499","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":798,"opdsId":"urn:uuid:SW-26021","title":"Where Do My Thoughts Go?","authors":["Sherein Bansal"],"language":"","readingLevel":"","publisher":"","summary":"A girl is thinking about her thoughts! What do they do all day? Where do they go? Have you seen them anywhere?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/276432/size7/d9be1b71882531b5e4b2ebd28f8c9ef6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/276432/size7/d9be1b71882531b5e4b2ebd28f8c9ef6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-26021","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-26021","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":799,"opdsId":"urn:uuid:SW-213159","title":"The Blue Fruit","authors":["Kaminee Singh"],"language":"","readingLevel":"","publisher":"","summary":"Kasnee was surprised to see a blue fruit on a tree and ran to her mother...read more to find out what happens next!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283721/size7/fd214d8d30a37a6d012502a29ea9a738.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283721/size7/fd214d8d30a37a6d012502a29ea9a738.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-213159","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-213159","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":800,"opdsId":"urn:uuid:SW-214558","title":"A Scary Pit","authors":["Zubin Miller"],"language":"","readingLevel":"","publisher":"","summary":"Samira loves to cycle! But suddenly she stops when she hears a goat bleating…","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283380/size7/339a0666e3f6f30961d5f3dea5189159.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283380/size7/339a0666e3f6f30961d5f3dea5189159.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-214558","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-214558","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":801,"opdsId":"urn:uuid:SW-94122","title":"Are You the Woodpecker?","authors":["Suhel Quader"],"language":"","readingLevel":"","publisher":"","summary":"Oh no! Killi and Killan the parakeets have lost their home. They set out in search of the woodpecker who can make them a tree hole nest. The birds discover many other nests, but will they find a new home?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726997/size7/39aa7999b25b35f60ec02919fb3a4b79.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726997/size7/39aa7999b25b35f60ec02919fb3a4b79.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-94122","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-94122","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":802,"opdsId":"urn:uuid:SW-10031","title":"Mumtaz Embroiders Her Dreams","authors":["Jolly  Rohatgi"],"language":"","readingLevel":"","publisher":"","summary":"Young Mumtaz has come from her village to Lucknow to learn new stitches for the chikankari that she and the other women in her village do. Thanks to her friend Munnu, Mumtaz learns even more than she had imagined!  Jolly Rohtagi’s sensitive story is illustrated by Ram Soni through sanjhi, the art of paper cutting.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/118163/size7/cb7cdd8d49e3e690fae53b5375f67eb7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/118163/size7/cb7cdd8d49e3e690fae53b5375f67eb7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-10031","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-10031","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":803,"opdsId":"urn:uuid:SW-16146","title":"We call her Ba - A Biography of Kasturba Gandhi","authors":["Subhadra Sen Gupta"],"language":"","readingLevel":"","publisher":"","summary":"Kasturba Gandhi was no ordinary woman. She had a strong identity, courage and tremendous willpower and she sacrificed a lot for her country. She was a friend and trusted companion of the Father of the Nation, Mahatma Gandhi. Gandhiji’s biographer, Louis Fischer wrote about her, “Being herself and being at the same time a shadow of the Mahatma made her a remarkable woman.”\nRead about this amazing woman who walked shoulder to shoulder with one of the most prominent leaders of the world during the most turbulent times of this peninsula.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/43053/size7/b8e88a3967820974f51cc878f316d3ed.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/43053/size7/b8e88a3967820974f51cc878f316d3ed.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-16146","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-16146","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":804,"opdsId":"urn:uuid:SW-470","title":"Naughty or Not (Tell me now series)","authors":["Madhav Chavan"],"language":"","readingLevel":"","publisher":"","summary":"Often, an inquisitive child asks his parents an endless set of questions. The 'Tell me ... now!' Series describes how interesting the questions and answers turn out. This one is about behaviour.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/700475/size7/87fc5b8f1397a63daae7e68a63dae475.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/700475/size7/87fc5b8f1397a63daae7e68a63dae475.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-470","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-470","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":805,"opdsId":"urn:uuid:SW-112695","title":"The Amazing Adventure","authors":["Kim Ann Arun"],"language":"","readingLevel":"","publisher":"","summary":"Tito and Rika fight over a mobile phone when, by accidentally pressing a button, they summon a UFO. An alien appears at the door and asks them to come aboard. Accompanied by a puppy and firefly, they go on a grand adventure in the spaceship. But next morning they wonder… Was it all a dream?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/198771/size7/527817e40ccb3a942cde879c554bd00c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/198771/size7/527817e40ccb3a942cde879c554bd00c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-112695","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-112695","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":806,"opdsId":"urn:uuid:SW-259305","title":"The Secrets of Rocks","authors":["Suchi Govindarajan"],"language":"","readingLevel":"","publisher":"","summary":"Rocks are everywhere — under the ground,\nabove the ground, and even at the bottom of\nour oceans. But where do rocks come from?\nWhat are they made of? If rocks could talk,\nthey would share many secrets.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/716006/size7/2a7fc11e509d305c2c43159bbedf1d55.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/716006/size7/2a7fc11e509d305c2c43159bbedf1d55.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-259305","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-259305","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":807,"opdsId":"urn:uuid:SW-749","title":"The Sparrow and The Fruit","authors":["Divaspathy Hegde"],"language":"","readingLevel":"","publisher":"","summary":"When her plump juicy guava falls into a clump of thorns, Gubbi uses every trick she knows, and gets the fruit back. But is it right to use mean tricks to get what you want? Find out by reading this book!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722315/size7/b686eaaf5b0e52c1db3be9ef3e06a678.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722315/size7/b686eaaf5b0e52c1db3be9ef3e06a678.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-749","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-749","type":"application/epub+zip","rel":"http://opds-spec.o