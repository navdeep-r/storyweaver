tration_crops/701010/size7/e47e8431f29c226becbf3dc0b7a82b99.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/701010/size7/e47e8431f29c226becbf3dc0b7a82b99.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-149","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-149","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":200,"opdsId":"urn:uuid:SW-37268","title":"It's a Ghost!","authors":["Alisha Berger"],"language":"","readingLevel":"","publisher":"","summary":"Once there was a ghost who loved to scare someone every day. One day, he decided to look for something easy to scare… like a mouse! Will the mouse be as frightened as everyone else?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/617117/size7/f46f95b0a9c9d93baa8531860a28a997.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/617117/size7/f46f95b0a9c9d93baa8531860a28a997.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-37268","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-37268","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":201,"opdsId":"urn:uuid:SW-49732","title":"A Stitch in Time","authors":["Himadri  Das","Veena Prasad"],"language":"","readingLevel":"","publisher":"","summary":"First, a ripped shirt and then, a faulty iron box. The day has just begun for Shyam. With everything going wrong one after the other, Shrisha takes him to a Repair Mela where you can fix almost anything.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717377/size7/de7ac270e794445be00068049e544ed0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717377/size7/de7ac270e794445be00068049e544ed0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-49732","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-49732","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":202,"opdsId":"urn:uuid:SW-47980","title":"Shoecat Thoocat","authors":["Shalini  Srinivasan"],"language":"","readingLevel":"","publisher":"","summary":"Kamala’s new shoecat attacks whoever it meets! Tomatoes, thathas, friends, teachers, goats… everyone hates it. What will they do now?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/158527/size7/3980efa22d78c2250c1298435f56e840.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/158527/size7/3980efa22d78c2250c1298435f56e840.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-47980","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-47980","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":203,"opdsId":"urn:uuid:SW-37230","title":"Tall and Short","authors":["Celia  Bolam"],"language":"","readingLevel":"","publisher":"","summary":"Can you tell which family members are tall and which are short? This book demonstrates the concept of opposites— tall and short— through the members of a child’s family.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/101345/size7/e64bf7a17d2acc3605b1e60a19301d27.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/101345/size7/e64bf7a17d2acc3605b1e60a19301d27.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-37230","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-37230","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":204,"opdsId":"urn:uuid:SW-111469","title":"The Sound of Water","authors":["Shalini  Srinivasan"],"language":"","re