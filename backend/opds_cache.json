9f8111063ab35391.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-461858","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-461858","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":991,"opdsId":"urn:uuid:SW-457793","title":"ಪತ್ತೇದಾರ ಕೌಶಿಕ್","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಹೊಸ ಟಾರ್ಚ್, ಭೂತಗನ್ನಡಿ ಕೊಂಡು ತಂದ ಕೌಶಿಕ್ ತಾನು ನಿಜವಾಗಿಯೂ ಪತ್ತೇದಾರಿಯೇ ಆಗಿಬಿಟ್ಟೆ ಎಂದು ಭಾವಿಸುತ್ತಾನೆ. ಅವನು ಈಗ ಕಾಡಿನಲ್ಲಿ ಏನೇ ಪತ್ತೆ ಹಚ್ಚುತ್ತಿದ್ದಾನೆ. ನೀವೂ ಡಿಟೆಕ್ಟಿವ್ ಆಗುವ ಕನಸು ಕಾಣುತ್ತಿದ್ದರೆ ಬನ್ನಿ ಕೌಶಿಕ್ ಜೊತೆ ಸೇರಿಕೊಳ್ಳಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721717/size7/eb5a572c2dc1b8583ea321e7209afa20.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721717/size7/eb5a572c2dc1b8583ea321e7209afa20.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-457793","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-457793","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":992,"opdsId":"urn:uuid:SW-578061","title":"ಬಹುಭುಜ ಕುಟುಂಬ","authors":["Bhat Ananthesha"],"language":"","readingLevel":"level 4","publisher":"","summary":"ಬಹುಭುಜಗಳ ಕುಟುಂಬವು ಪರಸ್ಪರ ತಿಳಿದುಕೊಳ್ಳುವ ಪ್ರಯತ್ನದಲ್ಲಿ ಒಟ್ಟಿಗೆ ಸೇರುತ್ತವೆ! ನೀವು ಅವರನ್ನು ತಿಳಿದುಕೊಳ್ಳಲು ಬಯಸುವಿರಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/228290/size7/e4e6314995480cca3523d0fff4f0b051.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/228290/size7/e4e6314995480cca3523d0fff4f0b051.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-578061","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-578061","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"i