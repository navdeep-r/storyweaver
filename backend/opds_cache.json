s://storyweaver.org.in/api/v0/story/epub/SW-3566","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":266,"opdsId":"urn:uuid:SW-256809","title":"Hakeem's Hiccups","authors":["Sadaf Siddique"],"language":"","readingLevel":"","publisher":"","summary":"It’s Ramzan and Hakeem sahib has a case of the hiccups — so he can’t drink water to make it go away. What will hic-hic-hiccuping Hakeem sahib do, and can his patients help their beloved doctor?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495600/size7/5fdb186c7a37dff48a512042343b3013.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495600/size7/5fdb186c7a37dff48a512042343b3013.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-256809","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-256809","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":267,"opdsId":"urn:uuid:SW-38508","title":"The Golden Bird","authors":["Alisha Berger"],"language":"","readingLevel":"","publisher":"","summary":"When the king finds out there is a golden bird that can make him emperor of the universe, he goes on a mission to catch it! But his daughter has other ideas, and must muster her courage to stand up for her kingdom.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/96023/size7/a101742421bf42ffe882d16bdf4f5819.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/96023/size7/a101742421bf42ffe882d16bdf4f5819.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-38508","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-38508","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":268,"opdsId":"urn:uuid:SW-37257","title":"The Bubble Mystery","authors":["Alisha Berger"],"language":"","readingLevel":"","publisher":"","summary":"Toot-Toot is afraid of the water until she notices some funny bubbles. When she finally bathes in the pond, she sees lots of bubbles that go blop, blop, blop! Where do they come from? No one will answer when she asks. Can Toot-Toot solve the bubble mystery?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/427053/size7/9cafc47475f7d6eed6edb7877a504d6e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/427053/size7/9cafc47475f7d6eed6edb7877a504d6e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-37257","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-37257","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":269,"opdsId":"urn:uuid:SW-118183","title":"How I Feel","authors":["Varsha Seshan"],"language":"","readingLevel":"","publisher":"","summary":"How do you feel when Nani comes to visit?  How do you feel when you spoil a library book? Read this book and see how you feel today.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/171875/size7/b5e3b9c7796bf4435fbd82e63b8d4f38.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/171875/size7/b5e3b9c7796bf4435fbd82e63b8d4f38.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-118183","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-118183","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":270,"opdsId":"urn:uuid:SW-56813","title":"Savio Finds the Right Angle","authors":["Ramya Pai"],"language":"","readingLevel":"","publisher":"","summary":"Fatima wants to finish her homework on angles. But her brother Savio drags her out to the beach. Will an afternoon outdoors help Fatima with her homework?","coverUrl":"https://static.storyweaver.org.in/illustr