v0/story/epub/SW-10145","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":569,"opdsId":"urn:uuid:SW-10831","title":"कल्लू के किस्से ३ - मंगू माली और अँबिया भूत","authors":["Manisha Chaudhry"],"language":"","readingLevel":"","publisher":"","summary":"ख़जूरिया में आपका स्वागत है। इस गाँव मे कल्लू और उसके दोस्त रोज़ कुछ नया कारनामा कर दिखाते हैं। कभी गाँव की रुढ़ियों पर सवाल उठाते हैं तो कभी किसी की अकड़ निकाल के गाँव में नये विचारों की ताज़ी हवा का झोंका लाते हैं। पढ़ते-खेलते, छोटी-बड़ी खुशियों और दुखों को लिये, कल्लू और उसके दोस्तों की ज़िन्दगी में शरीक हो जाइये।\nख़जूरिया में मुनिया के गुस्से से सभी परिचित थे। मंगू माली किसी को भी अपने बाग से आम नहीं लेने देता था, यह भी सर्वविदित था। मुनिया को आम पाने का बड़ा लालच था। वह भी मंगू माली के बाग से! ऐसे में क्या होने वाला था? पढ़िये और जानिये।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/31115/size7/6d83c8e348dae277f57773d74ef2f9e2.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/31115/size7/6d83c8e348dae277f57773d74ef2f9e2.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-10831","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-10831","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":570,"opdsId":"urn:uuid:SW-202770","title":"गिलहरी","authors":["Dropti Sharma"],"language":"","readingLevel":"","publisher":"","summary":"एक गिलहरी कर रही है ख़ूब शैतानी।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/294294/size7/2e3c7a1ed3a82e33b4a69d826c2af6f7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/294294/size7/2e3c7a1ed3a82e33b4a69d826c2af6f7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-202770","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-202770","type":"application/epub+zip",