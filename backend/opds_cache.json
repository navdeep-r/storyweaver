":"https://static.storyweaver.org.in/illustration_crops/706699/size7/d25b79db41cf876f6c23e003227e6346.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/706699/size7/d25b79db41cf876f6c23e003227e6346.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-1005","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-1005","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":388,"opdsId":"urn:uuid:SW-377688","title":"वनस्पतींशी गुजगोष्टी","authors":["Neeta Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"नुकत्याच मोठ्या होऊ लागलेल्या जयश्रीला, झाडं आणि रोपं यांच्याइतकं दुसरं काहीही आवडायचं नाही. मग वनस्पतींना समजून घेण्यासाठी, आपलं सगळं आयुष्य तिनं त्याच आभासाला वाहून घ्यायचं ठरवलं. पर्यावरणतज्ज्ञ डॉ. जयश्री सुब्रह्मण्यम यांचं हे चरित्र म्हणजे जणू उत्कटतेची आणि उत्साहाची गाथाच आहे.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/491323/size7/1990bf6c5f6788bca49cd0131c95f55a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/491323/size7/1990bf6c5f6788bca49cd0131c95f55a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-377688","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-377688","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":389,"opdsId":"urn:uuid:SW-48473","title":"आऽकऽछी!","authors":["Vandana Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"माकड अत्यंत चौकस, जिज्ञासू होतं. त्याला नेहमीच खूप प्रश्न पडायचे. प्रत्येकाला मनापासून वाटायचं की आपणही माकडाला मदत करावी. परंतु काहीवेळा खरं उत्तर पूर्णपणे अनपेक्षित येत असे.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/179743/size7/a654b0074ddd5df4feccd29d7b3b57ee.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/179743/size7/a654b0074ddd5df4feccd29d7b3b57ee.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-48473","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-48473","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":390,"opdsId":"urn:uuid:SW-126624","title":"लाडूची षाभा","authors":["Atish Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"राहुल आणि ऋत्विकचे मित्र नेहमी त्यांच्या डब्यातल्या खाऊवर डल्ला मारायचे. मग आपल्या खाऊला मित्रांच्या तावडीतून वाचवायला एके दिवशी त्या दोघांनी एक भन्नाट सांकेतिक भाषा तयार केली... आपणही ती शिकूया का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/180166/size7/49c85a9527750e46622accc20a0c24f0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/180166/size7/49c85a9527750e46622accc20a0c24f0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-126624","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-126624","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":391,"opdsId":"urn:uuid:SW-150253","title":"कुवोम्बा - चिंतातुर ढगोबाई","authors":["Varsha Gajendragadkar"],"language":"","readingLevel":"","publisher":"","summary":"कुवोम्बाकडं १,००० जणांसाठीच्या मिठाईची मागणी नोंदवण्यात आली होती. खरंतर हे ऐकून तिनं खूश होऊन जायला हवं होतं. पण उलट ती प्रचंड चिंतेतच पडली. या मेजवानीसाठी इतकी सारी मिठाई वेळेत बनविणं कुवोम्बाला जमेल का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/527508/size7/513f04e8b2e0702bd7dd0c187bfa0544.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/527508/size7/513f04e8b2e0702bd7dd0c187bfa0544.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-150253","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-150253","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":392,"opdsId":"urn:uuid:SW-687","title":"आईची शाळेतली गंमत","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"एक दिवस मीराची आई तिच्या शाळेत गेली  पण तिथे तर कुणीच नव्हतं.\nमीरा, वर्गातली मुलं, शिक्षक सगळे कुठे गायब झाले होते ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723634/size7/30d13d0b8c4072a4032ab2309f586a32.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723634/size7/30d13d0b8c4072a4032ab2309f586a32.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-687","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-687","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":393,"opdsId":"urn:uuid:SW-260376","title":"छोट्याशा रोपट्याची गोष्ट","authors":["Sushrut Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"तुमच्या आजूबाजूला असणाऱ्या झाडांकडं जरा बारकाईनं पाहा बरं. कितीतरी बघण्यासारख्या गोष्टी दिसतील, कितीतरी प्राणी भेटतील आणि कितीतरी नवं शिकायला मिळेल.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715981/size7/10130d05074d4687484c87f23e820b1b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715981/size7/10130d05074d4687484c87f23e820b1b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-260376","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-260376","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":394,"opdsId":"urn:uuid:SW-38911","title":"लाडू पार्टी","authors":["Siddharth Kelkar"],"language":"","readingLevel":"","publisher":"","summary":"लाडू खाण्याची वेळ झाली आहे, पण मीरा आणि मिहीर ज्या ज्या वेळी लाडू खायला उचलतात, त्या-त्या वेळी बेल वाजते, डिंग डाँग!\nनेमके कोणीतरी पाहुणे येतात. त्यांच्याकडे बारा लाडू आहेत. पाहा, ती दोघं ते लाडू कसे वाटून घेतात बरं?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117565/size7/399dc3e5ef943846b6f10d2347afdec5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117565/size7/399dc3e5ef943846b6f10d2347afdec5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-38911","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-38911","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":395,"opdsId":"urn:uuid:SW-39587","title":"दिव्यानं नकाशा कसा काढला?","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"आपला मामेभाऊ रवी गाजापूरला येणार म्हणून दिव्या खूप उत्साहात आहे. रवीला अचूक रस्ता कसा सापडेल, याची तिला चिंता वाटते आहे. रवीला एखाद्या नकाशाची मदत होईल का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/717011/size7/6c1c36d92ace6c0269eb253f538a74bd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/717011/size7/6c1c36d92ace6c0269eb253f538a74bd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-39587","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-39587","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":396,"opdsId":"urn:uuid:SW-302762","title":"मला वर चढता येतं!","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"या छोटूला वर चढता तर येतं पण त्याला खाली उतरता येतं का? ’मोठ्ठं होताना’ या चार पुस्तकांच्या मालिकेतील हे एक पुस्तक.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/705479/size7/57c8c82ddc4444a38929edee69280586.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/705479/size7/57c8c82ddc4444a38929edee69280586.jpg","acquisitions":[{"h