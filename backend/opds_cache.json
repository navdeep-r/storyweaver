ustration_crops/723772/size7/b0476b13553c024e91d6672d33eb8bf7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723772/size7/b0476b13553c024e91d6672d33eb8bf7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-107267","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-107267","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":988,"opdsId":"urn:uuid:SW-94355","title":"The coffee legend","authors":["Alemu Abebe","CODE Ethiopia"],"language":"","readingLevel":"","publisher":"","summary":"Tells about the origin of coffee in Ethiopia.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/141898/size7/abb9020d5ee9a16dd632f4fe7184ddba.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/141898/size7/abb9020d5ee9a16dd632f4fe7184ddba.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-94355","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-94355","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":989,"opdsId":"urn:uuid:SW-209887","title":"All the Missing Socks","authors":["Easterine Kire"],"language":"","readingLevel":"","publisher":"","summary":"Striped ones, jangly ones, neon ones —\nwhere do all the socks go? This charming\nstory in verse will finally solve the mystery\nof the missing socks.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/287603/size7/fba59e27bdadfb9da6ce4325d90e068a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/287603/size7/fba59e27bdadfb9da6ce4325d90e068a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-209887","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-209887","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":990,"opdsId":"urn:uuid:SW-19362","title":"The Biscuit Jar Must Fall","authors":["Nozizwe  Herero"],"language":"","readingLevel":"","publisher":"","summary":"Prudence promises Micki and her friends that when they finish cleaning Micki’s room they can have biscuits. But when they are finished, Prudence is nowhere to be found. So Micki and her friends spend the rest of their day finding ways to reach the biscuit jar.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/85541/size7/895660e7ba678f57e23487be99152ea6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/85541/size7/895660e7ba678f57e23487be99152ea6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-19362","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-19362","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":991,"opdsId":"urn:uuid:SW-462","title":"Colours (Tell me now series)","authors":["Madhav Chavan"],"language":"","readingLevel":"","publisher":"","summary":"Often an inquisitive child asks his parents about the colours or shapes that he sees around himself. The 'Tell me ... now!' Series describes how interesting the questions and answers turn out.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/700102/size7/610c0cae5d16405f1f342e373837d71f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/700102/size7/610c0cae5d16405f1f342e373837d71f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-462","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-462","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":992,"opdsId":"urn:uuid:SW-42777","title":"Toothless Charu","authors":["Erica Cuellar"],"language":"","readingLevel":"",