lication/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1013,"opdsId":"urn:uuid:SW-106445","title":"ಕಾಗೆ ಮೊಸಳೆಗಳ ನಡುವೆ ಜಾಣ ಅನಾನ್ಸಿ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಆಸೆಬುರುಕ ಅನಾನ್ಸಿಯು ತನ್ನ ಗೆಳೆಯರಾದ ಕಾಗೆಗಳಿಂದ ತನಗೆ ಸಿಗಬೇಕಾದ ಹಣ್ಣುಗಳಿಗಿಂತ ಹೆಚ್ಚಿನ ಪಾಲನ್ನು ಪಡೆಯಲು  ಯತ್ನಿಸುತ್ತದೆ. ಅದರ ಕುತಂತ್ರವನ್ನು ಅರಿತ ಕಾಗೆಗಳು ಅದನ್ನು ಒಂದು ದ್ವೀಪದ ಮಧ್ಯೆ ಬಿಟ್ಟು ಬಂದು ಬಿಡುತ್ತವೆ. ಅಲ್ಲಿಂದ ಪಾರಾಗುವ ಯತ್ನದಲ್ಲಿ ಅದು ಹಸಿದ ಮೊಸಳೆಗಳ ನಡುವೆ ಸಿಕ್ಕಿಬೀಳುತ್ತದೆ. ಅನಾನ್ಸಿಯ ಅಂತ್ಯ ಹತ್ತಿರವಾದಂತೆ ತೋರುತ್ತದೆ. ಅನಾನ್ಸಿಯು ಅಪಾಯದಿಂದ ಪಾರಾಗಲು ಮಾಡಿದ ಉಪಾಯವೇನು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/137946/size7/f0a2a20636347fe112cc2ed93a034639.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/137946/size7/f0a2a20636347fe112cc2ed93a034639.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-106445","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-106445","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1014,"opdsId":"urn:uuid:SW-593071","title":"ಮದುವೆಗೆ ಹೋಗುವುದು","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಮಗುವೊಂದು ಚಿಕ್ಕಪ್ಪನ ಮದುವೆಗೆ ರೈಲಿನಲ್ಲಿ ಹಳ್ಳಿಗೆ ಹೋಗುತ್ತಿದೆ. ರೈಲ್ವೆ ಸ್ಟೇಷನ್ನಿನಲ್ಲಿ ಏನೇನಾಯಿತು ಎಂದು ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/705057/size7/d860f55c2e5731d44bba086d93b79f63.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/705057/size7/d860f55c2e5731d44bba086d93b79f63.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-593071","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-593071","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1015,"opdsId":"urn:uuid:SW-596179","title":"ಸ್ಮಾರಕಗಳ ಗಣಿತ","authors":["Sriram MS"],"language":"","readingLevel":"","publisher":"","summary":"ಪಿರಮಿಡ್‌ಗಳು, ಹಳೆಯ ದೇವಾಲಯಗಳು ಮತ್ತು ಜಂತರ್ ಮಂತರ್‌ಗಳ \nನಡುವೆ ಇರುವ ಸಾಮಾನ್ಯ ಅಂಶಗಳೇನು? \nಗಣಿತ! ಜಗತ್ತಿನಾದ್ಯಂತ ಸೃಜನಶೀಲ ವಾಸ್ತುಶಿಲ್ಪಿಗಳು ಗಣಿತವನ್ನು ಉಪಯೋಗಿಸಿ ಅದ್ಭುತ ಕಟ್ಟಡಗಳನ್ನು ಕಟ್ಟಿದ್ದಾರೆ. ನಾವು ಅವುಗಳನ್ನು \nಇಂದಿಗೂ ಬೆರಗಿನಿಂದ ನೋಡುತ್ತೇವೆ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/715991/size7/fed27aa128d74c4879f6305804722539.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/715991/size7/fed27aa128d74c4879f6305804722539.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-596179","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-596179","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1016,"opdsId":"urn:uuid:SW-630403","title":"ನಾನು, ನನ್ನಕ್ಕ","authors":["Bhavya"],"language":"","readingLevel":"","publisher":"","summary":"ಅನು ತನ್ನ ತಂಗಿ ಜೊತೆ ಒಮ್ಮೊಮ್ಮೆ ಜಗಳವಾಡುತ್ತಾಳೆ. ಆದರೆ, ಅವಳೇ ತಂಗಿಗೆ ಹೊಸ ವಿಷಯಗಳನ್ನು ಕಲಿಸಲು ಸಹಾಯ ಮಾಡುತ್ತಾಳೆ. ಒಬ್ಬರನ್ನೊಬ್ಬರು ಇಷ್ಟಪಡುವ ಅಕ್ಕ-ತಂಗಿಯರ ಕತೆ ಇದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722794/size7/f143a6160fb50b198048ab8960fafc03.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722794/size7/f143a6160fb50b198048ab8960fafc03.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-630403","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-630403","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1017,"opdsId":"urn:uuid:SW-110064","title":"ಭೆರೆಯ ಕಾಡಿದ ಹಾವು","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಭೆರೆಯ ಸಮಸ್ಯೆಗೆ ನರಿಯಣ್ಣನ ಪರಿಹಾರ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/130944/size7/60e6914b7d472e925f19dd4042a39ce3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/130944/size7/60e6914b7d472e925f19dd4042a39ce3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-110064","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-110064","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1018,"opdsId":"urn:uuid:SW-593614","title":"ಹುಡುಕಿ!","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ನಿಮ್ಮ ಕಣ್ಣುಗಳನ್ನು ಚುರುಕುಗೊಳಿಸಿ ಮತ್ತು ಹುಡುಕಲು ಸಿದ್ಧರಾಗಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/118159/size7/20cbb32737835c1e57be3fc1c92c40ee.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/118159/size7/20cbb32737835c1e57be3fc1c92c40ee.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-593614","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-593614","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1019,"opdsId":"urn:uuid:SW-210603","title":"ಬೀಗದಕೈಗೊಂದು ಬೀಗ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಸಂದೀಪನಿಗೆ ಒಂದು ಬೀಗದಕೈ ಸಿಕ್ಕಿತು.  ಅದಕ್ಕೆ ಹೊಂದುವ ಬೀಗ ಸಿಕ್ಕಿತೆ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/285312/size7/c42453cb742c40a243d46a70cc96d28e.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/285312/size7/c42453cb742c40a243d46a70cc96d28e.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-210603","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-210603","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1020,"opdsId":"urn:uuid:SW-437316","title":"ಆಕಾರಗಳು","authors":["Bhargavi Pushpak"],"language":"","readingLevel":"","publisher":"","summary":"ಗೆರೆ, ಚುಕ್ಕಿ, ಸುರುಳಿಗಳು... ಹೀಗೆ ಪ್ರಕೃತಿಯಲ್ಲಿ ಇರುವುದೆಲ್ಲ ಆಕಾರಗಳೇ. ಗಮನವಿಟ್ಟು ನೋಡಿದರೆ ನಿಮಗೆ ಎಲ್ಲೆಡೆ ಕಾಣುವುದು ಆಕಾರಗಳೇ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/652282/size7/1e3a23dcdc396af31898db61f77cfe98.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/652282/size7/1e3a23dcdc396af31898db61f77cfe98.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-437316","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-437316","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1021,"opdsId":"urn:uuid:SW-456757","title":"ಗೋಗೋ ಎಲ್ಲಿ ಹೋಯಿತು?","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಮೃಗಾಲಯದ ಗೊರಿಲ್ಲ ಗೋಗೋ ಪಂಜರದಲ್ಲಿ ಇಲ್ಲಿ. ಅಲ್ಲಿ ಕೆಲಸ ಮಾಡು ಟೊಟೊ ಅದನ್ನು ಹುಡುಕುತ್ತಿದ್ದಾರೆ. ಗೋಗೋ ಅನ್ನು ಹುಡುಕಲು ಟೊಟೊ ಅವರಿಗೆ ಸಹಾಯ ಮಾಡುತ್ತೀರಾ??","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722400/size7/03af4ace340bf149dc2cee14949f59ba.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722400/size7/03af4ace340bf149dc2cee14949f59ba.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-456757","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-456757","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1022,"opdsId":"urn:uuid:SW-473082","title":"ಇ ಸಿ ಜಾರ್ಜ್ ಸುದರ್ಶನ್: ಭೌತಶಾಸ್ತ್ರದ ಬೆಳಕು","authors":["Rakshitha  A.B"],"language":"","readingLevel":"","publisher":"","summary":"20ನೇ ಶತಮಾನದಲ್ಲಿ ಭೌತವಿಜ್ಞಾನಿ ಇ ಸಿ ಜಾರ್ಜ್‌ ಸುದರ್ಶನ್‌ ಅದ್ಭುತ ವೈಜ್ಞಾನಿಕ ಸಂಶೋಧನೆಯೊಂದನ್ನು ಮಾಡಿದರು. ವಿಶ್ವದಲ್ಲಿರುವ ಪರಮಾಣುಗಳು, ಚಿಕ್ಕ ಚಿಕ್ಕ ಕಣಗಳ ಕುರಿತಾದ ಹಲವು ಕುತೂಹಲಕಾರಿ ಪ್ರಶ್ನೆಗಳಿಗೆ ಉತ್ತರ ಕಂಡುಕೊಳ್ಳುವಲ್ಲಿ ಇವು ಸಹಾಯ ಮಾಡಿದವು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/355137/size7/1a08dda7de3758c23d7bf39f174fa900.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/355137/size7/1a08dda7de3758c23d7bf39f174fa900.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-473082","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-473082","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1023,"opdsId":"urn:uuid:SW-110149","title":"ನರ್ತಕಿಯ ಹಾಡು","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಆ ಹುಡುಗಿಗೆ  ನೃತ್ಯವೆಂದರೆ ಇಷ್ಟ. ಆದರೆ ಎಲ್ಲರ ಬೆಂಬಲ ಅದಕ್ಕಿಲ್ಲ.  ಈ ಬಗ್ಗೆ ಹುಡುಗಿಯ ವಿಚಾರವೇನು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/130935/size7/9bf7f782c6acf5225539a3d04234ff38.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/130935/size7/9bf7f782c6acf5225539a3d04234ff38.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-110149","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-110149","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1024,"opdsId":"urn:uuid:SW-456063","title":"ಡಾರ್ಡಲ್‌ಗಳ ಇಂಧನ ಹುಡುಕಾಟ","authors":["Janardhana C S"],"language":"","readingLevel":"","publisher":"","summary":"ಮೂರು ಪುಟಾಣಿ ಡಾರ್ಡಲ್​ಗಳು ತಮ್ಮ ಮನೆಗೆ ವಾಪಸ್ಸಾಗಲು ಬೇಕಿರುವ ಇಂಧನವನ್ನು ಹುಡುಕುತ್ತಿವೆ. ಆದರೆ, ಸಂಪನ್ಮೂಲಗಳ ತೀವ್ರ ಕೊರತೆಯಿರುವ ಜಗತ್ತಿನಲ್ಲಿ ಸಿಕ್ಕಿಬಿದ್ದಿರುವ ಅವರಿಗೆ ಇಂಧನ ಸುಲಭವಾಗಿ ದೊರಕುತ್ತಿಲ್ಲ. ಇದು ‘ಡಾರ್ಡಲ್​ಗಳ ಸಾಹಸ’ದ ಮೂರು ಪುಸ್ತಕಗಳ ಸರಣಿಯಲ್ಲಿ ಮೊದಲನೆಯದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/450225/size7/c43e0a29907901033bd3d6e7b1542ee7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/450225/size7/c43e0a29907901033bd3d6e7b1542ee7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-456063","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-456063","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1025,"opdsId":"urn:uuid:SW-209496","title":"ಜೋಕಾಲಿ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಅನುಜ್‌ ಜೋಕಾಲಿ ಆಡಲು ಬಯಸಿದಾಗ ಮಾಮುನಿ ಒಂದು ಅಪರೂಪದ ಜೋಕಾಲಿ ತಯಾರಿಸಿದಳು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283713/size7/5b9d79bc11ac0cd4afff208de81694f3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283713/size7/5b9d79bc11ac0cd4afff208de81694f3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-209496","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-209496","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1026,"opdsId":"urn:uuid:SW-560203","title":"ಅದ್ಭುತ ಬಣ್ಣಗಳು","authors":["Bhat Ananthesha"],"language":"","readingLevel":"Level 2","publisher":"","summary":"ಹಿಂದೆ, ಎಲ್ಲಾ ಪಕ್ಷಿಗಳು ಬಿಳಿಯಾಗಿರುತ್ತವೆ. ಬಣ್ಣ ಬದಲಾಯಿಸಲು ಮಾಯ ಅಜ್ಜನಿಗೆ ಮಾತ್ರ ಸಾಧ್ಯ. ಆದರೆ ದಿನವೂ ಬಣ್ಣ ಬದಲಿಸಿ ಅಜ್ಜನಿಗೆ ತೊಂದರೆಯಾಗುತ್ತಿದೆ. ಆದ್ದರಿಂದ ಅಜ್ಜ ಉಪಾಯವನ್ನು ಯೋಚಿಸಿದರು. ಅಜ್ಜನ ತಂತ್ರ ಚೆನ್ನಾಗಿದೆಯೇ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/128599/size7/3f4ccfdae226169d9e418f37af5a5881.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/128599/size7/3f4ccfdae226169d9e418f37af5a5881.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-560203","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-560203","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1027,"opdsId":"urn:uuid:SW-456417","title":"ತೋಟದಲ್ಲಿ...","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ರೈತ ತನ್ನ ತೋಟದಲ್ಲಿ ಉಳುಮೆ ಮಾಡುತ್ತಿದ್ದಾಗ, ಮಳೆ ಶುರುವಾಯಿತು. ಮಳೆಯ ಜೊತೆಗೆ ಕೆಲವು ವಿಚಿತ್ರಗಳೂ ಸಂಭವಿಸಿದವು... ಆಕಾಶದಿಂದ ಮೀನು ಬಿದ್ದಂತೆ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/699236/size7/f3aef9b7bd272d344757851790fbfaf7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/699236/size7/f3aef9b7bd272d344757851790fbfaf7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-456417","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-456417","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1028,"opdsId":"urn:uuid:SW-640646","title":"ಈ ಭೂಮಿ ನನ್ನ ಶಾಲೆ: ದಾದಾಜಿ ಖೋಬ್ರಗಡೆ, ಭಾರತದ ಭತ್ತದ ತಳಿಗಳ ಜನಕ","authors":["Dr K Puttaswamy"],"language":"","readingLevel":"","publisher":"","summary":"ದಾದಾಜಿ ಖೋಬ್ರಗಡೆ ಬಾಲಕನಾಗಿರುವಾಗ; ಬಾಬಾಸಾಹೇಬ್ ಅಂಬೇಡ್ಕರರು, ಕ್ರಿಯಾಶೀಲರಾಗಿರುವಂತೆ ನೀಡಿದ ಕರೆಯನ್ನು ಕೇಳಿದ್ದರು. ಅವರ ಜಮೀನು ಅವರಿಗೆ ತಾಳ್ಮೆ, ಸಹಾನುಭೂತಿ, ಪ್ರೀತಿಯನ್ನು ಬೋಧಿಸುವ ಶಾಲೆಯಾಯಿತು. ಎಲ್ಲಕ್ಕೂ ಮಿಗಿಲಾಗಿ ಹೊಸದನ್ನು ಸಂಶೋಧಿಸಲು, ದೊಡ್ಡ ಕನಸು ಕಾಣಲು ಸ್ಫೂರ್ತಿ ನೀಡಿತು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722797/size7/ae11ecb26549da3c10901a89947d46b5.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722797/size7/ae11ecb26549da3c10901a89947d46b5.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-640646","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-640646","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1029,"opdsId":"urn:uuid:SW-615842","title":"ಶಾಂತಿಯ ಮರಗೆಳತಿ","authors":["G W Carlo"],"language":"","readingLevel":"","publisher":"","summary":"ಮರಗಳು ಮಾತನಾಡುತ್ತವೆಯೇ? ಏನೋ, ಶಾಂತಿಯಂತೂ ನಂಬುತ್ತಾಳೆ. ಒಂದು ವಿಶಿಷ್ಟ ಗೆಳೆತನದ ಕುರಿತ ಈ ಕತೆಯನ್ನು ಓದಿ.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/42552/size7/4ec52bd05764d9148615d4c4f550d681.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/42552/size7/4ec52bd05764d9148615d4c4f550d681.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-615842","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-615842","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1030,"opdsId":"urn:uuid:SW-474621","title":"ಕಚಕ್, ಕಚಕ್","authors":["Shashirekha"],"language":"","readingLevel":"","publisher":"","summary":"ಅವಿಗೆ ಅಡುಗೆ ಮಾಡುವ ದಿನವೆಂದರೆ, ಮನೆಯವರ ಕೆಲಸಗಳಲ್ಲಿ ತಾನೂ ಜೊತೆಗೂಡುವುದು ಎಂದರೆ ಬಲು ಇಷ್ಟ. ಹಾಗಿದ್ದರೆ ಅವಿ ಅಡುಗೆ ಮನೆಯಲ್ಲಿ ಏನೇನು ಮಾಡಿದ, ಆಕೃತಿಗಳನ್ನು ಕುತೂಹಲದಿಂದ ಗಮನಿಸುವ ಅವನ ಜೊತೆ ನಾವೂ ಹೋಗೋಣವಾ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/461865/size7/c5024bc800308b02341e8e8878c2507c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/461865/size7/c5024bc800308b02341e8e8878c2507c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-474621","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-474621","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1031,"opdsId":"urn:uuid:SW-582021","title":"ಜಿರಜಿಂಬೆ ಜಿರಜಿಂಬೆ","authors":["Anasuya Patil"],"language":"","readingLevel":"","publisher":"","summary":"ರಾತ್ರಿ ಹೊತ್ತು ನಾಯಿಮರಿಯೊಂದು ಆರಾಮಾಗಿ ಮಲಗಿತ್ತು. ಏನೋ ಸದ್ದಾಗಿ ಅದಕ್ಕೆ ಎಚ್ಚರಾಯಿತು. ಸದ್ದು ಎಲ್ಲಿಂದ ಬರುತ್ತಿದೆ ಸದ್ದು ಎಂದು ಹುಡುಕಲು ಹೊರಟಿತು. ಸದ್ದು ಎಲ್ಲಿಂದ ಬರುತ್ತಿರಬಹುದು?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/103106/size7/aac47970ce74bb38d1bd3e8b3eec0d36.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/103106/size7/aac47970ce74bb38d1bd3e8b3eec0d36.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-582021","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-582021","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1032,"opdsId":"urn:uuid:SW-142171","title":"ಹಠಮಾರಿ ಮೇಕೆರಾಜ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಹಗ್ಗಕಟ್ಟಿ 