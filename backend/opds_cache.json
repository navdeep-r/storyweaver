ub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":526,"opdsId":"urn:uuid:SW-25913","title":"Le cerf-volant","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Découvre ce qui arrive au cerf-volant dans ce livre qui rend un bel hommage au style artistique des Warlis (ethnie aborigène du Gujarat).","coverUrl":"https://static.storyweaver.org.in/illustration_crops/117638/size7/ac6a77ff9d0dd2a0a61098ad0557ff0c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/117638/size7/ac6a77ff9d0dd2a0a61098ad0557ff0c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-25913","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-25913","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":527,"opdsId":"urn:uuid:SW-100707","title":"Sona  aide sa maman","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Sona est une petite fille très intelligente. Tu as peut-être déjà lu la petite histoire dans laquelle elle aide son papa. Cette fois, elle aide sa maman et trouve son travail très intéressant.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722863/size7/65346cf4b564c5e789c24507605a234d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722863/size7/65346cf4b564c5e789c24507605a234d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-100707","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-100707","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":528,"opdsId":"urn:uuid:SW-10166","title":"Découvrons le World Wide Web","authors":["goofy"],"language":"","readingLevel":"","publisher":"","summary":"Vous allez « sur Internet » et vous savez plus ou moins vous en servir, n'est-ce pas ?  Mais www, vous avez c