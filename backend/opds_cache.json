ryweaver.org.in/illustration_crops/722412/size7/c9131925228d1e8ba22cbb83656b4e17.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-385","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-385","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":707,"opdsId":"urn:uuid:SW-94573","title":"पैसे का समझदारी से इस्तेमाल","authors":["Madhu B. Joshi"],"language":"","readingLevel":"","publisher":"","summary":"रुपया पैसा शृंखला ऐसे कई उपयोगी तथ्य उजागर करती है जो हमारी इस बदलती हुई दुनिया में बच्चों को पैसे के सही उपयोग करने में सहायता करेंगे। केवल पैसे कमाना और बचाना ही काफ़ी नहीं है। हर किसी को पैसे को होशियारी से इस्तेमाल करना चाहिए ताकि हमारी अभी और बाद की ज़रूरतों और इच्छाओं को पूरा करने के लिए हमारे पास पर्याप्त पैसा हो। प्रसिद्ध पक्षी विशेषज्ञ सलीम अली ने अपने जेब ख़र्च से क्या किया था? क्या हर चीज़ की क़ीमत होती है? धूप की क्या कीमत होती है? बीमा क्या है? इन सबके बारे में पैसे का समझदारी से इस्तेमाल, पुस्तक ४   पढ़ कर जानिए। रुपया पैसा शृंखला में और भी बहुत कुछ जानने को मिलेगा।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/518439/size7/362709cff44795ecc847a3367f1ecf53.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/518439/size7/362709cff44795ecc847a3367f1ecf53.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-94573","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-94573","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":708,"opdsId":"urn:uuid:SW-166120","title":"कछुआ और खरगोश","authors":["K. Vijaya"],"language":"","readingLevel":"","publisher":"","summary":"बहुत दिनों पहले कछुए ने अपनी लगन के बल पर घमण्डी खरगोश को दौड़ में हराया था। अब दोनों फिर साथ आये हैं और उन्हें मिल कर राजा का ज़रूरी काम करना है। सहयोग के बिना यह असम्भव है पर क्या दोनों विरोधी मिल कर काम कर पायेंगे