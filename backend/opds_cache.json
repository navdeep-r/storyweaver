on"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-238391","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":746,"opdsId":"urn:uuid:SW-344821","title":"Mina Makes a Dash","authors":["Anjali  Alappat"],"language":"","readingLevel":"","publisher":"","summary":"Mina has to take part in the 400-metre dash for Sports Day. She knows she has to practise. First she runs 100 metres, then 200 metres, but can she make it to 400 metres? Learn to measure distance as Mina trains.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/436810/size7/c1a3205a510f214897d38cc6ee0972a9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/436810/size7/c1a3205a510f214897d38cc6ee0972a9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-344821","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-344821","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":747,"opdsId":"urn:uuid:SW-233090","title":"So Much to See","authors":["Chamindhi Abeywarna"],"language":"","readingLevel":"","publisher":"","summary":"There is so much to see in a house — all the little things, the animals and people who make a house a home. Crawl along and watch the world with little Uma.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/315559/size7/ca9efae074f72f3550506be13013256d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/315559/size7/ca9efae074f72f3550506be13013256d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-233090","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-233090","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":748,"opdsId":"urn:uuid:SW-258781","title":"Around You: States of Matter","authors":["Sukanya  Sinha"],"language":"