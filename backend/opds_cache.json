://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-94768","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":325,"opdsId":"urn:uuid:SW-136065","title":"Mama, il y a une chauve-souris dans mon plat!","authors":["Jordan Hairabedian"],"language":"","readingLevel":"","publisher":"","summary":"Suppi n'est pas du tout content de voir une chauve-souris voler dans sa maison. En fait, il a assez peur de la chauve-souris. Comment Suppi et Maman peuvent-elles ramener la chauve-souris à sa famille?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/57856/size7/f1e874aeb6aad2c5558fea57c8273c6c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/57856/size7/f1e874aeb6aad2c5558fea57c8273c6c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-136065","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-136065","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":326,"opdsId":"urn:uuid:SW-102975","title":"Boum badaboum!","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Muni le maçon doit démolir un cabanon et bâtir une nouvelle clinique à la place. Il gravit la colline pour demander de l'aide à plusieurs personnes. Mais parfois, l'aide se présente sous une forme inattendue!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495625/size7/cb7272fca8729d1afce929ec613d09f9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495625/size7/cb7272fca8729d1afce929ec613d09f9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-102975","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-102975","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":327,"opdsId":"urn:uuid:SW-24947","title":"Scratch! Scratch! Scratch!","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Manu adore sauter et compter. Malheureusement, elle a attrapé la varicelle et ça la démange beaucoup.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/726298/size7/a8d3613af0c68801c935157ee52533a0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/726298/size7/a8d3613af0c68801c935157ee52533a0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-24947","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-24947","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":328,"opdsId":"urn:uuid:SW-128686","title":"L'homme qui se croyait plus intelligent que sa femme: Conte traditionnel norvégien","authors":["Anne-Claire Olivo"],"language":"","readingLevel":"","publisher":"","summary":"Il y a fort fort longtemps, vivait en Norvège un fermier morose et grognon qu'on appelait Gus le Grincheux. Gus le Grincheux n'était pas juste grognon, il était aussi arrogant et se croyait plus intelligent que tout le monde, et plus particulièrement que sa femme. Lis ce conte traditionnel norvégien, à la fois drôle et captivant, et découvre combien il est intelligent!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721041/size7/16f2c75b5386f70c5ab1721b9cfa385d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721041/size7/16f2c75b5386f70c5ab1721b9cfa385d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-128686","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-128686","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":329,"opdsId":"urn:uuid:SW-44051","title":"Mon corps","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Nos corps sont toujours en action, n'est-ce pas ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/40760/size7/8febbba21c80e17d9fb99e3f9e3d68b3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/40760/size7/8febbba21c80e17d9fb99e3f9e3d68b3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-44051","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-44051","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":330,"opdsId":"urn:uuid:SW-149055","title":"Comment Pintu trouve Pi","authors":["Dr. Priti Bhatia and Tarka Indulkar"],"language":"","readingLevel":"","publisher":"","summary":"Pintu est seul dans sa nouvelle école. Chaque fois qu'il essaie de parler à ses camarades de classe, ils forment un cercle fermé. Puis Pintu trouve le pi.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/718341/size7/5ba950a3c80d17bc15f123072ca97a74.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/718341/size7/5ba950a3c80d17bc15f123072ca97a74.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-149055","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-149055","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":331,"opdsId":"urn:uuid:SW-24809","title":"Qui fait ce bruit ?","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Scratch... Scratch... Qui peut bien faire ce bruit ? Priya va le découvrir dans cette petite histoire.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/34997/size7/65a5a02ef778f95e582ebb23ecddc4e6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/34997/size7/65a5a02ef778f95e582ebb23ecddc4e6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-24809","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-24809","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":332,"opdsId":"urn:uuid:SW-43805","title":"Dis, c'est quoi Internet ?","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Sais-tu comment envoyer un e-mail ? BIEN SÛR ! Donc tu sais ce qu'est Internet ? Hum... bôf. Tu sais ce que signifie www ? Euh... Tu te sens un peu bête, tout d'un coup ? Ne t'en fais pas, Nettikutti est là pour éclairer ta lanterne ! Viens l'écouter dévoiler les mystères et la magie de ce gigantesque cerveau numérique que l'on appelle le World Wide Web.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/712338/size7/78e325d28576a52fd9d7edc40163b740.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/712338/size7/78e325d28576a52fd9d7edc40163b740.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-43805","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-43805","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":333,"opdsId":"urn:uuid:SW-223031","title":"Chunu et Munu : il gèle !","authors":["Cyrille Largillier"],"language":"","readingLevel":"","publisher":"","summary":"Chunu et Munu se réveillent par un matin de grand froid. Elles ne trouvent pas leurs vêtements chauds ! Où peuvent bien être ces vêtements ?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/101410/size7/9d1ab657164a00bed5d792be5509c5c0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/101410/size7/9d1ab657164a00bed5d792be5509c5c0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-223031","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.or