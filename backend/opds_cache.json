ry/pdf/SW-42684","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-42684","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":742,"opdsId":"urn:uuid:SW-103405","title":"Mention très bien pour Kadogoo","authors":["Sak Untala"],"language":"","readingLevel":"","publisher":"","summary":"Kadogoo est loin d'être le meilleur élève de sa classe, mais il sait qu'il peut améliorer ses résultats. Découvre dans cette petite histoire comment il va s'y prendre.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/119976/size7/7d392e7454139296f93ede807e37cf0f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/119976/size7/7d392e7454139296f93ede807e37cf0f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-103405","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-103405","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":743,"opdsId":"urn:uuid:SW-223020","title":"L'oreiller à rêves","authors":["Cyrille Largillier"],"language":"","readingLevel":"","publisher":"","summary":"Un pirate, un arbre et un ours rendent le sommeil d'un petit garçon difficile. Le jour, ce sont ses amis, mais quand la nuit tombe, tout change. Il ne peut plus dormir. L'oreiller à rêves est une histoire qui apprend à transformer les cauchemars en rêves.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/83456/size7/f000f0562cc19885da3eb44ae4788274.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/83456/size7/f000f0562cc19885da3eb44ae4788274.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-223020","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-223020","type":"application/epub+zip","rel":"http://opds