:"https://storyweaver.org.in/api/v0/story/epub/SW-223480","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1077,"opdsId":"urn:uuid:SW-457142","title":"ಥಾಂಗ್ವಾಂಗ್ ಮತ್ತು ಭಲ್ಲುಕ","authors":["Hema Khurshapur"],"language":"","readingLevel":"","publisher":"","summary":"ಮರಿ ಥಾಂಗ್ವಾಂಗ್ ಮತ್ತು ಭಲ್ಲುಕ ಕರಡಿ ಎರಡಕ್ಕೂ ಮಾತಾಡೋದು ಅಂದರೆ ತುಂಬಾ ಇಷ್ಟ. ಅವು ಗಾಆಆ! ಗಿಇಇ! ಗ್ಳು ಗ್ಳು... ಗರ್ ರ್ ರ್ ರ್. ಗುರ್ ರ್ ರ್ ರ್... ಖುರ್ ರ್ ರ್ ರ್ ಎನ್ನುತ್ತಿರುತ್ತವೆ. ನಿಮಗೆ ಈ ಮಾತುಗಳು ಅರ್ಥ ಆಗಬಹುದೇ ಎಂದು ನೋಡಲು ಈ ಕತೆ ಓದಿ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/699302/size7/202d57edfaca33a6bf2d6e488ef4bb3f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/699302/size7/202d57edfaca33a6bf2d6e488ef4bb3f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-457142","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-457142","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1078,"opdsId":"urn:uuid:SW-209249","title":"ಕಮಲಿಯ ಕೊಡೆ","authors":["M.R.Ganesha Kumar"],"language":"","readingLevel":"","publisher":"","summary":"ಕಮಲಿಯು ಅಪರೂಪದ ಕೊಡೆ ತಯಾರಿಸಿದ ಕತೆಯಿದು.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283925/size7/53a84ff9f70e35c16289cd1aceeb2227.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283925/size7/53a84ff9f70e35c16289cd1aceeb2227.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-209249","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-209249","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":1079,"opdsId":"urn:uuid:SW-593603","title":"ಯಾರದಿದು ಬಟನ್?","authors":["Pushpak M"],"language":"","readingLevel":"","publisher":"","summary":"ಟಿನ್ ಟಿನ್ ದಾರಿಯಲ್ಲಿ ಸಿಕ್ಕ ಬಟನ್ ಜಾಡು ಹಿಡಿದು ಹೊರಟಿದೆ. ಗಜಿಬಿಜಿ ಜನರ ಮಧ್ಯೆ ಅಪ್ಪಚ್ಚಿಯಾಗದೇ ಉಳಿದಿದ್ದು, ಹೊಸ ಸ್ನೇಹ