:"https://static.storyweaver.org.in/illustration_crops/582053/size7/e8ae871d00b28e2942870e1e35ee69b4.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-509792","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-509792","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":717,"opdsId":"urn:uuid:SW-110824","title":"बोबो आणि बागेतल्या अळ्या","authors":["Jui Kulkarni"],"language":"","readingLevel":"","publisher":"","summary":"झाडांवर पडलेल्या अळ्या वेगानं पानं खाऊन टाकत आहेत. त्यामुळं बोबो आता झाडावर पडलेल्या त्या किडीचा नायनाट करण्याच्या कामगिरीवर आहे. ती ही कामगिरी पार पाडू शकेल का?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/495594/size7/9fec4d87f484e7a1832f21cae4834f7b.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/495594/size7/9fec4d87f484e7a1832f21cae4834f7b.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-110824","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-110824","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":718,"opdsId":"urn:uuid:SW-570599","title":"ऋतू","authors":["Ashlesha Gore"],"language":"","readingLevel":"","publisher":"","summary":"भारताच्या विविध भागांमध्ये उन्हाळा, पावसाळा, हिवाळा आणि वसंत हे ऋतू कसे असतात ते या पोस्टरमध्ये दर्शवलेलं आहे.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/630301/size7/86792ce0ef33872bb09c4fa6bf05e178.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/630301/size7/86792ce0ef33872bb09c4fa6bf05e178.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-570599","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-570599","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":719,"opdsId":"urn:uuid:SW-725","title":"नावेतील सहल","authors":["Meera Tendolkar"],"language":"","readingLevel":"","publisher":"","summary":"विकी खार बढाईखोर आहे. एक दिवस त्याला त्याचा चुलतभाऊ भेटायला आला. जेव्हा ते दोघे नावेत बसून फिरायला गेले तेव्हा काहीतरी गमतीशीर घडले. या दोन खारींच्या मजेदार अनुभवाचा हा किस्सा आहे.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/702015/size7/1445bec6f17f2ec069dd00d0fe5878d0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/702015/size7/1445bec6f17f2ec069dd00d0fe5878d0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-725","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-725","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":720,"opdsId":"urn:uuid:SW-84811","title":"कसं बनतं शरीर?","authors":["Mrinalinee  Vanarase"],"language":"","readingLevel":"","publisher":"","summary":"आपली बहीण आईच्या पोटात असतानाच तिला आपले केस, फुफ्फुसं आणि हातपाय कसे तयार करायचे, हे ठाऊक असल्याचं ऐकून वावा पार चक्रावूनच गेला. आपल्या शरीरातल्या अब्जावधी पेशी आपल्या वाढीला आणि शरीर कमावायला कशी मदत करत असतात, हे आपणही वावासोबत शोधू या.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/146763/size7/cd20c6624ef8ec0ffae3fcba78318c40.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/146763/size7/cd20c6624ef8ec0ffae3fcba78318c40.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-84811","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-84811","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":721,"opdsId":"urn:uuid:SW-15508","title":"स्वप्ने भरत जाणारी मुमताज","authors":["Sandhya Taksale"],"language":"","readingLevel":"","publisher":"","summary":"गावामधल्या अनेक बायकांसह मुमताज आपल्या खेडयात चिकनकारी, भरतकाम करत असते. काही नवे टाके शिकायला ती लखनौमध्ये येते आणि कल्पना केली होती, त्यापेक्षा कितीतरी अधिक शिकते. तिचा छोटा मित्र मुन्नूही तिला मदत करतो. जॉली रोहतगी यांच्या या भावपूर्ण कथेला राम सोनी यांनी, कागदाचं कातरकाम करून तयार होणार्‍या साँझी शैलीत चित्रं काढली आहेत.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/118163/size7/cb7cdd8d49e3e690fae53b5375f67eb7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/118163/size7/cb7cdd8d49e3e690fae53b5375f67eb7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-15508","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-15508","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":722,"opdsId":"urn:uuid:SW-111193","title":"मुंबईची कहाणी बंदर, बोंबील आणि जहाजबांधणी","authors":["Sai Keskar"],"language":"","readingLevel":"","publisher":"","summary":"बाहेर सारखा पाऊस पडतो आहे. घराबाहेर पडून करता येण्याजोगं काहीच नाही. मग अशावेळी आजीकडून एक छानशी गोष्ट ऐकू या! ही गोष्ट आहे कोळी समाजाची. म्हणजेच मुंबईच्या मूळ रहिवाशांची, त्यांच्या आवडत्या माशांची आणि तिथल्या ऐतिहासिक जहाजबांधणी उद्योगाची!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/723772/size7/b0476b13553c024e91d6672d33eb8bf7.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/723772/size7/b0476b13553c024e91d6672d33eb8bf7.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-111193","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-111193","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":723,"opdsId":"urn:uuid:SW-594262","title":"माझा नंबर पहिला!","authors":["Abhijit Pendharkar"],"language":"","readingLevel":"","publisher":"","summary":"A family of shapes is excited about the lantern competition. But they realize that if they want to win the competition, they will have to work together.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/103107/size7/43203fa34036421960d9da99e8f4ce7c.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/103107/size7/43203fa34036421960d9da99e8f4ce7c.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-594262","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-594262","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":724,"opdsId":"urn:uuid:SW-30042","title":"धडाडीचं पाऊल","authors":["Varsha Gajendragadkar"],"language":"","readingLevel":"","publisher":"","summary":"सकाळी फिरायला जाताना सुरवंटराव बुटांच्या २१ जोड्या घालतात. पण इतके पाय असल्यावर पहिल्यांदा त्यातला कुठला पाय वापरायचा, हे त्यांना कसं कळणार? चला, आकडेमोजणी आणि विचारांतला गोंधळ सांगणाऱ्या या गोष्टीतले सुरवंटराव आणि बागेतल्या त्यांच्या मित्रांसोबत आपणही जरा फेरफटका मारूया.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/646248/size7/785eeebf26aca45dc9fc4f56cedba1a6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/646248/size7/785eeebf26aca45dc9fc4f56cedba1a6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-30042","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-30042","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":725,"opdsId":"urn:uuid:SW-838","title":"तरंगत तरंगत","authors":["Vidya Tiware"],"language":"","readingLevel":"","publisher":"","summary":"सर्वच लहान मुलांना उंच आकाशाचे आकर्षण असते. आकाश पाहून त्यांच्या मनात अनेक विचार येतात. मन वसे ते स्वप्नी दिसे हे ’तरंगत तरंगत’ वाचताना प्रत्ययास येते.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722226/size7/ad14cad678c8a03f6879020afcbf60b5.jpg","thumbnailUrl":"https://static.storyweaver.