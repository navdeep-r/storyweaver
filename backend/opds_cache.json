_crops/118167/size7/4639d7adf6ecaf744a6d4318b423e6a0.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/118167/size7/4639d7adf6ecaf744a6d4318b423e6a0.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-14391","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-14391","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":175,"opdsId":"urn:uuid:SW-25665","title":"Shhh...Simmi is Listening","authors":["Aparna  Kapur"],"language":"","readingLevel":"","publisher":"","summary":"Simmi knows her sister Lolo very well. She can tell what Lolo is up to even with her eyes closed. Here is a simple book that introduces sound to young readers.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/153148/size7/2d6e22a4911b73bebac3b40698f21c20.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/153148/size7/2d6e22a4911b73bebac3b40698f21c20.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-25665","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-25665","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":176,"opdsId":"urn:uuid:SW-4772","title":"Dum Dum-a-Dum Biryani!","authors":["Gayathri Tirthapura"],"language":"","readingLevel":"","publisher":"","summary":"Basha and Sainabi are in a panic. Ammi is ill, and Saira aunty has just announced that she is arriving for lunch - with 23 other people! Budding chef Basha thinks he can cook Ammi's Dum Biryani, but her recipe only makes enough for 4 people. Math wiz Sainabi jumps in to help, declaring that she knows how to turn a 4-person recipe to a 24-person recipe. Do the siblings succeed in serving up a truly Dum Dum-a-Dum biryani? Read this book to find out!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/710992/size7/148136331161fe3faf86e1ff30c0f59d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/710992/size7/148136331161fe3faf86e1ff30c0f59d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-4772","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-4772","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":177,"opdsId":"urn:uuid:SW-12292","title":"Hide and Seek","authors":["Kanchan Bannerjee"],"language":"","readingLevel":"","publisher":"","summary":"When you play Hide and Seek with your friends, where do YOU hide? Want some ideas? Let's read this story.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/34964/size7/b444d20af25d0c9bafa9a14a0c23ba2a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/34964/size7/b444d20af25d0c9bafa9a14a0c23ba2a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-12292","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-12292","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":178,"opdsId":"urn:uuid:SW-705","title":"The Magic Powder - A Folktale from Myanmar","authors":["Greystroke"],"language":"","readingLevel":"","publisher":"","summary":"Once upon a time, in a little village on the banks of the Irrawaddy river, there lived a young woman called Thuza. She was very happily married to handsome young Theingi. But there was one problem that nagged Thuza – her husband believed he would find a way to turn dirt into hold! Did he succeed? Read this delightful tale from Myanmar to find out.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/697435/size7/1a89e33ee73ca7454a57ef29be7d2dab.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/697435/size7/1a89e33ee73ca7454a57ef29be7d2dab.jpg","acquisi