aver.org.in/api/v0/story/pdf/SW-597132","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-597132","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":252,"opdsId":"urn:uuid:SW-334952","title":"ਡਰਪੋਕ ਰੇਲਗੱਡੀ","authors":["Amandeep Kaur Moga"],"language":"","readingLevel":"","publisher":"","summary":"ਕੀ ਤੁਸੀਂ ਨਵੀਂ ਜਗ੍ਹਾ ਤੇ ਜਾਣ ਅਤੇ ਇਕੱਲੇ ਘੁੰਮਣ ਤੋਂ ਡਰਦੇ ਹੋ?ਨਹੀਂ ਨਾ,ਪਰ ਇਹ ਨਵਾਂ ਇੰਜਣ ਤਾਂ ਬਹੁਤ ਹੀ ਡਰਪੋਕ ਹੈ। ਹੁਣ  ਜੇਕਰ ਇੰਜਣ ਡਰਦਾ ਹੈ ਤਾਂ ਰੇਲ ਗੱਡੀ ਕਿਵੇਂ ਚੱਲੇਗੀ ?ਆਓ,ਦੇਖੀਏ ਕਿ ਇਹ ਇੰਜਣ ਦਾ ਡਰ ਕਿਵੇਂ ਦੂਰ ਹੋਇਆ ਅਤੇ ਰੇਲ ਗੱਡੀ ਕਿਵੇਂ ਚੱਲੀ!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721023/size7/80a76fd4a925e3e639bdd087df48bd0f.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721023/size7/80a76fd4a925e3e639bdd087df48bd0f.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-334952","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-334952","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":253,"opdsId":"urn:uuid:SW-598124","title":"ਗੋਰੀਲੇ ਦੀ ਪਾਰਟੀ","authors":["Beant  Singh"],"language":"","readingLevel":"","publisher":"","summary":"ਗੋਰੀਲਾ ਪਾਰਟੀ ਲਈ ਤਿਆਰ ਹੋ ਜਾਂਦਾ ਹੈ। ਪਾਰਟੀ ਲਈ ਕੀ ਚਾਹੀਦਾ ਹੈ? ਬਹੁਤ ਸਾਰੀਆਂ ਟੋਪੀਆਂ! ਗੋਰੀਲੇ ਦੇ ਨਾਲ ਸਾਰੇ ਘਰ ਵਿੱਚ ਪਾਰਟੀ ਵਾਲੀਆਂ ਟੋਪੀਆਂ ਰੱਖੋ। ਥਾਂ ਸੰਬੰਧੀ ਦਿਸ਼ਾਵਾਂ ਅਤੇ ਪਾਰਟੀ ਵਾਲੀਆਂ ਟੋਪੀਆਂ ਬਾਰੇ ਇੱਕ ਜੀਵੰਤ ਕਿਤਾਬ।","coverUrl":"https://static.storyweaver.org.in/illustration_crops/491328/size7/21e156f5c960f08498b5485296de5fe9.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/491328/size7/21e156f5c960f08498b5485296de5fe9.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-598124","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-598124","type":"application/epub+zip","rel":"http://opds-sp