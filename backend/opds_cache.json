n/api/v0/story/epub/SW-213116","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":822,"opdsId":"urn:uuid:SW-213126","title":"Hide and Seek","authors":["Nancy Siddhant Dogra"],"language":"","readingLevel":"","publisher":"","summary":"There is a girl hiding in a tree. She will come down only when a special person calls her. Who? Read more to find out.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283174/size7/01e070e72742d77a40bc7710b7efffcd.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283174/size7/01e070e72742d77a40bc7710b7efffcd.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-213126","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-213126","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":823,"opdsId":"urn:uuid:SW-213120","title":"Rat-Cat","authors":["Ashwini Joshi"],"language":"","readingLevel":"","publisher":"","summary":"A fat cat saw a small rat and ran after it. How will the rat save its life?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/283809/size7/12e5856b4b4ab06beb92362899c4693d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/283809/size7/12e5856b4b4ab06beb92362899c4693d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-213120","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-213120","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":824,"opdsId":"urn:uuid:SW-16972","title":"The Big, Big Matchbox","authors":["Arvind Gupta"],"language":"","readingLevel":"","publisher":"","summary":"Prem and his friends had a big task with a tiny matchbox. You could also try this big task at home. Hours of fun guaranteed!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/43610/size7/37b27665c10faf1bd7e8637da3d93033.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/43610/size7/37b27665c10faf1bd7e8637da3d93033.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-16972","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-16972","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":825,"opdsId":"urn:uuid:SW-43897","title":"Ready? Yes! Play!","authors":["Arundhati Nath"],"language":"","readingLevel":"","publisher":"","summary":"Anu loves cricket and her dream is to play the game. Find out how Anu bowls everyone over when she plays her first match.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/90216/size7/ca6f84ff90a7405fad9a030d14f0b808.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/90216/size7/ca6f84ff90a7405fad9a030d14f0b808.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-43897","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-43897","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":826,"opdsId":"urn:uuid:SW-187","title":"Sister, Sister, Why is the Sky So Blue?","authors":["Roopa Pai"],"language":"","readingLevel":"","publisher":"","summary":"Little Brother's inquisitive mind is always full of questions for Big Sister. He knows Big Sister has all the answers, because she is always reading one big fat book or another. In this book, Little Brother wonders why the sky is blue. When Big Sister asks him why he things it could be so, his imagination runs riot. Could it be a giant blue sari spread out to dry in the sky that makes it blue, or is it something else altogether? Of course, Big Sister has the right answer in the end, but before you start reading this fun book to find out, tell us: why do YOU think the sky is blue?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722412/size7/c9131925228d1e8ba22cbb83656b4e17.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722412/size7/c9131925228d1e8ba22cbb83656b4e17.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-187","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-187","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":827,"opdsId":"urn:uuid:SW-10718","title":"Spot!","authors":["Pratham Books Team"],"language":"","readingLevel":"","publisher":"","summary":"Sharpen your eyes and get ready for a spotting spree!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/118159/size7/20cbb32737835c1e57be3fc1c92c40ee.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/118159/size7/20cbb32737835c1e57be3fc1c92c40ee.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-10718","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-10718","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":828,"opdsId":"urn:uuid:SW-22384","title":"Different Abilities","authors":["Agnes  Mabururu"],"language":"","readingLevel":"","publisher":"","summary":"We all have different abilities, but find out what we have in common.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/106379/size7/3e09ace06914e0e70d3eaa420f3b51c8.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/106379/size7/3e09ace06914e0e70d3eaa420f3b51c8.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-22384","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-22384","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":829,"opdsId":"urn:uuid:SW-106407","title":"Megan and the Princess of Death","authors":["C G Salamander"],"language":"","readingLevel":"","publisher":"","summary":"After following Frits down a cable car line, Megan finds herself trapped in another strange world, The Hopah Place, with an annoying princess. Megan and Frits must journey through a series of scary-creepy caves to find their way back home, but first she must solve three riddles.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/727154/size7/b53ed09e0cc6e49999ce7b28ca94c2bb.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/727154/size7/b53ed09e0cc6e49999ce7b28ca94c2bb.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-106407","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-106407","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":830,"opdsId":"urn:uuid:SW-103020","title":"Whose Voice is This?","authors":["All Children Reading Cambodia"],"language":"","readingLevel":"","publisher":"","summary":"What's the voice, and who's it?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/150995/size7/62605d4d6831166e2605823b426debcc.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/150995/size7/62605d4d6831166e2605823b426debcc.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-103020","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-103020","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":831,"opdsId":"urn:uuid:SW-1106","title":"The Man Who Thought He Was Smarter Than His Wife: A Folktale From Norway","authors":["Veena Seshadri"],"language":"","readingLevel":"","publisher":"","summary":"Long long ago, there lived in Norway a grumpy, grouchy farmer called Gloomy Gus. Gloomy Gus was not just a grouch---he was arrogant too, and believed he was smarter than everybody else, especially his wife. Read this captivating and humourous folktale from Norway to find out just how smart he really was!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721041/size7/16f2c75b5386f70c5ab1721b9cfa385d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721041/size7/16f2c75b5386f70c5ab1721b9cfa385d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-1106","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-1106","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":832,"opdsId":"urn:uuid:SW-790","title":"Sniffles, the Crocodile and Punch, the Butterfly","authors":["Herminder Ohri"],"language":"","readingLevel":"","publisher":"","summary":"What are friends for, if not to help each other? Even friends like Sniffles, the Crocodile and Punch, the Butterfly. A lovely story about two clever friends.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722293/size7/3b8b2eef225554b2567b41f5bcf1e9d1.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722293/size7/3b8b2eef225554b2567b41f5bcf1e9d1.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-790","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-790","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":833,"opdsId":"urn:uuid:SW-109523","title":"A Very Busy Day","authors":["Chisanga Mukuka"],"language":"","readingLevel":"","publisher":"","summary":"Today is a very busy day. Come to town with Mama and me!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/183410/size7/b42217090b2df104a47c9d395e8bd87d.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/183410/size7/b42217090b2df104a47c9d395e8bd87d.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-109523","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-109523","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":834,"opdsId":"urn:uuid:SW-92172","title":"Happy Maths : Numbers","authors":["Mala Kumar"],"language":"","readingLevel":"","publisher":"","summary":"This is a mathematics book with a difference. There are more stories here than problems! So read the stories, absorb the mix of facts and fiction and enjoy teasing your brain.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/703146/size7/02654779ece6e09f2a880907b015c3ed.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/703146/size7/02654779ece6e09f2a880907b015c3ed.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-92172","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-92172","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":835,"opdsId":"urn:uuid:SW-40959","title":"Mission of the Fish","authors":["Celia  Bolam"],"language":"","readingLevel":"","publisher":"","summary":"A school of fish has a mission: to get rid of garbage in their home. Together they work to convince humans to keep the water clean. Do you think humans will listen to the fish?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/99483/size7/74f42656493f5db6ca1e6080364e6633.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/99483/size7/74f42656493f5db6ca1e6080364e6633.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-40959","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-40959","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":836,"opdsId":"urn:uuid:SW-47915","title":"Rustle Bustle","authors":["Swagata Sen Pillai"],"language":"","readingLevel":"","publisher":"","summary":"Oh! Oh! What was that? What moved there? A fun poem on the stubborn little cockroaches!","coverUrl":"https://static.storyweaver.org.in/illustration_crops/99507/size7/5fedd9cf8a782807f6053d707be4d8b3.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/99507/size7/5fedd9cf8a782807f6053d707be4d8b3.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-47915","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-47915","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":837,"opdsId":"urn:uuid:SW-112731","title":"The Storybook Princess","authors":["Prum Kunthearo"],"language":"","readingLevel":"","publisher":"","summary":"Chamnan likes to listen to stories. But he asks a lot of questions, some of which are difficult for his father to answer. One night he dreams of a character from a storybook — a princess under the spell of a witch. Chamnan asks the princess many questions and breaks the spell. In the morning, he is excited to tell his father the tale of the storybook princess.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/199306/size7/021aed9115d16ed230a9777037c87ad6.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/199306/size7/021aed9115d16ed230a9777037c87ad6.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-112731","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-112731","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":838,"opdsId":"urn:uuid:SW-213330","title":"The Baby Elephant Learns To Drink Water","authors":["Kaminee Singh"],"