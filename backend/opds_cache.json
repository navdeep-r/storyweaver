pi/v0/story/epub/SW-539457","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":171,"opdsId":"urn:uuid:SW-29911","title":"Игри","authors":["Anica Petkoska"],"language":"","readingLevel":"","publisher":"","summary":"Дадо и Ито се смешни. Прочитајте за нивните будалштини во оваа интересна приказна.","coverUrl":"https://static.storyweaver.org.in/illustration_crops/721916/size7/906e74898bf061f7abefb75c6319ad63.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/721916/size7/906e74898bf061f7abefb75c6319ad63.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-29911","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-29911","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"id":172,"opdsId":"urn:uuid:SW-228192","title":"जीजी, जीजी, सीज़े ऊपर केम नती पड़ती?","authors":["Arvind Vaishnav"],"language":"","readingLevel":"","publisher":"","summary":"जीजी ने पुसवा हारु मुन्ना राज़ा ने मन मांय नें ज़ाणे ऐवा केटला ऐ सवाल उठता रेता हेता। जीजी ने पाय ज़वाब हरवगत मली ज़ाता केम के ई हरवेरा कोय ने कोय मोटी क़िताब वांसती रे है। मुन्ना राज़ा हुंसिं रिया है के सीज़े नेंसे केम पड़े हैं? केटलो मज़ो आवतों ज़ो सीजें ऊपर पड़ती! कम से कम आई सोका माते क़सरो करते गांगडती ते नें! जीजी मुन्ना ऱाजा ना अच्छा सवाल नो सही जवाब दाँत काड़ीने आलति रेती। पण भणवा पेले तमें भी तो बताडो तमें हूँ हुंसों हो-सीज़े ऊपर केम नें पड़ती है?","coverUrl":"https://static.storyweaver.org.in/illustration_crops/722409/size7/6fba8609c6e66c4289bbcef0bfcb7e0a.jpg","thumbnailUrl":"https://static.storyweaver.org.in/illustration_crops/722409/size7/6fba8609c6e66c4289bbcef0bfcb7e0a.jpg","acquisitions":[{"href":"https://storyweaver.org.in/api/v0/story/pdf/SW-228192","type":"application/pdf+zip","rel":"http://opds-spec.org/acquisition"},{"href":"https://storyweaver.org.in/api/v0/story/epub/SW-228192","type":"application/epub+zip","rel":"http://opds-spec.org/acquisition"}]},{"i